Keywords = {Radar; Radar imaging; Robots; Millimeter wave communication; Radar
   antennas; Grasping; Manipulators; Antenna arrays; Radar polarimetry;
   Program processors; Transparent object grasping; robotic arm;
   radar-camera fusion; synthetic aperture radar (SAR); material
   identification},
