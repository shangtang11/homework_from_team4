@inproceedings{ WOS:001690442800033,
Author = {Reddy, Thejeswara and Dandra, Prasad and Vrind, Tushar and Kandala,
   Bhargavi and Singh, Omkar and Mani, Somraj and Hong, Seokha},
Book-Group-Author = {IEEE},
Title = {Optimizing System-on-Chip and Software Design for Enhanced Power Savings
   and Response Time},
Booktitle = {2025 IEEE INTERNATIONAL CONFERENCE ON ELECTRONICS, COMPUTING AND
   COMMUNICATION TECHNOLOGIES, CONECCT},
Series = {IEEE International Conference on Electronics Computing and Communication
   Technologies},
Year = {2025},
Note = {11th International Conference on Electronics Computing and Communication
   Technologies-CONECCT-Annual, INDIA, JUL 10-13, 2025},
Abstract = {Battery life is a critical factor in the commercial success of embedded
   devices, necessitating power-efficient system design. This paper
   presents a System-On-Chip (SOC) and software co-optimization technique
   to minimize power consumption during periodic wake-ups from deep sleep
   (warm boots). To enable fast recovery, modern embedded systems keep some
   domains always-on, DRAM in self-refresh while power-gating others,
   forcing software to wait for DRAM initialization during warm boot and
   increasing system latency. We propose using accelerated RAM (XRAM) in
   the always-on domain to execute select operations-such as peripheral
   initialization-before DRAM becomes available. A novel algorithm
   identifies and clusters DRAM-independent software functions that can be
   hosted in XRAM, simultaneously optimizing XRAM sizing and function
   selection based on DRAM wake-up time. During warm boot, these functions
   execute from XRAM while DRAM initializes in parallel, reducing both
   system response time and power consumption. Experimental results on a
   generic SoC platform demonstrate up to 9\% power savings in periodic
   workloads, validating the effectiveness of our approach for
   energy-constrained embedded systems.},
Type = {Proceedings Paper},
Affiliation = {Reddy, T (Corresponding Author), Samsung Elect, New Delhi, India.
   Reddy, Thejeswara; Dandra, Prasad; Vrind, Tushar; Kandala, Bhargavi; Singh, Omkar; Mani, Somraj; Hong, Seokha, Samsung Elect, New Delhi, India.},
