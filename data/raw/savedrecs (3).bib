   Gao, Ruijie, Univ Michigan, Ann Anbor, MI USA.
   Xu, Ceyu, HKUST, Hong Kong, Peoples R China.
   Wills, Lisa Wu, Duke Univ, Durham, NC USA.},
DOI = {10.1145/3695053.3731004},
Keywords = {Performance Modeling and Simulation; Open-source Hardware; High-level
   Hardware Description Language},
