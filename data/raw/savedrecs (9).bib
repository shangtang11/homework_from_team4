Affiliation = {Jin, YE (Corresponding Author), Univ Florida, Dept Elect \& Comp Engn, Gainesville, FL 32611 USA.
   Arias, Orlando; Sullivan, Dean; Shan, Haoqi; Jin, Yier, Univ Florida, Dept Elect \& Comp Engn, Gainesville, FL 32611 USA.},
