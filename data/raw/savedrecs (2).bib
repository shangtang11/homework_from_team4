@article{ WOS:001378163300033,
Author = {Li, Jia and Huang, Li and Zhai, Yikui and Ling, Shikang and Ouyang, Hao
   and Li, Lin},
Title = {MFF-IBL: A Lightweight Cascade Network Based on Multibranch Feature
   Fusion and Incremental Broad Learning for Lead-Independent ECG
   Classification},
Journal = {IEEE TRANSACTIONS ON INSTRUMENTATION AND MEASUREMENT},
Year = {2025},
Volume = {74},
Abstract = {The timely detection and treatment of arrhythmia, a cardiovascular
   disease (CVD) characterized by abnormal heart rhythm, can effectively
   prevent its occurrence. The conventional means of detecting arrhythmia
   in clinical practice are mainly with the help of a 12-lead
   electrocardiogram (ECG). Although deep learning technology in ECG
   automatic classification has demonstrated significant efficacy, there
   are still some problems such as complex network structure, high
   computational cost, and poor interpretability. In addition, most of the
   existing models take single-lead ECG as the research object, and the
   analysis of 12-lead ECG signals is insufficient, which is also contrary
   to the actual clinical diagnostic methods. Aimed at the above problems,
   we propose a lightweight cascade network (MFF-IBL) for single-lead and
   12-lead ECG classification under different acquisition paradigms, with
   only 0.36 M parameters and 202 MFLOPs of computational resources.
   MFF-IBL is composed of multi-branch feature fusion and a broad learning
   network. The multibranch feature fusion network uses a convolutional
   neural network (CNN) and bidirectional gated recurrent unit (BiGRU)
   module to obtain diverse information such as morphological features and
   temporal features of each lead ECG signal. The classifier takes as input
   the fused features from each lead to obtain comprehensive information
   from the 12-lead ECG. In classification tasks, the lightweight network
   model benefits significantly from incremental broad learning (IBL)
   enhanced by chicken swarm optimization (CSO). Experimental results
   demonstrate that MFF-IBL achieves superior classification performance
   compared to state-of-the-art networks across three widely used public
   databases.},
Type = {Article},
Affiliation = {Zhai, YK (Corresponding Author), Wuyi Univ, Sch Elect \& Informat Engn, Jiangmen 529020, Peoples R China.
