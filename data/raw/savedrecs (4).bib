@article{ WOS:001221337300054,
Author = {Cheng, Pao-Ying and Su, Ying-Cheng and Chao, Paul C. -P.},
Title = {Novel High Throughput-to-Area Efficiency and Strong-Resilience Datapath
   of AES for Lightweight Implementation in IoT Devices},
Journal = {IEEE INTERNET OF THINGS JOURNAL},
Year = {2024},
Volume = {11},
Number = {10},
Pages = {17678-17687},
Month = {MAY 15},
Abstract = {A new datapath for the advanced encryption standard (AES) is proposed in
   this work, which is successfully optimized with a high efficiency of
   throughout-to-area for lightweight applications in Internet of Things
   (IoT) devices. The proposed AES architecture enables parallel encryption
   of 32-bit blocks for efficient processing of 128-bit data while
   minimizing hardware area. Optimization is achieved by utilizing shift
   registers instead of conventional registers in the ShiftRows,
   MixColumns, and key expansion stages of the 32-bit AES operation. Our
   implementation, based on the TSMC 40-nm process, achieves a throughput
   of 692.65 Mb/s, with a gate count of 5.65K and a figure of merit (FOM)
   of 122.59-Mb/s/k-gate, better than all the previous works in terms of
   efficiency. Furthermore, our proposed 32-bit datapath ensures security
   against correlation power analysis attacks owing to designed
   simultaneously active encryption and decryption, as the 32-bit key out
   of 128 bits remains unrevealed even with 100000 traces for attack.},
Type = {Article},
Affiliation = {Chao, PCP (Corresponding Author), Natl Yang Ming Chiao Tung Univ, Dept Elect \& Elect Engn, Hsinchu 300093, Taiwan.
   Cheng, Pao-Ying; Su, Ying-Cheng; Chao, Paul C. -P., Natl Yang Ming Chiao Tung Univ, Dept Elect \& Elect Engn, Hsinchu 300093, Taiwan.},
DOI = {10.1109/JIOT.2024.3359714},
