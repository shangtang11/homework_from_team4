@article{ WOS:001489876400001,
Author = {Zhu, Mengjia and Li, Shuo and Bi, Peng and Liang, Huarun and Wu, Xun-En
   and Zhang, Chi and Song, Xian and Yu, Aifang and Xu, Jingtao and Lu,
   Haojie and Wang, Haomin and Zhai, Junyi and Li, Yi and Zheng, Zijian and
   Zhang, Yingying},
Title = {Nanofiber-Based Superskin for Augmented Tactility},
Journal = {ADVANCED FIBER MATERIALS},
Year = {2025},
Volume = {7},
