@inproceedings{ WOS:000835725500030,
Author = {Cassano, Luca and Lazzeri, Elia and Litovchenko, Nikita and Di Natale,
   Giorgio},
Editor = {Kubatova, H and Steininger, A and Jenihhin, M and Garbolino, T and Fiser, P and Belohoubek, J and Borecky, J},
Title = {On the optimization of Software Obfuscation against Hardware Trojans in
   Microprocessors},
Booktitle = {2022 25TH INTERNATIONAL SYMPOSIUM ON DESIGN AND DIAGNOSTICS OF
   ELECTRONIC CIRCUITS AND SYSTEMS (DDECS)},
Series = {IEEE International Symposium on Design and Diagnostics of Electronic
   Circuits \& Systems},
Year = {2022},
Pages = {172-177},
Note = {25th International Symposium on Design and Diagnostics of Electronic
   Circuits and Systems (DDECS), Prague, CZECH REPUBLIC, APR 06-08, 2022},
Abstract = {The quest of low production cost and short time-tomarket, as well as the
   complexity of modern integrated circuits pushed towards a globalization
   of the supply chain of silicon devices. Such production paradigm raised
   a number of security threats among which Hardware Trojan Horses (HTHs),
   that became a serious issue not only for academy but also for industry
   in the very last years. Indeed, it has been demonstrated that HTHs can
   be inserted into microprocessors allowing the attacker to run malicious
   software, to acquire root privileges or to steal secret information. In
   this paper we present the use of software obfuscation to protect systems
   against HTHs that aim at stealing information from the microprocessor
   while it is executing a program. Moreover, we present a Genetic
   Algorithm-based approach to optimize such anti-HTH methodology by
   maximizing the obtained obfuscation while minimizing the introduced
   overhead. We proved the effectiveness and efficiency of the proposed
   methodology on the Ariane 64bit RISC-V microprocessor running a set of
   MiBench benchmarks and cryptographic programs.},
Type = {Proceedings Paper},
Affiliation = {Cassano, L (Corresponding Author), Politecn Milan, Milan, Italy.
