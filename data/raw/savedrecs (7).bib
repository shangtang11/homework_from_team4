@inproceedings{ WOS:001062141900003,
Author = {Nikiema, Pegdwende Romaric and Palumbo, Alessandro and Aasma, Allan and
   Cassano, Luca and Kritikakou, Angeliki and Kulmala, Ari and Lukkarila,
   Jari and Ottavi, Marco and Psiakis, Rafail and Traiola, Marcello},
Editor = {Savino, A and Maniatakos, M and DiCarlo, S and Gizopoulos, D},
Title = {Towards dependable RISC-V cores for edge computing devices},
Booktitle = {2023 IEEE 29TH INTERNATIONAL SYMPOSIUM ON ON-LINE TESTING AND ROBUST
   SYSTEM DESIGN, IOLTS},
Series = {IEEE International On-Line Testing Symposium},
Year = {2023},
Note = {29th IEEE International Symposium on On-Line Testing and Robust System
   Design (IOLTS), Platanias, GREECE, JUL 03-05, 2023},
Abstract = {The migration of the computation from the cloud into edge devices, i.e.,
   Internet-of-Things (IoTs) devices, reduces the latency and the quantity
   of data flowing into the network. With the emerging open-source and
   customizable RISC-V Instruction Set Architecture (ISA), cores based on
   such ISA are promising candidates for several application domains within
   the IoT family, such as automotive, Unnamed Aerial Vehicles (UAVs),
   industrial automation, healthcare, agriculture etc., where power
   consumption, real-time execution, security and reliability are of
   highest importance. In this emerging new era of connected RISC-V IoT
   devices, mechanisms are needed for a reliable and secure execution,
   still meeting area, energy consumption and computation time constraints
   of edge devices. We propose three mechanisms towards this goal, i.e.,
   (i) a Root of Trust module for post-quantum secure boot, (ii) hardware
   checkers against hardware trojan horses and microarchitectural
   side-channel attacks, and (iii) a fine-grained dual core lockstep
   mechanism for real-time error detection and correction. The paper
   illustrates the proposed mechanisms with related motivations and
   implications, as well as a discussion on future research directions.},
Type = {Proceedings Paper},
Affiliation = {Nikiema, PR (Corresponding Author), Univ Rennes, CNRS, Inria, IRISA, Rennes, France.
   Nikiema, Pegdwende Romaric; Kritikakou, Angeliki; Traiola, Marcello, Univ Rennes, CNRS, Inria, IRISA, Rennes, France.
