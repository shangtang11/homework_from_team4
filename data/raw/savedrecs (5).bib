@inproceedings{ WOS:001424939400059,
Author = {Nakata, Yuki and Matsubara, Katsuya},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Poster: Feasibility of Runtime-Neutral Wasm Instrumentation for
   Edge-Cloud Workload Handover},
Booktitle = {2024 IEEE/ACM SYMPOSIUM ON EDGE COMPUTING, SEC 2024},
Series = {IEEE-ACM Symposium on Edge Computing},
Year = {2024},
Pages = {528-530},
Note = {9th Symposium on Edge Computing, Rome, ITALY, DEC 04-07, 2024},
Abstract = {In edge computing, flexibly offloading or handing over computing
   workloads among devices, edge, and cloud, achieved by live migration, is
   crucial because of its hierarchical and heterogeneous structure.
   Implementing the process migration requires the runtime system to
   capture and restore the state of a running application at any arbitrary
   time. WebAssembly (Wasm) has attracted attention as a common platform
   for edge computing since it provides not only architecture neutrality
   and secure sandboxing as a lightweight VM but also performs at a
   native-level performance with AOT/JIT code optimization. Unfortunately,
   the different code optimizations in various Wasm runtimes make it harder
   to insert instrumentation code into application binary at runtime. We
   are currently developing a self-hosted Wasm runtime, i.e., a runtime
   that can be executed on another runtime as a Wasm application
   instrumentation mechanism while handling the runtime heterogeneity,
   including AOT/JIT code transformation. One of the major concerns in our
   proposal is the overhead caused by the intervention of another runtime
   for instrumentation. This study discusses the feasibility of a
   self-hosted runtime with instrumentation for obtaining the application's
   running state by comparing it with existing methods and evaluating it
   through preliminary experiments.},
Type = {Proceedings Paper},
Affiliation = {Nakata, Y (Corresponding Author), SAKURA Internet Inc, Osaka, Japan.
   Nakata, Y (Corresponding Author), Future Univ Hakodate, Hakodate, Hokkaido, Japan.
   Nakata, Yuki, SAKURA Internet Inc, Osaka, Japan.
   Nakata, Yuki; Matsubara, Katsuya, Future Univ Hakodate, Hakodate, Hokkaido, Japan.},
