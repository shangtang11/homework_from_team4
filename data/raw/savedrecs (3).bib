@inproceedings{ WOS:001614845800391,
Author = {Scarciglia, Lorenzo and Paolillo, Antonio and Palossi, Daniele},
Editor = {Ott, C},
Title = {A Map-free Deep Learning-based Framework for Gate-to-Gate Monocular
   Visual Navigation aboard Miniaturized Aerial Vehicles},
Booktitle = {2025 IEEE INTERNATIONAL CONFERENCE ON ROBOTICS AND AUTOMATION (ICRA)},
Year = {2025},
Pages = {9935-9941},
Note = {2025 International Conference on Robotics and Automation-ICRA-Annual,
   Atlanta, GA, MAY 19-23, 2025},
Abstract = {Palm-sized autonomous nano-drones, i.e., sub-50 g in weight, recently
   entered the drone racing scenario, where they are tasked to avoid
   obstacles and navigate as fast as possible through gates. However, in
   contrast with their bigger counterparts, i.e., kg-scale drones,
   nano-drones expose three orders of magnitude less onboard memory and
   compute power, demanding more efficient and lightweight vision-based
   pipelines to win the race. This work presents a map-free vision-based
   (using only a monocular camera) autonomous nano-drone that combines a
   real-time deep learning gate detection front-end with a classic yet
   elegant and effective visual servoing control back-end, only relying on
   onboard resources. Starting from two state-of-the-art tiny deep learning
   models, we adapt them for our specific task, and after a mixed
   simulator-real-world training, we integrate and deploy them aboard our
   nano-drone. Our best-performing pipeline costs of only 24M
   multiplyaccumulate operations per frame, resulting in a closed-loop
   control performance of 30 Hz, while achieving a gate detection root mean
   square error of 1.4 pixels, on our 20 k real-world image dataset.
   In-field experiments highlight the capability of our nano-drone to
