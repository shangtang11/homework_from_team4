@inproceedings{ WOS:001684940200085,
Author = {Chen, Wanqi and Yang, Weidong and Guo, Yiming and Qiu, Jing and Wang,
   Renpei and Jiang, Jianfei and Jing, Naifeng and Wang, Qin},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {RVME: An Efficient Matrix Engine Design Based on Matrix Extension of
   RISC-V},
Booktitle = {2025 IEEE 43RD INTERNATIONAL CONFERENCE ON COMPUTER DESIGN, ICCD},
Series = {Proceedings IEEE International Conference on Computer Design},
Year = {2025},
Pages = {602-609},
Note = {43rd International Conference on Computer Design-ICCD-Annual,
   Richardson, TX, NOV 10-12, 2025},
Abstract = {The rapid advancement of Deep Neural Networks (DNNs) continues to
   challenge traditional computing architectures, prompting the development
   of various hardware accelerators. However, insufficient software
   ecosystem support and limited programmability have significantly
   constrained the widespread deployment of such hardware accelerators.
   CPUs, owing to their versatility and widespread applicability, remain
   strong candidates for DNN acceleration. Several CPU vendors have
   proposed matrix extensions, but none has publicly disclosed the detailed
   microarchitecture, and researchers also lack simulation tools for
   evaluating architectures based on matrix extensions during early-stage
   design. To address these challenges, we propose RVME, an efficient
   matrix engine based on a matrix extension of RISC-V, designed as a CPU
   coprocessor, along with an open-source and configurable simulator built
   upon gem5. RVME introduces scale-out Outer Product Arrays (OPAs) that
   achieve bubble-free General Matrix Multiplication (GEMM) execution and
   superior power efficiency. We also introduce a cache-aware,
   loop-adaptive mapping framework for RVME that searches for mappings with
   optimal Energy-Delay Product (EDP). Experimental results show that RVME
   achieves up to 13.4x speedup and over 21.7x instruction count reduction
   compared to a RISC-V Vector Extension (RVV)-based design. Additionally,
   it delivers a peak energy-area efficiency of 1921.4 GOPS/W/mm(2),
   surpassing state-of-the-art DNN accelerators by more than 6x.},
Type = {Proceedings Paper},
Affiliation = {Wang, Q (Corresponding Author), Shanghai Jiao Tong Univ, Shanghai, Peoples R China.
