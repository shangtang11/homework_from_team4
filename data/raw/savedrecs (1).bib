@article{ WOS:001554488200008,
Author = {Sharma, Ankita and Rani, Shalli},
Title = {Post-Quantum Cryptography (PQC) for IoT-Consumer Electronics Devices
   Integrated With Deep Learning},
Journal = {IEEE TRANSACTIONS ON CONSUMER ELECTRONICS},
Year = {2025},
Volume = {71},
Number = {2},
Pages = {4925-4933},
Month = {MAY},
Abstract = {The emergence of quantum computing seriously threatens the security of
   legacy cryptographic protocols in consumer electronics devices based on
   the Internet of Things (IoT). These are essential components of
   mission-critical infrastructures, such as industrial control systems,
   smart grids, and healthcare. In particular, this work examines how to
   strengthen the resistance of the IoT to classical and quantum-based
   cyberattacks by combining deep learning methods with post-quantum
   cryptography (PQC). To protect key exchange, encryption, and
   authentication processes in IoT-consumer devices, we will continue to
   use quantum-resistant cryptographic algorithms, including lattice-based,
   hash-based, and code-based cryptography. To provide real-time anomaly
   detection and response capabilities, we suggest a hybrid security
   framework combining PQC with deep learning-based intrusion detection
   systems. Our methodology ensures secure communications and data
   exchanges linked to quantum attacks in the future within IoT systems
   while leveraging continuous learning over time to allow Intrusion
   Detection System (IDS) models to adapt to new attack vectors. We suggest
   optimized algorithms for PQC solutions that are lightweight and suitable
   for deployment in edge computing nodes and Internet of Things devices,
   considering the resource-constrained IoT situations where PQC
   implementation would be difficult. Through comparative studies and
   simulations, we demonstrate how our integrated PQC-deep learning
   framework offers an improved IoT security solution that could safeguard
   vital systems in a world powered by quantum technology. The results
   shows the key generation time which is 12.5ms, encryption/decryption
   time 25.3ms, latency 18.7ms, throughput 5000 operations/sec and energy
   consumption 2.4mJ.},
Type = {Article},
Affiliation = {Rani, S (Corresponding Author), Chitkara Univ, Inst Engn \& Technol, Rajpura 140401, Punjab, India.
   Sharma, Ankita; Rani, Shalli, Chitkara Univ, Inst Engn \& Technol, Rajpura 140401, Punjab, India.},
DOI = {10.1109/TCE.2025.3569904},
Keywords = {Cryptography; Internet of Things; Quantum computing; Security;
   Encryption; Computers; Deep learning; Elliptic curve cryptography;
   Computational modeling; Anomaly detection; Post-quantum cryptography;
   deep learning; hybrid cryptography; intrusion detection systems; IoT
   consumer devices},
