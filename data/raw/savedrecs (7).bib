Title = {Machine Learning Accelerators in 2.5D Chiplet Platforms with Silicon
   Photonics},
Booktitle = {2023 DESIGN, AUTOMATION \& TEST IN EUROPE CONFERENCE \& EXHIBITION, DATE},
Series = {Design Automation and Test in Europe Conference and Exhibition},
Year = {2023},
Note = {Design, Automation and Test in Europe Conference and Exhibition (DATE),
   Antwerp, BELGIUM, APR 17-19, 2023},
Abstract = {Domain-specific machine learning (ML) accelerators such as Google's TPU
   and Apple's Neural Engine now dominate CPUs and GPUs for
   energy-efficient ML processing. However, the evolution of electronic
   accelerators is facing fundamental limits due to the limited computation
   density of monolithic processing chips and the reliance on slow metallic
   interconnects. In this paper, we present a vision of how optical
   computation and communication can be integrated into 2.5D chiplet
   platforms to drive an entirely new class of sustainable and scalable ML
   hardware accelerators. We describe how cross-layer design and
   fabrication of optical devices, circuits, and architectures, and
   hardware/software codesign can help design efficient photonics-based
   2.5D chiplet platforms to accelerate emerging ML workloads.},
