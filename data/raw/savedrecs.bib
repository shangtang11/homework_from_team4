@article{ WOS:001630073400002,
Author = {Wang, Wenjie and Xie, Xiongwu and Zhang, Pengfei and Zhao, Lei},
Title = {Time-delayed mechanical detection and imaging based on self-charged
   persistent mechanoluminescence},
Journal = {MATERIALS RESEARCH BULLETIN},
Year = {2026},
Volume = {196},
Month = {MAR},
Abstract = {Accurate detection of mechanoluminescence (ML) signals is crucial for
   their application in mechanical sensing, and Persistent ML (Pers-ML)
   materials offer a viable pathway to address the challenge of capturing
   transient signals. However, most reported Pers-ML materials rely on
   trap-controlled mechanisms that require pre-irradiation, which limits
   their practical application. In this study, we develop two
   self-activated ML materials, Ca19Zn2(PO4)14: Dy3+(CZPOD)/PDMS and
   Ca19Zn2(PO4)14: Tb3+(CZPOT)/PDMS, that exhibit excellent Pers-ML
   performance without the need for pre-irradiation. The observed ML
   originates from triboelectric effects at the inorganic-organic
   interface. This triboelectricity not only induces transient ML during
   mechanical stimulation but also enables carrier trapping in intrinsic
   defect states of the inorganic phosphor. After unloading, these trapped
   carriers are thermally released at room temperature, producing Pers-ML.
   Leveraging this intrinsic property, we propose a novel strategy for
   delayed stress monitoring. This work offers a new perspective for
   expanding the application scope of Pers-ML materials across diverse
   real-world scenarios.},
Type = {Article},
Affiliation = {Wang, WJ (Corresponding Author), Northwest Minzu Univ, Gansu Prov Biomass Funct Composites Engn Res Ctr, Key Lab Util Environm Friendly Composite Mat \& Bio, Gansu Prov Res Ctr Basic Sci Surface \& Interface C, Lanzhou 730030, Peoples R China.
