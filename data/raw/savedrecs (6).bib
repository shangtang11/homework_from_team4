@article{ WOS:001029770200001,
Author = {An, Junjie and Wang, Linfang and Ye, Wang and Li, Weizeng and Gao,
   Hanghang and Li, Zhi and Zhou, Zhidao and Tian, Jinghui and Gao,
   Jianfeng and Dou, Chunmeng and Liu, Qi},
Title = {Design memristor-based computing-in-memory for AI accelerators
   considering the interplay between devices, circuits, and system},
Journal = {SCIENCE CHINA-INFORMATION SCIENCES},
Year = {2023},
Volume = {66},
Number = {8},
Month = {AUG},
Abstract = {Recent advances in developing beyond von Neumann architectures have
   moved the memristive devices to the forefront as one of the key enablers
   to realizing memristive computing-in-memory (mCIM) structures, which
   shows a great promise to boost the energy-efficiency and the performance
   of artificial intelligence (AI) chips. In this study, by considering the
   interactions between devices, circuits, and systems in the mCIM design,
   we propose several cross-layer design techniques, including (1) the
   BL-SL interactive forming protection (BSIFP) circuit that can reduce the
   voltage drop on the selected transistor, suppress the current overshoot
   by 65.96\%, and improve the bit-cell density by more than 10.19\%, (2)
   the clamping transistor trimming scheme (CTTS) to prevent the
   multiply-and-accumulate (MAC) signal margin degradation from
   chip-to-chip resistance variations, and (3) dynamic input-parallelism
   and output-precision (DIPOP) that can reduce the energy cost by 22.92\%
   in a typical inference task with negligible accuracy loss. The results
   demonstrate the significant role of the cross-layer-interactive approach
   and provide a preliminary guideline for highly-efficient mCIM design.},
