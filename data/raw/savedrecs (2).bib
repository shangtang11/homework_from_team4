@inproceedings{ WOS:001572098000038,
Author = {Carvalho, Jean Douglas and Forte, Felipe de Souza and Taciro, Hugo Kenji
   and Melo, Glaucia and Dias Santos, Max Mauro},
Book-Group-Author = {IEEE},
Title = {LLM-Powered Framework for Interpretable Traffic Rule Processing in
   Autonomous Driving},
Booktitle = {2025 IEEE 34TH INTERNATIONAL SYMPOSIUM ON INDUSTRIAL ELECTRONICS, ISIE},
Series = {Proceedings of the IEEE International Symposium on Industrial
   Electronics},
