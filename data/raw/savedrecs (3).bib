EarlyAccessDate = {DEC 2024},
Keywords = {Feature extraction; Vectors; Integrated circuit modeling; Trojan horses;
   Codes; Hardware; Logic gates; Accuracy; Syntactics; Training; Graph
   neural networks (GNNs); hardware security; hardware Trojans (HTs);
   multiple-category features; register transfer level},
