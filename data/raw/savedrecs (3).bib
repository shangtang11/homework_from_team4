@inproceedings{ WOS:001478053000001,
Author = {Ramesh, Arjun and Huang, Tianshu and Titzer, Ben L. and Rowe, Anthony},
Book-Group-Author = {ACM},
Title = {Empowering WebAssembly with Thin Kernel Interfaces},
Booktitle = {PROCEEDINGS OF THE 2025 TWENTIETH EUROPEAN CONFERENCE ON COMPUTER
   SYSTEMS, EUROSYS 2025},
Year = {2025},
Pages = {1-20},
Note = {20th European Conference on Computer Systems-EuroSys, Rotterdam,
   NETHERLANDS, MAR 30-APR 03, 2025},
Abstract = {Wasm is gaining popularity outside the Web as a well-specified low-level
   binary format with ISA portability, low memory footprint and polyglot
   targetability, enabling efficient in-process sandboxing of untrusted
   code. Despite these advantages, Wasm adoption for new domains is often
   hindered by the lack of many standard system interfaces which precludes
   reusability of existing software and slows ecosystem growth. This paper
   proposes thin kernel interfaces for Wasm, which directly expose OS
   userspace syscalls without breaking intra-process sandboxing, enabling a
   new class of virtualization with Wasm as a universal binary format. By
   virtualizing the bottom layer of userspace, kernel interfaces enable
   effortless application ISA portability, compiler backend reusability,
   and armor programs with Wasm's built-in control flow integrity and
   arbitrary code execution protection. Furthermore, existing
   capability-based APIs for Wasm, such as WASI, can be implemented as a
   Wasm module over kernel interfaces, improving reuse, robustness, and
   portability through better layering. We present an implementation of
   this concept for two kernels - Linux and Zephyr - by extending a modern
   Wasm engine and evaluate our system's performance on a number of
   sophisticated applications which can run for the first time on Wasm.},
Type = {Proceedings Paper},
Affiliation = {Ramesh, A (Corresponding Author), Carnegie Mellon Univ, Pittsburgh, PA 15213 USA.
   Ramesh, Arjun; Huang, Tianshu; Titzer, Ben L., Carnegie Mellon Univ, Pittsburgh, PA 15213 USA.
   Rowe, Anthony, Carnegie Mellon Univ, Bosch Res, Pittsburgh, PA USA.},
DOI = {10.1145/3689031.3717470},
Keywords = {virtualization; operating systems; WebAssembly; Linux; Zephyr;
   compilers; interpreters; edge computing},
Keywords-Plus = {FORMAL VERIFICATION; SYSTEMS},
Author-Email = {arjunr2@andrew.cmu.edu
   tianshu2@andrew.cmu.edu
   btitzer@andrew.cmu.edu
