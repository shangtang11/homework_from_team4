@inproceedings{ WOS:000565678000007,
Author = {Wicaksana, Arief and Charif, Amir and Andriamisaina, Caaliph and
   Ventroux, Nicolas},
Book-Group-Author = {IEEE},
Title = {Hybrid Prototyping Methodology for Rapid System Validation in HW/SW
   Co-Design},
Booktitle = {2019 CONFERENCE ON DESIGN AND ARCHITECTURES FOR SIGNAL AND IMAGE
   PROCESSING (DASIP)},
Series = {Conference on Design and Architectures for Signal and Image Processing},
Year = {2019},
Pages = {35-40},
Note = {Conference on Design and Architectures for Signal and Image Processing
   (DASIP), Montreal, CANADA, OCT 16-18, 2019},
Abstract = {As the System-on-Chip (SoC) complexity increases, hardware/software
   co-design plays an important role to improve design productivity, reduce
   time to market, and optimize the overall results. Consequently, there is
   a high interest in providing rapid system validation in such a paradigm
   to achieve the aforementioned objectives. There exist in previous works
   prototyping techniques related to the development phase. FPGA-based
   prototyping has the benefits of enabling HW/SW integration and system
   validation after the Register Transfer Level (RTL) implementation is
   available while virtual platforms provide capabilities to accelerate
   software development with higher level functional models, e.g.
   Transaction Level Modeling (TLM).
   In this paper, we propose a hybrid prototyping methodology which takes
   advantage of virtual and FPGA-based prototyping in a single framework.
   We aim to provide a rapid and flexible system validation solution for
   HW/SW co-design at various stages of development based on the
   availability of TLM and RTL implementations. The proposed methodology
   allows online and offline performance analysis and debugging for early
   feedback in HW/SW architecture exploration. This was evaluated in the
   experiments with a neural network processor as a case study.},
Type = {Proceedings Paper},
Affiliation = {Wicaksana, A (Corresponding Author), CEA, List, Embedded Comp Lab, F-91191 Gif Sur Yvette, France.
