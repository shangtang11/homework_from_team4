@article{ WOS:001619524100002,
Author = {Peng, Shun and Wan, Zhenshuai and Fu, Yu and Liu, Chong and Tian, Ye and
   Wei, Ronghan and Fan, Yibin and Xin, Peifang},
Title = {Flexible magnetic tactile sensors: Materials, working principles, and
   applications-A review},
Journal = {MATERIALS TODAY PHYSICS},
Year = {2025},
Volume = {59},
Month = {DEC},
Abstract = {Flexible magnetic tactile sensors (FMTSs) have emerged as a promising
   technology for seamlessly translating physical interactions into digital
   signals, offering exceptional advantages in sensitivity, durability, and
   adaptability. These sensors leverage advanced magnetic materials,
   including hard magnetic materials, hard magnetic composites, soft
   magnetic materials, and soft magnetic composites, to convert mechanical
   stimuli into quantifiable magnetic signals. This review comprehensively
   examines recent advances in FMTSs through three critical dimensions:
   material innovations, transduction mechanisms, and application
   scenarios. We first analyze performance-enhancing material designs, such
   as magnetoelastic composites, and emphasize their roles in improving
   sensitivity and mechanical flexibility. Subsequently, we explore the
   core physical transduction principles: Hall effect, anisotropic
   magnetoresistance (AMR) effect, giant magnetoresistance (GMR) effect,
   tunnel magnetoresistance (TMR) effect, magnetostriction, giant
   magnetoimpedance (GMI) effect, and magnetoelectric (ME) effect. We
   systematically evaluate the intrinsic trade-offs among key metrics,
   including resolution, dynamic range, and energy efficiency. This
   analysis underscores how material properties (e.g., magnetic domain
   dynamics, magnetoelectric coupling efficiency) and device architectures
   (e.g., multilayer heterointerfaces, optimization of magnetic flux
   closure) dictate fundamental performance limits. Furthermore, we
   highlight their emerging applications in human-machine interaction,
   precision grasping, and tactile perception, where FMTSs facilitate
   precise feedback, high-accuracy positioning, and multidimensional force
   decoupling. Moreover, current challenges-such as environmental
   robustness, scalability, and signal drift-are critically assessed, while
   future directions focus on bioinspired designs and artificial
   intelligence (AI)-driven system integration. By synthesizing
   interdisciplinary perspectives, this review aims to accelerate the
   development of next-generation tactile sensing technologies for adaptive
   haptic interfaces and smart environments.},
Type = {Review},
Affiliation = {Wan, ZS; Tian, Y (Corresponding Author), Henan Univ Technol, Sch Mech \& Elect Engn, Zhengzhou 450001, Peoples R China.
