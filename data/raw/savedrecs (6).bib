@article{ WOS:001048599300001,
Author = {Shafiei, Mahdi and Daryanavard, Hassan and Hatam, Ahmad},
Title = {Scalable and custom-precision floating-point hardware convolution core
   for using in AI edge processors},
Journal = {JOURNAL OF REAL-TIME IMAGE PROCESSING},
Year = {2023},
Volume = {20},
Number = {5},
Month = {OCT},
Abstract = {AI algorithms such as CNNs devices have necessitated the design of
   lightweight, low-power, and fast hardware in edge processors. In this
   paper, a floating-point convolution core is proposed for edge processors
   to implement CNN. At first, the conventional CNN networks were analyzed
   in terms of the abundance of filter size. Considering the performance
   and execution time, the focus of the research is on size of 3 x 3. Next,
   using the proposed 10-input adder instead of nine 2-input adders and
   modifying the multipliers, an optimum 32-bit 3 x 3 convolution core has
   been designed. After studying different bit widths in mantissa and the
   exponent of floating-point numbers in CNNs, 13-bit is considered as the
   minimum bit width without accuracy losing. The 3 x 3 core with the new
   bit width is implemented. Since filter sizes 1 x 1 and 5 x 5 are also
   available in conventional networks, the new scalable architecture is
   designed to support all three sizes. Finally, the YOLOv4-tiny object
   detection and GoogLeNet are used as two benchmarks to evaluate the final
   3 x 3 scalable core. The results have shown that despite using
   floating-point calculations, the FPS is equal to 45.9, which is equal to
   the previous works that were done in fixed-point, while the accuracy of
   the proposed work is 84\% which is similar to the 32-bit floating point.},
Type = {Article},
Affiliation = {Daryanavard, H (Corresponding Author), Univ Hormozgan, Dept Elect \& Comp Engn, Bandar Abbas, Iran.
   Shafiei, Mahdi; Daryanavard, Hassan; Hatam, Ahmad, Univ Hormozgan, Dept Elect \& Comp Engn, Bandar Abbas, Iran.},
