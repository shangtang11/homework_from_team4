@inproceedings{ WOS:000852887300086,
Author = {Vicarte, Jose Rodrigo Sanchez and Flanders, Michael and Paccagnella,
   Riccardo and Garrett-Grossman, Grant and Morrison, Adam and Fletcher,
   Christopher W. and Kohlbrenner, David},
Book-Group-Author = {IEEE COMP SOC},
Title = {Augury: Using Data Memory-Dependent Prefetchers to Leak Data at Rest},
Booktitle = {43RD IEEE SYMPOSIUM ON SECURITY AND PRIVACY (SP 2022)},
Series = {IEEE Symposium on Security and Privacy},
Year = {2022},
Pages = {1491-1505},
Note = {43rd IEEE Symposium on Security and Privacy (SP), San Francisco, CA, MAY
   23-26, 2022},
Abstract = {Microarchitectural side-channel attacks are enjoying a time of explosive
   growth, mostly fueled by novel transient execution vulnerabilities.
   These attacks are capable of leaking arbitrary data, as long as it is
   possible for the adversary to read that data into the processor core
   using transient instructions.
   In this paper, we present the first microarchitectural attack that leaks
   data at rest in the memory system, i.e., never directly read into the
   core speculatively or non-speculatively. This technique is enabled by a
   previously unreported class of prefetcher: a data memory-dependent
   prefetcher (DMP). These prefetchers are designed to allow prefetching of
   irregular address patterns such as pointer chases. As such, DMPs examine
   and use the contents of memory directly to determine which addresses to
   prefetch.
   Our experiments demonstrate the existence of a pointerchasing DMP on
   recent Apple processors, including the A14 and M1. We then reverse
   engineer the details of this DMP to determine the opportunities for and
   restrictions it places on attackers using it. Finally, we demonstrate
   several basic attack primitives capable of leaking pointer values using
   the DMP.},
