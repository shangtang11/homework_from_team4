@article{ WOS:001485749900003,
Author = {Ali, Mhm and Atia, Mostafa R. A. and Fouz, Moustafa A.},
Title = {Decision enhancement of speed and separating monitoring modes for
   human-robot collaborative safety},
Journal = {SYSTEMS AND SOFT COMPUTING},
Year = {2025},
Volume = {7},
Month = {DEC},
Abstract = {Involving human robot collaboration advancements are transforming
   industrial safety protocols. This paper proposes an enhancement approach
   to improve robot decision accuracy, in Speed and Separation Monitoring
   (SSM), according to ISO/TS 15066 safety standard. This approach
   integrates Machine Learning (ML), Artificial Intelligence (AI), for
   decision-making using data extracted from an active depth camera, which
   tracks operators' hand movements and measures distances on line. The
