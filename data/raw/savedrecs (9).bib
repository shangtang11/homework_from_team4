Note = {18th International SoC Design Conference (ISOCC), Jeju, SOUTH KOREA, OCT
   06-09, 2021},
Abstract = {This paper presents a charge-redistribution in-memory-computing (IMC)
   macro that realizes multi-bit multiply-and-accumulation (MAC) operation
   based on 5T static randomaccess memory (SRAM). The charge-domain MAC
   operation based on capacitor array allows the IMC-SRAM macro to achieve
   high linearity and improved energy efficiency. Also, an optimized 5T
   SRAM structure saves area consumption, increasing bit density of the
   macro. The proposed IMC-SRAM 64 x 64 macro was designed using 28nm CMOS
   process.},
