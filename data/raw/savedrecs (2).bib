@inproceedings{ WOS:001544582700017,
Author = {Kohnhaeuser, Florian and Coppik, Nicolas and Gottel, Christian and
   Finster, Soren},
Editor = {Zlatolas, LN and Rannenberg, K and Welzer, T and Garcia-Alfaro, J},
Title = {Lightweight and Persistent Remote Attestation: Leveraging a Continuous
   Chain of Trust in Software Integrity Measurements},
Booktitle = {ICT SYSTEMS SECURITY AND PRIVACY PROTECTION, SEC 2025, PT I},
Series = {IFIP Advances in Information and Communication Technology},
Year = {2025},
