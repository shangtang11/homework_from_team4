@article{ WOS:000788884100001,
Author = {Elkhatib, Rami and Koziel, Brian and Azarderakhsh, Reza and Kermani,
   Mehran Mozaffari},
Title = {Accelerated RISC-V for Post-Quantum SIKE},
Journal = {IEEE TRANSACTIONS ON CIRCUITS AND SYSTEMS I-REGULAR PAPERS},
