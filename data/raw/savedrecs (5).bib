@inproceedings{ WOS:001325422100061,
Author = {Hao, Mingbo and Qian, Junyi and Li, Zhiting and Qian, Zhangrui and Shan,
   Weiwei},
Book-Group-Author = {IEEE},
Title = {OhmNet: General Static IR Drop Estimation Neural Network Architecture},
Booktitle = {2024 INTERNATIONAL SYMPOSIUM OF ELECTRONICS DESIGN AUTOMATION, ISEDA
   2024},
Year = {2024},
Pages = {337-342},
Note = {2nd International Symposium of Electronics Design Automation (ISEDA),
   Xian, PEOPLES R CHINA, MAY 10-13, 2024},
Abstract = {Static IR drop analysis is a crucial part in the signoff stage of the IC
   design flow. Conventional commercial tools are often time-consuming,
   hindering the acceleration of the industrial design cycle. We propose a
   novel OhmNet neural network architecture to provide quick and accurate
   predictions for the limited IR drop mitigation time budget in the IC
   design period. OhmNet incorporates circuit constraint into the model
   optimization process. This approach not only facilitates the convergence
   of the model but also enhances its interpretability. Furthermore, the
   implementation of the OhmNet architecture is modular. We develop four
   configurable modules that can be customized to meet specific accuracy or
   speed requirements, leading to the creation of the OhmNet-23 network.
   The experimental results show that the network is still sensitive to
   isolated, small-scale regions with high IR drop. Compared with the
   ground truth, the average correlation coefficient (CC) and the mean
   absolute error (MAE) of the estimation result are 92.92\% and 2.14 mV,
   respectively, and the estimation speed is 28.98\% faster than the method
   based on U-Net.},
Type = {Proceedings Paper},
Affiliation = {Shan, WW (Corresponding Author), Southeast Univ, Sch Integrated Circuits, Nanjing, Peoples R China.
   Hao, Mingbo; Qian, Junyi; Li, Zhiting; Qian, Zhangrui; Shan, Weiwei, Southeast Univ, Sch Integrated Circuits, Nanjing, Peoples R China.},
