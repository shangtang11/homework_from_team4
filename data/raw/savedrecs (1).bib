@article{ WOS:001584065400001,
Author = {Lin, Wei-Cheng and Hsieh, Chun-Ting and Hsieh, Yun-Yu and Yeh, Chun-Wei},
Title = {Design and Implementation of a Doppler Ultrasound Transducer Utilizing
   an Empirical Physical-Based Model for Carotid Artery Stenosis},
Journal = {INTERNATIONAL JOURNAL OF CIRCUIT THEORY AND APPLICATIONS},
Year = {2025},
Month = {2025 SEP 30},
Abstract = {This study proposes an ultrasound Doppler transceiver designed for
   noninvasive, real-time evaluation of carotid artery stenosis (CAS).
   Utilizing a diode-based regulation circuit with precise control of
   nonoverlap timing exceeding 10 ns, the transceiver operates efficiently
   with a single 27 V supply, delivering an output swing of +/- 18 V to
   drive the transducer effectively. To evaluate CAS, we propose an
   empirical physics-based model for assessing hemodynamic parameters, peak
   systolic velocity (PSV) and wall shear stress (WSS), using the developed
   ultrasonic transducer. The model is calibrated with a Doppler string
   phantom platform (CIRS 43A). The results demonstrate PSV values of 0.84
   m/s under healthy carotid artery conditions (compared to a
   phantom-defined target of 0.81 m/s) and 2.00 m/s under severe stenosis
   conditions (compared to 1.83 m/s), with deviations within +/- 15\%. The
   configuration was also verified using finite element analysis
   simulations in COMSOL Multiphysics. The simulation results exhibit
   agreement with clinical data. A correlation coefficient of 0.922 was
   obtained for PSV, and WSS values remained within the clinical error
   range across stenotic and post-stenotic regions. These findings
   highlight that the proposed transceiver, combined with the empirical
   physics-based model for PSV and WSS, provides an accurate method for the
   early assessment of CAS.},
Type = {Article; Early Access},
Affiliation = {Hsieh, CT (Corresponding Author), Chang Gung Univ, Dept Elect Engn, Taoyuan, Taiwan.
