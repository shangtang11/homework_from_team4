@article{ WOS:001457781100030,
Author = {Sedighiani, Shima and van Bolderik, Bram and de Bruin, Barry and Singh,
   Kamlesh and Jordans, Roel and Harpe, Pieter and de Gyvez, Jose Pineda},
Title = {An Ultra-Low-Leakage Microcontroller With Configurable Power Management
   for Energy Harvesting IoT Devices},
Journal = {IEEE ACCESS},
Year = {2025},
Volume = {13},
Pages = {53594-53607},
Abstract = {This paper presents a power management unit (PMU) architecture designed
   for energy-harvesting IoT devices, integrating a dual-capacitor system,
   an ultra-low-leakage balloon-based microcontroller (MCU), and a fully
   digital controller. The PMU dynamically switches between an active
   capacitor, an idle capacitor, and a backup battery, optimizing energy
   use in different operational modes. This configuration optimizes
   capacitor voltages for various operational modes, applying a higher
   voltage to the active capacitor for enhanced performance and a lower
   voltage to the idle capacitor for ultra-low-leakage data retention.
   Additionally, a fully digital PMU controller replaces conventional
   analog components, leveraging a digital voltage monitor and
   converter-free voltage regulation. The test chip is designed and
   fabricated using a 28-nm FD-SOI technology. The balloon-based MCU
   measurement shows that it can retain data during idle mode with a power
   consumption of only 3nW at 0.6V, achieving a \$4400
   \textbackslash{}times \$ reduction in leakage power compared to
   conventional MCUs without balloon memory. Furthermore, the results of
   the system measurement demonstrate a substantial reduction in battery
   usage from 88\% in traditional setups to 0\%, while ensuring continuous
   operation and data retention.},
Type = {Article},
Affiliation = {Sedighiani, S (Corresponding Author), Eindhoven Univ Technol, Dept Elect Engn, NL-5612 AZ Eindhoven, Netherlands.
