Title = {Cluster Regulation Architecture and Control Strategy of Fast Charging
   Stations with Energy Storage System},
Booktitle = {2021 IEEE 4TH INTERNATIONAL CONFERENCE ON AUTOMATION, ELECTRONICS AND
   ELECTRICAL ENGINEERING, AUTEEE},
Year = {2021},
Pages = {762-765},
Note = {4th International Conference on Automation Electronics and Electrical
   Engineering, Shenyang, PEOPLES R CHINA, NOV 19-21, 2021},
Abstract = {Considering the trend of electric vehicle charging station widely
   equipped with energy storage system(ESS) in the future, the energy
   storage system of the fast charging station(FCS) can meet the local
   charging load demand and realize the friendly support to the
   distribution network through the cluster mode, which is an important
   application way for fast charging station with energy storage
   system(FCSESS). According to the above requirements, firstly, a
   hierarchical control architecture of FCSESS cluster based on 4G/5G
   communication and intelligent edge control device is proposed. Secondly,
   a cluster division method is proposed, taking the FCSESS in a feeder as
   a cluster, and then evaluation method of cluster operation potential is
   proposed, which will provide support for the cluster coordination
   control of FCSESS. Combined with the hierarchical structure of the
   cluster regulation system of the FCSESS, the coordinated control
   strategy of the ESS based on the cluster is proposed to realize the fast
   response to the safe operation interaction of the regional power grid
   and the optimal control of the cluster, so as to slow down the heavy
   load of the line and reduce the load fluctuation of the distribution
   network. Finally, a simulation example is given to verify the
   effectiveness of the cluster method and the coordinated control
   strategy.},
