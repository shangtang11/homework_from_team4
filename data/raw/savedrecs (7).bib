@inproceedings{ WOS:001146866200079,
Author = {Zurstrassen, Niko and Bosbach, Nils and Joseph, Jan Moritz and Junger,
   Lukas and Weinstock, Jan Henrik and Leupers, Rainer},
Book-Group-Author = {IEEE},
Title = {Efficient RISC-V-on-x64 Floating Point Simulation},
Booktitle = {2023 IEEE 41ST INTERNATIONAL CONFERENCE ON COMPUTER DESIGN, ICCD},
Series = {Proceedings IEEE International Conference on Computer Design},
Year = {2023},
Pages = {558-565},
Note = {41st IEEE International Conference on Computer Design (ICCD), George
   Washington Univ, Washington, DC, NOV 06-08, 2023},
Abstract = {Fast simulation of Virtual Platforms (VPs) is a cornerstone of modern
   hardware/software co-development. A particular challenge, especially if
   target and host Instruction Set Architecture (ISA) are different, is the
   simulation of Floating Point (FP) instructions. Although FP arithmetic
   was standardized in 1985 by IEEE 754, extensive revisions and lax
   definitions have led to a variety of different implementations. Thus,
   the question we seek to answer in this work is: How can FP instructions
   be efficiently simulated, if the FP arithmetic provided by the host ISA
   is semantically different?
   In this paper, we first provide a comprehensive overview of methods used
   in academia and open-source projects. Subsequently, we propose our own
   strategy for emulating RISC-V FP instructions on an x64 host. Our idea
   is to leverage the host's FPU and handle corner cases in software. In
   contrast to other works, we cover the full spectrum of arithmetic FP
   instructions and present innovative approaches, especially for the
   computation of division and square root. Moreover, we show how exception
   flags and a non-default rounding mode can be handled efficiently. Our
   approach achieves a 3x speedup in common FP benchmarks compared to
   purely software-based solutions. When comparing our method against more
   sophisticated methods, as for example used in QEMU, we achieve a 50\%
   performance gain for non-default rounding modes.},
Type = {Proceedings Paper},
Affiliation = {Zurstrassen, N (Corresponding Author), Rhein Westfal TH Aachen, Inst Commun Technol \& Embedded Syst, Aachen, Germany.
   Zurstrassen, Niko; Bosbach, Nils; Joseph, Jan Moritz; Leupers, Rainer, Rhein Westfal TH Aachen, Inst Commun Technol \& Embedded Syst, Aachen, Germany.
