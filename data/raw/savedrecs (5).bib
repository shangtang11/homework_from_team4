Title = {Firmware-Based DoS Attacks in Wireless Sensor Network},
Booktitle = {COMPUTER SECURITY. ESORICS 2023 INTERNATIONAL WORKSHOPS, CPS4CIP, PT II},
Series = {Lecture Notes in Computer Science},
Year = {2024},
Volume = {14399},
