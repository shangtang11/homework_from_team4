@article{ WOS:001194048100001,
Author = {Hirner, Florian and Mert, Ahmet Can and Roy, Sujoy Sinha},
Title = {Proteus: A Pipelined NTT Architecture Generator},
Journal = {IEEE TRANSACTIONS ON VERY LARGE SCALE INTEGRATION (VLSI) SYSTEMS},
Year = {2024},
Volume = {32},
Number = {7},
Pages = {1228-1238},
Month = {JUL},
Abstract = {Number theoretic transform (NTT) is a fundamental building block in
   emerging cryptographic constructions such as fully homomorphic
   encryption (FHE), post-quantum cryptography (PQC), and zero-knowledge
   proof (ZKP). In this work, we introduce Proteus, an open-source
   parametric hardware to generate pipelined architectures for the NTT. For
   a given parameter set including the polynomial degree and size of the
   coefficient modulus, Proteus can generate Radix-2 NTT architectures
   using single-path delay feedback (SDF) and multipath delay commutator
   (MDC) approaches. We also present a detailed analysis of NTT
   implementation approaches and use several optimizations to achieve the
   best NTT configuration. Our evaluations demonstrate performance gain up
   to 1.8x compared to SDF and MDC-based NTT implementations in the
   literature. Our SDF and MDC architectures use 1.75x and 6.5x less DSPs,
   and 3x and 10.5x less BRAMs, respectively, compared to state-of-the-art
   SDF and MDC-based NTT implementations.},
Type = {Article},
Affiliation = {Hirner, F (Corresponding Author), Graz Univ Technol, Inst Appl Informat Proc \& Commun, A-8010 Graz, Austria.
   Hirner, Florian; Mert, Ahmet Can; Roy, Sujoy Sinha, Graz Univ Technol, Inst Appl Informat Proc \& Commun, A-8010 Graz, Austria.},
