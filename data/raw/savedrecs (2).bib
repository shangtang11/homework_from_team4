@inproceedings{ WOS:001545636700080,
Author = {Liao, Xinfang and Huang, Zeyu and Xu, Changqing and Chen, Ruijing and
   An, Chenglin and Liu, Yi and Mu, Fanquan},
Book-Group-Author = {IEEE},
Title = {Research on the Simulation Acceleration Method of System-Level
   Single-Event Effects Based on Register Fault Injection},
Booktitle = {2025 14TH INTERNATIONAL CONFERENCE ON MODERN CIRCUITS AND SYSTEMS
   TECHNOLOGIES, MOCAST},
Series = {International Conference on Modern Circuits and Systems Technologies},
Year = {2025},
Note = {14th International Conference on Modern Circuits and Systems
   Technologies-MOCAST-Annual, Dresden, GERMANY, JUN 11-13, 2025},
Abstract = {With the increase in the scale of aerospace integrated circuits and the
   rise in circuit complexity, anti-radiation reinforcement technology has
   become more difficult to evaluate. This paper adopts a system-level
   single-event effects simulation method based on register fault
   injection, and proposes the simulation acceleration methods from two
   dimensions: the reduction of circuit simulation scale and the
   optimization of simulation injection strategies. Firstly, a fault set
   reduction method based on stuck-at fault simulation is proposed, which
   reduces the fault injection set from the spatial and temporal
   dimensions. Secondly, a fault injection simulation method for dynamic
   fault set reduction based on confidence level theory is proposed. By
   dividing the simulation into multiple rounds, the error rate of
   registers in different simulation rounds is analyzed, dynamically
   optimizing the fault set and adjusting the fault injection quantity to
   improve simulation efficiency. Based on this, a simulation model of the
   LEON2 SoC system is built to validate the proposed single-event effects
   simulation method. The data shows that the simulation acceleration
   integration scheme proposed in this paper can detect 16.6\% more
   sensitive register units compared to the common register random fault
   injection method. Compared to the full register traversal fault
   injection method, it uses only 5.9\% of the fault injection scale and
   can detect 93.5\% of the sensitive register units, maintaining high
   simulation speed and detection accuracy. This technology can be applied
   to the single-event effects sensitivity analysis of various modules in
   integrated circuit design, providing guidance for optimizing chip
   anti-radiation reinforcement design.},
Type = {Proceedings Paper},
Affiliation = {Liao, XF (Corresponding Author), Xidian Univ, Guangzhou Inst technol, Guangzhou, Peoples R China.
