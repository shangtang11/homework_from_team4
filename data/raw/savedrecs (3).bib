@article{ WOS:001378973000001,
Author = {Tavazoei, Mohammad Saleh},
Title = {Stabilisation in an infinite time horizon by homomorphically encrypted
   first-order controllers with regular Pisot poles},
Journal = {INTERNATIONAL JOURNAL OF SYSTEMS SCIENCE},
Year = {2025},
Volume = {56},
Number = {10},
Pages = {2221-2230},
Month = {JUL 27},
Abstract = {It has been previously found that partially homomorphic encryption based
   controllers cannot operate in an infinite time horizon, unless all
   elements of their state matrices are integer numbers. Considering this
   fact and the results of a recent research revealing the role of Pisot
   numbers to act as the poles of integer state matrix based state space
   models involving no unstable pole-zero cancellation, the present paper
   aims to introduce some classes of realisations implementing first-order
   discrete-time controllers, which can be used in an infinite time horizon
   in encrypted control systems. These classes of controller realisations
   are obtained based on sequences approaching to limit points of positive
   Pisot numbers settled in the range \$ (1,2) \$ (1,2). An analytical
   procedure is also suggested to find the exact range of the controller
   gain for ensuring the closed-loop stability.},
