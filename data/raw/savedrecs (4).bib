   Wehrheim, Heike, Carl von Ossietzky Univ Oldenburg, Oldenburg, Germany.},
DOI = {10.1007/978-3-031-50521-8\_2},
Keywords = {Durable Linearizability; Px86-TSO; Persistency; Libraries; FliT;
   Verification},
