Title = {Evaluation of Application-Independent Unbiased Approximate Multipliers
   on Quantized Convolutional Neural Networks},
Booktitle = {2023 IEEE 36TH INTERNATIONAL SYSTEM-ON-CHIP CONFERENCE, SOCC},
