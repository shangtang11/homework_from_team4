@article{ WOS:000637190300016,
Author = {Mach, Stefan and Schuiki, Fabian and Zaruba, Florian and Benini, Luca},
Title = {FPnew: An Open-Source Multiformat Floating-Point Unit Architecture for
   Energy-Proportional Transprecision Computing},
Journal = {IEEE TRANSACTIONS ON VERY LARGE SCALE INTEGRATION (VLSI) SYSTEMS},
