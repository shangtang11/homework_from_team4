@inproceedings{ WOS:000465118300020,
Author = {Bresch, Cyril and Chollet, Stephanie and Hely, David},
Book-Group-Author = {IEEE},
Title = {Towards an Inherently Secure Run-Time Environment for Medical Devices},
Booktitle = {2018 IEEE INTERNATIONAL CONGRESS ON INTERNET OF THINGS (ICIOT)},
Year = {2018},
Pages = {140-147},
Note = {3rd IEEE International Congress on Internet of Things (IEEE ICIOT) Part
   of the IEEE World Congress on Services, San Francisco, CA, JUL 02-07,
   2018},
Abstract = {Connected medical devices are promising in medical area. However, these
   devices are known to be poor in security and strongly vulnerable to code
   injection attacks. These attacks aim at modifying the run-time behavior
   of an application by violating its control flow graph. Control flow
   hijacking can lead hackers to remotely control medical application and
   endanger patient's life. This article focuses on devices and provides an
   overview of the different countermeasures that mitigate run-time
   attacks. Finally, from this state of the art, we will expose the
   perspectives and the ongoing work to make medical devices inherently
   more secure.},
