   Zhuang, Yuan, Wuhan Univ, Shenzhen Res Inst, Shenzhen 518057, Peoples R China.},
DOI = {10.1109/TIM.2025.3571159},
Article-Number = {8509213},
Keywords = {Laser radar; Odometry; Feature extraction; Point cloud compression;
   Bundle adjustment; Memory management; Computational efficiency; Windows;
   Simultaneous localization and mapping; Consistent LiDAR mapping; LiDAR
   bundle adjustment (BA); memory efficiency; optimization; SLAM; SLAM},
