@article{ WOS:001626333500001,
Author = {Jadhav, Seema Haribhau and Patil, Sangita Bapu and Sarwadnya, R. V.},
Title = {Enhancing torque control in brushless dc motors with hybrid fractional
   order PID controller approach},
Journal = {INTERNATIONAL JOURNAL OF ELECTRONICS},
Year = {2025},
Month = {2025 NOV 30},
Abstract = {Brushless Direct Current (BLDC) motors are widely used due to their
   efficiency and performance, utilising permanent magnets on the rotor and
   removing the requirement for brushes and commutators found in
   traditional motors. However, controlling torque and speed precisely
   remains challenging due to complex electronic controllers, leading to
   higher power consumption and decreased efficiency. This paper proposes a
   hybrid approach using a Fractional Order PID (FOPID) controller for
   enhanced torque control in BLDC motors. The hybrid technique combines
   the Red Panda Optimisation Algorithm (RPOA) and Local Randomised Neural
   Networks (LRNN), known as the RPOA-LRNN approach. The main objective is
   to minimise torque ripples and improve speed control. RPOA optimises the
   gain parameters of the FOPID controller, while LRNN predicts these
   parameters dynamically. The proposed method's performance is evaluated
   using MATLAB simulations and contrasted against existing strategies such
   as the Firefly Algorithm with Artificial Neural Networks (FA-ANN),
   Improved Genetic Algorithm Optimisation Fuzzy Controller (IGAOFC), and
   Emperor Penguin Optimisation (EPO) algorithm. Results demonstrate
   significant improvements, with torque ripples reduced to 14\% using the
   proposed RPOA-LRNN approach, compared to 28\% for FA-ANN and EPO, and
   23\% for IGAOFC. This highlights the proposed method's superiority for
   applications requiring smoother torque output.},
