@article{ WOS:001448327900001,
Author = {Yu, Andrew C. and Srimani, Tathagata and Shulaker, Max M.},
Title = {Overcoming Ambient Drift and Negative-Bias Temperature Instability in
   Foundry Carbon Nanotube Transistors},
Journal = {ACS APPLIED MATERIALS \& INTERFACES},
Year = {2025},
Volume = {17},
Number = {13},
Pages = {20411-20417},
Month = {MAR 18},
Abstract = {Carbon nanotube field-effect transistors (CNFETs) are promising
   candidates for back-end-of-line logic integration as a complementary
   path for continued electronic scaling. However, overcoming CNFET ambient
   drift (i.e., air stability) and reliability is underexplored. Here, we
   demonstrate that silicon nitride encapsulation limits ambient
   atmosphere-induced threshold voltage shift (similar to 8x reduction of
   median Delta V-T over 90 days). With stabilized nitride-encapsulated
   CNFETs, we characterize CNFET negative bias temperature instability
   (NBTI) with both DC and AC stress across the electric field,
   temperature, gate oxide thickness, and stress frequency. AC pulsed
   operation significantly improves CNFET NBTI vs DC operation across a
   wide frequency range of 1 kHz-10 MHz. A 20\% duty cycle AC operation at
   10 MHz could extend the NBTI time to failure by > 10(4)x vs DC for a
   target |Delta V-T| tolerance <= 100 mV with a gate bias V-GS,V-Stress =
   -1.2 V at 125 degrees C. This work improves our understanding of
   overcoming ambient drift and BTI reliability in CNFETs.},
Type = {Article},
Affiliation = {Srimani, T (Corresponding Author), Stanford Univ, Dept Elect Engn, Stanford, CA 94305 USA.
   Srimani, T (Corresponding Author), Carnegie Mellon Univ, Dept Elect \& Comp Engn, Pittsburgh, PA 15213 USA.
   Yu, Andrew C.; Shulaker, Max M., MIT, Dept Elect Engn \& Comp Sci, Cambridge, MA 02139 USA.
