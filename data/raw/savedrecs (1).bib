@article{ WOS:001502534900005,
Author = {Chen, Zhiwen and Li, Caihong and Yang, Yi and Li, Min and Wu, Yongwei
   and Chen, Zhongli},
Title = {MSVT: Multi-grained spatial and VMamba temporal for few-shot action
   recognition},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2025},
Volume = {288},
Month = {SEP 1},
Abstract = {Few-shot action recognition (FSAR) aims to recognize the novel classes
   of video actions with limited labeled samples. This task is gradually
   gaining popularity as a new research topic due to its potential
   practical value. Although recent methods have achieved excellent
   performance, they still suffer from two limitations: (i) The limitations
   of sample sparsity inherent in few-shot learning lead to the problem of
   model overfitting and poor generalization. (ii) The single learning of
   dependencies between adjacent frames ignores the spatial context
   information between objectives in the video. Therefore, we design a
   novel Multi-grained Spatial and VMamba Temporal (MSVT) enrichment method
   for few-shot action recognition. Specifically, we first develop a
   multi-grained spatial encoder to learn the spatial visual features and
   preserve the integrity of the objective visual semantic. Then, VMamba is
   introduced to FSAR and designs a novel temporal encoder. It performs
   encoding in both inter-frame temporal (horizontal) and intra-frame
   spatial (vertical) dimensions. Finally, we measure the match between the
   query and support videos with the designed compound prototype matching
   strategy. Extensive experiments on four public few-shot action
   recognition benchmarks show that MSVT can significantly outperform a
   variety of state-of-the-art few-shot action recognition methods on
   Kinetics, UCF101, HMDB51. Especially, MSVT achieves 77.2\%, 90.4\%, and
   62.1 \% on the Kinetics, UCF101, and HMDB51 with the 5-way 1-shot
   setting, respectively.},
Type = {Article},
