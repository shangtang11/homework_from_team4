@article{ WOS:001221642500001,
Author = {Safari, Mir Mahdi and Pourrostam, Jafar},
Title = {The role of analog signal processing in upcoming telecommunication
   systems: Concept, challenges, and outlook},
Journal = {SIGNAL PROCESSING},
Year = {2024},
Volume = {220},
Month = {JUL},
Abstract = {With the increasing demands in modern communications, the concepts of
   energy -efficient and low-cost processors have received a lot of
   attention from researchers in recent years. These cases are also taken
   into consideration in today's high-speed and high -capacity
   communications (HSHCC), which is one of the requirements in new
   generation of wireless networks i.e., 6G. International
   telecommunication union's (ITU) goal in wireless communications is to
   deliver higher data rates up to 10 Gbps, along with high spectral
   efficiency and advanced coverage. In multi -gigabit or terabit -per
   -second wireless communications, digital signal processing (DSP) faces
   significant challenges. Therefore, analog signal processing (ASP) and
   design methods based on it have gained a new importance recently. In
   today's modern telecommunication systems, ASP is used in areas such as
   the design of analog -to -digital converter (ADC) -less and also
   DAC-less transceivers, beamforming, secure communication, deep learning
   (DL), neural network accelerators (ANN), real-time phasers-based
   applications, Internet of things (IoT), etc. In this research, we
   describe and classify the works done in this field. This paper presents
   a comprehensive review of the ASP concept, challenges, and outlooks in
   modern and smart communications to pave the path for academic and
   industrial researchers who aim to work in this area.},
Type = {Review},
Affiliation = {Pourrostam, J (Corresponding Author), Univ Tabriz, Fac Elect \& Comp Engn, Tabriz, Iran.
   Safari, Mir Mahdi; Pourrostam, Jafar, Univ Tabriz, Fac Elect \& Comp Engn, Tabriz, Iran.},
DOI = {10.1016/j.sigpro.2024.109446},
EarlyAccessDate = {MAR 2024},
