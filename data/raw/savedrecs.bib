@article{ WOS:001664801600001,
Author = {Zhang, Qingyu and Yin, C. and Lv, Yqi},
Title = {A Flexible High-Performance Domain-Specific Vector RISC-V Processor For
   Post-Quantum Cryptography},
Journal = {IEICE ELECTRONICS EXPRESS},
Year = {2026},
Volume = {23},
Number = {6},
Pages = {1-6},
Month = {MAR 25},
Abstract = {A vector-processor architecture based on the RISC-V extended instruction
   set is proposed and evaluated for the acceleration of postquantum
   cryptographic(PQC) algorithms. The core employs an in-order, partially
   four-way multi-issue pipeline and delivers a significant speedup over
   pure-software RISC-V implementations. Unlike previous hardware-software
   co-designs that target specific PQC schemes, the instructionset
   extensions are derived from fine-grained, fixed-point arithmetic
   primitives; consequently, the same core can speed up current NIST
   candidates and tolerate future algorithm updates while remaining useful
   for other cryptographic workloads. The processor was implemented in 28nm
   SMIC HKE+ process, and post-layout simulations were conducted. Results
   showed that under primary PQC standards, compared with the
   state-of-the-art counterparts, it can achieve a reduction in total
   cycles by 9.1\%-12.7\%. In terms of stream cipher, block cipher, and
   hash cipher algorithms, it can achieve 12x- 24x performance improvement,
   which enables it to have higher flexibility in practical application
   scenarios.},
Type = {Article},
Affiliation = {Zhang, QY (Corresponding Author), Univ Elect Sci, Sch Automat Engn, Chengdu, Peoples R China.
   Zhang, Qingyu; Yin, C., Univ Elect Sci, Sch Automat Engn, Chengdu, Peoples R China.
