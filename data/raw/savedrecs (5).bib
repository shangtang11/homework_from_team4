@inproceedings{ WOS:001294429400079,
Author = {Tsampiras, Konstantinos and Liontos, Anastasios and Tenentes, Vasileios},
Book-Group-Author = {IEEE},
Title = {Evaluating Trusted Firmware Remote Attestation on ARM and RISC-V Edge
   Computing Prototypes},
Booktitle = {2024 13TH INTERNATIONAL CONFERENCE ON MODERN CIRCUITS AND SYSTEMS
   TECHNOLOGIES, MOCAST 2024},
Series = {International Conference on Modern Circuits and Systems Technologies},
Year = {2024},
Note = {13th International Conference on Modern Circuits and Systems
   Technologies (MOCAST), Sofia, BULGARIA, JUN 26-28, 2024},
Abstract = {During remote attestation, a platform must prove to a verifier authority
   that it is trustworthy and has not been altered in-the-field. There is
   an increased effort towards centralized and decentralized remote
   attestation, however there are not many physical platforms benchmarked
   for their remote attestation capabilities in the literature. In this
   paper, we present two prototypes that support remote attestation: one
   with a close architectture, based on an ARM microprocessor implemented
   on a Raspberry Pi 3 with an Infineon Trusted Platform Module (TPM); and
   another one with an open RISC-V microprocessor implemented on an Arty A7
   FPGA with the RV64GC RISCV core and the IBM virtual TPM 2.0.
   Furthermore, we conduct an experimental evaluation of the computational
   and networking cost of attestation during the execution of the
   attestation protocol between the implemented prototypes while
   considering cloud, virtual and physical verifier platforms. We provide
   insights on the mechanisms and cost of remote attestation for the
   attester, the verifier and the network, and we identify routines of
   trusted computing that can be optimized within an open CPU architecture.
   The identified performance gaps between close and open architectures,
   highlight challenges that need to be addressed by open architectures to
   match the performance of close architectures in security workloads.},
