@article{ WOS:001717581500020,
Author = {Sukumaran, Simi and Babu, P. S. and Gala, Neel and Warrier, Tripti S.},
Title = {P-Box: A RISC-V Packed-SIMD Approach of Accelerating Edge Workloads on
   Scalar Embedded Cores},
Journal = {IEEE ACCESS},
Year = {2026},
Volume = {14},
Pages = {40172-40189},
Abstract = {The growing need for data-parallel processing in edge devices demands
   efficient hardware acceleration for Digital Signal Processing (DSP),
   Computer Vision (CV), and Artificial Intelligence (AI) inference
   workloads. The RISC-V ISA, with its open and modular design, along with
   the Packed-SIMD (RVP) extension, offers an ideal foundation for scalable
   vectorisation in resource-constrained embedded systems. This work
   presents the first modular and fully compliant implementation of the
   RISC-V Packed-SIMD (RVP v0.9.11) extension in most configurable way to
   accelerate edge workloads on scalar cores. It uses a configurable
   framework to design both RV32 (P-Box32) and RV64 (P-Box64)
   architectures, and enables seamless integration into existing cores
   without extensive microarchitectural modifications. P-Box32 design is
   integrated with Azurite, a two-stage in-order core from InCore
   Semiconductors. Azurite with P-Box32 achieves maximum speedups of 4.9 \&
   times; in synthetic benchmarks covering DSP and CV applications on
   Xilinx Artix-7 FPGA. Real-world benchmark evaluations achieve
   performance gains up to 1.9 \& times; in ML-TinyPerf and 2 \& times; in
   CIFAR-10 image recognition while maintaining the same prediction
   accuracy as the Non-SIMD variant. At the 22 nm ASIC node, P-Box32 incurs
   a 25\% area overhead with a 16\% reduction in frequency closure on
   Azurite, surpassing the state of the art designs. Results demonstrate
   that RVP acceleration can be integrated efficiently within compact
   cores, to deliver significant performance gains for DSP, CV, Basic
   Linear Algebra Subprograms (BLAS), Security and AI workloads in
   next-generation edge processors.},
