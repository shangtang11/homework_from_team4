@inproceedings{ WOS:001546444800031,
Author = {Mhatre, Swapneel C.},
Book-Group-Author = {ACM},
Title = {Automatic Generation of Simulators for Processors with Accelerators
   Running in a Virtualized Environment},
Booktitle = {PROCEEDINGS OF THE 39TH ACM SIGSIM INTERNATIONAL CONFERENCE ON
   PRINCIPLES OF ADVANCED DISCRETE SIMULATION, ACM SIGSIM PADS 2025},
Year = {2025},
Pages = {192-193},
Note = {39th International Conference on Principles of Advanced Discrete
   Simulation-PADS, Santa Fe, NM, JUN 24-26, 2025},
Abstract = {Simulation remains central to evaluating innovations in computer
   architecture on target metrics. However, building or modifying
   simulators is laborious and prone to errors. Existing simulators for
   processors in a virtualized environment do not simulate the hypervisor
   instructions, leading to inaccuracy in the simulation. Many processors
   today are built with accelerators to enhance the speed of performing
   specific operations, and current simulators are not built to handle them
   effectively. Hence, this research aims to develop an approach for
   automatic generation of simulators for processors with accelerators that
   simulate the hypervisor instructions in a virtualized environment. The
   paper concludes that the proposed approach helps in accurately
   simulating the overhead due to virtualization and also in providing
   flexibility to the designer to explore a range of processor designs.},
