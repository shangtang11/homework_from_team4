@inproceedings{ WOS:000786411900078,
Author = {Singh, Sandeep Kumar and Agrawal, Kamal and Singh, Keshav and Li,
   Chih-Peng},
Book-Group-Author = {IEEE},
Title = {UAV-Assisted Hybrid Communication System with NOMA and Nonlinear Energy
   Harvesting},
Booktitle = {2021 IEEE 94TH VEHICULAR TECHNOLOGY CONFERENCE (VTC2021-FALL)},
Series = {IEEE Vehicular Technology Conference Proceedings},
Year = {2021},
Note = {94th IEEE Vehicular Technology Conference (VTC-Fall), ELECTR NETWORK,
   SEP 27-30, 2021},
Abstract = {In this work, we investigate an unmanned aerial vehicle (UAV)-aided
   novel hybrid wireless communication network consisting of a cellular
   user and a small internet of things (IoT) network having one low-power
   IoT hub which serves a sensor node. During the first signalling phase,
   the UAV-assisted base station (BS) uses non-orthogonal multiple access
   signalling to serve the cellular user and the IoT-hub, simultaneously.
   In the second phase, the cellular user uplinks the control signal to
   UAV-BS, whereas, at the same time the IoT-hub communicates with the
   sensor node using the power harvested by applying simultaneous wireless
   information and power transfer (SWIPT) and nonlinear energy harvesting.
   We derive the closed-form expressions of the achievable ergodic capacity
   of the cellular user and the IoT-hub during the first signalling phase
   and the sensor node and the UAV-BS during the second phase considering
   nonlinear energy harvesting at the IoT hub. Further, we demonstrate the
   trade-off between available transmit power at UAV-BS, IoT-hub (harvested
   power), and cellular user to achieve desired capacity at the sensor node
   and UAV-BS. We validate the accuracy of derived expressions by using
   numerical simulations.},
