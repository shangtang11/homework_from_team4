Affiliation = {Vanna-Iampikul, P (Corresponding Author), Georgia Inst Technol, 266 Ferst Dr, Atlanta, GA 30332 USA.
   Vanna-Iampikul, Pruek; Lu, Yi-Chen; Shim, Da Eun; Lim, Sung Kyu, Georgia Inst Technol, 266 Ferst Dr, Atlanta, GA 30332 USA.},
