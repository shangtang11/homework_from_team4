@article{ WOS:001522055100007,
Author = {Das, Kunal Kranti and Nisar, Arshid and Kaushik, Brajesh Kumar and
   Chattopadhyay, Anupam and Zahoor, Furqan},
Title = {Unified PUF and TRNG Design Using SOT-MTJ Crossbar Array},
Journal = {IEEE TRANSACTIONS ON MAGNETICS},
Year = {2025},
Volume = {61},
Number = {7},
Month = {JUL},
Abstract = {In the era of the Internet of Things (IoT), physically unclonable
   functions (PUFs) and true random number generators (TRNGs) are essential
   for ensuring hardware-level security and device authentication. This
   article presents a unified, simulation-based design of a dual-function
   PUF/TRNG using a spin-orbit torque magnetic tunnel junction (SOT-MTJ)
   crossbar array. The proposed architecture exploits the inherent
   stochastic switching behavior and process-induced resistance variations
   of SOT-MTJ devices to generate unique and random responses. Depending
   upon the application, the same hardware can seamlessly switch between
   PUF and TRNG functionalities, enhancing reconfigurability and area
   efficiency. The proposed design achieves low energy consumption of 0.2
   pJ/bit for the PUF and 0.3 pJ/bit for the TRNG, with respective
   throughputs of 8 and 0.333 Gb/s. The PUF demonstrates excellent
   performance with uniqueness of 50.15\%, uniformity of 51.6\%,
   bit-aliasing of 51.25\%, and perfect reliability of 100\%. The TRNG
   output passes all NIST statistical randomness tests without requiring
   post-processing. Compared to existing STT-MRAM- and RRAM-based
   solutions, the proposed design offers superior performance in terms of
   energy efficiency and randomness quality while providing
   reconfigurability between TRNG and PUF applications.},
Type = {Article},
Affiliation = {Kaushik, BK (Corresponding Author), Dept Elect \& Commun Engn, IIT Roorkee, Roorkee 247667, India.
