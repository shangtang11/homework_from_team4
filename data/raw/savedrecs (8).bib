Title = {Hardware Implementation of Network Interface Architecture for RISC-V
   based NoC-MPSoC Framework},
Booktitle = {2022 35TH INTERNATIONAL CONFERENCE ON VLSI DESIGN (VLSID 2022) HELD
   CONCURRENTLY WITH 2022 21ST INTERNATIONAL CONFERENCE ON EMBEDDED SYSTEMS
   (ES 2022)},
