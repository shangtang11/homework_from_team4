@article{ WOS:001682798600001,
Author = {Lu, Wenjuan and Zhang, Can and Hu, Wei and Gong, Xiaobo and Li, Zhihao
   and Xu, Shijie and Wu, Xiulong and Peng, Chunyu},
Title = {A Floating-Point SRAM Computing-in-Memory Macro Using Digital-Domain
   Structure for CNNs},
Journal = {IEEE TRANSACTIONS ON VERY LARGE SCALE INTEGRATION (VLSI) SYSTEMS},
Year = {2026},
Month = {2026 FEB 6},
Abstract = {With the increasingly complex computing requirements of convolutional
   neural networks (CNNs) in edge computing scenarios, computing-in-memory
   (CIM) has been proposed to address the bottlenecks of high data transfer
   energy consumption and long computing latency faced by traditional von
   Neumann architecture. This work proposes a floating-point (FP) CIM macro
   based on static random access memory (SRAM), which achieves
   high-efficiency CNN matrix multiplication and accumulation (MAC)
   operations. The main features of this work include: 1) dynamically
   configuring the maximum exponent to eliminate the exponent comparison
   operation while maintaining high inference accuracy; 2) introducing a
   dual-bit wordline-separated 6T SRAM cell (DWScell) and a mantissa
   computing cell (MCC) for full-precision and high-throughput mantissa
   multiplication; and 3) proposing a tailored 9T full adder (FA) and a 5T
   half adder (HA) to reduce the delay and area cost of both exponent and
   mantissa calculation. In a 28-nm CMOS process simulation environment,
   this macro achieved an energy efficiency (EF) of 4.81 TFLOPS/W when
   performing MAC operations on BF16-input and BF16-weight. Based on the
   ResNet50 network model, classification verification of the CIFAR-100
   dataset achieved an accuracy of 76.7\%.},
Type = {Article; Early Access},
Affiliation = {Wu, XL (Corresponding Author), Anhui Univ, Sch Integrated Circuits, Hefei 230601, Peoples R China.
   Lu, Wenjuan; Zhang, Can; Hu, Wei; Gong, Xiaobo; Li, Zhihao; Xu, Shijie; Wu, Xiulong; Peng, Chunyu, Anhui Univ, Sch Integrated Circuits, Hefei 230601, Peoples R China.},
DOI = {10.1109/TVLSI.2026.3656424},
EarlyAccessDate = {FEB 2026},
Keywords = {Computing-in-memory (CIM); convolutional neural networks (CNNs); dynamic
   configuration; floating-point (FP); multiplication and accumulation
   (MAC)},
Keywords-Plus = {UNIT-MACRO},
Author-Email = {xiulong@ahu.edu.cn},
Affiliations = {Anhui University},
Cited-References = {Chen PY, 2024, IEEE SOLID-ST CIRC L, V7, P299, DOI 10.1109/LSSC.2024.3418099.
   Chiu YC, 2020, IEEE J SOLID-ST CIRC, V55, P2790, DOI 10.1109/JSSC.2020.3005754.
