@article{ WOS:001675971500001,
Author = {Jiang, Bin and Wang, Xiangkai and He, Dongyi and Cheng, Siyu and Liao,
   Maoyu and Miao, Duoqian and Xia, Qingling and Zhao, Yun and Li, Gen},
Title = {A comprehensive review of deep learning for motor imagery EEG: From
   healthy subjects to patients},
Journal = {BIOMEDICAL SIGNAL PROCESSING AND CONTROL},
Year = {2026},
Volume = {117},
Month = {MAY 15},
Abstract = {Motor imagery-based electroencephalography (MI-EEG) decoding has become
   a foundational technique in braincomputer interface (BCI) systems,
   offering promising assistive and rehabilitative applications for
   individuals with motor impairments, including stroke, spinal cord
   injury, and Parkinson's diseases. This review provides a systematic and
   indepth survey of deep learning approaches for MI-EEG decoding, with a
   particular emphasis on fusion mechanisms across model architectures,
   subject populations, and data paradigms. We firstly categorize and
   examine representative models developed for healthy subjects under
   single-subject and cross-subject schemes, emphasizing their
   architectural evolution and limitations in generalization-thereby
   establishing the basis for subsequent structural fusion. Experimental
   results reveal substantial performance degradation when transferring
   these models to patient EEG data, underscoring the need for
   population-adaptive modeling. We further analyze recently proposed
   frameworks specifically designed for clinical populations, highlighting
   their structural flexibility and task-specific alignment. This
   structural complementarity between healthy-subject and patient-centric
   models exemplifies a cross-paradigm fusion strategy at the architectural
   level. Beyond model design, we systematically compare public datasets
   from healthy subjects, condition-specific datasets from patients, and
   institutionally curated clinical datasets. The comparative results
   identify a closed-loop fusion trend that promotes synergistic
   integration of heterogeneous data sources, paving the way for
   generalized yet personalized MI-EEG decoding. Finally, we outline
   current challenges and future research directions centered on multimodal
   fusion, lightweight modeling, and clinically deployable BCI systems.
   This review advocates a clinically informed fusion paradigm that bridges
   algorithm development and real-world rehabilitation, promoting
   patient-centered, generalizable, and portable MI-EEG decoding
   technologies.},
Type = {Review},
Affiliation = {Xia, QL (Corresponding Author), Chongqing Univ Technol, Sch Artificial Intelligence, Chongqing 401135, Peoples R China.
   Zhao, Y (Corresponding Author), Chongqing Polytech Univ Elect Technol, Sch Smart Hlth, Chongqing 401131, Peoples R China.
