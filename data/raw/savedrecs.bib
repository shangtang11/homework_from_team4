@article{ WOS:001668504700001,
Author = {Sun, Guiling and Kong, Yunlong and Zhang, Haicheng and Zheng, Bowen},
Title = {CFD: A Chiplet Function Decomposition method for edge computing tasks},
Journal = {MICROELECTRONICS JOURNAL},
Year = {2026},
Volume = {169},
Month = {MAR},
Abstract = {Chiplet technology has become a key enabler of next-generation computing
   systems, offering modularity and scalability beyond traditional
   monolithic SoCs. However, in edge computing, chiplet design still
   suffers from functional redundancy and performance degradation caused by
   inefficient task decomposition and excessive inter-chiplet
   communication. This paper proposes a Chiplet Function Decomposition
   (CFD) method to improve functional reuse and system efficiency in
   multi-task scenarios. Based on the Operator-Function-Task framework, CFD
   decomposes complex tasks into operator graphs and identifies reusable
   substructures through a common subgraph-based functional extraction
   approach. A redundancy reduction metric and performance loss model are
   introduced to balance modular reuse and computational cost. Experiments
   on two representative groups of image recognition tasks demonstrate that
   CFD effectively reduces functional redundancy while maintaining low
   performance overhead. These results demonstrate that CFD effectively
   enables scalable, reconfigurable, and efficient chiplet-based
   architectures for edge computing.},
