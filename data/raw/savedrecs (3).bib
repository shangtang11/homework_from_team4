@article{ WOS:001292759600001,
Author = {Spagnolo, Fanny and Vatalaro, Massimo and Perri, Stefania and Crupi,
   Felice and Corsonello, Pasquale},
Title = {C4TERO: Configurable Cascaded Carry Chains for High Reliability TERO
   PUFs on FPGAs},
Journal = {IEEE TRANSACTIONS ON CIRCUITS AND SYSTEMS I-REGULAR PAPERS},
Year = {2025},
Volume = {72},
Number = {2},
Pages = {561-572},
Month = {FEB},
Abstract = {In this paper we present a novel Transient Effect Ring Oscillator
   Physical Unclonable Function for FPGAs. It exploits in an original way
   the carry chain resources available in modern devices. The basic cell
   adopted in the proposed architecture can be runtime configured to
   implement different oscillation paths. This property enables the
   possibility to output more than one bit response per cell by choosing
   among the configurations those that exhibit the highest reliability.
   Such results are achieved by adopting a specific calibration process
   able to identify configurations of the cells showing the highest
   stability and the most uncorrelated responses. When implemented on
   several Series 7 Xilinx devices, no unstable bits were observed at 1 V
   and 25 \$<\^{}>\{\textbackslash{}circ\}\$ C. Under voltage variation in
   the manufacturer recommended ranges, a worst case bit error rate of
   0.046\% is achieved. The circuit designed as here described consists of
   64 cells, produces 128 response bits and consumes just 535
   look-up-tables and 256 carry chains.},
Type = {Article},
Affiliation = {Corsonello, P (Corresponding Author), Univ Calabria, Dept Informat Modeling Elect \& Syst Engn, I-87036 Arcavacata Di Rende, Italy.
   Spagnolo, Fanny; Vatalaro, Massimo; Crupi, Felice; Corsonello, Pasquale, Univ Calabria, Dept Informat Modeling Elect \& Syst Engn, I-87036 Arcavacata Di Rende, Italy.
   Perri, Stefania, Univ Calabria, Dept Mech Energy \& Management Engn, I-87036 Arcavacata Di Rende, Italy.},
DOI = {10.1109/TCSI.2024.3438362},
