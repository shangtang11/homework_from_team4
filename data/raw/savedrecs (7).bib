   Landauer, Derrek C., BlueHalo, Kirtland AFB, NM 87117 USA.
   Lovelly, Tyler M., Air Force Res Lab, Kirtland AFB, NM USA.},
DOI = {10.1109/SCC57168.2023.00014},
