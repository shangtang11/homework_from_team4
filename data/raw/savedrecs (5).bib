@inproceedings{ WOS:001229692400079,
Author = {Levy, Akash and Walston, Joe and Samanta, Sourav and Raina, Priyanka and
   Diamantidis, Stelios},
Book-Group-Author = {IEEE},
Title = {FastPASE: An AI-Driven Fast PPA Speculation Engine for RTL Design Space
   Optimization},
Booktitle = {2024 25TH INTERNATIONAL SYMPOSIUM ON QUALITY ELECTRONIC DESIGN, ISQED
   2024},
Series = {International Symposium on Quality Electronic Design},
Year = {2024},
Note = {25th International Symposium on Quality Electronic Design (ISQED), San
   Francisco, CA, APR 03-05, 2024},
Abstract = {We develop a tool called FastPASE to rapidly predict design metrics such
   as power, performance, and area from RTL using graph convolutional
   networks. FastPASE encodes elaborated RTL netlists as dataflow graphs
   and applies fan-in/fan-out convolutions based on the connectivity of the
   nodes. We apply FastPASE to three design case studies: (1) a
   configurable single instruction multiple data (SIMD) IP, (2) SweRV, an
   open-source RISC-V core, and (3) randomly-generated combinational RTL.
   We find that depending on design size, FastPASE can produce predictions
   16.7x-155x faster than a commercial physical design tool run up to
   placement, with average normalized mean absolute error (NMAE) of 13\%
   across all metrics tested for SIMD unit and RISC-V core. On SweRV, we
   demonstrate that using FastPASE as a proxy metric engine during RTL
   design space optimization produces improved aggregate design scores in
   similar to 13x less time than using full physical design runs. In this
   context, our tool enables RTL designers to quickly explore the RTL
   design space and determine the right parameter settings for a particular
   set of silicon design goals.},
Type = {Proceedings Paper},
Affiliation = {Levy, A (Corresponding Author), Stanford Univ, Dept Elect Engn AI, Stanford, CA 94305 USA.
   Levy, Akash; Raina, Priyanka, Stanford Univ, Dept Elect Engn AI, Stanford, CA 94305 USA.
