@article{ WOS:001709147500022,
Author = {Essahraui, Siham and Lamaakal, Ismail},
Title = {A Comprehensive Survey of TinyML-Based Biometric Recognition for IoT
   Edge Devices},
Journal = {IEEE INTERNET OF THINGS JOURNAL},
Year = {2026},
Volume = {13},
Number = {6},
Pages = {10564-10588},
Month = {MAR 15},
Abstract = {The integration of tiny machine learning (TinyML) with human biometric
   recognition constitutes a significant advancement in enabling secure,
   efficient, and real-time identity verification on resource-constrained
   embedded devices. This article provides the first comprehensive survey
   exploring this integration, encompassing both physiological modalities,
   such as fingerprint, face, and iris recognition, and behavioral
   modalities, including gait, voice, and keystroke dynamics. The
   foundational principles of TinyML are introduced, alongside a discussion
   of key enabling techniques, such as quantization, pruning, and the
   design of lightweight neural network architectures. A structured
   taxonomy of biometric applications is proposed, organizing recent
   research into five principal domains: wearable devices, smart home and
   IoT security, healthcare monitoring, access control systems, and
   surveillance. In addition, the survey critically evaluates the
   limitations of current TinyML-based biometric implementations,
   highlighting challenges related to memory and computational constraints,
   inference latency, robustness under varying conditions, privacy
   preservation, and lack of standardization. Finally, prospective research
   directions are outlined, emphasizing advances in federated learning
   (FL), Tiny AutoML, multimodal fusion, and neuromorphic computing.
   Collectively, this work provides a comprehensive reference to guide
   researchers and practitioners in the development of reliable,
   privacy-aware, and highly efficient edge-deployed biometric recognition
   systems.},
Type = {Article},
