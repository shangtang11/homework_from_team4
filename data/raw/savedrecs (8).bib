Author = {Niederhagen, Ruben and Roth, Johannes and Waelde, Julian},
Editor = {Batina, L and Daemen, J},
Title = {Streaming SPHINCS plus for Embedded Devices Using the Example of TPMs},
Booktitle = {PROGRESS IN CRYPTOLOGY - AFRICACRYPT 2022},
