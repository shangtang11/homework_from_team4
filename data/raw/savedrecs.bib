@article{ WOS:001719578000001,
Author = {Chen, Chaojie and Wu, Xingcai and Xiao, Yuanyuan and Yu, Peijia and
   Wang, Qi},
Title = {DHS-ViG: Dynamic hierarchical selective graph for comprehensive and
   robust feature perception},
Journal = {NEUROCOMPUTING},
Year = {2026},
Volume = {680},
Month = {JUN 1},
Abstract = {Vision graph neural networks (ViGs) have been proven to effectively
   capture complex relationships and structural information for visual data
   through graph modeling. However, current ViGs often rely on a fixed
   number of neighbor interactions at each stage, which limits their
   ability to learn visual features of various sizes. Moreover, as the
   network deepens, lower-level visual semantics tend to be aggregated and
   potentially discarded, resulting in a less comprehensive representation
   of higher-level features. To address these challenges, we propose a
   dynamic hierarchical selective vision graph convolutional network
   (DHS-ViG) that enhances the representation of low-level semantic
   features. Our approach includes a hierarchical selective graph (HSG)
   block that can focus on important nodes by constructing hierarchical
   graphs and dynamic selective graph convolution, providing various
   receptive fields and emphasizing key semantic features of different
   sizes. Additionally, a mid-level semantic adapter (MSA) is designed to
   address the information loss in deeper stages by retaining low-level
   semantic information. Extensive analysis and experiments on various
   tasks validate the effectiveness of our approach, with DHS-ViG-Ti
   achieving a top-1 accuracy of 79.2\% on ImageNet, surpassing Pyramid
   ViG-Ti by 1\%. This performance highlights the critical role that
   DHS-ViG plays in enhancing the learning of low-level semantic
   information, proving essential in visual tasks. Our code is available at
   https://github.com/GZU-SAMLab/DHS-ViG.},
Type = {Article},
Affiliation = {Wang, Q (Corresponding Author), Guizhou Univ, Coll Comp Sci \& Technol, State Key Lab Publ Big Data, Guiyang 550025, Peoples R China.
