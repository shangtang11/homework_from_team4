@inproceedings{ WOS:001596652300154,
Author = {Mohith, V and Borah, Shekhar Suman and Sundaravadivel, Prabha and
   Sakthivel, R.},
Book-Group-Author = {ACM},
Title = {Multi-Parameter Comparative Study of Selective In-Memory Computing
   Processor Architectures for Performance Optimization in Accelerated Edge
   Computing},
Booktitle = {PROCEEDINGS OF THE GREAT LAKES SYMPOSIUM ON VLSI 2025, GLSVLSI 2025},
Year = {2025},
Pages = {1002-1007},
Note = {35th Great Lakes Symposium on VLSI-GLSVLSI, New Orleans, LA, JUN 30-JUL
   02, 2025},
Abstract = {In-memory computing (IMC) represents a transformative method for data
   processing, addressing the inefficiencies associated with data transfer
   between memory and processing units. Integrating computation within
   memory enhances performance for data-intensive applications such as
   artificial intelligence, machine learning, big data analytics, and edge
   computing.This study emphasizes the capability of IMC to revolutionize
   computational frameworks by tackling the memory wall and energy
   limitations, thereby fostering advancements in hardware design and
   software optimization to satisfy the requirements of future computing
   tasks. This paper discusses IMC featuring specific memory devices and
   the corresponding IMC architecture designed for edge applications. The
   comprehensive review indicates that ReRAM memory technology is optimally
   suited for AI-driven and Edge applications within an IMC architecture.},
Type = {Proceedings Paper},
Affiliation = {Mohith, V (Corresponding Author), Vellore Inst Technol, Vellore, Tamil Nadu, India.
   Mohith, V; Sakthivel, R., Vellore Inst Technol, Vellore, Tamil Nadu, India.
