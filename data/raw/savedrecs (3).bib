@inproceedings{ WOS:001596652300073,
Author = {Suresh, Arjun and Burra, Hari Narayana and Chen, Wei-Huan and Holcomb,
   Daniel},
Book-Group-Author = {ACM},
Title = {Security Aware Placement for Split Manufactured Integrated Circuit
   Design Flows},
Booktitle = {PROCEEDINGS OF THE GREAT LAKES SYMPOSIUM ON VLSI 2025, GLSVLSI 2025},
Year = {2025},
Pages = {470-477},
Note = {35th Great Lakes Symposium on VLSI-GLSVLSI, New Orleans, LA, JUN 30-JUL
   02, 2025},
Abstract = {The globalized supply chain of integrated circuit production relies on
   outsourced facilities for fabrication in advanced nodes. In this
   setting, it is important to harden designs against hardware reverse
   engineering and trojan insertion by untrusted foundries. Split
   fabrication has been discussed as a solution. In a split manufacturing
   flow, the physical layout of the target design is partitioned into two
   parts. An advanced node untrusted foundry fabricates transistors and
   lower metals, and a trusted foundry then completes the design by adding
   the upper metals. The security of split fabrication requires that the
   untrusted foundry, given their available information, views multiple
   variants of the design as equally viable. In this paper we propose and
   realize a novel concept of simultaneously co-optimizing the physical
   design of all the viable variants to improve performance. The
   optimization is guided by information that is already allowed to the
   untrusted foundry, ensuring that security is preserved. We validate our
   methodology with benchmark circuits across a range of security levels
   and show that our PPA costs are optimized in conjunction with the
   security requirement. Specifically, we find that our flow improved
   power, maximum operating frequency and wirelength on our benchmark
   circuits by an average by 12.55\%, 41.16\% and 16.49\% respectively when
   compared to non security-aware placement techniques.},
Type = {Proceedings Paper},
Affiliation = {Suresh, A (Corresponding Author), Univ Massachusetts Amherst, Amherst, MA 01003 USA.
   Suresh, Arjun; Burra, Hari Narayana; Chen, Wei-Huan; Holcomb, Daniel, Univ Massachusetts Amherst, Amherst, MA 01003 USA.},
