Pages = {65-68},
Month = {JUL-DEC},
Abstract = {We propose the concept of security socket to protect the integration of
   loosely-coupled accelerators in system-on-chip (SoC) architectures. The
   socket is placed between an accelerator and the rest of the SoC and
   provides security services that are completely decoupled from the
   accelerator implementation. Any accelerator can be plugged into the
   socket and transparently benefit from all the security services.},
