Title = {A 12nm Agile-Designed SoC for Swarm-Based Perception with Heterogeneous
   IP Blocks, a Reconfigurable Memory Hierarchy, and an 800MHz Multi-Plane
   NoC},
Booktitle = {ESSCIRC 2022- IEEE 48TH EUROPEAN SOLID STATE CIRCUITS CONFERENCE
   (ESSCIRC)},
Year = {2022},
