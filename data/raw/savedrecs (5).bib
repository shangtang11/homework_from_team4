@inproceedings{ WOS:001323546200047,
Author = {Singla, Anmol and Kushwaha, Dinesh and Aman, Gulyawar and Chakraborty,
   Shubhradip and Goel, Abhishek and Bulusu, Anand and Dasgupta, Sudeb},
Book-Group-Author = {IEEE},
Title = {An Energy-Efficient SRAM-based Charge Domain Compute In-Memory
   Architecture},
Booktitle = {2024 22ND IEEE INTERREGIONAL NEWCAS CONFERENCE, NEWCAS 2024},
Series = {IEEE International New Circuits and Systems Conference},
Year = {2024},
Pages = {233-237},
Note = {22nd IEEE Interregional NEWCAS Conference (NEWCAS), Sherbrooke, CANADA,
   JUN 16-19, 2024},
Abstract = {This paper presents an energy-efficient and low-latency approach for
   performing a large number of Multiply and Accumulate (MAC) operations in
   Deep Neural Networks (DNNs) using a Compute In-Memory (CIM) approach
   based on SRAM. The proposed design utilizes a 10T1C bit-cell, offering
   robustness and linearity advantages over competing architectures. A
   Voltage-to-Time Converter (VTC) cell based on a current-starve approach
   is employed to convert the analog voltage domain to time domain.
   Furthermore, a Time-to-Digital Converter (TDC) is utilized to reduce
   hardware costs. The implemented 128x64 SRAM-based CIM macro uses 45nm
   CMOS technology. The proposed design achieves an energy efficiency of
   740.39 TOPS/W with a latency of 4 nanoseconds at 1.0V. Additionally, the
   macro achieves an accuracy of 94.4\% when evaluated on the MNIST
   dataset. The designed architecture achieves a high throughput of 4096
   GOPS, effectively addressing issues related to read-write disturb, power
   consumption, and hardware costs prevalent in existing state-of-the-art
   solutions. By integrating the proposed CIM approach with the 10T1C
   bit-cell, VTC, and TDC, this research offers an efficient and
   cost-effective solution for performing MAC operations in DNNs. High
   throughput, energy efficiency, low latency, and accuracy make this
   design highly promising for accelerating deep-learning tasks.},
