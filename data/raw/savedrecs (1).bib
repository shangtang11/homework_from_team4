@article{ WOS:001506151100005,
Author = {Done, Yves and DU Val, Louis and Lachaize, Renaud and Felber, Pascal and
   Hagimont, Daniel and Tchana, Alain},
Title = {Understanding Intel User Interrupts},
Journal = {PROCEEDINGS OF THE ACM ON MEASUREMENT AND ANALYSIS OF COMPUTING SYSTEMS},
Year = {2025},
Volume = {9},
Number = {2},
Month = {JUN},
Abstract = {User interrupts (UINTR) is a new hardware feature available in recent
   Intel Xeon processors. It enables a CPU to send, receive, and handle
   hardware inter-processor interrupts directly in user mode, meaning
   without the intervention of the OS kernel. In this paper, we shed light
   on the inner working of this facility and investigate, with detailed
   performance and overhead measurements considering deployments on
   physical machines and virtual machines with Linux and KVM, how it can be
   leveraged for more efficient inter-process communications, as an
   alternative to OS (Unix) signals. With UINTR, preemptive user-level
   thread schedulers can achieve quantum lengths in the microsecond scale.},
Type = {Article},
Affiliation = {Done, Y (Corresponding Author), Univ Toulouse, IRIT, CNRS, Toulouse INP,UT3 Toulouse, Toulouse, France.
   Done, Yves; Hagimont, Daniel, Univ Toulouse, IRIT, CNRS, Toulouse INP,UT3 Toulouse, Toulouse, France.
