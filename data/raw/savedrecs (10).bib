@inproceedings{ WOS:000568277400029,
Author = {Shukla, Satyam and Ray, Kailash Chandra},
Book-Group-Author = {IEEE},
Title = {Design and ASIC Implementation of a Reconfigurable Fault-Tolerant ALU
   for Space Applications},
Booktitle = {2019 IEEE INTERNATIONAL SYMPOSIUM ON SMART ELECTRONIC SYSTEMS (ISES
   2019)},
Year = {2019},
Pages = {156-159},
Note = {5th IEEE International Symposium on Smart Electronic Systems (iSES)
   (Formerly iNiS), Rourkela, INDIA, SEP 16-18, 2019},
Abstract = {Electronic devices operating in space suffer from damage due to cosmic
   rays, hence for such applications, radiation effects are the primary
   concern. With technology scaling, semiconductor devices are achieving
   high performance, low power, and less area, but it increases the
   radiation degradation and makes the integrated circuit vulnerable to
   error. In this paper, we have discussed the phenomena of Single Event
   Upset (SEU) and proposed a reconfigurable Arithmetic Logic Unit (ALU) to
   mitigate the degradation due to SEU. The designed ALU can be configured
   to either work in `normal\_mode' or RadHard\_mode' based on a control
   signal. The design has three identical ALUs; in `normal mode' of
   operation, only one ALU is active, and in RadHard mode' it uses two
   redundant ALUs to mitigate the effect of SEU. Errors were inserted
   during the simulation to test the fault tolerance capability of the
   design. ASIC (Application Specific Integrated Circuit) implementation
   was done using 180mn CMOS technology; the reported area was 69013 mu
   m(2) and power was 4.035mW. This approach may be power efficient
   compared to the traditional TMR (Triple Modular Redundancy) approach in
   which all the redundant blocks are always active, independent of
   operating environment.},
Type = {Proceedings Paper},
Affiliation = {Shukla, S (Corresponding Author), Indian Inst Technol, Dept Elect Engn, Patna 801103, Bihar, India.
   Shukla, Satyam; Ray, Kailash Chandra, Indian Inst Technol, Dept Elect Engn, Patna 801103, Bihar, India.},
DOI = {10.1109/iSES47678.2019.00042},
Keywords = {Reliable computing; Fault-tolerant ALU; Single Event Upset; Radiation
   hardened design},
