@article{ WOS:001166816300001,
Author = {Xiao, Zheng and Chen, Weijie and Qin, Yunchuan and Wu, Fan and
   Chronopoulos, Anthony Theodore and Nicolau, Alex and Li, Kenli},
Title = {NGLIC: A Nonaligned-Row Legalization Approach for 3-D Interdie
   Connection},
Journal = {IEEE TRANSACTIONS ON COMPUTER-AIDED DESIGN OF INTEGRATED CIRCUITS AND
   SYSTEMS},
Year = {2024},
