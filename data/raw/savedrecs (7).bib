@article{ WOS:000856129900031,
Author = {Chhabria, Vidya A. and Sapatnekar, Sachin S.},
Title = {OpeNPDN: A Neural-Network-Based Framework for Power Delivery Network
   Synthesis},
Journal = {IEEE TRANSACTIONS ON COMPUTER-AIDED DESIGN OF INTEGRATED CIRCUITS AND
   SYSTEMS},
Year = {2022},
Volume = {41},
Number = {10},
Pages = {3515-3528},
Month = {OCT},
Abstract = {Power delivery network (PDN) design is a nontrivial, time-intensive, and
   iterative task. Correct PDN design must consider power bumps, currents,
   blockages, and signal congestion distribution patterns. This work
   proposes a machine learning-based methodology that employs a set of
   predefined PDN templates. At the floorplan stage, coarse estimates of
   current, congestion, macro/blockages, and C4 bump distributions are used
   to synthesize a grid for early design. At the placement stage, the grid
   is incrementally refined based on more accurate and fine-grained
   distributions of current and congestion. At each stage, a convolutional
   neural network (CNN) selects an appropriate PDN template for each region
   on the chip, building a safe-by-construction PDN that meets IR drop and
   electromigration (EM) specifications. The CNN is initially trained using
   a large synthetically created dataset, following which transfer learning
   is leveraged to bridge the gap between real-circuit data (with a limited
   dataset size) and synthetically generated data. On average, the
   optimization of the PDN frees thousands of routing tracks in
   congestion-critical regions, when compared to a globally uniform PDN,
   while staying within the IR drop and EM limits.},
Type = {Article},
Affiliation = {Chhabria, VA (Corresponding Author), Univ Minnesota, Dept Elect \& Comp Engn, Minneapolis, MN 55414 USA.
   Chhabria, Vidya A.; Sapatnekar, Sachin S., Univ Minnesota, Dept Elect \& Comp Engn, Minneapolis, MN 55414 USA.},
