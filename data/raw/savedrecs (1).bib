@article{ WOS:001476511200008,
Author = {Xiao, Liang and Liu, Huanhuan and Lv, Zefang and Chen, Yifan and Lin,
   Zhiping and Du, Yousong},
Title = {Reinforcement-Learning-Based APT Defense for Large-Scale Smart Grids},
Journal = {IEEE INTERNET OF THINGS JOURNAL},
Year = {2025},
Volume = {12},
Number = {9},
Pages = {11917-11925},
Month = {MAY 1},
Abstract = {Reinforcement-learning-(RL)-based advanced persistent threats (APTs)
   defense schemes choose the scan interval to enhance the detection
   accuracy, and the data protection level can be further improved by
   optimizing the repair rate corresponding to methods, such as malicious
   files removal, security software version update and passwords reset,
   each requiring different computational resources, such as CPUs. In this
   article, we propose an RL-based APT defense scheme to optimize both the
   continuous scan interval of metering data and repair rate to mitigate
   the potential loss for meter data management systems (MDMSs) in smart
   grids with large-scale meters. Based on the size of the metering data
   stored at MDMS and the compromised data, the data tag granularity and
   the number of CPUs for repairing, neural networks extract the state
   feature, address the quantization error of defense policy, and update
   the weights based on the APT defense experiences and the shared weights
   of neighboring MDMSs to improve the defense performance as a weighted
   sum of the defense duration, detection accuracy and data protection
   level. The computational complexity of the proposed scheme and the
   performance bounds according to the Nash Equilibrium of the game between
   the MDMS and the APT attacker are provided. Simulation results based on
   three MDMSs that receive the metering data from 50-150 smart meters and
   an APT attacker with the selected attack interval up to 5 s show the
   performance gain over the benchmark based on the optimal control theory
   and Q-learning in large-scale smart grids.},
Type = {Article},
Affiliation = {Xiao, L (Corresponding Author), Xiamen Univ, Dept Informat \& Commun Engn, Xiamen 361005, Peoples R China.
