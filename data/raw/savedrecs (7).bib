@inproceedings{ WOS:001073659300045,
Author = {Oh, Hyun Woo and An, Seongmo and Jeong, Won Sik and Lee, Seung Eun},
Book-Group-Author = {IEEE},
Title = {RF2P: A Lightweight RISC Processor Optimized for Rapid Migration from
   IEEE-754 to Posit},
Booktitle = {2023 IEEE/ACM INTERNATIONAL SYMPOSIUM ON LOW POWER ELECTRONICS AND
   DESIGN, ISLPED},
Year = {2023},
Note = {IEEE/ACM International Symposium on Low Power Electronics and Design
   (ISLPED), Vienna, AUSTRIA, AUG 07-08, 2023},
Abstract = {This paper presents a lightweight processor and evaluation platform for
   migrating from IEEE-754 to posit arithmetic, with an optimized posit
   arithmetic unit (PAU) supporting existing floating-point instructions.
   The PAU features a reconfigurable divider architecture for diverse
   operating conditions and lightweight square root logic. The platform
   includes a posit-optimized compiler, divider generator, JTAG environment
   builder, and programmable logic controller. The experimental results
   demonstrate the successful execution of legacy IEEE-754 code with a
   small additional workload and up to 60.09 times the performance
   improvement through hardware acceleration. Additionally, the PAU and
   divider consume 11.00\% and 57.87\% fewer LUTs, respectively, compared
   to the best prior works.},
Type = {Proceedings Paper},
Affiliation = {Lee, SE (Corresponding Author), Seoul Natl Univ Sci \& Technol, Dept Elect Engn, Seoul 01811, South Korea.
   Oh, Hyun Woo; An, Seongmo; Jeong, Won Sik; Lee, Seung Eun, Seoul Natl Univ Sci \& Technol, Dept Elect Engn, Seoul 01811, South Korea.},
DOI = {10.1109/ISLPED58423.2023.10244582},
Keywords = {real number arithmetic; processor core; hardware acceleration; reduced
