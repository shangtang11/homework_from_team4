@article{ WOS:001409831400001,
Author = {Shen, Hongxiang and Han, Zeyu and Li, Zongyuan and He, Yuxing and
   Yoshikawa, Nobuyuki},
Title = {Design and fabrication of integrator using adiabatic
   quantum-flux-parametron circuit},
Journal = {SUPERCONDUCTOR SCIENCE \& TECHNOLOGY},
Year = {2025},
Volume = {38},
Number = {2},
Month = {FEB 1},
Abstract = {We believe that the adiabatic quantum flux parametron (AQFP) circuit, as
   a novel low-power superconducting circuit technology, has potential
   application in various fields, including utilizing its high precision to
   determine the phase of input signals. To improve the precision of AQFP
   circuits, it is crucial to reduce the gray zone of the system. In this
   paper, we investigate a digital integration method to reduce the gray
   zone and enhance the precision of the AQFP circuits. Theoretical
   analysis demonstrates that the gray zone narrows, and the precision of
   the system improves as more data points are integrated. Additionally, we
   establish the quantitative relationship between the reduction in gray
   zone and the number of integrated data points. To validate these
   findings, we fabricate AQFP integrator circuits and perform experimental
   verification. Furthermore, we estimate the relationship between the
   scale of the integration circuit and the chip area, emphasizing
   possibilities for various future application scenarios.},
