@inproceedings{ WOS:001429154700002,
Author = {Ahmed, Fahim and Arafin, Md Tanvir},
Book-Group-Author = {ASSOC COMPUTING MACHINERY},
Title = {SANTA: A Spatial Accelerator Design for Efficient Number Theoretic
   Transform (NTT) on Heterogeneous System-on-Chips},
Booktitle = {PROCEEDINGS OF THE 2024 WORKSHOP ON ATTACKS AND SOLUTIONS IN HARDWARE
   SECURITY, ASHES 2024},
Year = {2024},
Pages = {2-10},
Note = {2024 Workshop on Attacks and Solutions in Hardware Security, UT, OCT
   14-18, 2024},
Abstract = {Recent developments in lattice-based post-quantum cryptographic (PQC)
   algorithms are drawing attention to their implementation on low-power
   edge devices. Number theoretic transform (NTT) is the core mathematical
   operation of the lattice-based PQC algorithm. Hence, a power-efficient
   NTT accelerator is the fundamental building block of edge
   device-friendly PQC implementation. This paper presents SANTA, the
   world's first accelerator for NTT computation on AMD's Versal (R)
   Adaptive System on Chip (ASoC), an edge-application-oriented spatial
   computation system. We leverage ASoC's single instruction multiple data
   (SIMD) feature in our proposed accelerator design by vectorizing the NTT
   computation to achieve speed gain. We further accelerate the NTT
   computation by utilizing the two-dimensional spatial computing
   architecture of the ASoC platform to distribute the workload for
   parallel processing. We also evaluate the runtime and power consumption
   of our proposed NTT accelerator on AMD's Versal VCK190 evaluation board.
   Our results show that edge deployable spatial accelerators can
   significantly improve performance over traditional CPUs. For 4096-point
   NTT, SANTA demonstrates 2.8x speed gain over the state-of-the-art CPU
   implementation. We have published this work's open-source codes at
   https://github.com/SPIRE-GMU/ACAP\_NTT.},
Type = {Proceedings Paper},
Affiliation = {Ahmed, F (Corresponding Author), George Mason Univ, Fairfax, VA 22030 USA.
   Ahmed, Fahim; Arafin, Md Tanvir, George Mason Univ, Fairfax, VA 22030 USA.},
DOI = {10.1145/3689939.3695781},
Keywords = {Number Theoretic Transform; Lattice-Based Cryptography; Spatial
   Computing; Versal ASoC Architecture},
Author-Email = {fahmed42@gmu.edu
   marafin@gmu.edu},
Affiliations = {George Mason University},
