@inproceedings{ WOS:001316065000072,
Author = {Cecchetti, Ethan and Yao, Siqiu and Ni, Haobin and Myers, Andrew C.},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Compositional Security for Reentrant Applications},
Booktitle = {2021 IEEE SYMPOSIUM ON SECURITY AND PRIVACY, SP},
Series = {IEEE Symposium on Security and Privacy},
Year = {2021},
Pages = {1249-1267},
Note = {42nd IEEE Symposium on Security and Privacy (SP), ELECTR NETWORK, MAY
   24-27, 2021},
Abstract = {The disastrous vulnerabilities in smart contracts sharply remind us of
   our ignorance: we do not know how to write code that is secure in
   composition with malicious code. Information flow control has long been
   proposed as a way to achieve compositional security, offering strong
   guarantees even when combining software from different trust domains.
   Unfortunately, this appealing story breaks down in the presence of
   reentrancy attacks. We formalize a general definition of reentrancy and
   introduce a security condition that allows software modules like smart
   contracts to protect their key invariants while retaining the expressive
   power of safe forms of reentrancy. We present a security type system
   that provably enforces secure information flow; in conjunction with
   run-time mechanisms, it enforces secure reentrancy even in the presence
   of unknown code; and it helps locate and correct recent high-profile
   vulnerabilities.},
Type = {Proceedings Paper},
Affiliation = {Cecchetti, E (Corresponding Author), Cornell Univ, Ithaca, NY 14853 USA.
   Cecchetti, Ethan; Yao, Siqiu; Ni, Haobin; Myers, Andrew C., Cornell Univ, Ithaca, NY 14853 USA.},
DOI = {10.1109/SP40001.2021.00084},
Keywords = {information flow control; language-based security; integrity; smart
   contracts},
Author-Email = {ethan@cs.cornell.edu
   yaosiqiu@cs.cornell.edu
   haobin@cs.cornell.edu
   andru@cs.cornell.edu},
Affiliations = {Cornell University},
Cited-References = {Albert E, 2020, P ACM PROGRAM LANG, V4, DOI 10.1145/3428277.
