@article{ WOS:000689365300001,
Author = {Xie, Yunong and Zhang, Zhiyong},
Title = {Carbon nanotube-based CMOS transistors and integrated circuits},
Journal = {SCIENCE CHINA-INFORMATION SCIENCES},
