@article{ WOS:000859098800001,
Author = {Stangherlin, Kleber and Sachdev, Manoj},
Title = {Design and Implementation of a Secure RISC-V Microprocessor},
Journal = {IEEE TRANSACTIONS ON VERY LARGE SCALE INTEGRATION (VLSI) SYSTEMS},
Year = {2022},
Volume = {30},
Number = {11},
Pages = {1705-1715},
Month = {NOV},
Abstract = {Secret keys can be extracted from the power consumption or
   electromagnetic emanations of unprotected devices. Traditional
   countermeasures have a limited scope of protection and impose several
   restrictions on how sensitive data must be manipulated. We demonstrate a
   bit-serial RISC-V microprocessor implementation with no plain-text data.
   All values are protected using Boolean masking. Software can run with
   little to no countermeasures, reducing code size and performance
   overheads. Unlike previous literature, our methodology is fully
   automated and can be applied to designs of arbitrary size or complexity.
   We also provide details on other key components, such as clock
   randomizer, memory protection, and random number generator (RNG). The
   microprocessor was implemented in 65-nm CMOS technology. Its
   implementation was evaluated using NIST tests and side-channel attacks.
   Random numbers generated with our RNG pass on all NIST tests. The
   side-channel analysis on the baseline implementation extracted the
   advanced encryption system (AES) key using only 375 traces, while our
   secure microprocessor was able to withstand attacks using 20M traces.},
Type = {Article},
Affiliation = {Stangherlin, K (Corresponding Author), Univ Waterloo, Elect \& Comp Engn ECE Dept, Waterloo, ON N2L 3G1, Canada.
   Stangherlin, Kleber; Sachdev, Manoj, Univ Waterloo, Elect \& Comp Engn ECE Dept, Waterloo, ON N2L 3G1, Canada.},
