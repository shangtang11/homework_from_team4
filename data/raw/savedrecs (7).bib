@inproceedings{ WOS:001221819200266,
Author = {Wang, Haoyan and Ye, Yunong and Li, Wei and Wang, Zhiqiang and Liu, Jie},
Book-Group-Author = {IEEE},
Title = {Research on Modeling and IP Technology for High-Speed Optical
   Interconnection Interfaces in Optoelectronic Microsystems},
Booktitle = {2023 24TH INTERNATIONAL CONFERENCE ON ELECTRONIC PACKAGING TECHNOLOGY,
   ICEPT},
Series = {International Conference on Electronic Packaging Technology},
Year = {2023},
Note = {24th International Conference on Electronic Packaging Technology
   (ICEPT), Shihezi, PEOPLES R CHINA, AUG 08-11, 2023},
Abstract = {The exponential growth in data communications and processing has
   resulted in significant advancements in high reliability, big volume,
   and low-latency data transmission technology. However, due to
   limitations in data transmission between nodes, the collaborative and
   parallel computing capabilities of systems are severely restricted by
   the bandwidth of electrical interconnection. This has created a need for
   optoelectronic microsystem integration. To meet this need, a range of
   integrated photonics components have been developed using the
   silicon-on-insulator (SOI) platform, which offers high-confinement and
   compatibility with standard CMOS processes. While complex functional
   blocks or intellectual property (IP) cores have been developed and used
   to speed up the user IC design flow, the research on IP cores in
   optoelectronic microsystems is currently lacking. Therefore, in this
   paper, we describe the design methodology for modeling and IP technology
   used in high-speed optical interconnection interfaces for optoelectronic
   microsystems. We propose an architecture for high-speed optical
   interconnection interfaces, as well as basic unit modeling and IP
   technology. To demonstrate the proposed technology, we functionally
   decompose and design an IP prototype of a high-speed optical
   interconnection interface, which shows clear eye diagrams at 56 Gbps.},
Type = {Proceedings Paper},
