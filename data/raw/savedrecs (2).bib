@inproceedings{ WOS:001552932200011,
Author = {Bastoni, Andrea and Zuepke, Alexander and Solieri, Marco},
Editor = {Cinque, M and Cotroneo, D and DeSimone, L and Eckhart, M and Lee, PPC and Zonouz, S},
Title = {Observe and Regulate Memory Interference on MPSoC: a Practical Approach},
Booktitle = {2025 55TH ANNUAL IEEE/IFIP INTERNATIONAL CONFERENCE ON DEPENDABLE
   SYSTEMS AND NETWORKS-SUPPLEMENTAL VOLUME, DSN-S},
Series = {Annual IEEE/IFIP International Conference on Dependable Systems and
