@inproceedings{ WOS:000553550000004,
Author = {Di Mauro, Alfio and Conti, Francesco and Schiavone, Pasquale Davide and
   Rossi, Davide and Benini, Luca},
Book-Group-Author = {IEEE},
Title = {Pushing On-chip Memories Beyond Reliability Boundaries in Micropower
   Machine Learning Applications},
Booktitle = {2019 IEEE INTERNATIONAL ELECTRON DEVICES MEETING (IEDM)},
Series = {IEEE International Electron Devices Meeting},
Year = {2019},
Note = {65th IEEE Annual International Electron Devices Meeting (IEDM), San
   Francisco, CA, DEC 09-11, 2019},
Abstract = {Memory access dominates inference energy in today's Deep Neural Network
   (DNN) accelerators. We analyze voltage over-scaling for on-chip memories
   and explore the trade-off between energy efficiency and reliability for
   robust and computationally efficient deep Binary Neural Networks (BNNs).
   Experimental results on a BNN accelerator fabricated in FDX22 technology
   with on-chip SRAMs powered down to 0.4V (well below the 0.8V nominal
   Vdd) demonstrate major energy efficiency improvements (2.3x) at
   negligible end-to-end classification accuracy degradation.},
