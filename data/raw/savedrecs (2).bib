@article{ WOS:001575807500044,
Author = {Muslimin, Nuril Azmi and Mansor, Nurulafiqah Nadzirah and Mokhlis,
   Hazlie and Abdullah, Mohd Noor and Pil Ramli, Suzana},
Title = {Lighting System Optimization, Components, and Simulation Tools for
   Building Installations: A Review},
Journal = {IEEE ACCESS},
Year = {2025},
Volume = {13},
Pages = {160508-160535},
Abstract = {Globally, buildings account for approximately one-third of total energy
   consumption, with lighting systems contributing around 17\% of a
   building's total energy use. The initial design of a lighting system
   plays a crucial role in overall energy efficiency, as well-planned
   lighting solutions can significantly reduce daily energy consumption.
   Integrating energy-saving practices into lighting design has proven to
   be an effective strategy to mitigate rising energy demands. However,
   optimizing lighting systems is complex, as energy efficiency must be
   balanced with occupant comfort, which heavily influences energy usage
   patterns. Studies suggest that up to one-third of a building's energy
   performance is affected by inefficient energy-related behaviors. Given
   these challenges, optimization techniques are essential in designing
   efficient lighting systems that minimize energy consumption while
   maintaining comfortable indoor environments. This paper provides a
   comprehensive review of state-of-the-art lighting system designs in
   buildings, analyzing optimization techniques, tools, and methodologies
   used in previous research. It traces the evolution of lighting system
   optimization over the past two decades, highlighting key research
   objectives, constraints, and influencing factors. Additionally, it
   identifies existing gaps and research opportunities in lighting system
   optimization, considering emerging trends and future requirements. The
   study explores various meta-heuristic optimization methods such as
   Particle Swarm Optimization (PSO), Multi-Objective Particle Swarm
   Optimization (MOPSO), and Genetic Algorithms (GA), among others, which
   have been widely applied in past research, achieving energy savings of
   up to 70\%. Commonly used simulation tools, including DIALux and MATLAB,
   are reviewed for their role in optimizing lighting system performance.
   Furthermore, the paper provides insights into current industry practices
   and the challenges faced by consulting engineers in implementing
   advanced optimization techniques due to complexity and time constraints.
   To bridge the gap between research and practical application, a
   guideline framework for optimal lighting system design is proposed. This
   framework considers practicality, material selection, regulatory
   standards, and real-world constraints to assist lighting designers and
   engineers in implementing efficient and sustainable lighting solutions.
   By synthesizing past research and emerging trends, this study aims to
   contribute to the ongoing development of smarter, more energy-efficient
   lighting systems in buildings.},
Type = {Article},
