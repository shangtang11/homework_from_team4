@article{ WOS:001635765700011,
Author = {Pereira, Sergio and Cerdeira, David and Rodrigues, Cristiano and Pinto,
   Sandro},
Title = {Rethinking Trusted Execution Environments in the Age of Reconfigurable
   Computing},
Journal = {IEEE ACCESS},
Year = {2025},
Volume = {13},
Pages = {206079-206095},
Abstract = {As systems become more interconnected and complex, relying solely on
   general-purpose operating systems (OS) to provide the necessary
   foundation for security-critical applications becomes challenging.
   Trusted execution environments (TEEs), i.e., Intel SGX and Arm
   TrustZone, have been widely adopted to minimize security vulnerabilities
   by reducing the attack surface. However, recent reported attacks on
   these well-known TEEs raise concerns about their fundamental security
   assurances. This work introduces the concept of Trusted Execution
   Environments On-Demand (TEEOD). This novel solution leverages
   Field-programmable gate array (FPGA) technology to provide customized
   and dedicated execution environments (enclaves) per application on a
   per-need basis. Each enclave includes only the necessary hardware blocks
   to ensure independent execution, i.e., a soft-core microcontroller unit
   (MCU), private memories, and access to TEE services and access to TEE
   services in compliance with the GlobalPlatform (GP) TEE specification.
   This industry-standard specification defines the architecture and
   requirements for TEEs, ensuring interoperability and security in trusted
   applications (TAs). Evaluation on an AMD Zynq UltraScale+ MPSoC
   (Ultra96-V2) with an entry-level FPGA demonstrates TEEOD's ability to
   synthesize up to four enclaves, surpassing the GlobalPlatform TEE
   specification's minimum requirement of two TAs. We also demonstrated
   TEEOD's practicality in real-world scenarios by successfully running a
   legacy open-source Bitcoinwallet. TEEOD achieves a 39.2x speedup over
   vanilla OP-TEE for straightforward operations. When dealing with more
   computationally intensive operations, a TEEOD configuration that
   leverages hardware-accelerated cryptographic services resulted in a 1.1x
   speedup compared to vanilla OP-TEE. In contrast, its software-based
   version showed a slowdown of 1.5x.},
Type = {Article},
Affiliation = {Pereira, S (Corresponding Author), Univ Minho, Ctr ALGORITMI LASI, P-4800058 Guimaraes, Portugal.
   Pereira, Sergio; Cerdeira, David; Rodrigues, Cristiano; Pinto, Sandro, Univ Minho, Ctr ALGORITMI LASI, P-4800058 Guimaraes, Portugal.},
