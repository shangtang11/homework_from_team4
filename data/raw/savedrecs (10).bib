DOI = {10.1109/JSSC.2018.2866929},
Keywords = {Algorithmic voltage-feed-in (AVFI) topology; buck-boost; dc-dc; linear
   topology; parasitic loss; power density; rational voltage conversion
   ratio; reconfigurable; reference-selective bootstrapping; switched
   capacitor},
