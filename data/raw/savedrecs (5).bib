@article{ WOS:001200006300002,
Author = {Ho, Rebecca and Fuller, Samuel and Lee, Hae-Seung and Shulaker, Max M.},
Title = {Biosensor Chip for Point-of-Care Diagnostics: Carbon Nanotube Sensing
   Platform for Bacterial Detection and Identification},
Journal = {IEEE TRANSACTIONS ON NANOTECHNOLOGY},
Year = {2024},
Volume = {23},
Pages = {281-285},
Abstract = {Emerging technologies, such as carbon nanotubes (CNTs), show exciting
   benefits for next-generation electronic systems and have recently been
   incorporated within commercial fabrication facilities and foundries.
   Here we demonstrate a real-world application of carbon nanotube
   field-effect transistors (CNFETs) leveraging these foundry capabilities:
   performing disease diagnostics by detecting and identifying infectious
   pathogens in model biological samples. This Biosensor chip leverages the
   benefits of 200 mm wafer-scale and VLSI-compatible foundry fabrication
   of CNFETs, which can be seamlessly integrated with the mature sensing
   modality of antibody-based targeted antigen binding, to realize a robust
   and manufacturable biosensor technology. As a demonstration, we realize
   Biosensor chips that are capable of detecting and identifying three
   different infectious pathogens simultaneously through multiplexing
   across hundreds of functionalized CNFET-antibody biosensors within each
   chip.},
