@inproceedings{ WOS:000833458700041,
Author = {Tullos, Justin and Graham, Scott and Patel, Pranav},
Book-Group-Author = {ACAD CONF LTD},
Title = {Applied Analytical Model for Latency Evaluation of RISC-V Security
   Monitor},
Booktitle = {PROCEEDINGS OF THE 16TH INTERNATIONAL CONFERENCE ON CYBER WARFARE AND
   SECURITY (ICCWS 2021)},
Series = {International Conference on Cyber Warfare and Security},
Year = {2021},
Pages = {354-363},
Note = {16th International Conference on Cyber Warfare and Security (ICCWS),
   Tennessee Tech Univ, ELECTR NETWORK, FEB 25-26, 2021},
Abstract = {The release of RISC-V, an open-source instruction set architecture, in
   2011 paved the way for a new era of processor technology evolution built
   around the open exchange of embedded security, validation, and
   implementation. Keystone, an open-source software security monitor
   developed for RISC-V processors, provides primitives to secure embedded
   systems. In addition to providing secure enclaves for sensitive
   processing, Keystone operates as a reference monitor, ensuring a system
   is using its resources correctly (Lee et al., 2020). Incorporating
   Keystone, or any security measures, will impact the performance of an
   embedded system. To assess the impact, we applied a theoretical model
   for a reference monitor based on a closed queueing network from
   Gorbachov et al. (2019). Our focus was to develop a control-flow diagram
   that captured the interactions of Keystone in our experimental system
   and execute a benchmark suite for measuring the time to complete an
   enclave creation job. The results provide the basis for a modelling
   framework to determine the average system response time. The framework
   in turn enables system designers to make appropriate trade-offs between
   system security and performance when including Keystone in a RISC-V
   design.},
Type = {Proceedings Paper},
Affiliation = {Graham, S (Corresponding Author), US Air Force, Inst Technol, Wright Patterson AFB, OH 45433 USA.
