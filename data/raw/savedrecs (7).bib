@inproceedings{ WOS:001065966600018,
Author = {Slpsk, Patanjali and Cruz, Jonathan and Ray, Sandip and Bhunia, Swarup},
Book-Group-Author = {IEEE},
Title = {PROTECTS: Secure Provisioning of System-on-Chip Assets in Untrusted
   Testing Facility},
Booktitle = {2023 IEEE INTERNATIONAL TEST CONFERENCE INDIA, ITC INDIA},
Series = {IEEE International Test Conference on India},
Year = {2023},
Note = {7th IEEE International Test Conference India (ITC India), Bangalore,
   INDIA, JUL 23-25, 2023},
Abstract = {System-on-Chips contain variety of Hardware Security Assets (HSAs) to
   protect the components of the system against untrusted entities. Binding
   the HSAs to each SoC silicon instance during the testing stage, known as
   provisioning, is a critical step in SoC life cycle since improper
   provisioning could compromise the secure, trustworthy field operation of
   SoC and/or lead to crucial supply chain threats (e.g., piracy, cloning
   and reverse engineering). However, existing SoC provisioning methods do
   not scale to more advanced threat vectors under the emergent zero trust
   model that considers the foundry and testing/assembly process
   untrustworthy. We address this problem through a comprehensive
   framework, PROTECTS that enables secure provisioning of HSAs under zero
   trust. We demonstrate PROTECTS using a representative RISC-V based SoC
   with diverse set of HSAs. Our analysis shows that PROTECTS incurs
   minimal design overheads (0.36\%, 0.54\% and 0.0\%) in area, power, and
   gate-count, respectively, for the entire SoC), while providing strong
   security guarantees.},
Type = {Proceedings Paper},
Affiliation = {Slpsk, P (Corresponding Author), Univ Florida, Dept Elect \& Comp Engn, Gainesville, FL 32611 USA.
   Slpsk, Patanjali; Cruz, Jonathan; Ray, Sandip; Bhunia, Swarup, Univ Florida, Dept Elect \& Comp Engn, Gainesville, FL 32611 USA.},
DOI = {10.1109/ITCINDIA59034.2023.10235499},
Keywords = {Zero Trust; SoC provisioning; Reverse Engineering; Counterfeiting;
   Piracy},
Author-Email = {patanjal.sristil@ufl.edu
