@article{ WOS:001706743200001,
Author = {Wang, Runxia and Cao, Ben},
Title = {Coexisting dynamics near the Hopf bifurcation of a hair bundle model for
   auditory amplification and frequency selectivity},
Journal = {CHINESE JOURNAL OF PHYSICS},
Year = {2026},
Volume = {101},
Pages = {249-266},
Month = {JUN},
Abstract = {Amplification and frequency selectivity are vital functions of auditory
   system. While it is established that hair cells function near a Hopf
   bifurcation for high sensitivity, the precise dynamical mechanisms are
   not fully resolved. This study proposes an underlying dynamical
   mechanism that hair cells leverage complex coexisting behaviors near the
   Hopf bifurcation to enable frequencyselective amplification. Firstly,
   four typical coexisting scenarios involving a small-amplitude state
   (resting or periodic/chaotic oscillations) and a large-amplitude state
   (periodic/chaotic oscillations) are revealed. Bifurcation and stability
   analysis are used to identify their dynamics. Notably, a novel form of
   coexistence near the supercritical Hopf bifurcation induced by a fold
   bifurcation of limit cycles is uncovered. Then, numerical simulations
   show that hair cells, poised in the small-amplitude state with hidden
   coexisting large-amplitude state, amplify weak sinusoidal stimuli (1
   nm). Each coexisting behavior exhibits a distinct range and optimal
   frequency for amplification, which is determined by the intrinsic
   frequency of the hidden large-amplitude attractor. Finally, it is
   elucidated that the dynamical mechanism involves the stimulus driving
   the system from the small-amplitude state towards the basin of the
   large-amplitude attractor, resulting in amplified responses. These
   findings enhance the understanding of auditory amplification and
   frequency selectivity near the Hopf bifurcation, facilitating the
   development of biomimetic auditory sensors and intelligent auditory
   perception systems.},
Type = {Article},
Affiliation = {Cao, B (Corresponding Author), Nanjing Univ Informat Sci \& Technol, Sch Artificial Intelligence, Sch Future Technol, Nanjing 210044, Jiangsu, Peoples R China.
