@article{ WOS:001717543800004,
Author = {Buyuktas, Baris and Klotz, Jonas and Demir, Begum},
Title = {FedX: Explanation-Guided Pruning for Communication-Efficient Federated
   Learning in Remote Sensing},
Journal = {IEEE JOURNAL OF SELECTED TOPICS IN APPLIED EARTH OBSERVATIONS AND REMOTE
   SENSING},
Year = {2026},
Volume = {19},
Pages = {8549-8560},
Abstract = {Federated learning (FL) enables the collaborative training of deep
   neural networks across decentralized data archives (i.e., clients),
   where each client stores data locally and only shares model updates with
   a central server. This makes FL a suitable learning paradigm for remote
   sensing (RS) image classification tasks, where data centralization may
   be restricted due to legal and privacy constraints. However, a key
   challenge in applying FL to RS tasks is the communication overhead
   caused by the frequent exchange of large model updates between clients
   and the central server. To address this issue, in this article, we
   propose a novel strategy (denoted as FedX) that uses explanation-guided
   pruning to reduce communication overhead by minimizing the size of the
   transmitted models without compromising performance. FedX leverages
   backpropagation-based explanation methods to estimate the task-specific
   importance of model components and prunes the least relevant ones at the
   central server. The resulting sparse global model is then sent to
   clients, substantially reducing communication overhead. We evaluate FedX
   on multilabel scene classification using the BigEarthNet-S2 dataset and
   single-label scene classification using the EuroSAT dataset.
   Experimental results show the success of FedX in significantly reducing
   the number of shared model parameters while enhancing the generalization
   capability of the global model, compared to both unpruned model and
   state-of-the-art pruning methods.},
Type = {Article},
Affiliation = {Büyüktas, B (Corresponding Author), Tech Univ Berlin, Fac Elect Engn \& Comp Sci, D-10623 Berlin, Germany.
   Buyuktas, Baris; Klotz, Jonas; Demir, Begum, Tech Univ Berlin, Fac Elect Engn \& Comp Sci, D-10623 Berlin, Germany.
   Buyuktas, Baris; Klotz, Jonas; Demir, Begum, BIFOLD Berlin Inst Fdn Learning \& Data, D-10623 Berlin, Germany.},
DOI = {10.1109/JSTARS.2026.3666106},
Keywords = {Servers; Computational modeling; Training; Data models; Quantization
   (signal); Prototypes; Predictive models; Model compression; Law; Data
   privacy; Explanation methods; federated learning (FL); image
