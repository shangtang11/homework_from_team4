@inproceedings{ WOS:000610549200288,
Author = {Kumar, Vinay B. Y. and Gupta, Naina and Chattopadhyay, Anupam and
   Kasper, Michael and Krauss, Christoph and Niederhagen, Ruben},
Editor = {DiNatale, G and Bolchini, C and Vatajelu, EI},
Title = {Post-Quantum Secure Boot},
Booktitle = {PROCEEDINGS OF THE 2020 DESIGN, AUTOMATION \& TEST IN EUROPE CONFERENCE
   \& EXHIBITION (DATE 2020)},
Series = {Design Automation and Test in Europe Conference and Exhibition},
Year = {2020},
Pages = {1582-1585},
Note = {Design, Automation and Test in Europe Conference and Exhibition (DATE),
   Grenoble, FRANCE, MAR 09-13, 2020},
Abstract = {A secure boot protocol is fundamental to ensuring the integrity of the
   trusted computing base of a secure system. The use of digital signature
   algorithms (DSAs) based on traditional asymmetric cryptography,
   particularly for secure boot, leaves such systems vulnerable to the
   threat of quantum computers. This paper presents the first post-quantum
   secure boot solution, implemented fully as hardware for reasons of
   security and performance. In particular, this work uses the eXtended
   Merkle Signature Scheme (XMSS), a hash-based scheme that has been
   specified as an IETF RFC. The solution has been integrated into a secure
   SoC platform around RISC-V cores and evaluated on an FPGA and is shown
   to be orders of magnitude faster compared to corresponding
   hardware/software implementations and to compare competitively with a
   fully hardware elliptic curve DSA based solution.},
Type = {Proceedings Paper},
Affiliation = {Kumar, VBY (Corresponding Author), Nanyang Technol Univ, Singapore, Singapore.
