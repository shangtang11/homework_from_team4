@article{ WOS:001657755400006,
Author = {Liu, Fanming and Yang, Hailin and Zhang, Wu and Zhang, Meng and Zhang,
   Chengyun},
Title = {Flexible pressure sensor with femtosecond laser-induced hierarchical
   micro/nanostructures for physiological signal monitoring and tactile
   object recognition},
Journal = {MEASUREMENT},
Year = {2026},
Volume = {263},
Month = {MAR 3},
Abstract = {Physiological signal monitoring and tactile perception are critical
   sensing capabilities for human-machine interfaces, robotics, and
   wearable electronics. Flexible pressure sensors hold significant promise
   in these areas, leveraging their bendable and conformable structures to
   enable seamless integration. However, performance enhancement through
   the introduction of microstructures often suffers from complex
   fabrication procedures, hindering large-scale production. Herein, we
   proposed a facile and scalable strategy to fabricate dual-sided
   hierarchical micro/nanostructures on polydimethylsiloxane (PDMS)
   surfaces via femtosecond laser micro-processing. The resulting sensor
   exhibits a sensitivity of 0.20 kPa-1, fast response/recovery times
   (92/46 ms), and excellent reliability over 5000 cycles. Moreover, the
   sensor is capable of monitoring human physiological signals, perceiving
   surface roughness, and performing object recognition. These results
   demonstrate that the flexible pressure sensor fabricated by this simple
   method shows broad application potential in wearable devices and
   human-machine interaction.},
