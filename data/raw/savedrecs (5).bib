Booktitle = {2024 IEEE LLM AIDED DESIGN WORKSHOP, LAD 2024},
Year = {2024},
Note = {1st IEEE International Workshop on LLM-Aided Design (LAD), IBM Almaden
   Campus, San Jose, CA, JUN 28-29, 2024},
Abstract = {This paper investigates the use of multimodal large language models
   (MMLLMs) for generating Verilog code from visual inputs, addressing the
   challenge of describing complex system architectures. It explores the
   potential of these models to map visual information from circuit
   diagrams to Verilog, due to the lack of standardized microarchitecture
   diagrams in the industry. A difficulty-graded benchmark is introduced to
   test the LLMs' generative capabilities. Additionally, the study proposes
   ``Thinking Vision,{''} a novel visual acquisition method for RTL
   generation, which has significantly enhanced success rates in
   open-source multimodal models by over 50\%. The paper concludes with an
   evaluation of multimodal LLMs' performance and suggestions for improving
   visual processing capabilities for complex architectures.},
