@article{ WOS:001631894000017,
Author = {Padilha, Matheus and Lima, Kewin and Junior, Henrique and Mendes,
   Raudiney and Caetano Firmo, Andre and Ximenes, Rafael and Lima, Ricardo},
Title = {Automated Optical Microscope Integrated With Cloud Computing and YOLOv8m
   for Mortality Classification of C. elegans},
Journal = {IEEE ACCESS},
Year = {2025},
Volume = {13},
Pages = {201234-201245},
Abstract = {This paper proposes an integrated and scalable solution for automating
   C. elegans mortality classification pharmacological assays. The system
   combines an automated optical microscopy device and an AWS cloud server.
   The device, built with CNC system components (stepper motors and linear
   guides), automatically images the lower region of multiwell plates,
   overcoming visualization challenges such as worm aggregates and media
   turbidity. A dataset of 8,477 images was used for model development,
   split into 70\% for training and 30\% for testing. The captured images
   are automatically sent to a cloud database, where a computer vision
   algorithm based on the YOLOv8m architecture is executed specifically for
   nematode mortality classification. Despite considerable blur in the
   images, the trained model achieved excellent performance, with all
   metrics (precision, recall, and F1-score, mAP@50 and mAP@50:95)
   exceeding 86.0\%, combined with an inference speed of 33.2 frames per
   second. The decentralized architecture allows a single AWS server to
   manage the processing of multiple distributed devices, reducing
   operational costs. The solution offers remote operation via a browser,
   facilitating collaborative analysis, data storage, and the exchange of
   results between geographically dispersed laboratories. The results
   validate the proposal as a robust, efficient, and competitive
   alternative for automation in pharmacological research.},
