@article{ WOS:001617020600001,
Author = {Aljahdali, Asia Othman},
Title = {PrivShield-CQ: A chaotic-quantum encryption framework with lightweight
   authentication for post-quantum secure consumer applications},
Journal = {ARRAY},
Year = {2025},
Volume = {28},
Month = {DEC},
Abstract = {The rapid expansion of consumer technologies such as Internet of Things
   devices, smart home systems, and wearable electronics has created new
   security challenges, especially as quantum computing threatens
   traditional encryption methods. This paper proposes PrivShield-CQ, a
   chaotic-quantum encryption framework designed for post-quantum secure
   consumer applications. The framework integrates a six-dimensional
   hyper-chaotic Chen system for high-entropy key generation with National
   Institute of Standards and Technology (NIST) standardized post-quantum
   algorithms, including Module Lattice Key Encapsulation Mechanism
   (ML-KEM), Module Lattice Digital Signature Algorithm (ML-DSA), and
   Stateless Hash Digital Signature Algorithm (SLH-DSA). Extensive
   experiments across devices such as ESP32, Raspberry Pi 4B, and Galaxy
   S23 demonstrate significant improvements: 99.7\% quantum attack
   resistance, 65.4\% lower authentication latency with 3.7 ms average
   response, 31.4\% energy savings, and 33.0\% extended battery life
   compared to existing post-quantum cryptography approaches. Shannon
   entropy analysis (7.9973/8.0) and successful completion of all 15
   National Institute of Standards and Technology randomness tests confirm
   cryptographic strength. Validated through a six-month real-world
   deployment with over 10,000 secure interactions per hour, PrivShield-CQ
   bridges the gap between theoretical quantum-safe cryptography and
   practical consumer use, enabling scalable, energy-efficient, and
   quantum-resistant security for next-generation connected ecosystems.},
