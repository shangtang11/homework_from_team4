Series = {IEEE International On-Line Testing Symposium},
Year = {2022},
Note = {28th IEEE International Symposium on On-Line Testing and Robust System
   Design (IOLTS), Politecnico Torino, Torino, ITALY, SEP 12-14, 2022},
Abstract = {Electronics employed in modern safety-critical systems require severe
   qualification during the manufacturing process and in the field, to
   prevent fault effects from manifesting themselves as critical failures
   during mission operations. Traditional fault models are not sufficient
   anymore to guarantee the required quality levels for chips utilized in
   mission-critical applications. The research community and industry have
   been investigating new test approaches such as device-aware test,
   cell-aware test, path-delay test, and even test methodologies based on
   the analysis of manufacturing data to move the scope from OPPM to OPPB.
   This special session presents four contributions, from academic
   researchers and industry professionals, to enable better chip quality.
   We present results on various activities towards this objective,
   including device-aware test, software-based self-test, and memory test.},
