@article{ WOS:001556092100050,
Author = {Mystkowska, Gabriela and Monopoli, Matteo and Nannipieri, Pietro and
   Zulberti, Luca and Codinachs, David Merodio and Fanucci, Luca},
Title = {Hardware Platforms Enabling Edge AI for Space Applications: A Critical
   Review},
Journal = {IEEE ACCESS},
Year = {2025},
Volume = {13},
Pages = {143939-143956},
Abstract = {Artificial Intelligence is an emerging technology in the space industry
   as it enables real-time data processing and autonomous navigation. We
   aim to facilitate mission development by providing an extensive
   state-of-the-art review. We analyze recent advancements in hardware
   architectures for space on-the-edge applications. We explore the unique
   challenges of space environments, including radiation hardening,
   flexibility, and real-time processing needs. We identify the possible
   hardware accelerator architectures and assess their applicability
   on-board spacecraft. We examine key developments in hardware
   accelerators, general-purpose processors, and neuromorphic chips, with
   an emphasis on adaptability for space applications. We compare the
   available chips in terms of performance capabilities, power consumption,
   technology node and radiation hardening. We showcase future directions,
   offering a comprehensive overview of cutting-edge solutions for
   AI-driven space missions.},
