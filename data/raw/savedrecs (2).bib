@inproceedings{ WOS:001691789100014,
Author = {Guo, Zexiang and Chen, Hengxiang and Mai, Xinheng and Qiu, Qiusang and
   Ma, Gan and Kappassov, Zhanat and Li, Qiang and Chen, Nutan},
