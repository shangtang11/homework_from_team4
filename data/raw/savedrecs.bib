@article{ WOS:001638287900001,
Author = {Yang, Junyi and Luo, Xinyu and Ke, Ye and Luo, Xinyu and Wang, Zheng and
   Shang, Hongyang and Dong, Shuai and Fu, Zhengnan and Yang, Xiaofeng and
   Liu, Hongjie and Basu, Arindam},
Title = {A 33.6136.2-TOPS/W Nonlinear Analog Computing-in-Memory Macro for
   Multi-Bit LSTM Accelerator in 65-nm CMOS},
Journal = {IEEE JOURNAL OF SOLID-STATE CIRCUITS},
Year = {2025},
Month = {2025 DEC 12},
Abstract = {The energy efficiency (EE) of analog computing-in-memory (ACIM)
   accelerator for recurrent neural networks (RNNs), particularly long
   short-term memory (LSTM) networks, is limited by the high proportion of
   nonlinear (NL) operations typically executed digitally. To address this,
   we propose an LSTM accelerator incorporating an ACIM macro with
   reconfigurable (1-5 bit) NL in-memory (NLIM) analog-to-digital converter
   (ADC) to compute NL activations directly in the analog domain using: 1)
   a dual-9T bitcell with decoupled read/write paths for signed inputs and
   ternary weight operations; 2) a read-word-line underdrive cascode (RUDC)
   technique achieving 2.8x higher read-bitline dynamic range (DR) than
   single-transistor designs ( 1.4x better over conventional cascode
   structure with 7x lower current variation); and 3) a dual-supply
   6T-static random access memory (SRAM) array for efficient multi-bit
   weight operations and reducing both bitcell count ( 7.8x ) and latency (
   4x ) for 5-bit weight operations. We experimentally demonstrate a 5-bit
   NLIM ADC for approximating NL activations in LSTM cells, achieving
   average error <1 LSB. Simulation confirms the robustness of NLIM ADC
   against temperature variations thanks to the replica bias strategy. Our
   design achieves 92.0\% on-chip inference accuracy for a 12-class
   keyword-spotting (KWS) task while demonstrating 2.2x higher system-level
   normalized EE and 1.6x better normalized area efficiency than
   state-of-the-art (SOTA) works. The results combine physical measurements
   of a macro unit-accounting for the majority of LSTM operations (99\%
