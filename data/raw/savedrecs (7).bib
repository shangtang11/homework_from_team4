@inproceedings{ WOS:001701721800188,
Author = {Vizcaino, Pablo and Ieronymakis, Georgios and Dimou, Nikolaos and
   Papaefstathiou, Vassilis and Labarta, Jesus and Mantovani, Filippo},
Book-Group-Author = {ACM},
Title = {Short Reasons for Long Vectors in HPC CPUs: A Study Based on RISC-V},
Booktitle = {PROCEEDINGS OF 2023 SC23 WORKSHOPS OF THE INTERNATIONAL CONFERENCE ON
   HIGH PERFORMANCE COMPUTING, NETWORK, STORAGE, AND ANALYSIS, SC-W 2023},
Year = {2023},
Pages = {1543-1549},
Note = {2023 Workshops of the International Conference for High Performance
   Computing Networking Storage and Analysis-SC-W, Denver, CO, NOV 12-17,
   2023},
Abstract = {For years, SIMD/vector units have enhanced the capabilities of modern
   CPUs in High-Performance Computing (HPC) and mobile technology. Typical
   commercially-available SIMD units process up to 8 double-precision
   elements with one instruction. The optimal vector width and its impact
   on CPU throughput due to memory latency and bandwidth remain challenging
   research areas. This study examines the behavior of four computational
   kernels on a RISC-V core connected to a customizable vector unit,
   capable of operating up to 256 double precision elements per
   instruction. The four codes have been purposefully selected to represent
   nondense workloads: SpMV, BFS, PageRank, FFT. The experimental setup
   allows us to measure their performance while varying the vector length,
   the memory latency, and bandwidth. Our results not only show that larger
   vector lengths allow for better tolerance of limitations in the memory
   subsystem but also offer hope to code developers beyond dense linear
   algebra.},
Type = {Proceedings Paper},
