@inproceedings{ WOS:000870310500015,
Author = {Yuan, Shenghao and Besson, Frederic and Talpin, Jean-Pierre and Hym,
   Samuel and Zandberg, Koen and Baccelli, Emmanuel},
Editor = {Shoham, S and Vizel, Y},
Title = {End-to-End Mechanized Proof of an eBPF Virtual Machine for
   Micro-controllers},
Booktitle = {COMPUTER AIDED VERIFICATION (CAV 2022), PT II},
Series = {Lecture Notes in Computer Science},
Year = {2022},
Volume = {13372},
Pages = {293-316},
Note = {34th International Conference on Computer-Aided Verification (CAV) held
   as part of the Federated Logic Conference (FLoC), Haifa, ISRAEL, AUG
   07-10, 2022},
Abstract = {RIOT is a micro-kernel dedicated to IoT applications that adopts eBPF
   (extended Berkeley Packet Filters) to implement so-called
   femto-containers. As micro-controllers rarely feature hardware memory
   protection, the isolation of eBPF virtual machines (VM) is critical to
   ensure system integrity against potentially malicious programs. This
   paper shows how to directly derive, within the Coq proof assistant, the
   verified C implementation of an eBPF virtual machine from a Gallina
   specification. Leveraging the formal semantics of the CompCert C
   compiler, we obtain an end-to-end theorem stating that the C code of our
   VM inherits the safety and security properties of the Gallina
   specification. Our refinement methodology ensures that the isolation
   property of the specification holds in the verified C implementation.
   Preliminary experiments demonstrate satisfying performance.},
Type = {Proceedings Paper},
Affiliation = {Yuan, SH (Corresponding Author), INRIA, Rennes, France.
   Yuan, Shenghao; Besson, Frederic; Talpin, Jean-Pierre, INRIA, Rennes, France.
