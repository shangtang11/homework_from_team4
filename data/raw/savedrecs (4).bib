@inproceedings{ WOS:001260970400012,
Author = {Cantoro, Riccardo and Grosso, Michelangelo and Guglielminetti, Iacopo
   and Khoshzaban, Reza and Reorda, Matteo Sonza},
Book-Group-Author = {IEEE},
Title = {Assessing the Effectiveness of Software-Based Self-Test Programs for
   Static Cell-Aware Test},
Booktitle = {IEEE EUROPEAN TEST SYMPOSIUM, ETS 2024},
Series = {Proceedings of the European Test Symposium},
Year = {2024},
Note = {IEEE European Test Symposium (ETS), Hague, NETHERLANDS, MAY 20-24, 2024},
Abstract = {Software-Based Self-Test (SBST) is vastly adopted as a hardware safety
   mechanism for the in-field test of safety-critical systems in the form
   of Software Test Libraries (STLs). Typically, an STL's diagnostic
   coverage is evaluated on the stuck-at fault model. As various
   defect-oriented fault models exist and are used for manufacturing
   testing, such as the popular cell-aware test (CAT), there is a need to
   evaluate the effectiveness of SBST when such models are targeted. This
   work targets static CAT faults. We evaluated the fault coverage of
   open-available STLs for a RISC-V SoC. We used results stemming from
   stuck-at fault simulation and gate-exhaustive simulation to elaborate on
   the obtained results.},
