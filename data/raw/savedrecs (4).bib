@inproceedings{ WOS:001471864600044,
Author = {Duc Hong An Le and Vu Trung Duong Le and Viet Anh Ho and Van Tinh Nguyen
   and Hoai Luan Pham and Van Duy Tran and Tuan Hai Vu and Nakashima,
   Yasuhiko},
Book-Group-Author = {IEEE},
Title = {High-Efficiency RISC-V-Based Cryptographic Coprocessor for Security
   Applications},
Booktitle = {2024 21ST INTERNATIONAL SOC DESIGN CONFERENCE, ISOCC},
Series = {International SoC Design Conference},
Year = {2024},
Pages = {103-104},
Note = {21st International SoC Design Conference-ISOCC, Sapporo, JAPAN, AUG
   19-22, 2024},
Abstract = {With its simple and highly flexible instruction set, the RISC-V
   architecture is considered the optimal solution for security
   applications requiring high-performance and low-power cryptographic
   hardware. However, existing RISC-V processors for cryptography still
   suffer from low performance. To solve this problem, this paper proposes
   a RISC-V-based cryptographic coprocessor referred to as ``Co-RISCV{''}
   to achieve high speed and hardware efficiency. The real-time performance
   results of our Co-RISCV at an actual System-on-Chip (SoC) level on the
   Xilinx ZCU102 FPGA platform demonstrate that the Co-RISCV is better from
   1.2 to 14.3 times than modern CPUs in power efficiency. Compared with
   related works, the Co-RISCV also shows an improvement of 1.13 to 3.31
   times in terms of throughput measured in cycles per byte.},
Type = {Proceedings Paper},
Affiliation = {Pham, HL (Corresponding Author), Le Quy Don Tech Univ, Hanoi, Vietnam.
   Duc Hong An Le; Viet Anh Ho, Univ Informat Technol VNUHCM, Ho Chi Minh City, Vietnam.
   Van Tinh Nguyen, Nara Inst Sci \& Technol, 8916-5 Takayama Cho, Ikoma, Nara 6300192, Japan.
   Vu Trung Duong Le; Hoai Luan Pham; Van Duy Tran; Tuan Hai Vu; Nakashima, Yasuhiko, Le Quy Don Tech Univ, Hanoi, Vietnam.},
