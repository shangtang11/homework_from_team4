@article{ WOS:001377144100001,
Author = {Mathure, Nimish and Srinivasan, Sudarshan K. and Ponugoti, Kushal K.},
Title = {Invulnerability invariants for software controlled speculation},
Journal = {ELECTRONICS LETTERS},
Year = {2024},
Volume = {60},
Number = {23},
Month = {DEC 14},
Abstract = {Spectre class of transient execution security attacks on modern
   microprocessors rely on speculative execution. Software Controlled
   Speculation (SCS) was proposed as a microarchitecture-level defense in
   the original Spectre paper and has also been adopted by ARM. The idea
   with SCS is to allow a mode in the microarchitecture, where instructions
   that read from memory are not allowed to execute speculatively. Errors
   or malicious fault-injections in the implementation of SCS can still
   render the microarchitecture vulnerable to Spectre attacks. A formal
   verification method is proposed that can check the correctness of the
   implementation of SCS and detect any faults. The method has been
   demonstrated to be very efficient on two sets of benchmarks and provides
   accurate detection of implementation faults in SCS.},
Type = {Article},
Affiliation = {Mathure, N (Corresponding Author), North Dakota State Univ, Elect \& Comp Engn, Fargo, ND 58105 USA.
