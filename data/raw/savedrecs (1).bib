@article{ WOS:001517681400001,
Author = {Assafrao, Denise and de Lima, A. G. and Silva, Edilberto O. and
   Filgueiras, Cleverson},
Title = {Nonlinear refractive index changes and absorption coefficients in
   quantum dot induced by variable effective mass},
Journal = {PHYSICA B-CONDENSED MATTER},
Year = {2025},
Volume = {714},
Month = {OCT 1},
Abstract = {This study explores the linear and nonlinear optical absorption
   coefficients (OAC) and refractive index changes (RIC) in quantum dot
   systems with a position-dependent variable effective mass described as
   m(r) = ary, where the exponent y controls how strongly the effective
   mass varies with radial distance, influencing the confinement strength
   and localization of carriers. Significant contributions to both linear
   and nonlinear OAC and RIC are observed. Our results reveal that
   variations in y modify the intersubband dipole matrix elements and
   energy intervals, leading to noticeable shifts in optical properties.
   The results show that higher y values shift resonance peaks toward
   higher energies, while changes in the confinement frequency result in
   abrupt shifts and peak diminutions. These insights provide a deeper
   understanding of the optical behaviors in the quantum systems under
   consideration, paving the way for designing devices with optimal
   efficiency.},
Type = {Article},
Affiliation = {Assafrao, D (Corresponding Author), Univ Fed Espirito Santo, Dept Fis, Vitoria, ES, Brazil.
