@inproceedings{ WOS:001214074700012,
Author = {Karl, Patrick and Schupp, Jonas and Sigl, Georg},
Editor = {Wacquez, R and Homma, N},
Title = {The Impact of Hash Primitives and Communication Overhead for
   Hardware-Accelerated SPHINCS},
Booktitle = {CONSTRUCTIVE SIDE-CHANNEL ANALYSIS AND SECURE DESIGN, COSADE 2024},
Series = {Lecture Notes in Computer Science},
Year = {2024},
Volume = {14595},
Pages = {221-239},
Note = {15th International Workshop on Constructive Side-Channel Analysis and
   Secure Design (COSADE), Ctr Microelectron, Gardanne, FRANCE, APR 09-10,
   2024},
Abstract = {SPHINCS+ is a signature scheme included in the first NIST post-quantum
   standard, that bases its security on the underlying hash primitive. As
   most of the runtime of SPHINCS+ is caused by the evaluation of several
   hash- and pseudo-random functions, instantiated via the hash primitive,
   offloading this computation to dedicated hardware accelerators is a
   natural step. In this work, we evaluate different architectures for
   hardware acceleration of such a hash primitive with respect to its
   use-case and evaluate them in the context of SPHINCS+. We attach
   hardware accelerators for different hash primitives (SHAKE256 and
   Ascon-Xof for both, full and round-reduced versions) to CPU interfaces
   having different transfer speeds. We show, that for most use-cases, data
   transfer determines the overall performance if accelerators are equipped
   with FIFOs and that reducing the number of rounds in the permutation
   does not necessarily lead to significant performance improvements when
   using hardware acceleration.},
Type = {Proceedings Paper},
Affiliation = {Karl, P (Corresponding Author), Tech Univ Munich, TUM Sch Computat Informat \& Technol, Munich, Germany.
   Karl, Patrick; Schupp, Jonas; Sigl, Georg, Tech Univ Munich, TUM Sch Computat Informat \& Technol, Munich, Germany.
