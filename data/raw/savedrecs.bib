@article{ WOS:001703603300001,
Author = {Yu, Fei and Wang, Xuqi and Xiao, Yue and He, Yan and Yao, Wei and Cai,
   Shuo and Jin, Jie},
Title = {Extreme multistability in discrete memristive neuron maps and
   implications for dual-field applications},
Journal = {INTEGRATION-THE VLSI JOURNAL},
Year = {2026},
Volume = {109},
Month = {JUL},
Abstract = {Memristors have been shown to play a pivotal role in the enhancement of
   chaotic dynamics and the construction of complex mappings, a property
   that can be attributed to their inherent memory and nonlinear
   characteristics. The present study introduces two discrete
   charge-controlled memristor models, validates their properties, and
   explores their cascaded operations. These are then coupled with Rulkov
   neuron mappings to construct two novel types of discrete cascaded
   memristive neuron maps (DCMNMs). The system's rich hyperchaotic behavior
   and extreme multistability are revealed through phase diagrams, Lyapunov
   exponents (LEs) and complexity analysis. The present study utilizes the
   constructed DCMNM model as a high-performance chaotic sequence
   generator. In the domain of information security, a color image
   encryption algorithm is devised using the generated hyperchaotic
