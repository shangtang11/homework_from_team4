@inproceedings{ WOS:000981940000124,
Author = {Ma, Tianliang and Deng, Zhihui and Shao, Leilai},
Book-Group-Author = {IEEE},
Title = {AutoFlex: Unified Evaluation and Design Framework for Flexible Hybrid
   Electronics},
Booktitle = {2023 28TH ASIA AND SOUTH PACIFIC DESIGN AUTOMATION CONFERENCE, ASP-DAC},
Series = {Asia and South Pacific Design Automation Conference Proceedings},
Year = {2023},
Pages = {757-762},
Note = {28th Asia and South Pacific Design Automation Conference (ASP-DAC),
   Miraikan Natl Museum Emerging Sci \& Informat, Tokyo, JAPAN, JAN 16-19,
   2023},
Abstract = {Flexible hybrid electronics (FHE), integrating high performance silicon
   chips with multi-functional sensors and actuators on flexible
   substrates, can be intimately attached onto irregular surfaces without
   compromising their functionalities, thus enabling more innovations in
   healthcare, internet of things (IoTs) and various human-machine
   interfaces (HMIs). Recent developments on compact models and process
   design kits (PDKs) of flexible electronics have made designs of small to
   medium flexible circuits feasible. However, the absence of a unified
   model and comprehensive evaluation benchmarks for flexible electronics
   makes it infeasible for a designer to fairly compare different flexible
   technologies and to explore potential design options for a heterogeneous
   FHE design. In this paper, we present AutoFlex, a unified evaluation and
   design framework for flexible hybrid electronics, where device
   parameters can be extracted automatically and performance can be
   evaluated comprehensively from device levels, digital blocks to
   large-scale digital circuits. Moreover, a ubiquitous FHE sensor
   acquisition system, including a flexible multi-functional sensor array,
   scan drivers, amplifiers and a silicon based analog-to-digital converter
   (ADC), is developed to reveal the design challenges of a representative
   FHE system.},
Type = {Proceedings Paper},
Affiliation = {Ma, TL (Corresponding Author), Shanghai Jiao Tong Univ, Shanghai, Peoples R China.
   Ma, Tianliang; Deng, Zhihui; Shao, Leilai, Shanghai Jiao Tong Univ, Shanghai, Peoples R China.},
