# 文献计量项目 - 检索式配置
# 符合课程要求：Query as Code / 可复现 / 版本化
version: "0.1"
name: RISC-V处理器设计文献检索
time_window: [2016, 2025]
fields: [title, abstract]
doc_type: [Article, Review]
language: English

# 检索式布尔结构（课程标准模板）
# (Object) AND (Subject) AND (Method/Topic) NOT (Exclusion)
query:
  object:
    - "RISC-V"
    - "RISC V"
    - "RISC_V"
    - "RV32"
    - "RV64"
  
  subject:
    - "CPU"
    - "central processing unit"
    - "processor"
    - "microprocessor"
    - "core"
  
  method:
    - "design"
    - "architecture"
    - "implementation"
    - "microarchitecture"

  exclusion:
    - "GPU"
    - "graphics processing unit"
    - "DSP"
    - "digital signal processor"
    - "FPGA"
    - "ASIC"
    - "accelerator"
