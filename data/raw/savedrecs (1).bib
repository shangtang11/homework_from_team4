EarlyAccessDate = {APR 2025},
Keywords = {Probabilistic logic; Bayes methods; Diseases; Cognition; Hardware;
   Computational modeling; Parallel processing; Monte Carlo methods; Markov
   random fields; Interpolation; Approximate inference; customized RISC-V;
