@article{ WOS:001633047500001,
Author = {Choi, Joonwon and Kim, Jaewoo and Kang, Jeehoon},
Title = {Revamping Verilog Semantics for Foundational Verification},
Journal = {PROCEEDINGS OF THE ACM ON PROGRAMMING LANGUAGES-PACMPL},
Year = {2025},
Volume = {9},
Number = {OOPSLA2, OOPLA2},
Month = {OCT},
Abstract = {In formal hardware verification, particularly for Register-Transfer
   Level (RTL) designs in Verilog, model checking has been the predominant
   technique. However, it suffers from state explosion, limited expressive
   power, and a large trusted computing base (TCB). Deductive verification
   offers greater expressive power and enables foundational verification
   with a minimal TCB. Nevertheless, Verilog's standard semantics,
   characterized by its nondeterministic and global scheduling, pose
   significant challenges to its application. To address these challenges,
   we propose a new Verilog semantics designed to facilitate deductive
   verification. Our semantics is based on least fixpoints to enable
   cycle-level functional evaluation and modular reasoning. For
   foundational verification, we prove our semantics equivalent to the
   standard scheduling semantics for synthesizable designs. We demonstrate
   the benefits of our semantics with a modular verification of a pipelined
   RISC-V processor's functional correctness and progress guarantees. All
   our results are mechanized in Rocq.},
Type = {Article},
Affiliation = {Choi, J (Corresponding Author), Amazon Web Serv, Seattle, WA 98109 USA.
