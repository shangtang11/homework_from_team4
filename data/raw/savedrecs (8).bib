@inproceedings{ WOS:000981574300130,
Author = {Collini, Luca and Tan, Benjamin and Pilato, Christian and Karri, Ramesh},
Book-Group-Author = {IEEE},
Title = {Reconfigurable Logic for Hardware IP Protection: Opportunities and
   Challenges (Invited Paper)},
Booktitle = {2022 IEEE/ACM INTERNATIONAL CONFERENCE ON COMPUTER AIDED DESIGN, ICCAD},
Series = {ICCAD-IEEE ACM International Conference on Computer-Aided Design},
Year = {2022},
Note = {IEEE/ACM 41st International Conference on Computer Aided-Design (ICCAD),
   San Diego, CA, OCT 29-NOV 03, 2022},
Abstract = {Protecting the intellectual property (IP) of integrated circuit (IC)
   design is becoming a significant concern of fab-less semiconductor
   design houses. Malicious actors can access the chip design at any stage,
   reverse engineer the functionality, and create illegal copies. On the
   one hand, defenders are crafting more and more solutions to hide the
   critical portions of the circuit. On the other hand, attackers are
   designing more and more powerful tools to extract useful information
   from the design and reverse engineer the functionality, especially when
   they can get access to working chips. In this context, the use of custom
   reconfigurable fabrics has recently been investigated for hardware IP
   protection. This paper will discuss recent trends in hardware
   obfuscation with embedded FPGAs, focusing also on the open challenges
   that must be necessarily addressed for making this solution viable.},
