   Sinanoglu, Ozgur, New York Univ Abu Dhabi, Div Engn, Abu Dhabi, U Arab Emirates.},
DOI = {10.1109/TCAD.2022.3231174},
Keywords = {High output corruption; large-scale locking; learning-resilient; logic
   locking; sequential satisfiability (SAT)-based attacks},
