@article{ WOS:000899056400001,
Author = {Haris, Jude and Gibson, Perry and Cano, Jose and Agostini, Nicolas Bohm
   and Kaeli, David},
Title = {SECDA-TFLite: A toolkit for efficient development of FPGA-based DNN
   accelerators for edge inference},
Journal = {JOURNAL OF PARALLEL AND DISTRIBUTED COMPUTING},
Year = {2023},
Volume = {173},
Pages = {140-151},
Month = {MAR},
Abstract = {In this paper we propose SECDA-TFLite, a new open source toolkit for
   developing DNN hardware accelerators integrated within the TFLite
   framework. The toolkit leverages the principles of SECDA, a
   hardware/software co-design methodology, to reduce the design time of
   optimized DNN inference accelerators on edge devices with FPGAs. With
   SECDA-TFLite, we reduce the initial setup costs associated with
   integrating a new accelerator design within a target DNN framework,
   allowing developers to focus on the design. SECDA-TFLite also includes
   modules for cost-effective SystemC simulation, profiling, and AXI-based
   data communication. As a case study, we use SECDA-TFLite to develop and
   evaluate three accelerator designs across seven common CNN models and
   two BERT-based models against an ARM A9 CPU-only baseline, achieving an
   average performance speedup across models of up to 3.4x for the CNN
   models and of up to 2.5x for the BERT-based models. Our code is
   available at https:// github .com /gicLAB /SECDA-TFLite. (c) 2022 The
   Authors. Published by Elsevier Inc. This is an open access article under
   the CC BY license (http://creativecommons.org/licenses/by/4.0/).},
