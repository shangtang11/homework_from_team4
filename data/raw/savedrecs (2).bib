@inproceedings{ WOS:001540569200015,
Author = {Aspros, Maxime Henri and Sapriza, Juan and Ansaloni, Giovanni and
   Atienza, David},
Book-Group-Author = {ACM},
Title = {A flexible framework for early power and timing comparison of
   time-multiplexed CGRA kernel executions},
Booktitle = {COMPANION PROCEEDINGS OF THE 22ND ACM INTERNATIONAL CONFERENCE ON
   COMPUTING FRONTIERS 2025 WORKSHOPS AND SPECIAL SESSIONS, CF2025},
Year = {2025},
Pages = {62-65},
Note = {22nd International Conference on Computing Frontiers-CF, Cagliari,
   ITALY, MAY 28-30, 2025},
Abstract = {At the intersection between traditional CPU architectures and more
   specialized options such as FPGAs or ASICs lies the family of
   reconfigurable hardware architectures, termed Coarse-Grained
   Reconfigurable Arrays (CGRAs). CGRAs are composed of a 2-D array of
   processing elements (PE), tightly integrated with each other, each
   capable of performing arithmetic and logic operations. The vast design
   space of CGRA implementations poses a challenge, which calls for fast
   exploration tools to prune it in advance of time-consuming syntheses.
   The proposed tool aims to simplify this process by simulating kernel
   execution and providing a characterization framework. The estimator
   returns energy and latency values otherwise only available through a
   time-consuming post-synthesis simulation, allowing for instantaneous
   comparative analysis between different kernels and hardware
   configurations.},
Type = {Proceedings Paper},
Affiliation = {Aspros, MH (Corresponding Author), Polytech Montreal, Montreal, PQ, Canada.
   Aspros, Maxime Henri, Polytech Montreal, Montreal, PQ, Canada.
   Sapriza, Juan, Ecole Polytech Fed Lausanne, Lausanne, Switzerland.
   Ansaloni, Giovanni; Atienza, David, Ecole Polytech Fed Lausanne, Embedded Syst Lab, STI, Lausanne, Switzerland.},
DOI = {10.1145/3706594.3726977},
Keywords = {CGRA; Design Space Exploration; Simulator},
Author-Email = {maxime.aspros@polymtl.ca
   juan.sapriza@epfl.ch
   giovanni.ansaloni@epfl.ch
   david.atienza@epfl.ch},
Affiliations = {Universite de Montreal; Polytechnique Montreal; Swiss Federal Institutes
