@article{ WOS:001682771500001,
Author = {Yang, Ziyi and Wang, Yushi and Yang, Jinqiao and Yan, Quanshu and Xiao,
   Anqin and Zheng, Li-Rong and Zou, Zhuo},
Title = {An Always-On Event-Triggered DVS Fall Detection Processor With
   Precision-Adaptive Inference in 40-nm CMOS},
Journal = {IEEE TRANSACTIONS ON CIRCUITS AND SYSTEMS I-REGULAR PAPERS},
Year = {2026},
Month = {2026 FEB 6},
Abstract = {Fall detection is critical in elderly care, where always-on, low-power
   monitoring is essential due to multi-node, battery-powered deployment
   across complex home environments. This work presents an event-triggered
   fall detection chip with precision-adaptive inference, optimized for
   always-on real-time processing of Dynamic Vision Sensor (DVS) data. The
   proposed chip features an end-to-end architecture that directly accepts
   raw address event representation (AER) input and integrates a
   preprocessing module and a precision-adaptive spiking neural network
   (SNN) into a unified hardware framework. The proposed chip dynamically
   adjusts inference precision based on real-time activity levels: low-risk
   actions trigger low-precision inference with 4-bit weights, while
   high-risk movements switch to high-precision 8-bit inference for
   accurate fall detection. Additionally, the chip incorporates a generic
   memory-free spatiotemporal denoising architecture which contributes to
   at least a 1\% improvement in accuracy, while a timestep skipping
   strategy further reduces energy and latency by nearly 20\% during
   few-event periods without sacrificing performance for fall detection.
   Fabricated in 40-nm CMOS, the chip occupies 0.88 mm(2), and achieves the
   best energy efficiency of 2.2 pJ/SOP at 20 MHz. This processor achieves
   3.9 pJ per event on the DVSGesture128 dataset, demonstrating
   state-of-the-art performance in event-level processing efficiency. In
   the typical home-activity scenario, the event-triggered mode achieves a
   64.8\% improvement in battery life compared to the fixed 8-bit precision
   configuration.},
Type = {Article; Early Access},
Affiliation = {Zou, Z (Corresponding Author), Fudan Univ, Coll Future Informat Technol, State Key Lab Integrated Chips \& Syst, Shanghai 200433, Peoples R China.
   Yang, Ziyi; Wang, Yushi; Yang, Jinqiao; Yan, Quanshu; Xiao, Anqin; Zheng, Li-Rong; Zou, Zhuo, Fudan Univ, Coll Future Informat Technol, State Key Lab Integrated Chips \& Syst, Shanghai 200433, Peoples R China.},
DOI = {10.1109/TCSI.2026.3658356},
EarlyAccessDate = {FEB 2026},
