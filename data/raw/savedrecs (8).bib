@inproceedings{ WOS:001071492700044,
Author = {Ferrari, Victor and Sousa, Rafael and Pereira, Marcio and de Carvalho,
   Joao P. L. and Amaral, Jose Nelson and Araujo, Guido},
Book-Group-Author = {ACM},
Title = {Improving Convolution via Cache Hierarchy Tiling and Reduced Packing},
Booktitle = {PROCEEDINGS OF THE 2022 31ST INTERNATIONAL CONFERENCE ON PARALLEL
   ARCHITECTURES AND COMPILATION TECHNIQUES, PACT 2022},
Year = {2022},
Pages = {538-539},
Note = {31st International Conference on Parallel Architectures and Compilation
   Techniques (PACT), Discovery Partners Inst, Chicago, IL, OCT 08-12, 2022},
Abstract = {Convolution is one of the most computationally intensive machine
   learning model operations, usually solved by the known Im2Col + BLAS
   method. Thiswork proposes a novel convolution-algorithm to improve upon
   Im2Col + BLAS by introducing (a) CSA: a convolution specific 3D
   cache-blocking analysis that focuses on tile reuse over the cache
   hierarchy, (b) CSO: a macro-kernel that follows CSA to compute the
   convolution by tiling it, (c) a specialized microkernel that seeks to
   achieve peak hardware performance, and (d) packing routines for the
   input tensor and filters to bridge the gap between tiling and
   micro-kernel. Our approach speeds up end-toend machine learning model
   inference by up to 26\% and 21\% for x86 and POWER10 architectures,
   respectively.},
Type = {Proceedings Paper},
Affiliation = {Ferrari, V (Corresponding Author), Univ Estadual Campinas, Inst Comp, Campinas, Brazil.
   Ferrari, Victor; Sousa, Rafael; Araujo, Guido, Univ Estadual Campinas, Inst Comp, Campinas, Brazil.
