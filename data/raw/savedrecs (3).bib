@inproceedings{ WOS:001683462200750,
Author = {Yadav, Aasmaan and Garcia, Fernando Cuello and Gonzalez, Alejandro and
   Trevisan, Bernardo Eilert and Xu, Anna and Ugur, Muhammed and
   Bhattacharjee, Abhishek and Pothukuchi, Raghavendra Pradyumna},
Book-Group-Author = {IEEE},
Title = {Foresee: A Modular and Open Framework to Explore Integrated Processing
   on Brain-Computer Interfaces},
Booktitle = {2025 47TH ANNUAL INTERNATIONAL CONFERENCE OF THE IEEE ENGINEERING IN
   MEDICINE AND BIOLOGY SOCIETY (EMBC)},
Series = {Annual International Conference of the IEEE Engineering in Medicine and
   Biology Society},
Year = {2025},
Note = {47th International Conference of the Engineering in Medicine and Biology
   Society-EMBC-Annual, Copenhagen, DENMARK, JUL 14-18, 2025},
Abstract = {Brain-computer interfaces (BCIs) with processing integrated on the
   device enable fast and autonomous closed-loop interaction with the
   brain. While such BCIs are rapidly gaining traction, they are also
   difficult to design due to the tight and conflicting power and
   performance needs of on-device processing. Meeting these specifications
   often requires the BCI processors to be co-designed with applications
   and algorithms, with processor designers and computational
   neuroscientists working closely to converge on the target hardware
   platform. But, this process has traditionally been cumbersome and ad
   hoc, due to the lack of systematic design space exploration frameworks.
   In response, we present Foresee, a new framework for fast exploration of
   BCI processors. Foresee offers a unified and modular interface for
   iteratively co-optimizing BCI processors with their algorithms, without
   sacrificing accuracy, speed, or ease of use. Foresee is publicly
   available, and comes with a library of hardware blocks for common signal
   processing functions that the community could contribute and build on.
   We demonstrate Foresee's utility and capability by analyzing on-device
   processing for two seizure detection methods from prior work, and
   validating our analysis on real hardware. We expect Foresee to be vital
   in designing next-generation BCIs.},
