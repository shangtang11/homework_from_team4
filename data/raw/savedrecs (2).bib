@inproceedings{ WOS:001661593600072,
Author = {Andjelkovie, Marko and Syed, Rizwan Tariq and Chen, Junchao and Vargas,
   Fabian and Ulbricht, Markus and Petri, Markus},
Book-Group-Author = {IEEE},
Title = {A Resilient Processing Platform for 6G Wireless Communication Networks},
Booktitle = {2025 IEEE 34TH INTERNATIONAL CONFERENCE ON MICROELECTRONICS, MIEL},
Series = {International Conference on Microelectronics-MIEL},
Year = {2025},
Pages = {363-368},
Note = {34th IEEE International Conference on Microelectronics-MIEL-Annual,
   SERBIA, OCT 13-16, 2025},
Abstract = {Resilience is one of the key requirements for the future 6G wireless
   communication networks. The hardware components for the 6G network nodes
   should be self-aware and self-adaptive, allowing for timely detection of
   transient and permanent faults, and autonomous system reconfiguration in
   order to maintain the required functionality even in the case of
   anomalies. In this work, we present our preliminary design of a
   resilient processing platform intended to serve as a processing unit in
   6G network nodes. The platform integrates a quad-core RISC-V processor,
   a triple-core neural network accelerator, memory blocks, a variety of
   on-chip sensors, and a customized controller for fault management and
   operating mode selection. The prototype of the processing platform has
   been implemented on a commercial FPGA platform, and the selected use
   case is the radar-based hand gesture recognition.},
