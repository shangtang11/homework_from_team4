@inproceedings{ WOS:001477286700001,
Author = {Fukai, Takaaki and Mori, Manami and Sakamoto, Ryuichi and Hirofuchi,
   Takahiro and Asaka, Takuya},
Book-Group-Author = {ACM},
Title = {A Thin Hypervisor Approach to Multi-Tenant SmartNICs in Edge Data
   Centers},
Booktitle = {PROCEEDINGS OF THE 8TH INTERNATIONAL WORKSHOP ON EDGE SYSTEMS, ANALYTICS
   AND NETWORKING, EDGESYS 2025},
Year = {2025},
Pages = {1-6},
Note = {8th International Workshop on Edge Systems Analytics and
   Networking-EDGESYS, Rotterdam, NETHERLANDS, MAR 30-APR 03, 2025},
Abstract = {In the post-5G era, reducing service response times is crucial for edge
   workloads. SmartNICs are network devices capable of offloading various
   types of processing, with the potential to reduce service response
   times. To provide SmartNICs to users of multi-tenant edge data centers,
   it is necessary to ensure security, software reusability, and
   manageability without performance degradation.
   In this study, we propose a SmartNIC design based on a thin hypervisor
   running on a SmartNIC equipped with a general-purpose processor. The
   hypervisor partitions hardware resources into multiple execution
   environments that can run arbitrary software, including OSes while
   isolating them from each other. It also can be foundation for
   implementing management functions. This paper also provides insights
   into hardware design to minimize hypervisor overhead. To validate the
   proposed method, we implemented a prototype and evaluated it on NVIDIA
   Bluefield-2 and AMD Alveo U25, which includes an FPGA-implemented TCP
   offload engine. The evaluation results demonstrate that the proposed
   system meets the requirements with negligible performance degradation.},
