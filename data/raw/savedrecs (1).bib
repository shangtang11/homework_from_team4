@article{ WOS:001442951900007,
Author = {Ye, Jin and Peng, Yajun and Li, Yijun and Li, Zhaoyi and Huang, Jiawei},
Title = {Asynchronous Control Based Aggregation Transport Protocol for
   Distributed Deep Learning},
Journal = {IEEE TRANSACTIONS ON COMPUTERS},
Year = {2025},
Volume = {74},
Number = {4},
Pages = {1362-1376},
Month = {APR},
Abstract = {With the rapid growth scale of dataset and model, the training of deep
   neural networks (DNN) tends to be deployed in a distributed manner. In
   the large-scale distributed training, the bottlenecks have gradually
   moved from computational resources to communication process. Recent
   researches adopt in-network aggregation (INA) that offloads the gradient
   aggregation process to programmable switches, thereby reducing network
   traffic amount and transmission latency. Unfortunately, due to the
   bandwidth competition in shared training clusters, the straggler will
   slow down the training efficiency of INA. To address this issue, we
   propose an Asynchronous Control based Aggregation Transport Protocol
   (AC-ATP), which makes full use uncongested links to transmit gradients
   and the switch memory to cache gradients from the fast workers to
   accelerate the gradient aggregation. Meanwhile, AC-ATP performs
   congestion control according to the transmission progress of worker and
   the remaining completion time of the job. The evaluation results of real
   testbed and large-scale simulations show that AC-ATP reduces the
   aggregate time by up to 68\% and speeds up training in real-world
   benchmark models.},
Type = {Article},
Affiliation = {Huang, JW (Corresponding Author), Cent South Univ, Sch Comp Sci \& Engn, Changsha 410083, Peoples R China.
   Ye, Jin; Peng, Yajun, Guangxi Univ, Sch Comp \& Elect Informat, Nanning 530004, Peoples R China.
   Li, Yijun; Li, Zhaoyi; Huang, Jiawei, Cent South Univ, Sch Comp Sci \& Engn, Changsha 410083, Peoples R China.},
DOI = {10.1109/TC.2025.3525604},
Keywords = {Switches; Training; Bandwidth; Computers; Transport protocols; Memory
   management; Control systems; Artificial neural networks; Deep learning;
   Servers; Distributed training; in-network aggregation; straggler;
