   Georg and Claus, Martin and Schulz, Stefan E. and Schroeter, Michael and
   Hermann, Sascha},
Title = {Gate Spacer Investigation for Improving the Speed of High-Frequency
   Carbon Nanotube-Based Field-Effect Transistors},
Journal = {ACS APPLIED MATERIALS \& INTERFACES},
Year = {2020},
Volume = {12},
Number = {24},
Pages = {27461-27466},
Month = {JUN 17},
Abstract = {Carbon nanotube (CNT)-based field-effect transistors have demonstrated
   great potential for high-frequency (HF) analog transceiver electronics.
   Despite significant advancements, one of the remaining challenges is the
   optimization of the device architecture for obtaining the highest
   possible speed and linearity. While most studies so far have
   concentrated on symmetrical top gated FET devices, we report on the
   impact of the device architecture on their HF performance. Based on a
   wafer-level nanotechnology platform and device simulations, transistors
   with a buried gate having different widths and positions in the FET
   channel have been fabricated. Analysis of several FETs with
   nonsymmetrical gate electrode location in the channel revealed a speed
   increase of up to 18\% measured by the external transit frequency f(T)
   and maximum frequency of oscillation f(max). Although only randomly
   oriented CNTs with a density of 25 CNTs/pm and 280 nm long channels were
   used in this study, transit frequencies up to 14 GHz were obtained.},
