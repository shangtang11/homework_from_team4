@article{ WOS:001631713800001,
Author = {Zhang, Xiaojun and Song, Xin and Liu, Shuguang and Liu, Yue and Gao,
   Jian},
Title = {MRSA: A multi-mode reconfigurable systolic array architecture based on
   channel-wise stationary dataflow for CNNs},
Journal = {MICROELECTRONICS JOURNAL},
Year = {2026},
Volume = {168},
Month = {FEB},
Abstract = {Convolutional neural networks (CNNs) exhibit increasing architectural
   depth and substantial heterogeneity in input feature map dimensionality,
   presenting significant challenges for efficient hardware acceleration.
   Existing dataflows often have difficulty maintaining high processing
   unit utilization and low computational latency while ensuring
   compatibility. To address this issue, we designed a channel-wise
   stationary (CS) dataflow for CNN accelerators, which can be compatible
   with arbitrary convolutional kernel sizes and effectively reuses ifmaps,
   alleviating access bandwidth bottlenecks. Based on this, we proposed a
   multi-mode reconfigurable systolic array (MRSA) architecture. By
   splitting data in the channel dimension and extending the systolic array
   (SA) units in the column dimension, the SA can support various sizes of
   input tensors in different modes without incurring extra memory
   bandwidth overhead. Accurate scheduling of processing units enables
   pipeline cyclic splicing and latency overlapping, enhancing the
   computational unit utilization. Experiments show that the MRSA
   architecture based on CS dataflow achieves average processing unit
   utilization rates of 86.5\%, 94.9\%, and 98.8\% in the convolutional
   layers of AlexNet, YOLOv3-Tiny, and VGG16, respectively.},
Type = {Article},
Affiliation = {Gao, J (Corresponding Author), Shandong Univ Sci \& Technol, 579 Qianwangang Rd, Qingdao 266590, Shandong, Peoples R China.
   Zhang, Xiaojun; Song, Xin; Liu, Shuguang; Liu, Yue; Gao, Jian, Shandong Univ Sci \& Technol, 579 Qianwangang Rd, Qingdao 266590, Shandong, Peoples R China.},
