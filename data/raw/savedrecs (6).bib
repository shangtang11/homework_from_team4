@inproceedings{ WOS:001042307500103,
Author = {Derasari, Preet and Gogineni, Kailash and Venkataramani, Guru},
Book-Group-Author = {ACM},
Title = {MAYAVI: A Cyber-Deception Hardware for Memory Load-Stores},
Booktitle = {PROCEEDINGS OF THE GREAT LAKES SYMPOSIUM ON VLSI 2023, GLSVLSI 2023},
Year = {2023},
Pages = {563-568},
Note = {33rd Great Lakes Symposium on VLSI (GLSVLSI), Knoxville, TN, JUN 05-07,
   2023},
Abstract = {Rapid evolution of security attacks presents a perpetual challenge to
   computer system defenders in terms of continuously upgrading their
   defense capabilities and being aware of adversarial tactics. Emerging
   technologies like cyber-deception offer the unique advantage of
   intelligently surveying hostile behavior while actively safeguarding
   sensitive assets by manipulating the malware execution flow to
   non-useful states or misrepresenting critical data.
   This paper explores the untapped potential of a hardware-assisted
   cyber-deception framework that augments a contemporary processor's
   abilities to realize a proactive deception platform. We present MAYAVI,
   a load/store unit-based hardware deception engine that dynamically
   alters the target addresses of memory requests issued by a malicious
   process. The redirected requests can lead to honeypots that actively
   engage and deceive the adversary. Our experimental results show MAYAVI's
   efficacy against recent malware families while incurring negligible
   performance impact.},
Type = {Proceedings Paper},
Affiliation = {Derasari, P (Corresponding Author), George Washington Univ, Washington, DC 20052 USA.
