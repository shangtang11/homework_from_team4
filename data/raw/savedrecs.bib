@article{ WOS:001669243400012,
Author = {Li, Yu and Liu, Yu and Dai, Anchen and Li, Hangyu and Shen, Yanlong and
   Zhou, Ying},
Title = {HANAMI: Hardware-Assisted Fuzzing for Microcontroller Firmware With
   Neural Network Assistance},
Journal = {IEEE INTERNET OF THINGS JOURNAL},
Year = {2026},
Volume = {13},
Number = {3},
Pages = {4992-5005},
Month = {FEB 1},
Abstract = {Fuzzing for the microcontroller unit (MCU) firmware presents unique
   challenges compared to conventional program code fuzzing due to hardware
   limitations and restricted runtime visibility. While firmware emulation
   and hardware-assisted methods mitigate execution environment challenges
   for embedded fuzzing tools, the efficiency of fuzzing MCU firmware,
   especially peripheral driver code, is still limited by sparse code
   coverage and insufficient path exploration. To overcome these
   challenges, we propose hardware-assisted fuzzing for microcontroller
   firmware with neural network assistance (HANAMI), a coverage-guided
   firmware fuzzing framework that incorporates reinforcement learning (RL)
   to overcome these limitations. HANAMI employs ARM Embedded Trace
   Macrocell (ETM) to gather real-time instruction execution traces.
   Instead of relying on traditional random mutators, HANAMI employs a deep
   RL (DRL) agent to prioritize high-value code regions and optimize
   mutation strategies. In addition, we design a new reward scheme for
   HANAMI, in which the intrinsic curiosity module (ICM) is introduced to
   shape the intrinsic reward. This approach is aimed at enhancing the
   discovery of sparse firmware code paths. We implement HANAMI and
   evaluate it on the NXP S32K148EVB board, where it succeeds in
   discovering more paths than the baseline and shows its potential for
   fuzzing real-world Internet of Things (IoT) applications.},
Type = {Article},
Affiliation = {Zhou, Y (Corresponding Author), Shenzhen Campus Sun Yat Sen Univ, Sch Elect \& Commun Engn, Shenzhen 518107, Peoples R China.
