Title = {TinyIDS - An IoT Intrusion Detection System by Tiny Machine Learning},
Booktitle = {COMPUTATIONAL SCIENCE AND ITS APPLICATIONS-ICCSA 2024 WORKSHOPS, PT II},
Series = {Lecture Notes in Computer Science},
Year = {2024},
Volume = {14816},
