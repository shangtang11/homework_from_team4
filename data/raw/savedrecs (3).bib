@article{ WOS:001308913200001,
Author = {Contoli, Chiara and Freschi, Valerio and Lattanzi, Emanuele},
Title = {Energy-aware human activity recognition for wearable devices: A
   comprehensive review},
Journal = {PERVASIVE AND MOBILE COMPUTING},
Year = {2024},
Volume = {104},
Month = {NOV},
Abstract = {With the rapid advancement of wearable devices, sensor-based human
   activity recognition has emerged as a fundamental research area with
   broad applications in various domains. While significant progress has
   been made in this research field, energy consumption remains a critical
   aspect that deserves special attention. Recognizing human activities
   while optimizing energy consumption is essential for prolonging device
   battery life, reducing charging frequency, and ensuring uninterrupted
   monitoring and functionality. The primary objective of this survey paper
   is to provide a comprehensive review of energyaware wearable human
   activity recognition techniques based on wearable sensors without
   considering vision-based systems. In particular, it aims to explore the
   state-of-the-art approaches and methodologies that integrate activity
   recognition with energy management strategies. Finally, by surveying the
   existing literature, this paper aims to shed light on the challenges,
   opportunities and potential solutions for energy-aware human activity
   recognition.},
