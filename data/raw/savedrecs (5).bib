DOI = {10.1109/ACCESS.2024.3450105},
Keywords = {Optimization; Codes; Topology; Software algorithms; Synthesizers;
   Software development management; Algorithm design and analysis; Circuit
   synthesis; Algorithmic-level explorations; circuit design;
   Logic-in-Memory (LiM); von Neumann bottleneck},
