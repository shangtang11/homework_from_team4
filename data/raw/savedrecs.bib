@article{ WOS:001706516800001,
Author = {Tohidi, Hamed and Ghanatghestani, Mokhtar Mohammadi and Shahbazzadeh,
   Mehdi Jafari and Eslami, Mahdiyeh},
Title = {A low-power, energy-efficient, and highly-accurate approximate
   compressor design for arithmetic circuits},
Journal = {INTEGRATION-THE VLSI JOURNAL},
Year = {2026},
Volume = {109},
Month = {JUL},
Abstract = {As the number of transistors increases in modern electronic devices,
   minimizing power consumption and maximizing processing speed have become
   crucial design considerations. Approximate computing has emerged as an
   effective approach to reduce energy consumption by trading off a small
   degree of accuracy. Multipliers, which are extensively used in digital
   signal processing algorithms, rely on compressor cells as fundamental
   building blocks. This paper presents a novel approximate compressor cell
   based on carbon nanotube field-effect transistor (CNFET), implemented
   using a hybrid standard CMOS (S-CMOS) and transmission gate logic (TGL)
   style. Comprehensive simulations at both circuit and application levels
   validate the proposed cell's efficiency. HSPICE simulations demonstrate
   a significant improvement in the power-delay-area product (PDAP) of at
   least 43.31\% at 0.9 V power supply compared to existing circuits. Monte
   Carlo (MC) transient analysis confirms the cell's robustness against
   manufacturing variations. Furthermore, the functionality of the proposed
   cell in an image sharpening algorithm, assessed using peak
   signal-to-noise ratio (PSNR) and structural similarity (SSIM) metrics,
   demonstrates its suitability for fault-tolerant image processing
   applications. A fair comparison of circuit efficacy is facilitated by
   introducing key figures of merit (FOMs). Results demonstrate the
   proposed cell outperforms existing designs.},
Type = {Article},
Affiliation = {Ghanatghestani, MM (Corresponding Author), Islamic Azad Univ, Dept Comp Engn, Bam C, Bam, Iran.
   Tohidi, Hamed; Shahbazzadeh, Mehdi Jafari; Eslami, Mahdiyeh, Islamic Azad Univ, Dept Elect Engn, KeC, Kerman, Iran.
