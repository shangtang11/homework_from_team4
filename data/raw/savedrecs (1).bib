@article{ WOS:001480312800001,
Author = {Yin, Guodong and Chen, Yiming and Lee, Mingyen and Du, Xirui and Ke, Yue
   and Tang, Wenjun and Chen, Zhonghao and Zhou, Mufeng and Yue, Jinshan
   and Yang, Huazhong and Jia, Hongyang and Liu, Yongpan and Li, Xueqing},
Title = {Hybrid SRAM/ROM Compute-in-Memory Architecture for High Task-Level
   Energy Efficiency in Transformer Models With 8928-kb/mmTEXPRESERVE0
   Density in 28nm CMOS},
Journal = {IEEE JOURNAL OF SOLID-STATE CIRCUITS},
Year = {2025},
Volume = {60},
Number = {11},
Pages = {4140-4153},
Month = {NOV},
Abstract = {This article reports the first ultra-high-density hybrid static random
   access memory (SRAM)/read-only memory (ROM) compute-in-memory (CiM)
   architecture for multibit multiply-accumulate (MAC) operations of
   transformer models. It features several techniques that enhance the
   on-chip weight density, energy efficiency, and flexibility, namely: 1)
   the hybrid CiM structure of 6T SRAM and 1T multi-level cell (MLC) ROM
   for ultra-high memory density to improve the limited on-chip memory
   capacity and alleviate the frequent weight reload from dynamic random
   access memory (DRAM); 2) 2-/5-b adaptive-resolution analog-to-digital
   converters (ADCs) for energy reduction and low accuracy loss; and 3)
   post-fabrication 1-of-4 capacitor selection (PFCS) to reduce the
   capacitance of computing capacitors, which was originally limited by the
   capacitor variation. This leads to lower energy and higher accuracy. A
   record-high 22-Mb ROM CiM and 896-kb SRAM CiM macro has demonstrated the
   8 x 8 b MAC operations of one transformer layer, featuring ultra-high
   weight density of 8928 kb/mm(2) and significantly reduced DRAM access
   activities toward high inference energy efficiency.},
