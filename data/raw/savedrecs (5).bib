Title = {ELEVATE: Optimal scheduling of time-sensitive tasks on the heterogeneous
   reconfigurable Edge},
Booktitle = {2024 IEEE 32ND INTERNATIONAL CONFERENCE ON NETWORK PROTOCOLS, ICNP},
Series = {IEEE International Conference on Network Protocols Proceedings},
Year = {2024},
Note = {32nd International Conference on Network Protocols, Charleroi, BELGIUM,
   OCT 28-31, 2024},
Abstract = {Edge computing is evolving to include heterogeneous compute nodes with
   distinct characteristics. Graphic processing units (GPU) and
   field-programmable gate arrays (FPGA) can execute demanding deep
   learning (DL) tasks while meeting the deadlines of time-sensitive
   applications. However, FPGAs require reconfiguration to execute
   different tasks. In this paper, we first demonstrate that FPGAs can be
   reconfigured in real-time. Additionally, we propose ELEVATE as a novel
   scheduling algorithm for reconfigurable heterogeneous edge computing
   platforms targeting Industry 4.0 post-production quality control.
   ELEVATE design focusses on optimising the reconfiguration of the FPGA
   unit for heterogeneous quality inspection tasks. Our simulations
   indicate that ELEVATE reduces task waiting time by up to two orders of
   magnitude and achieves energy savings of up to 25\% compared to a
   statically configured FPGA unit.},
