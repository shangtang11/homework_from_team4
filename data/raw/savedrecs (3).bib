@inproceedings{ WOS:001566005900149,
Author = {Salinas, Gonzalo and Sequeira, Guilherme and Rodriguez, Alfonso and
   Bispo, Joao and Paulino, Nuno},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {SIMD Acceleration of Matrix-Vector Operations on RISC-V for Variable
   Precision Neural Networks},
Booktitle = {2025 IEEE INTERNATIONAL PARALLEL AND DISTRIBUTED PROCESSING SYMPOSIUM
   WORKSHOPS, IPDPSW},
