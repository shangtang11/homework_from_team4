@inproceedings{ WOS:000698732400038,
Author = {Bragg, Nate F. F. and Foster, Jeffrey S. and Roux, Cody and
   Solar-Lezama, Armando},
Editor = {Silva, A and Leino, KRM},
Title = {Program Sketching by Automatically Generating Mocks from Tests},
Booktitle = {COMPUTER AIDED VERIFICATION (CAV 2021), PT I},
Series = {Lecture Notes in Computer Science},
Year = {2021},
Volume = {12759},
Pages = {808-831},
Note = {33rd International Conference on Computer-Aided Verification (CAV),
   ELECTR NETWORK, JUL 20-23, 2021},
Abstract = {Sketch is a popular program synthesis tool that solves for unknowns in a
   sketch or partial program. However, while Sketch is powerful, it does
   not directly support modular synthesis of dependencies, potentially
   limiting scalability. In this paper, we introduce Sketcham, a new
   technique that modularizes a regular sketch by automatically generating
   mocks-functions that approximate the behavior of complete
   implementations-from the sketch's test suite. For example, if the
   function f originally calls g, Sketcham creates a mock g(m) from g's
   tests and augments the sketch with a version of f that calls g(m). This
   change allows the unknowns in f and g to be solved separately, enabling
   modular synthesis with no extra work from the Sketch user. We evaluated
   Sketcham on ten benchmarks, performing enough runs to show at a 95\%
   confidence level that Sketcham improves median synthesis performance on
   six of our ten benchmarks by a factor of up to 5 x compared to plain
   Sketch, including one benchmark that times out on Sketch, while
   exhibiting similar performance on the remaining four. Our results show
   that Sketcham can achieve modular synthesis by automatically generating
   mocks from tests.},
