@article{ WOS:001606221600003,
Author = {Wang, Xi and Xiang, Ruiheng and Zhu, Xinning and Chu, Xuyang and Ke,
   Yuzhi and Zhou, Wei},
Title = {Consistency evaluation of high-power PEM fuel cell stacks using an
   entropy-weighted index},
Journal = {ENERGY CONVERSION AND MANAGEMENT},
Year = {2026},
Volume = {348},
Number = {B},
Month = {JAN 15},
Abstract = {The output performance and operational lifetime of kilowatt-scale proton
   exchange membrane (PEM) fuel cell stacks are significantly limited by
   the `bucket effect', wherein stack durability is constrained by the
   weakest single fuel cell. To address this issue, this work develops an
   entropy-weighted consistency index (EWCI), integrating Shannon entropy
   with weighted voltage deviation, to systematically evaluate the
   performance uniformity within a 5 kW fuel cell stack. The evolution
   characteristics of inconsistency at both the stack and single-cell
   levels were revealed through systematic testing of polarization curves
   and high-frequency resistance under varying conditions of temperature,
   relative humidity (RH), stoichiometric ratio (SR), and back-pressure.
   The developed EWCI reliably identifies underperforming cells and
   quantitatively measures their voltage instability. Under adverse
   operating conditions, including low temperature (45 degrees C, Case 1),
   low RH (20 \%, Case 4), low hydrogen supply (1.4 SR, Case 9), and low
   back-pressure (50 kPa, Case 8), the fuel cell stack exhibited pronounced
   nonuniformity, with corresponding EWCI values of 15.18, 7.49, 15.05, and
   13.83 bits, respectively. Further dynamic load experiments demonstrated
   that stack heterogeneity features transient fluctuation behavior, with
   the maximum instantaneous EWCI reaching 25.11 bit (Case 1). The end cell
   shows the poorest consistency, with a local EWCI of up to 8.8 bit,
   acting as the primary performance bottleneck. This study establishes a
   quantitative index for characterizing internal inconsistency in PEMFC
   stacks, offering foundational insights for both performance optimization
   and intelligent health management in next-generation fuel cell systems.},
Type = {Article},
Affiliation = {Zhou, W (Corresponding Author), Xiamen Univ, Pen Tung Sah Inst Micronano Sci \& Technol, Xiamen 361005, Peoples R China.
