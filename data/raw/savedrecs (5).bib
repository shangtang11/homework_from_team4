@inproceedings{ WOS:001283833600010,
Author = {Vran, Jan and Shingarov, Boris},
Editor = {Soderberg, E and Church, L},
Title = {Tinyrossa: A Compiler Framework for Vertical, Verified Construction of
   Smalltalk VMs},
Booktitle = {PROCEEDINGS OF THE 8TH INTERNATIONAL CONFERENCE ON THE ART, SCIENCE, AND
   ENGINEERING OF PROGRAMMING, PROGRAMMING COMPANION 2024},
Year = {2024},
Pages = {43-46},
Note = {8th International Conference on the Art, Science, and Engineering of
   Programming (Programming), Lund, SWEDEN, MAR 11-15, 2024},
Abstract = {This talk presents Tinyrossa, an experimental JIT- and AoT-compilation
   framework which is part of our larger ``Smalltalk-25{''} program of
   research towards constructing dynamic-language VMs using formal methods.
   As far as compilation per se, Tinyrossa does not make novel
   contributions; it is a traditional compiler that performs IL-to-IL and
   IL-to-Native code transformations. The main point of our work is to
   treat existing compilation algorithms within a mathematically-rigorous
   framework of executable logical specifications.
   To that end, each code transformation is endowed with a
   ``Justification{''} (a certificate proving the transformation's
   soundness). Justifications are computed by MachineArithmetic, our
   SMT-based theorem prover written in Smalltalk.
   Tinyrossa is an ongoing research effort. In this workshop talk, we
   present our current status using an example walking through the
   compilation of a simple method down to optimized native RISC-V code.},
Type = {Proceedings Paper},
Affiliation = {Vran, J (Corresponding Author), LabWare, Dundee, Scotland.
