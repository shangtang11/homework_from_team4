@inproceedings{ WOS:000946536500021,
Author = {Scheipel, Tobias and Angermair, Florian and Baunach, Marcel},
Editor = {Fabelo, H and Ortega, S and Skavhaug, A},
Title = {moreMCU: A Runtime-reconfigurable RISC-V Platform for Sustainable
   Embedded Systems},
Booktitle = {2022 25TH EUROMICRO CONFERENCE ON DIGITAL SYSTEM DESIGN (DSD)},
Series = {EUROMICRO Conference Proceedings},
Year = {2022},
Pages = {24-31},
Note = {25th Euromicro Conference on Digital System Design (DSD), Maspalomas,
   SPAIN, AUG 31-SEP 02, 2022},
Abstract = {As the number of embedded systems continues to grow, so does the amount
   of disposed electronic devices. This is mainly due to partially or fully
   outdated hardware, caused by new legal regulations in jurisdiction or
   cutting-edge features within a new generation of devices or hardware
   components. As most devices are designed without having long-term
   maintainability in mind and can be easily replaced without much monetary
   effort, it is often easier to dispose of them. This throw-away
   mentality, however, increases the carbon footprint enormously.
   Within this work, we propose a platform that can be used to design
   future embedded systems in a more sustainable way by preparing them for
   long-term hardware adaptations. To do so, we aim to make logic updatable
   and re-usable while the device stays operational. This is achieved by
   carefully co-designing an operating system and a microcontroller
   platform with reconfigurable logic. In this paper, we use a RISC-V-based
   microcontroller running on a field-programmable gate array. The said
   microcontroller is designed to feature a modular pipeline and
   replaceable on-chip peripherals alongside a partial reconfiguration
   controller that can hot-swap parts of the microcontroller while it is
   running. It is supported by an operating system that handles the
   reconfiguration as well as functionality emulation, in case it is not
   (yet) available in hardware. Both the hardware and the software are
   aware of each other and can manipulate shared data structures for the
   management of the reconfiguration concept. The experimental evaluation
   that was carried out on a Artix-7 device shows the proper operation
   alongside performance measurements and resource utilization of the
   on-the-fly reconfiguration of a proof-of-concept system without
   affecting the execution of the remainder of the system.},
Type = {Proceedings Paper},
Affiliation = {Scheipel, T (Corresponding Author), Graz Univ Technol, Inst Tech Informat, Graz, Austria.
   Scheipel, Tobias; Angermair, Florian; Baunach, Marcel, Graz Univ Technol, Inst Tech Informat, Graz, Austria.},
