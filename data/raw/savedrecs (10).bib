@inproceedings{ WOS:000500998700203,
Author = {Fibich, Christian and Horauer, Martin and Obermaisser, Roman},
Book-Group-Author = {IEEE},
Title = {Reliability-Enhanced High-Level Synthesis using Memory Profiling and
   Fault Injection},
Booktitle = {2019 IEEE 28TH INTERNATIONAL SYMPOSIUM ON INDUSTRIAL ELECTRONICS (ISIE)},
Series = {Proceedings of the IEEE International Symposium on Industrial
   Electronics},
Year = {2019},
Pages = {1363-1370},
Note = {28th IEEE International Symposium on Industrial Electronics (IEEE-ISIE),
   Vancouver, CANADA, JUN 12-14, 2019},
Abstract = {The HLShield concept proposed in previous work aims at automating the
   augmentation of digital circuit designs with fault tolerance logic
   during the High-Level Synthesis (HLS) process. It proposes to use design
   analysis methods that identify parts of the design to protect against a
   certain fault hypothesis, a reliability-enhanced synthesis tool, and
   methods to validate the effectiveness of the added fault tolerance logic
   in order to automatically generate reliable digital designs using HLS.
   This work extends the HLShield framework by proposing a toolflow to
   estimate the influence of bit flips in user-defined sequential elements
   on the total failure rate a digital integrated circuit. It proposes a
   model that combines vendor-supplied reliability data with fault
   propagation probabilities for each class of sequential elements in the
   target device. Furthermore, this work presents an empirical method to
   determine these propagation probabilities using netlist-level fault
   injection techniques.
   We further apply these methods to analyze the failure rate improvement
   achievable using a method from previous work that aims at reducing a
   design's failure rate by selecting especially vulnerable sequential
   elements for protection. This is done according to register/memory
   access patterns in an intermediate representation of the high-level
   design. Results show choosing the correct metric has a noticeable
   influence on the achievable reduction in failure rate compared to the
   incurred overhead.},
Type = {Proceedings Paper},
Affiliation = {Fibich, C (Corresponding Author), Univ Appl Sci Technikum Wien, Vienna, Austria.
   Fibich, Christian; Horauer, Martin, Univ Appl Sci Technikum Wien, Vienna, Austria.
