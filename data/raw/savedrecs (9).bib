@article{ WOS:000721999200019,
Author = {Mazzoni, Benedetta and Benatti, Simone and Benini, Luca and Tagliavini,
   Giuseppe},
Title = {Efficient Transform Algorithms for Parallel Ultra-Low-Power IoT End
   Nodes},
Journal = {IEEE EMBEDDED SYSTEMS LETTERS},
Year = {2021},
Volume = {13},
Number = {4},
Pages = {210-213},
Month = {DEC},
Abstract = {Modern Internet of Things (IoT) end nodes must support computational
   intensive workloads at a limited power budget. Parallel ultra-low-power
   (PULP) architectures are a promising target for this scenario, and the
   availability of highly optimized software libraries is crucial to
   exploit parallelism and reduce software development costs. This letter
   proposes an efficient parallel design of the widely used short-time
   Fourier transform (STFT) and discrete wavelet transform (DWT) transforms
   targeting ultra-low-power IoT devices. We address key performance
   challenges related to fine-grained synchronization and banking conflicts
   in shared memory. We achieve high throughput (50.95 samples/mu s, on
   average), good parallel speedup (up to 6.79x), and high energy
   efficiency (up to 172.55 GOp/s/W) on a cluster of eight RISC-V cores
   optimized for PULP operation.},
