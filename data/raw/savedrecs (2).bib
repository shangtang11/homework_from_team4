@inproceedings{ WOS:001596652300045,
Author = {Ma, Yu and Sun, Yan and Zhang, Jianmin and Fu, Siqing},
Book-Group-Author = {ACM},
Title = {SFC-TRNG: A Stable Fast and Compact True Random Number Generator based
   on Magnetic Tunnel Junction},
Booktitle = {PROCEEDINGS OF THE GREAT LAKES SYMPOSIUM ON VLSI 2025, GLSVLSI 2025},
Year = {2025},
Pages = {306-311},
Note = {35th Great Lakes Symposium on VLSI-GLSVLSI, New Orleans, LA, JUN 30-JUL
   02, 2025},
Abstract = {Random numbers are fundamental to modern information technology, playing
   a crucial role in fields such as cryptography and machine learning.
   Conventional True Random Number Generators (TRNG), which rely on
   physical phenomena, often face limitations such as large size, high
   power consumption, and limited generation rates, hindering their
   adoption in high-performance applications. This paper presents a novel
   TRNG design based on Spin-Transfer Torque Magnetic Tunnel Junctions
   (STT-MTJ), which exploit thermally induced random magnetic switching
   characteristics to generate high-quality random number sequences. The
   proposed architecture is optimized for both high stability and
   throughput, effectively addressing the critical trade-off between
   performance and reliability. Our circuit-level simulations demonstrate
   the generator's functionality, and the output bitstream passes all 15
   NIST statistical tests, confirming its exceptional randomness. The
   design achieves a compact footprint of 11.17....2, a low energy
   consumption of 3.98 pJ per generated bit, and a generation rate of 303
   Mb/s, significantly surpassing existing STT-MTJ-based TRNG. These
   advancements render the proposed design highly suitable for applications
   requiring high-performance random number generation, such as secure
   cryptography, machine learning, and scientific computing.},
Type = {Proceedings Paper},
Affiliation = {Zhang, JM (Corresponding Author), Natl Univ Def Technol, Changsha, Peoples R China.
