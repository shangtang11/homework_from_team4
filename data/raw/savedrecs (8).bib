@inproceedings{ WOS:000943995800028,
Author = {Ly, Chau Bao and Norris, Cindy},
Book-Group-Author = {ACM},
Title = {LY86-64: AWeb-based Simulator for the Y86-64 PIPE Architecture},
Booktitle = {ACMSE 2022: PROCEEDINGS OF THE 2022 ACM SOUTHEAST CONFERENCE},
Year = {2022},
Pages = {31-37},
Note = {Annual ACM Southeast Conference ACMSE, ELECTR NETWORK, APR 18-20, 2022},
Abstract = {Computer architecture simulators play an important role in education and
   in advancing improved architecture designs. For Computer Science
   students, implementing an architecture simulator allows them to develop
   a better understanding of computer systems and to improve software
   engineering skills. At Appalachian State University (App State), our
   architecture simulator project is a seminal project for Computer Science
   majors. For many students, it is their first software product of a
   significant size. However, to implement the code, students need a
   sophisticated understanding of the machine being simulated. Of
   particular difficulty is the control logic and signals that determine
   the inputs to the stages of the Y86-64 PIPE machine which is the basis
   of their project. To enable students to better understand this aspect,
   we searched for a graphical Y86-64 simulator that provides a
   visualization of the control logic. A simulator such as that could
   engender a better understanding of the control logic and also be used to
   assist in the debugging of their own projects. Several Y86-64 simulators
   are available, but none that we found provided the desired
   functionality. For this reason, we undertook the development of the
   LY86-64 (pronounced ``lee 86-64{''}), a Y86-64 browser-based simulator.
   In a survey of 31 students who experimented with the LY86-64 simulator,
   96.8\% of the students agreed that the simulator provided them with a
   better understanding of the pipeline control logic.},
Type = {Proceedings Paper},
Affiliation = {Ly, CB (Corresponding Author), Appalachian State Univ, Boone, NC 28608 USA.
   Ly, Chau Bao; Norris, Cindy, Appalachian State Univ, Boone, NC 28608 USA.},
