@inproceedings{ WOS:001296009500002,
Author = {Surminski, Sebastian and Niesler, Christian and Davi, Lucas and Sadeghi,
   Ahmad-Reza},
Editor = {Tibouchi, M and Wang, X},
Title = {DMA'n'Play: Practical Remote Attestation Based on Direct Memory Access},
Booktitle = {APPLIED CRYPTOGRAPHY AND NETWORK SECURITY, PT II, ACNS 2023},
Series = {Lecture Notes in Computer Science},
Year = {2023},
Volume = {13906},
Pages = {32-61},
Note = {21st International Conference on Applied Cryptography and Network
   Security (ACNS), Kyoto, JAPAN, JUN 19-22, 2023},
Abstract = {Remote attestation allows validating the trustworthiness of a remote
   device. Existing attestation schemes either require hardware changes,
   trusted computing components, or rely on strict timing constraints. In
   this paper, we present a novel remote attestation approach, called
   DMA'n'Play, that tackles these practical limitations by leveraging DMA
   (direct memory access). Since DMA does not require CPU time, DMA'n'Play
   even allows attestation of devices with real-time constraints. To
   prevent the exploitation of side-channels which potentially could
   determine if the attestation is running, we developed DMA'n'Play To-Go,
   a small, mobile attestation device that can be plugged into the attested
   device. We evaluated DMA'n'Play on two real-world devices, namely a
   syringe pump and a drone. Our evaluation shows that DMA'n'Play adds
   negligible performance overhead and prevents data-only attacks, by
   validating critical data in memory.},
Type = {Proceedings Paper},
Affiliation = {Surminski, S (Corresponding Author), Univ Duisburg Essen, Essen, Germany.
