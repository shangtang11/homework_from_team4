@article{ WOS:001466357900001,
Author = {Liu, Zihan and Yan, Siyu and Wang, Zixuan and Zhao, Xinyi and Wei, Wei
   and Duan, Yuai and Xu, Zhenzhen and Han, Tianyu},
Title = {A fluorescent tactile-visual sensory organ for skin texture imaging and
   deep-learning recognition},
Journal = {CHEMICAL ENGINEERING JOURNAL},
Year = {2025},
Volume = {512},
Month = {MAY 15},
Abstract = {The integration of visual and tactile perceptions is an ideal strategy
   to build a sensory organ for intelligent devices. The challenge in this
   domain can be partly concluded as the difficulty in developing
   tactile-visual sensitive materials with high perceptual accuracy and
   intuitive signal output. Herein, we design a
   diethylamino-hydroxybenzylidene fluorescent material (C3) by combining
   aggregation-induced emission (AIE) and twisted intramolecular charge
   transfer (TICT) concepts. It was fabricated into a drop-casting film to
   serve as a tactile sensor, functioning under a low contact force down to
   kPa level. Upon tactile contact with human skin, C3 self-assembles into
   nanofibrils on the film, leading to 12-fold increase in fluorescence
   intensity, together with a large hypochromatic-shift. By virtue of the
   selectively localized self-assembly driven by contact degree, C3 film
   generates a morphology structure to reflect the surface condition of the
   skin in contact, further yielding a characteristic fluorescent pattern
   resembling the skin texture. The fluorescent textures from various
   locations of human skin were collected, and further analyzed by a
   deep-learning model namely EfficientNet. After multiple training cycles,
   the recognition accuracy reaches as high as 97.4 \%. In addition, we
   reveal the construction of an intelligent system using C3 film as the
   sensory organ, which integrates tactile perception and visual feedback.
   The system could image skin texture by tactile perception, and
   simultaneously transfer the resulting fluorescence images into computer
   for deep-learning-based recognition. The system achieves 100 \%
   recognition accuracy in various simulated human-machine interaction
   scenarios, including life-form recognition, dermal authenticity
   verification, spatial positioning and identity recognition.},
Type = {Article},
Affiliation = {Han, TY (Corresponding Author), Capital Normal Univ, Dept Chem, Beijing 100048, Peoples R China.
   Liu, Zihan; Yan, Siyu; Wang, Zixuan; Zhao, Xinyi; Wei, Wei; Duan, Yuai; Xu, Zhenzhen; Han, Tianyu, Capital Normal Univ, Dept Chem, Beijing 100048, Peoples R China.},
