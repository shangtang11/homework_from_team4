@inproceedings{ WOS:001537918202117,
Author = {Chen, Yinjie and Zhang, Di and Chen, Hua},
Book-Group-Author = {IEEE},
Title = {Learning More Comprehensive Representations of ICs for Enhanced Routing
   Congestion Prediction},
Booktitle = {2025 IEEE INTERNATIONAL SYMPOSIUM ON CIRCUITS AND SYSTEMS, ISCAS},
Series = {IEEE International Symposium on Circuits and Systems},
Year = {2025},
Note = {2025 International Symposium on Circuits and Systems-ISCAS-Annual,
   ENGLAND, MAY 25-28, 2025},
Abstract = {As Integrated Circuits (ICs) increase in complexity, there is a growing
   need for more comprehensive representations within deep learning
   approaches to support Electronic Design Automation (EDA) tasks in the
   backend stage, such as routing congestion prediction. However, current
   methods in congestion prediction often fail to fully combine both
   topological and geometrical information, limiting their ability to
   effectively represent and optimize circuits. Here we propose a novel
   architecture named TGFN that effectively merges topological information
   from the entire circuit and diverse geometrical information from layouts
   to enhance prediction accuracy. This model is specially designed to
   accommodate various data structures, integrating them into a cohesive
   latent representation that comprehensively models the circuit.
   Experimental results demonstrate that our method not only leverages both
   types of information effectively but also outperforms alternative
   baseline approaches. Notably, it achieves up to 6.87\%, 11.24\% and
   15.96\% improvements in Pearson, Spearman and Kendall correlation
   coefficients respectively.},
