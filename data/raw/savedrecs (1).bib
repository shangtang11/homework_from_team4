@article{ WOS:001608674200001,
Author = {Moench, Emanuel and Stein, Tobias},
Title = {Equity Premium Predictability over the Business Cycle},
Journal = {JOURNAL OF FINANCIAL AND QUANTITATIVE ANALYSIS},
Year = {2025},
Month = {2025 SEP 2},
Abstract = {Equity returns follow a pronounced V-shape pattern around the onset of
   recessions. They sharply drop into negative territory just before
   business cycle peaks and then strongly recover as the recession unfolds.
   Recessions are typically preceded by a flat yield curve. Probit models
   relying on the term spread as a predictor therefore time the beginning
   of recessions well. We show that model-implied recession probabilities
   based on the term spread strongly improve equity premium prediction in-
   and out-of-sample and outperform several benchmark predictors.
   Correcting for a structural break in the mean of the term spread in 1982
   further strengthens the forecast performance.},
Type = {Article; Early Access},
Affiliation = {Moench, E (Corresponding Author), Frankfurt Sch Finance \& Management, CEPR, Frankfurt, Germany.
