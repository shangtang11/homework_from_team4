@article{ WOS:001525891500001,
Author = {Feng, Tianliang and Xu, Ziwei},
Title = {Defect-dependent adsorption and electronic properties of single-walled
   carbon nanotubes in oxygen and palladium environments},
Journal = {DIAMOND AND RELATED MATERIALS},
Year = {2025},
Volume = {157},
Month = {AUG},
Abstract = {Single-walled carbon nanotubes (SWCNTs) are increasingly used in
   electronic devices. However, their performance is often hindered by
   intrinsic defects and environmental elements. Here, we systematically
   investigate the adsorption properties of oxygen and palladium atoms on
   prototypical (8,0) SWCNTs with three typical defects (single-vacancy
   defect, Stone-Wales defect, and double-vacancy defect), as well as the
   effect on their electronic properties by density functional theory
   calculations. It is revealed that the adsorption strength behavior
   exhibits a significant defect dependence. The adsorption of oxygen and
   palladium atoms can create different degree of local deformation of the
   SWCNTs. Except the SWCNT with Stone-Wales defect, the bandgaps of other
   SWCNTs are changed a lot after the oxygen and palladium adsorption. The
   Stone-Wales defect, however, can not only reduce the local deformation
   created by the adsorption but also protect the bandgap. In addition,
   structural defects are limited in their ability to thermally stabilize
   palladium atoms. This theoretical study will provide a theoretical
   guidance for the design and optimization of SWCNT-based electronic
   devices in the practical application environments containing intrinsic
   defects and environmental elements.},
Type = {Article},
Affiliation = {Xu, ZW (Corresponding Author), Jiangsu Univ, Sch Mat Sci \& Engn, Zhenjiang 212013, Peoples R China.
