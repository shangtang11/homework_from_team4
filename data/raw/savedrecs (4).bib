   Fern, Nicole; Breunesse, Cees-Bart; Van Woudenberg, Jasper, Riscure North Amer, San Francisco, CA 94108 USA.
   Gillis, Kate; Dich, Alex, Intrinsix Corp, Marlborough, MA 01752 USA.
   Grossmann, Peter, Zero AS Corp, Lexington, MA 02421 USA.},
DOI = {10.1109/TETC.2023.3268303},
Keywords = {Logic gates; Computer architecture; Integrated circuit modeling;
   Testing; Power demand; Correlation; Side-channel attacks; Pre-silicon;
