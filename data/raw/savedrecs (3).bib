@inproceedings{ WOS:001540569200010,
Author = {Pejasinovic, Risto and Caratelli, Alessandro and Nookala, Anvesh and
   Denkinger, Benoit Walter and Andorno, Marco},
Book-Group-Author = {ACM},
Title = {Hardware and software build flow with SoCMake},
Booktitle = {COMPANION PROCEEDINGS OF THE 22ND ACM INTERNATIONAL CONFERENCE ON
   COMPUTING FRONTIERS 2025 WORKSHOPS AND SPECIAL SESSIONS, CF2025},
Year = {2025},
Pages = {42-45},
Note = {22nd International Conference on Computing Frontiers-CF, Cagliari,
   ITALY, MAY 28-30, 2025},
Abstract = {System-on-chip (SoC) development requires a unified build system capable
   of managing both hardware and software components. Existing hardware
   build systems often lack support for software compilation, necessitating
   separate build systems for hardware and software tasks. To address this
   gap, SoCMake, a CMake-based build system, was developed to unify
   hardware and software workflows.
   SoCMake introduces an IP block abstraction, support for electronic
   design automation (EDA) tools, supports software cross-compilation, and
   efficiently manages dependencies between hardware and software
   components. Additionally, it enhances hardware verification by
   supporting RTL simulators and verification methodologies while enabling
   C++ usage for improved productivity.},
Type = {Proceedings Paper},
Affiliation = {Pejasinovic, R (Corresponding Author), Neuveville, Bern, Switzerland.
   Pejasinovic, Risto, Neuveville, Bern, Switzerland.
