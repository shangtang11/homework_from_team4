Title = {Bridging the Gap in ECG Classification: Integrating Self-supervised
   Learning with Human-in-the-Loop Amid Medical Equipment Hardware
   Constraints},
Booktitle = {APPLIED RECONFIGURABLE COMPUTING. ARCHITECTURES, TOOLS, AND
   APPLICATIONS, ARC 2024},
