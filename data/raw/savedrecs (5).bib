@inproceedings{ WOS:001350073900010,
Author = {Usman, Ahmad B. and Asplund, Mikael},
Book-Group-Author = {IEEE},
Title = {Remote Attestation with Software Updates in Embedded Systems},
Booktitle = {2024 IEEE CONFERENCE ON COMMUNICATIONS AND NETWORK SECURITY, CNS 2024},
Series = {IEEE Conference on Communications and Network Security},
Year = {2024},
Note = {IEEE Conference on Communications and Network Security (CNS), Taipei,
   TAIWAN, SEP 30-OCT 03, 2024},
Abstract = {This paper presents RASUES, a remote -attestation based scheme designed
   to incorporate software updates in embedded systems. Our approach has
   two primary aims: to extend remote attestation specifications to account
   for software updates, and to leverage Remote Attestation (RA) to
   validate the integrity of the update process itself. We extend the RATS
   RFC 9334 specification with an update procedure that accounts for the
   expected state before and after the update. We demonstrate the
   feasibility of our design by implementing the main functionality of
   RASUES on a TPM-based hardware platform. We evaluate the latency of our
   prototype and analyze its security properties, showing that the approach
   has acceptable overhead and can provide added security under the stated
   assumptions.},
Type = {Proceedings Paper},
Affiliation = {Usman, AB (Corresponding Author), Linkoping Univ, Dept Comp \& Informat Sci, Linkoping, Sweden.
