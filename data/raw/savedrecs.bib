@article{ WOS:001719133300001,
Author = {Liao, Zenghua and Liao, Jinzhi and Hu, Shengze and Huang, Peixin and
   Zhao, Xiang},
Title = {LeHSE: Large language model enhanced hierarchical script extraction from
   multiple documents},
Journal = {KNOWLEDGE-BASED SYSTEMS},
Year = {2026},
Volume = {340},
Month = {MAY 12},
Abstract = {The extraction and structured presentation of scripts are essential for
   clear instructions and effective learning. While previous studies
   focused on extracting linear scripts from single documents, they
   overlooked the potential of aggregating hierarchical scripts from
   multiple sources. In this paper, we draw on the cognitive load theory
   from psychology and introduce a novel task of multi-document script
   extraction to address this gap. To tackle this challenge, we propose
   LeHSE, a Large Language Model (LLM) framework for hierarchical script
   extraction from multiple documents. LeHSE operates through a three-stage
   process. First, it employs an iterative extraction module to derive
   linear scripts from single documents. Next, a hierarchy recognition
   module identifies relationships between these linear scripts and
   aggregates them into hierarchical scripts. Finally, a script enhancement
   module enriches the extracted scripts with commonsense knowledge and
   cross-script insights. To accommodate scenarios with limited
   computational resources, we also introduce LeHSE-FT, a lightweight
   alternative that leverages smaller, specialized models fine-tuned on our
   newly constructed MDScript dataset, which includes 2000 goals and 15,493
   documents and serves as a robust benchmark for multi-document script
   extraction research. Extensive experiments, including both automatic and
   human evaluations, demonstrate the superiority of LeHSE. Additionally,
   LeHSE-FT achieves performance comparable to LLMs, demonstrating the
   value of fine-tuned, smaller specialized models for efficient
   multi-document script extraction.},
Type = {Article},
Affiliation = {Liao, JZ (Corresponding Author), Natl Univ Def Technol, Natl Key Lab Big Data \& Decis, Changsha, Peoples R China.
