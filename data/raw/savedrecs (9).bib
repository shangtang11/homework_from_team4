   Oberhauser, Jonas; Oberhauser, Lilith; Paolillo, Antonio; Behrens, Diogo; Fu, Ming, Huawei OS Kernel Lab, Shenzhen, Peoples R China.
   Vafeiadis, Viktor, Max Planck Inst Software Syst, D-67663 Kaiserslautern, Germany.},
DOI = {10.1007/978-3-030-91014-3\_17},
Keywords = {Consistency models; Verification; Optimization; NUMA-aware locks},
