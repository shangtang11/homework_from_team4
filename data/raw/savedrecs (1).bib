@article{ WOS:001555371100002,
Author = {Garofalo, Angelo and Benini, Luca},
Title = {Leveraging RISC-V for HW/SW Codesign of Flexible and Efficient TinyML
   SoCs},
Journal = {IEEE DESIGN \& TEST},
Year = {2025},
Volume = {42},
Number = {5},
Pages = {8-26},
Month = {OCT},
Abstract = {Editor's notes: This keynote article presents a comprehensive and
   impactful contribution to energy-efficient TinyML through the design of
   domain-specific RISC-V instruction set architecture (ISA) extensions for
   Edge AI workloads. The authors provide detailed hardware-software
   codesign contributions, including sub-byte SIMD arithmetic, fused
   mac-load operations, and vector lockstep execution within tightly
   coupled compute clusters. This keynote exemplifies the potential of open
