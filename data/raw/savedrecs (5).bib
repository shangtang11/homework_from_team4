@inproceedings{ WOS:001414843700013,
Author = {Zhang, Ruisi and Rajarathnam, Rachel Selina and Pan, David Z. and
   Koushanfar, Farinaz},
Book-Group-Author = {ASSOC COMPUTING MACHINERY},
Title = {Automated Physical Design Watermarking Leveraging Graph Neural Networks},
Booktitle = {2024 ACM/IEEE 6TH SYMPOSIUM ON MACHINE LEARNING FOR CAD, MLCAD 2024},
Year = {2024},
Note = {6th Symposium on Machine Learning for CAD, Snowbird, UT, SEP 09-11, 2024},
Abstract = {This paper presents AutoMARKs, an automated and transferable
   watermarking framework that leverages graph neural networks to reduce
   the watermark search overheads during the placement stage. AutoMARKs's
   novel automated watermark search is accomplished by (i) constructing
   novel graph and node features with physical, semantic, and design
   constraint-aware representation; (ii) designing a data -efficient
   sampling strategy for watermarking fidelity label collection; and (iii)
   leveraging a graph neural network to learn the connectivity between
   cells and predict the watermarking fidelity on unseen layouts. Extensive
   evaluations on ISPD'15 and ISPD'19 benchmarks demonstrate that our
   proposed automated methodology: (i) is capable of finding quality
   -preserving watermarks in a short time; arid (ii) is transferable across
   various designs, i.e., AutoMARKs trained on one layout is generalizable
   to other benchmark circuits. AuToMARKs is also resilient against
   potential watermark removal and forging attacks.},
