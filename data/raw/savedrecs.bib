@article{ WOS:001728215800001,
Author = {Mauser, Lucas and Zhang, Xinyu and Kruger, Daniel and Waschle, Moritz
   and Wagner, Stefan},
Title = {RunSoC: A design-space exploration framework for scheduling and
   allocation of automotive software tasks to semiconductor design
   partitions in system-on-chips},
Journal = {JOURNAL OF SYSTEMS AND SOFTWARE},
Year = {2026},
Volume = {237},
Month = {JUL},
Abstract = {Background: Automotive systems are transitioning from
   microcontroller-based architectures to high-performance multi-core
   System-on-Chip (SoC) platforms to meet the demands of software-defined
   vehicles. This shift complicates the scheduling and allocation of
   software tasks, making it challenging to balance performance, timing
   demands, determinism, adaptability, and efficiency using current static
   or dynamic allocation methods. Aim: This paper presents RunSoC, a
   design-space exploration framework for scheduling and allocation
   strategies of automotive software tasks on multi-core SoCs. Rather than
   targeting deployable production schedules, the framework enables system
   architects to explore the impact of architectural choices under
   constrained computational resources. Method: We conduct a rapid
   literature review and expert interviews to identify research gaps and
   industrial needs. Based on these insights, we design and validate a
   hybrid framework that integrates static and dynamic core allocation with
   two scheduling policies: first-come first-serve and priority-aware.
   Results: We validate the framework on directed acyclic graph models of
   Advanced-Driver Assistance Systems (ADAS) workloads. The results
   highlight the high per-core efficiency and comparable average latency of
   static allocation, though it carries the risk of incomplete execution of
   event-driven task chains. Here, incorporating additional cores or
   dynamic allocation can enhance the overall utilization and throughput.
   Conclusion: RunSoC provides a flexible, metrics-driven framework that
   integrates task dependencies and priorities, offering reproducible,
   performance-oriented scheduling and allocation analysis for early
   architectural decision-making in software-defined vehicle platforms.},
Type = {Article},
Affiliation = {Mauser, L (Corresponding Author), Daimler Truck AG, Stuttgart, Germany.
   Mauser, L (Corresponding Author), Tech Univ Munich, Heilbronn, Germany.
   Mauser, Lucas; Waschle, Moritz, Daimler Truck AG, Stuttgart, Germany.
   Mauser, Lucas; Zhang, Xinyu; Kruger, Daniel; Wagner, Stefan, Tech Univ Munich, Heilbronn, Germany.},
