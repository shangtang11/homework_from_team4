@inproceedings{ WOS:001446544900015,
Author = {Wilson, Johannes and Asplund, Mikael},
Editor = {Iwaya, LH and Kamm, L and Martucci, L and Pulls, T},
Title = {Analysing TLS Implementations Using Full-Message Symbolic Execution},
Booktitle = {SECURE IT SYSTEMS, NORDSEC 2024},
Series = {Lecture Notes in Computer Science},
Year = {2025},
Volume = {15396},
Pages = {283-302},
Note = {29th Nordic Conference on Secure IT Systems, Karlstad, SWEDEN, NOV
   06-07, 2024},
Abstract = {In this paper, we present a methodology for performing thorough analysis
   of TLS protocol implementations using dynamic symbolic execution. This
   method explores all possible inputs by treating entire messages as
   symbolic using KLEE. We are able to analyse the message parsing logic in
   detail, showing fulfilment of requirements from the protocol
   specification. This has previously not been performed for whole messages
   in complex protocols such as TLS. We tackle several problems that cause
   state space explosion by providing appropriate abstractions of
   implementation primitives. Additionally, we explore how protocol design
   choices impact the feasibility of analysis and argue for a strict TLS
   specification. We have applied our method to the ServerHello message
   parsing in several versions of the WolfSSL TLS 1.3 implementation. Our
   analysis revealed two vulnerabilities in the client implementation which
   were both assigned CVEs, one of them marked as high severity.},
Type = {Proceedings Paper},
Affiliation = {Wilson, J (Corresponding Author), Linkoping Univ, Linkoping, Sweden.
   Wilson, J (Corresponding Author), Sectra Commun, Linkoping, Sweden.
   Wilson, Johannes; Asplund, Mikael, Linkoping Univ, Linkoping, Sweden.
   Wilson, Johannes, Sectra Commun, Linkoping, Sweden.},
