DOI = {10.1109/DSD60849.2023.00066},
Keywords = {RISC-V; Application Class CPU; CPU Architecture; CVA6},
Keywords-Plus = {ENERGY; COST},
Author-Email = {gianmarco.ottavi2@unibo.it
   florian@openhwgroup.org
   lbenini@iis.ee.ethz.ch
   davide.rossi@unibo.it},
Affiliations = {University of Bologna; Swiss Federal Institutes of Technology Domain;
   ETH Zurich},
Cited-References = {Asanovic Krste, 2016, Tech. Rep. UCB/EECS- 2016-17, V4.
