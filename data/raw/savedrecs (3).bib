@article{ WOS:001356192600001,
Author = {Yin, Qianxi and Li, Dejian and Wu, Zhipeng and Pun, Sio Hang and Liu, Yu},
Title = {Design and Implementation of RISC-V System-on-Chip for SPWM Generation
   Based on FPGA},
Journal = {IEICE ELECTRONICS EXPRESS},
Year = {2024},
Volume = {21},
Number = {24},
Month = {DEC 25},
Abstract = {Alternating Current (AC) motors play important roles across various
   fields. Traditional processors utilizing Sine Pulse Width Modulation
   (SPWM) to control the speed of AC motors face challenges such as high
   computational complexity and limited flexibility. To address these
   problems in the variable frequency speed control process of AC motors,
   this paper proposes the design of a System-on-Chip (SoC) capable of
   generating SPWM waves. Our proposal is based on an open-source Reduced
   Instruction Set Computer fifth-generation (RISC-V) processor. The
   proposal is verified on the Field Programmable Gate Array (FPGA)
   platform. The results demonstrate that, with the sine wave frequency set
   to 3200 Hz and the triangular wave frequency set to 15 KHz, our proposal
   achieves a 413 x acceleration compared to the traditional software
   method. Compared to the previous accelerator, our design reduces
   (Look-Up-Table) LUT consumption by 41.10\% and (Total Harmonic
   Distortion) THD by 17.79\%.},
Type = {Article},
Affiliation = {Liu, Y (Corresponding Author), Tianjin Univ, Sch Microelect, Tianjin 300072, Peoples R China.
   Yin, Qianxi; Wu, Zhipeng; Liu, Yu, Tianjin Univ, Sch Microelect, Tianjin 300072, Peoples R China.
   Li, Dejian, Beijing Smartchip Microelect Technol Co Ltd, Beijing, Peoples R China.
   Pun, Sio Hang, Univ Macau, Inst Microelect, Macau 999078, Peoples R China.},
DOI = {10.1587/elex.21.20240603},
EarlyAccessDate = {NOV 2024},
Keywords = {RISC-V; SPWM; FPGA},
Keywords-Plus = {VOLTAGE; SIMULATION; CONVERTER},
