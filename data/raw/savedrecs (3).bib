@inproceedings{ WOS:001559160300044,
Author = {Pi, Yan and Li, Tun and Zou, Hongji and Qu, Wanxia and He, Xu and Liu,
   Wanwei},
Book-Group-Author = {IEEE},
Title = {PipelineGen: Towards Automated Generation of Pipeline from ISA Formal
   Semantic Specification},
