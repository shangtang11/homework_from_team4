   Yoo, Jerald, N1 Inst Hlth, Singapore 117456, Singapore.},
DOI = {10.1109/JSSC.2022.3144460},
EarlyAccessDate = {FEB 2022},
Keywords = {Electroencephalography; Epilepsy; Switches; Voltage; Tuning;
   Sensitivity; Surface treatment; Area-energy efficiency; analog front end
