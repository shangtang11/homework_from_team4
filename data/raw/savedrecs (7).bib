Volume = {18},
Number = {4},
Month = {OCT},
Abstract = {Convolutional neural networks (CNNs) have gained a massive impression in
   the fields of computer vision and especially in the embedded
   applications because of their high accuracy and performance. However,
   high computational complexity and power consumption due to convolution
   operations causes a high demand for low-power accelerators. A 3D
   geometric optimization strategy is proposed to alleviate the area and
   power requirements of Multiply Accumulate operations prevalent in all
   spatial CNNs. The proposed technique is generic and may be easily scaled
   for accelerators performing spatial 2D convolution.},
