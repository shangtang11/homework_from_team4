@article{ WOS:001674359000002,
Author = {Heo, Hyojoo and Shin, Yunwoo and Jeon, Juhee and Park, Taeho and Ryu,
   Seungho and Cho, Kyoungah and Kim, Sangsig},
Title = {Quaternary true random number generator comprising gated
   p+-i-n+ diodes},
Journal = {SCIENCE CHINA-INFORMATION SCIENCES},
Year = {2026},
Volume = {69},
Number = {3},
Month = {JAN 20},
Abstract = {Hardware-based true random number generators (TRNGs) have emerged as the
   basic unit of multivalued cryptographic systems that can significantly
   contribute to security technologies by lowering the risk of hacking. In
   this study, we propose a quaternary true random number generator
   (Q-TRNG) by connecting three binary true random number generators
   (B-TRNGs) without auxiliary circuits. The B-TRNGs are constructed using
   gated p+-i-n+ diodes with latch-up voltage variations owing to the
   inherent stochasticity of the band modulation mechanism. Owing to the
   inherent stochasticity of the gated p+-i-n+ diode, the Q-TRNG generates
   quaternary random numbers with four distinct current levels,
   corresponding to digit `0', `1', `2', and `3'. We demonstrate image
   encryption and decryption using the quaternary sequences. This study
   paves the way for multinary TRNGs contributing to the development of
   high-level hardware security technologies for edge devices.},
