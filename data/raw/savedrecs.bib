   Xiang, Wei, James Cook Univ, Coll Sci \& Engn, Cairns, Qld 4870, Australia.},
DOI = {10.1109/JIOT.2025.3618657},
Keywords = {Protocols; Vehicle dynamics; Epidemics; Heuristic algorithms;
   Convergence; Trajectory; Optimal control; Optimization; Lyapunov
   methods; Stability criteria; High-order adjoint-based optimal control;
   Lyapunov functions; recursive stability analysis;
   susceptible-infected-recovered (SIR) epidemic gossip protocols; urban
   intersection traffic alert dissemination},
