@inproceedings{ WOS:000584334300019,
Author = {Xu Bo and Yang Yunpeng and Chen Kai and Yan Yanjun and Zhang Shuo and
   Wang Yifan},
Book-Group-Author = {IEEE},
Title = {An efficient waveform averaging method based on FPGA in oscilloscope},
Booktitle = {PROCEEDINGS OF 2019 14TH IEEE INTERNATIONAL CONFERENCE ON ELECTRONIC
   MEASUREMENT \& INSTRUMENTS (ICEMI)},
Year = {2019},
Pages = {124-131},
Note = {14th IEEE International Conference on Electronic Measurement and
   Instruments (ICEMI), Changsha, PEOPLES R CHINA, NOV 01-03, 2019},
Abstract = {In recent years, with the rapid development of the electronic
   information industry, the capture of high-speed signals has become a hot
   issue in the field of time domain testing. As a universal test
   instrument, oscilloscopes are widely used in various industries. In
   order to eliminate the noise superimposed on the input signal, the
   average capture mode is added to the digital oscilloscope. This mode
   averages the acquired multiple waveforms to make the waveform smoother.
   At present, the common practice needs to transmit the acquired waveform
   to the host computer, and the host computer performs the shift operation
   after the accumulation, so the average times can only be 2(n) . This
   method requires more storage resources and the waveform refresh rate is
   low. For this reason, this paper proposes an efficient waveform
   averaging method based on FPGA. The method performs the arithmetic
   operation in the FPGA, so the average times is any integer from 2 to
   65536, which improves the overall performance of the oscilloscope.},
Type = {Proceedings Paper},
Affiliation = {Yang, YP (Corresponding Author), Univ Elect Sci \& Technol China, Sch Automat Engn, Chengdu 611731, Peoples R China.
   Xu Bo; Yang Yunpeng; Chen Kai; Yan Yanjun; Zhang Shuo; Wang Yifan, Univ Elect Sci \& Technol China, Sch Automat Engn, Chengdu 611731, Peoples R China.},
DOI = {10.1109/icemi46757.2019.9101595},
