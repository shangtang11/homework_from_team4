@inproceedings{ WOS:000588563400015,
Author = {Santos, Douglas Almeida and Luza, Lucas Matana and Zeferino, Cesar
   Albenes and Dilillo, Luigi and Melo, Douglas Rossi},
Book-Group-Author = {IEEE},
Title = {A Low-Cost Fault-Tolerant RISC-V Processor for Space Systems},
Booktitle = {2020 15TH IEEE INTERNATIONAL CONFERENCE ON DESIGN \& TECHNOLOGY OF
   INTEGRATED SYSTEMS IN NANOSCALE ERA (DTIS 2020)},
Year = {2020},
Note = {15th IEEE International Conference on Design and Technology of
   Integrated Systems in Nanoscale Era (DTIS), ELECTR NETWORK, APR 01-03,
   2020},
Abstract = {Embedded processors have been used in a diversity of applications, such
   as consumer electronics, home appliances, and automation systems.
   Another area that embedded processors can be adopted is space systems,
   which demand fault-tolerant components to deal with the environmental
   hostility. This work presents a low-cost fault-tolerant implementation
   of the RISC-V architecture, an emerging open industry standard for the
   building of embedded processors. The proposed implementation employs
   physical and information redundancy to reduce error propagation, with
   competitive silicon and power overheads when comparing with other RISC-V
   implementations.},
Type = {Proceedings Paper},
Affiliation = {Santos, DA (Corresponding Author), Univ Vale Itajai, Lab Embedded \& Distributed Syst LEDS, Itajai, SC, Brazil.
