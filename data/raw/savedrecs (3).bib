Title = {DuRTL - Information Flow Analysis Tool for Register Transfer Level
   Hardware Designs},
Booktitle = {2025 38TH INTERNATIONAL CONFERENCE ON VLSI DESIGN AND 2024 23RD
   INTERNATIONAL CONFERENCE ON EMBEDDED SYSTEMS, VLSID},
Series = {International Conference on VLSI Design},
Year = {2025},
Pages = {197-202},
Note = {38th International Conference on VLSI Design and International
   Conference on Embedded Systems, Bengaluru, INDIA, JAN 04-08, 2025},
Abstract = {In this tool paper, we present a design information flow analysis tool
   called DuRTL. DuRTL is an open-source hardware information flow analysis
   tool implemented in C++ that helps designers understand and comprehend
   unknown hardware designs written in Verilog and VHDL. DuRTL implements
   an approach for Hardware Information Flow Tracking based on a tagging
   mechanism where unique tags are injected into a hardware design. Each
   tag is associated with a signal at a specific time and identifies a flow
   of information during the traversal of the circuit. We explain the
   methodology and IFT implementation of DuRTL and some of the design
   choices made during the development. We also present some experiments
   that show the capabilities of DuRTL.},
