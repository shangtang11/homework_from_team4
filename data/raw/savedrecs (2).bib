@inproceedings{ WOS:001575967100060,
Author = {Budak, Utku and De Santis, Fabrizio and Yasar, Osman and Safieh, Malek
   and Sigl, Georg},
Book-Group-Author = {IEEE},
Title = {A Lightweight Firmware Resilience Engine for Real-Time Operating Systems},
