@article{ WOS:000858203700001,
Author = {Lee, Kyu-Bae and Park, Jina and Choi, Eunjin and Jeon, Mingi and Lee,
   Woojoo},
Title = {Developing a TEI-Aware PMIC for Ultra-Low-Power System-on-Chips},
Journal = {ENERGIES},
Year = {2022},
Volume = {15},
Number = {18},
Month = {SEP},
Abstract = {As the demand for ultra-low-power (ULP) devices has increased
   tremendously, system-on-chip (SoC) designs based on ultra-low-voltage
   (ULV) operation have been receiving great attention. Moreover, research
   has shown the remarkable potential that even more power savings can be
   achieved in ULV SoCs by exploiting the temperature effect inversion
   (TEI) phenomenon, i.e., the delay of the ULV SoCs decreases with
   increasing temperature. However, TEI-aware low-power (TEI-LP) techniques
   have a critical limitation in practical terms, in that dedicated power
   management-integrated circuits (PMICs) have not yet been developed. In
   other words, it is essential to develop PMICs that automatically bring
   out the full potential of the TEI-LP techniques as the chip temperature
   changes. With the aim of designing such PMICs, this paper first
   conducted a study to find the most suitable DC-DC converter for PMICs
   and then developed a control algorithm to maximize the effectiveness of
   the TEI-LP techniques. Furthermore, we have developed a compact hardware
   controller for the algorithm to operate most energy efficiently on
   ULP-SoCs.},
Type = {Article},
Affiliation = {Lee, W (Corresponding Author), Chung Ang Univ, Sch Elect \& Elect Engn, Seoul 06974, South Korea.
