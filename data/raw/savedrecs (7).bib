@inproceedings{ WOS:001035580700032,
Author = {Kostadinov, Nikolay and Bencheva, Nina},
Editor = {VanDerAa, N},
Title = {Educational Tools for Processor Design Classes: A Case Study},
Booktitle = {2023 32ND ANNUAL CONFERENCE OF THE EUROPEAN ASSOCIATION FOR EDUCATION IN
