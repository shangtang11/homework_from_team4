@inproceedings{ WOS:000805289900026,
Author = {Perez, Borja and Fell, Alexander and Davis, John D.},
Book-Group-Author = {IEEE},
Title = {Coyote: An Open Source Simulation Tool to Enable RISC-V in HPC},
Booktitle = {PROCEEDINGS OF THE 2021 DESIGN, AUTOMATION \& TEST IN EUROPE CONFERENCE
   \& EXHIBITION (DATE 2021)},
Year = {2021},
Pages = {130-135},
Note = {Design, Automation and Test in Europe Conference and Exhibition (DATE),
   ELECTR NETWORK, FEB 01-05, 2021},
Abstract = {The confluence of technology trends and economics has reincarnated
   computer architecture and specifically, software-hardware co-design. We
   are entering a new era of a completely open ecosystem, from applications
   to chips and everything in between. The software-hardware co-design of
   supercomputers for tomorrow requires flexible tools today that will take
   us to the Exascale and beyond. The MareNostrum Experimental Exascale
   Platform (MEEP) addresses this by proposing a flexible FPGA-based
   emulation platform, designed to explore hardware-software co-designs for
   future RISC-V supercomputers. This platform is part of an open
   ecosystem, allowing its infrastructure to be reused in other projects.
   MEEP's inaugural emulated system will be a RISC-V based self-hosted HPC
   vector and systolic array accelerator, with a special aim at efficient
   data movement. Early development stages for such an architecture require
   fast, scalable and easy to modify simulation tools, with the right
   granularity and fidelity, enabling rapid design space exploration. Being
   a part of MEEP, this paper introduces Coyote, a new open source,
   execution-driven simulator based on the open source RISC-V ISA and which
   can provide detailed insights at various levels and granularities.
   Coyote focuses on data movement and the modelling of the memory
   hierarchy of the system, which is one of the main hurdles for high
   performance sparse workloads, while omitting lower level details. As a
   result, performance evaluation shows that Coyote achieves an aggregate
   simulation of up to 6 MIPS when modelling up to 128 cores. This enables
   the fast comparison of different designs for future RISC-V based HPC
   architectures.},
Type = {Proceedings Paper},
Affiliation = {Perez, B (Corresponding Author), Barcelona Supercomp Ctr, Barcelona, Spain.
   Perez, Borja; Fell, Alexander; Davis, John D., Barcelona Supercomp Ctr, Barcelona, Spain.},
