@inproceedings{ WOS:001349548800120,
Author = {Sreedhar, Kavya and Nyengele, Gedeon and Horowitz, Mark and Torng,
   Christopher},
Book-Group-Author = {IEEE},
Title = {A 3.25 GHz Large-Integer Extended GCD Accelerator in 12 nm},
Booktitle = {2024 50TH IEEE EUROPEAN SOLID-STATE ELECTRONICS RESEARCH CONFERENCE,
   ESSERC 2024},
Series = {Proceedings of the European Solid-State Circuits Conference},
Year = {2024},
Pages = {476-479},
Note = {50th IEEE European Solid-State Electronics Research Conference (ESSERC),
   Bruges, BELGIUM, SEP 09-12, 2024},
Abstract = {Large-integer extended GCD (XGCD) is a critical operation in
   cryptography applications such as new blockchains and modular inversion.
   We present the first ASIC for XGCD, which is 23x faster than
   state-of-the-art software, 18x faster than prior hardware simulations,
   and up to 303x faster than prior chips for modular inversion. These
   performance gains come from careful circuit and logic optimizations to
   avoid long carry propagation and to hide control signal delays. Our chip
   computes XGCD with 255-bit integer inputs in 87 ns and XGCD with 512-bit
   integer inputs in 176 ns on average. Our chip can be configured for
   constant-time execution and computes constanttime 255-bit XGCD in 119 ns
   and constant-time 512-bit XGCD in 239 ns.},
Type = {Proceedings Paper},
Affiliation = {Sreedhar, K (Corresponding Author), Stanford Univ, Stanford, CA 94305 USA.
