@article{ WOS:001611942100001,
Author = {Gudisa, Gowthami and Japa, Aditya and Kumbhare, Vijay Rao},
Title = {Secure and energy-efficient TRNG and NV-SRAM design using
   VGSOT-MTJ/CNTFET hybrid integration},
Journal = {JOURNAL OF MAGNETISM AND MAGNETIC MATERIALS},
Year = {2025},
Volume = {635},
Month = {DEC 1},
Abstract = {The scaling of complementary metal oxide semiconductor (CMOS) technology
   limits static random-access memory (SRAM) performance in system-on-chip
   (SoC) architectures, particularly regarding cell stability and
   high-speed operation. Spintronic devices and carbon nanotube
   field-effect transistors (CNTFETs) are explored as alternatives. This
   paper proposes a hybrid non-volatile SRAM (NV-SRAM) design using
   voltage-gated spin orbit torque magnetic tunnel junctions (VGSOT-MTJ),
   which offers advantages like voltage-controlled magnetic anisotropy
   (VCMA), in-plane exchange bias (HEX), and CMOS compatibility. The VCMA
   effect reduces critical current (ISOT), minimizing power consumption and
   enabling faster switching. The HEX stabilizes magnetic states,
   eliminating the need for external fields. CNTFETs enhance speed and
   reduce power dissipation due to their superior carrier mobility. The
   conventional 6T-SRAM, VGSOT-MTJ/CMOS based NV-SRAM, and VGSOT-MTJ/
   CNTFET based NV-SRAM were designed and verified using industry standard
   cadence virtuoso by incorporating electrical model of VGSOT-MTJ and
   Stanford CNTFET Verilog-A model. The proposed VGSOT-MTJ/CMOS based
   NV-SRAM reported 42.66 \% and 77.12 \% reduction in power consumption
   compared to spin-transfer torque MTJ (STT-MTJ) SRAM and STT-SOT-MTJ
   SRAM, respectively. Moreover, a 56.77 \% and 82.75 \% reduction in power
   consumption is observed compared to existing designs in case of
   VGSOT-MTJ/CNTFET based NV-SRAM. Additionally, both the cells were
   analyzed for stability using the butterfly curve method, that
   demonstrated an improvement in static noise margin (SNM) at lower supply
   voltages. Furthermore, VGSOT-MTJ/CNTFET based NV-SRAM true random number
   generator (TRNG) is designed and evaluated its randomness by calculating
   the Shannon and minimum entropy. The proposed TRNG achieved Shannon and
   minimum entropy of 0.99999 and 0.99001 respectively. Additionally, the
   proposed TRNG passed all NIST statistical tests, demonstrating the
   randomness of the generated bits. Therefore, the CNTFET and VGSOT-MTJ
   are suitable for low-power, high-speed, hardware secure designs that are
   integrated within SoC architectures.},
Type = {Article},
Affiliation = {Kumbhare, VR (Corresponding Author), Koneru Lakshmaiah Educ Fdn, Dept Elect \& Commun Engn, Hyderabad 500075, Telangana, India.
   Gudisa, Gowthami; Kumbhare, Vijay Rao, Koneru Lakshmaiah Educ Fdn, Dept Elect \& Commun Engn, Hyderabad 500075, Telangana, India.
