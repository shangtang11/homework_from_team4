@inproceedings{ WOS:000540724500036,
Author = {Ibrahim, Ahmad and Sadeghi, Ahmad-Reza and Tsudik, Gene},
Editor = {Goldberg, I and Moore, T},
Title = {HEALED: HEaling \& Attestation for Low-End Embedded Devices},
Booktitle = {FINANCIAL CRYPTOGRAPHY AND DATA SECURITY, FC 2019},
Series = {Lecture Notes in Computer Science},
