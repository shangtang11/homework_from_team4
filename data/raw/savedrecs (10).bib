@inproceedings{ WOS:000546169600010,
Author = {Chen, Kejun and Deng, Qingxu and Hou, Yumin and Jin, Yier and Guo,
   Xiaolong},
Book-Group-Author = {IEEE},
Title = {Hardware and Software Co-Verification from Security Perspective},
Booktitle = {2019 20TH INTERNATIONAL WORKSHOP ON MICROPROCESSOR/SOC TEST, SECURITY
   AND VERIFICATION (MTV 2019)},
Series = {Proceedings International Workshop on Microprocessor Test and
   Verification},
Year = {2019},
Pages = {50-55},
Note = {20th International Workshop on Microprocessor and SOC Test, Security and
   Verification (MTV), Austin, TX, DEC 09-10, 2019},
Abstract = {Attacks which combine software vulnerabilities and hardware
   vulnerabilities are emerging security problems. Although the runtime
   verification or remote attestation can determine the correctness of a
   system, existing methods suffer from inflexible security policy setup
   and high performance overheads. Meanwhile, they rarely focus on
   addressing the threat in the RISC-V architecture, which provides an open
   Instruction Set Architecture (ISA) of the processsor. In this paper, we
   propose a comprehensive software and hardware co-verification method to
   protect the entire RISC-V system in the runtime. The proposed method
   adopts the Dynamic Information Flow Tracking (DIFT) framework to
   implement a new Verifier and Prover security architecture for supporting
   runtime software and hardware co-verification. We realize a FPGA
   prototype on the Rocket-Chip, an RISC-V open-source processor core. The
   framework is implemented as a co-processor which do not change the
   architecture of main processor core and the new security architecture
   can be integrated with other RISC-V processors.},
