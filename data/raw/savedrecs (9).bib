@article{ WOS:000609003900032,
Author = {Hu, Yuecong and Chen, Shaochuang and Cong, Xin and Sun, Sida and Wu,
   Jiang-bin and Zhang, Daqi and Yang, Feng and Yang, Juan and Tan,
   Ping-Heng and Li, Yan},
Title = {Electronic Raman Scattering in Suspended Semiconducting Carbon Nanotube},
Journal = {JOURNAL OF PHYSICAL CHEMISTRY LETTERS},
Year = {2020},
Volume = {11},
Number = {24},
Pages = {10497-10503},
Month = {DEC 17},
Abstract = {The electronic Raman scattering (ERS) features of single-walled carbon
   nanotubes (SWNTs) can reveal a wealth of information about their
   electronic structures. Previously, the ERS processes have been
   exclusively reported in metallic SWNTs (M-SWNTs) and attributed to the
   inelastic scattering of photoexcited excitons by a continuum of
   low-energy electron-hole pairs near the Fermi level. Therefore, the ERS
   features have been thought to appear exclusively in M-SWNTs but not in
   semiconducting SWNTs (S-SWNTs), which are more desired in many
   application fields such as nanoelectronics and bioimaging. In this work,
   the experimental observation of the ERS features in suspended S-SWNTs is
   reported, the processes of which are accomplished via the available
   high-energy electron-hole pairs. The excitonic transition energies with
   an uncertainty in the order of +/- 1 meV can be directly obtained via
   the ERS spectra, compared to a typical uncertainty of +/- 10 meV in
   conventional electronic spectroscopies. The ERS features can facilitate
   further systematic studies on the properties of SWNT, both metallic and
   semiconducting, with defined chirality.},
Type = {Article},
Affiliation = {Yang, J; Li, Y (Corresponding Author), Peking Univ, Coll Chem \& Mol Engn, State Key Lab Rare Earth Mat Chem \& Applicat, Beijing Natl Lab Mol Sci,Key Lab Phys \& Chem Nano, Beijing 100871, Peoples R China.
