Booktitle = {10TH INTERNATIONAL CONFERENCE ON INTERACTIVE THEOREM PROVING, ITP 2019},
Series = {Leibniz International Proceedings in Informatics},
Year = {2019},
Volume = {141},
Note = {10th International Conference on Interactive Theorem Proving-ITP,
   Portland, OR, SEP 09-12, 2019},
Abstract = {There are useful programs that do not terminate, and yet standard Hoare
   logics are not able to prove liveness properties about non-terminating
   programs. This paper shows how a Hoare-like programming logic framework
   (characteristic formulae) can be extended to enable reasoning about the
   I/O behaviour of programs that do not terminate. The approach is
   inspired by transfinite induction rather than coinduction, and does not
   require non-terminating loops to be productive. This work has been
   developed in the HOL4 theorem prover and has been integrated into the
   ecosystem of proof tools surrounding the CakeML programming language.},
