DOI = {10.1109/TCAD.2024.3372461},
Keywords = {Association rule analysis (ARA); combinational circuits; input vectors
   (IVs) identification; reliability-critical IVs (RCIVs); sequential
   circuits; Association rule analysis (ARA); combinational circuits; input
   vectors (IVs) identification; reliability-critical IVs (RCIVs);
   sequential circuits},
