@inproceedings{ WOS:000401471500031,
Author = {Zimmer, Brian and Chiu, Pi-Feng and Nikolic, Borivoje and Asanovic,
   Krste},
Book-Group-Author = {IEEE},
Title = {Reprogrammable Redundancy for Cache Vmin Reduction in a 28nm
   RISC-V Processor},
Booktitle = {2016 IEEE ASIAN SOLID-STATE CIRCUITS CONFERENCE (A-SSCC)},
Series = {IEEE Asian Solid-State Circuits Conference Proceedings of Technical
   Papers},
Year = {2016},
Pages = {121-124},
Note = {IEEE Asian Solid-State Circuits Conference (A-SSCC), Toyama, JAPAN, NOV
   07-09, 2016},
Abstract = {The presented processor lowers SRAM-based cache V-min by using three
   architectural techniques-bit bypass (BB), dynamic column redundancy
   (DCR), and line disable (LD)-that use low-overhead reprogrammable
   redundancy (RR) to avoid failing bitcells and therefore increase the
   maximum bitcell failure rate in processor caches. In the 28nm chip, the
   V-min of the 1MB L2 cache is reduced by 25\%, resulting in a 49\% power
   reduction with a 2\% area overhead and minimal timing overhead.},
