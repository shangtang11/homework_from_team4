@inproceedings{ WOS:000724166000004,
Author = {Kritikakou, Angeliki and Skalistis, Stefanos},
Editor = {Mitra, T and Gerstlauer, A},
Title = {Progress-aware Dynamic Slack Exploitation in Mixed-critical Systems:
   Work-in-Progress},
Booktitle = {PROCEEDINGS OF THE 2020 INTERNATIONAL CONFERENCE ON EMBEDDED SOFTWARE
   (EMSOFT)},
Year = {2020},
Pages = {10-12},
Note = {International Conference on Embedded Software (EMSOFT) / 16th Embedded
   Systems Week (ESWEEK), ELECTR NETWORK, SEP 20-25, 2020},
Abstract = {Mixed-critical systems consist of high criticality and low criticality
   applications. When a high criticality task exceeds its less pessimistic
   Worst Case Execution Time (WCET), the system switches mode and low
   criticality tasks are usually dropped. To postpone mode switch, existing
   approaches explore the slack, created dynamically due to an actual
   execution of a task that is faster than its WCET. However, the slack is
   visible only after the task has finished. To further enable dynamic
   slack exploitation, we propose a fine-grained approach that exposes the
   slack created due to the progress of tasks, during execution, and safely
   uses it to postpone mode switch.},
Type = {Proceedings Paper},
Affiliation = {Kritikakou, A (Corresponding Author), Univ Rennes, IRISA, CNRS, INRIA, Rennes, France.
   Kritikakou, Angeliki, Univ Rennes, IRISA, CNRS, INRIA, Rennes, France.
   Skalistis, Stefanos, Raytheon Technol Res Ctr, Cork, Ireland.},
