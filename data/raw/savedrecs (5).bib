@inproceedings{ WOS:001414891300070,
Author = {Xu, Dong and Feng, Yuan and Shin, Kwangsik and Kim, Daewoo and Jeon,
   Hyeran and Li, Dong},
Book-Group-Author = {IEEE},
Title = {Efficient Tensor Offloading for Large Deep-Learning Model Training based
   on Compute Express Link},
Booktitle = {SC24: INTERNATIONAL CONFERENCE FOR HIGH PERFORMANCE COMPUTING,
   NETWORKING, STORAGE AND ANALYSIS, 2024},
Year = {2024},
Note = {2024 International Conference for High Performance Computing,
   Networking, Storage and Analysis, Atlanta, GA, NOV 17-22, 2024},
Abstract = {The deep learning models (DL) are becoming bigger, easily beyond the
   memory capacity of a single accelerator. The recent progress in large DL
   training utilizes CPU memory as an extension of accelerator memory and
   offloads tensors to CPU memory to save accelerator memory. This solution
   transfers tensors between the two memories, creating a major performance
   bottleneck. We identify two problems during tensor transfers: (1) the
   coarse-grained tensor transfer creating difficulty in hiding transfer
   overhead, and (2) the redundant transfer that unnecessarily migrates
   value-unchanged bytes from CPU to accelerator. We introduce a cache
   coherence interconnect based on Compute Express Link (CXL) to build a
   cache coherence domain between CPU memory and accelerator memory. By
   slightly extending CXL to support an update cache-coherence protocol and
   avoiding unnecessary data transfers, we reduce training time by 33.7\%
   (up to 55.4\%) without changing model convergence and accuracy, compared
   with the state-of-the-art work in DeepSpeed {[}62].},
