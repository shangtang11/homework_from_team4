@article{ WOS:001600992300001,
Author = {Xie, Kang and Li, Lang and Song, Qingling},
Title = {FLLBC: a low-power lightweight block cipher for internet of medical
   things},
Journal = {PHYSICA SCRIPTA},
Year = {2025},
Volume = {100},
Number = {10},
Month = {OCT 1},
Abstract = {It is becoming increasingly prominent to ensure the secure transmission
   of sensitive patient data with the rapidly developing Internet of
   Medical Things (IoMT). In addition, IoMT devices predominantly operate
   on batteries and have power limitations. A low-power lightweight block
   cipher named FLLBC is proposed in this paper to maintain secure data
   transmission in resource-constrained IoMT devices. Firstly, a
   four-branch variant of the Lai-Massey structure is designed by FLLBC
   with a simplified round function that significantly reduces the power
   consumption. At the same time, nonlinear operations are added to the
   branches on the outside of the structure to break the symmetry of the
   structure. Secondly, two S-boxes of different sizes are constructed on
   the nonlinear layer. A lightweight 5-bit S-box with high security and
   low power consumption is constructed based on a parallel gate-level
   implementation structure, which not only achieves the optimal
   differential uniformity and nonlinearity but also has an area of only
   28.35 GE. FLLBC's 5-bit S-box achieves a 29.2\% reduction in area when
   compared with ASCON's S-box. Meanwhile, a construction method for
   involution 4-bit S-boxes is proposed based on the underlying logic
   gates. The area of the 4-bit S-box obtained by this method is only 12
   GE. Experimental data show that the hardware area and power of FLLBC are
   1655 GE and 2.48 mu W when implemented using the UMC 0.18 mu m 1P6M
   process library. FLLBC reduces power consumption and area by 18.6\%
   compared with Midori. Finally, an IoMT data acquisition and
   communication infrastructure is developed, and FLLBC was used to encrypt
   the collected data.},
