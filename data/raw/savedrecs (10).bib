Title = {A Minimal RISC-V Vector Processor for Embedded Systems},
Booktitle = {PROCEEDINGS OF THE 2020 FORUM FOR SPECIFICATION AND DESIGN LANGUAGES
   (FDL)},
Series = {International Forum on Design Languages},
Year = {2020},
Note = {Forum for Specification and Design Languages (FDL), Kiel, GERMANY, SEP
   15-17, 2020},
Abstract = {This paper presents the first RISC-V vector processor design aimed at
   microcontrollers that uses the new RISC-V `V' extension for vectors,
   part of the open-source RISC-V instruction set architecture (ISA). Being
   aimed at small embedded devices, it demonstrates a simpler method of
   parallel execution than traditional vector architectures to minimise
   logic. It has been synthesised for testing on an FPGA at 50MHz. Typical
   vector-compatible applications have been used as benchmarks. Performance
   has been improved by up to 5.8x for the demonstrated applications
   relative to a comparable scalar RISC-V processor, for an increase in
   FPGA resource utilisation of at most 2.6x.},
