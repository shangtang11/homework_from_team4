@article{ WOS:001716335200001,
Author = {Zhu, Yi and Jia, Qiaoqiao and Liu, Shikai and Chen, Xin and Zhang,
   Tingting},
Title = {Cross-Platform Cognitive Load Assessment in Human-Computer Interaction
   Using EEG and Frequency-Domain Weighted Modeling},
Journal = {INTERNATIONAL JOURNAL OF HUMAN-COMPUTER INTERACTION},
Year = {2026},
Month = {2026 MAR 13},
Abstract = {Cognitive load assessment using Electroencephalogram (EEG) signals has
   emerged as a critical area in Human-Computer Interaction (HCI). However,
   most existing methods are developed for single-platform environments and
   often overlook the distributional differences in EEG signals and feature
   transfer challenges between traditional Personal Computer (PC) and
   Virtual Reality (VR) platforms. To address these issues, this paper
   proposes a cross-platform cognitive load assessment framework that
   integrates frequency-domain feature modeling with a cognitively-driven
   dynamic weighting mechanism. The approach begins by extracting
   multi-band Power Spectral Density (PSD) features via Fast Fourier
   Transform (FFT), leveraging the characteristics of different EEG
   frequency bands to capture variations in cognitive load. Unlike
   traditional models that rely on static feature weighting, the proposed
   method employs a dynamic weighting scheme that adjusts based on task
   duration, device type, and spectral energy distribution. This enhances
   the model's adaptability and robustness across platforms. Experimental
   results demonstrate better classification performance in multi-task
   scenarios on both PC and VR platforms, particularly through improved
   identification of high-frequency beta and gamma bands features. The key
   contributions of this study include the introduction of a novel weighted
   EEG modeling approach and the advancement of cross-platform cognitive
   load assessment, offering robust technical support for future HCI
   applications in diverse and complex environments.},
Type = {Article; Early Access},
