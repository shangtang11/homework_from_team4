@inproceedings{ WOS:001506972600326,
Author = {Abich, Geancarlo},
Book-Group-Author = {IEEE},
Title = {Assessing Soft Error Reliability in Vectorized Kernels: Vulnerability
   and Performance Trade-offs on Arm and RISC-V ISAs},
Booktitle = {2025 DESIGN, AUTOMATION \& TEST IN EUROPE CONFERENCE, DATE},
Series = {Design Automation and Test in Europe Conference and Exhibition},
Year = {2025},
Note = {2025 Design, Automation \& Test in Europe Conference-DATE, Lyon, FRANCE,
   MAR 31-APR 02, 2025},
Abstract = {The demand for advanced processing capabilities is paramount in the
   ever-evolving landscape of radiation-resilient computing exploration.
   With the standardization of vector extensions on Arm and Risc-V ISAs,
   leading technology companies are adopting high-performance processors to
   exploit vector capabilities. This work promotes uniform random fault
   injection techniques to assess the increased vulnerability within the
   adoption of vector extensions from RISC-V RVV and Arm SVE. The obtained
   results show the soft error criticality correlation to registers'
   cross-section and the vectorized benchmarks, emphasizing the necessity
   of performance and reliability balance in emerging devices with vector
   capabilities.},
