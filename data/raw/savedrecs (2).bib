@inproceedings{ WOS:001552253000024,
Author = {Ji, Xuan and Kazmierski, Tom J. and Halak, Basel},
Editor = {Tylman, W},
Title = {SYNAPSE A New Approach to Semi -automated Design of Ultra -low -power
   Application -specific Embedded Processors},
Booktitle = {2025 32ND INTERNATIONAL CONFERENCE ON MIXED DESIGN OF INTEGRATED
   CIRCUITS AND SYSTEM, MIXDES},
Year = {2025},
Pages = {135-139},
Note = {32nd International Conference on Mixed Design of Integrated Circuits and
   System-MIXDES-Annual, Szczecin, POLAND, JUN 26-27, 2025},
Abstract = {The main contribution of this paper is a new approach to semi-automated
   synthesis of Application Specific Embedded Processors (ASEPs). Designers
   of ASEPs do not have the comfort of standardized software support
   because the instruction sets are customised. Therefore, ASEP designs are
   frequently performed manually. However, in recent years a growing
   interest in ASEPs has been observed. This can he explained by the
   following two factors. Firstly, in contrast to general-purpose
   processors, ASEPs are particularly resilient to cybersecurity threats,
   which nowadays affect both software and hardware in modern SoC
   applications, especially in critical areas such as medicine,
   communication or smart grids. Secondly, the usual justification for
   using ASEP designs is their excellent performance and power efficiency
   characteristics which are comparable or can exceed those of dedicated
   hardware. Results presented in this paper show that automated ASEP
   designs can be more than an order of magnitude smaller, and therefore
   more power efficient, than equivalent general-purpose application
   specific embedded processors. The small size results from the fact that
   both the architecture and instruction set of an ASEP are tailored to the
   unique needs of a particular application within the embedded system. The
   automation approach presented in this paper helps to reduce the high
   design costs and necessity to use highly skilled design engineers.},
Type = {Proceedings Paper},
Affiliation = {Ji, X (Corresponding Author), Univ Southampton, Sch Elect \& Comp Sci, Southampton, Hants, England.
   Ji, Xuan; Kazmierski, Tom J.; Halak, Basel, Univ Southampton, Sch Elect \& Comp Sci, Southampton, Hants, England.},
