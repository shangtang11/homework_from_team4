@inproceedings{ WOS:000852879300021,
Author = {Yu, Xiang and Yang, Zhijie and Peng, Linghui and Lin, Bo and Yang,
   Wenjing and Wang, Lei},
Book-Group-Author = {IEEE},
Title = {CNN Specific ISA Extensions Based on RISC-V Processors},
Booktitle = {2022 5TH INTERNATIONAL CONFERENCE ON CIRCUITS, SYSTEMS AND SIMULATION
   (ICCSS 2022)},
Year = {2022},
Pages = {116-120},
Note = {5th International Conference on Circuits, Systems and Simulation
   (ICCSS), Joint Int Res Lab Informat Display \& Visualizat, Nanjing,
   PEOPLES R CHINA, MAY 13-15, 2022},
Abstract = {The CNNs have achieved excellent performance in pattern recognition and
   target detection, which have a wide range of applications in industrial
   control, medical imaging, autonomous driving, and other fields. However,
   it is very inefficient to execute data-intensive CNN applications on
   edge devices with limited computing and power resources. It is necessary
   to add a domain-specific acceleration module on the edge devices to
   improve the performance when performing intensive calculations. In this
   work, we present ISA extensions based on the RISC-V ISA, including data
   operation instruction and data transfer instruction, aimed at boosting
   the computational efficiency of CNNs on edge devices. The
   microarchitecture supporting our proposed extensions is built on top of
   an open-source RISC-V core. In addition, extended instructions have been
   added to the GCC Binutils toolchain. To evaluate the effect of our
   extended instructions, we performed a set of workloads on the baseline
   and extended core, our proposed ISA extensions have a speed-up ratio of
   1.5x when executing a CNN, and reaches 2.48x-2.82x when only performing
   convolution calculations. The results show that our proposed ISA
   extensions can effectively improve the performance of CNNs.},
