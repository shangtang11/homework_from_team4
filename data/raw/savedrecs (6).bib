@article{ WOS:001120965700001,
Author = {Huang, Shan and Yin, Hua-Lei and Chen, Zeng-Bing and Wu, Shengjun},
Title = {Quantum-Accelerated Algorithms for Generating Random Primitive
   Polynomials Over Finite Fields},
