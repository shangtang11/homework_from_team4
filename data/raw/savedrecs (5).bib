@inproceedings{ WOS:001451853300005,
Author = {Strauch, Tobias},
Book-Group-Author = {IEEE},
Title = {Transaction Level Hierarchy Guided and Functional Coverage Driven
   Deductive Formal Verification},
Booktitle = {2024 INTERNATIONAL WORKSHOP ON RAPID SYSTEM PROTOTYPING, RSP},
Series = {IEEE International Symposium on Rapid System Prototyping},
Year = {2024},
Pages = {28-34},
Note = {35th International Symposium on Rapid System Prototyping, Raleigh, NC,
   OCT 03, 2024},
Abstract = {We demonstrate how dynamic verification (e.g. simulation) can be
   replaced by deductive formal verification and how to benefit from the
   advantages of symbolic verification and the reuse of verification
   proofs. To do this, we swap the well-known module-hierarchy based
   concept with a transaction-level (TL) based alternative, which still
   allows us to describe the design as precisely as on RTL. We enhance the
   aspect-oriented and TL oriented language PDVL to support the definition
   of functional coverage (FC) and assertions at all levels of a
   TL-hierarchy.
   We then show how to use a deductive formal verification (DFV) flow which
   compiles PDVL code into Gallina code to be used by the Coq theorem
   prover. It can be argued that FC can be converted into proof obligations
   and that proving them is equivalent to 100\% coverage. We also
   demonstrate how lower-level proofs can be reused when verifying aspects
   at higher-levels of a TL-hierarchy. We argue that the traditional
   assertion-based verification (ABV) methodology is still supported and
   SVA can be proven using DFV.},
Type = {Proceedings Paper},
Affiliation = {Strauch, T (Corresponding Author), EDAptix eK, R\&D, Munich, Germany.
   Strauch, Tobias, EDAptix eK, R\&D, Munich, Germany.},
DOI = {10.1109/RSP64122.2024.10870908},
Keywords = {Transaction level design and verification; deductive formal
   verification; coverage driven verification; ABV},
