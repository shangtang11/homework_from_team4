@inproceedings{ WOS:001248072800180,
Author = {Zhu, Shiliang and Miao, Min and Zhang, Zhuanzhuan and Duan, Xiaolong},
Book-Group-Author = {IEEE},
Title = {Research on A Chiplet-based DSA (Domain-Specific Architectures) Scalable
   Convolutional Acceleration Architecture},
Booktitle = {2022 23RD INTERNATIONAL CONFERENCE ON ELECTRONIC PACKAGING TECHNOLOGY,
   ICEPT},
Series = {International Conference on Electronic Packaging Technology},
Year = {2022},
Note = {23rd International Conference on Electronic Packaging Technology
   (ICEPT), Dalian, PEOPLES R CHINA, AUG 10-13, 2022},
Abstract = {With the development of AI (Artificial Intelligence) technology, CNN
   (Convolutional Neural Networks) with more hidden layers and complex
   structures have emerged, which also means denser interaction among
   computing, storage, and data exchange cores. In order to enhance energy
   efficiency and processing capability, in addition to optimizing CNN
   computational model, it is also of significance to choose a suitable
   hardware architecture. Considering the huge energy consumption of
   general-purpose CPUs (central processing unit) and GPUs (graphic
   processing unit), the industry is currently focusing on FPGA (Field
   Programmable Gate Array)/CPU or FPGA/GPU combination as heterogeneous
   computational model, where the FPGA acts as an acceleration coprocessor.
   Therefore, this paper proposes a chiplet-based DSA (Domain Specific
   Architecture) scalable convolution acceleration architecture in this
   context. The architecture is designed in the paradigm of 2.5D chiplet
   integration, in which chiplets interconnected with 2D mesh network
   co-work as a whole. Compared with the on-chip interconnects of SoC
   (system-on-chip), the proposed microsystem architecture has the
   following features:1)a double-layer NoC (Network-on-Chip) architecture
   capable of high data throughput; 2) The multi-path XY algorithm based on
   the two-layer NoC framework. Therefore, the system can dynamically
   adjust the number of NoC nodes receiving data on the data path according
   to the size of the convolution kernel, and therefore enhance the
   parallelism of the system. With the proposed architecture, the
   computational efficiency of convolutional acceleration can be improved,
   as well as flexibility in responding to convolutional tasks with various
   nature and demands.},
Type = {Proceedings Paper},
Affiliation = {Miao, M (Corresponding Author), Beijing Informat Sci \& Technol Univ, Key Lab, Minist Educ Optoelect Measurement Technol \& Instr, Beijing 100101, Peoples R China.
