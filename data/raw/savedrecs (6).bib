DOI = {10.1016/j.future.2023.07.002},
EarlyAccessDate = {JUL 2023},
Keywords = {General Matrix-Matrix Multiplication; General Matrix-Matrix Operations;
   Hardware accelerator; Embedded-systems; Online-learning; TinyML},
