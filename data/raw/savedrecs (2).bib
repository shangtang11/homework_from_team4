@inproceedings{ WOS:001575951700069,
Author = {Bohra, Dixit Dutt and Banerjee, Dip Sankar and Sanadhya, Somitra},
Book-Group-Author = {IEEE},
Title = {Sparse-Aware NTT: Accelerating Lattice-Based Cryptography on FPGAs},
