Title = {Investigating FPGA Gaming Systems: Real-Time Tic-Tac-Toe with Custom
   RISC, VGA Output, and Hardware Counters},
Booktitle = {2025 5TH INTERNATIONAL CONFERENCE ON TRENDS IN MATERIAL SCIENCE AND
   INVENTIVE MATERIALS, ICTMIM},
Year = {2025},
Pages = {416-421},
Note = {5th International Conference on Trends in Material Science and Inventive
   Materials-ICTMIM, Kanyakumari, INDIA, APR 07-09, 2025},
Abstract = {This paper presents an FPGA based real-time Tic Tac Toe gaming system
   with custom RISC processor, VGA output and hardware counters. In
   contrast, software-based implementation in traditional gaming systems
   can incur processing delays and increase resource overhead. We address
   these challenges in this research by developing a fully hardware-based
   solution that exploits parallelism and efficient resource utilization.
   With the proposed system, the behavior of latency and hardware
   utilization is optimized so that real time gameplay is with minimal
   latency. Synthesis and simulation confirm the implementation with low
   resource usage without compromising the smooth performance. The results
   validate the correctability of the approach based on using the FPGA for
   delivering it with interactive gaming experience with high
   responsiveness.},
