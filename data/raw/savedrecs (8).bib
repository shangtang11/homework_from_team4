@inproceedings{ WOS:000869767400008,
Author = {Koffas, Stefanos and Vadnala, Praveen Kumar},
Editor = {Zhou, J and Adepu, S and Alcaraz, C and Batina, L and Casalicchio, E and Chattopadhyay, S and Jin, C and Lin, J and Losiouk, E and Majumdar, S and Meng, W and Picek, S and Shao, J and Su, C and Wang, C and Zhauniarovich, Y and Zonouz, S},
Title = {On the Effect of Clock Frequency on Voltage and Electromagnetic Fault
   Injection},
Booktitle = {APPLIED CRYPTOGRAPHY AND NETWORK SECURITY WORKSHOPS, ACNS 2022},
Series = {Lecture Notes in Computer Science},
Year = {2022},
Volume = {13285},
Pages = {127-145},
Note = {20th International Conference on Applied Cryptography and Network
   Security (ACNS), ELECTR NETWORK, JUN 20-23, 2022},
Abstract = {We investigate the influence of clock frequency on the success rate of a
   fault injection attack. In particular, we examine the success rate of
   voltage and electromagnetic fault attacks for varying clock frequencies.
   Using three different tests that cover different components of a
   System-on-Chip, we perform fault injection while its CPU operates at
   different clock frequencies. Our results show that the attack's success
   rate increases with an increase in clock frequency for both voltage and
   EM fault injection attacks. As the technology advances push the clock
   frequency further, these results can help assess the impact of fault
   injection attacks more accurately and develop appropriate
   countermeasures to address them.},
