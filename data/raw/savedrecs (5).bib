@inproceedings{ WOS:001236958200067,
Author = {Liu, Xin-You},
Book-Group-Author = {ASSOC COMPUTING MACHINERY},
Title = {Student Research Abstract: Real-Time 3D Registration and Fusion with
   SRAM-based Analog In-Memory Computing},
Booktitle = {39TH ANNUAL ACM SYMPOSIUM ON APPLIED COMPUTING, SAC 2024},
Year = {2024},
Pages = {454-456},
Note = {39th Annual ACM Symposium on Applied Computing (SAC), Univ Salamanca,
   Avila, SPAIN, APR 08-12, 2024},
Abstract = {In-memory computing systems are designed to offload workloads without
   transmitting tasks between CPU or GPU, reducing energy consumption. 3D
   sensors generate events of interest, usually powered by harvested energy
   or prolonged battery lifetimes. This work designed a three-dimensional
   (3D) sensing system using analog SRAM-based CIMs macro for storage and
   data processing to identify the subjects. The proposed neural network
   training scheme embedded the uncertainty model to tackle ADC
   non-deterministic thermal noise error. The design leverages the
   multiplication-accumulation (MAC) operation with limited precision on
   SRAM CIM macro, accelerating computation such as graph convolution,
   attention mechanism, and.. nearest high dimensional feature vectors in
   Euclidean distance for the proposed registration pipeline. The
   experiment shows a reduction in the model size by up to 27 times,
   reduces the energy consumption by at least 100 times, and shortens the
   inference time by 297 times.},
Type = {Proceedings Paper},
Affiliation = {Liu, XY (Corresponding Author), Natl Taiwan Univ, Dept Comp Sci \& Informat Engn, Taipei, Taiwan.
