@article{ WOS:001630038300001,
Author = {Surulivelu, Muthumarilakshmi and Hemanand, D. and Babu, R. Ganesh and
   Subash, T. D.},
Title = {AI-based tuberculosis detection and localization in chest X-rays using a
   Binarized Simplicial Convolutional Neural Network for efficient and
   accurate diagnosis},
Journal = {BIOMEDICAL SIGNAL PROCESSING AND CONTROL},
Year = {2026},
Volume = {113},
Number = {D},
Month = {MAR},
Abstract = {Mycobacterium tuberculosis (MTB) is the infectious agent that causes
   tuberculosis (TB), and its detection requires identifying the bacteria
   in the body to ensure timely treatment and control. In this manuscript,
   an AI-driven approach using a binarized simplicial convolutional neural
   network enables efficient and accurate detection and localization of
   tuberculosis in chest X-rays (AI-TDL-CXR-BSCNN) is proposed. Firstly,
   the input image is gathered from the Chest X-ray dataset and then
   pre-processed using Robust Maximum Correntropy Kalman Filter (RMCKF),
   for normalization and image resizing. Then, the pre-processed image is
   given to Weighted Multi-View Evidential Clustering (WMVEC) to segment
   the lung region. Then the segmented images are given to the Refined
   Linear Chirplet Transform (RLCT) for feature extraction. RLCT is used to
   extract relevant features like texture, color, and shape. Then the
   extracted features are given to the Binarized Simplicial Convolutional
   Neural Network (BSCNN) to detect TB in CXR images and classify them as
   Tuberculosis and Normal. The Multiplayer Battle Game-Inspired Optimizer
   (MBGO) is employed to optimize the weight parameters of BSCNN. The
   proposed AI-TDL-CXR-BSCNN approach implemented in Python demonstrates
   substantial improvements in accuracy, precision, sensitivity, F1 score,
   receiver operating characteristic curve (ROC), specificity, intersection
   over union (IoU) and Dice. The proposed AI-TDL-CXR-BSCNN approach
   achieves an accuracy of 99\% for Tuberculosis and 97\% for Normal
   compared with existing methods. These findings confirm the reliability
   and effectiveness of the proposed technique for accurate and efficient
   TB detection from CXR images.},
