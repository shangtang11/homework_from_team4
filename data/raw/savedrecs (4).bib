@article{ WOS:001203373000025,
Author = {Kong, Liang and Qin, Guojie and Li, Shuguo},
Title = {Design an Efficient FPGA-Based Accelerator for Leveled BFV Homomorphic
   Encryption},
Journal = {IEEE TRANSACTIONS ON CIRCUITS AND SYSTEMS II-EXPRESS BRIEFS},
Year = {2024},
Volume = {71},
Number = {3},
Pages = {1381-1385},
Month = {MAR},
Abstract = {In this brief, we present computational fusions with Residue Number
   System (RNS) basis transforms to enhance computational efficiency. We
   also investigate the impact of the word length of RNS primes for the
   leveled BFV scheme. Moreover, the method of dedicated acceleration for
   the critical subroutine is proposed. Based on these optimizations, an
   efficient accelerator for the leveled BFV scheme is accomplished on
   Virtex-7 FPGA. Compared to latest works, our design achieves 1.6 times
   speedup and 1.4x-2.6x area-time-product improvements.},
