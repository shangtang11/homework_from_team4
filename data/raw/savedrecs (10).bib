Affiliations = {Kyungpook National University (KNU)},
Cited-References = {Han Y, 2020, IEEE T INTELL TRANSP, V21, P298, DOI 10.1109/TITS.2019.2891314.
   Kanamoto T, 2019, MIDWEST SYMP CIRCUIT, P1085, DOI {[}10.1109/mwscas.2019.8884919, 10.1109/MWSCAS.2019.8884919].
   Lee D., 2020 INT C EL INF CO, P1.},
