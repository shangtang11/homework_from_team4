   Ali, Muhammad Intizar, Dublin City Univ, Sch Elect Engn, Dublin, Ireland.},
DOI = {10.1109/SCC53864.2021.00045},
Keywords = {IoT Devices; TinyML; Microcontrollers; Offline Inference; SRAM
   Optimization; Classifiers Porting},
