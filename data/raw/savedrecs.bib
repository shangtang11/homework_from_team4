@article{ WOS:001606766000001,
Author = {Xia, Haihang and Liu, Haotian and Zhao, Yuqin and Goodenough, John and
   Abhayaratne, Charith and Liu, Sichen and Li, Sizhao and Deng, Tiantai},
Title = {An Approximate Computing-Based Spiking Neural Networks Neuron Model and
   STDP Learning},
Journal = {IEEE TRANSACTIONS ON CIRCUITS AND SYSTEMS I-REGULAR PAPERS},
Year = {2026},
Volume = {73},
Number = {4},
Pages = {2621-2634},
Month = {APR},
Abstract = {Spiking Neural Networks (SNNs) show great potential in applications such
   as image processing, robotics, and communications. However, the vast
   number of neuron models and learning algorithms in large-scale SNNs
   impose significant hardware and energy overhead, with multiplication
   remaining the most critical operation. Thus, to address this challenge,
   this paper presents the hardware design of the Logarithmic Linear
   Multiply (LLMu) and Logarithmic Linear Segmented Multiply (LLSMu). These
   two components are specifically designed for neuron models and learning
   algorithms, achieving high accuracy with low hardware resource
   utilization and energy consumption. To demonstrate the capabilities of
   LLMu and LLSMu, we implement two mainstream SNN neuron models-Leaky
   Integrate-and-Fire (LIF) and Izhikevich-as well as the Spike
   Timing-Dependent Plasticity (STDP) learning algorithm, and compare their
   performance with state-of-the-art approaches on FPGA and ASIC platforms.
   The scope of this work is limited to these models and algorithms. The
   LLMu-and LLSMu-based implementations exhibit significantly improved
   energy efficiency over existing methods. Specifically, in the FPGA
   implementation, the LLSMubased LIF neuron model achieves a 6.75x
   improvement, the LLSMu-based Izhikevich neuron model achieves a 2.70x to
   3.72x improvement, and the LLMu-based STDP achieves a 21.03x to 48.78x
   improvement in energy efficiency. In the ASIC implementation, the
   LLSMu-based Izhikevich neuron model further improves energy efficiency
   by 5.58x to 5.69x, while the LLMu-based STDP achieves 5.96x and 3.69x
   improvements compared to prior designs.},
