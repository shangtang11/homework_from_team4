@inproceedings{ WOS:001698291100010,
Author = {Schneider, Klaus and Selim, Demyana and Kercher, Nadine},
Book-Group-Author = {IEEE},
Title = {Performance Modeling and Analysis of Exposed Datapath Architectures},
Booktitle = {2025 FORUM ON SPECIFICATION \&AMP; DESIGN LANGUAGES, FDL},
Series = {International Forum on Design Languages},
Year = {2025},
Note = {2025 Forum on Specification \& Design Languages-FDL, GERMANY, SEP 10-12,
   2025},
Abstract = {In exposed data path architectures, registers are replaced by an on-chip
   network that connects their processing units (PUs) directly. This allows
   the compiler to determine PU allocation, instruction scheduling, and
   data transport between the PUs. To prevent unnecessary synchronization
   of the PUs, their network ports are typically buffered. Although many
   performance models are available for traditional RISC architectures,
   there are no specific performance models for buffered exposed datapath
   (BED) architectures.
   In this paper, we investigate the impact of the relevant design
   parameters of BED architectures, consider their dependencies, and
   determine reasonable parameter values for designing cost-effective
   efficient BED processors. In particular, we examine the number of PUs,
   the instruction issue width (superscalarity), the size of network
   buffers, and the latency of instructions, and relate these parameters
   with the processor performance. We develop a performance model to
   estimate the runtime in terms of the mentioned parameters and validate
   our performance model with experimental results.},
Type = {Proceedings Paper},
Affiliation = {Schneider, K (Corresponding Author), RPTU Univ Kaiserslautern Landau, Kaiserslautern, Germany.
   Schneider, Klaus; Selim, Demyana; Kercher, Nadine, RPTU Univ Kaiserslautern Landau, Kaiserslautern, Germany.},
