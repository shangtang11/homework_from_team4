@article{ WOS:001712052200005,
Author = {Chatzopoulos, Odysseas and Trakosa, Maria and Dixit, Harish D. and
   Sankar, Sriram and Gizopoulos, Dimitris},
Title = {Phoebe: Measuring the Unmeasurable-Demystifying Silent Data Corruptions
   in AI Accelerators Through Microarchitectural Modeling},
Journal = {IEEE MICRO},
Year = {2026},
Volume = {46},
Number = {1},
Pages = {55-65},
Month = {JAN},
Abstract = {Artificial intelligence (AI) accelerators are vital for efficiently
   executing data-heavy workloads, but increasing design complexity and
   shrinking manufacturing processes introduce serious reliability
   challenges, including silent data corruptions (SDCs). While CPU
   reliability has been analyzed significantly, AI accelerators require
   tailored analysis due to their diverse and evolving designs. We present
   Phoebe, a comprehensive methodology for evaluating the reliability of
   systolic array-based AI accelerators harnessing the power of
   microarchitectural modeling. Phoebe captures the full compute stack,
   from software to gates, across diverse design points, including
   dataflows, datatypes, memory hierarchies, and array sizes. We support
   statistical fault injection on key hardware structures-such as static
   random-access memory, registers, and functional units-across multiple
   fault models. Phoebe also incorporates acceleration techniques that
   increase injection throughput by more than 1000 \& times; without
   sacrificing accuracy. Evaluations on diverse machine-learning models
   reveal SDC vulnerability trends across accelerator design points,
   demonstrating Phoebe's effectiveness for broad design-space exploration.},
Type = {Article},
Affiliation = {Chatzopoulos, O (Corresponding Author), Univ Athens, Athens 16122, Greece.
   Chatzopoulos, Odysseas; Trakosa, Maria, Univ Athens, Athens 16122, Greece.
