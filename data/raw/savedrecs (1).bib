@article{ WOS:001577747200001,
Author = {Singh, Manmohan and Sood, Sandeep Kumar and Bhatia, Munish},
Title = {Post-quantum Cryptography: A Review on Cryptographic Solutions for the
   Era of Quantum Computing},
Journal = {ARCHIVES OF COMPUTATIONAL METHODS IN ENGINEERING},
Year = {2025},
Month = {2025 SEP 24},
Abstract = {The emergence of Quantum Computing (QC) presents a substantial risk to
   conventional cryptography systems, many of which are vulnerable to
   Shor's factoring algorithm and other effective quantum algorithms.
   Post-quantum cryptography (PQC) has arisen as a vital domain,
   concentrating on cryptographic techniques founded on difficulties
   presumed to withstand quantum assaults. The current article offers a
   thorough examination of PQC, focusing specifically on its four principal
   categories: hash-based cryptography (HBC), code-based cryptography
   (CBC), lattice-based cryptography (LBC), and multivariate public key
   cryptography (MPKC). The current study performs a scientometric analysis
   of 3800 publications connected to PQC, sourced from the Scopus database,
   covering the period from 2015 to 2024, to investigate the evolution and
   research trends in the field. The analysis includes link walkthrough
   analysis, document co-citation analysis, burst detection, and keyword
   co-occurrence analysis. The findings underscore significant theme
   clusters, pivotal publications, and nascent trends in PQC research. The
   current study highlights the increasing significance of PQC in many
   applications and offers strategic ideas for improving its efficacy in
   practical implementations. The identified research clusters are
   essential focal points for tackling present issues and directing future
   inquiries in the PQC domain.},
Type = {Review; Early Access},
Affiliation = {Singh, M (Corresponding Author), Natl Inst Technol Kurukshetra, Dept Comp Applicat, Kurukshetra, Haryana, India.
   Singh, Manmohan; Sood, Sandeep Kumar; Bhatia, Munish, Natl Inst Technol Kurukshetra, Dept Comp Applicat, Kurukshetra, Haryana, India.},
