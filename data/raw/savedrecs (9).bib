@article{ WOS:000591830100001,
Author = {Castro, Robson Flavio and Godinho-Filho, Moacir and Tavares-Neto,
   Roberto Fernandes},
Title = {Dispatching method based on particle swarm optimization for
   make-to-availability},
Journal = {JOURNAL OF INTELLIGENT MANUFACTURING},
Year = {2022},
Volume = {33},
Number = {4},
Pages = {1021-1030},
Month = {APR},
Abstract = {Make-to-availability (MTA) is a subtype of make-to-stock that emerged
   from production, planning, and control system, simplified
   drum-buffer-rope (S-DBR). The dispatching production order logic of the
   MTA does not consider the elements present in a wide range of
   manufacturing systems, such as sequence-dependent setup time. These
   characteristics generally creates difficulties in the S-DBR, thereby
   worsening performance indicators, such as mean flow time, setup time,
   and stock replenishment frequency. Given this research gap, the present
   study aims to develop a dispatching method for production orders in MTA,
   based on the particle swarm optimization (PSO) metaheuristic. The
   dispatching method aims to minimize the mean flow time, setup time, and
   stock levels in environments with a dependent setup time. To evaluate
   the performance of the new dispatching method, we used computational
   simulation to compare this method and the MTA dispatching logic. The
   results showed that the PSO for sequence achieved better performance,
   reducing the mean flow time, setup time, and stock level.},
Type = {Article},
Affiliation = {Tavares-Neto, RF (Corresponding Author), Fed Univ Sao Carlos UFSCAR, Dept Ind Engn, Sao Carlos, Brazil.
   Castro, Robson Flavio; Godinho-Filho, Moacir; Tavares-Neto, Roberto Fernandes, Fed Univ Sao Carlos UFSCAR, Dept Ind Engn, Sao Carlos, Brazil.},
