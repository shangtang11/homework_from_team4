@article{ WOS:001549133700001,
Author = {Montanaro, Gabriele and Trovo, Francesco and Zoni, Davide},
Title = {FARMER: Online-Learning-Based Workload Consolidation on Large FPGAs
   Accelerated With Dynamic Partial Reconfiguration},
Journal = {IEEE TRANSACTIONS ON VERY LARGE SCALE INTEGRATION (VLSI) SYSTEMS},
Year = {2026},
Volume = {34},
Number = {1},
Pages = {15-23},
Month = {JAN},
Abstract = {As the demand for performance and scalability in cloud applications
   continues to grow, high-performance computing (HPC) facilities
   increasingly integrate FPGAs to accelerate computational workloads. To
   fully utilize the extensive resources available on modern high-end
   FPGAs, it is essential to optimize the allocation of multiple
   applications on a single device. This article introduces FARMER, a novel
   online learning methodology that leverages machine learning (ML) to
   model the throughput of different applications running concurrently on
   the same FPGA. It combines this with a sequential decision-making
   strategy and an in-circuit exploration flow based on dynamic partial
   reconfiguration (DPR) to drastically speed up the exploration of large
   design spaces. Experimental evaluations across a wide range of
   representative scenarios, conducted on a real prototyping platform using
   an AMD Alveo U55C FPGA board, demonstrate that FARMER consistently
   identifies a feasible solution while exploring less than
   \$\textbackslash{}mathbf \{0.012\textbackslash{}\%\}\$ of the total
   design space.},
Type = {Article},
Affiliation = {Montanaro, G (Corresponding Author), Politecn Milan, Dipartimento Elettron Informaz \& Bioingn, I-20133 Milan, Italy.
   Montanaro, Gabriele; Trovo, Francesco; Zoni, Davide, Politecn Milan, Dipartimento Elettron Informaz \& Bioingn, I-20133 Milan, Italy.},
