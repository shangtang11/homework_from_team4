@article{ WOS:001166968700018,
Author = {Zhang, Yongliang and Rong, Yitong and Duan, Xuyang and Yang, Zhen and
   Li, Qiang and Guo, Ziyu and Cheng, Xu and Zeng, Xiaoyang and Han, Jun},
Title = {An Energy-Efficient BNN Accelerator With Two-Stage Value Prediction for
   Sparse-Edge Gesture Recognition},
Journal = {IEEE TRANSACTIONS ON CIRCUITS AND SYSTEMS I-REGULAR PAPERS},
Year = {2024},
Volume = {71},
Number = {1},
Pages = {320-333},
Month = {JAN},
Abstract = {In recent years, natural, flexible, and contactless vision-based gesture
   recognition has received significant attention in human-computer
   interaction. However, employing convolutional neural networks (CNNs) for
   RGB or RGB-D gestures can result in excessive power consumption and poor
   energy efficiency, making them unsuitable for embedded systems. In this
   paper, we propose a lightweight sparse binarized neural network (sBNN)
   model for edge gesture recognition that achieves an accuracy of
   89.43\%-99.92\% on four open-source gesture datasets with
   \$\textbackslash{}leq 20.26\$ million operations (MOP) and
   \$\textbackslash{}leq 15.83\$ -Kilobytes (KB) parameters. We find high
   channel-level sparsity in the activation maps of sBNN when edge gestures
   are used as inputs. The sparse activation maps have multiple identical
   activation vectors called sparse activation vectors (SAV), which lead to
   highly repeated calculations. In order to avoid this issue, we propose a
   two-stage value prediction approach to skip these calculations,
   achieving a speedup of 1.03x-1.83x. Moreover, to reduce on- chip memory,
   the compression technique is applied to the sparse activation maps,
   providing a compression rate of 1.72x-3.45x. Finally, we implement an
   energy-efficient sparse BNN accelerator (SBA) on an embedded
   field-programmable gate array (FPGA). The experimental results show that
   our SBA has a latency of 26.3-46.8- \$\textbackslash{}mu
   \textbackslash{}text\{s\}\$ , a power consumption of 0.807 W, and an
   energy efficiency of 536.22-952.70-GOPS/W at 50-MHz frequency. Our SBA
   offers lower latency, lower power consumption, and higher energy
   efficiency than previous state-of-the-art gesture recognition
   accelerators.},
Type = {Article},
Affiliation = {Han, J (Corresponding Author), Fudan Univ, State Key Lab Integrated Chips \& Syst, Shanghai 201203, Peoples R China.
   Zhang, Yongliang; Rong, Yitong; Duan, Xuyang; Yang, Zhen; Li, Qiang; Guo, Ziyu; Cheng, Xu; Zeng, Xiaoyang; Han, Jun, Fudan Univ, State Key Lab Integrated Chips \& Syst, Shanghai 201203, Peoples R China.},
DOI = {10.1109/TCSI.2023.3320175},
Keywords = {Gesture recognition; Energy efficiency; Image segmentation; Image edge
   detection; Feature extraction; Power demand; Computer architecture;
   sparse BNN; compression technique; value prediction; FPGA},
