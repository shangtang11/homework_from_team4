   Patooghy, Ahmad, North Carolina A\&T State Univ, Dept Comp Syst Technol, Greensboro, NC 27411 USA.},
DOI = {10.3390/electronics14234745},
Article-Number = {4745},
Keywords = {Hardware Trojans; Large Language Models; Hardware Security; Hardware
   Design},
Author-Email = {faruque@nmsu.edu
   badawy@nmsu.edu},
Affiliations = {New Mexico State University; University System of Ohio; Miami
   University; University of North Carolina; North Carolina A\&T State
   University},
Cited-References = {Ahmad B, 2023, Arxiv, DOI {[}arXiv:2302.01215, 10.48550/arXiv.2302.01215, DOI 10.48550/ARXIV.2302.01215].
