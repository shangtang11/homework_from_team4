@article{ WOS:001649761900001,
Author = {Zhou, Sufang and Wang, Yifeng and Wang, Lin and Chen, Liangyi and Wang,
   Yadi},
Title = {FedDG: An Efficient Federated Learning Framework for IoT Communication
   Based on Dynamic Fusion and Gradient Compression},
Journal = {IEEE TRANSACTIONS ON INDUSTRIAL INFORMATICS},
Year = {2026},
Volume = {22},
Number = {3},
Pages = {2530-2540},
Month = {MAR},
Abstract = {Federated learning (FL) has gained significant attention as a
   distributed machine learning approach in recent years. However, in the
   context of the Internet of Things, terminal devices exhibit considerable
   heterogeneity in data distribution, communication, and computational
   resources. This heterogeneity can introduce bias, hindering model
   accuracy through iterative training. Moreover, disparities in
   communication and computational capabilities limit FL to
   resource-constrained devices, slowing convergence. To address these
   challenges, we propose FedDG, an FL framework that integrates model
   compression and dynamic fusion. Specifically, for nonindependently and
   identically distributed data, we adaptively adjust the client
   compression rate based on model training errors, reducing transmission
   costs while improving both convergence speed and accuracy. Furthermore,
   clients are dynamically selected for aggregation in each round based on
   training time and model performance, alleviating the impact of
   low-resource clients and reducing communication overhead. Experimental
   results show that FedDG significantly lowers communication bandwidth and
   data transmission size, and accelerates model convergence under data
   heterogeneity compared to benchmark schemes, such as FedAvg, FedNova,
   STC, DF\_FL, DAdaQuant, and adaptive quantization in device selection
   strategy (AQUILA).},
