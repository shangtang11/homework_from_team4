@inproceedings{ WOS:000799493300009,
Author = {Tan, Weihang and Wang, Antian and Lao, Yingjie and Zhang, Xinmiao and
   Parhi, Keshab K.},
Book-Group-Author = {IEEE},
Title = {Pipelined High-throughput NTT Architecture for Lattice-Based
   Cryptography},
Booktitle = {PROCEEDINGS OF THE 2021 ASIAN HARDWARE ORIENTED SECURITY AND TRUST
   SYMPOSIUM (ASIANHOST)},
Year = {2021},
Note = {IEEE Asian Hardware Oriented Security and Trust Symposium (AsianHOST),
   Shanghai, PEOPLES R CHINA, DEC 16-18, 2021},
Abstract = {Lattice-based cryptography is a powerful cryptographic primitive that
   can achieve post-quantum security. The most computational-intensive
   operations in the lattice-based cryptographic schemes are the polynomial
   multiplications over the ring, which can be accelerated by adopting the
   number theoretic transform (NTT) in practical applications. This paper
   proposes a novel hardware accelerator for the NTT algorithm for
   lattice-based cryptography applications, which can achieve full
   utilization for all the hardware components. The key ideas involve
   exploiting well-designed folding sets and applying the folding
   transformations to adapt the fast Fourier transform (FFT) multi-path
   delay commutator architectures and a lightweight modular multiplier.},
