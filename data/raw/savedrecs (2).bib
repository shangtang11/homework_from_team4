@inproceedings{ WOS:001596652300024,
Author = {McGhee, Jordan and Lujano, Nayra and Peterson, Aiden and Duwe, Henry and
   Tyagi, Akhilesh and Gulmezoglu, Berk},
Book-Group-Author = {ACM},
Title = {Microarchitecture Evaluation Framework for Transient Execution Attack
   Vulnerability: Metrics, Fuzzing, and Sensitivity Analysis},
Booktitle = {PROCEEDINGS OF THE GREAT LAKES SYMPOSIUM ON VLSI 2025, GLSVLSI 2025},
Year = {2025},
Pages = {161-168},
Note = {35th Great Lakes Symposium on VLSI-GLSVLSI, New Orleans, LA, JUN 30-JUL
   02, 2025},
Abstract = {In this paper, we present a unified vulnerability analysis framework for
   transient execution attacks in out-of-order processors. We illustrate
   with a representative Spectre attack template and fuzzing to expose the
   range of speculative window sizes exhibited by a microarchitecture. Our
   results show small, medium, and large BOOM cores with speculative window
   sizes of 30-185 cycles, 40-370 cycles, and 70-540 cycles, respectively.
   Large speculative windows allow us to examine multi-byte leakage. We
   then demonstrate a tradeoff between online and offline effort for the
   attacker.
   We show that increased speculative window size does not necessarily
   result in increased leakage bandwidth. Small BOOM core saturates at 2
   leaked bytes per attack round. Medium and large BOOM cores saturate at 4
   leaked bytes per attack round despite having a speculative window size
   of 540. This indicates that some other microarchitecture parameters
   become the limiting factor instead of speculative window size. We
   performed a preliminary sensitivity analysis which helped strengthen
   this claim.},
