@article{ WOS:000967266100001,
Author = {Khurshid, Anum and Yalew, Sileshi Demesie and Aslam, Mudassar and Raza,
   Shahid},
Title = {ShieLD: Shielding Cross-Zone Communication Within Limited-Resourced IoT
   Devices Running Vulnerable Software Stack},
Journal = {IEEE TRANSACTIONS ON DEPENDABLE AND SECURE COMPUTING},
Year = {2023},
Volume = {20},
Number = {2},
Pages = {1031-1047},
Month = {MAR-APR},
Abstract = {Securing IoT devices is gaining attention as the security risks
   associated with these devices increase rapidly. TrustZone-M, a Trusted
   Execution Environment (TEE) for Cortex-M processors, ensures stronger
   security within an IoT device by allowing isolated execution of
   security-critical operations, without trusting the entire software
   stack. However, TrustZone-M does not guarantee secure cross-world
   communication between applications in the Normal and Secure worlds. The
   cryptographic protection of the communication channel is an obvious
   solution; however, within a low-power IoT device, it incurs high
   overhead if applied to each cross-world message exchange. We present
   ShieLD, a framework that enables a secure communication channel between
   the two TrustZone-M worlds by leveraging the Memory Protection Unit
   (MPU). ShieLD guarantees confidentiality, integrity and authentication
   services without requiring any cryptographic operations. We implement
   and evaluate ShieLD using a Musca-A test chip board with Cortex-M33 that
   supports TrustZone-M. Our empirical evaluation shows, among other gains,
   the cross-zone communication protected with ShieLD is 5 times faster
   than the conventional crypto-based communication.},
Type = {Article},
Affiliation = {Khurshid, A (Corresponding Author), RISE Res Inst Sweden, Cybersecur Unit, S-50115 Stockholm, Sweden.
   Khurshid, Anum; Yalew, Sileshi Demesie; Aslam, Mudassar; Raza, Shahid, RISE Res Inst Sweden, Cybersecur Unit, S-50115 Stockholm, Sweden.},
