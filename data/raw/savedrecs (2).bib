@article{ WOS:001413219600004,
Author = {Trupiano, Giacomo and De Simoni, Giorgio and Giazotto, Francesco},
Title = {Quasiparticle-injection superconducting microwave relaxation oscillator},
Journal = {PHYSICAL REVIEW APPLIED},
Year = {2025},
Volume = {23},
Number = {1},
Month = {JAN 22},
Abstract = {We propose a superconducting microwave relaxation oscillator based on a
   nanowire shunted by a resistor and an inductor controlled by
   quasiparticle injection from a tunnel junction positioned on it: the
   tuning and dc bias. The device frequency is modulated via the tunnel
   junction, which induces localized heating by injecting quasiparticles.
   This heating mechanism modulates the nanowire switching current,
   enabling relaxation oscillations when it falls below the bias current.
   We simulate the device operating principles and its performance across
   various parameters, including different choices of shunt resistor, shunt
   inductance, and bath temperature ranging from 20 mK to 1 K. The device
   showed oscillation with a frequency range approximately between 1 and 10
   GHz and total energy dissipation per cycle of approximately 100 zJ. Our
   results suggest that this design offers a promising platform for
   compact, tunable superconducting oscillators in the microwave spectrum
   with potential applications in quantum information processing, microwave
   technology, and ultralow-power electronics. The straightforward
   frequency control mechanism and integration potential make this device
   an attractive candidate for superconducting microwave local oscillators.},
