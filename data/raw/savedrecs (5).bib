@inproceedings{ WOS:001304429500004,
Author = {Li, Jiangnan and Yan, Yazhou and Zhu, Guowei and Yin, Wenbo and Wang,
   Lingli},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {An End-to-End Agile Design Framework to Improve Energy Efficiency on
   CGRAs},
Booktitle = {2024 IEEE 35TH INTERNATIONAL CONFERENCE ON APPLICATION-SPECIFIC SYSTEMS,
   ARCHITECTURES AND PROCESSORS, ASAP 2024},
Series = {IEEE International Conference on Application-Specific Systems
   Architectures and Processors},
Year = {2024},
Pages = {17-18},
Note = {35th IEEE International Conference on Application-Specific Systems,
   Architectures and Processors (ASAP), City Univ Hong Kong, Dept Elect
   Engn, Hong Kong, HONG KONG, JUL 24-26, 2024},
Abstract = {In this paper, we propose a domain-specific framework that integrates
   Chisel-based Coarse-grained reconfigurable architecture (CGRA) Modeling,
   RTL generation, Architecture Graph Intermediate Representation (IR),
   dataflow graph (DFG) Mapping, interconnect exploration, and physical
   implementation. Within this framework, we propose an interconnect
   exploration flow based on a novel interconnect architecture called
   Matrix, which realizes a heterogeneous interconnect architecture for a
   set of specific applications by application mapping, design space
   exploration (DSE) and pruning. We design an agile mapper built on a
   graph-based two-level architectural IR, which better adapts to the
   flexible interconnect model and enables greater interconnect exploration
   to improve the mapping success rate. Experiments show a significant
   reduction in architecture area, improved energy efficiency, and high PE
   utilization compared to the state-of-the-art tool, with high-quality
   mapping results due to architecture tuning. Additionally, our pruning
   strategies reduce interconnect paths in the Matrix, ensuring
   interconnect efficiency and further improving PE utilization.},
Type = {Proceedings Paper},
Affiliation = {Wang, LL (Corresponding Author), Fudan Univ, Sch Microelect, State Key Lab Integrated Chips \& Syst, Shanghai, Peoples R China.
   Li, Jiangnan; Yan, Yazhou; Zhu, Guowei; Yin, Wenbo; Wang, Lingli, Fudan Univ, Sch Microelect, State Key Lab Integrated Chips \& Syst, Shanghai, Peoples R China.},
DOI = {10.1109/ASAP61560.2024.00014},
Keywords = {Reconfigurable Architecture; Interconnect Exploration; CGRA Mapping;
