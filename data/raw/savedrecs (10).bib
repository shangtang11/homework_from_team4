@inproceedings{ WOS:000454795600007,
Author = {Riedy, Jason and Demmel, James},
Book-Group-Author = {IEEE},
Title = {Augmented Arithmetic Operations Proposed for IEEE-754 2018},
Booktitle = {2018 IEEE 25TH SYMPOSIUM ON COMPUTER ARITHMETIC (ARITH)},
Series = {Proceedings Symposium on Computer Arithmetic},
Year = {2018},
Pages = {45-52},
Note = {25th International Symposium on Computer Arithmetic, Amherst, MA, JUN
   25-27, 2018},
Abstract = {Algorithms for extending arithmetic precision through compensated
   summation or arithmetics like double-double rely on operations commonly
   called twoSum and twoProduct. The current draft of the IEEE 754 standard
   specifies these operations under the names augmentedAddition and
   augmentedMultiplication. These operations were included after three
   decades of experience because of a motivating new use: bitwise
   reproducible arithmetic. Standardizing the operations provides a
   hardware acceleration target that can provide at least a 33\% speed
   improvements in reproducible dot product, placing reproducible dot
   product almost within a factor of two of common dot product. This paper
   provides history and motivation for standardizing these operations. We
   also define the operations, explain the rationale for all the specific
   choices, and provide parameterized test cases for new boundary
   behaviors.},
