@article{ WOS:001621647600008,
Author = {Hao, Jianshe and Xu, Yanbin and Yang, Chaofan and Guo, Rui and Lyu, Yang
   and Ji, Zhongying and Wang, Xiaolong},
Title = {3D printed hydrogel with fingerprint-inspired features for enhanced
   sensing performance in electronic skin},
Journal = {CHEMICAL ENGINEERING JOURNAL},
Year = {2025},
Volume = {525},
Month = {DEC 1},
Abstract = {Electronic skin has emerged as a prominent research focus due to its
   extensive applications in flexible sensing, intelligent human-machine
   interaction, and biomedical detection. Hydrogels, characterized by their
   high water content, excellent flexibility, and conductivity, exhibit
   significant potential in this domain. Systematic characterization
   revealed that the prepared hydrogels demonstrated outstanding
   comprehensive properties: a tensile strength of up to 2300 kPa, a
   fracture elongation rate of 1370 \%, and strong adhesion to substrates
   such as iron (50 kPa) and glass (42 kPa), with a gauge factor (GF)
   reaching 8.74. Inspired by the microstructure of human fingerprints,
   this study employed light-curing 3D printing technology to fabricate
   conductive hydrogels featuring biomimetic fingerprint microstructures.
   Following this, solvent exchange treatment was applied to establish a
   modulus gradient within the hydrogel network, transforming it from an
   initially homogeneous state into a final product with graded mechanical
   properties. This post-treatment step was crucial for achieving
   exceptional sensing capabilities. Compared to the original hydrogel, the
   treated hydrogel provided a more biomimetic and responsive interface for
   sensing applications while retaining excellent conductivity and
   mechanical properties at room temperature. The synergistic effect of the
   biomimetic fingerprint structures and the modulus gradient significantly
   enhanced material feature recognition, enabling hydrogel-based
   electronic skin to exhibit superior performance in tactile perception
   and biological signal monitoring. Through the combined strategy of
   microstructure modulation and post-treatment, this study achieved
   enhanced sensing performance and durability, offering new insights for
   the development of advanced flexible electronics and smart wearable
   devices.},
