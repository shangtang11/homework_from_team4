@inproceedings{ WOS:001304429500010,
Author = {Cao, Yasong and Wen, Mei and Shen, Junzhong and Li, Zhongxing},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {BitShare: An Efficient Precision-Scalable Accelerator with
   Combining-Like-Terms GEMM},
Booktitle = {2024 IEEE 35TH INTERNATIONAL CONFERENCE ON APPLICATION-SPECIFIC SYSTEMS,
   ARCHITECTURES AND PROCESSORS, ASAP 2024},
Series = {IEEE International Conference on Application-Specific Systems
   Architectures and Processors},
Year = {2024},
Pages = {36-44},
Note = {35th IEEE International Conference on Application-Specific Systems,
   Architectures and Processors (ASAP), City Univ Hong Kong, Dept Elect
   Engn, Hong Kong, HONG KONG, JUL 24-26, 2024},
Abstract = {Narrow-precision fixed-point (INT) computation is a significant approach
   for reducing memory requirements and enhancing the performance of
   accelerators for Deep Neural Networks (DNNs). Different DNNs, as well as
   different layers within the DNNs, may exhibit varying numerical
   distributions, necessitating INT formats with different minimum
   bit-widths. Therefore, DNN accelerators need to support multi-precision
   INT computations to strike a better balance between DNN inference
   accuracy and performance. However, existing precision-scalable
   accelerators face challenges such as low bandwidth utilization,
   insufficient utilization of computing resources across different
   precision modes, and complex circuit structures with associated
   overhead. In this paper, we propose (1) a hardware-friendly
   Combining-Like-Terms GEMM (CLT-GEMM) scheme that supports multiple
   computing modes of 2/4/8 bits and their combinations to align with the
   various bit-width settings of DNNs; (2) and subsequently design an
   efficient systolic accelerator with scalable precision, named BitShare,
   which features DataMap module and Multi-mode adder-tree-based
   accumulators. Compared to the state-of-the-art precision-scalable
   design, BitBlade, our accelerator achieves a 57.25\% reduction in
   bandwidth requirement and exhibits an improvement of 1.14x and 1.12x in
   area and power efficiency (2bx2b), respectively.},
Type = {Proceedings Paper},
Affiliation = {Wen, M (Corresponding Author), Natl Univ Def Technol, Coll Comp, Changsha, Peoples R China.
   Wen, Mei, Natl Univ Def Technol, Coll Comp, Changsha, Peoples R China.
   Key Lab Adv Microprocessor Chips \& Syst, Changsha, Peoples R China.},
DOI = {10.1109/ASAP61560.2024.00020},
Keywords = {configurable circuits; hardware accelerator; multiply-accumulate units;
   systolic array; GEMM},
Keywords-Plus = {DEEP NEURAL-NETWORKS; ARCHITECTURE; PROCESSOR},
Author-Email = {caoyasong@nudt.edu.cn
   meiwen@nudt.edu.cn
   shenjunzhong@nudt.edu.cn
   zhongxingli.cs@outlook.com},
Affiliations = {National University of Defense Technology - China},
