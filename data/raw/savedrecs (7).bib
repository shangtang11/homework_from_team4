@inproceedings{ WOS:000981940000112,
Author = {Parvin, Sajjad and Goli, Mehran and Torres, Frank Sill and Drechsler,
   Rolf},
Book-Group-Author = {IEEE},
Title = {Trojan-D2: Post-Layout Design and Detection of Stealthy Hardware Trojans
   - a RISC-V Case Study},
Booktitle = {2023 28TH ASIA AND SOUTH PACIFIC DESIGN AUTOMATION CONFERENCE, ASP-DAC},
Series = {Asia and South Pacific Design Automation Conference Proceedings},
Year = {2023},
Pages = {683-689},
Note = {28th Asia and South Pacific Design Automation Conference (ASP-DAC),
   Miraikan Natl Museum Emerging Sci \& Informat, Tokyo, JAPAN, JAN 16-19,
   2023},
Abstract = {With the exponential increase in the popularity of the RISC-V ecosystem,
   the security of this platform must be re-evaluated especially for
   mission-critical and IoT devices. Besides, the insertion of a Hardware
   Trojan (HT) into a chip after the in-house mask design is outsourced to
   a chip manufacturer abroad for fabrication is a significant source of
   concern. Though abundant HT detection methods have been investigated
   based on side-channel analysis, physical measurements, and functional
   testing to overcome this problem, there exists stealthy HTs that can
   hide from detection. This is due to the small overhead of such HTs
   compared to the whole circuit.
   In this work, we propose several novel HTs that can be placed into a
   RISC-V core's post-layout in an untrusted manufacturing environment.
   Next, we propose a non-invasive analytical method based on contactless
   optical probing to detect any stealthy HTs. Finally, we propose an
   open-source library of HTs that can be used to be placed into a
   processor unit in the post-layout phase. All the designs in this work
   are done using a commercial 28nm technology.},
Type = {Proceedings Paper},
Affiliation = {Parvin, S (Corresponding Author), Univ Bremen, Inst Comp Sci, Bremen, Germany.
