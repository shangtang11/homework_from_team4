@article{ WOS:001703590700001,
Author = {Yang, Xiaogang and Wei, Jinghe and Hu, Kai and Ding, Ke},
Title = {A Flash acceleration controller that supports redundant replacement},
Journal = {MICROELECTRONICS JOURNAL},
Year = {2026},
Volume = {171},
Month = {MAY},
Abstract = {In order to solve the problems of slow reading speed and low yield of
   embedded Flash in microcontroller, a Flash acceleration controller has
   been designed. This controller integrates adaptive regulation
   technology, dual-buffer prefetching technology, branch prediction
   technology, and read-back locking technology. These technologies can not
   only improve the read performance of Flash, but also reduce the overall
   power consumption. Test results show that the read performance of Flash
   has increased by 20\% to 30\%, and the overall power consumption has
   decreased by 15\%. In addition, a redundant replacement design for bad
   sectors of Flash was added. Through address mapping, bad sectors of
   Flash caused by manufacturing defects can be replaced, effectively
   solving the problem of low Flash yield and increasing the Flash yield by
   nearly 20\%.},
