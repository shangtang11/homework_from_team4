Title = {Survey of Chiplet Technology: SoC Architecture, Interconnect, EDA, and
   Advanced Packaging},
Journal = {IEEE JOURNAL ON EMERGING AND SELECTED TOPICS IN CIRCUITS AND SYSTEMS},
