@article{ WOS:001508499200001,
Author = {Cai, Shuo and Huang, Chao and Yu, Fei and Wang, Weizheng and Yin,
   Lairong},
Title = {Approximate multiplier design and error estimate model based on partial
   carry truncation},
Journal = {AEU-INTERNATIONAL JOURNAL OF ELECTRONICS AND COMMUNICATIONS},
Year = {2025},
Volume = {200},
Month = {OCT},
Abstract = {To tackle the issues of computational overhead and chip performance,
   approximate computing, an emerging paradigm, has become a focus of
   active research. As relatively intricate yet extensively-used
   computational units, multipliers play a pivotal role in fault-tolerant
   applications. In this paper, we propose an approximate multiplier design
   method based on partial carry truncation (PCT) and present two design
   strategies for the design of approximate 8 x 8 multipliers, which
   achieve high accuracy and low power consumption. Experimental results
   show significant performance improvements. The high-accuracy multiplier
   PCTM8 reduces the power and delay by 12.22\% and 24.39\%, respectively,
   compared to the exact multiplier. Furthermore, it introduces a mean
   error distance (MED) and mean relative error distance (MRED) of only
   3.78 and 0.0012, respectively. In contrast, the proposed low-power
   multiplier PCTM8-T8 reduces the in power and delay by 80.39\% and
   68.29\%, respectively, compared to the exact multiplier. Moreover, we
   introduce an error estimate model that fuses the PCT approach with
   probabilistic analysis. This model can be utilized to accurately and
   efficiently estimate an approximate multiplier's MED, thereby
   facilitating the development of fault-tolerant designs. In the image
   processing context, the PCTM8 demonstrates a peak signal-to-noise ratio
   (PSNR) of 54.19 dB and a structural similarity (SSIM) of 99.96\%, while
   PCTM8-T8's SSIM value exceeds 95\%.},
Type = {Article},
Affiliation = {Cai, S (Corresponding Author), Changsha Univ Sci \& Technol, Sch Comp \& Commun Engn, Changsha 410114, HN, Peoples R China.
