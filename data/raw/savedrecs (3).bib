@inproceedings{ WOS:001454351600073,
Author = {Pedada, Uday Kiran and Sharma, Tarun and Grover, Deepank and Deb, Sujay},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {An efficient RISC-V Vector Coprocessor for Heart Rate Variability
   Detection on Edge},
Booktitle = {2025 38TH INTERNATIONAL CONFERENCE ON VLSI DESIGN AND 2024 23RD
   INTERNATIONAL CONFERENCE ON EMBEDDED SYSTEMS, VLSID},
Series = {International Conference on VLSI Design},
Year = {2025},
Pages = {427-432},
Note = {38th International Conference on VLSI Design and International
   Conference on Embedded Systems, Bengaluru, INDIA, JAN 04-08, 2025},
Abstract = {Given the emergence of modern wearable devices, there is a need for
   devices with efficient, low-power processing capabilities to perform
   continuous health monitoring. Heart Rate Variability (HRV) is a crucial
   health parameter indicating cardiac health by measuring the time
   variation between heartbeats. Monitoring HRV continuously is challenging
   due to the need for efficient and low-power processing on edge devices.
   While conventional methods rely on general-purpose processors, these are
   not optimized for the specific needs of continuous HRV detection,
   especially in terms of power and area efficiency. This work addresses
   the issue by proposing an efficient vector coprocessor based on the
   open-source RISC-V Instruction Set Architecture (ISA) for HRV detection
   on edge devices. The vector coprocessor reduces power consumption and
   enhances performance by taking vector operations from the main
   processor. We also implement a vector-aware HRV calculation algorithm
   optimized for edge computing, which processes data in smaller chunks to
   fit the limited memory of edge devices. The proposed work shows an 80\%
   improvement in power density compared to the Ibex processor.},
