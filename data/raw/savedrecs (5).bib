@inproceedings{ WOS:001411695400017,
Author = {Karmakar, Praveen and Nauni, Divyanshu and Karfa, Chandan},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Analyzing Area and Latency Overhead in C and RTL Locked Designs},
Booktitle = {2023 IEEE ASIA PACIFIC CONFERENCE ON POSTGRADUATE RESEARCH IN
   MICROELECTRONICS AND ELECTRONICS, PRIMEASIA 2023},
Series = {Asia Pacific Conference on Postgraduate Research in Microelectronics and
   Electronics},
Year = {2024},
Pages = {35-39},
Note = {2023 Asia-Pacific Conference on Postgraduate Research in
   Microelectronics and Electronics, Hyderabad, INDIA, NOV 19-22, 2023},
Abstract = {Modern integrated circuit (IC) design hubs have adopted the fab-less
   design methodology for developing their System on Chips (SoCs). This
   allows for unreliable entities to operate at various IC supply chain
   nodes, posing security concerns such as IP piracy, counterfeiting, and
   overproduction of ICs. Logic locking is a widely accepted technique for
   securing modern IC designs against such threats. However, logic locking
   imposes additional resource constraints and introduces area and latency
   overhead in the original design, thereby affecting its efficiency and
   performance. This report analyses the area and latency overhead incurred
   when an original IC is locked at the behavioural level (C) and register
   transfer level (RTL). The design is locked to ensure uniform locking in
   both the C and RTL designs. Experimental results show that locking at
