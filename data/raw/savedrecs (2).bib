@article{ WOS:001566975200011,
Author = {Bazli, Mohammad and Es'Haghi, Siavash and Shahi, Mahmoud and Reza Naseh,
   Majid},
Title = {Reliability-Driven HLS Binding: A Simulated Annealing Approach to
   Minimize Aging and Process Variation in Digital Circuits},
Journal = {IEEE ACCESS},
Year = {2025},
Volume = {13},
Pages = {152103-152114},
Abstract = {The aggressive scaling of CMOS technology into the nanoscale regime has
   driven remarkable performance improvements. However, it has introduced
   significant reliability challenges due to stochastic aging and process
   variation (APV) effects, including Bias Temperature Instability (BTI)
   and manufacturing variations. These effects degrade circuit performance,
   increase timing violations, and reduce operational lifetimes, posing
   critical obstacles to reliable Very Large Scale Integration (VLSI)
   design. This study proposes a novel High-Level Synthesis (HLS) framework
   that integrates stochastic APV considerations into functional unit (FU)
   binding and port assignment. Utilizing a Random Forest (RF) machine
   learning model with 98.7-98.9\% accuracy to predict workload-induced APV
   effects, the framework employs Simulated Annealing (SA) optimization to
   concurrently minimize APV-induced degradation and interconnection costs
   while ensuring uniform degradation across FUs. Experimental results
   across benchmarks (MIPS, IDCT, FFT, and JPEG) show that the proposed
   method reduces APV intensity by up to 9.96\% compared to APV-unaware
   methods (e.g., LegUp) and by up to 3.19\% compared to APV aware weighted
   bipartite matching methods. Additionally, it improves circuit lifetime
   by an average of 34.22\% and 5.9\% compared with APV-unaware and aware
   methods, respectively, without area overhead. These advancements come
   with increased execution time overhead due to extensive design space
   exploration. This approach sets a new benchmark for reliability-aware
   HLS, offering a scalable and robust solution for designing resilient
   VLSI circuits in nanoscale technologies.},
Type = {Article},
Affiliation = {Es'Haghi, S (Corresponding Author), Islamic Azad Univ, Dept Elect \& Comp Engn, SRC, Tehran, Iran.
   Bazli, Mohammad; Reza Naseh, Majid, Islamic Azad Univ, Dept Engn, Bi C, Birjand, Iran.
