Title = {An MLA-LLM Hardware Acceleration with Tensor-Train Decomposition on
   Group Vector Systolic Accelerator},
Booktitle = {2025 IEEE 36TH INTERNATIONAL CONFERENCE ON APPLICATION-SPECIFIC SYSTEMS,
