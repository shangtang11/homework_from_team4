@article{ WOS:001590350800001,
Author = {Akram, Muhammad Shakeel and Varma, Bogaraju Sharatchandra and Javed,
   Aqib and Harkin, Jim and Finlay, Dewar},
Title = {Toward TinyDPFL systems for real-time cardiac healthcare: Trends,
   challenges, and system-level perspectives on AI algorithms, hardware,
   and edge intelligence},
Journal = {JOURNAL OF SYSTEMS ARCHITECTURE},
Year = {2025},
Volume = {168},
Month = {NOV},
Abstract = {Despite rapid advances in medical technology, cardiac diseases remain
   the leading cause of global mortality, with arrhythmias that pose
   significant diagnostic and treatment challenges. This survey presents a
   comprehensive review of 176 state-of-the-art contributions in machine
   learning (ML), federated learning (FL), TinyML, and hardware
   acceleration for efficient, real-time, and privacy-preserving cardiac
   diagnosis and care. Explores both software and hardware advancements,
   including differential privacy (DP), quantized neural networks, and FPGA
   (Field Programmable Gate Array)-based implementations optimized for edge
   devices and wearable devices. Key challenges, such as latency, energy
   constraints, adversarial robustness, and personalization, are
   systematically examined. The survey synthesizes solutions across
   algorithmic innovations, secure and adaptive FL frameworks, and
   neuromorphic and sparse architectures, especially FPGA-based solutions,
   for resource-aware inference and training. Informed by original
   research, it highlights emerging directions: AI-driven data mining, DP
   for quantized models, continual learning (CL) on the edge,
   FPGA-accelerators including quantized DNN, SNN, and Sparse
   architectures, tuneable/reconfigurable FPGA-based TinyDPFL, Multimodal
   heterogeneous FL, real-time adversarial detection via model
   watermarking. This work offers a unified system-level perspective
   bridging ML algorithms and edge AI hardware, guiding the development of
   scalable, adaptive, and trustworthy cardiac healthcare systems. Beyond
   surveying existing literature, it proposes forward-looking design
   principles to advance intelligent, secure, and practical digital
   cardiology.},
Type = {Article},
Affiliation = {Akram, MS (Corresponding Author), Ulster Univ, Sch Comp, York St, Belfast BT15 1ED, North Ireland.
   Akram, Muhammad Shakeel; Varma, Bogaraju Sharatchandra; Finlay, Dewar, Ulster Univ, Sch Comp, York St, Belfast BT15 1ED, North Ireland.
   Javed, Aqib; Harkin, Jim, Ulster Univ, Sch Comp Engn \& Intel Sys, Northland Rd, Londonderry BT48 7JL, North Ireland.},
DOI = {10.1016/j.sysarc.2025.103587},
EarlyAccessDate = {OCT 2025},
Article-Number = {103587},
Keywords = {Cardiac diseases; Diagnosis and treatment; Machine learning; Federated
   learning; TinyML; Hardware accelerators; FPGA; Differential privacy},
Keywords-Plus = {CONGESTIVE-HEART-FAILURE; PAROXYSMAL ATRIAL-FIBRILLATION; CONVOLUTIONAL
   NEURAL-NETWORK; AUTOMATED DETECTION; WAVELET TRANSFORM; CLASSIFICATION;
   DIAGNOSIS; ACCELERATOR; LEADLESS; ARRHYTHMIAS},
Author-Email = {akram-ms@ulster.ac.uk},
Affiliations = {Ulster University; Ulster University},
