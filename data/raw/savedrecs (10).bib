@inproceedings{ WOS:000674473500006,
Author = {Feree, Hugo and Pohjola, Johannes Aman and Kumar, Ramana and Owens,
   Scott and Myreen, Magnus O. and Ho, Son},
Editor = {Piskac, R and Rummer, P},
Title = {Program Verification in the Presence of I/O Semantics, Verified Library
   Routines, and Verified Applications},
Booktitle = {VERIFIED SOFTWARE: THEORIES, TOOLS, AND EXPERIMENTS, (VSTTE 2018)},
Series = {Lecture Notes in Computer Science},
Year = {2018},
Volume = {11294},
Pages = {88-111},
Note = {10th International Working Conference on Verified Software - Theories,
   Tools, and Experiments (VSTTE) held as Part of the Federated Logic
   Conference (FLoC), Oxford, ENGLAND, JUL 18-19, 2018},
Abstract = {Software verification tools that build machine-checked proofs of
   functional correctness usually focus on the algorithmic content of the
   code. Their proofs are not grounded in a formal semantic model of the
   environment that the program runs in, or the program's interaction with
   that environment. As a result, several layers of translation and wrapper
   code must be trusted. In contrast, the CakeML project focuses on
   end-to-end verification to replace this trusted code with verified code
   in a cost-effective manner.
   In this paper, we present infrastructure for developing and verifying
   impure functional programs with I/O and imperative file handling.
   Specifically, we extend CakeML with a low-level model of file I/O, and
   verify a high-level file I/O library in terms of the model. We use this
   library to develop and verify several Unix-style command-line utilities:
   cat, sort, grep, diff and patch. The workflow we present is built around
   the HOL4 theorem prover, and therefore all our results have
   machine-checked proofs.},
