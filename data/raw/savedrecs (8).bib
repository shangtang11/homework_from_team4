@article{ WOS:000742697800001,
Author = {Spetalnick, Samuel and Raychowdhury, Arijit},
Title = {A Practical Design-Space Analysis of Compute-in-Memory With SRAM},
Journal = {IEEE TRANSACTIONS ON CIRCUITS AND SYSTEMS I-REGULAR PAPERS},
Year = {2022},
Volume = {69},
Number = {4},
Pages = {1466-1479},
Month = {APR},
Abstract = {Analog-domain compute-in-memory (CIM) is a technique that has emerged in
   part as a response to the memory-intensive vector-matrix-multiplications
   (VMMs) required to implement important emerging applications, notably
   machine learning inference. Implemented CIM systems have demonstrated
   good energy efficiency for lower-precision systems and/or with loosened
   compute-level accuracy requirements. A priori it is unclear exactly how
   the efficiency advantages of CIM emerge and therefore the
   generalizability of these advantages, beyond the specific demonstrated
   examples, is unclear. Noting that not all VMM-heavy workloads can
   tolerate imperfect accuracy and/or reduced precision, this work combines
   high-level models with circuit models and simulations to examine the
   efficiency gains and penalties associated with CIM in static
   random-access memory (SRAM) arrays. Extracted models which are needed to
   make assertive statements about CIM are developed and discussed. An
   energy comparison to standard SRAM is made, and the issues of accuracy
   loss and area are contextualized. Finally, a few example models
   comparing the energy efficiency of CIM to that of SRAM are shown to
   verify that CIM is most effective for error-tolerant, low-precision
   applications.},
Type = {Article},
Affiliation = {Spetalnick, S (Corresponding Author), Georgia Inst Technol, Dept Elect \& Comp Engn, Atlanta, GA 30332 USA.
   Spetalnick, Samuel; Raychowdhury, Arijit, Georgia Inst Technol, Dept Elect \& Comp Engn, Atlanta, GA 30332 USA.},
