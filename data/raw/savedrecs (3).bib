@inproceedings{ WOS:001476945200151,
Author = {Tanaka, Tomonari and Uezono, Takumi and Suenaga, Kohei and Hashimoto,
   Masanori},
Book-Group-Author = {ACM},
Title = {Hardware Error Detection with In-Situ Monitoring of Control Flow-Related
   Specifications},
Booktitle = {30TH ASIA AND SOUTH PACIFIC DESIGN AUTOMATION CONFERENCE, ASP-DAC 2025},
Series = {Asia and South Pacific Design Automation Conference Proceedings},
Year = {2025},
Pages = {966-973},
Note = {30th Asia and South Pacific Design Automation Conference-ASP-DAC-Annual,
   ACM SIGDA, Tokyo, JAPAN, JAN 20-23, 2025},
Abstract = {In hardware accelerators used in data centers and safety-critical
   applications, soft errors and resultant silent data corruption
   significantly compromise reliability, particularly when upsets occur in
   control-flow operations, leading to severe failures. To address this, we
   introduce a method for monitoring control flow-related specifications
   using Petri nets. We validated our method across three designs:
   convolutional layers in LeNet-5, Gaussian blur in Canny edge detection,
   and AES encryption. Our fault injection campaign targeting the control
   registers and primary control inputs demonstrated high error detection
   rates in both datapath and control logic. Synthesis results show that a
   maximum detection rate is achieved with a few to around 10 \% area
   overhead in most cases. The proposed detectors quickly detect 88.0\% to
   99.9\% of failures resulting from upsets in internal control registers
   and perturbation in primary control inputs.},
Type = {Proceedings Paper},
Affiliation = {Tanaka, T (Corresponding Author), Kyoto Univ, Kyoto, Japan.
   Tanaka, Tomonari; Suenaga, Kohei; Hashimoto, Masanori, Kyoto Univ, Kyoto, Japan.
   Uezono, Takumi, Hitachi Ltd, Yokohama, Kanagawa, Japan.},
