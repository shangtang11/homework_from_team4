@article{ WOS:001706999100001,
Author = {Zhao, Shilei and Song, Jiafeng and Zheng, Jiwen and Chen, Zhengyu and
   Liu, Zhiwei and Huang, Hai},
Title = {High performance mixed-radix NTT design for post quantum cryptography},
Journal = {INTEGRATION-THE VLSI JOURNAL},
Year = {2026},
Volume = {109},
Month = {JUL},
Abstract = {The rapid advancement of quantum computers motivates the transition to
   Post-Quantum Cryptography (PQC). Lattice-Based Cryptography (LBC) has
   emerged as a prominent candidate, but its hardware implementation is
   challenging due to the high computational cost of large-degree
   polynomial multiplication. The Number Theoretic Transform (NTT) is
   critical for accelerating these operations. This paper proposes a novel
   mixed-radix NTT/INTT algorithm and a unified high-performance hardware
   architecture. Specifically, the proposed design minimizes overhead by
   reusing diagonal butterfly units for radix-4/2 operations. Furthermore,
   a Configurable Modular Multiplier (CMM) shares resources between
   Plantard and Barrett algorithms to resolve speed mismatches. Finally, a
   conflict-free memory access scheme efficiently schedules dataflow
   without incurring additional hardware costs. Implemented on a Xilinx
   Virtex-7 FPGA, our design demonstrates significant resource efficiency,
   achieving an Area-Time Product (ATP) improvement of 1.32 \& times; -1.72
   \& times; over state-of-the-art works.},
Type = {Article},
Affiliation = {Huang, H (Corresponding Author), Harbin Univ Sci \& Technol, Harbin, Peoples R China.
