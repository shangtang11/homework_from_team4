Abstract = {Federated Learning (FL) faces fundamental limitations in mobile
   environments where client mobility introduces dynamic connectivity and
   resource fluctuations. Traditional FL frameworks assume static
   participants, leading to suboptimal model convergence and resource waste
   when applied to real-world scenarios like vehicular networks or drone
   swarms. This research investigates the integration of mobility patterns
   into FL client orchestration, proposing a novel paradigm that
   prioritises reliability and efficiency. We explore predictive client
   selection, resource-aware optimisation, and stability guarantees under
   mobility dynamics. Preliminary experiments highlight the potential of
   mobility-driven strategies to improve model accuracy while reducing
   bandwidth waste as compared to static approaches. The work aims to
   address critical open questions in FL scalability for next-generation
   edge ecosystems.},
Type = {Proceedings Paper},
Affiliation = {Wang, QY (Corresponding Author), Univ Glasgow, Sch Comp Sci, Glasgow, Lanark, Scotland.
   Wang, Qiyuan; Anagnostopoulos, Christos, Univ Glasgow, Sch Comp Sci, Glasgow, Lanark, Scotland.},
