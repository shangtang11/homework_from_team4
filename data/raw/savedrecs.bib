@article{ WOS:001706400700018,
Author = {Park, Hyeong-Jun and Trung Ngo, Chi and Lee, Myeong-Hun and Hong,
   Jong-Phil},
Title = {Parameter Optimization Method for Improving the Reliability of the NIST
   SP 800-22 Test Suite in TRNG Verification},
Journal = {IEEE ACCESS},
Year = {2026},
Volume = {14},
Pages = {31159-31173},
Abstract = {The NIST SP 800-22 test suite serves as the benchmark for Random Number
   Generator (RNG) evaluation, yet default parameters frequently induce
   Type I errors due to approximation inaccuracies and Level-1 statistic
   sensitivity. This paper presents a systematic parameter optimization
   methodology designed to mitigate structural false rejections in the
   Frequency, Cumulative Sums, and Non-overlapping Template Matching tests.
   Analytical pass thresholds for the Frequency and Cumulative Sums tests
   are derived and aligned with statistically modeled maximum values to
   identify stable pass regions ( \$n\$ ). For the Non-overlapping Template
   Matching test, a parameter sweep based on sensitivity analysis is
   employed to determine the optimal ( \$n, N\$ ) set, effectively
   resolving hypersensitivity to strict decision boundaries. Experimental
   verification using a 28 nm CSRO-based TRNG demonstrates that these
   optimized parameters achieve a 100\% pass rate across all chips, a
   significant improvement over the 72\% minimum pass rate observed with
   default settings. These results confirm that the proposed optimization
   effectively eliminates structural Type I errors without compromising
   test sensitivity, providing a generalizable framework for
   hardware-specific entropy verification.},
Type = {Article},
Affiliation = {Hong, JP (Corresponding Author), Chungbuk Natl Univ, Sch Elect Engn, Cheongju 28644, South Korea.
   Park, Hyeong-Jun; Trung Ngo, Chi; Lee, Myeong-Hun; Hong, Jong-Phil, Chungbuk Natl Univ, Sch Elect Engn, Cheongju 28644, South Korea.},
DOI = {10.1109/ACCESS.2026.3667853},
Keywords = {NIST; Reliability; Binary sequences; Optimization methods; Semiconductor
   device measurement; Entropy; Systematics; Generators; Photonics;
   Hardware; NIST SP 800-22; TRNG; type I error mitigation; verification
