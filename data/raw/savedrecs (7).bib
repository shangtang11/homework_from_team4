@inproceedings{ WOS:001191294100003,
Author = {Gorodecky, Danila and Sousa, Leonel},
Book-Group-Author = {IEEE Comp Soc},
Title = {Scalable architecture of constant division on FPGA},
Booktitle = {2023 IEEE 30TH SYMPOSIUM ON COMPUTER ARITHMETIC, ARITH 2023},
Series = {Proceedings Symposium on Computer Arithmetic},
Year = {2023},
Pages = {16-23},
Note = {30th IEEE Symposium on Computer Arithmetic (ARITH), Portland, OR, SEP
   04-06, 2023},
Abstract = {This paper proposes a method for hardware integer division by a
   constant, based only on combinational logic, i.e. without requiring
   storage and feedback in calculations. The proposed scheme for division
   consists of adders and encoders, where encoders are systems of Boolean
   functions. The proposed divisor provides at the output the quotient and
   the residue (at the same time or separately). Experiments conducted on
   FPGA demonstrate up to three times improvement in area cost compare to
   the optimized divisor circuits provided by the Xilinx tools, while the
   delay is improved by 25\% for dividends with less than 48-bit. It is
   also shown in this paper that the proposed approach is scalable, and in
   comparison to the state-of-the-art, the proposed approach improves the
   area or the delay, or both for many constant values and input bit sizes.},
