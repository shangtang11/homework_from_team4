@article{ WOS:001706087200001,
Author = {Zou, Dikai and Tao, Jun and Li, Ruijie and Zhou, Kecheng and Wu, Haotian},
Title = {SpringFuzz: Comprehensive grey-box fuzzing of spring-based web
   applications},
Journal = {COMPUTERS \& SECURITY},
Year = {2026},
Volume = {165},
Month = {JUN},
Abstract = {Java web applications play a vital role in modern digital
   infrastructure, making them a prime target for cyber attacks. As a
   widely adopted security assessment technique, grey-box fuzzing has
   become a crucial tool for uncovering software vulnerabilities. However,
   applying it to Java web applications presents inherent challenges,
   primarily due to heterogeneous program entry points, cross-request state
   persistence, and input semantics validation. Although prior work has
   proposed solutions to these issues, limitations still remain in terms of
   fuzzing efficiency and comprehensiveness. To fill these gaps, we present
   SpringFuzz, a grey-box fuzzer tailored to web applications based on the
   Java Spring framework. SpringFuzz employs introspection of routing
   metadata to perform precise web-entry recognition, reconstructing
   endpoint templates and constraints. Building on this, it analyzes
   persistence precedence by leveraging URL semantics alongside taint-based
   propagation analysis. Additionally, curated vulnerability payloads are
   integrated into mutation, scheduling, and feedback operations, enabling
   more efficient vulnerability discovery. Our evaluation on six real-world
   Spring targets with 50 curated vulnerabilities shows that SpringFuzz
   significantly outperforms existing tools, improving edge coverage by
   190.0\%, 87.9\%, and 22.6\% compared to Jazzer, Witcher, and EvoMaster,
   respectively. Furthermore, it achieves a 62.9\% average recall for
   vulnerability reproduction at a markedly reduced time-to-exposure. The
