@article{ WOS:001492659900001,
Author = {Yang, Xiaofeng and Chen, Qian and Zheng, Hongshun and Liu, Hongxiang and
   Lu, Shengli},
Title = {CTSNet: Collaborative temporal-spatial net with dual-branch
   cross-attention for dynamic IR drop prediction},
Journal = {INTEGRATION-THE VLSI JOURNAL},
Year = {2025},
Volume = {103},
Month = {JUL},
Abstract = {Accurate prediction of dynamic IR drop is vital in the signoff stage of
   integrated circuit (IC) design automation to prevent functional
   failures. Recent advances in neural network methodologies have shown
   promise for rapid computation in system-on-chip (SoC) voltage drop
   prediction. However, existing approaches fall short due to simplistic
   feature extraction methods that treat temporal and spatial data
   uniformly. To overcome this limitation, we propose CTSNet, a novel SoC
   voltage drop prediction model using a dual-encoder-single-decoder
   architecture for temporal-spatial collaborative learning. Specifically,
   we introduce a temporal-spatial dual encoder structure for temporal
   feature extraction and a temporal-spatial attention fusion module to
   integrate features from both temporal and spatial branches, enhancing
   the model's ability to capture intrinsic semantics across data types.
   Experimental validation on the CircuitNet dataset demonstrates CTSNet's
   superiority over state-of-the-art methods, achieving a 5.2\% reduction
   in normalized mean absolute error (NMAE), a 4.1\% improvement in
   F1-Score, and an 79\% reduction in average inference time.},
