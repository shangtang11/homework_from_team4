@inproceedings{ WOS:001506972600328,
Author = {Alam, Shamiul and Aziz, Ahmedullah},
Book-Group-Author = {IEEE},
Title = {Ferroelectric-Superconducting Synergy for Future Computing},
Booktitle = {2025 DESIGN, AUTOMATION \& TEST IN EUROPE CONFERENCE, DATE},
Series = {Design Automation and Test in Europe Conference and Exhibition},
Year = {2025},
Note = {2025 Design, Automation \& Test in Europe Conference-DATE, Lyon, FRANCE,
   MAR 31-APR 02, 2025},
Abstract = {Ferroelectric Superconducting Quantum Interference Devices (Fe-SQUIDs)
   have recently gained attention as a transformative technology for
   superconducting computing, offering voltage-controlled switching that is
   essential for large-scale digital circuits. This unique technology has
   the potential to drive advancements in cryogenic computing by enabling
   scalable memory systems and voltage-controlled logic circuits. These
   innovations are critical for the realization of large-scale quantum
   computers and hold significant promise for high-performance computing
   and space exploration. In this article, we explore how Fe-SQUIDs,
   integrated with heater cryotrons (hTrons), can be harnessed to develop
   key components of computing systems. These include non-volatile memory,
   voltage-controlled logic circuits, in-memory matrix-vector
   multiplication systems, and ternary content-addressable memory. We also
   examine how changes in the key characteristics of Fe-SQUIDs and hTrons
   influence the performance of these applications, providing insights into
   the design and optimization of next-generation superconducting hardware.},
Type = {Proceedings Paper},
Affiliation = {Alam, S (Corresponding Author), Univ Tennessee, Dept Elect Engn \& Comp Sci, Knoxville, TN 37996 USA.
