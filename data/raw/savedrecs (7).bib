@inproceedings{ WOS:001073487300202,
Author = {Huang, Bo-Yuan and Zhang, Hongce and Gupta, Aarti and Malik, Sharad},
Book-Group-Author = {IEEE},
Title = {INVITED: Generalizing the ISA to the ILA: A Software/Hardware Interface
   for Accelerator-rich Platforms},
Booktitle = {2023 60TH ACM/IEEE DESIGN AUTOMATION CONFERENCE, DAC},
Year = {2023},
Note = {60th ACM/IEEE Design Automation Conference (DAC), San Francisco, CA, JUL
   09-13, 2023},
Abstract = {This paper presents the Instruction-Level Abstraction (ILA) as a formal
   software/hardware interface for accelerator-rich platforms. The ILA
   provides a common framework for formal functional specification of
   processors and accelerator behavior, verifying their implementations,
   and reasoning about software-hardware interactions of programs with
   accelerators. The ILA-MCM specification extends the ILA to enable
   reasoning about interactions of accelerators with other compute engines
   through shared memory. The 3LA compilation flow for accelerators uses
   the ILA model to bridge the gap between fine-grain compiler intrinsics
   and coarse-grain accelerator operations.},
Type = {Proceedings Paper},
Affiliation = {Huang, BY (Corresponding Author), Intel Corp, Baltimore, MD 21208 USA.
   Huang, Bo-Yuan, Intel Corp, Baltimore, MD 21208 USA.
   Zhang, Hongce, Hong Kong Univ Sci \& Technol, Guangzhou, Peoples R China.
