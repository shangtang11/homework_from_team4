   Myoren, Hiroaki, Saitama Univ, Saitama 3388570, Japan.},
DOI = {10.1587/transele.2020SUP0001},
Keywords = {superconducting fabrication technology; Nb/AlOx/Nb Joseph-son junction;
   caldera planarization; multi-layer structure; single-flux quantum logic;
