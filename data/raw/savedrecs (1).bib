@article{ WOS:001508164400001,
Author = {Shin, Dongarm and Ji, Youngwoo and Cho, Seonghwan and Jang, Taekwang},
Title = {Energy-Efficient Data Transmitters Achieving Energy Per Bit Beyond
   CV2 Limitation},
Journal = {IEEE TRANSACTIONS ON CIRCUITS AND SYSTEMS I-REGULAR PAPERS},
Year = {2025},
Volume = {72},
Number = {12},
Pages = {7693-7706},
Month = {DEC},
Abstract = {This article presents adiabatic data transmitters using stepwise driving
   to improve the energy efficiency of low data-rate sensor nodes beyond
   the CV2 limitation. Stepwise driving is applied to NRZ and PAM-4
   modulations, supporting data rates of hundreds of Mb/s, required by
   micro-controller peripheral I/O interfaces in sensor nodes. Fabricated
   in 22nm CMOS, the proposed transmitter drivers achieve over 64\% energy
   savings at 200 Mb/s compared to conventional CV2 drivers.},
Type = {Article},
Affiliation = {Jang, T (Corresponding Author), Dept Informat Technol \& Elect Engn, CH-8092 Zurich, Switzerland.
   Shin, Dongarm; Cho, Seonghwan, Korea Adv Inst Sci \& Technol, Daejeon 34141, South Korea.
