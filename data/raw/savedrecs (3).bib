@inproceedings{ WOS:001684940200121,
Author = {Shrestha, Pratik and Savidis, Ioannis},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Representation Learning for Digital Integrated Circuit Design Automation},
Booktitle = {2025 IEEE 43RD INTERNATIONAL CONFERENCE ON COMPUTER DESIGN, ICCD},
Series = {Proceedings IEEE International Conference on Computer Design},
Year = {2025},
Pages = {867-871},
Note = {43rd International Conference on Computer Design-ICCD-Annual,
   Richardson, TX, NOV 10-12, 2025},
Abstract = {Representation learning has become an effective technique utilized by
   electronic design automation (EDA) algorithms. By addressing challenges
   related to the increasing complexity of circuits and the corresponding
   stringent power, performance, and area (PPA) requirements,
   representation learning facilitates the automatic extraction of
   meaningful features from complex data formats, including images, grids,
   and graphs. In this paper, the application of representation learning to
   digital IC design automation is explored with an analysis of prior work
   on foundational concepts and case studies on tasks that include timing
   prediction and routability analysis. Key techniques, including
   image-based methods, graph-based approaches, and hybrid multimodal
   solutions, are described that highlight the improvements provided in
   routing and timing prediction. The provided advancements demonstrate the
   potential of representation learning to enhance efficiency, accuracy,
   and scalability in current integrated circuit design flows.},
