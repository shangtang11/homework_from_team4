@inproceedings{ WOS:001267265700014,
Author = {Ranawaka, Piyumal and Azhar, Muhammad Waqar and Stenstrom, Per},
Book-Group-Author = {ACM},
Title = {DNNOPT: A Framework for Efficiently Selecting On-chip Memory Loop
   Optimizations of DNN Accelerators},
Booktitle = {PROCEEDINGS OF THE 21ST ACM INTERNATIONAL CONFERENCE ON COMPUTING
   FRONTIERS 2024, CF 2024},
Year = {2024},
Pages = {126-137},
Note = {21st ACM International Conference on Computing Frontiers (CF), Ischia,
   ITALY, MAY 07-09, 2024},
Abstract = {Deep neural network (DNN) accelerators suffer from poor utilization of
   on-chip memory which potentially reduces performance and energy
   efficiency. Loop reordering and blocking are used to improve on-chip
   memory utilization in DNN accelerators. However, existing optimization
   frameworks are inefficient due to either a prohibitive time complexity
   of searching the entire search space or due to a sub-optimal choice of
   optimizations.
   This paper proposes DNNOPT - a hardware/software framework for optimally
   selecting loop order and blocking factors, for loop reordering and
   blocking in isolation or in combination. DNNOPT uses proposed Early exit
   and Strided search strategies to prune the search space and simple
   analytical models of data reuse to evaluate each optimization point
   efficiently and accurately. Overall, DNNOPT reduces the search space by
   more than two orders of magnitude and improves performance, energy
   efficiency and time to solution, on average, by 1.8x, 50\%, and 226x,
   respectively, of convolutional neural network (CNN) and Transformer
   applications compared to state-of-the-art frameworks.},
Type = {Proceedings Paper},
Affiliation = {Ranawaka, P (Corresponding Author), Chalmers Univ Technol, Gothenburg, Sweden.
   Ranawaka, Piyumal; Azhar, Muhammad Waqar; Stenstrom, Per, Chalmers Univ Technol, Gothenburg, Sweden.},
