@article{ WOS:001677148800001,
Author = {Shin, Jaewon and Hamada, Mototsugu and Kosuge, Atsutake},
Title = {A Connectivity-Aware Via-Programmable DNN Processor Using a Single
   Photomask},
Journal = {IEEE OPEN JOURNAL OF CIRCUITS AND SYSTEMS},
Year = {2026},
Volume = {7},
Pages = {11-20},
Abstract = {This paper presents a via-programmable DNN processor architecture, the
   Via-Programmable Neuron Array (VPNA), designed for low-NRE and low-power
   AIoT applications. To enable shared base-chip layouts across diverse
   workloads, a connectivity-aware design ensures tile-to-tile routing
   under a column-wise placement rule. A \$6\{\textbackslash{}times \}6\$
   programmable-wire structure supports task-specific data paths, and
   via-based ternary-weight mapping allows multiple tasks to reuse the same
   base chip with a single via mask. A unified bit-serial neuron circuit
   supports convolution and pooling operations under both neuron-serial and
   neuron-parallel modes, completing the functional implementation required
   for one-dimensional time-series DNNs. Post-layout evaluations in a 40 nm
   CMOS process demonstrate sub-milliwatt power consumption and sufficient
   inference accuracy across representative AIoT tasks, including keyword
   spotting, ECG arrhythmia detection, and EEG seizure detection. Compared
   with prior FPGA- and ASIC-based accelerators, the proposed architecture
   achieves a better trade-off among low power, low NRE cost, and
   task-level flexibility, highlighting its potential as a scalable
   foundation for future ultra-low-NRE and field-programmable AIoT
   processors.},
Type = {Article},
Affiliation = {Shin, J (Corresponding Author), Univ Tokyo, Grad Sch Engn, Tokyo 1138656, Japan.
   Shin, Jaewon; Hamada, Mototsugu; Kosuge, Atsutake, Univ Tokyo, Grad Sch Engn, Tokyo 1138656, Japan.},
