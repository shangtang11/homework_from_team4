@article{ WOS:000766553500001,
Author = {Langehaug, Tor J. and Graham, Scott R. and Kabban, Christine M. Schubert
   and Borghetti, Brett J.},
Title = {MADFAM: MicroArchitectural Data Framework and Methodology},
Journal = {IEEE ACCESS},
Year = {2022},
Volume = {10},
Pages = {23511-23531},
Abstract = {In the aftermath of Spectre and Meltdown researchers have proposed a
   variety of attack detection solutions by applying machine learning to
   data collected from hardware performance monitoring units. Although many
   microarchitectural attack detection systems provide high-accuracy
   detection results, the behavior of the underlying data collection
   mechanisms is not well described or understood. This research introduces
   the MicroArchitectural Data Framework And Methodology (MADFAM) to
   prescribe a systematic approach to collecting and preserving the
   information available in sequences of microarchitectural data. The
   proposed framework focuses on hardware performance counters (HPCs) as
   the primary data source. HPC configuration is complex, which makes it
   difficult for others to reproduce results or advance the
   state-of-the-art. This framework includes a description of design
   decisions that HPC research must consider across an array of problem
   domains, including information security. MADFAM proposes a data
   collection architecture and evaluation criteria to improve the
   discussion about the experimental settings and design decisions used in
   HPC research. The proposed framework evaluation criteria are then used
   to establish a baseline characterization of time series data that future
   research can use to compare alternative framework implementations.},
Type = {Article},
Affiliation = {Langehaug, TJ (Corresponding Author), Air Force Inst Technol, Grad Sch Engn \& Management, Wright Patterson AFB, OH 45433 USA.
   Langehaug, Tor J.; Graham, Scott R.; Kabban, Christine M. Schubert; Borghetti, Brett J., Air Force Inst Technol, Grad Sch Engn \& Management, Wright Patterson AFB, OH 45433 USA.},
