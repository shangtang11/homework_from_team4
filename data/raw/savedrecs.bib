@article{ WOS:001700579700001,
Author = {Shao, Zexiong and Che, Le and Yu, Zhuliang},
Title = {Adaptive Full-Scale Frequency Filters based Dual-Granularity Interaction
   Network for Motor Imagery/Motor Execution-Electroencephalogram decoding},
Journal = {BIOMEDICAL SIGNAL PROCESSING AND CONTROL},
Year = {2026},
Volume = {119},
Number = {B},
Month = {JUN 15},
Abstract = {Capturing global and local temporal patterns in a complete and
   systematic manner is critical for enhancing the performance of decoding
   algorithms for motor imagery (MI)/motor execution
   (ME)-electroencephalogram (EEG) signals. However, current multi-scale
   convolutional neural network (CNN), constrained by fixed receptive field
   filters, may overlook important local scales and often neglect the
   extraction of global temporal patterns. Moreover, Transformer, due to
   their inherently parameter-inefficient nature and susceptibility to
   noise, struggle to achieve performance improvements on MI/ME datasets
   with limited data. In addition, their overall architectural design is
   flawed, as Transformer typically process incomplete signals and ignore
   the potential complementary correlations between global and local
   temporal patterns. To address these issues, we propose
   Frequency-Decoupling based Dual-Granularity Interaction Network
   (FDDGINet). FDDGINet first leverages complex-valued neural network
   (CVNN)-inspired full-scale frequency filters to concurrently capture
   both global and local temporal features in a parameter-efficient manner,
   while fully preserving global temporal information. It then maps the
   feature representations into a richer latent space using spatio-temporal
   convolution, and further encodes the complementary correlations between
   the global and local temporal features via a dual-axis attention
   mechanism. Guided by these complementary correlations, the two types of
   features mutually supplement each other before being fused for final
   classification. FDDGINet achieves impressive decoding performance on
   three representative MI/ME datasets, surpassing all current
   state-of-theart (SOTA) methods. These results highlight the tremendous
   potential of FDDGINet in MI/ME-EEG decoding and offer a novel pathway
   for exploring CVNN-based MI/ME-EEG frequency domain analysis and
   inter-scale information interaction.},
Type = {Article},
Affiliation = {Yu, ZL (Corresponding Author), South China Univ Technol, Sch Automat Sci \& Engn, Guangzhou 510641, Guangdong, Peoples R China.
   Shao, Zexiong; Yu, Zhuliang, South China Univ Technol, Sch Automat Sci \& Engn, Guangzhou 510641, Guangdong, Peoples R China.
   Shao, Zexiong, Inst Super Robot Huangpu, Guangzhou 510700, Guangdong, Peoples R China.
   Che, Le, South China Univ Technol, Sch Architecture, Guangzhou 510641, Guangdong, Peoples R China.
   Yu, Zhuliang, South China Univ Technol, Shien Ming Wu Sch Intelligent Engn, Guangzhou 511442, Guangdong, Peoples R China.},
DOI = {10.1016/j.bspc.2026.109895},
EarlyAccessDate = {FEB 2026},
Article-Number = {109895},
Keywords = {Brain-Computer Interface (BCI); Electroencephalogram (EEG); Motor
   Imagery/Motor Execution (MI/ME); Frequency filters; Dual-axis attention
   mechanism},
Keywords-Plus = {CONVOLUTIONAL NEURAL-NETWORK; TRANSFORMER; FUSION},
Author-Email = {auszx@mail.scut.edu.cn
