@inproceedings{ WOS:001480909600084,
Author = {Chen, Po Hao and Bali, Akshaya and Yang, Shining and Haghi, Pouya and
   Knox, Carlton and Li, Benjamin and Abouelmagd, Amr Akmal and Skjellum,
   Anthony and Herbordt, Martin},
Book-Group-Author = {IEEE},
Title = {Cycle-Stealing in Load-Imbalanced HPC Applications},
Booktitle = {2024 IEEE HIGH PERFORMANCE EXTREME COMPUTING CONFERENCE, HPEC},
Series = {IEEE High Performance Extreme Computing Conference},
Year = {2024},
Note = {2024 Conference on High Performance Extreme Computing-HPEC-Annual,
   ELECTR NETWORK, SEP 23-27, 2024},
Abstract = {It is practical to steal cycles when Message Passing Interface (MPI)
   programs are load imbalanced, either from natural algorithmic load,
   because of collective communication and/or process skew, and/or because
   of variable message loads and needs for message progress within the MPI
   implementation. We introduce TIMELORD, a runtime library to provide
   fungibility for compute-cycles without significantly degrading the
   nominal performance of the parallel application. We propose three means
   to exploit wasted cycles in LAMMPS, miniFE, and miniAMR. The results
   show, on average, 40\% of the runtime can be used to execute extra
   computations and that runtime overheads are less than 4\%. We envisage
   that these extra computations be related to the target application;
   here, for simplicity and proof-of-concept, we assume arbitrary commodity
   applications. Additionally, TIMELORD uncovers inefficiencies in the MPI
   progress engine and improves baseline performance. We explore some
   fundamental issues of load imbalance and its interaction with system
   software, including the predictability of extra time and the relative
   benefits of prediction versus preemption. TIMELORD requires no changes
   to the MPI application, MPI implementation, or other system components.},
Type = {Proceedings Paper},
Affiliation = {Chen, PH (Corresponding Author), Boston Univ, ECE Dept, Boston, MA 02215 USA.
   Chen, Po Hao; Bali, Akshaya; Yang, Shining; Haghi, Pouya; Knox, Carlton; Li, Benjamin; Herbordt, Martin, Boston Univ, ECE Dept, Boston, MA 02215 USA.
