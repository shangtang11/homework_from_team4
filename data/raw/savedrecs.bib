@article{ WOS:001698988600001,
Author = {Dib, Omar},
Title = {Blockchain-enabled defenses in federated learning: A comprehensive
   survey},
Journal = {COMPUTER SCIENCE REVIEW},
Year = {2026},
Volume = {61},
Month = {AUG},
Abstract = {Federated Learning (FL) enables multiple clients to collaboratively
   train machine learning models without sharing raw data, offering
   significant privacy benefits. However, FL is inherently vulnerable to
   various security and pri vacy attacks, including model poisoning,
   backdoors, Sybil attacks, and inference attacks. Blockchain has emerged
   as a promising enabler for securing FL due to its decentralized,
   immutable, and auditable nature. This survey of fers a comprehensive
   tutorial and review of blockchain-enabled defenses in FL, presenting a
   detailed taxonomy of defense mechanisms categorized by objectives,
   including incentive and reputation-based defenses, verification and
   audit-based mechanisms, privacy-preserving approaches, hybrid
   AI-assisted defenses, and secure aggregation strategies. For each
   category, we explain the conceptual mechanism, illustrate its
   implementation in the literature, and analyze its effectiveness,
   trade-offs, and limitations. We also discuss the promises and practical
   challenges of adopting blockchain in FL, including scalability, latency,
   energy consumption, and deployment in heterogeneous edge environments.
   Finally, we identify open research directions and emerging trends,
   providing researchers and practitioners with a structured roadmap for
   advancing secure, decentralized, and robust FL systems.},
