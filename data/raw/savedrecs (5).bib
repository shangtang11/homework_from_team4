@inproceedings{ WOS:001268541101153,
Author = {Moorthii, Chithambara J. and Rayapati, Vinay and Rao, Nanditha and Suri,
   Manan},
Book-Group-Author = {IEEE},
Title = {VPU-CIM: A 130nm, 33.98 TOPS/W RRAM based Compute-In-Memory Vector
   Co-Processor},
Booktitle = {2024 IEEE INTERNATIONAL SYMPOSIUM ON CIRCUITS AND SYSTEMS, ISCAS 2024},
Series = {IEEE International Symposium on Circuits and Systems},
Year = {2024},
Note = {IEEE International Symposium on Circuits and Systems (ISCAS), Singapore,
   SINGAPORE, MAY 19-22, 2024},
Abstract = {Deep Learning inference on edge devices requires reduced memory
   load/store latency and low bit-precision computations. To address these
   challenges, we present VPU-CIM: a novel RRAM-based Compute-In-Memory
   (CIM) variable bit-precision vector co-processor. We introduce vector
   extensions to the RISC-V ISA and implement it as an in-memory compute
   unit with a unique data mapping strategy. The design is implemented
   using open-source Skywater 130nm PDK, with area estimates provided for
   TSMC 28nm and ASAP 7nm PDKs. Our design achieves an energy efficiency of
   33.98 TOPS/W for a 4,4 (I, W) precision configuration. The results
   demonstrate the potential of RRAM-based vector computations in memory.},
Type = {Proceedings Paper},
Affiliation = {Suri, M (Corresponding Author), Indian Inst Technol Delhi, New Delhi, India.
   Rayapati, Vinay; Rao, Nanditha, Int Inst Informat Technol, Bangalore, Karnataka, India.
