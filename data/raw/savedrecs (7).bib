Title = {Developing an Ultra-low Power RISC-V Processor for Anomaly Detection},
Booktitle = {2023 DESIGN, AUTOMATION \& TEST IN EUROPE CONFERENCE \& EXHIBITION, DATE},
Series = {Design Automation and Test in Europe Conference and Exhibition},
Year = {2023},
Note = {Design, Automation and Test in Europe Conference and Exhibition (DATE),
   Antwerp, BELGIUM, APR 17-19, 2023},
Abstract = {This paper aims to develop an ultra-low power processor for wearable
   devices for anomaly detection. To this end, this paper proposes a
   processor architecture that divides the architecture into a part for
   general applications running on wearable devices (day part) and a part
   that performs anomaly detection by analyzing sensor data (night parts),
   and each part operates completely independently. This day-night
   architecture allows the day part, which contains the power-hungry
   main-CPU and system interconnect, to be turned off most of the time
   except for intermittent work, and the night part, which consists only of
   the sub-CPU and minimal IPs, can run all the time with low power. By
   developing a processor based on the proposed processor architecture, the
   design verification of the proposed technology and the superiority of
   power saving are demonstrated.},
Type = {Proceedings Paper},
Affiliation = {Lee, W (Corresponding Author), Chung Ang Univ, Seoul, South Korea.
   Han, K (Corresponding Author), Elect \& Telecommun Res Inst ETRI, Daejeon, South Korea.
