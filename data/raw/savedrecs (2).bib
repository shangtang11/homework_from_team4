Title = {iVault: Architectural Code Concealing Techniques to Protect
   Cryptographic Keys},
Booktitle = {EMBEDDED COMPUTER SYSTEMS: ARCHITECTURES, MODELING, AND SIMULATION,
   SAMOS 2024, PT II},
