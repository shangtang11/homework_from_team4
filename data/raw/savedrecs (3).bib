@inproceedings{ WOS:001549674500007,
Author = {Vu Trung Duong Le and Hoai Luan Pham and Tuan Hai Vu and Van Duy Tran
   and Nakashima, Yasuhiko},
Book-Group-Author = {IEEE},
Title = {UniCrypt: Universal Crypto Engine with Optimized Resource Sharing for
   Security Applications},
Booktitle = {2025 IEEE SYMPOSIUM ON LOW-POWER AND HIGH-SPEED CHIPS AND SYSTEMS, COOL
   CHIPS},
Series = {IEEE Cool Chips},
Year = {2025},
Note = {28th Symposium in Low-Power and High-Speed Chips-COOL CHIPS-Annual,
   JAPAN, APR 16-18, 2025},
Abstract = {Nowadays, traditional hash functions and stream ciphers, including
   SHA256, SM3, BLAKE256, BLAKE2s, ChaCha20, and Salsa20, are widely used
   for data security and protection. Unfortunately, most existing
   cryptographic platforms supporting these algorithms suffer from
   limitations in performance, flexibility, and hardware efficiency. To
   address these challenges, this paper proposes the Universal Efficient
   Crypto Engine (UniCrypt), a highly flexible architecture that
   efficiently supports six traditional cryptographic algorithms with low
   power consumption, minimal resource usage, and high performance.
   Specifically, UniCrypt incorporates three key innovations: a dynamically
   configurable memory organization, a unified configurable ALU, and system
   pipeline scheduling. The UniCrypt architecture has been implemented and
   verified at the system-on-chip level on the Xilinx ZCU102 FPGA.
   Real-time comparisons with powerful CPUs demonstrate that UniCrypt
   achieves 1.2 times to 9.3 times higher energy efficiency. Moreover, FPGA
   synthesis results further show that UniCrypt delivers throughput
   improvements ranging from 1.35 times to 92.3 times and area efficiency
   improvements from 1.14 times to 280.5 times compared to related
   FPGA-based accelerators. Finally, ASIC synthesis results demonstrate
   that UniCrypt achieves a 78.7\% unified efficiency while attaining a
   computational throughput improvement of 3.34 times to 54.44 times
   compared to related works.},
Type = {Proceedings Paper},
Affiliation = {Le, VTD (Corresponding Author), Nara Inst Sci \& Technol, 8916-5 Takayama Cho, Ikoma, Nara 6300192, Japan.
   Vu Trung Duong Le; Hoai Luan Pham; Tuan Hai Vu; Van Duy Tran; Nakashima, Yasuhiko, Nara Inst Sci \& Technol, 8916-5 Takayama Cho, Ikoma, Nara 6300192, Japan.},
DOI = {10.1109/COOLCHIPS65488.2025.11018585},
Keywords = {Cryptography; FPGA; ASIC; SHA256; Resource Sharing},
Author-Email = {le.duong@naist.ac.jp},
Affiliations = {Nara Institute of Science \& Technology},
