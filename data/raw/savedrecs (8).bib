@inproceedings{ WOS:001041471300011,
Author = {Wang, Ziyi and Bai, Chen and He, Zhuolun and Zhang, Guangliang and Xu,
   Qiang and Ho, Tsung-Yi and Yu, Bei and Huang, Yu},
