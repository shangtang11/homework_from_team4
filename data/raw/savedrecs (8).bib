@inproceedings{ WOS:001041471300203,
Author = {Chang, Kevin Kai-Chun and Chiang, Chun-Yao and Lee, Pei-Yu and Jiang,
   Iris Hui-Ru},
Book-Group-Author = {ACM},
Title = {Timing Macro Modeling with Graph Neural Networks},
Booktitle = {PROCEEDINGS OF THE 59TH ACM/IEEE DESIGN AUTOMATION CONFERENCE, DAC 2022},
Year = {2022},
Pages = {1219-1224},
Note = {59th ACM/IEEE Design Automation Conference (DAC) - From Chips to Systems
   - Learn Today, Create Tomorrow, San Francisco, CA, JUL 10-14, 2022},
Abstract = {Due to rapidly growing design complexity, timing macro modeling has been
   widely adopted to enable hierarchical and parallel timing analysis. The
   main challenge of timing macro modeling is to identify timing variant
   pins for achieving high timing accuracy while keeping a compact model
   size. To tackle this challenge, prior work applied ad-hoc techniques and
   threshold setting. In this work, we present a novel timing macro
   modeling approach based on graph neural networks (GNNs). A timing
   sensitivity metric is proposed to precisely evaluate the influence of
   each pin on the timing accuracy. Based on the timing sensitivity data
   and the circuit topology, the GNN model can effectively learn and
   capture timing variant pins. Experimental results show that our
   GNN-based framework reduces 10\% model sizes while preserving the same
   timing accuracy as the state-of-the-art. Furthermore, taking common path
   pessimism removal (CPPR) as an example, the generality and applicability
   of our framework on various timing analysis models and modes are also
   validated empirically.},
Type = {Proceedings Paper},
Affiliation = {Chang, KKC (Corresponding Author), Natl Taiwan Univ, Dept Elect Engn, Taipei 106319, Taiwan.
   Chang, Kevin Kai-Chun; Jiang, Iris Hui-Ru, Natl Taiwan Univ, Dept Elect Engn, Taipei 106319, Taiwan.
   Chiang, Chun-Yao; Jiang, Iris Hui-Ru, Natl Taiwan Univ, Grad Inst Elect Engn, Taipei 106319, Taiwan.
   Lee, Pei-Yu, Cadence Design Syst Inc, Hsinchu, Taiwan.},
DOI = {10.1145/3489517.3530599},
