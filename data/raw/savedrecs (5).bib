@inproceedings{ WOS:001363166600239,
Author = {Yang, Wei and Zhang, Shuhua and Song, Rui and Zhao, Chuanqi and Wang,
   Lanruo},
Editor = {Li, G and Li, Z},
Title = {RiscV-based Edge Intelligence Application for Securing Power Automation
   Device},
Booktitle = {2024 4TH POWER SYSTEM AND GREEN ENERGY CONFERENCE, PSGEC 2024},
Year = {2024},
Pages = {1347-1351},
Note = {4th Power System and Green Energy Conference (PSGEC), Shanghai, PEOPLES
   R CHINA, AUG 22-24, 2024},
Abstract = {For the power automation system, which is literally a cloud-edge
   collaboration system, the cybersecurity topic is becoming the top
   priority. The power automation device as the edge intelligent device of
   automation network does not only play the role of data acquisition,
   analysis and interaction with the cloud but also undertakes
   responsibilities for security leveraging trusted core chip, secure
   operation system, and secure application mechanism. Meanwhile, the
   trusted chip core is fundamental to implement the secure power
   automation. This paper presents an Edge intelligent device prototype
   based on the RiscV core chip because the RiscV architecture
   significantly mitigates the security risks due to the open source core.
   And the operating system and application mechanism for the edge
   intelligent device is also addressed to secure all the power automation
   system. For the operating system, it should be able defend against all
   kinds of cyberattacks leveraging AI machine learning algorithm. On the
   other hand, for application mechanism, the communication between devices
   and control center should be protected according to the existing
   standard IEC 62351 series. In addition, verification results at lab
   compared with others are shown in the last section.},
Type = {Proceedings Paper},
