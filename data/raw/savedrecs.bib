@article{ WOS:001717966200001,
Author = {Pan, Wenya and Gao, Hongyan and Duan, Xiaohui and Guo, Xiaoxue and Peng,
   Shu and Zhang, Pengfei and Liu, Bitao and Chen, Wenbo and Liu, Fei and
   Zhao, Lei},
Title = {Design of multimodal stimuli-distinct responsive dynamic luminescence
   for visualized mechanical sensing},
Journal = {CHEMICAL ENGINEERING JOURNAL},
Year = {2026},
Volume = {534},
Month = {APR 15},
Abstract = {The intrinsic coupling between mechanical stimuli and light emission in
   mechanoluminescent (ML) materials offers unique advantages for
   visualized mechanical sensing. However, conventional ML-based sensing
   technologies typically rely on absolute intensity variations from a
   single emission center, making them susceptible to environmental
   interference and limiting measurement accuracy under dynamic stress
   conditions. To address this challenge, we propose a system-level
   light-assisted dynamic mechanical sensing strategy by integrating
   photoluminescence (PL) and ML materials with distinct stimulus
   sensitivities as internal reference and sensing channels, respectively.
   By exploiting strain-dependent ML emission under constant optical
   excitation, a selfreferenced ratiometric luminescence sensing platform
   with dynamic response capability is constructed. The results demonstrate
   that color-resolved luminescence enables high visual distinguishability
   and intrinsic selfcalibration, allowing quantitative or
   semi-quantitative visualization of mechanical information. This design
   strategy alleviates the dependence of conventional ratiometric systems
   on complex host-dopant coupling or multi-emission-center engineering,
   thereby expanding material selection flexibility and providing a broadly
   applicable general framework for visual ratiometric dynamic mechanical
   sensing systems.},
Type = {Article},
Affiliation = {Gao, HY; Zhang, PF; Liu, F; Zhao, L (Corresponding Author), Baoji Univ Arts \& Sci, Collaborat Innovat Ctr Rare Earth Opt Funct Mat \&, Sch Phys \& Optoelect Technol, Baoji 721016, Shaanxi, Peoples R China.
