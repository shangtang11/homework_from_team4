@inproceedings{ WOS:001661551200068,
Author = {Park, Jiyong and Park, Dahoon and Hong, Yeeun and Kung, Jaeha},
Book-Author = {IEEE},
Title = {RIMIX: RISC-V Core with MIXed-Precision SIMD Instruction Extensions
   Supported by Oracle-Assisted Sub-Network Search for Efficient TinyML},
Booktitle = {2025 IEEE/ACM INTERNATIONAL SYMPOSIUM ON LOW POWER ELECTRONICS AND
   DESIGN, ISLPED},
Series = {International Symposium on Low Power Electronics and Design},
Year = {2025},
Note = {2025 International Symposium on Low Power Electronics and Design-ISLPED,
   ICELAND, AUG 06-08, 2025},
Abstract = {As the size of the deep learning model increases, mixed-precision
   quantization has become an efficient compression technique. However, the
   lack of MCU support for mixed-precision computation limits its
   performance in running tinyML tasks. To address this issue, we propose a
   RISC-V core, named RIMIX, designed to support various bit combinations
   with minimal hardware overhead. The RIMIX features an optimized bit
   packing mechanism, an extended ISA tailored for mixed-precision
   arithmetic, and a neural unit capable of multi-precision computations,
   achieving up to 28.6x speedup over an Ibex core. To maximize the quality
   of tinyML processing with RIMIX, we also present an oracle-based neural
   architecture search to discover optimized models under a target
   constraint. To speed up the search process, we propose a novel two-stage
   approach that decouples model topology search and mixed-precision
   training. First, we search for an oracle network using training-free
   NAS, i.e., a high-bit optimized network that serves as a basis for
   mixed-precision training. Once the oracle architecture is identified, we
   distill the model with weight sharing so that it performs well on any
   bit combinations. We further propose a sub-network selection strategy
   from the oracle network, considering actual RIMIX instruction cycles to
   better meet the target constraints. Our sub-network selection method
   outperforms conventional BOPs-based search methods. Finally, the
   proposed SW/HW co-design method enables 2.0x faster execution in running
   TinyML tasks while keeping the accuracy drop by less than 2\% compared
   to the existing state-of-the-art method on the Artix-7 FPGA board.},
