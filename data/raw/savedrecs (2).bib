Title = {Plan Your Defense: A Comparative Analysis of Leakage Detection Methods
   on RISC-V Cores},
Booktitle = {EMBEDDED COMPUTER SYSTEMS: ARCHITECTURES, MODELING, AND SIMULATION,
   SAMOS 2024, PT II},
