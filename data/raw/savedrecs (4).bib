@inproceedings{ WOS:001268541103164,
Author = {Dumoulin, Joren and Houshmand, Pouya and Jain, Vikram and Verhelst,
   Marian},
Book-Group-Author = {IEEE},
Title = {Enabling Efficient Hardware Acceleration of Hybrid Vision Transformer
   (ViT) Networks at the Edge},
Booktitle = {2024 IEEE INTERNATIONAL SYMPOSIUM ON CIRCUITS AND SYSTEMS, ISCAS 2024},
Series = {IEEE International Symposium on Circuits and Systems},
Year = {2024},
Note = {IEEE International Symposium on Circuits and Systems (ISCAS), Singapore,
   SINGAPORE, MAY 19-22, 2024},
Abstract = {Hybrid vision transformers combine the elements of conventional neural
   networks (NN) and vision transformers (ViT) to enable lightweight and
   accurate detection. However, several challenges remain for their
   efficient deployment on resourceconstrained edge devices. The hybrid
   models suffer from a widely diverse set of NN layer types and large
   intermediate data tensors, hampering efficient hardware acceleration. To
   enable their execution at the edge, this paper proposes innovations
   across the hardware-scheduling stack: a.) At the lowest level, a
   configurable PE array supports all hybrid ViT layer types; b.) temporal
   loop re-ordering within one layer, enabling hardware support for
   normalization and softmax layers, minimizing onchip data transfers; c.)
   further scheduling optimization employs layer fusion across inverted
   bottleneck layers to drastically reduce off-chip memory transfers. The
   resulting accelerator is implemented in 28nm CMOS, achieving a peak
   energy efficiency of 1.39 TOPS/W at 25.6 GMACs/s.},
Type = {Proceedings Paper},
Affiliation = {Dumoulin, J (Corresponding Author), Katholieke Univ Leuven, MICAS, ESAT, Leuven, Belgium.
