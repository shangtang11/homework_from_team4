@inproceedings{ WOS:000945853500054,
Author = {Xue, Bing and Zwolinski, Mark},
Book-Group-Author = {IEEE},
Title = {Using Formal Methods to Evaluate Hardware Reliability in the Presence of
   Soft Errors},
Booktitle = {PRIME 2022: 17TH INTERNATIONAL CONFERENCE ON PHD RESEARCH IN
   MICROELECTRONICS AND ELECTRONICS},
Year = {2022},
Pages = {213-216},
Note = {17th Conference on Ph.D Research in Microelectronics and Electronics
   (PRIME), Villasimius, ITALY, JUN 12-15, 2022},
Abstract = {Reliability is a major concern in many embedded systems.
   Redundancy-based methods are widely used against Single Event Upsets,
   causing significant temporal and spatial overhead. The traditional
   method to evaluate the reliability of a system is fault injection.
   However, it is practically impossible to test all faults for a complex
   design due to intractable simulation times. In this paper, we propose
   using formal methods to evaluate hardware reliability in the presence of
   soft errors. The proposed method can exhaustively search the entire
   state space and the whole fault list in a reasonable time. The method is
   applied to assess the vulnerability of all registers in a RISC-V Ibex
   core.},
Type = {Proceedings Paper},
Affiliation = {Xue, B (Corresponding Author), Univ Southampton, Sch Elect \& Comp Sci, Southampton SO17 1BJ, Hants, England.
   Xue, Bing; Zwolinski, Mark, Univ Southampton, Sch Elect \& Comp Sci, Southampton SO17 1BJ, Hants, England.},
