@article{ WOS:001540246500001,
Author = {Xiong, Jingyi and Zhang, Jiawei and Zheng, Xufan and Hu, Tianyu and
   Xiang, Huimin and Li, Yuda and Xiao, Biao and Wang, Xunchang and Yang,
   Renqiang},
Title = {Fluorescence sensing of nitro explosives based on deep learning},
Journal = {CELL REPORTS PHYSICAL SCIENCE},
Year = {2025},
Volume = {6},
Number = {7},
Month = {JUL 16},
Abstract = {Fluorescence sensing technology has been extensively used in the field
   of explosives monitoring for highly sensitive trace detection and early
   warning systems. However, these advancements have been hindered by a
   significant reliance on professional technicians and a low degree of
   automation. Here, we present a cloud-based website that encapsulates a
   deep-learning-assisted technique based on the PaddlePaddle You Only Look
   Once (PPYOLO) model and integrates a highly sensitive external
   fluorescence sensor. This approach, combined with a deep learning model,
   streamlines the detection of nitro explosives, enhancing automation
   levels and efficiency. The cloud-based interface and self-developed
   portable sampling software offer a user-friendly, interactive, and
   portable system. Moreover, the model boasts a target recognition
   accuracy (bounding box mean average precision {[}bbox\_map]) of up to
   99\%, making it capable of automatically extracting six independent
   color signals from images and providing detection results. These results
   suggest that the proposed method could provide promising perspectives
   for the future development of efficient and portable explosives
   detection systems.},
