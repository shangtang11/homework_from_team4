   Azumi, Takuya, Saitama Univ, Grad Sch Sci \& Engn, Acad Assoc, Saitama 3388570, Japan.},
DOI = {10.1109/OJIES.2026.3666358},
Keywords = {Safety; Codes; Embedded systems; Reliability; Industrial electronics;
   Seaports; Real-time systems; Kernel; Freeports; Computer bugs;
