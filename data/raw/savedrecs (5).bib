@inproceedings{ WOS:001414927800010,
Author = {Mach, Jan and Kohutka, Lukas and Cicak, Pavel},
Editor = {Kryjak, T and Petrot, F},
Title = {Influence of Structural Units on Vulnerability of Systems with Distinct
   Protection Approaches},
Booktitle = {2024 27TH EUROMICRO CONFERENCE ON DIGITAL SYSTEM DESIGN, DSD 2024},
Series = {Euromicro Symposium on Digital System Design},
Year = {2024},
Pages = {73-80},
Note = {27th Euromicro Conference on Digital System Design, FRANCE, AUG 28-30,
   2024},
Abstract = {Mission/safety-critical applications rely on the dependability of their
   semiconductor control systems. The lockstepping is state-of-the-art when
   it comes to their protection. This paper compares the dual/triple
   lockstep systems with the Hardisc, which features
   microarchitecture-level protection. For a fair comparison, each system
   is based on the same architecture and integrates protection against
   bit-flips in memory and transient faults in the bus. We analyse how
   individual structures of the system affect the vulnerability of a system
   to faults. Our fault injection methodology combines pre-synthesis
   simulation with synthesis data to scale the fault rate of the structures
   according to their size. The results show that the Hardisc can withstand
   fault rates orders of magnitude higher than the dual-core lockstep
   system while preserving the same area and power consumption. It comes
   with a 5\% frequency penalty. The pipeline logic has the most
   significant impact on the vulnerability of the lockstep system. On the
   other hand, the ECC-protected register file constraints the maximum
   failure rate the Hardisc can withstand due to fault accumulation during
   specific program sections.},
