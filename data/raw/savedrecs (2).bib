   Feng, Lang; Wang, Zhongfeng, Sun Yat Sen Univ, Sch Integrated Circuits, Guangzhou 510275, Peoples R China.},
DOI = {10.1109/TCAD.2024.3448264},
Keywords = {Writing; Prediction algorithms; Encryption; Memory management; Hardware;
