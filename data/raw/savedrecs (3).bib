@article{ WOS:001323612600001,
Author = {Grossi, Marco and Alfonsi, Fabrizio and Prandini, Marco and Gabrielli,
   Alessandro},
Title = {Increasing the Security of Network Data Transmission with a Configurable
   Hardware Firewall Based on Field Programmable Gate Arrays},
Journal = {FUTURE INTERNET},
Year = {2024},
Volume = {16},
Number = {9},
Month = {SEP},
Abstract = {One of the most common mitigations against network-borne security
   threats is the deployment of firewalls, i.e., systems that can observe
   traffic and apply rules to let it through if it is benign or drop
   packets that are recognized as malicious. Cheap and open-source (a
   feature that is greatly appreciated in the security world) software
   solutions are available but may be too slow for high-rate channels.
   Hardware appliances are efficient but opaque and they are often very
   expensive. In this paper, an open-hardware approach is proposed for the
   design of a firewall, implemented on off-the-shelf components such as an
   FPGA (the Xilinx KC705 development board), and it is tested using
   controlled Ethernet traffic created with a packet generator as well as
   with real internet traffic. The proposed system can filter packets based
   on a set of rules that can use the whitelist or blacklist approach. It
   generates a set of statistics, such as the number of
   received/transmitted packets and the amount of received/transmitted
   data, which can be used to detect potential anomalies in the network
   traffic. The firewall has been experimentally validated in the case of a
   network data throughput of 1 Gb/s, and preliminary simulations have
   shown that the system can be upgraded with minor modifications to work
   at 10 Gb/s. Test results have shown that the proposed firewall features
   a latency of 627 ns and a maximum data throughput of 0.982 Gb/s.},
