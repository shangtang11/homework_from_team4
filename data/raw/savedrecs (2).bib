@inproceedings{ WOS:001537918202147,
Author = {Galli, Davide and Matteucci, Matteo and Zoni, Davide},
Book-Group-Author = {IEEE},
Title = {Rabbit: Dynamic Clock Randomization to Protect against Side-Channel
   Attacks},
