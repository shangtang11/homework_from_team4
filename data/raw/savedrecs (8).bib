   Lee, Il-Gu, Sungshin Womens Univ, Dept Convergence Secur Engn, Seoul 02844, South Korea.},
DOI = {10.1109/ACCESS.2022.3151430},
Keywords = {Security; Internet of Things; Hardware; Physical unclonable function;
   Encryption; System-on-chip; Standards; Hardware security; Internet of
   Things; physical unclonable function; secure cryptographic system on
   chip},
Keywords-Plus = {LIGHTWEIGHT},
Author-Email = {iglee@sungshin.ac.kr
