@article{ WOS:001703623500001,
Author = {Thomas, Mariya and Mathews, Mahima Mary and Panchami, V and Sebastian,
   Asha and Eswaran, Sivaraman},
Title = {Securing the future: A comprehensive review of post-quantum digital
   signatures},
Journal = {COMPUTER SCIENCE REVIEW},
Year = {2026},
Volume = {61},
Month = {AUG},
Abstract = {Public key cryptography plays a pivotal role in maintaining digital
   security and privacy, with its foundations built on the hardness of
   certain mathematical problems. However, the emergence of quantum
   computing threat ens the security of current cryptographic systems,
   making the adoption of post-quantum cryptography (PQC) an urgent
   necessity. Digital signature schemes are essential components in secure
   communications, provid ing authentication, non-repudiation, and data
   integrity. This paper examines the state of post-quantum digital
   signature schemes across various cryptographic approaches, including
   lattice-based, code-based, multivariate polynomial-based, hash-based,
   symmetric-key-based, and isogeny-based systems, alongside advancements
   in Multi-Party Computation in the Head (MPC-in-the-head) schemes. The
   paper then explores application-specific signatures such as blind,
   undeniable, threshold, chameleon, aggregate, and ring signatures,
   explaining their main use cases and the existing post-quantum
   cryptographic classifications that support these constructions individ
   ually. Software implementations of selected prominent PQC digital
   signature schemes were carried out, and their performance was
   systematically analysed using metrics such as bandwidth consumption,
   latency, and com putational efficiency. These results provide key
   observations regarding the suitability of different schemes for both
   resource-constrained and high-performance environments. Subsequently, a
   detailed literature review of im plementations on embedded and hardware
   platforms is presented, focusing on ARM-based devices and FPGA
   accelerators to evaluate deployment feasibility beyond general-purpose
   processors. Based on the software and implementation-level findings, a
   comparative analysis across software, embedded, and hardware platforms
   is conducted to highlight architectural influences on performance,
   scalability, and practicality. Furthermore the cryptanalytic attacks on
   post-quantum digital signature schemes across various PQC
   classifications are examined in this paper, taking into account both
   classical and quantum adversarial models. To evaluate realistic secu
   rity constraints, implementation-oriented vulnerabilities such as
   side-channel and fault-based attacks are also examined. In addition, the
   applicability of post-quantum digital signature schemes within TLS, IoT,
   and related practical deployment scenarios is analysed. The study also
   discusses possible directions for further investigation, focusing on the
   requirement for effective and expandable PQC systems that can satisfy
   changing cybersecurity re quirements. In order to protect sensitive data
   in the digital era, this study emphasizes the need for implementing
   quantum-secure systems by fusing theoretical understandings with
   real-world applications.},
Type = {Review},
Affiliation = {Eswaran, S (Corresponding Author), Curtin Univ Malaysia, Dept Elect \& Comp Engn, Miri 98009, Malaysia.
   Thomas, Mariya; Mathews, Mahima Mary; Panchami, V, Indian Inst Informat Technol Kottayam, CyberLabs, Valavoor 686635, Pala, India.
