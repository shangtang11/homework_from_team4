@inproceedings{ WOS:001055030700018,
Author = {Mosanu, Sergiu and Fixe, Joshua and Sakib, Mohammad Nazmus and Skadron,
   Kevin and Stan, Mircea},
Book-Group-Author = {IEEE},
Title = {FreezeTime: Towards System Emulation through Architectural
   Virtualization},
Booktitle = {2023 IEEE INTERNATIONAL PARALLEL AND DISTRIBUTED PROCESSING SYMPOSIUM
   WORKSHOPS, IPDPSW},
Series = {IEEE International Symposium on Parallel and Distributed Processing
   Workshops},
Year = {2023},
Pages = {129-136},
Note = {37th IEEE International Parallel and Distributed Processing Symposium
   (IPDPS), St Petersburg, FL, MAY 15-19, 2023},
Abstract = {High-end FPGAs enable architecture modeling through emulation with high
   speed and fidelity. However, the available reconfigurable logic and
   memory resources limit the size, complexity, and speed of the emulated
   target designs. In addition to the spatial dimension, this work uses the
   temporal dimension, implemented with architectural multiplexing coupled
   with block-level synchronization, to model a complete system-on-chip
   architecture. Our approach presents mechanisms to abstract instance
   plurality while preserving timing in sync. We demonstrate this technique
   by emulating a hypothetical system consisting of a processor and a large
   SRAM memory. For Linux boot, we measure significant emulation vs.
   simulation speedup while matching RTL simulation accuracy.},
