@inproceedings{ WOS:001540479400008,
Author = {Elhamawy, Nourhan and Anders, Jens and Polian, Ilia and Sauer, Matthias},
Book-Group-Author = {IEEE},
Title = {Towards Understanding of System-Level Test Unique Fails},
Booktitle = {2025 IEEE EUROPEAN TEST SYMPOSIUM, ETS},
Series = {Proceedings of the European Test Symposium},
Year = {2025},
Note = {2025 European Test Symposium-ETS-Annual, Tallinn, ESTONIA, MAY 26-30,
   2025},
Abstract = {System-Level test (SLT) has been empirically shown to detect fails that
   had not been covered by earlier structural or functional test
   insertions. Even though theories about the reasons for SLT-unique fails
   abound, no conclusive evidence in favor of any of them have been
   presented so far. In this work, for the first time, we present
   simulation data for a recently discovered class of subtle defects that
   are truly SLT-unique, i.e., fundamentally cannot be triggered during
   scan test using standard Design-for-Testing (DFT). While the activation
   conditions of these defects extend over more than two clock cycles, we
   show that they do occasionally occur in SLT workloads. Analyzing the
   behavior of multi-time-frame triggered defects leads to conclusions that
   are coherent with (limited) previously reported empirical findings about
   SLT-unique fails, and we believe that such defects are a strong
   candidate towards understanding and, ultimately, eliminating SLT-unique
   fails.(1)},
Type = {Proceedings Paper},
Affiliation = {Elhamawy, N (Corresponding Author), Univ Stuttgart, Inst Smart Sensors, Stuttgart, Germany.
   Elhamawy, N (Corresponding Author), Univ Stuttgart, Inst Comp Engn \& Comp Architecture, Stuttgart, Germany.
