@inproceedings{ WOS:000630443300034,
Author = {Tehrani, Etienne and Graba, Tarik and Merabet, Abdelmalek Si and Danger,
   Jean-Luc},
Editor = {Trost, A and Zemva, A and Skavhaug, A},
Title = {RISC-V Extension for Lightweight Cryptography},
Booktitle = {2020 23RD EUROMICRO CONFERENCE ON DIGITAL SYSTEM DESIGN (DSD 2020)},
Year = {2020},
Pages = {222-228},
Note = {23rd Euromicro Conference on Digital System Design (DSD), ELECTR
   NETWORK, AUG 26-28, 2020},
Abstract = {Lightweight Cryptography (LWC) is suitable for IoTs which require a high
   level of security while keeping a low complexity. Many lightweight
   cryptographic algorithms have been proposed to satisfy these
   requirements. But there is currently no emerging standard concerning the
   symmetric block ciphering, as every algorithm has its own advantage. For
   instance one can be optimized for low latency, another one for low
   complexity but requires more rounds to be cryptographically secure to
   the detriment of throughput. Hence, a processor able to cope with all
   the algorithms should be ideal to provide agility, performance and
   security while keeping an affordable complexity. We present in this
   paper a specific execution unit of the RISC-V processor which is able to
   run the most common lightweight 64-bit block ciphers. The gain in
   performance can reach over a hundred compared to the reference
   architecture. The acceleration takes advantage of five specific
   instructions which can easily be adapted to the execution unit of a
   VexRiscv architecture. The complexity can double when implementing the
   new execution unit, but provide a high degree of agility and performance
   when executing most of lightweight cryptographic implementations.},
Type = {Proceedings Paper},
Affiliation = {Tehrani, E (Corresponding Author), Inst Polytech Paris, Telecom Paris, LTCI, F-91120 Palaiseau, France.
   Tehrani, Etienne; Graba, Tarik; Merabet, Abdelmalek Si; Danger, Jean-Luc, Inst Polytech Paris, Telecom Paris, LTCI, F-91120 Palaiseau, France.},
