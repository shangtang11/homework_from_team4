@article{ WOS:001461898100001,
Author = {Shen, Ruipeng and Li, Ying-Ai and Zhang, Weiran and Du, Yanqiu and Guo,
   Ye and Zou, Zhihua and Liang, Xiao and Li, Quanshun and Zhu, Youliang
   and Zhang, Yu-Mo and Zhang, Sean Xiao-An},
Title = {Biomimetic synaptic ion release-capture strategy and related functional
   materials and devices},
Journal = {CHEMICAL ENGINEERING JOURNAL},
Year = {2025},
Volume = {511},
Month = {MAY 1},
Abstract = {Artificial synapses have been designed and demonstrated to improve the
   efficiency of information processing. Progress in achieving ideal
   artificial synapse (AS) devices and computers is still unsatisfactory,
   due to the unclear molecular level reaction mechanisms of information
   transmission between synapses of related materials and devices. Herein,
   we simulated one possible mechanism of specific recognition proteins and
   active ligands on Zn2+ ion release-capture (IRC) and information
   transmission through spectral methods. Observation and validation of
   related molecular level dynamic reaction mechanisms were achieved
   through use of bionic molecular switches with Br- and Zn2+, and the
   mechanism was further validated through relevant biological tests in
   cells. Then, relevant functional material and AS device with good
   memory, controllable switching ability and highly simplified computation
   and display procedures based on IRC mechanism was fabricated for visual
   enhancement simulation. The imitation and harvest of IRC mechanism may
   provide more ideas for the development of new materials and devices for
   artificial intelligence, supercomputer, medical sensor and etc., and the
   strategy of using known chemical processes to verify unknown
   physiological processes will bring more ideas for researchers to break
   the bottle-neck in other fields.},
