@inproceedings{ WOS:001476945200087,
Author = {Liu, Shang and Fang, Wenji and Lu, Yao and Zhang, Qijun and Xie, Zhiyao},
Book-Group-Author = {ACM},
Title = {Towards Big Data in AI for EDA Research: Generation of New
   Pseudo-Circuits at RTL Stage},
Booktitle = {30TH ASIA AND SOUTH PACIFIC DESIGN AUTOMATION CONFERENCE, ASP-DAC 2025},
