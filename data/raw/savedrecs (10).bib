Affiliation = {Banerjee, U (Corresponding Author), MIT, Dept Elect Engn \& Comp Sci, Cambridge, MA 02139 USA.
   Banerjee, Utsav; Wright, Andrew; Juvekar, Chiraag; Waller, Madeleine; Arvind; Chandrakasan, Anantha P., MIT, Dept Elect Engn \& Comp Sci, Cambridge, MA 02139 USA.},
