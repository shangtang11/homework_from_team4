@article{ WOS:001254655900001,
Author = {Opilka, Filip and Niemiec, Marcin and Gagliardi, Maria and Kourtis,
   Michail Alexandros},
Title = {Performance Analysis of Post-Quantum Cryptography Algorithms for Digital
   Signature},
Journal = {APPLIED SCIENCES-BASEL},
Year = {2024},
Volume = {14},
Number = {12},
Month = {JUN},
Abstract = {In the face of advancing quantum computing capabilities posing
   significant threats to current cryptographic protocols, the need for
   post-quantum cryptography has become increasingly urgent. This paper
   presents a comprehensive analysis of the performance of various
   post-quantum cryptographic algorithms specifically applied to digital
   signatures. It focuses on the implementation and performance analysis of
   selected algorithms, including CRYSTALS-Dilithium, Falcon, and SPHINCS+,
   using the liboqs library. Performance tests reveal insights into key
   pair generation, file signing, and signature verification processes.
   Comparative tests with the well-known and popular RSA algorithm
   highlight the trade-offs between security and time efficiency. The
   results can help to select secure and efficient ciphers for specific
   5G/6G services.},
