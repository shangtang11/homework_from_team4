@article{ WOS:001682783600001,
Author = {Zhao, Chenyu and Zhou, Yuquan and Liu, Yanming and Zhang, Peigen and
   Tian, He},
Title = {Projected Performance of MoS2-Based SRAM Incorporating
   Defect-Induced Threshold Voltage Variations},
Journal = {IEEE TRANSACTIONS ON ELECTRON DEVICES},
Year = {2026},
Volume = {73},
Number = {3},
Pages = {1701-1704},
Month = {MAR},
Abstract = {Molybdenum disulfide (MoS2) is one of the most widely investigated 2-D
   materials due to its ideal electrical properties and excellent
   short-channel characteristics. However, the intrinsic defects in MoS2
   materials compromise the uniformity of MoS2 transistors, hindering
   progress in its large-scale application. Consequently, analytical
   methodologies for quantifying how transistor variability propagates to
   circuit-level performance are urgently needed. This work establishes
   MoS2 device models incorporating threshold voltage variations at the
   transistor level, and simulates typical designs of MoS2-based static
   random access memory (SRAM). The results show that as the standard
   deviation of threshold voltage ( sigma(th) ) increases from 0.00 to 0.10
   V, the yield rapidly drops to less than 20\%. When sigma(th) reaches
   0.30 V, the read/write operation becomes nearly impossible. However, the
   read-decoupled SRAM design, which is usually regarded as more robust
   than the conventional SRAM design, loses its advantageous static noise
   margin (SNM) when sigma(th) exceeds 0.10V. For future industrial
   applications, it is advisable to improve the fabrication process to
   maintain sigma th below 0.03 V before further optimization of device
   topology or channel parameters. This integrated approach provides a
   robust analytical framework and valuable perspective for the industrial
   advancement of 2-D materials.},
Type = {Article},
