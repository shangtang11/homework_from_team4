@article{ WOS:001140561000002,
Author = {Tsai, Chne-Wuen and Jiang, Rucheng and Zhang, Lian and Zhang, Miaolin
   and Yoo, Jerald},
Title = {Seizure-Cluster-Inception CNN (SciCNN): A Patient-Independent Epilepsy
   Tracking SoC With 0-Shot-Retraining},
Journal = {IEEE TRANSACTIONS ON BIOMEDICAL CIRCUITS AND SYSTEMS},
Year = {2023},
Volume = {17},
Number = {6},
Pages = {1202-1213},
Month = {DEC},
Abstract = {Epilepsy tracking System-on-Chips (SoC) usually perform patient-specific
   classification to deal with the patient-to-patient seizure pattern
   variation from a surface electroencephalogram (EEG). However, the
   patient-specific classifier training requires the EEG signals from the
   target patients a priori, which involves costly and time-consuming
   hospitalization for the inpatient data collection. To address this
   issue, this paper presents a patient-independent epilepsy tracking SoC
   that is trained with pre-existing databases and can be directly deployed
   to the target patients without collecting their data and performing
   cumbersome patient-specific training beforehand. The proposed SoC adopts
   a Seizure-Cluster-Inception Convolutional Neural Network (SciCNN) Neural
   Processor (SNP) to reduce SRAM access rate by 179.05 x with the
   Kernel-Wise Pipeline (KWP). The 22-Ch. SoC achieves event-based
   sensitivity of 90.3\%/90.4\%/83.3\% and specificity of
   93.6\%/95.7\%/88.6\% on unseen patients from CHB-MIT database/EU
   database/local hospital patient, respectively.},
Type = {Article},
Affiliation = {Yoo, J (Corresponding Author), Natl Univ Singapore, Dept Elect \& Comp Engn, Singapore 117585, Singapore.
