@inproceedings{ WOS:001539305200009,
Author = {Hunhold, Laslo and Quinlan, James},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Evaluation of Bfloat16, Posit, and Takum Arithmetics in Sparse Linear
   Solvers},
