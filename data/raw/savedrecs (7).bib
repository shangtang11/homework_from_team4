@inproceedings{ WOS:001125860900007,
Author = {Miemietz, Till and Reusch, Viktor and Roitzsch, Michael and Haertig,
   Hermann},
Book-Group-Author = {ACM},
Title = {An NVM Performance Study Towards Whole System Persistence on Server
   Platforms},
Booktitle = {PROCEEDINGS OF THE 2023 1ST WORKSHOP ON DISRUPTIVE MEMORY SYSTEMS, DIMES
   2023},
Year = {2023},
Pages = {45-51},
Note = {1st Workshop on Disruptive Memory Systems (DIMES) Part of 29th ACM
   Symposium on Operating Systems Principles (SOSP), Koblenz, GERMANY, OCT
   23, 2023},
Abstract = {Whole system persistence (WSP) is a concept for retaining the
   computational state of a system even in case of a power failure. In the
   context of server systems, WSP could render it possible to quickly power
   on and off machines that only need to be used occasionally, thus saving
   energy. This paper takes on this idea and discusses multiple approaches
   for implementing WSP on such machines. Our evaluation shows that after
   starting a system, an NVM-based version of WSP can achieve tail latency
   improvements of up to 93\% compared to booting a system and loading data
   from an SSD. At the same time, WSP is able to provide suspend and resume
   times in the order of tens of milliseconds.},
