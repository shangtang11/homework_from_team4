@article{ WOS:000609019300006,
Author = {Liu Zhaoliang and Wei Huang and Wang, Daobo},
Title = {Functional agricultural monitoring data storage based on sustainable
   block chain technology},
Journal = {JOURNAL OF CLEANER PRODUCTION},
Year = {2021},
Volume = {281},
Month = {JAN 25},
Abstract = {In agriculture, the impact of environment on crops is the most critical.
   How to accurately and real-time monitor the growth environment of crops
   is very important for the growth of crops. However, in the process of
   monitoring, how to store the monitoring data safely and reliably has
   become a research problem. Therefore, this paper proposes a storage
   method of agricultural monitoring data based on Sustainable blockchain
   technology. Among them, this paper mainly studies the monitoring data
   storage and privacy protection scheme. With the continuous storage of
   monitoring data, the amount of data is increasing, which leads to the
   shortage of local storage space. Therefore, in the improvement of the
   existing local storage space storage method, with the advantages of
   cloud storage, the data is encrypted and stored in the cloud, and the
   privacy side based on blockchain is adopted It can ensure the privacy
   and security of storage. In the simulation analysis, it is found that
   the data storage method designed in this paper can store more than 0.5
   mb/s for three groups of data with the size of 0 MB, 100 MB and 200 MB.
   Considering the privacy protection scheme of the storage system, the
   1024 bit key is adopted, which can ensure the security of agricultural
   monitoring data stored in the cloud. (C) 2020 Elsevier Ltd. All rights
   reserved.},
Type = {Article},
