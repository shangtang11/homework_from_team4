Title = {Deformable Chiplet-Based Computer Using Inductively Coupled Wireless
   Communication},
Booktitle = {27TH ASIA AND SOUTH PACIFIC DESIGN AUTOMATION CONFERENCE, ASP-DAC 2022},
Series = {Asia and South Pacific Design Automation Conference Proceedings},
Year = {2022},
Pages = {98-99},
Note = {27th Asia and South Pacific Design Automation Conference (ASP-DAC),
   ELECTR NETWORK, JAN 17-20, 2022},
Abstract = {Research on microrobot swarms and deformable user interfaces has been
   conducted extensively. Inductively coupled wireless bus technology has
   been proposed for such applications. This technology uses inductive
   coupling among onchip coils to connect multiple chiplets wirelessly. By
   wirelessly connecting small chiplets, it is possible to construct
   deformable systems with various chip configurations. The prototype chip,
   which has a 32-bit RISC-V processor core and a wireless communication
   interface, is fabricated in 0.18-mu m CMOS technology. The prototype
   validates that inductively coupled wireless data communication can be
   achieved between two processor chiplets.},
