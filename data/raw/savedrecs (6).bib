@article{ WOS:000962586100001,
Author = {Yu, Huifang and Liu, Junze and Wang, Zhicang},
Title = {Certificateless multi-source elliptic curve ring signcryption for cloud
   computing},
Journal = {JOURNAL OF INFORMATION SECURITY AND APPLICATIONS},
Year = {2023},
Volume = {74},
Month = {MAY},
Abstract = {Network coding can encode and forward the received data packets to save
   the network resources and improve the bandwidth utilization in cloud
   computing environment. To resist the pollution attacks and improve the
   computational efficiency in network coding, we construct certificateless
   multi-source elliptic curve ring sign-cryption (CL-MSECRSC) scheme
   suitable for cloud computing, its security relies on the hardness of
   elliptic curve discrete logarithm (ECDL) and elliptic curve computation
   Diffie-Hellman (ECCDH) problems. CL-MSECRSC has the properties of
   anti-forgery, anti-pollution, confidentiality and unconditional
   anonymity; also, scalar multi-plication operations greatly save its
   computation overhead.},
Type = {Article},
Affiliation = {Yu, HF (Corresponding Author), Xian Univ Posts \& Telecommun, Sch Cyberspace Secur, Xian 710121, Peoples R China.
