@article{ WOS:000704824200015,
Author = {Okuhara, Hayate and Elnaqib, Ahmed and Dazzi, Martino and Palestri,
   Pierpaolo and Benatti, Simone and Benini, Luca and Rossi, Davide},
Title = {A Fully Integrated 5-mW, 0.8-Gbps Energy-Efficient Chip-to-Chip Data
   Link for Ultralow-Power IoT End-Nodes in 65-nm CMOS},
Journal = {IEEE TRANSACTIONS ON VERY LARGE SCALE INTEGRATION (VLSI) SYSTEMS},
Year = {2021},
Volume = {29},
Number = {10},
Pages = {1800-1811},
Month = {OCT},
Abstract = {The increasing complexity of Internet-of-Things (IoT) applications and
   near-sensor processing algorithms is pushing the computational power of
   low-power, battery-operated end-node systems. This trend also reveals
   growing demands for high-speed and energy-efficient inter-chip
   communications to manage the increasing amount of data coming from
   off-chip sensors and memories. While traditional microcontroller
   interfaces such as SPIs cannot cope with tight energy and large
   bandwidth requirements, low-voltage swing transceivers can tackle this
   challenge, thanks to their capability to achieve several Gbps of the
   communication speed at milliwatt power levels. However, recent research
   on high-speed serial links focused on high-performance systems, with a
   power consumption significantly larger than the one of low-power IoT
   end-nodes, or on stand-alone designs not integrated at a system level.
   This article presents a low-swing transceiver for the energy-efficient
   and low-power chip-to-chip communication fully integrated within an IoT
   end-node system-on-chip, fabricated in CMOS 65-nm technology. The
   transceiver can be easily controlled via a software interface; thus, we
   can consider realistic scenarios for the data communication, which
   cannot be assessed in stand-alone prototypes. Chip measurements show
   that the transceiver achieves 8.46x higher energy efficiency at 15.9x
   higher performance than a traditional microcontroller interface such as
   a single-SPI.},
Type = {Article},
