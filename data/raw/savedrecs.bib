@article{ WOS:001694322900004,
Author = {Karamuftuoglu, Mustafa Altay and Ucpinar, Beyza Zeynep and Razmkhah,
   Sasan and Pedram, Massoud},
Title = {Programmable Bistable Vortex Logic for Scalable Superconductor
   Electronics},
Journal = {IEEE TRANSACTIONS ON APPLIED SUPERCONDUCTIVITY},
Year = {2026},
Volume = {36},
Number = {5},
Month = {AUG},
Abstract = {We present a reconfigurable logic circuit for Superconductor Electronics
   (SCE) based on a modified bistable vortex memory (BVM). Unlike
   conventional cell-based designs, this approach enables the direct
   modification of logic functions at the cell level by application of a
   control signal, thereby improving resource utilization and reducing
   redundant circuitry. The non-volatility of BVM enables on-chip logic
   reconfiguration without hardware changes or continuous power. Its high
   integration density and simple gate structure support higher logic
   density than most SCE logic families. This in-field programmability
   simplifies clocking, reduces area overhead, and supports scalable,
   energy-efficient designs. Circuit-level simulations verify the
   functionality and programmability of the proposed logic, while analysis
   of reconfiguration latency and energy efficiency demonstrates its
   feasibility for advanced superconductor computing architectures.},
