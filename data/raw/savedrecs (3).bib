@article{ WOS:001350762100058,
Author = {Zhao, Xuyang and Gao, Tianning and Zhao, Aidong and Bi, Zhaori and Yan,
   Changhao and Yang, Fan and Wang, Sheng-Guo and Zhou, Dian and Zeng, Xuan},
Title = {ROI-HIT: Region of Interest-Driven High-Dimensional Microarchitecture
   Design Space Exploration},
Journal = {IEEE TRANSACTIONS ON COMPUTER-AIDED DESIGN OF INTEGRATED CIRCUITS AND
   SYSTEMS},
Year = {2024},
Volume = {43},
Number = {11},
Pages = {4178-4189},
Month = {NOV},
Abstract = {Exploring the design space of RISC-V processors faces significant
   challenges due to the vastness of the high-dimensional design space and
   the associated expensive simulation costs. This work proposes a region
   of interest (ROI)-driven method, which focuses on the promising ROIs to
   reduce the over-exploration on the huge design space and improve the
   optimization efficiency. A tree structure based on self-organizing map
   (SOM) networks is proposed to partition the design space into ROIs. To
   reduce the high dimensionality of design space, a variable selection
   technique based on a sensitivity matrix is developed to prune
   unimportant design parameters and efficiently hit the optimum inside the
   ROIs. Moreover, an asynchronous parallel strategy is employed to further
   save the time taken by simulations. Experimental results demonstrate the
   superiority of our proposed method, achieving improvements of up to
   43.82\% in performance, 33.20\% in power consumption, and 11.41\% in
   area compared to state-of-the-art methods.},
