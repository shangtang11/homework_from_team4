@article{ WOS:001181521100001,
Author = {Li, Zeju and Wang, Qinfan and Zou, Zihan and Shen, Qiao and Xie, Na and
   Cai, Hao and Zhang, Hao and Liu, Bo},
Title = {Layer-Sensitive Neural Processing Architecture for Error-Tolerant
   Applications},
