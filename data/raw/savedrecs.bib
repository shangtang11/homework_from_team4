@article{ WOS:001662954800010,
Author = {Angelis, Georgios Fotios and Karanassos, Dimitrios and Emvoliadis,
   Alexandros and Tatsis, Georgios and Drosou, Anastasios and Tzovaras,
   Dimitrios},
Title = {HMTC: A Hybrid Mamba-Transformer Model for Calibration of Low-Cost Air
   Quality Sensors},
Journal = {IEEE SENSORS JOURNAL},
Year = {2026},
Volume = {26},
Number = {2},
Pages = {3315-3326},
Month = {JAN 15},
Abstract = {The assessment of low-cost sensors (LCSs) for air quality (AQ)
   multisensor systems performance is a critical aspect of the AQ
   monitoring framework. The calibration model for these devices is one of
   the key drivers of overall performance. Field calibration is
   increasingly recognized as the best approach for calibrating AQ
   monitoring devices. However, to achieve high-quality calibration
   results, LCSs must be co-located with reference stations. To address
   this challenge, we propose a comprehensive solution that leverages
   self-supervised pretraining on LCS data to learn meaningful
   representations for pollution data calibration. In the first stage, our
   model undergoes unsupervised pretraining inspired by masked
   autoencoders. In the second stage, supervised fine-tuning is applied to
   enhance the accuracy of pollution data calibration. In addition, we
   introduce a novel architecture that combines state-space models (SSMs),
   specifically Mamba, with Transformer layers. Our model is rigorously
   evaluated on two publicly available research datasets, consistently
   outperforming all baseline methods. Furthermore, we present a newly
   designed ESP32 microcontroller-based system to validate the
   effectiveness of our approach in real-world scenarios. The results
   demonstrate that our calibration technique is well-suited for
   microcontrollers with limited resources, significantly reducing the cost
   of IoT solutions for AQ and pollution monitoring.},
Type = {Article},
