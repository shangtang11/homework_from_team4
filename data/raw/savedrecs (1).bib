@article{ WOS:001587323300001,
Author = {Wu, Hongbiao and Lin, Zhitin},
Title = {A 9T SRAM Computation-in-Memory Architecture With High-Precision MAC,
   Enhanced Bitline Voltage Margin, and Improved Frequency Performance Over
   Conventional Architectures},
