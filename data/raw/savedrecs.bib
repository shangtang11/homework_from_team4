@article{ WOS:001607634700004,
Author = {Noor, Aziz and Li, Yuanzheng and Tang, Guoqiang and Yu, Guang-An and
   Dai, Xirui and Peng, Qinghe and Chen, Hongyi and Xu, Peng and Iqbal,
   Rashid and Du, Taili and Dong, Fangyang and Xu, Minyi},
Title = {MXene and deep learning-enabled hybrid triboelectric-electromagnetic
   sensor for enhanced tactile and touchless perception in robotic hand},
Journal = {MATERIALS TODAY PHYSICS},
Year = {2025},
Volume = {59},
Month = {DEC},
Abstract = {Enabling robots to perceive both touchless and tactile perceptions
   without relying on vision-based methods and addressing the issue of
   cross-sensitivity/decoupling remains a significant challenge. This study
   presents MXene and Deep Learning-enabled state-of-the-art hybrid
   triboelectric-electromagnetic sensor (HTES) based on the combined
   effects of triboelectric nanogenerators (TENG) and electromagnetic
   nanogenerators (EMG), which decouples the touchless and tactile signals
   using a dual-mode TENG-EMG design. The HTES features a simplified
   structure composed of MXene, silicone rubber, a magnet, copper wire, and
   a polylactic acid (PLA) framework. By integrating into a robotic hand,
   the HTES provides dual-mode perception without cross-sensitivity or
   decoupling issues. In TENG mode, the touchless sensing capability
   enables reliable material recognition through voltage signal outputs.
   The incorporation of MXene nanosheets remarkably enhances sensitivity,
   extending the effective sensing range from 20 mm to 40 mm. In EMG mode,
   tactile sensing determines object shape and hardness based on current
   signals, while the spiral structure facilitates the sensitive detection
   of variations in magnetic flux. Utilizing a convolutional neural network
   (CNN), the HTES accurately classifies material types, object shapes, and
   hardness with accuracies of 99.5 \%, 97.9 \%, and 98.6 \%, respectively.
   The sensor design and experimental results suggest that this approach
   may lay the foundation for robotic interactions with the physical world
   comparable to human perception.},
