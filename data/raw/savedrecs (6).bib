@article{ WOS:000978099200004,
Author = {Ouyang, Wei and Lu, Wei and Zhang, Yamin and Liu, Yiming and Kim, Jong
   Uk and Shen, Haixu and Wu, Yunyun and Luan, Haiwen and Kilner, Keith and
   Lee, Stephen P. and Lu, Yinsheng and Yang, Yiyuan and Wang, Jin and Yu,
   Yongjoon and Wegener, Amy J. and Moreno, Justin A. and Xie, Zhaoqian and
   Wu, Yixin and Won, Sang Min and Kwon, Kyeongha and Wu, Changsheng and
   Bai, Wubin and Guo, Hexia and Liu, Tzu-li and Bai, Hedan and Monti,
   Giuditta and Zhu, Jason and Madhvapathy, Surabhi R. and Trueb, Jacob and
   Stanslaski, Maria and Higbee-Dempsey, Elizabeth M. and Stepien, Iwona
   and Ghoreishi-Haack, Nayereh and Haney, Chad R. and Kim, Tae-il and
   Huang, Yonggang and Ghaffari, Roozbeh and Banks, Anthony R. and Jhou,
   Thomas C. and Good, Cameron H. and Rogers, John A.},
Title = {A wireless and battery-less implant for multimodal closed-loop
   neuromodulation in small animals},
Journal = {NATURE BIOMEDICAL ENGINEERING},
Year = {2023},
Volume = {7},
Number = {10},
Pages = {1252+},
Month = {OCT},
Abstract = {A tether-less and battery-less implant allows for the recording of
   electroencephalograms, electromyograms and body temperature in freely
   moving small animals, and for closed-loop neuromodulation via
   optogenetics and pharmacology.
   Fully implantable wireless systems for the recording and modulation of
   neural circuits that do not require physical tethers or batteries allow
   for studies that demand the use of unconstrained and freely behaving
   animals in isolation or in social groups. Moreover, feedback-control
   algorithms that can be executed within such devices without the need for
   remote computing eliminate virtual tethers and any associated latencies.
   Here we report a wireless and battery-less technology of this type,
   implanted subdermally along the back of freely moving small animals, for
   the autonomous recording of electroencephalograms, electromyograms and
   body temperature, and for closed-loop neuromodulation via optogenetics
   and pharmacology. The device incorporates a system-on-a-chip with
   Bluetooth Low Energy for data transmission and a compressed
   deep-learning module for autonomous operation, that offers
   neurorecording capabilities matching those of gold-standard wired
   systems. We also show the use of the implant in studies of sleep-wake
   regulation and for the programmable closed-loop pharmacological
   suppression of epileptic seizures via feedback from
   electroencephalography. The technology can support a broader range of
   applications in neuroscience and in biomedical research with small
   animals.},
