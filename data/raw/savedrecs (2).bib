@article{ WOS:001491264800001,
Author = {Guthmuller, Eric and Fuguet, Cesar and Bocco, Andrea and Fereyre, Jerome
   and Evans, Adrian and Durand, Yves},
Title = {Variable and Extended Precision (VRP) Accelerator Implemented in a 22 nm
   SoC},
Journal = {ELECTRONICS LETTERS},
Year = {2025},
Volume = {61},
Number = {1},
Month = {JAN},
Abstract = {Linear solvers and eigensolvers are the heart of high-performance
   computing scientific applications. Among them, iterative projection
   methods are preferred to direct algorithms for large problems because of
   their lower memory usage, but they are prone to roundoff errors. Using
   an enhanced working precision inside the linear computing kernels
   mitigates this issue and accelerates convergence. Today, to go beyond 80
   bits of precision, the only option is to use software libraries which
   are very slow. We introduce the variable and extended precision
   accelerator (VRP), a RISC-V accelerator implemented on a system-on-chip
   (SoC) using GF22FDX technology. The VRP supports floating point
   computations with a range of significand bits from 2 to 512. This
   accelerator delivers an average 19.25x\$\textbackslash{}times\$
   application speedup compared to the well-known MPFR software library
   running on a 2400 MHz Intel Xeon processor. Additionally, extended
   precision facilitates the convergence of linear solvers for problems
   that would otherwise fail to converge and reduces energy-to-solution.},
Type = {Article},
Affiliation = {Guthmuller, E (Corresponding Author), Univ Grenoble Alpes, CEA, List, Grenoble, France.
   Guthmuller, Eric; Bocco, Andrea; Fereyre, Jerome; Evans, Adrian; Durand, Yves, Univ Grenoble Alpes, CEA, List, Grenoble, France.
   Fuguet, Cesar, Univ Grenoble Alpes, CNRS, Grenoble INP, TIMA,Inria, Grenoble, France.},
