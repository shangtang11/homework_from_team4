   and Khasawneh, Khaled N.},
Book-Group-Author = {ACM},
Title = {Evolution of Defenses against Transient-Execution Attacks},
Booktitle = {PROCEEDINGS OF THE 2020 GREAT LAKES SYMPOSIUM ON VLSI, GLSVLSI 2020},
Year = {2020},
Pages = {169-174},
Note = {2020 Great Lakes Symposium on VLSI-GLSVLSI, Beijing, PEOPLES R CHINA,
   SEP 07-09, 2020},
Abstract = {Transient-execution attacks, such as Meltdown and Spectre, exploit
   performance optimizations in modern CPUs to enable unauthorized access
   to data across protection boundaries. Against these attacks, we have
   noticed a rapid growth of deployed and proposed countermeasures. In this
   paper, we show the evolution of countermeasures against
   transient-execution attacks by both industry and academia since the
   initial discoveries of the attacks. We show that despite the advances in
   the understanding and systematic view of the field, the proposed and
   deployed defenses are limited.},
