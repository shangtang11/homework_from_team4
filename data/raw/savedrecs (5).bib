@inproceedings{ WOS:001424943400037,
Author = {Rahman, Md Moshiur and Almawzan, Rasheed and Dasgupta, Aritra and Paria,
   Sudipta and Bhunia, Swamp},
Book-Group-Author = {IEEE},
Title = {United We Protect: Protecting IP Confidentiality with Integrated
   Transformation and Redaction},
Booktitle = {2024 IEEE PHYSICAL ASSURANCE AND INSPECTION OF ELECTRONICS, PAINE 2024},
Year = {2024},
Note = {2024 IEEE Physical Assurance and Inspection of Electronics-PAINE,
   Huntsville, AL, NOV 12-14, 2024},
Abstract = {Due to the globally distributed nature of the semiconductor industry,
   hardware intellectual property (IP) blocks are increasingly subject to
   attacks on their confidentiality, including IP piracy, cloning, and
   reverse engineering (RE). Countermeasures like logic locking, state
   space transformation, and logic redaction, which employ structural and
   functional transformations on the design, promise to successfully
   prevent such attacks on hardware IP at different stages of its life
   cycle. The state-of-the-art logic locking and transformation techniques
   are generally secure against functional query-based attacks. However, in
   recent years, researchers have found that they are vulnerable to
   structural attacks that rely on identifying structural signatures. In
   comparison, logic redaction techniques replace security-critical logic
   cones and interconnects in a design with programmable fabrics, thereby
   protecting a redacted design against structural analysis-based attacks.
   However, redaction techniques incur significantly higher hardware
   overheads compared to transformation-based ones. In this paper, we
   introduce an integrative countermeasure against confidentiality attacks
   on hardware IPs that unites the complementary benefits of state space
   transformation using finite state machines (FSMs) and programmable
   fabric-based logic redaction. We provide an electronic design automation
   (EDA) framework based on the proposed algorithm that interfaces with
   commercial tool flow. We demonstrate the security and overhead benefits
   through theoretical and experimental analysis using a complete software
   implementation of the proposed countermeasure. We use several
   open-source benchmark IPs to show that the proposed unified approach
   provides significantly higher protection than transformation-based
   solutions with much lower overhead than redaction-based ones.},
Type = {Proceedings Paper},
Affiliation = {Rahman, MM (Corresponding Author), Univ Florida, Gainesville, FL 32608 USA.
   Rahman, Md Moshiur; Almawzan, Rasheed; Dasgupta, Aritra; Paria, Sudipta; Bhunia, Swamp, Univ Florida, Gainesville, FL 32608 USA.},
DOI = {10.1109/PAINE62042.2024.10792848},
Keywords = {State Space Transformation; Logic Redaction; Hardware Intellectual
