@article{ WOS:000658349200010,
Author = {Choi, Jong-Moon and Kwon, Do-Wan and Woo, Je-Joong and Park, Eun-Je and
   Kwon, Kee-Won},
Title = {Implementation of an On-Chip Learning Neural Network IC Using Highly
   Linear Charge Trap Device},
Journal = {IEEE TRANSACTIONS ON CIRCUITS AND SYSTEMS I-REGULAR PAPERS},
Year = {2021},
Volume = {68},
Number = {7},
Pages = {2863-2875},
Month = {JUL},
Abstract = {This paper presents an IC implementation of on-chip learning neural
   network accelerator using highly linear CMOS-compatible floating gate
   charge trap devices. A simple learning algorithm utilizing
   winner-take-all and competitive learning is proposed to design fast and
   power-efficient hardware. This algorithm was analyzed with behavioral
   model of emerging non-volatile memory via MATLAB. The linearity,
   symmetry, and cycle-to-cycle variation of multi-bit switching
   characteristic affects training accuracy. The proposed content-aware
   programming technique of modulated column line driver provides
   flexibility for real-time training while maintaining device linearity,
   despite having to update a different step for every unit cell and
   training. The prototype IC is embedded in the process-in-memory
   structure for energy efficient computing, in which cell arrays were
   divided into 4 sub-blocks to reduce I-R drop. The prototype IC
   fabricated using 180nm CMOS technology consumes 353.3pJ and 898.2pJ
   during inference and training mode, which corresponds 95.05TOPS/W and
   38.03 TOPS/W, respectively. The fully integrated non-volatile AI IC with
   on-chip solution is demonstrated with throughput of 1343.2 GOPS.},
Type = {Article},
Affiliation = {Kwon, KW (Corresponding Author), Sungkyunkwan Univ, Dept Informat \& Commun Engn, Suwon 16419, South Korea.
   Choi, Jong-Moon; Woo, Je-Joong; Park, Eun-Je, Samsung Elect Co Ltd, Memory Div, Hwaseong 18448, South Korea.
   Choi, Jong-Moon, Sungkyunkwan Univ, Dept Elect \& Comp Engn, Suwon 16419, South Korea.
   Kwon, Do-Wan, Samsung Elect Co Ltd, Syst LSI Div, Hwaseong 18448, South Korea.
   Kwon, Do-Wan, Sungkyunkwan Univ, Dept Semicond \& Display Engn, Suwon 16419, South Korea.
   Kwon, Kee-Won, Sungkyunkwan Univ, Dept Informat \& Commun Engn, Suwon 16419, South Korea.},
DOI = {10.1109/TCSI.2021.3071872},
Keywords = {Integrated circuits; System-on-chip; Training; Computer architecture;
   Linearity; Switches; Microprocessors; On-chip solution; floating gate;
   real-time training; competitive learning; feedforward; I-R drop},
Keywords-Plus = {IN-MEMORY},
