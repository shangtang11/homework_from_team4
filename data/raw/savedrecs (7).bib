Year = {2023},
Volume = {13835},
Pages = {66-79},
Note = {28th International Conference on Parallel and Distributed Computing
   (Euro-Par), Glasgow, SCOTLAND, AUG 22-26, 2022},
Abstract = {Vipera provides a compiler and runtime framework for implementing
