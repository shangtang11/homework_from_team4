@inproceedings{ WOS:000861612702007,
Author = {Hendrickx, Lotte and Van Ranst, Wiebe and Goedeme, Toon},
Book-Group-Author = {IEEE},
Title = {Hot-started NAS for Task-specific Embedded Applications},
Booktitle = {2022 IEEE/CVF CONFERENCE ON COMPUTER VISION AND PATTERN RECOGNITION
   WORKSHOPS, CVPRW 2022},
Series = {IEEE Computer Society Conference on Computer Vision and Pattern
