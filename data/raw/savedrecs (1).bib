@article{ WOS:001459534500001,
Author = {Shi, Yayong and Zhu, Haiyan and Wang, Rui},
Title = {Sparse mobile crowd sensing in low-resource computing environments: An
   active spatio-temporal fracture approach},
Journal = {COMPUTER NETWORKS},
Year = {2025},
Volume = {263},
Month = {MAY},
Abstract = {Different perspectives of data present distinct features, and diverse
   downstream tasks have varying requirements for feature compression.
   However, lossy compression frequently overlooks outlier features,
   resulting in the loss of crucial features and failing to satisfy the
   diverse needs of downstream tasks for feature extraction and multi-scale
   error reconstruction. Therefore, this paper puts forward a Task-Oriented
   Framework for Feature Adaptation and Multi-Scale Compression (TOF-ZIP).
   First, we introduce a novel data summarization method that leverages the
   self-attention mechanism of graph neural networks to assign weights to
   key data features. This method constructs a sparse data summary and
   addresses the issue of key feature loss through adaptive compression.
   Second, we adopt a tree-based multi-precision compression method. This
   method recursively splits data blocks, calculates approximate values and
   residuals, stores them in a tree structure, and combines nodes as
   required to achieve multi-scale compression. We validated the
   performance of the framework through situational awareness tasks and raw
   data error reconstruction tasks. We evaluated its compression
   performance on various datasets using multiple metrics, including
   perceptual error, compression ratio, and decompression time.
   Additionally, we conducted further validation of the model's
   effectiveness through end-to-edge data transmission experiments.
   Experimental results show that TOF-ZIP attains or approaches
   state-of-the-art performance across multiple evaluation metrics.},
Type = {Article},
