Title = {Revisiting Challenges for Selective Data Protection of Real Applications},
Booktitle = {APSYS `21: PROCEEDINGS OF THE 12TH ACM SIGOPS ASIA-PACIFIC WORKSHOP ON
   SYSTEMS},
Year = {2021},
Pages = {138-145},
Note = {12th ACM SIGOPS Asia-Pacific Workshop on Systems (APSys), ELECTR
   NETWORK, AUG 24-25, 2021},
Abstract = {Selective data protection is a promising technique to defend against the
   data leakage attack. In this paper, we revisit technical challenges that
   were neglected when applying this protection to real applications. These
   challenges include the secure input channel, granularity conflict, and
   sensitivity conflict. We summarize the causes of them and propose
   corresponding solutions. Then we design and implement a prototype system
   for selective data protection and evaluate the overhead using the RISC-V
   Spike simulator. The evaluation demonstrates the efficiency (less than
   3\% runtime overhead with optimizations) and the security guarantees
   provided by our system.},
