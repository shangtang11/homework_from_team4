@inproceedings{ WOS:001553983100006,
Author = {Oster, Joe and DeLozier, Christian},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Preventing Client-Side Exploits in Games with Capability Architectures},
Booktitle = {2025 IEEE/ACM 9TH INTERNATIONAL WORKSHOP ON GAMES AND SOFTWARE
   ENGINEERING, GAS},
Series = {International Workshop on Games and Software Engineering},
Year = {2025},
Pages = {41-42},
Note = {9th International Workshop on Games and Software Engineering-GAS,
   Ottawa, CANADA, APR 29, 2025},
Abstract = {Client-side exploits, such as wall-hacks and aimbots, affect the
   competitive integrity of games. Competitive games prevent such exploits
   through kernel-level monitoring that not only invades the player's
   privacy but also potentially opens a channel for kernel-level attacks on
   the player's computer.
   Capability architectures, which attach additional metadata to memory,
   offer a solution to preventing client-side exploits that can be
   palatable to both players and game designers. By compartmentalizing
   memory with restricted permissions, games can prevent players from
   viewing or modifying memory associated with the game directly. However,
   games need not have access to the entire system at the kernel-level to
   perform this task. We propose integrating a first-person shooter running
   on Linux within a modern capability architecture.},
Type = {Proceedings Paper},
Affiliation = {Oster, J (Corresponding Author), US Naval Acad, Elect \& Comp Engn, Annapolis, MD 21402 USA.
