Affiliation = {Yamada, Y (Corresponding Author), Tokyo Inst Technol, Sch Comp, Tokyo, Japan.
   Yamada, Yuji; Berjab, Nesrine; Yoneda, Tomohiro; Kise, Kenji, Tokyo Inst Technol, Sch Comp, Tokyo, Japan.},
