@inproceedings{ WOS:001253690000072,
Author = {Derasari, Preet and Venkataramani, Guru},
Book-Group-Author = {Assoc Computing Machinery},
Title = {EPIC: Efficient and Proactive Instruction-level Cyberdefense},
Booktitle = {PROCEEDING OF THE GREAT LAKES SYMPOSIUM ON VLSI 2024, GLSVLSI 2024},
Series = {Proceedings - Great Lakes Symposium on VLSI},
Year = {2024},
Pages = {409-414},
Note = {34th Great Lakes Symposium on VLSI (GLSVLSI), Clearwater, FL, JUN 12-14,
   2024},
Abstract = {In the evolving cyber-threats landscape, conventional security defenses
   often fall short, relying on reactive countermeasures that limit their
   ability to address the attack vectors that adapt over time. Proactive
   defense strategies, such as cyber deception and Moving Target Defense
   (MTD), aim to pre-emptively control the attack surface and redirect or
   drain the adversaries actively. Currently, their adoption is hindered by
   high runtime costs that further limit their scalability for real-world
   deployments.
   In this paper, we introduce EPIC, a proactive defense framework that
   smartly leverages hardware support at the instruction level granularity.
   Recognizing the efficiency gaps in existing solutions, incorporates a
   hardware-level instruction manipulation unit that is seamlessly
   integrated with the processor pipeline, thereby providing the defenders
   with the ability to intercept malicious behavior dynamically and alter
   the program outcomes. The framework incorporates the flexibility for the
   user to define custom instruction filter policies and manufacture honey
   resources for controlled engagement with the attackers. Our evaluation
   establishes EPIC as a novel and efficient, proactive defense solution,
   addressing the limitations in current cyber defense approaches, and
   reduces the system runtime impact from 5.3x (in current software-based
   solutions) to 21\% using our hardware support.},
Type = {Proceedings Paper},
Affiliation = {Derasari, P (Corresponding Author), George Washington Univ, Washington, DC 20052 USA.
   Derasari, Preet; Venkataramani, Guru, George Washington Univ, Washington, DC 20052 USA.},
DOI = {10.1145/3649476.3658749},
