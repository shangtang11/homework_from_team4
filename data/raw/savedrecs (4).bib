Affiliation = {Budak, U (Corresponding Author), Tech Univ Munich, Chair Secur Informat Technol, Munich, Germany.
   Budak, Utku; Sigl, Georg, Tech Univ Munich, Chair Secur Informat Technol, Munich, Germany.
