@inproceedings{ WOS:001420205900019,
Author = {Gupta, Sundesh and Shah, Aditya and Shah, Miten and Syiemlieh, Laribok
   and Maurya, Chandresh},
Editor = {Lee, M and Mantoro, T and Ayu, MA and Wong, KW and Hidayanto, AN},
Title = {FiLMing Multimodal Sarcasm Detection with Attention},
