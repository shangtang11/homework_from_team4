@article{ WOS:001290420300001,
Author = {Yu, Bengong and Wang, Haoyu and Xi, Zhonghao},
Title = {Multifaceted and deep semantic alignment network for multimodal sarcasm
   detection},
Journal = {KNOWLEDGE-BASED SYSTEMS},
Year = {2024},
Volume = {301},
Month = {OCT 9},
Abstract = {Multimodal sarcasm detection uses information from different sources to
   determine whether there is a discrepancy between the literal and implied
   meaning of the text and whether the target possesses a sarcastic
   inclination. Most recent research has focused on capturing
   inconsistencies between text and images through attention mechanisms or
   graph neural networks, among other methods. However, these studies have
   provided a coarse-grained detection of inconsistencies across various
   aspects, neglecting the multifaceted features of incoherence in terms of
   emotion and syntax. Therefore, starting from a finer-grained analysis of
   the sarcastic characteristics, this study proposes a new model named
   MDSAN(multifaceted and deep semantic alignment network). The MDSAN model
   consists of two incongruity capture modules (semantic extraction module
   (SEM) and emotion inversion detection Module (EID)) and a deep
   cross-modality distillation and alignment module (DCIE). The SEM module
   integrates prior knowledge and leverages a multihead mechanism to mine
   incoherent textual semantic information from multiple layers. The EID
   module begins with the Kantorovich problem and uses the Sinkhorn
   algorithm to minimize the cost flow of textual and pictorial
   distributions in the emotional space, quantifying the emotional
   inversion degree of text-image pairs to assist in sarcasm detection. In
   addition, the DCIE module uses sequence distillation and an improved
   cross-attention mechanism guided by mutual information to facilitate
   deep cross-modal global feature interaction. Extensive experiments and
   tests on commonly used benchmarks have shown that the proposed method is
   effective and superior.},
Type = {Article},
Affiliation = {Yu, BG (Corresponding Author), Hefei Univ Technol, Sch Management, Tunxi Rd, Hefei 230009, Anhui, Peoples R China.
   Yu, Bengong; Wang, Haoyu; Xi, Zhonghao, Hefei Univ Technol, Sch Management, Tunxi Rd, Hefei 230009, Anhui, Peoples R China.
