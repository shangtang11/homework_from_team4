Title = {Simodense: a RISC-V softcore optimised for exploring custom SIMD
   instructions},
Booktitle = {2021 31ST INTERNATIONAL CONFERENCE ON FIELD-PROGRAMMABLE LOGIC AND
   APPLICATIONS (FPL 2021)},
