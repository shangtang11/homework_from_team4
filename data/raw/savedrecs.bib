   Lee, Na Kyung; Lee, Young Seo, Soongsil Univ, Sch Elect Engn, Seoul 06978, South Korea.},
DOI = {10.32604/cmc.2025.069976},
Keywords = {Edge AI; DRAM reliability; error protection; bit-flip error; deep neural
   networks},
