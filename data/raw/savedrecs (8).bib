   Yang, Chen, Xi An Jiao Tong Univ, Sch Microelect, Xian 710049, Peoples R China.},
DOI = {10.1109/TCSI.2022.3163970},
EarlyAccessDate = {APR 2022},
Keywords = {Homomorphic encryption; reconfigurable PE; multi-core architecture;
   NTT/INTT; RNS; BFV scheme},
