@article{ WOS:001554326900012,
Author = {Belleville, Nicolas},
Title = {Genelle et al. Revisited: Masking an AES Round With Only Four Secure
   ANDs},
Journal = {IEEE EMBEDDED SYSTEMS LETTERS},
Year = {2025},
Volume = {17},
Number = {4},
Pages = {210-213},
Month = {AUG},
Abstract = {Side-channel attacks are very efficient against AES implementations. In
   consequence, countermeasures are needed. Many works studied how to
   efficiently mask the AES, and in particular its SBox. In this letter, we
   revisit Genelle et al. approach based on secure conversion between
   Boolean and multiplicative masking, and show that with bitslicing along
   with other optimizations it enables computing a whole round with only
   four secure ANDs (SecAnd), making it very competitive in terms of
   performance. In particular, our second-order implementation is 1.18 x
   faster than a fixsliced implementation, for similar binary size and
   security.},
