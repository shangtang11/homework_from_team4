@inproceedings{ WOS:001323732800003,
Author = {Ganesan, Karthikeyan Sabari and Gupta, Shivam and Kandele, Suyash and
   Kumar, Sudesh and Maddipati, Harika Chowdary and Sahu, Rajeev Anand and
   Saraswat, Vishal},
Book-Group-Author = {ACM},
Title = {Quantum-Resilient Security Controls},
Booktitle = {PROCEEDINGS OF RECENT ADVANCES IN QUANTUM COMPUTING AND TECHNOLOGY,
   REAQCT 2024},
Year = {2024},
Pages = {12-19},
Note = {Recent Advances in Quantum Computing and Technology conference (ReAQCT),
   Budapest, HUNGARY, JUN 19-20, 2024},
Abstract = {Authentication, integrity, and confidentiality are primary security
   requirements in the digital communication. These properties facilitate
   robust security controls such as secure boot, secure update, secure
   access, and secure TLS across connected devices. In the heart of these
   security features are traditional cryptographic algorithms which are
   vulnerable to powerful quantum attacks. In this paper, we present
   quantum-resilient implementations for the aforementioned security
   controls. Leveraging NIST-recommended algorithms -CRYSTALS-Kyber,
   CRYSTALS-Dilithium, FALCON, XMSS, and SPHINCS+- our solutions not only
   withstand quantum attacks, but also outperform their classical
   counterparts in efficiency and flexibility for various use cases.},
Type = {Proceedings Paper},
Affiliation = {Ganesan, KS (Corresponding Author), Bosch Global Software Technol, Bangalore, Karnataka, India.
   Ganesan, Karthikeyan Sabari; Gupta, Shivam; Kandele, Suyash; Kumar, Sudesh; Maddipati, Harika Chowdary; Sahu, Rajeev Anand; Saraswat, Vishal, Bosch Global Software Technol, Bangalore, Karnataka, India.},
DOI = {10.1145/3665870.3665877},
Keywords = {Quantum-resilient; Post-Quantum Cryptography; Secure boot; Secure
   access; Secure update; Secure TLS; Connected devices; NIST
   standardization.},
Author-Email = {karthikeyansabari.ganesan@in.bosch.com
   shivam.gupta@in.bosch.com
