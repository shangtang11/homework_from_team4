@inproceedings{ WOS:001441178200076,
Author = {Aviles, Robert S. and Beerel, Peter A.},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {A Joint Optimization of Buffer and Splitter Insertion for Phase-Skipping
   Adiabatic Quantum-Flux-Parametron Circuits},
Booktitle = {2024 IEEE 42ND INTERNATIONAL CONFERENCE ON COMPUTER DESIGN, ICCD},
Series = {Proceedings IEEE International Conference on Computer Design},
Year = {2024},
Pages = {534-541},
Note = {42nd International Conference on Computer Design, Milan, ITALY, NOV
   18-20, 2024},
Abstract = {Adiabatic Quantum-Flux-Parametron (AQFP) logic is a promising emerging
   device technology with six orders of magnitude lower power than CMOS.
   However, AQFP is challenged by the fact that every gate must be clocked,
   where proper data transfer requires connected gates to have shifted but
   overlapping clocks. As a result, buffers need to be used to balance
   reconvergent logic paths, a problem that is exacerbated by every
   multi-node fanout needing a tree of clocked splitters. Recent AQFP
   circuit design techniques have offered an opportunity to reduce buffer
   costs by supporting a notion of phase-skipping but the EDA support for
   these advanced circuits is limited. This paper proposes the first
   algorithm to optimize buffer and splitter insertion for phase-skipping
   AQFP circuits and achieves over 31\% savings over existing buffer
   reduction schemes and up to 74\% savings in buffers and splitter costs
   over the SOTA non-phase skipping circuits. The code used in our
   experiments can be accessed at:
   https://github.com/robertsaviles/AQFP-Phase-Skipping.git.},
Type = {Proceedings Paper},
Affiliation = {Aviles, RS (Corresponding Author), Univ Southern Calif, Ming Hsieh Dept ECE, Los Angeles, CA 90007 USA.
   Aviles, Robert S.; Beerel, Peter A., Univ Southern Calif, Ming Hsieh Dept ECE, Los Angeles, CA 90007 USA.},
DOI = {10.1109/ICCD63220.2024.00088},
Keywords = {AQFP Clocking; Synthesis for Emerging Devices; Gate-Level Clocking},
Author-Email = {rsaviles@usc.edu
   pabeerel@usc.edu},
Affiliations = {University of Southern California},
Cited-References = {Ayala CL, 2020, SUPERCOND SCI TECH, V33, DOI 10.1088/1361-6668/ab7ec3.
