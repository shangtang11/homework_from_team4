@article{ WOS:001644185400001,
Author = {Freitas, Edney M. V. and Guimaraes, Nicolas and Maria, Rafael and Costa,
   Felipe and Milani, Guilherme and Sanches, Bruno and Van Noije, Wilhelmus},
Title = {Using open source EDA tools in ASICs for HEP: A mixed comparison},
Journal = {JOURNAL OF INSTRUMENTATION},
