@article{ WOS:001473091500018,
Author = {Rattanavipanon, Norrathep and Nunes, Ivan De Oliveira},
Title = {SLAPP: Poisoning Prevention in Federated Learning and Differential
   Privacy via Stateful Proofs of Execution},
Journal = {IEEE TRANSACTIONS ON INFORMATION FORENSICS AND SECURITY},
Year = {2025},
Volume = {20},
Pages = {4167-4182},
Abstract = {The rise of IoT-driven distributed data analytics, coupled with
   increasing privacy concerns, has led to a demand for effective
   privacy-preserving and federated data collection/model training
   mechanisms. In response, approaches such as Federated Learning (FL) and
   Local Differential Privacy (LDP) have been proposed and attracted much
   attention over the past few years. However, they still share the common
   limitation of being vulnerable to poisoning attacks wherein adversaries
   compromising edge devices feed forged (a.k.a. ``poisoned{''}) data to
   aggregation back-ends, undermining the integrity of FL/LDP results. In
   this work, we propose a system-level approach to remedy this issue based
   on a novel security notion of Proofs of Stateful Execution ( PoSX ) for
   IoT/embedded devices' software. To realize the PoSX concept, we design
   SLAPP : a System-Level Approach for Poisoning Prevention. SLAPP
   leverages commodity security features of embedded devices - in
   particular ARM TrustZone-M security extensions - to verifiably bind raw
   sensed data to their correct usage as part of FL/LDP edge device
   routines. As a consequence, it offers robust security guarantees against
   poisoning. Our evaluation, based on real-world prototypes featuring
   multiple cryptographic primitives and data collection schemes, showcases
   SLAPP `s security and low overhead.},
Type = {Article},
Affiliation = {Rattanavipanon, N (Corresponding Author), Prince Songkla Univ, Coll Comp, Phuket 83120, Thailand.
   Rattanavipanon, Norrathep, Prince Songkla Univ, Coll Comp, Phuket 83120, Thailand.
   Nunes, Ivan De Oliveira, Univ Zurich, Dept Informat, SPINS Grp, CH-8006 Zurich, Switzerland.},
DOI = {10.1109/TIFS.2025.3555179},
Keywords = {Internet of Things; Training; Prevention and mitigation; Data
   collection; Distributed databases; Cryptography; Vectors; Privacy; Noise
   measurement; Federated learning; Proofs of execution; poisoning attacks;
   federated learning; local differential privacy; embedded systems
   security},
