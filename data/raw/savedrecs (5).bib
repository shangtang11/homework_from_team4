@inproceedings{ WOS:001253690000074,
Author = {Jin, Shaoqian and Li, Yulin and Chen, Liwei and Shi, Gang},
Book-Group-Author = {Assoc Computing Machinery},
Title = {SSFuzz: Generating syntactic and semantic seeds for RISC-V processors},
Booktitle = {PROCEEDING OF THE GREAT LAKES SYMPOSIUM ON VLSI 2024, GLSVLSI 2024},
Series = {Proceedings - Great Lakes Symposium on VLSI},
Year = {2024},
Pages = {421-426},
Note = {34th Great Lakes Symposium on VLSI (GLSVLSI), Clearwater, FL, JUN 12-14,
   2024},
Abstract = {As processor complexity increases, the significance of fuzz testing for
   identifying vulnerabilities escalates. The effectiveness of fuzz testing
   is closely linked to the quality of its seeds. Randomly generated
   fuzzing seeds are often inefficient and struggle to thoroughly explore
   the processor's state. In contrast, high-quality seeds improve register
   coverage and accelerate bug detection. In our research, we refine seed
   optimization through syntactic and semantic analysis. We introduce
   SSFuzz, a fuzzer designed to generate superior seeds by employing syntax
   for mutations and expansions, and by utilizing diverse semantics to
   deepen seed instruction logic. This approach enables a more rapid
   exploration of the processor's state space and facilitates the discovery
   of bugs more efficiently. Utilizing ANTLR4{[}8], we convert code into
   Abstract Syntax Trees (AST) for seed generation and mutation, while also
   augmenting seed control flow to boost instruction execution rates. By
   guiding the insertion of semantically rich code fragments through
   coverage feedback, we enhance the effectiveness of our methodology. Our
   experiments validate the strategy's success, demonstrating significant
   improvements in seed execution rates and register coverage on
   Rocket{[}1] and Boom{[}15] processors.},
Type = {Proceedings Paper},
Affiliation = {Jin, SQ (Corresponding Author), Chinese Acad Sci, Inst Informat Engn, Beijing, Peoples R China.
   Jin, SQ (Corresponding Author), Univ Chinese Acad Sci, Sch Cyber Secur, Beijing, Peoples R China.
