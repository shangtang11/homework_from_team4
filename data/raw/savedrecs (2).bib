@article{ WOS:001425473300001,
Author = {Huang, Heqing and Li, Chunbiao and Cen, Xiaoliang and Gao, Yikai and
   Liu, Wangyu},
Title = {A Class of Two-Dimensional Offset-Boostable Chaotic Systems with
   Transcendental Functions},
Journal = {INTERNATIONAL JOURNAL OF BIFURCATION AND CHAOS},
Year = {2025},
Volume = {35},
Number = {03},
Month = {MAR 15},
Abstract = {Chaos regulation, including polarity control and offset boosting, is a
   new topic with active research for chaos-related applications. Chaotic
   systems with multiple offset-boostable variables provide more signal
   candidates with desired polarities and average values for application of
   chaos to secure communication. In this paper, we propose a new class of
   two-dimensional offset-boostable chaotic systems with exponential or
   logarithmic feedback functions. These systems provide two independent
   constants for nonbifurcating offset boosting in different regimes. The
   systems with transcendental functions are realized under the
   combinations of transistor and operational amplifiers, proving directly
   two-dimensional offset boosting.},
