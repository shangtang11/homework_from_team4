@inproceedings{ WOS:001062240300008,
Author = {Poellny, Oliver and Held, Albert and Kargl, Frank},
Editor = {Spencer, SN},
Title = {Steering Your Car With Electromagnetic Fields},
Booktitle = {PROCEEDINGS OF 6TH ACM COMPUTER SCIENCE IN CARS SYMPOSIUM, CSCS 2022},
Year = {2022},
Note = {6th ACM Computer Science in Cars Symposium (CSCS), Tech Hochschule
   Ingolstadt, Ingolstadt, GERMANY, DEC 08, 2022},
Abstract = {Several advanced driver assistance systems require a reliable angle of
   the steering wheel as input for their control-loop cycle. This research
   investigates attacks on the steering wheel angle sensor with
   electromagnetic fields. We present measurement data showing that an
   angle of 160 degrees or larger can be injected into the steering wheel
   angle sensor using a Helmholz coil. Further, this paper describes the
   reaction of the steering system on this manipulation. The most
   interesting observations were full use of an injected steering wheel
   angle by the receiving system if the injection started before the
   vehicle was started. Additionally, we describe the failure detection in
   the electric stability control and discuss existing compensating
   measures as well as possible mitigation measures.},
Type = {Proceedings Paper},
Affiliation = {Pöllny, O (Corresponding Author), Res \& Dev Mercedes Benz AG, Boblingen, Germany.
   Pöllny, O (Corresponding Author), Univ Ulm, Ulm, Germany.
   Poellny, Oliver, Res \& Dev Mercedes Benz AG, Boblingen, Germany.
   Poellny, Oliver, Univ Ulm, Ulm, Germany.
   Held, Albert, Res \& Dev Mercedes Benz AG, Sindelfingen, Germany.
   Kargl, Frank, Ulm Univ, Dept Distributed Syst, Ulm, Germany.},
