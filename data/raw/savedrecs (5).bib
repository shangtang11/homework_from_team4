@inproceedings{ WOS:001451879300016,
Author = {Wang, You and Zhang, Chaoyue and Xu, Yefan and Gong, Yu and Cai, Hao and
   Liu, Weiqiang},
Book-Group-Author = {IEEE},
Title = {Truly Random Number Generation by Using in-Plane Magnetic Tunnel
   Junction with Weak Anisotropy},
Booktitle = {2024 ASIAN HARDWARE ORIENTED SECURITY AND TRUST SYMPOSIUM, ASIANHOST},
Year = {2024},
Note = {2024 Asian Hardware Oriented Security and Trust Symposium, Kobe, JAPAN,
   DEC 16-18, 2024},
Abstract = {True random number generator (TRNG) is a key block of security
   applications which need cryptographic protections. However, most of the
   conventional TRNGs which use physical randomness are with high
   complexity and considerable power consumption. As for the recently
   proposed TRNGs by using non-volatile memory devices, the process for
   generation is complicated, which needs usually several steps to generate
   one bit, resulting in low throughput and redundant energy consumption.
   This paper proposes a novel implementation of TRNG by using the
   intrinsic randomness of in-plane magnetic tunnel junction with weak
   anisotropy. As the process of random writing is eliminated for in-plane
   magnetic tunnel junction with weak anisotropy, the generation of random
   bit is largely simplified and accelerated. With the feature of
   non-volatility and simplified generation process, this design may
   improve drastically the throughput and reduce the design complexity and
   energy consumption.},
