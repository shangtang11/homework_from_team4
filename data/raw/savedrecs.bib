@article{ WOS:001730963900001,
Author = {Li, Wenqian and Wei, Hanyu and Shen, Shiyu and Yang, Hao and Dai,
   Wangchen and Zhao, Yunlei},
Title = {cuFalcon: An Adaptive Parallel GPU Implementation for High-Performance
   Falcon Acceleration},
