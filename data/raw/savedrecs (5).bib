   Van Tinh Nguyen, Quy Don Tech Univ, Hanoi, Vietnam.},
DOI = {10.1109/ISOCC62682.2024.10762699},
Keywords = {RISC-V; SoC; FPGA; Lightweight Cryptography},
Author-Email = {pham.luan@is.naist.jp},
Affiliations = {Vietnam National University Ho Chi Minh City (VNUHCM) System; VNU-HCM
   University of Information Technology (VNUHCM-UIT); Nara Institute of
   Science \& Technology},
