@inproceedings{ WOS:001253778900046,
Author = {Million, Davy and Oliete-Escuin, Noelia and Fuguet, Cesar},
Book-Group-Author = {IEEE},
Title = {Breaking the Memory Wall with a Flexible Open-Source L1 Data-Cache},
Booktitle = {2024 DESIGN, AUTOMATION \& TEST IN EUROPE CONFERENCE \& EXHIBITION, DATE},
Series = {Design Automation and Test in Europe Conference and Exhibition},
Year = {2024},
Note = {27th Design, Automation and Test in Europe Conference and Exhibition
   (DATE), Valencia, SPAIN, MAR 25-27, 2024},
Abstract = {The lack of concurrency and pipelining in the memory sub-system of
   recent open-source RISC-V processors, such as the CVA6(1), is
   increasingly becoming the performance bottleneck. Recent updates to the
   new RISC-V High Performance L1 Data-cache (HPDcache), now fully
   integrated with the CVA6, bring significant (up to +234\%) speedups in
   key benchmarks with a negligible 5.92\% area impact. In this short
   paper, we detail these improvements, compare performance with existing
   caches and highlight the benefits of this new, open-source data-cache.},
