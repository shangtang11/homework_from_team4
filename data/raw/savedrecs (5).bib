   Shouyi},
Book-Group-Author = {IEEE},
Title = {GRS:A General RISC-V SIMD Vector Acceleration Processor for Artificial
   Intelligence Applications},
Booktitle = {2024 IEEE THE 20TH ASIA PACIFIC CONFERENCE ON CIRCUITS AND SYSTEMS,
   APCCAS 2024},
Series = {IEEE Asia-Pacific Conference on Circuits and Systems},
Year = {2024},
Pages = {702-706},
Note = {20th Asia-Pacific Conference on Circuits and Systems, Taipei, TAIWAN,
   NOV 07-09, 2024},
Abstract = {In this paper, we present GRS (General RISC-V SIMD), a 64-bit vector
   processor based on the RISC-V's vector extension, for Artificial
   Intelligence applications. This article proposes an improvement scheme
   with three characteristics. Firstly, GRS supports the Call Mechanism of
   Quad Pipelining (CMQP) in certain optimization scenarios to skip certain
   pipelining levels while performing repetitive or redundant calculations.
   Secondly, GRS adopts a Lane Self Tuning Technique (LSTT) to match
   different computational task requirements. Thirdly, GRS adds Logic
   Operation Capabilities Inside (LOCI) to the vector processing unit to
   share and reduce the interaction cost of control logic to further
   improve chip performance. Compared with the advanced vector processor
   ARA, the energy consumption of GRS has been 1.77 times by using a 28nm
   CMOS process for evaluation.},
