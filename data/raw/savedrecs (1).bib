   Zhiqiang},
Title = {Design of Arithmetic Units for Vector Processors Based on Carbon-Based
   Technology},
Journal = {IEICE ELECTRONICS EXPRESS},
Year = {2025},
Volume = {22},
Number = {21},
Month = {NOV 10},
Abstract = {Vector processors are widely used in high-performance computing (HPC)
   due to their flexibility and energy efficiency{[}1-3]. However, their
   performance scaling is increasingly constrained as silicon technology
   approaches its physical limits. This paper investigates carbon-based
   arithmetic units as a promising alternative for vector processors.
   Through simulations, we demonstrate that CNT arithmetic unit achieves
   33\% lower latency than silicon at the 0.5 mu m node. And at sub-10nm
   technology nodes, CNT-based designs exhibit a 7x speedup compared to
   conventional silicon FinFET implementations. These results highlight
   CNT's superior scaling characteristics and its strong potential as a
   next-generation computing technology.},
