@inproceedings{ WOS:000403396000011,
Author = {Esteves-Verissimo, Paulo and Volp, Marcus and Decouchant, Jeremie and
   Rahli, Vincent and Rocha, Francisco},
Editor = {Kim, DS and Kitakami, M and Varadharajan, V},
Title = {Meeting the Challenges of Critical and Extreme Dependability and
   Security},
Booktitle = {2017 IEEE 22ND PACIFIC RIM INTERNATIONAL SYMPOSIUM ON DEPENDABLE
   COMPUTING (PRDC 2017)},
Series = {IEEE Pacific Rim International Symposium on Dependable Computing},
Year = {2017},
Pages = {92-97},
Note = {IEEE 22nd Pacific Rim International Symposium on Dependable Computing
   (PRDC), Christchurch, NEW ZEALAND, JAN 22-25, 2017},
Abstract = {The world is becoming an immense critical information infrastructure,
   with the fast and increasing entanglement of utilities,
   telecommunications, Internet, cloud, and the emerging IoT tissue. This
   may create enormous opportunities, but also brings about similarly
   extreme security and dependability risks. We predict an increase in very
   sophisticated targeted attacks, or advanced persistent threats (APT),
   and claim that this calls for expanding the frontier of security and
   dependability methods and techniques used in our current CII. Extreme
   threats require extreme defenses: we propose resilience as a unifying
   paradigm to endow systems with the capability of dynamically and
   automatically handling extreme adversary power, and sustaining perpetual
   and unattended operation. In this position paper, we present this vision
   and describe our methodology, as well as the assurance arguments we make
   for the ultra-resilient components and protocols they enable,
   illustrated with case studies in progress.},
