@inproceedings{ WOS:001482656700042,
Author = {Jiang, Liguo and Li, Bo and Liu, Ping},
Book-Group-Author = {IEEE},
Title = {Efficient Thermal Simulation Method for 3-D Chiplets Heterogeneous
   Integrated Systems},
Booktitle = {2024 IEEE MTT-S INTERNATIONAL MICROWAVE WORKSHOP SERIES ON ADVANCED
   MATERIALS AND PROCESSES FOR RF AND THZ APPLICATIONS, IMWS-AMP},
Series = {IEEE MTT-S International Microwave Workshop Series on Advanced Materials
   and Processes for RF and THz Applications},
Year = {2024},
Note = {2024 IEEE MTT-S International Microwave Workshop Series on Advanced
   Materials and Processes for RF and THz Applications-IMWS-AMP, Nanjing,
   PEOPLES R CHINA, NOV 09-11, 2024},
Abstract = {As the integration density increases, thermal issues significantly
   impact the reliability and performance of integrated circuits, making
   thermal simulation analysis crucial during the design stage. Chip
   heterogeneous integration (CHI) is an advanced packaging method, but the
   large variation in structure sizes within CHI package systems poses
   significant challenges for full-scale numerical simulation methods. This
   paper introduces a system-level thermal modeling method that combines
   the via thermal resistance model, the trace network equivalent model,
   and the thin layer boundary model. This method is applied within the
   Notus thermal tool to manage the thermal behavior of CHI package
   systems. The proposed method is validated using two typical CHI package
   systems, and the results demonstrate that, compared to traditional
   full-scale modeling method, the Notus tool significantly improves
   computational efficiency while maintaining accuracy.},
Type = {Proceedings Paper},
Affiliation = {Jiang, LG (Corresponding Author), Xpeed Co Ltd, Shanghai, Peoples R China.
   Jiang, Liguo; Li, Bo; Liu, Ping, Xpeed Co Ltd, Shanghai, Peoples R China.},
DOI = {10.1109/IMWS-AMP62793.2024.10966579},
