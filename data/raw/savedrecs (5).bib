@inproceedings{ WOS:001471864600138,
Author = {Pauls, Friedrich and Haas, Sebastian and Verma, Yogesh},
Book-Group-Author = {IEEE},
Title = {Integration of IP-Cores for the M3 Architecture with Low Area
   Overhead: Accelerator Support Module},
Booktitle = {2024 21ST INTERNATIONAL SOC DESIGN CONFERENCE, ISOCC},
Series = {International SoC Design Conference},
Year = {2024},
Pages = {340-341},
Note = {21st International SoC Design Conference-ISOCC, Sapporo, JAPAN, AUG
   19-22, 2024},
Abstract = {Smart digital systems are integral to sectors such as communications,
   power grids, and autonomous transport. As these technologies
   increasingly underpin critical societal functions, the need for robust,
   breach-resistant security architectures becomes paramount. Secure tiled
   architectures with stringent hardware isolation capabilities have been
   shown to have a minimized attack surface even when integration of
   third-party intellectual property (IP) cores is indicated. However,
   current platforms require costly adaption of IP cores to the security
   protocols these architectures provide. This paper introduces a new
   Accelerator Support Module that manages the protocol overhead of the
   underlying security architecture and offers commonly used hardware
   interfaces. This module simplifies the integration of accelerators and
   only slightly increases the area overhead.},
Type = {Proceedings Paper},
Affiliation = {Pauls, F (Corresponding Author), Barkhausen Inst, Dresden, Germany.
   Pauls, Friedrich; Haas, Sebastian; Verma, Yogesh, Barkhausen Inst, Dresden, Germany.},
DOI = {10.1109/ISOCC62682.2024.10762360},
Keywords = {Hardware/Software Co-Design; Isolation; Network-on-Chip; Operating
   System; Privacy; Security; Tiled Architecture},
