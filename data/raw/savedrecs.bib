@article{ WOS:001640141600001,
Author = {Zhang, Chunchi and Chen, Xiangyu and Liu, Jinxiu and Lu, Xin and Tang,
   Siran and Tan, Chao and Wang, Zegao},
Title = {Low-Temperature Growth of Wafer-Scale MoS2 by Chemical Vapor Deposition
   Using MoO2Cl2 Sources},
Journal = {ADVANCED MATERIALS TECHNOLOGIES},
Year = {2026},
Volume = {11},
Number = {6},
Month = {MAR},
Abstract = {After decade, the size of MoS2 film evolves from micrometers to
   wafer-scale, and the recent report of MoS2 based reduced instruction set
   computing 32-bit microprocessor exemplifies the potential of 2D
   integrated-circuit technology beyond silicon. However, the requirement
   of higher growth temperature limits its back-end of line process in
   future CMOS technology. The film transfer process can somehow overcome
   the high-temperature issues, but the none-standard fabrication as well
   as additional interfacial impurities and wrinkles render its further
   development. Therefore, low-temperature growth of MoS2 become a next key
   point for its CMOS application. Herein, molybdenum dichlorodioxide
   (MoO2Cl2) is chosen as the precursor, and its low melting point and high
   activity will help MoS2 nucleation and growth. The effect of growth
   temperature and growth duration on the crystal structure, electronic
   structure and electrical property has been systematically studied. It is
   found that the film grown at 450 degrees C has the best performance when
   balance the film quality and temperature. Furthermore, post-treatment
   with (3-mercaptopropyltrimethoxysilane)-dichloromethane (MPS-DCM)
   solution is proofed to effectively repair the sulfur vacancy, and thus
   enhance the electric-field effect with carrier mobility and ON-state
   current increasing by 640\% and 253\%, respectively. This work provides
   a feasible solution for future realization of direct integration of
   molybdenum disulfide transistors on circuits.},
