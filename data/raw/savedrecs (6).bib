@inproceedings{ WOS:001103378300005,
Author = {Crespo, Luis and Tomas, Pedro and Roma, Nuno and Neves, Nuno},
Book-Group-Author = {IEEE},
Title = {Trading Performance, Power, and Area on Low-Precision Posit MAC Units
   for CNN Training},
Booktitle = {2023 IEEE 35TH INTERNATIONAL SYMPOSIUM ON COMPUTER ARCHITECTURE AND HIGH
   PERFORMANCE COMPUTING, SBAC-PAD},
Series = {International Symposium on Computer Architecture and High Performance
   Computing},
Year = {2023},
Pages = {46-56},
Note = {35th IEEE International Symposium on Computer Architecture and High
   Performance Computing (SBAC-PAD), Pontif Catholic Univ Rio Grande do
   Sul, Tech Sch, Porto Alegre, BRAZIL, OCT 17-20, 2023},
Abstract = {The recently proposed Posit number system has been regarded as a
   particularly well-suited floating-point format to optimize the
   throughput and efficiency of low-precision computations in convolutional
   neural network (CNN) applications. In particular, the Posit format
   offers a balance between decimal accuracy and dynamic range, which
   results in a distribution of values that seems particularly interesting
   for deep learning applications. However, the adoption of the Posit still
   raises some concerns regarding hardware complexity, particularly when
   accounting for the overheads associated with the quire exact
   accumulator. Accordingly, this paper presents a holistic study on the
   model accuracy, performance, power, and area trade-offs when adopting
   low-precision Posit multiply-accumulate (MAC) units for the training of
   CNNs. In particular, 28nm ASIC implementations of a reference Posit MAC
   unit architecture demonstrate that the quire accounts for over 70\% of
   the area and power utilization, and the obtained CNN training results
   showed that its use is only strictly required when considering mixed
   low-precision configurations. As a result, reducing the size of the
   quire results in an average reduction of area and power by 57\% and
   47\%, without imposing visible training accuracy losses.},
Type = {Proceedings Paper},
Affiliation = {Crespo, L (Corresponding Author), Univ Lisbon, Inst Super Tecn, INESC ID, Lisbon, Portugal.
   Crespo, Luis; Tomas, Pedro; Roma, Nuno; Neves, Nuno, Univ Lisbon, Inst Super Tecn, INESC ID, Lisbon, Portugal.},
DOI = {10.1109/SBAC-PAD59825.2023.00014},
