@inproceedings{ WOS:001327156000287,
Author = {Liu, Tianjian and Liu, Shujuan and Hu, Xing and Dong, Fang and Chen,
   Zhen and Peng, Haoyang and Liu, Sheng},
Book-Group-Author = {IEEE},
Title = {Study on the Effect of Film Process on Interface and Interconnection
   Reliability in the TSV Structure},
Booktitle = {2024 25TH INTERNATIONAL CONFERENCE ON ELECTRONIC PACKAGING TECHNOLOGY,
   ICEPT},
Series = {International Conference on Electronic Packaging Technology},
Year = {2024},
Note = {25th International Conference on Electronic Packaging Technology
   (ICEPT), Tianjin, PEOPLES R CHINA, AUG 07-09, 2024},
Abstract = {The through silicon via (TSV) is a critical technology to provide short
   vertical interconnects for 2.5D/3D advanced packaging. But the large
   mismatch of thermal expansion coefficient (CTE) between Cu and Si/SiO2
   results in thermal stress that compromises the thermal mechanical
   reliability of TSV structures. In this study, the defects caused by
   thermal stress during film process were investigated by Focused Ion Beam
   (FIB). Through the Finite Element Analysis (FEA), we have assessed the
   influence of the liner layer thickness (THKliner) between Cu and Si and
   the interlayer dielectric thickness (THKILD), on the induced thermal
   stress. Our study elucidates the interplay between the THKuner, THKILD
   and thermal stress, confirming that these parameters significantly
   reduce thermal stress when the THKliner is set to approximately 0.4um
   and the THKILD to around 1 mu m. These dimensions are thereby identified
   as the optimal process parameters for stress minimization. This work can
   provide an important technical means for the manufacture of TSV with
   high interface and interconnected reliability, and provide an important
   reference for practical engineering problems in the high density 2.5D/3D
   integration.},
Type = {Proceedings Paper},
