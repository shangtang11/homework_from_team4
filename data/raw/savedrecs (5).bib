@inproceedings{ WOS:001468545500016,
Author = {Solouki, Mohammadreza Amel and Sini, Jacopo and Violante, Massimo},
Book-Group-Author = {IEEE},
Title = {Enhancing Automotive Embedded Applications: A Comprehensive Evaluation
   of Control Flow Checking Methods},
Booktitle = {2024 IEEE INTERNATIONAL CONFERENCE ON DESIGN, TEST AND TECHNOLOGY OF
