@article{ WOS:001062311100001,
Author = {Kallimani, Rakhee and Pai, Krishna and Raghuwanshi, Prasoon and Iyer,
   Sridhar and Lopez, Onel L. A.},
Title = {TinyML: Tools, applications, challenges, and future research directions},
Journal = {MULTIMEDIA TOOLS AND APPLICATIONS},
