@inproceedings{ WOS:001190988000040,
Author = {Kempf, Fabian and Hoefer, Julian and Hotfilter, Tim and Becker, Juergen},
Book-Group-Author = {IEEE},
Title = {A Low-Stall Methodology for an Interleaved Processor State Replication},
Booktitle = {2023 IEEE 16TH INTERNATIONAL SYMPOSIUM ON EMBEDDED MULTICORE/MANY-CORE
   SYSTEMS-ON-CHIP, MCSOC},
Series = {IEEE International Symposium on Embedded Multicore Socs},
Year = {2023},
Pages = {276-283},
Note = {16th IEEE International Symposium on Embedded Multicore/Many-core
   Systems-on-Chip (MCSoC), Singapore Univ Technol \& Design, Singapore,
   SINGAPORE, DEC 18-21, 2023},
Abstract = {In this paper, we present a novel hardware approach, which allows a
   simultaneous program execution in parallel to a state transfer. We
   introduce an interleaved state replication methodology and a
   corresponding processor architecture. Our interleaved state replication
   methodology is applicable for fast context switches which are of crucial
   importance in mixed criticality systems. To enable our novel methodology
   for interleaved state replication directly on the hardware level we
   propose an appropriate processor architecture. On this architecture we
   implement various transfer strategies and investigate them on
   representative workloads. Our experiments demonstrate a program
   execution without stalls in the best case, while the complete state is
   replicated in parallel. The interleaved state transfer achieves an
   average 84\% reduction in stall cycles compared to state of the art.},
Type = {Proceedings Paper},
Affiliation = {Kempf, F (Corresponding Author), Karlsruhe Inst Technol, Karlsruhe, Germany.
   Kempf, Fabian; Hoefer, Julian; Hotfilter, Tim; Becker, Juergen, Karlsruhe Inst Technol, Karlsruhe, Germany.},
