@article{ WOS:001635805600015,
Author = {Wu, Zhongpan and Beyene, Abel and Hammad, Karim and Ghafar-Zadeh,
   Ebrahim and Magierowski, Sebastian},
Title = {Toward an Embedded SoC for Mobile DNA Sequencing Applications},
Journal = {IEEE TRANSACTIONS ON COMPUTATIONAL BIOLOGY AND BIOINFORMATICS},
Year = {2025},
Volume = {22},
Number = {6},
Pages = {2801-2816},
Month = {NOV},
Abstract = {The development of small DNA sequencers offers a transformative
   opportunity for portable genomics. However, current systems lack
   integrated bioinformatics computing and instead rely on bulky external
   systems. To address this limitation, we propose an embedded
   System-on-Chip (SoC) architecture aimed at mobile DNA sequencing
   applications, representing an initial step towards a fully integrated
   bioinformatics solution. The proposed heterogeneous SoC leverages the
   open-source RISC-V architecture and incorporates two specialized
   bioinformatics accelerators: one for deep learning-based basecalling and
   the other for sequence alignment. An FPGA-realized basecalling
   accelerator achieves a nearly 2000x speedup over a standalone RISC-V
   core and demonstrates 11.5x and 1.2x higher energy efficiency than x86
   CPUs and high-end GPUs, respectively, while maintaining an accuracy rate
   of 83.7\%. A separate accelerator optimized for sequence comparison,
   offers 538x and 357x performance-per-joule boost relative to x86 CPUs
   and an existing state-of-the-art accelerator, respectively, while far
   exceeding other platforms. A preliminary ASIC prototype operates at 250
   MHz with a power consumption of 34 mW, demonstrating significant
   potential for the proposed approach. Overall, the proposed SoC
   architecture presents a compelling first step towards embedded
   bioinformatics hardware for mobile DNA sequencing.},
Type = {Article},
