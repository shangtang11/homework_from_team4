@inproceedings{ WOS:000805289900176,
Author = {Saikia, Jyotishman and Yin, Shihui and Cherupally, Sai Kiran and Zhang,
   Bo and Meng, Jian and Seok, Mingoo and Seo, Jae-Sun},
Book-Group-Author = {IEEE},
Title = {Modeling and Optimization of SRAM-based In-Memory Computing Hardware
   Design},
Booktitle = {PROCEEDINGS OF THE 2021 DESIGN, AUTOMATION \& TEST IN EUROPE CONFERENCE
   \& EXHIBITION (DATE 2021)},
Year = {2021},
Pages = {942-947},
Note = {Design, Automation and Test in Europe Conference and Exhibition (DATE),
   ELECTR NETWORK, FEB 01-05, 2021},
Abstract = {In-memory computing (IMC) has been demonstrated as a promising technique
   to significantly improve energy-efficiency for deep neural network (DNN)
   hardware accelerators. However, designing one involves setting many
   design variables such as the number of parallel rows to assert,
   analog-to-digital converter (ADC) at the periphery of memory sub-array,
   activation/weight precisions of DNNs, etc., which affect
   energy-efficiency, DNN accuracy, and area. While individual IMC designs
   have been presented in the literature, they have not investigated this
   multi-dimensional design optimization. In this paper, to fill this
   knowledge gap, we present a SRAM-based IMC hardware modeling and
   optimization framework. A unified systematic study closely models IMC
   hardware, and investigates how a number of design variables and
   non-idealities (e.g. device mismatch and ADC quantization) affect the
   DNN accuracy of IMC design. To maintain high DNN accuracy for the IMC
   SRAM hardware, it is shown that the number of activated rows, ADC
   resolution, ADC quantization range, and different sources of
   variability/noise need to be carefully selected and co-optimized with an
   underlying DNN algorithm to implement.},
