@article{ WOS:000692940000001,
Author = {Malysheva, Lyuba},
Title = {Solution of the Spectral Problem for (2m,m) Carbon Nanotubes by
   Green's Function Method},
Journal = {PHYSICA STATUS SOLIDI B-BASIC SOLID STATE PHYSICS},
Year = {2021},
Volume = {258},
Number = {11},
Month = {NOV},
Abstract = {The exact solution of the spectral problem for an infinite (2m,m) carbon
   nanotube (CNT) is obtained from the analytic solution to the Schrodinger
   equation for the tight-binding Huckel-type Hamiltonian. Explicit
   expressions for Green's functions of chiral (2m,m) CNTs are obtained and
   the electronic structure of these CNTs is discussed. The (2m,m)
   nanotubes with a medium-chiral angle equal to 19.1 degrees are
   considered as an intermediate case between the thoroughly investigated
   achiral armchair and zigzag nanotubes.},
