@inproceedings{ WOS:001525516600017,
Author = {Kayang, Edwin and Paul, Mishel Jyothis and Jahns, Eric and Ozmen, Muslum
   Ozgur and Stojkov, Milan and Rudd, Kevin and Kinsy, Michel A.},
Editor = {Castrillon, J and Park, Y and Roop, P},
Title = {R-Visor: An Extensible Dynamic Binary Instrumentation and Analysis
   Framework for Open Instruction Set Architectures},
Booktitle = {PROCEEDINGS OF THE 26TH ACM SIGPLAN/SIGBED INTERNATIONAL CONFERENCE ON
   LANGUAGES, COMPILERS, AND TOOLS FOR EMBEDDED SYSTEMS, LCTES 2025},
Year = {2025},
Pages = {158-169},
Note = {26th International Conference on Languages Compilers and Tools for
   Embedded Systems-LCTES-Annual, SOUTH KOREA, JUN 16-17, 2025},
Abstract = {Binary instrumentation tools are widely used to facilitate the
   development of hardware and software systems. Traditionally, these tools
   are designed around a fixed Instruction Set Architecture (ISA)
   specification. However, there is a shift in the architectural community
   towards open ISAs, whose key feature is the ability to add custom ISA
   extensions. The lack of extensibility in traditional binary
   instrumentation tools limits their capacity to adapt to these evolving
   ISAs, thus hindering their ability to analyze and modify binaries built
   for open ISAs. To address this challenge, we present R-Visor, a modular
   and extensible Dynamic Binary Instrumentation (DBI) framework designed
   for open ISAs by allowing seamless integration of new extensions for
   instrumentation. R-Visor uses a cache-based just-in-time execution model
   to run application binaries while supporting advanced instrumentation
   routines at multiple granularities. R-Visor leverages Arch-Visor, a new
   Domain-Specific Language (DSL) that allows users to write specifications
   for ISAs and extensions, enabling seamless extensibility. Our
   implementation of R-Visor on the RISC-V architecture shows that on
   average R-Visor incurs 1.81x less overhead while utilizing 2.64x less
   memory than DynamoRIO, an industry standard DBI. Through Arch-Visor,
   R-Visor requires 9.30x less code than DynamoRIO to support the F
   (floating point) and C (compressed) extensions.},
Type = {Proceedings Paper},
Affiliation = {Kayang, E (Corresponding Author), Arizona State Univ, Tempe, AZ 85287 USA.
