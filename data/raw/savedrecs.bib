@article{ WOS:001708231900001,
Author = {Yu, Bin and Zhao, Kai and Wang, Wentao and Liu, Zhiwei and Huang, Hai},
Title = {Efficient Hardware Implementation of Extended Merkle Signature Scheme
   for SPHINCS},
Journal = {IEEE TRANSACTIONS ON CIRCUITS AND SYSTEMS I-REGULAR PAPERS},
Year = {2026},
Month = {2026 MAR 2},
Abstract = {To address the computational bottleneck of the Extended Merkle Signature
   Scheme (XMSS) signature algorithm within the current Stateless Practical
   Hash-based Incredibly Nice Cryptographic Signature+ (SPHINCS+) signature
   scheme, this paper presents a hardware implementation of the XMSS
   tailored for SPHINCS+. We propose an optimized Merkle tree construction
   algorithm that minimizes tree construction overhead and enhances overall
   signature speed by adjusting the key pair selection mechanism and
   reducing the number of nodes calculated during the signing process.
   Furthermore, by employing multi-lane parallel hash chains and optimizing
   the pipeline layout via a dual key pair alternating input method, the
   design reduces the total clock cycles required for key generation and
   signature calculation, thereby improving hardware utilization.
   Implemented on a Virtex-7 Field Programmable Gate Array (FPGA) platform,
   the design utilizes 512,621 Look-Up Tables (LUTs) and 108,667 Flip-Flops
   (FFs). Experimental results demonstrate speedup ratios of 3.86 and 3.87
   for key generation and signature calculation, respectively. Notably, the
   key generation throughput per unit area is 5.19 times that of the
   best-known existing design, demonstrating significant acceleration
   performance.},
Type = {Article; Early Access},
Affiliation = {Huang, H (Corresponding Author), Harbin Univ Sci \& Technol, Sch Comp Sci \& Technol, Harbin 150080, Heilongjiang, Peoples R China.
   Yu, Bin; Zhao, Kai; Wang, Wentao; Liu, Zhiwei; Huang, Hai, Harbin Univ Sci \& Technol, Sch Comp Sci \& Technol, Harbin 150080, Heilongjiang, Peoples R China.},
