@article{ WOS:001694317400001,
Author = {Shao, Weixuan and Mo, Zirui and Wang, Yuchen and Zhang, Chi and Yao,
   Xiaoxia and Wu, Di and Jia, Yuting and Gao, Qixuan and Shokouhimehrc,
   Mohammadreza and Liu, Zhengchun},
Title = {Efficient image feature-driven machine learning for meniscus volume
   measurement in transparent glass vials},
Journal = {MEASUREMENT},
Year = {2026},
Volume = {269},
Month = {APR 14},
Abstract = {Precise characterization of the meniscus profile is essential for
   non-contact, vision-based liquid-volume measurement. In this study, we
   apply COMSOL Multiphysics to develop an optical-imaging model of the
   liquid-gas interface in transparent glass vials, showing that
   discrepancies between the observed meniscus contour and its true
   geometry create unrecognized liquid regions and reduce measurement
   accuracy. We propose an imagefeature-based method to estimate the
   meniscus-defined volume. After image preprocessing and segmentation to
   isolate the meniscus, we extract a comprehensive set of visual features,
   conduct correlation and stability analyses to identify essential
   descriptors, and construct multiple feature combinations for modeling.
   We then evaluate five representative regression algorithms across
   different feature configurations. Nonlinear models outperform the linear
   baseline on our datasets; the random forest achieved the best median
   accuracy and narrowest error distribution, substantially reducing
   meniscus-induced error under the tested conditions. Validation on three
   glass vials with different specifications confirms that the method
   adapts well to varying geometries and imaging conditions. Accuracy
   remains high across all experiments, demonstrating strong robustness and
   generalization. This study provides a high-precision, non-contact
   approach for quantifying water volumes in transparent reagent vials and
   shows substantial potential for engineering applications.},
