@article{ WOS:001493253700004,
Author = {Gupta, Anisha and Mittal, Apeksha and Jain, Rachna},
Title = {A novel sarcasm detection approach for text-image data: Leveraging
   multimodal fusion and weighted latent factors},
Journal = {INFORMATION FUSION},
Year = {2025},
Volume = {123},
Month = {NOV},
Abstract = {Detecting sarcasm in social media is vital for sentiment analysis and
   cyberbullying prevention. This study introduces a new multimodal method
   that integrates both text and image data to identify sarcastic content
   accurately. Using an open-source multimodal Twitter dataset from GitHub,
   we combine features extracted from text through a BiLSTM (Bidirectional
   Long Short-Term Memory) model, images through ResNet (Residual Network),
   and image attributes using a CNN (Convolutional Neural Network) into a
   shared latent space. A Modified Latent Factor Text Image (MLFTI) Model
   is proposed which implements a weighted interaction matrix for sarcasm
   classification, utilizing a bifocal hybrid neural network framework.
   This approach improves performance by addressing data sparsity,
   minimizing noise, and reducing dimensionality while prioritizing the
   most significant elements of both text and image inputs before making a
   final classification. Modified Latent Factor accounting weighted
   distribution results in a computationally efficient approach with high
   performance. Our model achieves a 93\% accuracy rate, outperforming
   existing models,and contributing to advancements in computational
   linguistics and social media analysis. An ablation study is also done to
   identify the model's most important components and features and
   establish their contribution to model performance.},
Type = {Article},
Affiliation = {Jain, R (Corresponding Author), Bhagwan Parshuram Inst Technol, New Delhi, India.
   Gupta, Anisha; Mittal, Apeksha, GD Goenka Univ, Sohna, Haryana, India.
