@article{ WOS:001137401700001,
Author = {Kim, Jinwoo and Zhu, Lingjun and Torun, Hakki Mert and Swaminathan,
   Madhavan and Lim, Sung Kyu},
Title = {A PPA Study for Heterogeneous 3-D IC Options: Monolithic, Hybrid
   Bonding, and Microbumping},
Journal = {IEEE TRANSACTIONS ON VERY LARGE SCALE INTEGRATION (VLSI) SYSTEMS},
Year = {2024},
Volume = {32},
Number = {3},
Pages = {401-412},
Month = {MAR},
Abstract = {In this article, we present three commercial-grade 3-D IC designs based
   on state-of-the-art design technologies, specifically microbumping (3-D
   die stacking), hybrid bonding (wafer-on-wafer bonding), and monolithic
   3-D (M3D) ICs. To highlight tradeoffs present in these three designs, we
   perform analyses on power, performance, and area (PPA) and the clock
   tree. We also model the tier-to-tier interconnection in each 3-D IC
   methodology and analyze signal integrity (SI) to assess the reliability
   of each design. From our experiments using the OpenPiton benchmark, the
   hybrid bonding design shows the best timing improvement of 81.4\% when
   compared to its 2-D counterpart, while microbumping shows the best
   reliability among 3-D IC designs. Moreover, we expand our study to the
   commercial processor architecture, which is Arm Cortex-A53, with the new
   set of 3-D integration options. In addition, we show the microbump
   assignment methodology to handle a large number of 3-D interconnections
   in the microbumping 3-D design. We also perform SI on the new set of 3-D
   intertier/interdie connections to discuss the reliability based on their
   physical dimensions. With a new benchmark design, the hybrid-bonding 3-D
   shows the best energy-delay-product (EDP) improvement, which is 25.8\%
   compared to 2-D, and the largest eye-opening among 3-D integration
   options.},
Type = {Article},
Affiliation = {Kim, J (Corresponding Author), Georgia Inst Technol, Sch Elect \& Comp Engn, Atlanta, GA 30332 USA.
   Kim, J (Corresponding Author), Intel Corp, Santa Clara, CA 95054 USA.
   Kim, Jinwoo; Zhu, Lingjun; Torun, Hakki Mert; Swaminathan, Madhavan; Lim, Sung Kyu, Georgia Inst Technol, Sch Elect \& Comp Engn, Atlanta, GA 30332 USA.
   Kim, Jinwoo, Intel Corp, Santa Clara, CA 95054 USA.
   Torun, Hakki Mert, Apple Inc, San Diego, CA 92121 USA.},
DOI = {10.1109/TVLSI.2023.3342734},
EarlyAccessDate = {DEC 2023},
Keywords = {Integrated circuits; Bonding; Logic gates; Metals; Integrated circuit
   modeling; Stacking; Benchmark testing; 3-D integrated chip (IC);
   electronic design automation (EDA); hybrid bonding; microbump;
   monolithic; power; performance; and area (PPA); signal integrity (SI)},
Author-Email = {jinwookim.intel@gmail.com
   limsk@ece.gatech.edu},
