@article{ WOS:001612912000003,
Author = {Kohata, Ikuma and Yoshikawa, Ryo and Hisama, Kaoru and Bichara,
   Christophe and Otsuka, Keigo and Maruyama, Shigeo},
Title = {Edge dynamics in iron-cluster catalyzed growth of single-walled carbon
   nanotubes revealed by molecular dynamics simulations based on a neural
   network potential},
Journal = {CARBON},
Year = {2026},
Volume = {247},
Month = {FEB},
Abstract = {The controlled synthesis of single-walled carbon nanotubes (SWCNTs)
   requires a mechanistic understanding of chirality selection during
   growth. Here, we develop a neural network potential (NNP) for the
   carbon-metal system to accurately describe SWCNT growth and perform
   molecular dynamics (MD) simulations using this NNP. The simulations
   demonstrate defect-free growth with well-defined chirality, driven by
   dynamic rearrangements of edge configurations. The occurrence
   probability of edge configurations agrees with the entropy-driven edge
   stability model proposed in this work. In addition, we show that edge
   defects originate from vacancy formation but are suppressed by vacancy
   healing through adatom diffusion along SWCNT edges. These findings
   clarify the thermodynamic and kinetic roles of edge processes and
   provide mechanistic insights into chirality-controlled synthesis of
   SWCNTs.},
