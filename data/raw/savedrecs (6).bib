@article{ WOS:001035000400001,
Author = {Selvam, Samayanan and Park, Young-Kwon and Yim, Jin-Heong},
Title = {An extremely low temperature environment operatable hybrid
   dual-functioning energy device driven by a
   supercapacitor/piezo-triboelectric generator system},
Journal = {JOURNAL OF MATERIALS CHEMISTRY A},
Year = {2023},
Volume = {11},
Number = {32},
Pages = {16973-16984},
Month = {AUG 17},
Abstract = {Maintaining the quick-charging capacity of flexible supercapacitors
   (SCs) at low temperatures is a significant challenge. At reduced energy
   levels, the charging performance of piezo-triboelectric nanogenerators
   (PTNGs) using composite electrodes often deteriorates rapidly, owing to
   slow ion and charge transfer in the electrode electrolyte. Here, we
   present a self-chargeable power generator/SC-coupled device designed to
   operate at very low temperatures, ranging from 25 \& DEG;C to -80 \&
   DEG;C. The smart SC was fabricated using a
   PEDOT:TREN:PDMS:Ni@MnCO3/PEDOT:TREN:PVDF-PTFE:Ni@MnCO3 composite system
   and achieved a specific capacitance of 317 F g(-1) with 11.9 V charging
   power generation at -80 \& DEG;C. At room temperature (25 \& DEG;C), the
   attained capacitance was 542 F g(-1) with a power generation of 22 V,
   suggesting that this technology can potentially fulfill the urgent
   requirement for low-temperature-compatible wearable devices with
   autonomous rechargeable, stable power sources for next-generation
   electronics.},
Type = {Article},
Affiliation = {Yim, JH (Corresponding Author), Kongju Natl Univ, Div Adv Mat Engn, Budaedong 275, Cheonan 31080, Chungnam, South Korea.
