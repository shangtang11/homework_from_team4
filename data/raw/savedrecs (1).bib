@article{ WOS:001545023400001,
Author = {Ji, Dongseob and Kim, Soonhyo and Han, Myeonggeun and Jeon, Seungju and
   Lim, Bogyu and Noh, Yong-Young},
Title = {Solvent-driven dispersion of semiconducting carbon nanotubes using
   regiorandom Poly(3-dodecylthiophene) with cycloaliphatic solvents of low
   dielectric constant},
Journal = {POLYMER},
Year = {2025},
Volume = {336},
Month = {OCT 13},
Abstract = {Regioregular poly (3-dodecylthiophene) (rr-P3DDT) has been extensively
   utilized for the selective dispersion of semiconducting single-walled
   carbon nanotubes (sc-SWNTs). In contrast, regiorandom P3DDT (ra-P3DDT)
   has been reported to lack the capability to disperse sc-SWNTs; however,
   the specific role of regioregularity in determining its dispersion
   ability remains insufficiently understood. Herein, we report the
   selective dispersion of sc-SWNTs using ra-P3DDT by adjusting the
   solubility of the polymer in various organic solvents. The dispersion of
   sc-SWNTs using ra-P3DDTs is achieved in marginal solvents of low
   dielectric constant, where weakened interactions between the solvent and
   the side chains of the polymer enable the wrapping process, despite the
   short conjugation length of the wrapping polymer. The chirality of the
   sorted SWNTs is confirmed by absorption and Raman spectroscopies. Our
   findings indicate that the ability of ra-P3DDT to disperse sc-SWNTs is
   primarily governed by the thermodynamic tendency rather than polymer
   chain conformation. This study provides deeper insight into the
   fundamental mechanisms of sorting sc-SWNTs using conjugated polymers and
   broadens the range of solvents and polymers applicable to the conjugated
   polymer wrapping method.},
Type = {Article},
