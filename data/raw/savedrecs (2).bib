@article{ WOS:001621301600010,
Author = {Hyung Ko, Jae and Kim, Byung-Soo and Hwang, Taeho and Hyun Choi, Kyu},
Title = {A Compute-in-Memory Decoding Architecture for Posit-to-Floating-Point
   Conversion},
Journal = {IEEE ACCESS},
Year = {2025},
Volume = {13},
Pages = {196040-196049},
Abstract = {Modern computing systems are increasingly adopting low-precision
   floating-point formats to reduce memory overhead, particularly in
   large-scale applications such as large language models and scientific
   computing. Low-precision formats, however, are vulnerable to reduced
   numerical accuracy and provide only a limited dynamic range. The posit
   format, which incorporates a variable-length regime structure, has
   gained attention for providing higher precision and a broader dynamic
   range compared to conventional low-precision floating-point
   representations. Despite such advantages, conventional computing
   architectures are still based on IEEE 754 floating-point arithmetic,
   where achieving parallel and efficient posit-to-floating-point decoding
   remains a significant challenge. This paper proposes a Compute-in-Memory
   (CIM) architecture for posit-to-floating-point conversion that leverages
   the inherent parallelism of memory arrays to perform concurrent
   conversion of multiple posit values in a fixed number of cycles with
   negligible hardware overhead. The architecture implements key modules
   for posit decoding through bitwise in-memory logic operations, extending
   the state-of-the-art PIM microarchitecture to enable a wider range of
   micro-operations. Experimental results based on RRAM crossbar simulation
   demonstrate an average improvements of 3.3 x and 5.04 x in throughput
   and energy efficiency, respectively, compared to a baseline CMOS
   decoding architecture.},
Type = {Article},
Affiliation = {Choi, KH (Corresponding Author), Korea Elect Technol Inst, Seongnam 13449, Gyeonggi Do, South Korea.
   Hyung Ko, Jae; Kim, Byung-Soo; Hwang, Taeho; Hyun Choi, Kyu, Korea Elect Technol Inst, Seongnam 13449, Gyeonggi Do, South Korea.},
