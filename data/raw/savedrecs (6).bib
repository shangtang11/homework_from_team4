@inproceedings{ WOS:001261354500005,
Author = {Asmussen, Nils and Haas, Sebastian and Lackorzynski, Adam and Roitzsch,
   Michael},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Core-Local Reasoning and Predictable Cross-Core Communication with
   M3},
Booktitle = {2024 IEEE 30TH REAL-TIME AND EMBEDDED TECHNOLOGY AND APPLICATIONS
   SYMPOSIUM, RTAS 2024},
Series = {IEEE Real-Time and Embedded Technology and Applications Symposium},
Year = {2023},
Pages = {199-211},
Note = {30th Real-Time and Embedded Technology and Applications Symposium
   (RTAS), Hong Kong, PEOPLES R CHINA, MAY 14-16, 2024},
Abstract = {Modern cyber-physical systems often require security, heterogeneity, and
   real-time operation from their hardware platform and operating system.
   However, highly predictable real-time operating systems such as FreeRTOS
   do not employ strong component isolation required for platform security.
   Microkernels implement such isolation using virtual memory and code
   running in the privileged CPU mode, complicating real-time analysis.
   In this work, we start with a different architectural approach: M-3 is
   an existing hardware/software co-design for heterogeneous systems that
   features strong isolation between cores. However, the real-time
   properties of this platform have not been investigated. We first survey
   M-3's current state for real-time applicability and study both the
   communication latencies in comparison to other systems and M-3's
   different approach to task priorities. Furthermore we improve M-3's
   real-time applicability by adding a network-on-chip traffic regulation
   and enabling the enforcement of resource limits. With these additions,
   M-3 enables local reasoning about application execution. We perform the
   evaluation with an FPGA-based hardware prototype and in simulation based
   on gem5.},
Type = {Proceedings Paper},
Affiliation = {Asmussen, N (Corresponding Author), Barkhausen Inst, Dresden, Germany.
