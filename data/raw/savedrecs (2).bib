Series = {IEEE International Symposium on Circuits and Systems},
Year = {2025},
Note = {2025 International Symposium on Circuits and Systems-ISCAS-Annual,
   ENGLAND, MAY 25-28, 2025},
Abstract = {This paper proposes a method to enable fault isolation in non-intrusive
   fault injection at RTL and GL with a high-speed feature. The key scheme
   is to minimize the number of isolated modules inserted while maintaining
   the purity of the circuit source code called half-intrusive fault inject
   technique (HIFI). The proposed scheme integrates the advantages of
   intrusive and non-intrusive fault injection technique and enables fault
   isolation for the former. Simulation can be achieved by proposed HIFI
   with significantly 5x accelerated run-time than conventional intrusive
   technique. Besides, this work used this technique to build an
   open-source fault injection tool to help learners and researchers in the
   field of functional safety of integrate circuits.},
