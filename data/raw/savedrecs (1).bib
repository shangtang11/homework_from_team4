@article{ WOS:001534522300002,
Author = {Heng, Chua Wee and Uttraphan, Chessda and Choon, Chew Chang and Ching,
   Kok Boon},
Title = {Optimizing FPGA-based YOLO series accelerators: A survey of techniques},
Journal = {NEUROCOMPUTING},
Year = {2025},
Volume = {650},
Month = {OCT 14},
Abstract = {This review provides a comprehensive overview of hardware optimization
   techniques used to accelerate the You Only Look Once (YOLO) series of
   object detection models on Field-Programmable Gate Arrays (FPGAs). YOLO
   models are widely adopted for real-time applications due to their
   balance of accuracy and speed, but their computational demands
   necessitate innovative solutions for deployment in resource-constrained
   environments. This paper categorizes optimization techniques into two
   primary categories: model-level (e.g., quantization, pruning) and
   architectural-level (e.g., parallelism, pipelining). Furthermore, it
   describes the key performance metrics utilized in most previous works.
   Challenges such as trade-offs between latency, complexity, and accuracy
   are highlighted, along with promising avenues for future research. This
   survey serves as a valuable resource for designing efficient FPGA-based
   YOLO series accelerators, advancing the deployment of object detection
   in edge and embedded systems.},
