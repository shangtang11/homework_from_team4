   Iyer, Ravishankar, Intel, Syst Technol Lab, Hillsboro, OR 97124 USA.},
DOI = {10.1109/TC.2022.3214151},
Keywords = {B.6.1.e memory used as logic; C.1.3.i neural nets accelerator; C.1.3.e
   dataflow architectures},
