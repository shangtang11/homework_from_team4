@inproceedings{ WOS:000784162400056,
Author = {Lin, Weison and Arslan, Tughrul},
Book-Group-Author = {IEEE},
Title = {A Column Streaming-Based Convolution Engine and Mapping Algorithm for
   CNN-based Edge AI Accelerators},
Booktitle = {2021 28TH IEEE INTERNATIONAL CONFERENCE ON ELECTRONICS, CIRCUITS, AND
   SYSTEMS (IEEE ICECS 2021)},
Series = {IEEE International Conference on Electronics Circuits and Systems},
Year = {2021},
Note = {28th IEEE International Conference on Electronics, Circuits, and Systems
   (IEEE ICECS), Dubai, U ARAB EMIRATES, NOV 28-DEC 01, 2021},
Abstract = {Edge AI accelerators have been emerging as a solution for near
   customers' applications in areas such as image recognition sensors,
   remote sensing satellites, robotics, wearable devices, and drones. These
   applications require meeting performance targets and strict area and
   power constraints due to their portable mobility feature and limited
   power sources. As a result, a column streaming-based convolution engine
   has been proposed in this paper that includes column sets of processing
   elements design for flexibility in terms of the applicability for
   different CNN algorithms in edge AI accelerators. Compared to a
   commercialized CNN accelerator, the key results reveal that the column
   streaming-based convolution engine requires similar execution cycles to
   process a 227 x 227 feature map and avoid zero-padding penalties.},
Type = {Proceedings Paper},
Affiliation = {Lin, WS (Corresponding Author), Univ Edinburgh, Sch Engn, Inst Integrated Micro \& Nano Syst, Edinburgh, Midlothian, Scotland.
