@article{ WOS:001645451400005,
Author = {Liu, Xingting and Ning, Ke and Hou, Bin and Zhang, Jin and Gao, Shanshan
   and Ma, Jing},
Title = {Intelligent distribution equipment status monitoring and fault warning
   based on the power internet of things},
Journal = {INTERNATIONAL JOURNAL OF GLOBAL ENERGY ISSUES},
Year = {2026},
Volume = {48},
Number = {1-2},
Abstract = {This paper used the power Internet of Things (IoT) technology to monitor
   the status of the intelligent DR and give early warning of faults.
   First, the existing problems of the current DR were introduced. This
   paper then analysed the status monitoring requirements and system
   configuration of the DR and then discussed the monitoring technology of
   the intelligent DR to deal with the corresponding data faults. At the
   end of this paper, the effect of condition monitoring and fault early
   warning of intelligent DR was analysed, and finally, the conclusion was
   drawn. After adopting the IoT, the monitoring accuracy of each
   intelligent DR has improved compared with the previous one. The
   timeliness of fault early warning in DR has been greatly improved after
   the adoption of power distribution network technology, and the
   timeliness of fault early warning in DR 5 can reach 92\%.},
Type = {Article},
