@inproceedings{ WOS:000584252700166,
Author = {Sharma, Shantanu and Burtsev, Anton and Mehrotra, Sharad},
Book-Group-Author = {IEEE},
Title = {Advances in Cryptography and Secure Hardware for Data Outsourcing},
Booktitle = {2020 IEEE 36TH INTERNATIONAL CONFERENCE ON DATA ENGINEERING (ICDE 2020)},
Series = {IEEE International Conference on Data Engineering},
Year = {2020},
Pages = {1798-1801},
Note = {IEEE 36th International Conference on Data Engineering (ICDE), Dallas,
   TX, APR 20-24, 2020},
Abstract = {Despite extensive research, secure outsourcing remains an open
   challenge. This tutorial focuses on recent advances in secure
   cloud-based data outsourcing based on cryptographic (encryption,
   secret-sharing, and multi-party computation (MPC)) and hardware-based
   approaches. We highlight the strengths and weaknesses of
   state-of-the-art techniques, and conclude that, while no single approach
   is likely to emerge as a silver bullet. Thus, the key is to merge
   different hardware and software techniques to work in conjunction using
   partitioned computing wherein a computation is split across different
   cryptographic techniques carefully, so as not to compromise security. We
   highlight some recent work in that direction.},
Type = {Proceedings Paper},
