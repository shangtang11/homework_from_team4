@article{ WOS:000751488500001,
Author = {Kim, Sung and Fayazi, Morteza and Daftardar, Alhad and Chen, Kuan-Yu and
   Tan, Jielun and Pal, Subhankar and Ajayi, Tutu and Xiong, Yan and Mudge,
   Trevor and Chakrabarti, Chaitali and Blaauw, David and Dreslinski,
   Ronald and Kim, Hun-Seok},
Title = {Versa: A 36-Core Systolic Multiprocessor With Dynamically Reconfigurable
   Interconnect and Memory},
Journal = {IEEE JOURNAL OF SOLID-STATE CIRCUITS},
Year = {2022},
Volume = {57},
Number = {4},
Pages = {986-998},
Month = {APR},
Abstract = {We present Versa, an energy-efficient 36-core systolic multiprocessor
   with dynamically reconfigurable interconnects and memory. Versa
   leverages reconfigurable functional units and systolic-enhanced ARM
   cores to adapt for different algorithm characteristics, providing
   optimized bandwidth, access latency, and data reuse. Hardware support
   for crucial thread-synchronization operations enables a tree-based
   algorithm with 6.5x improvement in synchronization latency. Measured on
   a diverse set of compute kernels, Versa's design features culminate in
   median energy-efficiency improvements of 37.2x and 11.6x over mobile CPU
   and GPU baselines, respectively.},
