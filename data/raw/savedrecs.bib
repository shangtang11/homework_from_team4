@article{ WOS:001643524500001,
Author = {Xu, Liping and Xu, Siqiu and Xie, Chenchen and Wang, Qian and Chen,
   Houpeng and Li, Xi and Song, Zhitang},
Title = {System-Level Evaluation of a Differential Cell Architecture for
   Energy-Efficient Phase-Change Memory},
Journal = {IEEE TRANSACTIONS ON ELECTRON DEVICES},
Year = {2026},
Volume = {73},
Number = {1},
Pages = {690-693},
Month = {JAN},
Abstract = {Emerging applications such as edge AI, the Internet of Things (IoT), and
   mobile computing demand memory technologies that deliver both ultralow
   power consumption and high throughput. Phase-change memory (PCM) is a
   promising candidate due to its scalability and CMOS compatibility, but
   the conventional 1-transistor-1-resistor (1T1R) architecture suffers
   from narrow read margins and high programming energy. In this work, a
   differential 3-transistor-2-resistor (3T2R) PCM cell is evaluated, which
   enhances read robustness through differential comparison while
   maintaining a compact layout. Compared with 1T1R, the 3T2R prototype
   achieves an 86.7\% reduction in write energy and a 5.2 x improvement in
   write speed. Endurance and retention exhibit reliable performance under
   low-to-moderate cycling, while the cell area offers a balanced
   compromise between compactness and differential robustness. These
   results establish the 3T2R architecture as an efficient solution for
   embedded and edge memory applications where energy efficiency and
   high-speed operation are critical.},
