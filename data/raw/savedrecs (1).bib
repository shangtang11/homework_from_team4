@article{ WOS:001585443600001,
Author = {Kumar, Sujeet and Ray, Kailash Chandra},
Title = {A Parity-based Multi-bit Fault-Tolerant Instruction Decoder for RISC-V
   pipelined soft processor},
Journal = {INTEGRATION-THE VLSI JOURNAL},
Year = {2025},
Volume = {105},
Month = {NOV},
Abstract = {FPGA-based RISC-V softcore processors are gaining popularity in space
   applications due to their features of open ISA, modularity and
   integration capabilities. However, for those applications,
   radiation-induced singleevent multi-bit upsets (SEMUs) in CMOS devices
   lead to critical challenges as it can cause failure of processors. Among
   all the components of processors, the instruction decoder is
   particularly vulnerable. The faults of the instruction decoder can
   disrupt the program execution and potentially lead to system
   malfunction. Hence, in this context, a new parity-based multibit
   fault-tolerant instruction decoder architecture is proposed and
   integrated with an in-house designed five-stage pipeline RISC-V
   processor soft core in order to mitigate the SEMUs. Here, the design
   employs a nibble-based fault-masking approach to mitigate single-bit
   error per nibble and effectively handles multiple-bit error by
   selectively swapping instruction nibbles. The proposed multibit
   fault-tolerant instruction decoder (MFID) based five-stage pipeline
   RISC-V processor core is designed and implemented using Verilog HDL.
   Further, Xilinx's Soft Error Mitigation (SEM) IP core is employed for
   real-time fault injection to assess its fault-tolerant capabilities at
   the silicon level. This fault-tolerant RISC-V processor core is
   prototyped on a commercially available NEXYS FPGA board. Compared to
   existing SEMU mitigation Techniques, the proposed design offers
   significant benefits, including a 190.93\% reduction in LUT overhead and
   a 48.14\% in decrease in power consumption compared to triple modular
   redundancy (TMR) method. Furthermore, the design achieves a 95\%
   improvement in fault tolerance over an unprotected processor.},
Type = {Article},
Affiliation = {Kumar, S (Corresponding Author), Indian Inst Technol Patna, Dept Elect Engn, Patna, Bihar, India.
