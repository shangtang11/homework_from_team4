Title = {QR Factorization on a Long-Vector Processor},
Booktitle = {PARALLEL PROCESSING AND APPLIED MATHEMATICS, PPAM 2024, PT II},
Series = {Lecture Notes in Computer Science},
Year = {2025},
Volume = {15580},
Pages = {48-60},
Note = {15th International Conference on Parallel Processing and Applied
   Mathematics-PPAM-Biennial, Ostrava, CZECH REPUBLIC, SEP 08-11, 2024},
Abstract = {We build two high-performance implementations of the QR factorization
   optimized for the long vector units in the accelerator developed as part
   of the European Processor Initiative. Both realizations, based on the
   Householder and Gram-Schmidt (GS) methods respectively, are optimized
   via linear algebra kernels that can be reused for other applications.
   The experimental evaluation on an early test-chip of this accelerator
   shows significant gains over the LAPACK code running on a scalar RISCV
   core. It also shows the superiority of the Householder-based solution
   for square matrices and the advantages of GS for tall-and-skinny
   matrices when both the triangular and orthogonal factors are needed.},
