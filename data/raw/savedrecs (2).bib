@inproceedings{ WOS:001568886700043,
Author = {Liu, Zhilong and Peng, Long and Wang, Wenzhu and Li, Ke and Zeng, Binrui
   and Yu, Jie and Liu, Xiaodong},
Editor = {Huang, DS and Zhang, C and Zhang, Q and Pan, Y},
Title = {Accelerating LLM Inference on RISC-V Edge Devices via Vector Extension
   Optimization},
Booktitle = {ADVANCED INTELLIGENT COMPUTING TECHNOLOGY AND APPLICATIONS, ICIC 2025,
   PT III},
Series = {Lecture Notes in Computer Science},
Year = {2025},
Volume = {15844},
