@inproceedings{ WOS:001453268300054,
Author = {Rashmi, Priyadarshini B. K. and Sumanasa, B. N. and Rajendra, Prasad P.
   and Sarvagya, Mrinal and Ravi, Kumar M. G.},
Book-Group-Author = {IEEE},
Title = {Implementation and Extension of Bit Manipulation Instruction on RISC-V
   Architecture using FPGA},
Booktitle = {2024 5TH INTERNATIONAL CONFERENCE ON CIRCUITS, CONTROL, COMMUNICATION
   AND COMPUTING, I4C},
