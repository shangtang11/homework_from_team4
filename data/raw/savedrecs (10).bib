   Benini, Luca, Swiss Fed Inst Technol Zurich, Dept Informat Technol \& Elect Engn, CH-8092 Zurich, Switzerland.},
DOI = {10.1109/TCAD.2018.2883902},
Keywords = {Energy-quality tradeoff; floating-point (FP) emulation; precision
   tuning; transprecision computing},
Keywords-Plus = {PRECISION; POWER; OPTIMIZATION; COMPUTATION; FRAMEWORK; QUALITY; DESIGN},
