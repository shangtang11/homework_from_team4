@article{ WOS:001211300300001,
Author = {Zuo, Huamei and Zhan, Shixiang and Xu, Wangping and Wei, Xiaolin and
   Cao, Juexian},
Title = {Theoretical approaches toward designing sensitive materials for carbon
   nanotube-based field-effect transistor gas sensors},
Journal = {SENSORS AND ACTUATORS B-CHEMICAL},
Year = {2024},
Volume = {409},
Month = {JUN 15},
Abstract = {Screening sensitive materials is one of the keys to designing
   high-performance carbon nanotube-based field-effect transistor gas
   sensors. Here, we proposed a reliable way (e.g., H2S) to design
   sensitive materials with high efficiency based on theory and experiment.
   Our results demonstrated that the interaction between H2S and the
   sensitive materials must satisfy both energy level and parity match, and
   the maximum overlap of the orbital wave function. Especially, the gas
   Delta Q exhibits a strong linear scaling with the metal phi (Delta Q
   proportional to phi). Meanwhile, Delta phi will result in changes in the
   threshold voltage of the sensor (Delta V-th proportional to Delta phi)
   in experiments, which would lead to different response intensities.
   Therefore, the greater the Delta Q, the more changes in the threshold
   voltage, and corresponding higher response intensity. Expectedly, our
   experimental results show that the response intensity at equivalent
   concentrations is in high agreement with the theory (Pt > Pd > Ag), and
   the limit of H2S detection is low to 20 ppb.},
