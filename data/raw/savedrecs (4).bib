@inproceedings{ WOS:001280469200120,
Author = {Enttsel, Andriy and Marchioni, Alex and Setti, Gianluca and Mangia,
   Mauro and Rovatti, Riccardo},
Book-Group-Author = {IEEE},
Title = {Enhancing Anomaly Detection with Entropy Regularization in
   Autoencoder-based Lightweight Compression},
Booktitle = {2024 IEEE 6TH INTERNATIONAL CONFERENCE ON AI CIRCUITS AND SYSTEMS, AICAS
   2024},
Series = {IEEE International Conference on Artificial Intelligence Circuits and
   Systems},
Year = {2024},
Pages = {273-277},
Note = {6th International Conference on AI Circuits and Systems (AICAS), Abu
   Dhabi, U ARAB EMIRATES, APR 22-25, 2024},
Abstract = {Monitoring systems produce and transmit large amounts of data. For an
   efficient transmission, data is often compressed and autoencoders are a
   widely adopted neural network-based solution. However, this processing
   step leads to a loss of information that may negatively impact the
   performance of downstream tasks, such as anomaly detection. In this
   work, we propose a loss function for an autoencoder that addresses both
   compression and anomaly detection. Our key contribution is the inclusion
   of a regularization term based on information-theoretic quantities that
   characterize an anomaly detector processing compressed signals. As a
   result, the proposed approach allows for a better use of the
   communication channel such that the information preserved by the
   compressed signal is optimized for both detection and reconstruction,
   even in scenarios with lightweight compression. We tested the proposed
   technique with ECG signals affected by synthetic anomalies and the
   experiments demonstrated an average 17\% increase in the probability of
   detection across three standard detectors. Additionally, we proved that
   our approach is generalizable to image data.},
Type = {Proceedings Paper},
Affiliation = {Enttsel, A (Corresponding Author), Univ Bologna, DEI, Bologna, Italy.
   Enttsel, Andriy; Marchioni, Alex; Mangia, Mauro; Rovatti, Riccardo, Univ Bologna, DEI, Bologna, Italy.
   Setti, Gianluca; Mangia, Mauro; Rovatti, Riccardo, Univ Bologna, ARCES, Bologna, Italy.
   Setti, Gianluca, KAUST, CEMSE, Thuwal, Saudi Arabia.},
DOI = {10.1109/AICAS59952.2024.10595983},
Keywords = {anomaly detection; dimensionality reduction; autoencoder; information
   theory; compression},
Keywords-Plus = {SENSOR},
Author-Email = {andriy.enttsel@unibo.it
   alex.marchioni@unibo.it
   gianluca.setti@kaust.edu.sa
   mauro.mangia@unibo.it
   riccardo.rovatti@unibo.it},
