@article{ WOS:001531675700007,
Author = {Chen, Mei-Nung and Iwasaki, Rin and Ashiya, Mayoh and Zhao, Haoyu and
   Hong, Qi-An and Li, Yen-Ting and Chen, Kai-Lin and Mburu, Maina Moses
   and Li, Wei-Ting and Gu, Xiaodan and Chiang, Wei-Hung and Isono, Takuya
   and Satoh, Toshifumi and Chiu, Yu-Cheng},
Title = {Block copolymer architectures with poly(ε-caprolactone) for
   modulating interactions to enhance selectivity and stability of
   semiconducting single-walled carbon nanotube dispersions},
Journal = {CHEMICAL ENGINEERING JOURNAL},
Year = {2025},
Volume = {519},
Month = {SEP 1},
Abstract = {The challenge of maintaining long-term stability in dispersed nanotube
   solutions arises in the case of sorting semiconducting single-walled
   carbon nanotubes (s-SWCNTs) with conjugated homopolymers. A strategic
   approach that enhances steric hindrance between nanotubes is desirable
   to inhibit re-aggregation effectively. This study systematically
   investigates interactions between BCP-SWCNTs, assessing molecular weight
   and steric factors by introducing a nonpolar poly(epsilon-caprolactone)
   (PCL) segment into the lowest-molecular-weight polyfluorene (PF) as a
   demonstration. Employing a (PCL6k)3-b-PF6k miktoarm architecture
   achieves highly selective dispersions of s-SWCNTs with 1.145 nm
   diameters, attaining exceptional dispersion stability for over one year
   without re-aggregation. Thin-film transistors fabricated from these
   dispersions exhibit hole mobility up to 11.47 cm2 V-1 s-1 without
   additional washing treatment. This structural design of the soft segment
   emerges as a powerful strategy to modulate SWCNT-SWCNT interactions,
   highlighting the significant role of branched, soft segment-based
   conjugated BCPs in enhancing both sorting selectivity and dispersion
   stability.},
Type = {Article},
Affiliation = {Chiang, WH; Chiu, YC (Corresponding Author), Natl Taiwan Univ Sci \& Technol, Dept Chem Engn, 43,Sec 4,Keelung Rd, Taipei City 10607, Taiwan.
   Isono, T; Satoh, T (Corresponding Author), Hokkaido Univ, Fac Engn, Div Appl Chem, Sapporo 0608628, Japan.
   Satoh, T (Corresponding Author), Hokkaido Univ, Inst Chem React Design \& Discovery ICReDD, List Sustainable Digital Transformat Catalyst Coll, Sapporo 0010021, Japan.
   Chiu, YC (Corresponding Author), Natl Taiwan Univ Sci \& Technol, Sustainable Electrochem Energy Dev Ctr, Taipei City 10607, Taiwan.
