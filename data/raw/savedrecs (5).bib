@inproceedings{ WOS:001307887200016,
Author = {Yuan, Shenghao and Besson, Frederic and Talpin, Jean-Pierre},
Editor = {Gurfinkel, A and Ganesh, V},
Title = {End-to-End Mechanized Proof of a JIT-Accelerated eBPF Virtual Machine
   for IoT},
Booktitle = {COMPUTER AIDED VERIFICATION, PT I, CAV 2024},
Series = {Lecture Notes in Computer Science},
