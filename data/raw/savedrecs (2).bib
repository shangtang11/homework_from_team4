Title = {Crack Detection in Historical Buildings using a new dataset and FOMO
   MobileNetV2},
Booktitle = {2025 12TH INTERNATIONAL CONFERENCE ON SOFT COMPUTING \& MACHINE
   INTELLIGENCE, ISCMI},
Series = {International Conference on Soft Computing \& Machine Intelligence ISCMI},
Year = {2025},
Pages = {444-448},
Note = {12th International Conference on Soft Computing and Machine
   Intelligence-ISCMI-Annual, Rio de Janeiro, BRAZIL, NOV 21-23, 2025},
Abstract = {Cracks are significant forms of damage affecting the structural health
   of historical buildings. In this context, artificial intelligence and
   computer vision are relevant digital technologies for advancing the
   monitoring of cracks in cultural heritage sites. However, the literature
   in this research field still lacks specific studies focused on the
   recognition of such pathological manifestations in Brazilian colonial
   architecture, particularly with a view toward efficient models for
   mobile devices. The aim of this paper is to propose a deep learning
   approach for crack detection in historical buildings. To this end, a new
   dataset is proposed, ImageOP-Crack, comprising 1,795 images with 4,120
   annotated cracks collected of 24 cultural heritage buildings across four
   historic Brazilian cities. In addition, we investigate the performance
   of the Faster Objects, More Objects (FOMO) algorithm for crack detection
   and propose a methodology for hyperparameter tuning. The results show
   that the model tuned with MobileNetV2 0.35, a learning rate of 0.001,
   and input dimensions of 196 x 196 achieved a recall of 85\% (validation)
   and 86\% (test).},
