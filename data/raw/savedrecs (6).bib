@article{ WOS:001125287400004,
Author = {Iorga, Dan and Wickerson, John and Donaldson, Alastair F.},
Title = {Simulating Operational Memory Models Using Off-the-Shelf Program
   Analysis Tools},
Journal = {IEEE TRANSACTIONS ON SOFTWARE ENGINEERING},
Year = {2023},
Volume = {49},
Number = {12},
Pages = {5084-5102},
Month = {DEC},
Abstract = {Memory models allow reasoning about the correctness of multithreaded
   programs. Constructing and using such models is facilitated by
   simulators that reveal which behaviours of a given program are allowed.
   While extensive work has been done on simulating axiomatic memory
   models, there has been less work on simulation of operational models.
   Operational models are often considered more intuitive than axiomatic
   models, but are challenging to simulate due to the vast number of paths
   through the model's transition system. Observing that a similar
   path-explosion problem is tackled by program analysis tools, we
   investigate the idea of reducing the decision problem of ``whether a
   given memory model allows a given behaviour{''} to the decision problem
   of ``whether a given C program is safe{''}, which can be handled by a
   variety of off-the-shelf tools. We report on our experience using
   multiple program analysis tools for C for this purpose-a model checker
   (CBMC), a symbolic execution tool (KLEE), and three coverage-guided
   fuzzers (libFuzzer, Centipede and AFL++)-presenting two case-studies.
   First, we evaluate the performance and scalability of these tools in the
   context of the x86 memory model, showing that fuzzers offer performance
   competitive with that of RMEM, a state-of-the-art bespoke memory model
   simulator. Second, we study a more complex, recently developed memory
   model for hybrid CPU/FPGA devices for which no bespoke simulator is
   available. We highlight how different encoding strategies can aid the
   various tools and show how our approach allows us to simulate the
   CPU/FPGA model twice as deeply as in prior work, leading to us finding
   and fixing several infidelities in the model. We also experimented with
   applying three analysis tools that won the ``falsification{''} category
   in the 2023 Annual Software Verification Competition (SV-COMP). We found
   that these tools do not scale to our use cases, motivating us to submit
   example C programs arising from our work for inclusion in the set of
   SV-COMP benchmarks, so that they can serve as challenge examples.},
Type = {Article},
Affiliation = {Iorga, D (Corresponding Author), Imperial Coll London, Dept Comp, London SW7 2AZ, England.
   Iorga, Dan; Donaldson, Alastair F., Imperial Coll London, Dept Comp, London SW7 2AZ, England.
   Wickerson, John, Imperial Coll London, Dept Elect \& Elect Engn, London SW7 2AZ, England.},
DOI = {10.1109/TSE.2023.3326056},
Keywords = {Operational semantics; model checking; fuzzing; symbolic execution},
Keywords-Plus = {WEAK MEMORY; CONSISTENCY; CHECKING},
Author-Email = {d.iorga17@imperial.ac.uk
   j.wickerson@imperial.ac.uk
