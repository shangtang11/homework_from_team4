@article{ WOS:000368904200012,
Author = {Takamaeda-Yamazaki, Shinya and Nakatsuka, Hiroshi and Tanaka, Yuichiro
   and Kise, Kenji},
Title = {Ultrasmall: A Tiny Soft Processor Architecture with Multi-Bit Serial
   Datapaths for FPGAs},
Journal = {IEICE TRANSACTIONS ON INFORMATION AND SYSTEMS},
Year = {2015},
Volume = {E98D},
Number = {12},
Pages = {2150-2158},
Month = {DEC},
Abstract = {Soft processors are widely used in FPGA-based embedded computing
   systems. For such purposes, efficiency in resource utilization is as
   important as high performance. This paper proposes Ultrasmall, a new
   soft processor architecture for FPGAs. Ultrasmall supports a subset of
   the MIPS-I instruction set architecture and employs an area efficient
   microarchitecture to reduce the use of FPGA resources. While supporting
   the original 32-bit ISA, Ultrasmall uses a 2-bit serial ALU for all of
   its operations. This approach significantly reduces the resource
   utilization instead of increasing the performance overheads. In addition
   to these device-independent optimizations, we applied several
   device-dependent optimizations for Xilinx Spartan-3E FPGAs using 4-input
   lookup tables (LUTs). Optimizations using specific primitives
   aggressively reduce the number of occupied slices. Our evaluation result
   shows that Ultrasmall occupies only 84\% of the previous small soft
   processor. In addition to the utilized resource reduction, Ultrasmall
   achieves 2.9 times higher performance than the previous approach.},
Type = {Article},
Affiliation = {Takamaeda-Yamazaki, S (Corresponding Author), Nara Inst Sci \& Technol, Ikoma 6300192, Japan.
   Takamaeda-Yamazaki, Shinya, Nara Inst Sci \& Technol, Ikoma 6300192, Japan.
