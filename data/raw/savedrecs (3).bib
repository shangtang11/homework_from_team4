@inproceedings{ WOS:001543539900023,
Author = {Shao, Wenyuan and Han, Xinyu and Stella, Evan and Dierksheide, Linnea
   and Gadepalli, Phani Kishore and Parmer, Gabriel},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Janus: OS Support for a Secure, Fast Control-Plane},
Booktitle = {2025 IEEE 31ST REAL-TIME AND EMBEDDED TECHNOLOGY AND APPLICATIONS
   SYMPOSIUM, RTAS},
Series = {IEEE Real-Time and Embedded Technology and Applications Symposium},
Year = {2025},
Pages = {296-309},
Note = {31st Embedded Technology and Applications Symposium-RTAS-Annual, Irvine,
   CA, MAY 06-09, 2025},
Abstract = {The emergence of the edge cloud, empowered by advanced wireless
   technologies such as 5G, is aimed at delivering predictable, interactive
   services within low milliseconds. Even in the traditional cloud,
   latency-sensitive services are pervasive. To enable low-latency
   software, much focus has been on data-plane optimizations for fast
   processing of requests. Unfortunately, these efforts alone are
   insufficient: effective, low-latency services also require advances in
   the control-plane. However, control-plane operations require strong
   spatial and temporal isolation between tenant computations, thus can
   result in significant overhead.
   This paper introduces Janus, an OS abstraction for a flexible
   control-plane which provides both strong isolation and low latency
   through the use of pervasive kernel-bypass. Janus leverages Memory
   Protection Key (MPK) hardware to enable low-cost control operations for
   protected procedure call (PPC) and thread dispatch - two essential
   building blocks of spatial and temporal isolation. By transparently
   improving these fundamental control-plane operations, Janus enables
   efficient and predictable user-defined and customizable system control
   policies and mechanisms, while maintaining strong isolation. We evaluate
   Janus's ability to extensibly define new control mechanisms, increase
   the efficiency of an existing RTOS, and support low-latency services in
   a memcached server. Compared to a Linux approach, a specialized
   latency-sensitive control plane using Janus provides over a 6x
   improvement in throughput, while providing 99th percentile tail
   latencies almost 3x lower. Demonstrating the utility of an efficient
   control plane, Janus improves tail latency in a multi-tenant system by
   orders of magnitude.},
Type = {Proceedings Paper},
Affiliation = {Shao, WY (Corresponding Author), George Washington Univ, Washington, DC 20052 USA.
   Shao, Wenyuan; Han, Xinyu; Stella, Evan; Dierksheide, Linnea; Gadepalli, Phani Kishore; Parmer, Gabriel, George Washington Univ, Washington, DC 20052 USA.},
