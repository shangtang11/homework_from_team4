@inproceedings{ WOS:000814059800043,
Author = {Stapf, Emmanuel and Jauernig, Patrick and Brasser, Ferdinand and
   Sadeghi, Ahmad-Reza},
Book-Group-Author = {IEEE},
Title = {In Hardware We Trust? From TPM to Enclave Computing on RISC-V},
Booktitle = {PROCEEDINGS OF THE 2021 IFIP/IEEE INTERNATIONAL CONFERENCE ON VERY LARGE
   SCALE INTEGRATION (VLSI-SOC)},
Series = {IEEE-IFIP International Conference on VLSI and System-on-Chip},
Year = {2021},
Pages = {218-223},
Note = {29th IFIP/IEEE International Conference on Very Large Scale Integration
   (VLSI-SoC), Nanyang Technol Univ Ctr, ELECTR NETWORK, OCT 04-08, 2021},
Abstract = {System-on-Chip platforms have been increasingly extended with trusted
   computing functionality to provide strong protection for sensitive
   software applications through enclaves that only require trust in the
   hardware and minimal software components. However, the deployed enclave
   architectures are still suffering from various shortcomings such as the
   lack of secure I/O, or being vulnerable to side-channel attacks. Thus,
   recent research works propose new enclave architectures with more
   comprehensive threat models and advanced security features. A majority
   of these solutions is being developed on the open RISC-V architecture.
   In this paper, we present a brief overview of the RISC-V-based enclave
   architectures, discuss their features, limitations and open challenges.},
Type = {Proceedings Paper},
Affiliation = {Stapf, E (Corresponding Author), Tech Univ Darmstadt, Darmstadt, Germany.
   Stapf, Emmanuel; Jauernig, Patrick; Brasser, Ferdinand; Sadeghi, Ahmad-Reza, Tech Univ Darmstadt, Darmstadt, Germany.},
