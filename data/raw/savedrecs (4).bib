@inproceedings{ WOS:001478676500003,
Author = {Gao, Qingyu and Song, Liantao and Lei, Yan and Wang, Feng and Wang, Lei
   and Zong, Shize and Ding, Yan},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Enhancing Consistency in Container Migration via TEE: A Secure
   Architecture},
Booktitle = {2024 IEEE 23RD INTERNATIONAL CONFERENCE ON TRUST, SECURITY AND PRIVACY
   IN COMPUTING AND COMMUNICATIONS, TRUSTCOM},
Series = {IEEE International Conference on Trust Security and Privacy in Computing
   and Communications},
Year = {2024},
Pages = {21-28},
Note = {23rd International Conference on Trust Security and Privacy in Computing
   and Communications-TRUSTCOM-Annual, Sanya, PEOPLES R CHINA, DEC 17-21,
   2024},
Abstract = {Secure migration of multi-tenant containerized cloud servers is critical
   to maintaining the stability and security of cloud services. However,
   migrating applications across servers owned by different platforms
   introduces a range of security challenges. Recent research indicates
   that Trusted Execution Environments (TEEs) provide effective
   hardware-based isolation for containers, significantly enhancing data
   confidentiality and integrity. Despite these advancements, existing
   technologies still struggle to ensure consistency during the migration
   of container data. To address these issues, we propose a comprehensive
   security migration framework that defines the security properties
   required for container migration and introduces a software-based
   solution. This solution integrates several technologies, including a
   secure removal mechanism utilizing monotonic counters to prevent
   potential fork/rollback attacks and ensure the single-instance nature of
   migrated containers. Additionally, a two-phase commit-based
   pre-migration check mechanism is employed to maintain consistency among
   tightly coupled containers being migrated simultaneously on the same
   host. Safety analysis confirms the effectiveness of our proposed design,
   and performance evaluation indicates an additional overhead of
   approximately 7\%.},
