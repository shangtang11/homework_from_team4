@article{ WOS:001681120300028,
Author = {Diaz-Fortuny, Javier and Saraza-Canflanca, Pablo and Bury, Erik and
   Degraeve, Robin and Kaczer, Ben},
Title = {An Integrated PCB Platform for CMOS Variability and Aging
   Characterization of Array-Based ICs},
Journal = {IEEE TRANSACTIONS ON INSTRUMENTATION AND MEASUREMENT},
Year = {2026},
Volume = {75},
Abstract = {Characterizing variability and aging in CMOS circuits, such as ring
   oscillators (ROs), typically requires specialized laboratory equipment,
   including costly instrumentation and wafer probers for bare-die testing.
   In addition, statistical and long-term aging experiments, such as
   measuring bias temperature instability (BTI) and hot-carrier degradation
   (HCD), are often limited by restricted access to shared reliability labs
   and time-constrained measurement slots. To overcome these limitations,
   this article introduces a versatile PCB test platform that enables
   autonomous and accurate characterization of variability and aging
   effects in wire-bonded integrated circuits (ICs) for short-, mid-, and
   long-term reliability experiments. The PCB integrates the necessary
   hardware and software to perform statistical testing of RO circuits
   implemented in full-custom array chips. Its functionality is
   demonstrated with a custom IC fabricated in a commercially available
   0.9-V, 28-nm HKMG CMOS technology. The proposed PCB includes tunable
   level shifters to adapt control signals for chips from different
   foundries and technology nodes, dedicated force-and-sense biasing
   channels to compensate on-chip voltage drops during testing, and a
   MicroMod Teensy processor for ultrafast RO frequency measurements. This
   work presents the PCB's hardware architecture and the measurement
   methodology used to characterize the fabricated ICs.},
Type = {Article},
Affiliation = {Diaz-Fortuny, J (Corresponding Author), imec, B-3001 Leuven, Belgium.
   Diaz-Fortuny, Javier; Saraza-Canflanca, Pablo; Bury, Erik; Degraeve, Robin; Kaczer, Ben, imec, B-3001 Leuven, Belgium.},
DOI = {10.1109/TIM.2026.3655910},
Article-Number = {2000409},
Keywords = {Circuits; Testing; Stress; Frequency measurement; Reliability;
   Degradation; Stress measurement; Integrated circuit reliability;
   Accuracy; System-on-chip; Aging; automated characterization; bias
   temperature instability (BTI); full-custom design; hot-carrier
   degradation (HCD); integrated circuit (IC); PCB; variability},
