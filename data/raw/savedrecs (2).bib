@inproceedings{ WOS:001540559800027,
Author = {Engels, Steve and Badr, Mario and Whatley, Taylor},
Book-Group-Author = {ACM},
Title = {Enhancing MIPS Assembly Language Education with Saturn},
Booktitle = {PROCEEDINGS OF THE 30TH ACM CONFERENCE ON INNOVATION AND TECHNOLOGY IN
   COMPUTER SCIENCE EDUCATION VOL 2, ITICSE 2025},
Year = {2025},
Pages = {741-742},
Note = {30th Conference on Innovation and Technology in Computer Science
   Education-ITICSE-Annual, Nijmegen, NETHERLANDS, JUN 27-JUL 02, 2025},
Abstract = {We introduce Saturn, an Integrated Development Environment (IDE)
   tailored to students learning MIPS assembly language. Saturn combines
   standard development features such as syntax highlighting, breakpoints,
   and program tracing with educational enhancements including backward
   execution, detailed and mutable debugging state, and out-of-the box
   integration of memory mapped I/O (for display, keyboard, and audio). We
   have used Saturn in lectures and labs for three years, which has
   significantly improved student engagement. Saturn is now also available
   in the browser (WebSaturn), which expands accessibility and
   collaborative opportunities. Saturn, and its assembler (Titan), are
   actively developed with student and instructor feedback in mind. Our
   next steps include support for RISC-V and Arm instruction sets.},
Type = {Proceedings Paper},
