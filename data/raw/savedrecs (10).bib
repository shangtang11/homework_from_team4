@inproceedings{ WOS:000630168400005,
Author = {Jelesnianski, Christopher and Yom, Jinwoo and Min, Changwoo and Jang,
   Yeongjin},
Book-Group-Author = {ACM},
Title = {MARDU: Efficient and Scalable Code Re-randomization},
Booktitle = {PROCEEDINGS OF THE 13TH ACM INTERNATIONAL SYSTEMS AND STORAGE CONFERENCE
   (SYSTOR 2020)},
Year = {2020},
Pages = {49-60},
Note = {13th ACM International Systems and Storage Conference (SYSTOR), IBM,
   ELECTR NETWORK, OCT 13-15, 2020},
Abstract = {Defense techniques such as Data Execution Prevention (DEP) and Address
   Space Layout Randomization (ASLR) were role models in preventing early
   return-oriented programming (ROP) attacks by keeping performance and
   scalability in the forefront, making them widely-adopted. As code reuse
   attacks evolved in complexity, defenses have lost touch with pragmatic
   defense design to ensure security, either being narrow in scope or
   providing unrealistic overheads.
   We present MARDU, an on-demand system-wide re-randomization technique
   that maintains strong security guarantees while providing better overall
   performance and having scalability most defenses lack. We achieve code
   sharing with diversification by implementing reactive and scalable,
   rather than continuous or one-time diversification. Enabling code
   sharing further minimizes needed tracking, patching, and memory
   overheads. The evaluation of MARDU shows low performance overhead of
   5.5\% on SPEC and minimal degradation of 4.4\% in NGINX, proving its
   applicability to both compute-intensive and scalable real-world
   applications.},
Type = {Proceedings Paper},
Affiliation = {Jelesnianski, C (Corresponding Author), Virginia Tech, Blacksburg, VA 24061 USA.
   Jelesnianski, Christopher; Yom, Jinwoo; Min, Changwoo, Virginia Tech, Blacksburg, VA 24061 USA.
   Jang, Yeongjin, Oregon State Univ, Corvallis, OR 97331 USA.},
