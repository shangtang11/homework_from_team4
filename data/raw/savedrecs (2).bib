@inproceedings{ WOS:001665766800067,
Author = {Luettig, Bastian and Elsheikh, Yousif M. and Akhiat, Yassine and
   Annighoefer, Bjoern},
Book-Group-Author = {IEEE},
Title = {Policy-based Input Space Exploration to Find Worst-Case Inputs in
   Machine-Learning Based ARINC653 Applications},
Booktitle = {2025 AIAA DATC/IEEE 44TH DIGITAL AVIONICS SYSTEMS CONFERENCE, DASC},
Series = {IEEE-AIAA Digital Avionics Systems Conference},
Year = {2025},
Note = {44th AIAA DATC/IEEE Digital Avionics Systems Conference-DASC, Montreal,
   CANADA, SEP 14-18, 2025},
Abstract = {Modern programming assistants have made their way into developers' daily
   workflows, offering features such as code completion, automated test and
   document generation. However, for safety-critical domains like avionics,
   these tools pose unique challenges due to the need for high confidence
   and manual validation. Other machine learning applications allow for
   computer vision and pattern recognition but bring additional challenges
   in guaranteed execution time, confidence, and correctness. This paper
   introduces a reinforcement learning-based test agent using the
   Continuous-Armed Bandit (CAB) formulation to better guide test coverage
   and robustness, particularly for Machine-Learning (ML)-generated code.
   Our method systematically manipulates inputs and memory, aiming to
   identify high-risk input areas. The approach is validated on both
   trivial and neural-network-based ARINC653 applications. The results show
   promising potential for identifying long-computing input vectors and are
   compared against training and randomized data.},
Type = {Proceedings Paper},
Affiliation = {Luettig, B (Corresponding Author), Univ Stuttgart, Inst Aircraft Syst, Stuttgart, Germany.
