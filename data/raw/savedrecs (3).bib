@inproceedings{ WOS:001598852800118,
Author = {Taher, Mariam and Shousha, Hossam Moetaz and Saeed, Ahmed and Ismail,
   Yehea},
Book-Group-Author = {IEEE},
Title = {Optimized Test Pattern Reduction for GateExhaustive Faults Using MTTG
   and QuineMcCluskey STC},
Booktitle = {2025 15TH INTERNATIONAL CONFERENCE ON ELECTRICAL ENGINEERING, ICEENG},
Year = {2025},
Note = {15th IEEE International Conference on Electrical
   Engineering-ICEENG-Annual, Cairo, EGYPT, MAY 12-15, 2025},
Abstract = {Detecting cell-internal defects in VLSI circuits requires fault models
   that go beyond traditional stuck-at and transition fault models. The
   gate exhaustive fault model addresses this need by considering all
   possible input combinations for each gate, providing comprehensive fault
   coverage. However, the exhaustive nature of this model results in large
   test sets, necessitating effective test compaction techniques. This
   paper explores the integration of dynamic and static test compaction for
   gate-exhaustive faults. Dynamic test compaction reduces the number of
   test patterns during test generation by targeting multiple faults within
   a single pattern using Partial MaxSAT, thereby optimizing initial test
   sets. Building upon this foundation, static test compaction, using the
   Quine-McCluskey method, further refines the test set by eliminating
   redundancies and achieving minimal pattern counts. The proposed approach
   demonstrates significant reductions in patterns count while maintaining
   complete fault coverage. Experimental results show that our method
   reduces the number of test patterns from nine to seven patterns. This
   improvement highlights the efficiency of the proposed method in
   achieving superior test coverage while maintaining fault detection
   integrity.},
Type = {Proceedings Paper},
Affiliation = {Taher, M (Corresponding Author), Cairo Univ, Elect \& Commun Engn Dept, Cairo, Egypt.
