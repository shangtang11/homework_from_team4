@inproceedings{ WOS:000784162400029,
Author = {Petrovic, Marija L. and Milovanovic, Vladimir M.},
Book-Group-Author = {IEEE},
Title = {A Design Generator of Parametrizable and Runtime Configurable Constant
   False Alarm Rate Processors},
Booktitle = {2021 28TH IEEE INTERNATIONAL CONFERENCE ON ELECTRONICS, CIRCUITS, AND
   SYSTEMS (IEEE ICECS 2021)},
Series = {IEEE International Conference on Electronics Circuits and Systems},
Year = {2021},
Note = {28th IEEE International Conference on Electronics, Circuits, and Systems
   (IEEE ICECS), Dubai, U ARAB EMIRATES, NOV 28-DEC 01, 2021},
Abstract = {Constant false alarm rate (CFAR) algorithms are widely used in radar
   signal processing for object detection in cluttered and noisy
   environments and their fast hardware implementation is required in many
   of the real time applications. For that purpose, a parametrizable and
   runtime reconfigurable generator of CFAR detectors, featuring fully
   streaming I/O data interface, is captured inside Chisel hardware design
   language. Generator provides up to seven different CFAR algorithms
   available to choose from in compile time and throughout runtime
   configurability. Besides the algorithm choice, a wide range of settings,
   such as I/O data type and bit-widths, reference and guard window sizes,
   linear or logarithmic processing modes, edge handling methods, as well
   as some implementation specific parameters, are provided, hence enabling
   quick and efficient design space exploration. Several generator
   instances are tested and verified on a commercially-available FPGA board
   in conjunction with off-the-shelf radar transceivers thus proving that
   instances from the proposed peak detector generator can be effectively
   used whenever low latency processing performance is mandatory.},
Type = {Proceedings Paper},
Affiliation = {Petrovic, ML (Corresponding Author), Univ Kragujevac, Fac Engn, Sestre Janic 6, Kragujevac, Serbia.
   Petrovic, Marija L., Univ Kragujevac, Fac Engn, Sestre Janic 6, Kragujevac, Serbia.
   NOVELIC, Veljka Dugosevica 54, Belgrade, Serbia.},
