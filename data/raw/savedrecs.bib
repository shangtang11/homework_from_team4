@article{ WOS:001712894800001,
Author = {Alhussan, Amel Ali and El-Kenawy, El-Sayed M. and Eid, Marwa M. and
   Khodadadi, Nima},
Title = {Hybrid Al-Biruni and Puma Optimization (BERPO) for boosting the
   classification of Quality-of-Service (QoS) in 5G networks},
Journal = {JOURNAL OF NETWORK AND COMPUTER APPLICATIONS},
Year = {2026},
Volume = {250},
Month = {JUN},
Abstract = {With the exponential growth in mobile traffic and diverse service
   requirements, 5G networks face significant challenges in maintaining
   high-quality connectivity, including scalability, latency, and
   reliability. These challenges are further exacerbated by the growing
   demand for intelligent applications such as autonomous vehicles,
   industrial automation, virtual reality, e-health, and smart cities,
   which require highly reliable, low-latency communication. To address
   these challenges, this paper proposes a novel approach to classify
   quality-of-service (QoS) in 5G networks using an optimized Neural
   Network (NN) model. The primary aim is to improve QoS classification
   accuracy. The optimization is performed by hybridizing the Al-Biruni
   Earth Radius (BER) and Puma Optimization (PO) algorithms, resulting in
   BERPO. This hybrid algorithm optimizes both the parameters of the
   Synthetic Minority Oversampling Technique (SMOTE) for data balancing and
   those of the neural network used to classify 5G signal strength. A
   binary version of BERPO is further employed for feature selection.
   Experiments are conducted on a publicly available 5G QoS dataset using a
   fixed train/test evaluation protocol and benchmarking against classical
   machine learning and deep learning baselines. Experimental results
   indicate that the proposed BERPO algorithm achieved accuracies of
   99.3\%, 99.1\%, and 99.6\% for sensitivity, specificity, and overall
   accuracy, respectively, on the tested datasets. These results
   demonstrate strong performance under the reported experimental
   conditions, confirming the robustness of the proposed approach for QoS
   classification in 5G networks. Furthermore, several statistical tests,
   regression analyses, and sensitivity analyses validate the effectiveness
   of the proposed method, highlighting its potential for practical,
   reproducible 5G network management.},
