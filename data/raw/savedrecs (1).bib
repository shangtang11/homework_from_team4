@article{ WOS:001509136600001,
Author = {Zhao, Wenyi and Song, Qi and Li, Wei and Tian, Yongqin and Wang,
   Yingjian and Zhang, Weidong and Yang, Huihua},
Title = {Refined self-supervised learning via trident network and cross-hybrid
   optimization},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2025},
Volume = {290},
Month = {SEP 25},
Abstract = {Contrastive-based self-supervised learning (SSL) has achieved impressive
   success in capturing comprehensive representations, and it optimizes the
   encoder via identifying positive and negative views given a query
   anchor. Existing methods suffer from under-utilization of datasets and
   poor performance due to non-optimal sampling and optimization
   strategies. In this manuscript, we show that the global and local
   features can be cooperatively and complementally learned by minimizing
   the cross-model contrastive and single-model decouple losses,
   respectively. The key insights of this manuscript are the integration of
   hierarchical data, well-designed model structure, and cross-hybrid
   optimization objective. We first propose a hierarchical data for
   self-supervised training to capture the global and local features.
   Subsequently, a Trident network with shared weights and momentum updates
   is designed to generate representative vectors, allowing comprehensive
   features to be learned directly in an end-to-end manner without
   additional cost. Finally, the cross-hybrid optimization incorporates
   cross-model contrastive tasks and single-model decoupled position tasks
   into the framework, enabling complementary features to collaboratively
   optimize the encoder and continuously enhance feature representation.
   Extensive experiments on the ImageNet and Place-365 datasets show that
   the proposed method can significantly boost the performance.
   Specifically, our method achieves Top-1 accuracy of 72.2 \% over 200
   epochs on the ImageNet dataset with a standard ResNet-50. The code and
   pre-trained weights of this work will be available at
   https://github.com/WilyZhao8/STC.},
Type = {Article},
Affiliation = {Yang, HH (Corresponding Author), Beijing Univ Posts \& Telecommun, Sch Artificial Intelligence, Beijing 100876, Peoples R China.
