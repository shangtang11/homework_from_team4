@article{ WOS:001705761900001,
Author = {Liang, Qing and Zheng, Jinqi and Zhang, Zuchao and Wu, Yichun and Ling,
   Jiale and Zhang, Jie},
Title = {Design and implementation of a safety and security enhanced IEEE 1588
   clock synchronization system for Tokamak},
Journal = {FUSION ENGINEERING AND DESIGN},
Year = {2026},
Volume = {226},
Month = {MAY},
Abstract = {This paper presents the design and implementation of a safety and
   security enhanced IEEE 1588 clock synchronization system for tokamak,
   addressing stringent synchronization requirements and partially
   associated security challenges in critical infrastructures. The system
   utilizes an FPGA-assisted implementation of IEEE 1588 integrated with a
   GPS/BDS reference source to achieve high-accuracy timestamp. A key
   contribution is the application of the STPA-SafeSec methodology to
   systematically analyze functional safety and cyber security, identifying
   multiple potential hazardous control actions and vulnerability
   scenarios. Based on these analyses, a multi-layered safety and security
   enhancement mechanism is implemented, incorporating critical register
   write protection, timestamp data cyclic redundancy check (CRC), and the
   integrated security mechanism defined in IEEE 1588-2019. Experimental
   results demonstrate that the safety and security enhancement mechanisms
   effectively mitigate spoofing and replay attacks, with no abnormal
   synchronization states observed during cyclic attack tests. Evaluations
   conducted on the Experimental Advanced Superconducting Tokamak (EAST)
   show that the system achieves a synchronization accuracy better than 50
   ns RMS under a single-layer switch topology and maintains stable
   performance under high network load and long-term operation. The
   proposed system offers a cost-effective, highly portable, highly
   reliable, and secure clock synchronization solution for tokamak and
   other critical applications.},
