@inproceedings{ WOS:000722006802024,
Author = {Son, Jeongseok and Prechter, Griffin and Poddar, Rishabh and Popa,
   Raluca Ada and Sen, Koushik},
Book-Group-Author = {USENIX Assoc},
Title = {ObliCheck: Efficient Verification of Oblivious Algorithms with
   Unobservable State},
Booktitle = {PROCEEDINGS OF THE 30TH USENIX SECURITY SYMPOSIUM},
Year = {2021},
Pages = {2219-2236},
Note = {30th USENIX Security Symposium, ELECTR NETWORK, AUG 11-13, 2021},
Abstract = {Encryption of secret data prevents an adversary from learning sensitive
   information by observing the transferred data. Even though the data
   itself is encrypted, however, an attacker can watch which locations of
   the memory, disk, and network are accessed and infer a significant
   amount of secret information.
   To defend against attacks based on this access pattern leakage, a number
   of oblivious algorithms have been devised. These algorithms transform
   the access pattern in a way that the access sequences are independent of
   the secret input data. Since oblivious algorithms tend to be slow, a
   go-to optimization for algorithm designers is to leverage space
   unobservable to the attacker. However, one can easily miss a subtle
   detail and violate the oblivious property in the process of doing so.
   In this paper, we propose ObliCheck, a checker verifying whether a given
   algorithm is indeed oblivious. In contrast to existing checkers,
   ObliCheck distinguishes observable and unobservable state of an
   algorithm. It employs symbolic execution to check whether all execution
   paths exhibit the same observable behavior. To achieve accuracy and
   efficiency, ObliCheck introduces two key techniques: Optimistic State
   Merging to quickly check if the algorithm is oblivious, and Iterative
   State Unmerging to iteratively refine its judgment if the algorithm is
   reported as not oblivious. ObliCheck achieves x50300 of performance
   improvement over conventional symbolic execution without sacrificing
   accuracy.},
Type = {Proceedings Paper},
Affiliation = {Son, J (Corresponding Author), Univ Calif Berkeley, Berkeley, CA 94720 USA.
   Son, Jeongseok; Prechter, Griffin; Poddar, Rishabh; Popa, Raluca Ada; Sen, Koushik, Univ Calif Berkeley, Berkeley, CA 94720 USA.},
