@inproceedings{ WOS:001327706000032,
Author = {Dutta, Jayati and Peri, Priyanka and Malkuchi, Rohith},
Book-Group-Author = {IEEE},
Title = {A novel ZUC-PRN Generator using a Fully-Connected Neural Network},
Booktitle = {2024 IEEE 99TH VEHICULAR TECHNOLOGY CONFERENCE, VTC2024-SPRING},
Series = {IEEE Vehicular Technology Conference VTC},
Year = {2024},
Note = {IEEE 99th Vehicular Technology Conference (VTC-Spring), Singapore,
   SINGAPORE, JUN 24-27, 2024},
Abstract = {In this paper, a fast and secure neural network based Pseudo Random
   Number (PRN) generator is proposed in the ZUC architecture. Speed is
   accomplished by replacing the Linear Feedback Shift Register (LFSR) of
   ZUC with the neural network. To enhance security, all possible primitive
   polynomials of order 16 are considered as feedback polynomials of the
   LFSR and implemented in the neural network model. A new parameter called
   SEED is also introduced in the proposed architecture to provide better
   security. The randomness of the output keystream is shown through
   statistical analysis and the superiority of the proposed model is
   demonstrated by comparing the keystream generation times of the proposed
   algorithm with the existing ZUC algorithm in the 3rd Generation
   Partnership Project (3GPP) standard.},
