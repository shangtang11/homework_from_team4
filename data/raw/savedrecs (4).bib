@inproceedings{ WOS:001423331500041,
Author = {Franck, Christian and Grossschadl, Johann},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Step-by-Step Simulation and Statistical Analysis of C and Assembly
   Programs for MSP430},
Booktitle = {2024 11TH INTERNATIONAL CONFERENCE ON FUTURE INTERNET OF THINGS AND
   CLOUD, FICLOUD 2024},
Series = {International Conference on Future Internet of Things and Cloud},
Year = {2024},
Pages = {274-279},
Note = {11th International Conference on Future Internet of Things and Cloud,
   Vienna, AUSTRIA, AUG 19-21, 2024},
Abstract = {Many low-end embedded devices, such as miniature sensors and actuators,
   are equipped with 8 or 16-bit microcontrollers. The computational
   capabilities of these microcontrollers are far below that of more
   powerful 32-bit processors, which is not only because of lower clock
   frequencies, but also due to the lack of advanced architectural and
   micro-architectural features like branch prediction or superscalar
   execution. Therefore, the quality of C compilers for these platforms is
   particularly crucial to achieve acceptable software performance.
   However, results in the recent literature show that optimizing C
   compilers for the 16-bit MSP430 architecture of Texas Instruments are,
   in terms of performance, still a lot worse (up to an order of magnitude)
   than hand-tuned Assembly code, even when the C sources have been
   carefully optimized. We present in this paper a simulation and analysis
   tool that can help compiler designers and software developers to spot
   performance deficiencies in C code. Using two cryptographic
   permutations, namely Ascon and Photon, as case study, we demonstrate
   that the tool is capable to pinpoint three shortcomings of the
   code-optimization backend of version 4.6.3 of MSPGCC. More concretely,
   we show that the produced code is sub-optimal when it comes to register
   allocation, the rotation of multi-word operands, and addressing modes
   for operations that depend heavily on static look-up tables.},
Type = {Proceedings Paper},
Affiliation = {Franck, C (Corresponding Author), Univ Luxembourg, Dept Comp Sci, 6 Ave Fonte, L-4364 Esch Sur Alzette, Luxembourg.
   Franck, Christian; Grossschadl, Johann, Univ Luxembourg, Dept Comp Sci, 6 Ave Fonte, L-4364 Esch Sur Alzette, Luxembourg.},
DOI = {10.1109/FiCloud62933.2024.00049},
Keywords = {Embedded systems; MSP430 architecture; Software optimization; Code
   generation; Assembly programming},
Author-Email = {christian.franck@uni.lu
   johann.groszschaedl@uni.lu},
Affiliations = {University of Luxembourg},
Cited-References = {Campos F, 2020, LECT NOTES COMPUT SC, V12579, P526, DOI 10.1007/978-3-030-65411-5\_26.
   Dang D., 2014, Texas Instruments white paper.
