@article{ WOS:001619616300001,
Author = {Geng, Jun and Liu, Mengran and Tian, Sunan and Xie, Yuxin and Xing,
   Weitong and Yao, Xiangxiang and Yuan, Mingzi},
Title = {TESE-Net: Segmentation network for kidney and kidney tumor based on edge
   texture enhancement and aggregated segmented local attention},
Journal = {BIOMEDICAL SIGNAL PROCESSING AND CONTROL},
Year = {2026},
Volume = {113},
Number = {C},
Month = {MAR},
Abstract = {Early intervention is crucial to enhance the survival rate of renal
   tumor patients, and accurate segmentation is the basis of imaging
   histology analysis and surgical planning. However, fuzzy tumor
   boundaries, individual differences and uneven scanning conditions lead
   to time-consuming and subjective traditional visual segmentation; deep
   learning-assisted techniques, despite progress, are still difficult to
   cope with the challenges of fuzzy kidney tumor features and variable
   morphology. To this end, an end-to-end kidney tumor segmentation method,
   TESE-Net, is proposed in this study. It adopts an asymmetric
   encoder-decoder structure and introduces an edge texture enhancement
   module (ETEM) in the hopping connection part. To effectively alleviate
   the boundary blurring problem in the transition region between tumors
   and normal tissues by fusing and reconstructing the boundary information
   with weighted features and region's boundary blurring problem. Moreover,
   the model divides the feature map into multiple subgraphs, performs
   spatial attention operations within each subgraph to accurately extract
   local information, and combines with separable convolution to compute
   the channel attention to enhance the detail capturing ability. We also
   propose the salient position selection algorithm (SPS) and combine it
   with the Transformer, which is used to guide the Transformer to focus
   only on critical regions, thus reducing noise interference and
   accurately extracting key information in complex backgrounds. Tested on
   the KiTS19 dataset, TESE-Net achieved a kidney segmentation Dice score
   of 96.11\% and a tumor segmentation score of 81.17\%, outperforming
   baseline models. This method advances deep learning in medical image
   analysis and supports precise renal tumor diagnosis and treatment.},
Type = {Article},
Affiliation = {Liu, MR (Corresponding Author), Xinjiang Univ, Coll Software, Urumqi, Peoples R China.
