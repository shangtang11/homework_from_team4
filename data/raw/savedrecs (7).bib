DOI = {10.1109/TCAD.2022.3197491},
Keywords = {Internet of Things; Data models; Computational modeling; Integrated
   circuit modeling; Computer architecture; Cloud computing; Training; Deep
   mutual learning (DML); federated learning (FL); Internet of Things
   (IoT); model heterogeneity; neural network (NN)},
Author-Email = {mschen@sei.ecnu.edu.cn},
Affiliations = {East China Normal University; University of Houston System; University
