Keywords = {Deep learning; Clocks; Convolutional neural networks; Computers;
   Filters; Neurons; Internet of Things; Databases; Computer architecture;
   Training; Side-channel analysis; convolutional neural networks; dynamic
   frequency scaling; deep learning; template attack; RISC-V; AES},
