@inproceedings{ WOS:000558065600021,
Author = {Gollamudi, Anitha and Chong, Stephen and Arden, Owen},
Book-Group-Author = {IEEE},
Title = {Information Flow Control for Distributed Trusted Execution Environments},
Booktitle = {2019 IEEE 32ND COMPUTER SECURITY FOUNDATIONS SYMPOSIUM (CSF 2019)},
Series = {Proceedings IEEE Computer Security Foundations Symposium},
Year = {2019},
Pages = {304-318},
Note = {32nd IEEE Computer Security Foundations Symposium (CSF), Hoboken, NJ,
   JUN 25-28, 2019},
Abstract = {Distributed applications cannot assume that their security policies will
   be enforced on untrusted hosts. Trusted execution environments (TEEs)
   combined with cryptographic mechanisms enable execution of known code on
   an untrusted host and the exchange of confidential and authenticated
   messages with it. TEEs do not, however, establish the trustworthiness of
   code executing in a TEE. Thus, developing secure applications using TEEs
   requires specialized expertise and careful auditing.
   This paper presents DFLATE, a core security calculus for distributed
   applications with TEEs. DFLATE offers high-level abstractions that
   reflect both the guarantees and limitations of the underlying security
   mechanisms they are based on. The accuracy of these abstractions is
   exhibited by asymmetry between confidentiality and integrity in our
   formal results: DFLATE enforces a strong form of noninterference for
   confidentiality, but only a weak form for integrity. This reflects the
   asymmetry of the security guarantees of a TEE: a malicious host cannot
   access secrets in the TEE or modify its contents, but they can suppress
   or manipulate the sequence of its inputs and outputs. Therefore DFLATE
   cannot protect against the suppression of high-integrity messages, but
   when these messages are delivered, their contents cannot have been
   influenced by an attacker.},
Type = {Proceedings Paper},
Affiliation = {Gollamudi, A (Corresponding Author), Harvard Univ, Cambridge, MA 02138 USA.
   Gollamudi, Anitha; Chong, Stephen, Harvard Univ, Cambridge, MA 02138 USA.
   Arden, Owen, Univ Calif Santa Cruz, Santa Cruz, CA 95064 USA.},
