@inproceedings{ WOS:000701418600025,
Author = {Burrello, Alessio and Dequino, Alberto and Pagliari, Daniele Jahier and
   Conti, Francesco and Zanghieri, Marcello and Macii, Enrico and Benini,
   Luca and Poncino, Massimo},
Book-Group-Author = {IEEE},
Title = {TCN Mapping Optimization for Ultra-Low Power Time-Series Edge Inference},
Booktitle = {2021 IEEE/ACM INTERNATIONAL SYMPOSIUM ON LOW POWER ELECTRONICS AND
   DESIGN (ISLPED)},
Series = {International Symposium on Low Power Electronics and Design},
Year = {2021},
Note = {IEEE/ACM International Symposium on Low Power Electronics and Design
   (ISLPED), ELECTR NETWORK, JUL 26-28, 2021},
Abstract = {Temporal Convolutional Networks (TCNs) are emerging lightweight Deep
   Learning models for Time Series analysis. We introduce an automated
   exploration approach and a library of optimized kernels to map TCNs on
   Parallel Ultra-Low Power (PULP) microcontrollers. Our approach minimizes
   latency and energy by exploiting a layer tiling optimizer to jointly
   find the tiling dimensions and select among alternative implementations
   of the causal and dilated 1D-convolution operations at the core of TCNs.
   We benchmark our approach on a commercial PULP device, achieving up to
   103 x lower latency and 20.3 x lower energy than the Cube-AI toolkit
   executed on the STM32L4 and from 2.9 x to 26.6x lower energy compared to
   commercial closed-source and academic open-source approaches on the same
   hardware target.},
