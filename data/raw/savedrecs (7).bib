@article{ WOS:000898958800001,
Author = {Vousden, Mark and Morris, Jordan and McLachlan Bragg, Graeme and
   Beaumont, Jonathan and Rafiev, Ashur and Luk, Wayne and Thomas, David
   and Brown, Andrew},
Title = {Event-based high throughput computing: A series of case studies on a
   massively parallel softcore machine},
Journal = {IET COMPUTERS AND DIGITAL TECHNIQUES},
Year = {2023},
Volume = {17},
Number = {1},
Pages = {29-42},
Month = {JAN},
Abstract = {This paper introduces an event-based computing paradigm, where workers
   only perform computation in response to external stimuli (events). This
   approach is best employed on hardware with many thousands of smaller
   compute cores with a fast, low-latency interconnect, as opposed to
   traditional computers with fewer and faster cores. Event-based computing
   is timely because it provides an alternative to traditional big
   computing, which suffers from immense infrastructural and power costs.
   This paper presents four case study applications, where an event-based
   computing approach finds solutions to orders of magnitude more quickly
   than the equivalent traditional big compute approach, including problems
   in computational chemistry and condensed matter physics.},
