@article{ WOS:000594632500022,
Author = {Wright, John Charles and Schmidt, Colin and Ben Keller and Dabbelt,
   Daniel Palmer and Kwak, Jaehwa and Iyer, Vighnesh and Mehta, Nandish and
   Chiu, Pi-Feng and Bailey, Stevo and Asanovic, Krste and Nikolic,
   Borivoje},
Title = {A Dual-Core RISC-V Vector Processor With On-Chip Fine-Grain Power
   Management in 28-nm FD-SOI},
Journal = {IEEE TRANSACTIONS ON VERY LARGE SCALE INTEGRATION (VLSI) SYSTEMS},
Year = {2020},
Volume = {28},
Number = {12},
Pages = {2721-2725},
Month = {DEC},
Abstract = {This work demonstrates a dual-core RISC-V system-on-chip (SoC) with
   integrated fine-grain power management. The 28-nm fully depleted
   silicon-on-insulator (FD-SOI) SoC integrates switched-capacitor voltage
   converters and 4-Gb/s off-chip serial links. The SoC runs applications
   with operating system support on dual RISC-V Rocket cores with vector
   accelerators. Runtime monitoring of microarchitectural counters allows
   prediction of future compute intensity, enabling the voltage state of
   the managed core to be adjusted quickly to optimize energy efficiency
   without sacrificing overall performance.},
