@inproceedings{ WOS:001359449900024,
Author = {de la Vara, Jose Luis and Bauer, Thomas and Fischer, Bernhard and
   Karaca, Mustafa and Madeira, Henrique and Matschnig, Martin and Mazzini,
   Silvia and Nandi, Giann Spilere and Patrone, Fabio and Pereira, David
   and Proenca, Jose and Schlick, Rupert and Tonetta, Stefano and Yayan,
   Ugur and Sangchoolie, Behrooz},
Editor = {Paiva, ACR and Cavalli, AR and Martins, PV and Perez-Castillo, R},
Title = {A Proposal for the Classification of Methods for Verification and
   Validation of Safety, Cybersecurity, and Privacy of Automated Systems},
Booktitle = {QUALITY OF INFORMATION AND COMMUNICATIONS TECHNOLOGY, QUATIC 2021},
Series = {Communications in Computer and Information Science},
Year = {2021},
Volume = {1439},
Pages = {325-340},
Note = {14th International Conference on the Quality of Information and
   Communications Technology (QUATIC), Univ Algarve, ELECTR NETWORK, SEP
   08-11, 2021},
Abstract = {As our dependence on automated systems grows, so does the need for
   guaranteeing their safety, cybersecurity, and privacy (SCP). Dedicated
   methods for verification and validation (V\&V) must be used to this end
   and it is necessary that the methods and their characteristics can be
   clearly differentiated. This can be achieved via method classifications.
   However, we have experienced that existing classifications are not
   suitable to categorise V\&V methods for SCP of automated systems. They
   do not pay enough attention to the distinguishing characteristics of
   this system type and of these quality concerns. As a solution, we
   present a new classification developed in the scope of a large-scale
   industry-academia project. The classification considers both the method
   type, e.g., testing, and the concern addressed, e.g., safety. Over 70
   people have successfully used the classification on 53 methods. We argue
   that the classification is a more suitablemeans to categorise
   V\&Vmethods for SCP of automated systems and that it can help other
   researchers and practitioners.},
