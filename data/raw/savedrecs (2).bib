@article{ WOS:001430717500001,
Author = {Pan, Shing-Tai and Wu, Cheng-Hao},
Title = {A novel model based on CNN for improving computation efficiency on
   arrhythmia detection by combining HMM},
Journal = {BIOMEDICAL SIGNAL PROCESSING AND CONTROL},
Year = {2025},
Volume = {106},
Month = {AUG},
Abstract = {In this study, a novel method called Convolutional Hidden Markov Models
   (CovHMMs) is proposed. This method integrates a convolutional
   architecture with Hidden Markov Models (HMM) to enhance the
   computational efficiency of arrhythmia recognition in electrocardiograms
   (ECGs). ECG features are extracted by using a ResNetbased convolutional
   layer of neural network and are processed as observation sequences for
   training the HMM. Furthermore, a discrete Hidden Markov Model (HMM) is
   utilized to minimize computational expenses, aligning with our goal of
   developing a lightweight arrhythmia detection system. This approach
   enables the implementation of the proposed system on edge computing
   hardware. The experimental results demonstrate that the proposed method
   performs exceptionally well in arrhythmia recognition. Compared to other
   approaches utilizing convolutional neural networks for arrhythmia
   recognition, the proposed method demonstrates faster execution speed and
   consistent performance across various ECG datasets, maintaining a high
   recognition rate. This indicates that our method offers distinct
   advantages over other methods when applied in practical scenarios. The
   results of this study are promising and hold significant potential for
   widespread application in the medical field, contributing meaningfully
   to advancements in mobile and remote healthcare applications.},
Type = {Article},
Affiliation = {Pan, ST (Corresponding Author), Natl Univ Kaohsiung, Dept Comp Sci \& Informat Engn, Kaohsiung 811, Taiwan.
   Pan, Shing-Tai; Wu, Cheng-Hao, Natl Univ Kaohsiung, Dept Comp Sci \& Informat Engn, Kaohsiung 811, Taiwan.},
