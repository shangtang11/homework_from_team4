@article{ WOS:001658588000001,
Author = {Qian, Junyi and Deng, Lishuo and Li, Cai and Ding, Yizhi and Shan,
   Weiwei},
Title = {Actiniaria: Distributed Dynamic-IR-Drop-Aware Timing Monitor for AVFS
   With Lightweight Tentacles},
Journal = {IEEE SOLID-STATE CIRCUITS LETTERS},
Year = {2026},
Volume = {9},
Pages = {25-28},
Abstract = {Advances in integrated circuit (IC) technology have amplified the
   effects of process, voltage, and temperature (PVT) variations,
   particularly dynamic IR drop, which severely affects timing.
   Post-silicon IR drop monitoring circuits are lacking, forcing designers
   to reserve substantial static guard bands for worst-case scenarios,
   compromising energy efficiency. Inspired by biomimetics, this letter
   proposes an Actiniaria-shaped structure for distributed monitoring of
   multiple IR drop hotspots without invading critical paths (CPs). It
   comprises lightweight tentacles + central monitor. The tentacles use
   voltage-sensitive cells to sense the impact of IR drop on timing, while
   also supporting adaptive tuning for global variations. By using on-chip
   PVT sensors, Actiniaria tracks the timing characteristics of the longest
   CP in real time under PVT variations. A two-stage prewarning timing
   monitor captures timing margins and employs adaptive voltage/frequency
   scaling (AVFS) strategies to compress redundant guard bands. When
   applied to an open-source multicore RISC-V processor fabricated in 22-nm
   CMOS, Actiniaria achieves a 40.6\% reduction in power consumption
   through noninvasive dynamic IR drop monitoring while having only 0.08\%
   area overhead.},
Type = {Article},
Affiliation = {Shan, WW (Corresponding Author), Southeast Univ, Sch Integrated Circuits, Nanjing 210096, Peoples R China.
   Qian, Junyi; Deng, Lishuo; Li, Cai; Ding, Yizhi; Shan, Weiwei, Southeast Univ, Sch Integrated Circuits, Nanjing 210096, Peoples R China.},
