@inproceedings{ WOS:000925873100047,
Author = {Hu, Yahang and Wang, Yaohua and Dan, Xiaoqiang and Hu, Xiao and Liu, Fei
   and Li, Jinpeng},
Book-Group-Author = {IEEE},
Title = {Cost-Aware TVM (CAT) Tensorization for Modern Deep Learning Accelerators},
Booktitle = {2022 IEEE 40TH INTERNATIONAL CONFERENCE ON COMPUTER DESIGN (ICCD 2022)},
Series = {Proceedings IEEE International Conference on Computer Design},
Year = {2022},
Pages = {352-359},
Note = {IEEE 40th International Conference on Computer Design (ICCD), Olympic
   Valley, CA, OCT 23-26, 2022},
Abstract = {TVM is proposed to efficiently deploy deep learning (DL) networks to
   diverse hardware devices. Tensorization in TVM enables designers to
   manually set up mappings between tensor computation patterns in DL
   networks and specific hardware tensor instructions, so as to fully
   exploit the potential of DL accelerators. However, with the development
   of modem DL accelerators, a much richer set of hardware instructions are
   being proposed. This leads to a one-to-many mapping between a tensor
   computation pattern and hardware instructions, making it a non-trivial
   task to choose a proper mapping. To this end, we propose Cost Aware TVM
   (CAT) tensorization. The key insight of CAT is that both tensor
   computation patterns and instructions share similar tensor features.
   Based on this insight, CAT first extracts the tensor features of tensor
   computation patterns and locates eligible hardware instructions
   accordingly, and then selects the least time consuming hardware
   instruction via a cost model. Our experimental results across 8 deep
   learning models show that CAT tensorization can automatically map tensor
   computation patterns to proper hardware instructions, and our cost model
   based selection policy achieves an average speed up of 6.4x compared
   with randomly selecting an eligible hardware instruction for a tensor
   computation pattern.},
Type = {Proceedings Paper},
Affiliation = {Wang, YH (Corresponding Author), Natl Univ Def Technol, Changsha, Peoples R China.
   Hu, Yahang; Wang, Yaohua; Hu, Xiao, Natl Univ Def Technol, Changsha, Peoples R China.
