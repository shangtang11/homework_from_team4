@article{ WOS:001626884300032,
Author = {Duong, Phuc-Phan and Minh Nguyen, Hieu and Dao, Ba-Anh and Nguyen,
   Trong-Hung and Pham, Cong-Kha},
Title = {Dynamic S-Boxes Block Cipher for Side-Channel Attack Resistance},
Journal = {IEEE ACCESS},
Year = {2025},
Volume = {13},
Pages = {198523-198539},
Abstract = {Side-channel attacks constitute a critical security threat to hardware
   implementations of block ciphers. Traditional countermeasures, such as
   masking, aim to obscure the correlation between a device's power
   consumption and its internal cryptographic computations. In this work,
   we propose an approach based on dynamically generated S-boxes, which
   continuously change during encryption. This strategy reduces the
   predictability of the relationship between leakage signals and the
   processed data, thereby enhancing resistance to side-channel analysis.
   To validate our approach, we implemented the proposed dynamic S-box
   mechanism in an AES-128 core and evaluated it under correlation power
   analysis (CPA). While an unprotected AES implementation is easily
   compromised, our design with 1024 dynamic S-boxes variations
   successfully withstood a last-round CPA attack using more than 5 million
   power traces without revealing the correct key. This result confirms a
   substantial increase in the number of traces required for a successful
   attack, consistent with the theoretical expectation that increasing the
   number of S-boxes variations proportionally raises the attack effort.},
