@article{ WOS:001153345000001,
Author = {Qiu, Yulin and Dai, Xingyi and Yang, Jingkun and Liao, Jiaying and Han,
   Jiaxin and Wu, Yinghui and Cao, Yajun and Zhang, Xuyang and Zhong, Aihua
   and Ni, He and Huang, Long-Biao},
Title = {An Intelligent Glove System for Real-Time Multiple Electrical Signal
   Acquisition and Display},
Journal = {ADVANCED MATERIALS TECHNOLOGIES},
Year = {2024},
Volume = {9},
Number = {6},
Month = {MAR},
Abstract = {Realizing multimodal tactile perception for robots is highly desirable
   for achieving more intelligent human-machine interaction. A real-time
   intelligent glove system that can capture and monitor hand tactile
   information, including pressure, bending, and temperature is proposed.
   This system processes the collected data and visualizes the tactile
   information in a 2D image. The intelligent glove system integrates a
   palm-shaped sensor unit, a multi-channel data acquisition board, and a
   data analysis module. The glove consists of 34 flexible sensors,
   including 28 pressure sensors, five bending sensors, and one temperature
   sensor, which convert biological information into electrical signals. By
   enhancing the performance of the system, the intelligent glove achieves
   high sensitivity and good fault tolerance, allowing it to analyze the
   multimodal tactile information of the entire hand with fast
   responsivity. By analyzing the acquired multi-channel electrical
   signals, the system can analyze object shapes and various gripping
   states. This work paves the way for wearable devices used in multimodal
   tactile perception and promotes the emergence of new modes of
   human-machine interaction.
   A real-time intelligent glove system that can capture and monitor
   multimodal hand information (pressure, bending, and temperature) is
   proposed. By processing multi-channel signals, this system can generate
   real-time 2D images that display tactile information of the hand, with
   high sensitivity and fault tolerance. image},
