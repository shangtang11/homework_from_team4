@article{ WOS:001555184000001,
Author = {Srinivasan, K. and Raja, J.},
Title = {Optimized AES Cryptosystem on FPGA Using FQSR-KAT Network for Enhanced
   Security and Performance},
Journal = {IETE JOURNAL OF RESEARCH},
Year = {2025},
Month = {2025 AUG 22},
Abstract = {The Advanced Encryption Standard (AES) is a widely adopted symmetric-key
   cryptographic algorithm crucial for secure encryption and decryption.
   However, traditional hardware implementations of AES, such as
   Serial/Serial, Parallel/Serial, and Parallel/Pipelined architectures,
   encounter challenges related to resource utilization, execution time,
   and optimization. These architectures often present trade-offs between
   performance, area occupancy, and security. To overcome these limitations
   and enhance cryptographic security, an optimized FPGA-based solution is
   essential, particularly for high-performance applications that require
   both speed and robust security. This paper presents an optimized
   implementation of AES on an FPGA, integrating the Fuzzy Q-value
   Self-guided Regularized Structure Retention Generative Kepler's
   Adversarial Transformer Network (FQSR-GKATN) to improve security and
   efficiency. The proposed method enhances critical AES transformations,
   such as SubBytes and MixColumns, by incorporating fuzzy Q-values for
   regularization, self-guided structuring for adaptive learning, and a
   retention mechanism to optimize resource usage. When implemented in
   hybrid cryptosystems like AES on FPGA PSoC (Programmable System on
   Chip), this architecture accelerates execution time and ensures improved
   security while optimizing resource consumption. The implementation
   achieves a balance between performance, throughput 97.87 Mbps, power
   consumption as 0.003 W, and security 99\%, making it suitable for
   high-security cryptographic applications.},
Type = {Article; Early Access},
Affiliation = {Srinivasan, K (Corresponding Author), Sri Sairam Engn Coll, Dept Elect \& Commun Engn, Chennai, India.
