@article{ WOS:001727523500001,
Author = {Jiang, Han and Li, Susu and Liang, Shuibao and Dou, Guangbin},
Title = {Coupled Finite Element Analysis and Phase Field Modeling of
   Thermomechanical Fracture in Through-Glass Vias for Advanced Packaging},
Journal = {IEEE TRANSACTIONS ON ELECTRON DEVICES},
Year = {2026},
Month = {2026 },
Abstract = {Through-glass via (TGV) structures have been proven to be promising
   interconnect solutions for advanced packaging applications, while the
   coefficient of thermal expansion (CTE) mismatch between copper and glass
   induces severe stress concentrations and fracture during thermal
   loading. This study develops a coupled finite element and phase field
   modeling framework to simulate the thermomechanical fracture behavior of
   copper-filled TGV structures subjected to annealing. The simulations
   successfully capture arbitrary crack propagation paths in good agreement
   with experiments, revealing different failure modes: radial cracking
   during heating driven by circumferential stresses, and circumferential
   cracking during cooling driven by radial stresses. The influence of
   heating rate on crack formation mechanisms is systematically
   investigated, revealing the critical role of competition between stress
   accumulation and stress relaxation through copper creep. For the
   investigated TGV configuration, heating rates below 6.5 degrees C/min
   effectively suppress radial cracking during heating but cannot prevent
   circumferential cracking during cooling, while rates above 8.7 degrees
   C/min lead to dual-stage damage with significantly elevated damage
   levels. These findings establish heating rate as a critical control
   parameter for TGV manufacturing reliability and provide quantitative
   insights for design optimization of TGV-based advanced packaging
   structures.},
