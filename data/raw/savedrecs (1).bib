@article{ WOS:001555495500001,
Author = {Zhao, Hongfa and Wang, Baiqiao and Ruan, Liguang and Liu, Xiangyu and
   Pi, Yucong and Zhong, Junwen and Lin, Liwei and Wang, Zhong Lin and
   Ding, Wenbo},
Title = {Theoretical analysis of triboelectric nanogenerators: Charge mechanisms,
   energy conversion, and multifunctional applications},
Journal = {NANO ENERGY},
Year = {2025},
Volume = {144},
Month = {NOV},
Abstract = {Triboelectric nanogenerators (TENGs) are promising for energy harvesting
   and self-powered sensing, while a robust theoretical foundation is
   essential for their further developments. This study presents a
   comprehensive framework integrating charge distribution, electric field
   behavior, and energy conversion. Beginning with the initial charge
   formed during fabrication, the analysis derives self-consistent models
   of charge transfer and field evolution. Electric field energy is
   identified as a key parameter to ensure conservation across mechanical
   input, internal field energy, and electrical output. Based on this
   framework, the unique load-dependent current behavior of TENGs is
   explained, and the conditions for maximum energy output are evaluated
   through voltagecurrent and field energy relationships. The theory is
   further extended to predict and experimentally validate the actuation
   capability of TENGs, demonstrating vibrations in the 1-10 kHz range
   under external voltage. Additionally, the external radiation electric
   field induced by TENG motion is explored, indicating potential for
   electromagnetic communication. These findings deepen the theoretical
   understanding of TENGs and establish a foundation for their
   multifunctional applications in sensing, actuation, and wireless
   interfacing.},
