Title = {Design approaches and consideration for a reliable and efficient
   Monolithic 3D Integration},
Booktitle = {2024 IEEE COMPUTER SOCIETY ANNUAL SYMPOSIUM ON VLSI, ISVLSI},
Series = {IEEE Computer Society Annual Symposium on VLSI},
Year = {2024},
Pages = {533-538},
Note = {IEEE-Computer-Society Annual Symposium on VLSI (ISVLSI), Knoxville, TN,
   JUL 01-03, 2024},
Abstract = {Moore's law is reaching its end due to limitations in transistor
   scaling. With recent advancements in Monolithic Three-Dimensional (M3D)
   integration, we can meet the transistor density requirements for
   next-generation IC designs. Using M3D, we can significantly reduce the
   footprint occupied by an IC, thus improving the transistor density.
   These savings are attributed to sequential integration from M3D, which
   allows sequential processing of substrate layers. In M3D, transistor
   devices are created on top of each other, and metal interconnect layers
   are utilized to create connections between them. The choice of process
   for creating the top and bottom devices can vary based on the
   application, and it can impact the design rules. In this work, we look
   into the design considerations for 1) the Bulk-Silicon (Bulk-Si) process
   and 2) the Fully-Depleted Silicon on Insulator (FD-SOI) process. The
   standard logic cells and SRAM memory cell implementations are discussed
   for different processes based on design considerations.},
