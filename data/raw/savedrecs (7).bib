@inproceedings{ WOS:001042307500097,
Author = {Han, Ming and Wang, Ye and Dong, Jian and Liu, Heng and Wu, Jin and Qu,
   Gang},
Book-Group-Author = {ACM},
Title = {ATC: Approximate Temporal Coding for Efficient Implementations of
   Spiking Neural Networks},
Booktitle = {PROCEEDINGS OF THE GREAT LAKES SYMPOSIUM ON VLSI 2023, GLSVLSI 2023},
Year = {2023},
Pages = {527-532},
Note = {33rd Great Lakes Symposium on VLSI (GLSVLSI), Knoxville, TN, JUN 05-07,
   2023},
Abstract = {Spiking Neural Networks (SNN) update their neurons' states, the most
   energy consuming action, only after receiving or firing spikes for
   energy efficiency. So reducing the number of spikes would lead to more
   efficient SNN implementations. We propose an approximate temporal coding
   (ATC) for this purpose. Because the reduction of spikes leads to more
   synapses being used rarely, we develop a pruning method for further
   energy improvement. Experimental results validate the efficiency of ATC
   and the pruning method. On the MNIST dataset, for example, 61\% of the
   spikes are reduced, leading to 60\% energy saving without any accuracy
   loss.},
Type = {Proceedings Paper},
Affiliation = {Dong, J (Corresponding Author), Harbin Inst Technol, Harbin, Peoples R China.
   Han, Ming; Wang, Ye; Dong, Jian; Liu, Heng; Wu, Jin, Harbin Inst Technol, Harbin, Peoples R China.
