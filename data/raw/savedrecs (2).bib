DOI = {10.1109/ACCESS.2025.3538936},
Keywords = {IP networks; Trojan horses; Security; Microprogramming; Authentication;
   Table lookup; Hardware; Field programmable gate arrays; Logic gates;
   Fingerprint recognition; Authentication protocol; digest uniqueness to
   detect trojans; hardware trojans; PUF-based device-specific fingerprint;
   secure firmware update; utilization scale},
