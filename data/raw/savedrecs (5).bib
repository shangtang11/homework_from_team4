Title = {Approximate Fault-Tolerant Neural Network Systems},
Booktitle = {IEEE EUROPEAN TEST SYMPOSIUM, ETS 2024},
Series = {Proceedings of the European Test Symposium},
Year = {2024},
Note = {IEEE European Test Symposium (ETS), Hague, NETHERLANDS, MAY 20-24, 2024},
Abstract = {This paper aims to comprehensively explore challenges and opportunities
   to design highly efficient Neural Network (NN) systems through
   Approximate Computing (AxC) techniques while ensuring fault tolerance
   properties. By highlighting the intrinsic conflicting goals of AxC and
   fault tolerance principles, the study aims to stimulate and contribute
   to a deeper understanding of how important it is to consider fault
   tolerance requirements while designing approximate-computing-based
   systems. This is key to developing highly efficient fault-tolerant
   architectures for Neural Networks.},
