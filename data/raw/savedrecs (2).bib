@inproceedings{ WOS:001687137600005,
Author = {Feng, Yuanhao and Zhang, Youwei and Zhou, Hao and Zhang, Xiang and Liu,
   Zhi},
Book-Group-Author = {ACM},
Title = {A Lightweight Edge-Centric Chewing Sensing System with Multimodal
   Biosignal Fusion for Oral Health Monitoring},
Booktitle = {COMPANION OF THE 2025 ACM INTERNATIONAL JOINT CONFERENCE ON PERVASIVE
   AND UBIQUITOUS COMPUTING, UBICOMP COMPANION 2025},
Year = {2025},
Pages = {10-14},
Note = {2025 International Joint Conference on Pervasive and Ubiquitous
   Computing-UbiComp Companion, Espoo, FINLAND, OCT 12-16, 2025},
Abstract = {Tooth health is essential to overall well-being, yet remains largely
   unmonitored outside of dental clinics. We present NeuroChew, a
   multimodal wearable system that infers oral health status from everyday
   chewing behavior. By integrating electromyography (EMG),
   electrooculography (EOG), and electroencephalography (EEG), NeuroChew
   captures neuromuscular, attentional, and cognitive signals related to
   chewing. From these signals, the system extracts features such as
   symmetry, rhythm regularity, and EEG-based cognitive strain, enabling
   classification into three health-related chewing states: Normal,
   Asymmetric, and Discomfort. A lightweight Transformer-based model
   performs the classification, augmented by a rule-based refinement layer
   to improve interpretability and robustness. In a 20-participant pilot
   study, NeuroChew achieved 83.7\% accuracy, a macro F1 score of 0.826,
   and a macro AUC of 0.893 in distinguishing the three chewing states.
   These results demonstrate the feasibility of behavior-based,
   non-invasive oral health monitoring using wearable biosignals, and point
   toward new opportunities for ubiquitous dental diagnostics in everyday
   life. The system is designed with real-time processing in mind,
   supporting future deployment across edge-cloud infrastructures and
   autonomous agents.},
