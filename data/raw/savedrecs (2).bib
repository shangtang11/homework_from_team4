@inproceedings{ WOS:001559160300017,
Author = {Bai, Kangbo and Yan, Peiran and Liu, Lifeng and Jia, Tianyu},
Book-Group-Author = {IEEE},
Title = {VeriRAG: Design AI-Specific CPU Co-processor with RAG-Enhanced LLMs},
