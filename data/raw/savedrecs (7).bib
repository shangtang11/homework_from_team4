@article{ WOS:000928146100001,
Author = {Khatib, Emil J. J. and Alvarez-Merino, Carlos Simon and Luo-Chen, Hao
   Qiang and Moreno, Raquel Barco},
Title = {Designing a 6G Testbed for Location: Use Cases, Challenges, Enablers and
   Requirements},
Journal = {IEEE ACCESS},
Year = {2023},
Volume = {11},
Pages = {10053-10091},
Abstract = {Location will have a central role in Research and Development (R \& D)
   towards 6G networks, both as a service offered by the network (improving
   the current offering of 5G) and as an input to increasingly
   location-aware services and network functions. To integrate location
   into 6G standards, it will be very important to design validation
   systems such as testbeds, even when the actual technology is not yet
   commercially available. This paper performs a review of the use cases
   and their requirements, enabling technologies in 6G, and challenges; and
   proposes a flexible testbed architecture for performing network location
   related R \& D. This architecture will allow to deploy an evolving
   infrastructure which will allow early validation of 6G technologies.},
Type = {Review},
