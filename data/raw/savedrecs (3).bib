@inproceedings{ WOS:001572852800064,
Author = {Wang, Jianhuan and Xiao, Bin},
Book-Group-Author = {ACM},
Title = {Pace: Privacy-Preserving and Atomic Cross-chain Swaps for Cryptocurrency
   Exchanges},
Booktitle = {PROCEEDINGS OF THE 20TH ACM ASIA CONFERENCE ON COMPUTER AND
   COMMUNICATIONS SECURITY, ACM ASIACCS 2025},
Year = {2025},
Pages = {985-1002},
Note = {20th Asia Conference on Computer and Communications
   Security-ASIACCS-Annual, Hanoi, VIETNAM, AUG 25-29, 2025},
Abstract = {Cryptocurrency exchanges serve as critical infrastructure within the
   blockchain ecosystem, providing traders with accessible platforms for
   exchanging cryptocurrencies across a vast blockchain network. Atomic
   swap represents a promising underlying protocol for currency exchanges,
   ensuring secure currency swaps for traders. However, most existing
   atomic swap solutions fail to consider user privacy, with only a few
   achieving privacy preservation under specific constraints (e.g., only
   supporting anonymous blockchains or relying on the stable price
   assumption). These constraints limit their applicability in the volatile
   cryptocurrency market.
   To remove these constraints, we present Pace, a novel privacy-preserving
   atomic swap protocol that supports public blockchains like Bitcoin and
   Ethereum. Pace also maintains the balance security of both honest
   platforms and traders while removing the stable price assumption,
   thereby enhancing its applicability in the volatile cryptocurrency
   market. To enhance user privacy, we propose a 1-to-1 swap protocol that
   integrates mixers as relays, ensuring all transfers within the swap
   achieve unlinkability. To avoid atomicity issues arising from an
   increase in transfers, we propose the combinable and randomizable
   puzzle, an extension of existing randomizable puzzles that enables
   atomic execution for multiple transfers with different puzzles. In
   addition, we extend 1-to-1 swap protocol to 1-to-.. swap protocol to
   achieve flexible exchange rate settings, thereby removing the stable
   price assumption. We then provide a comprehensive security analysis to
   demonstrate that, even if the platform and another user are malicious,
   the unlinkability of the honest user' cross-chain addresses is still
   guaranteed. Finally, we implement a prototype of Pace and validate its
   practicality.},
Type = {Proceedings Paper},
Affiliation = {Wang, JH (Corresponding Author), Hong Kong Polytech Univ, Hong Kong, Peoples R China.
   Wang, Jianhuan; Xiao, Bin, Hong Kong Polytech Univ, Hong Kong, Peoples R China.},
