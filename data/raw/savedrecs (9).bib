@inproceedings{ WOS:000783821500006,
Author = {Abate, Carmine and Busi, Matteo and Tsampas, Stelios},
Editor = {Oh, H},
Title = {Fully Abstract and Robust Compilation And How to Reconcile the Two,
   Abstractly},
Booktitle = {PROGRAMMING LANGUAGES AND SYSTEMS, APLAS 2021},
Series = {Lecture Notes in Computer Science},
Year = {2021},
Volume = {13008},
Pages = {83-101},
Note = {19th Asian Symposium on Programming Languages and Systems (APLAS),
   Chicago, IL, OCT 17-18, 2021},
Abstract = {The most prominent formal criterion for secure compilation is full
   abstraction, the preservation and reflection of contextual equivalence.
   Recent work introduced robust compilation, defined as the preservation
   of robust satisfaction of hyperproperties, i.e., their satisfaction
   against arbitrary attackers. In this paper, we initially set out to
   compare these two approaches to secure compilation. To that end, we
   provide an exact description of the hyperproperties that are robustly
   satisfied by programs compiled with a fully abstract compiler, and show
   that they can be meaningless or trivial. We then propose a novel
   criterion for secure compilation formulated in the framework of
   Mathematical Operational Semantics (MOS), guaranteeing both full
   abstraction and the preservation of robust satisfaction of
   hyperproperties in a more sensible manner.},
Type = {Proceedings Paper},
Affiliation = {Tsampas, S (Corresponding Author), Katholieke Univ Leuven, Leuven, Belgium.
