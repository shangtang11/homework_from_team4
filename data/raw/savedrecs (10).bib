@inproceedings{ WOS:000628528400135,
Author = {Herdt, Vladimir and Gross, Daniel and Drechsler, Rolf},
Book-Group-Author = {IEEE},
Title = {Closing the RISC-V Compliance Gap: Looking from the Negative Testing
   Side},
Booktitle = {PROCEEDINGS OF THE 2020 57TH ACM/EDAC/IEEE DESIGN AUTOMATION CONFERENCE
   (DAC)},
Series = {Design Automation Conference DAC},
Year = {2020},
Note = {57th ACM/IEEE Design Automation Conference (DAC), ELECTR NETWORK, JUL
   20-24, 2020},
Abstract = {Compliance testing for RISC-V is very important. Therefore, an official
   hand-written compliance test-suite is being actively developed. However,
   besides requiring significant manual effort, it focuses on positive
   testing (the implemented instructions work as expected) only and
   neglects negative testing (consider illegal instructions to also ensure
   that no additional/unexpected behavior is accidentally added). This
   leaves a large gap in compliance testing.
   In this paper we propose a fuzzing-based test-suite generation approach
   to close this gap. We found new bugs in several RISC-V simulators
   including riscvOVPsim from Imperas which is the official reference
   simulator for compliance testing.},
