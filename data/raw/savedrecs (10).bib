@article{ WOS:000541147900009,
Author = {Stahl, Rafael and Mueller-Gritschneder, Daniel and Schlichtmann, Ulf},
Title = {Driver Generation for IoT Nodes With Optimization of the
   Hardware/Software Interface},
Journal = {IEEE EMBEDDED SYSTEMS LETTERS},
Year = {2020},
Volume = {12},
Number = {2},
Pages = {66-69},
Month = {JUN},
Abstract = {The Internet of Things (IoT) connects many tiny low-cost devices,
   so-called IoT nodes. Designers need to implement smart functionality
   with highly limited resources in terms of design effort, available
   on-chip memory, and computation power. This letter proposes a new method
   to reduce memory size, performance, and development effort for the
   device drivers. The driver behavior is developed with a new C-like
   domain-specific language. Through register layout optimization targeting
   to combine accesses it achieves to reduce run time by 52\% and code size
   by 22\% for two RISC-V PULPino device drivers.},
