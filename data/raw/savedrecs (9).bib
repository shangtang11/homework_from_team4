@inproceedings{ WOS:000701418600006,
Author = {Agnesina, Anthony and Brunion, Moritz and Kim, Jinwoo and Garcia-Ortiz,
   Alberto and Milojevic, Dragomir and Catthoor, Francky and Perumkunnil,
   Manu and Lim, Sung Kyu},
Book-Group-Author = {IEEE},
Title = {Power, Performance, Area and Cost Analysis of Memory-on-Logic
   Face-to-Face Bonded 3D Processor Designs},
Booktitle = {2021 IEEE/ACM INTERNATIONAL SYMPOSIUM ON LOW POWER ELECTRONICS AND
   DESIGN (ISLPED)},
Series = {International Symposium on Low Power Electronics and Design},
Year = {2021},
Note = {IEEE/ACM International Symposium on Low Power Electronics and Design
   (ISLPED), ELECTR NETWORK, JUL 26-28, 2021},
Abstract = {In this paper, we present a power, performance, area and cost (PPAC)
   analysis for large-scale 3D processor designs based on wafer-to-wafer
   bonding. From the evaluation of our cost model, we investigate a
   typically disregarded opportunity in 3D that is area savings due to
   buffer savings and better routability, offering unexpected cost savings.
   We explore the viability of this factor with the feedback of a
   state-of-the-art 3D memory-on-logic implementation flow. We show how
   this affects the PPAC of full-chip GDS implementations of a large-scale
   manycore processor design. Experiments show that our memory-on-logic 3D
   implementation offers 7\% silicon area savings, resulting in 53.5\%
   footprint reduction. We also obtain a 40\% power-performance-cost
   improvement compared with 2D counterparts.},
