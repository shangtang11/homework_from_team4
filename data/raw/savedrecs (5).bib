Title = {Implementation of High-speed and High-Accuracy Convolutional Neural
   Network Accelerator for Target Detection Applications},
Booktitle = {2024 5TH INTERNATIONAL CONFERENCE ON INNOVATIVE TRENDS IN INFORMATION
   TECHNOLOGY, ICITIIT 2024},
Year = {2024},
Note = {5th International Conference on Innovative Trends in Information
   Technology (ICITIIT), Kottayam, INDIA, MAR 15-16, 2024},
Abstract = {Deep Convolutional Neural Network (CNN) for real-time applications
   heavily depends on computing efficiency. The efficiency of the CNN
   algorithm has been improved by modifying Convolutional Neural Network
   accelerator. Thus, the proposed work development of improved CNN
   accelerator using Residue Number System (RNS) and implement in FPGA for
   performance investigation of throughput, latency, accuracy. The
   non-weighted nature of RNS makes it suitable for highspeed applications.
   As a result, it requires less space to house input feature maps and
   kernels. In addition to that, the proposed method will allow for
   parallel computation and required less power consumption. According to
   test results, the planned CNN accelerator can run the AlexNet at 165.4
   frames per second, 200.5 GOPs per second at its max, and 22.5 GOPs per
   Watt. Additionally, it can be changed to support VGG-16 for complicated
   object recognition.},
