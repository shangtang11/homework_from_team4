@article{ WOS:001495161100001,
Author = {Feng, Xiaoyu and Lu, Tianai and Zhou, Lu},
Title = {A 4D memristive chaotic system with multiple amplitude and offset
   controllers},
Journal = {PHYSICA SCRIPTA},
Year = {2025},
Volume = {100},
Number = {6},
Month = {JUN 1},
Abstract = {This paper constructs a novel 4D memristive chaotic system based on the
   classical Lorenz-like system. The study reveals that, despite the
   system's asymmetric nature, it can exhibit coexisting attractor basins
   with quasi-symmetric structures under specific parameter configurations.
   Further analysis shows that the system possesses two independent
   amplitude control parameters, one can simultaneously regulate the
   scaling of three state variables, while the other can regulate the
   amplitude of the memristor variable. Notably, offset control of the
   memristive variable can also be achieved, and only under the condition
   of the offset boosting of the memristive variable, changing the
   memristive coupling coefficient can induce offset in another system
   variable. Finally, the effectiveness of the system's amplitude and
   offset control characteristics is verified through analog circuit
   experiments, which provides a new theoretical basis and technical
   support for application to pseudo-random number generators.},
Type = {Article},
Affiliation = {Feng, XY (Corresponding Author), Nanjing Vocat Univ Ind Technol, Nanjing 210023, Peoples R China.
