   endri.bezati@epfl.ch
   jwj@cs.lth.se},
Affiliations = {Swiss Federal Institutes of Technology Domain; Ecole Polytechnique
   Federale de Lausanne; Lund University},
Cited-References = {{[}Anonymous], CHISEL BACKEND STREA.
