@article{ WOS:000777822100001,
Author = {Xiang, Rong},
Title = {Atomic precision manufacturing of carbon nanotube-a perspective},
Journal = {INTERNATIONAL JOURNAL OF EXTREME MANUFACTURING},
Year = {2022},
Volume = {4},
Number = {2},
Month = {JUN 1},
Abstract = {Carbon nanotube (CNT), particularly single-walled CNT, possesses
   exceptional properties, and can be utilized in many high-end
   applications including high-performance electronics. However, the atomic
   arrangement of a CNT determines its band structure, making the
   atomic-precision fabrication one of most important topics for the
   development of this material. In this perspective, the author gives a
   personal summary on the history, current status of the atomic-precision
   fabrication of CNT and outlines the remaining challenges as well as the
   possible paths that may lead the production of atomically precise CNTs
   from `fabrication' to `manufacturing'.},
