@article{ WOS:001658722900001,
Author = {Li, Mingyang and Kan, Yirong and Wu, Man and Zhang, Renyuan and
   Nakashima, Yasuhiko},
Title = {FPSpike: A Fully Parallel and Reconfigurable Architecture for
   Accelerating Spiking Neural Networks With Structured Sparsity},
Journal = {IEEE TRANSACTIONS ON CIRCUITS AND SYSTEMS I-REGULAR PAPERS},
Year = {2026},
Month = {2026 JAN 7},
Abstract = {This paper introduces FPSpike, a fully-parallel and reconfigurable
   architecture for accelerating spiking neural networks (SNNs) with
   structured sparsity. By introducing structured sparse synaptic
   connections, the neuron computation and weight storage costs are
   significantly reduced, while the wiring constraints of hardware
   implementation are alleviated, thus realizing a fully parallel SNN
   architecture on a single chip. Furthermore, FPSpike achieves high
   reconfigurability through local connections, allowing the network
   topology to be flexibly partitioned into multiple distinct hardware
   cores without redundancy, thereby enabling multi-task spatial parallel
   processing. In particular, a series of software-hardware co-designs are
   performed to improve the performance of FPSpike. Experimental results
   with FPGA-based implementation demonstrate that FPSpike achieves
   inference throughput improvements of 2.5x similar to 43.9x and 3.2x
   similar to 93.8x compared to Intel i7-12700K CPU and NVIDIA RTX3060Ti
   GPU, respectively. FPSpike also achieves performance speedups of 2.0x
   similar to 20.2x and energy efficiency improvements of 1.3x similar to
   7.7x compared to the state-of-the-art FPGA-based SNN accelerators.},
Type = {Article; Early Access},
Affiliation = {Kan, YR (Corresponding Author), Nara Inst Sci \& Technol, Div Informat Sci, Ikoma 6300192, Japan.
