@inproceedings{ WOS:001506972600122,
Author = {Qiu, Yuhang and Li, Wenming and Liu, Tianyu and Wang, Zhen and Zhang,
   Zhiyuan and Fan, Zhihua and Ye, Xiaochun and Fan, Dongrui and Tang,
   Zhimin},
Book-Group-Author = {IEEE},
Title = {Accelerating Authenticated Block Ciphers via RISC-V Custom Cryptography
   Instructions},
Booktitle = {2025 DESIGN, AUTOMATION \& TEST IN EUROPE CONFERENCE, DATE},
Series = {Design Automation and Test in Europe Conference and Exhibition},
Year = {2025},
Note = {2025 Design, Automation \& Test in Europe Conference-DATE, Lyon, FRANCE,
   MAR 31-APR 02, 2025},
Abstract = {As one of the standardized encryption algorithms, authenticated block
   ciphers based on Galois/Counter Mode (GCM) is a widely-used method to
   guarantee the accuracy and reliability in data transmission. The
   profiling work demonstrates that across the execution process of GCM
   mode, the authentication operation is the main performance bottleneck
   because it introduces operations in high-dimensional Galois field (GF),
   which could not be efficiently executed via existing ISA. To overcome
   this problem, we propose a custom ISA extension and cooperate it with
   RISC-V cryptography extension to accelerate the whole process of
   authenticated block ciphers. Besides, we design a specific crypto core
   including a fully-pipelined GF(2128) multiplier to support the extended
   instructions and integrate it into the multi-issue out-of-order core
   XT910 without introducing any clock frequency overhead. The proposed
   design significantly reduces the the number of instructions required in
   the main operations of authenticated block ciphers. We compare the
   performance of our designs to other existing acceleration scheme based
   on RISC-V ISA extension. Experimental result shows that our design
   outperforms other related work and achieves up to 17x speedup with a
   lightweight hardware overhead.},
Type = {Proceedings Paper},
