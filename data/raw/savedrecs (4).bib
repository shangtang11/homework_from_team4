DOI = {10.1109/DFT63277.2024.10753557},
Keywords = {Software-Based Self-Test; Functional ATPG; Automatic SBST;
   Microprocessor Test; RISC-V},
Affiliations = {Polytechnic University of Turin; University of Freiburg},
Cited-References = {Bernardi P., 2015, EUR TEST S ETS.
   Bierre A., 2009, Handbook of Satisfiability.
