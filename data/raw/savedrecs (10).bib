@inproceedings{ WOS:000621592204087,
Author = {Kartsch, Victor and Artoni, Fiorenzo and Benatti, Simone and Micera,
   Silvestro and Benini, Luca},
Book-Group-Author = {IEEE},
Title = {Using Low-Power, Low-Cost IoT Processors in Clinical Biosignal Research:
   an In-depth Feasibility Check},
Booktitle = {42ND ANNUAL INTERNATIONAL CONFERENCES OF THE IEEE ENGINEERING IN
   MEDICINE AND BIOLOGY SOCIETY: ENABLING INNOVATIVE TECHNOLOGIES FOR
   GLOBAL HEALTHCARE EMBC'20},
Series = {IEEE Engineering in Medicine and Biology Society Conference Proceedings},
Year = {2020},
