@article{ WOS:001532151900010,
Author = {Margalit, Roy and Kokologiannakis, Michalis and Itzhaky, Shachar and
   Lahav, Ori},
Title = {Dynamic Robustness Verification against Weak Memory},
Journal = {PROCEEDINGS OF THE ACM ON PROGRAMMING LANGUAGES-PACMPL},
Year = {2025},
Volume = {9},
Number = {PLDI},
Month = {JUN},
Abstract = {Dynamic race detection is a highly effective runtime verification
   technique for identifying data races by instrumenting and monitoring
   concurrent program runs. However, standard dynamic race detection is
   incompatible with practical weak memory models; the added
   instrumentation introduces extra synchronization, which masks weakly
   consistent behaviors and inherently misses certain data races. In
   response, we propose to dynamically verify program robustness-a property
   ensuring that a program exhibits only strongly consistent behaviors.
   Building on an existing static decision procedure, we develop an
   algorithm for dynamic robustness verification under a C11-style memory
   model. The algorithm is based on ``location clocks{''}, a variant of
   vector clocks used in standard race detection. It allows effective and
   easy-to-apply defense against weak memory on a per-program basis, which
   can be combined with race detection that assumes strong consistency. We
   implement our algorithm in a tool, called RSAN, and evaluate it across
   various settings. To our knowledge, this work is the first to propose
   and develop dynamic verification of robustness against weak memory
   models.},
Type = {Article},
Affiliation = {Margalit, R (Corresponding Author), Tel Aviv Univ, Tel Aviv, Israel.
   Margalit, Roy; Lahav, Ori, Tel Aviv Univ, Tel Aviv, Israel.
   Kokologiannakis, Michalis, Swiss Fed Inst Technol, Zurich, Switzerland.
   Itzhaky, Shachar, Technion, Haifa, Israel.},
DOI = {10.1145/3729277},
Article-Number = {174},
Keywords = {Weak memory models; C/C++11; Robustness; Dynamic race detection},
