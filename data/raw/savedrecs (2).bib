@inproceedings{ WOS:001698301700124,
Author = {Jin, Luochen and Xie, Xiaoyan and Yu, Jinhao and Ren, Xun},
Editor = {Tian, H},
Title = {Data Reuse and Locality Optimization Method Based on GEMM},
Booktitle = {EIGHTH INTERNATIONAL CONFERENCE ON ARTIFICIAL INTELLIGENCE AND PATTERN
   RECOGNITION, AIPR 2025, PT 1},
Series = {Proceedings of SPIE},
Year = {2025},
Volume = {13993},
Note = {8th International Conference on Artificial Intelligence and Pattern
   Recognition-AIPR, Quanzhou, PEOPLES R CHINA, SEP 19-21, 2025},
Abstract = {When deploying convolutional neural networks (CNNs) on GPU platforms,
   traditional General Matrix Multiplication (GEMM)-based convolution
   acceleration methods exhibit coarse-grained data locality management,
   failing to explicitly distinguish between high-frequency reused data and
   low-frequency accessed data, thereby limiting data reuse efficiency. To
   address this issue, this paper proposes a Locality-DataReuse-GEMM
   (L-DR-GEMM) method based on data reuse and locality optimization. First,
   the data of CNN convolutional layers is partitioned and tiled, with the
   block size dynamically adjusted according to the GPU's cache capacity.
   Second, the shared memory is decoupled into two independent buffers.
   Leveraging the principle of data locality, high-frequency accessed input
   data and weight data are pre-identified and retained in their respective
   buffers for full reuse. Experiments demonstrate that compared to
   traditional GEMM, the proposed method achieves an average speedup of
   1.08x for 1x1 convolutions and 1.12x for 3x3 convolutions. In
   small-batch inference scenarios, the method improves the processing
   efficiency of 3x3 kernels by an average of 1.10x. For the complete
   VGG-16 network, the performance improvement reaches 1.20x.},
