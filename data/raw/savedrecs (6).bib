@inproceedings{ WOS:001073487300137,
Author = {Chowdhury, Subhajit Dutta and Yang, Kaixin and Nuzzo, Pierluigi},
Book-Group-Author = {IEEE},
Title = {SimLL: Similarity-Based Logic Locking Against Machine Learning Attacks},
Booktitle = {2023 60TH ACM/IEEE DESIGN AUTOMATION CONFERENCE, DAC},
Year = {2023},
Note = {60th ACM/IEEE Design Automation Conference (DAC), San Francisco, CA, JUL
   09-13, 2023},
Abstract = {Logic locking is a promising technique for protecting integrated circuit
   designs while outsourcing their fabrication. Recently, graph neural
   network (GNN)-based link prediction attacks have been developed which
   can successfully break all the multiplexer-based locking techniques that
   were expected to be learning-resilient. We present SimLL, a novel
   similarity-based locking technique which locks a design using
   multiplexers and shows robustness against the existing
   structure-exploiting oracle-less learning-based attacks. Aiming to
   confuse the machine learning (ML) models, SimLL introduces
   key-controlled multiplexers between logic gates or wires that exhibit
   high levels of topological and functional similarity. Empirical results
   show that SimLL can degrade the accuracy of existing ML-based attacks to
   approximately 50\%, resulting in a negligible advantage over random
   guessing.},
Type = {Proceedings Paper},
Affiliation = {Chowdhury, SD (Corresponding Author), Univ Southern Calif, Ming Hsieh Dept Elect \& Comp Engn, Los Angeles, CA 90007 USA.
   Chowdhury, Subhajit Dutta; Yang, Kaixin; Nuzzo, Pierluigi, Univ Southern Calif, Ming Hsieh Dept Elect \& Comp Engn, Los Angeles, CA 90007 USA.},
DOI = {10.1109/DAC56929.2023.10247822},
Keywords = {Topological similarity; graph neural networks; machine learning; link
   prediction; hardware security},
Author-Email = {duttacho@usc.edu
   kaixinya@usc.edu
   nuzzo@usc.edu},
Affiliations = {University of Southern California},
Cited-References = {Alaql A, 2021, IEEE T VLSI SYST, V29, P1529, DOI 10.1109/TVLSI.2021.3089555.
