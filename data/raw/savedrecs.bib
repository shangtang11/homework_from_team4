@article{ WOS:001540964800002,
Author = {Antony, Amalan Joseph and Singh, Kunwar},
Title = {Millionaires' problem revisited},
Journal = {COMPUTERS \& ELECTRICAL ENGINEERING},
Year = {2025},
Volume = {127},
Number = {A},
Month = {OCT},
Abstract = {The millionaires' problem was presented by Andrew Yao in 1982, where two
   millionaires wish to find out which of them is richer, without however
   revealing their wealth to the other. Today, many applications exist
   where it is required to compare numerical values in confidence. In 2022,
   Liu et al. proposed a protocol to solve the millionaires' problem using
   Elliptic Curve Cryptography principles in a semi-honest model, which
   they extend to a malicious model (Liu et al., 2022). In this article, we
   (1) present attacks to show that Liu et al.'s protocol for the
   semi-honest model leaks information, (2) present attacks to show that
   Liu et al.'s protocol for the malicious model leaks information and also
   show that it is incorrect, and (3) propose provably secure protocols to
   solve the millionaires' problem in the semi-honest model as well as in
   the malicious model using Zero-Knowledge Proof and Oblivious Transfer.},
Type = {Article},
Affiliation = {Antony, AJ (Corresponding Author), Indian Inst Informat Technol Design \& Mfg, Dept Comp Sci \& Engn, Kancheepuram, Chennai 600127, Tamil Nadu, India.
