EarlyAccessDate = {MAY 2021},
Keywords = {Ensemble learning; Reconfigurable accelerators; DSE},
Author-Email = {alba.lopes@ifrn.edu.br
   monicapereira@dimap.ufrn.br},
Affiliations = {Instituto Federal do Rio Grande do Norte; Universidade Federal do Rio
   Grande do Norte},
Cited-References = {Binkert Nathan, 2011, Computer Architecture News, V39, P1, DOI 10.1145/2024716.2024718.
