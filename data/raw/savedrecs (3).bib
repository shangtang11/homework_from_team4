Affiliation = {Kung, J (Corresponding Author), Korea Univ, Sch Elect Engn, Seoul, South Korea.
   Park, Jiyong; Park, Dahoon; Hong, Yeeun; Kung, Jaeha, Korea Univ, Sch Elect Engn, Seoul, South Korea.},
