@inproceedings{ WOS:001310519400073,
Author = {Mahdavi, Mojtaba},
Book-Group-Author = {IEEE},
Title = {Memristor-Based Square Root Computation for Signal Processing
   Applications},
Booktitle = {2024 IEEE INTERNATIONAL BLACK SEA CONFERENCE ON COMMUNICATIONS AND
   NETWORKING, BLACKSEACOM 2024},
Series = {International Black Sea Conference on Communications and Networking},
Year = {2024},
Pages = {376-381},
Note = {12th IEEE International Black Sea Conference on Communications and
   Networking (BlackSeaCom), Georgian Tech Univ, Tbilisi, GEORGIA, JUN
   24-27, 2024},
Abstract = {The square root operation is a fundamental mathematical operation with
   extensive applications in various domains including signal processing
   and wireless communication systems. This paper presents a low-complexity
   and reconfigurable design methodology to implement the square root
   function. The key idea is to employ in memory computing (IMC) technique
   and perform the computations using a set of memristive devices. More
   specifically, the necessary multiplications and additions will be
   carried out by utilizing the inherent characteristics of memristor
   devices, following Ohm's law and Kirchhoff's current law. This inventive
   approach not only boosts flexibility but also underscores processing
   efficiency. By minimizing computational complexity and latency, it
   surpasses conventional implementation methods.},
Type = {Proceedings Paper},
Affiliation = {Mahdavi, M (Corresponding Author), Ericsson, Ericsson Res, Lund, Sweden.
