@article{ WOS:001634029300001,
Author = {Zeng, Jiang and Yang, Yaoquan and Xiao, Yang and Ni, Zehuan},
Title = {Enhancing stability and harmonic rejection ability of LCL-type
   grid-connected inverter with high-gain tracking differentiator},
Journal = {ELECTRIC POWER SYSTEMS RESEARCH},
Year = {2026},
Volume = {253},
Month = {APR},
Abstract = {Extensive state-variable-based methods have been proposed to address the
   inherent resonance and grid harmonic disturbances of LCL-type
   grid-connected inverters, but they typically require extra sensors and
   suffer from performance degradation due to time delays in digital
   control systems. To address these limitations, this article proposes a
   streamlined framework using only inverter-side current feedback and
   point-of-common coupling (PCC) voltage feedforward, enabling fast
   overcurrent protection, power control, synchronization, active damping,
   and grid harmonic disturbance suppression. For the control delay
   problem, an innovative trapezoidal method-based high-gain tracking
   differentiator (HGTD) is proposed to extract the highly accurate
   differential signals. By leveraging the proposed HGTD, first-order and
   second-order delay compensations are employed at PCC voltage feedforward
   to expand the equivalent positive damping range and reduce the output
   admittance of the inverter. The analysis also covers the impact of
   compensation parameters on loop stability margin and harmonic rejection
   performance. Finally, hardware-in-the-loop validation confirms the
   effectiveness of the proposed methods.},
Type = {Article},
Affiliation = {Yang, YQ (Corresponding Author), South China Univ Technol, Sch Elect Power, Guangzhou 510641, Peoples R China.
   Zeng, Jiang; Yang, Yaoquan; Xiao, Yang; Ni, Zehuan, South China Univ Technol, Sch Elect Power, Guangzhou 510641, Peoples R China.},
