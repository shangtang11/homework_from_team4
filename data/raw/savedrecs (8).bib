Pages = {324-333},
Note = {7th Brazilian Technology Symposium (BTSym) - Emerging Trends and
   Challenges in Technology, PUC Campinas Univ, ELECTR NETWORK, NOV, 2021},
Abstract = {Due to the high processing capacity, the Field Programmable Gate Array
   (FPGA) has been applied in space missions, which are susceptible to
   failures caused by Single-Event Upset (SEU). Due to cost and import
   restrictions, the use of unqualified FPGA for space missions requires
   the use of a redundancy algorithm to improve the reliability so that the
   system operates even under the effects of radiation. The Triple Modular
   Redundancy (TMR) technique is considered a reference solution, and its
   feasibility study was carried out as a redundancy algorithm. This way,
   the TMR is used not requiring the addition of new hardware in the
   system. The analysis of its behavior, mainly in terms of efficiency in a
   space system that uses FPGA, was performed and compared against the same
   reference system without the use of this technique. This article shows
   results numerically to prove the reliability improvement of the system
   using validated reference circuits subjected to failures emulating the
   radiation effect, in the form of SEU behavior.},
Type = {Proceedings Paper},
Affiliation = {Balbino, F (Corresponding Author), Technol Inst Aeronaut ITA, Sao Jose Dos Campos, SP, Brazil.
