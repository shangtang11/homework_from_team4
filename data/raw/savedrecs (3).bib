@inproceedings{ WOS:001680177600024,
Author = {Sharmin, Sadia and Kim, Yohan},
Editor = {ACM},
Title = {Lessons in Innovations, Interventions, and Kindness from the Global
   Pandemic: A Review of CS Education During COVID-19},
Booktitle = {PROCEEDINGS OF 25TH INTERNATIONAL CONFERENCE ON COMPUTING EDUCATION
   RESEARCH, KOLI CALLING 2025},
Year = {2025},
Note = {25th Koli Calling International Conference on Computing Education
   Research-Koli Calling, FINLAND, NOV 11-16, 2025},
Abstract = {The COVID-19 pandemic prompted an unprecedented and urgent overhaul of
   many sectors of society, including education. Computer Science (CS)
   education faced unique challenges such as catering to students with
   varied levels of prior knowledge, effectively teaching cumulative
   content, providing access to course-relevant hardware tools in a remote
   context, and more. Beyond the focus on new tools and technologies, the
   widespread uncertainty and global trauma also brought about a need for
   increased empathy, flexibility and care within education (aspects of a
   pedagogy of kindness). Now that much of the world has returned to
   ``normal{''}, which pedagogical strategies and insights that emerged
   during the pandemic are worth sustaining in post-pandemic CS education?
   To explore this, we conducted a narrative review with thematic analysis
   of 62 papers published in major CS education conferences between 2021
   and 2023 that described teaching practices during the pandemic. Our
   analysis identified nine major pedagogical focuses emphasized across
   these papers: generating online content and videos, rethinking
   assessments, overall course structures, remote collaborative work,
   online discussion tools, extra-curricular/co-curricular programs,
   inclusivity/diversity, metacognitive skills and online learning tools
   and platforms.
   Several papers described pedagogical interventions and 28 of 38
   intervention-based studies reported significant positive effects on
   various aspects of student experiences. The papers without interventions
   (n=24) still analyzed student behaviour and experiences, offering
   crucial insights into student needs and challenges. Lastly, the majority
   of papers (n=44) embodied principles of a pedagogy of kindness, such as
   compassion, community-building and co-construction (giving students
   agency over course design). Even if we are no longer facing a pandemic,
   many students will continue to face significant personal, structural,
   and academic challenges that may impact their learning. As such, the
   insights and practices that emerged during this crisis can inform more
   inclusive, sustainable, and student-centered approaches for CS education
   moving forward. This review highlights lessons from a disruptive - yet
   extensively experimental - time, exploring pedagogical strategies worth
   retaining and re-imagining for more equitable CS education.},
Type = {Proceedings Paper},
Affiliation = {Sharmin, S (Corresponding Author), Univ Toronto, Toronto, ON, Canada.
   Sharmin, Sadia; Kim, Yohan, Univ Toronto, Toronto, ON, Canada.},
DOI = {10.1145/3769994.3770006},
Article-Number = {24},
Keywords = {pandemic; student-centered teaching; wellness; pedagogy of kindness;
   narrative review},
