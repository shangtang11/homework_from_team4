@article{ WOS:001594984100048,
Author = {Chen, Hongtai and Yang, Mei and Li, Shunli and Zhao, Hongxin and Yin,
   Xiaoxing},
Title = {Fast Time-Domain Synthesis of Full Radiation Characteristics of 3-D
   Curved Wire Antennas Based on Lienard-Wiechert Potential},
Journal = {IEEE TRANSACTIONS ON ANTENNAS AND PROPAGATION},
Year = {2025},
Volume = {73},
Number = {10},
Pages = {7244-7259},
Month = {OCT},
Abstract = {This article presents a novel fast time-domain synthesis approach of 3-D
   curved thin-wire antennas, to achieve desired full radiation
   characteristic. The thin antenna is modeled as a series of connected,
   electrically short segments, allowing for flexible designs of arbitrary
   shapes. Using Lienard-Wiechert potentials, the radiation fields of these
   segments are efficiently computed, facilitating both rapid analysis and
   synthesis. A comprehensive signal space analysis is introduced to
   account for amplitude variation and waveform distortion, ensuring
   mathematical rigor and geometric clarity. The proposed approach is
   validated with the design and implementation of a wideband
   unidirectional circularly polarized antenna. The antenna achieves an
   impedance bandwidth of 121.9\%, a 3-dB axial ratio (AR) bandwidth of
   121.1\%, and a maximal realized gain of 12.5 dBic. In the time domain,
   it delivers a fidelity of 0.977, demonstrating its suitability for
   short-pulse (SP) applications. The approach also supports multiobjective
   optimization, enabling customized designs that balance amplitude,
   waveform, and polarization. This synthesis approach offers a versatile
