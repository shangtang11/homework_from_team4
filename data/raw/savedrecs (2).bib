@article{ WOS:001385382400029,
Author = {Huang, Keyu and Li, Chunbiao and Zhang, Xin and Moroz, Irene and Liu,
   Zuohua},
Title = {Constructing a Memristive Chaotic Oscillator With 2-D Offset Boosting},
Journal = {IEEE TRANSACTIONS ON COMPUTER-AIDED DESIGN OF INTEGRATED CIRCUITS AND
   SYSTEMS},
Year = {2025},
Volume = {44},
Number = {1},
Pages = {294-303},
Month = {JAN},
Abstract = {By designing a proper electromagnetic constraint within a memristor, and
   introducing it into a dynamical system with the increase of dimension, a
   class of memristive chaotic systems with 2-D offset boosters is
   constructed. One offset constant directly applies offset boosting of a
   system variable while the other modifies the offset of two variables
   simultaneously. Furthermore, when the derived structure satisfies a
   specific feedback balance law, the property of total amplitude control
   can be obtained. The circuit implementation is consequently realized and
   the results are in line with the theoretical analysis.},
