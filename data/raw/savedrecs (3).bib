@inproceedings{ WOS:001665533400075,
Author = {Pal, Kuldeep and Garade, Aniket P. and Deepika, V, H. and Haribabu, P.
   and Kumar, S. A. and Sudarsan, S. D.},
Book-Group-Author = {ACM},
Title = {Optimizing NumPy with SVE Acceleration on ARM Architectures},
Booktitle = {54TH INTERNATIONAL CONFERENCE ON PARALLEL PROCESSING, ICPP 2025, MAIN
   CONFERENCE PROCEEDINGS},
Year = {2025},
Pages = {774-783},
Note = {54th International Conference on Parallel Processing-ICPP-Annual, San
   Diego, CA, SEP 08-11, 2025},
Abstract = {NumPy, a cornerstone of Python's scientific ecosystem, often encounters
   performance bottlenecks on cutting-edge ARM-based High-Performance
   Computing (HPC) architectures. This paper presents a comprehensive
   optimization strategy for NumPy, meticulously designed for enhancing
   performance across modern ARM HPC architectures, by exploiting the full
   potential of ARM Scalable Vector Extensions (SVE). Our research details
   the design and implementation of hand-tuned SVE kernels for critical
   NumPy functions, integrated with a runtime SIMD dispatch mechanism and
   techniques for efficient vector memory access. Extensive performance
   evaluation on the A64FX demonstrates significant speedups across the
   board: basic arithmetic operations (addition, subtraction,
   multiplication) achieve up to 1300x acceleration compared to the
   standard NumPy build relying on compiler auto-vectorization or scalar
   fallbacks, vector-vector dot products reach 150x, matrixvector dot
   products improve by 14x, while Blocked and Batched GEMM variants see
   gains up to 44x and Strassen GEMM up to 20x. These substantial gains
   stem from carefully crafted SVE kernels, leveraging SVE's efficient
   vector instructions and memory access patterns, and the runtime dispatch
   mechanism. Our approach sets a new precedent for efficient and scalable
   scientific computing using NumPy on next-generation ARM-based HPC
   systems, making it a viable alternative to proprietary libraries.},
Type = {Proceedings Paper},
Affiliation = {Pal, K (Corresponding Author), CDAC, Bengaluru, India.
   Pal, Kuldeep; Garade, Aniket P.; Deepika, H., V; Haribabu, P.; Kumar, S. A.; Sudarsan, S. D., CDAC, Bengaluru, India.},
