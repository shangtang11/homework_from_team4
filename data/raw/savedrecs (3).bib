@inproceedings{ WOS:001420111900017,
Author = {Sato, Shigeyuki and Mizuhashi, Taiyo and Kimura, Genki and Taura,
   Kenjiro},
Editor = {Kiselyov, O},
Title = {Efficiently Adapting Stateless Model Checking for C11/C++11 to
   Mixed-Size Accesses},
Booktitle = {PROGRAMMING LANGUAGES AND SYSTEMS, APLAS 2024},
Series = {Lecture Notes in Computer Science},
Year = {2025},
Volume = {15194},
Pages = {346-364},
Note = {22nd Asian Symposium on Programming Languages and Systems, Kyoto, JAPAN,
   OCT 22-24, 2024},
Abstract = {Stateless model checking (SMC) is crucial for productivity in verified
   concurrent programming, and its recent developments for C/C++ and weak
   memory models are remarkable. The state-of-the-art SMC for C, GenMC,
   efficiently verifies C programs based on C11 atomics and pthreads.
   However, it does not support mixed-size accesses, accesses to the same
   memory region with different-sized types, even though they are
   ubiquitous in C/C++, particularly the code for memory management. As a
   result, GenMC does not work for C/C++ programs containing memory
   management. To resolve this problem, we develop a method of adapting
   GenMC to mixed-size accesses preserving its optimality. We
   experimentally evaluate the efficiency of our extended implementation of
   GenMC and its efficacy for memory management programs.},
Type = {Proceedings Paper},
Affiliation = {Sato, S (Corresponding Author), Univ Electrocommun, Tokyo, Japan.
   Sato, Shigeyuki, Univ Electrocommun, Tokyo, Japan.
   Mizuhashi, Taiyo; Kimura, Genki; Taura, Kenjiro, Univ Tokyo, Tokyo, Japan.},
DOI = {10.1007/978-981-97-8943-6\_17},
Keywords = {Stateless model checking; C11/C++11; Mixed-size accesses},
Author-Email = {sato.shigeyuki@uec.ac.jp},
