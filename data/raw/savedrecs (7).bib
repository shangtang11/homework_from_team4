@inproceedings{ WOS:001062143200085,
Author = {Tsantikidou, Kyriaki and Boufeas, Dimitrios and Sklavos, Nicolas},
Book-Group-Author = {IEEE},
Title = {Area-Delay Efficient Security Scheme for Smart Hospital Systems},
Booktitle = {2023 IEEE INTERNATIONAL CONFERENCE ON CYBER SECURITY AND RESILIENCE, CSR},
Year = {2023},
Pages = {552-557},
Note = {IEEE International Conference on Cyber Security and Resilience (CSR),
   Venice, ITALY, JUL 31-AUG 02, 2023},
Abstract = {In recent years, traditional Hospital facilities are adopting new
   technologies. Smart Hospitals mostly utilize the Internet of Things
   (IoT) technology due to its vast capabilities in connectivity. This IoT
   network requires specific protocols for proper functionality. Message
   Queuing Telemetry Transport (MQTT) protocol is suitable for managing the
   communication and routing procedures of the resource constrained IoT
   environment. Nevertheless, both MQTT and IoT have various
   vulnerabilities and threats that must first be addressed. In this paper,
   a lightweight key management procedure is analyzed, an end-to-end
   payload encryption method is followed, and a processor with different
   cryptographic mechanisms is implemented. This combination of processes
   best complements the E-Health-based Hospital architecture, requiring
   minimum resources and complete security. The proposed crypto processor
   efficiently implements three different cryptographic primitives in a
   RISC-V architecture, providing flexibility. It achieves the best
   area-delay compared to other hardware-based security schemes, with
   61.3\% resource reduction and minimum added computation overhead. This
   is accomplished due to proper formatting of specific instructions and a
   function, operation and register sharing methodology.},
