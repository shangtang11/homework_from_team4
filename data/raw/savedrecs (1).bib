EarlyAccessDate = {JUN 2025},
Keywords = {Voltage; Transmitters; Steady-state; Circuits; Power demand; Optical
   signal processing; Capacitors; Threshold voltage; Signal to noise ratio;
   Non-return to zero (NRZ); four-level pulse amplitude modulation (PAM-4);
   adiabatic circuits; charge sharing; capacitive load; switching power;
   low-power; energy efficiency; energy efficiency},
