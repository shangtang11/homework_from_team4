@inproceedings{ WOS:001046484100185,
Author = {Kobayashi, Nobuhiro},
Editor = {Shahriar, H and Teranishi, Y and Cuzzocrea, A and Sharmin, M and Towey, D and Majumder, AKMJA and Kashiwazaki, H and Yang, JJ and Takemoto, M and Sakib, N and Banno, R and Ahamed, SI},
Title = {Zero Trust Security Framework for IoT Actuators},
Booktitle = {2023 IEEE 47TH ANNUAL COMPUTERS, SOFTWARE, AND APPLICATIONS CONFERENCE,
   COMPSAC},
