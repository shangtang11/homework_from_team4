@article{ WOS:001222007800010,
Author = {Rabinovich, Daniil and Campos, Ernesto and Adhikary, Soumik and
   Pankovets, Ekaterina and Vinichenko, Dmitry and Biamonte, Jacob},
Title = {Robustness of variational quantum algorithms against stochastic
   parameter perturbation},
Journal = {PHYSICAL REVIEW A},
Year = {2024},
Volume = {109},
Number = {4},
Month = {APR 29},
Abstract = {Variational quantum algorithms are tailored to perform within the
   constraints of current quantum devices, yet they are limited by
   performance-degrading errors. In this study we consider a noise model
   that reflects realistic gate errors inherent to variational quantum
   algorithms. We investigate the decoherence of a variationally prepared
   quantum state due to this noise model, which causes a deviation from the
   energy estimation in the variational approach. By performing a
   perturbative analysis of optimized circuits, we determine the noise
   threshold at which the criterion set by the stability lemma is met. We
   assess our findings against the variational quantum eigensolver and
   quantum approximate optimization algorithm for various problems with up
   to 14 qubits. Moreover, we show that certain gate errors have a
   significantly smaller impact on the coherence of the state, allowing us
   to reduce the execution time without compromising performance.},
