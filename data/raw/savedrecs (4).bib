@inproceedings{ WOS:001444043400012,
Author = {Ali, Muhammad and Aliagha, Ensieh and Elnashar, Mahmoud and Goehringer,
   Diana},
Editor = {Nurmi, J and Rodrigues, J and Pezzarossa, L and Aberg, V and Behmanesh, B},
Title = {RV-ProViler: Evaluating RISC-V ISA for Application-Specific Requirements},
Booktitle = {2024 IEEE NORDIC CIRCUITS AND SYSTEMS CONFERENCE, NORCAS},
Year = {2024},
Note = {10th Nordic Circuits and Systems Conference, Lund, SWEDEN, OCT 29-30,
   2024},
Abstract = {RISC-V instruction set architecture (ISA) is gaining momentum as an
   open-source ISA that allows the implementation of a wide range of
   processor designs. These processor designs can tackle diverse
   application scenarios, from embedded processing to high-performance
   computing. RISC-V ISA has a modular architecture, with different base
   ISAs and optional standard extensions to choose from. RISC-V ISA in
   itself is quite diverse and requires a platform to profile the
   application to estimate which extensions and ISA configurations fit best
   for a particular application. RISC-V also provides an open-source
   toolchain and a Spike simulator that can be used to simulate an
   application. In this work, an open-source profiling tool is presented
   for evaluating RISC-VISA specification for an application called
   RV-ProViler. The profiling tool uses bash and Python scripts to couple
   the RISC-V toolchain and the Spike simulator to generate a histogram
   that details the instruction coverage of an application or a function
   for a particular RISC-V extension. To demonstrate the usability of the
   tool, different functions are used as a test case; matrix
   multiplication, convolution, max-pooling, and fully connected functions,
   to benchmark the P- (packed-SIMD) and the V-extension (vector
   instructions) of RISC-V. A Lenet-5 algorithm is also used as a test case
   to show a comparison between base ISA (RV32IM), P-extension (RV32IMP),
   and V-extension (RV32IMV). The results show a maximum speed-up of 5.87x
   when using P-extension and 16.52x when using V-extension for matrix
   multiplication. For Lenet-5 a speed-up of 4.09x when using P-extension
   and 9.58x when using V-extension was observed.},
Type = {Proceedings Paper},
Affiliation = {Ali, M (Corresponding Author), Tech Univ Dresden, Chair Adapt Dynam Syst, Dresden, Germany.
   Ali, Muhammad; Aliagha, Ensieh; Elnashar, Mahmoud; Goehringer, Diana, Tech Univ Dresden, Chair Adapt Dynam Syst, Dresden, Germany.},
DOI = {10.1109/NorCAS64408.2024.10752449},
Keywords = {RISC-V; Instruction Set Architecture (ISA); Profiling; Simulator;
   Machine Learning; Deep Learning},
