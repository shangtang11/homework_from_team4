Title = {ParallelNTT: Maximizing Performance of Forward and Inverse NTT on FPGA
   for ML-DSA and ML-KEM},
Booktitle = {PROCEEDINGS OF THE GREAT LAKES SYMPOSIUM ON VLSI 2025, GLSVLSI 2025},
Year = {2025},
Pages = {372-378},
Note = {35th Great Lakes Symposium on VLSI-GLSVLSI, New Orleans, LA, JUN 30-JUL
   02, 2025},
Abstract = {The rise of quantum computing threatens traditional cryptography,
   driving the need for post-quantum cryptography (PQC) algorithms like
   ML-KEM and ML-DSA. These Module-Lattice-Based Cryptography (MLBC)
   schemes rely on efficient polynomial multiplication, accelerated by the
   Number Theoretic Transform (NTT) from O(n(2)) to O(n log(2)n)
   complexity. This paper introduces ParallelNTT, an FPGA-based
   architecture optimizing forward and inverse NTT for ML-DSA and ML-KEM.
   By employing a fully parallelized design that eliminates RAM
   bottlenecks-feeding all coefficients to NTT stages
   simultaneously-ParallelNTT achieves a groundbreaking O( log(2)n)
   latency. Key innovations include taking advantage of the constant
   geometric structure for simplified routing, K-2-RED modular reduction
   for efficient arithmetics, and accessing twiddle factor storage shared
   across forward and inverse NTT, reducing area and boosting speed.
   Implemented on Xilinx Virtex UltraScale+ and Artix-7 FPGAs, it achieves
   frequencies up to 400 MHz and latencies as low as 0.015 mu s for ML-KEM
   and 0.017 mu ss for ML-DSA, demonstrating up to 24x improvement in
   latency over prior FPGAbased implementations while optimizing resource
   utilization. This scalable, very high-performance solution enhances the
   deployment of MLBC schemes in high-throughput environments, offering a
   robust foundation for future PQC systems.},
Type = {Proceedings Paper},
