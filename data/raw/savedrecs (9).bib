@article{ WOS:000587712700042,
Author = {Gonzalez, Yilian Ribot and Nelissen, Geoffrey},
Title = {HopliteRT{*}: Real-Time NoC for FPGA},
Journal = {IEEE TRANSACTIONS ON COMPUTER-AIDED DESIGN OF INTEGRATED CIRCUITS AND
   SYSTEMS},
Year = {2020},
Volume = {39},
Number = {11},
Pages = {3650-3661},
Month = {NOV},
Abstract = {With the increasing number of computation nodes integrated in multi and
   many-core platforms, network-on-chips (NoCs) emerged as a new
   communication medium in systems-on-chips (SoCs). HopliteRT is a new NoC
   design that was recently proposed to address the needs of real-time
   systems whilst respecting the constraints of field-programmable gate
   array (FPGA) platforms. In this article, we: 1) introduce priority-based
   routing in HopliteRT; 2) change the network topology in order to improve
   the packets' worst-case traversal time (WCTT); 3) identify a flaw in the
   existing timing analysis of HopliteRT; and 4) develop a new timing
   analysis that is proven correct. We also show by means of experiments
   that the modifications of HopliteRT proposed in this article allows for
   at least 2x improvement on the worst and average case traversal time of
   high priority packets, without impacting the quality of service of
   low-priority packets. The timing properties of high priority flows are
   greatly improved for negligible additional hardware costs. The proposed
   NoC has been implemented in Verilog and synthesized for a Xilinx
   Virtex-7 FPGA platform.},
Type = {Article},
Affiliation = {González, YR (Corresponding Author), Polytech Inst Porto, ISEP, CISTER Res Ctr, P-4200465 Porto, Portugal.
   Gonzalez, Yilian Ribot, Polytech Inst Porto, ISEP, CISTER Res Ctr, P-4200465 Porto, Portugal.
   Nelissen, Geoffrey, Eindhoven Univ Technol, Dept Math \& Comp Sci, NL-5612 AZ Eindhoven, Netherlands.},
DOI = {10.1109/TCAD.2020.3012748},
Keywords = {Field programmable gate array; network-onchips; real-time embedded
   systems; systems-on-chips; timing analysis},
Author-Email = {ribot@isep.ipp.pt},
Affiliations = {Instituto Politecnico do Porto; Eindhoven University of Technology},
