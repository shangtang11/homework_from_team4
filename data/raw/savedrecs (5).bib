@inproceedings{ WOS:001253778900316,
Author = {Guan, Zhenyu and Zhu, Yongqing and Huang, Yicheng and Lei, Luchang and
   Wang, Xueyan and Jia, Hongyang and Chen, Yi and Zhang, Bo and Dong, Jin
   and Bian, Song},
Book-Group-Author = {IEEE},
Title = {ESC-NTT: An Elastic, Seamless and Compact Architecture for
   Multi-Parameter NTT Acceleration},
Booktitle = {2024 DESIGN, AUTOMATION \& TEST IN EUROPE CONFERENCE \& EXHIBITION, DATE},
Series = {Design Automation and Test in Europe Conference and Exhibition},
Year = {2024},
Note = {27th Design, Automation and Test in Europe Conference and Exhibition
   (DATE), Valencia, SPAIN, MAR 25-27, 2024},
Abstract = {Fully homomorphic encryption (FHE) and post-quantum cryptography (PQC)
   heavily rely on number theoretic transform (NTT) to accelerate
   polynomial multiplication. However, most existing NTT accelerators lack
   flexibility when the underlying modulus and polynomial lengths change.
   Current designs often store twiddle factors in on-chip storage, facing a
   noticeable drawback when frequent parameter changes occur, leading to a
   potential 50\% decrease in computation speed due to the input bandwidth
   limitations. To address this challenge, we propose ESC-NTT, a
   fully-pipelined and flexible architecture for handling NTTs with varying
   parameters. ESC-NTT, a complete custom architecture, continuously
   performs N-point (inverse) NTT, negacyclic NTT (NCN), and inverse NCN
   (INCN) without introducing bubbles during modulus and NTT length
   switches. Additionally, we introduce a twiddle factor generator (TFG)
   module to replace on-chip factor storage and save 68.7\% twiddle
   factors' bandwidth compared to inputting every factor. In the
   experiment, ESC-NTT is implemented on a Xilinx Alveo U280 FPGA and
   synthesized in a 28nm CMOS technology. In the case of frequent modulus
   switching and same on-chip storage, the calculation speed of ESC-NTT is
   1.05x to 241.39x that of existing FHE accelerators when performing
   4096-point NTT.},
Type = {Proceedings Paper},
Affiliation = {Bian, S (Corresponding Author), Beihang Univ, Sch Cyber Sci \& Technol, Beijing, Peoples R China.
