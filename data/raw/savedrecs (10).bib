@inproceedings{ WOS:000470666100212,
Author = {Auer, Lukas and Skubich, Christian and Hiller, Matthias},
Book-Group-Author = {IEEE},
Title = {A Security Architecture for RISC-V based IoT Devices},
Booktitle = {2019 DESIGN, AUTOMATION \& TEST IN EUROPE CONFERENCE \& EXHIBITION
   (DATE)},
Series = {Design Automation and Test in Europe Conference and Exhibition},
Year = {2019},
Pages = {1154-1159},
Note = {22nd Design, Automation and Test in Europe Conference and Exhibition
   (DATE), Florence, ITALY, MAR 25-29, 2019},
Abstract = {New IoT applications are demanding for more and more performance in
   embedded devices while their deployment and operation poses strict power
   constraints. We present the security concept for a customizable Internet
   of Things (IoT) platform based on the RISC-V ISA and developed by
   several Fraunhofer Institutes. It integrates a range of peripherals with
   a scalable computing subsystem as a three dimensional System-in-Package
   (3D-SiP).
   The security features aim for a medium security level and target the
   requirements of the IoT market. Our security architecture extends given
   implementations to enable secure deployment, operation, and update. Core
   security features are secure boot, an authenticated watchdog timer, and
   key management.
   The Universal Sensor Platform (USeP) SoC is developed for
   GLOBALFOUNDRIES' 22FDX technology and aims to provide a platform for
   Small and Medium-sized Enterprises (SMEs) that typically do not have
   access to advanced microelectronics and integration know-how, and are
   therefore limited to Commercial Off-The-Shelf (COTS) products.},
Type = {Proceedings Paper},
Affiliation = {Auer, L (Corresponding Author), Fraunhofer Inst Appl \& Integrated Secur AISEC, Garching, Germany.
   Auer, Lukas; Hiller, Matthias, Fraunhofer Inst Appl \& Integrated Secur AISEC, Garching, Germany.
   Skubich, Christian, Fraunhofer Inst Integrated Circuits IIS, Div Engn Adapt Syst EAS, Dresden, Germany.},
