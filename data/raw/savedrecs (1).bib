@article{ WOS:001527357300001,
Author = {Xia, Zihan and Kang, Mingu},
Title = {DmNE: A Dual-Mode Neural Engine for Multiplicative and
   Multiplication-Free Kernels With Fine-Grained Precision Scaling and
   Processing Elementwise Power Gating},
Journal = {IEEE JOURNAL OF SOLID-STATE CIRCUITS},
Year = {2026},
Volume = {61},
Number = {3},
Pages = {1254-1267},
Month = {MAR},
Abstract = {Artificial intelligence (AI) hardware implementations require efficient
   model processing and the flexibility to adapt to varying accuracy and
   latency requirements, as well as energy budgets, given the target use
   cases. Existing AI hardware typically relies on bit precision or data
   sparsity to balance efficiency and accuracy. Alternatively, the
   multiplication-free L1 kernel, which measures the L1 distance between
   inputs and weights, has recently been proposed as a replacement for the
   traditional, energy-intensive multiplicative dot-product (DP) kernel.
   This L1 kernel achieves significant energy and delay advantages while
   maintaining comparable classification performance across various
   applications. Therefore, selectively applying the L1 kernel serves as an
   additional parameter to optimize trade-offs among accuracy, latency, and
   energy. To exploit such an opportunity, we present, for the first time,
   a silicon-proven dual-mode sparsity/precision-scalable processor, dubbed
   DmNE, that features the following: 1) a dual-mode reconfigurable
   architecture (DmRA) optimized for processing both conventional neural
   networks (NNs) with DP kernels and emerging NNs with L1 kernels; 2)
   processing elementwise power gating (PEPG) that fully utilizes the
   unstructured data sparsity, which comes from unique data statistics in
   L1 kernel processing, while maintaining a structured computing array;
   and 3) dual-mode bit-serial (DmBS) processing that enables 2-8-b
   flexible precision scaling and high resource utilization across both
   modes. Measurement results show that the proposed DmNE, fabricated in 65
   nm CMOS technology, achieves up to 2.2x energy efficiency improvement
   with PEPG as data sparsity increases from 0\% to 90\%, up to 8.8x energy
   efficiency gain with DmBS when bit precision scales from 8-b to 2-b, and
   up to 9.1x energy-delay product (EDP) boost on real-world NN benchmarks
   with DmRA by switching from DP to L1 mode. The test chip achieves
   0.36/1.0TOPS peak performance and 7.2/13.0 TOPS/W peak energy efficiency
   at 4-b data precision in DP/L1 mode, respectively.},
Type = {Article},
Affiliation = {Kang, MG (Corresponding Author), Univ Calif San Diego, Dept Elect \& Comp Engn, La Jolla, CA 92093 USA.
   Xia, Zihan; Kang, Mingu, Univ Calif San Diego, Dept Elect \& Comp Engn, La Jolla, CA 92093 USA.},
DOI = {10.1109/JSSC.2025.3583287},
EarlyAccessDate = {JUL 2025},
Keywords = {Kernel; Artificial neural networks; Accuracy; Hardware; Artificial
   intelligence; Engines; Energy efficiency; Silicon; Integrated circuit
   modeling; Energy consumption; Multiplication-free kernels; neural
   networks (NNs); power gating; precision scaling; reconfigurable
   accelerator; sparsity},
