@inproceedings{ WOS:001283819600020,
Author = {Li, Qiufeng and Huang, Hantao and Shen, Ao and Li, Kai and Huang, Sixiao
   and Yu, Hao},
Book-Group-Author = {IEEE},
Title = {A Mixed-precision DNN Compiler for Robotic Computing on FPGA},
Booktitle = {2023 3RD INTERNATIONAL CONFERENCE ON ROBOTICS, AUTOMATION AND ARTIFICIAL
   INTELLIGENCE, RAAI 2023},
Year = {2023},
Pages = {206-212},
Note = {3rd International Conference on Robotics, Automation and Artificial
   Intelligence (RAAI), Singapore, SINGAPORE, DEC 14-16, 2023},
Abstract = {Adopting deep learning models in robotic systems such as simultaneous
   localization and mapping (SLAM) attracts great interests from the
   community. The deployment of deep learning models on
   resource-constrained robotic edge system poses significant challenges
   due to their limited computational resources. Network architecture
   search(NAS)-based quantization is proven to achieve a great balance
   between network performance and hardware efficiency, which typically
   results in a mixed-precision network. Many mixed-precision accelerators
   have been developed as well to support computing mixed-precision
   networks manually. A software-hardware interface is thereby needed to
   automatically map mixed-precision networks onto mixed-precision
   accelerators. In this paper, we have developed a custom compiler
   framework for maximized speed-up through optimal mapping to the 2-8 bit
   acceleration, better scheduling on the core and minimum runtime
   overhead. Experiments show that, through our automated compilation
   approach, the mixed-precision models deployed on the ZCU102 FPGA
   achieves maximum throughput (524 GOPs for VGG16, 423GOPs for UndeepVo,
   705 GOPs OpenPose), meeting the real-time computing requirements for
   robotic DNNs.},
