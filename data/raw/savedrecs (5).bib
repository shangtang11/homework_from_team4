Title = {Special Session: In-Field ML-Assisted Intermittent Fault Localization
   and Management in RISC-V SoCs<bold> </bold>},
Booktitle = {2024 IEEE INTERNATIONAL SYMPOSIUM ON DEFECT AND FAULT TOLERANCE IN VLSI
   AND NANOTECHNOLOGY SYSTEMS, DFT},
