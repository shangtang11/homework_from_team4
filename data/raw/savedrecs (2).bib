@inproceedings{ WOS:001695149000010,
Author = {Maura, Divyansh and Akella, Venkatesh},
Book-Group-Author = {ACM},
Title = {Precision Aware Bank Separated Data Placement},
Booktitle = {PROCEEDINGS OF THE INTERNATIONAL SYMPOSIUM ON MEMORY SYSTEMS, MEMSYS
   2025},
Year = {2025},
Pages = {94-98},
Note = {2025 International Symposium on Memory Systems-MEMSYS, WA, OCT 07-08,
   2025},
Abstract = {Mixed-precision computing, which uses data with different bitwidths, is
   a promising way to improve the performance and energy efficiency of
   High-Performance Computing (HPC) workloads. While decreasing the
   precision of data representation saves storage, the benefits in other
   critical DRAM performance metrics, such as data movement, power
   consumption, and row buffer locality, do not always scale
   proportionally. This discrepancy is due to architectural constraints in
   DRAM subsystems, where fixed access granularities and bank contention
   limit the benefits of precision reduction. To address this, a DRAM
   optimization technique is proposed: precision-aware bank-separated data
   placement. This method involves dedicating specific DRAM banks to store
   data of a particular precision, which can improve data locality and
   reduce row buffer issues, leading to better performance and energy
   efficiency. Preliminary results suggest that this approach improves
   row-buffer hits by an average of 24\%, reduces DRAM activation energy by
   12\%, and reduces the variability in DRAM access latency. Sensitivity
   studies on DDR4, LPDDR, and HBM show that internal DRAM
   microarchitectural characteristics influence the efficacy of the
   approach.},
Type = {Proceedings Paper},
Affiliation = {Maura, D (Corresponding Author), Univ Calif Davis, Dept Elect \& Comp Engn, Davis, CA 95616 USA.
   Maura, Divyansh; Akella, Venkatesh, Univ Calif Davis, Dept Elect \& Comp Engn, Davis, CA 95616 USA.},
