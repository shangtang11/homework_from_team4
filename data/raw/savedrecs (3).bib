@inproceedings{ WOS:001601467200029,
Author = {Tri-Duc Ta and Quoc-Thinh Tran and Cong-Kha Pham and Duc-Hung Le},
Book-Group-Author = {IEEE},
Title = {Implementation of a Compact and ResourceEfficient 32-bit Microcontroller
   Based on RISC-V Steel on FPGA and ASIC},
Booktitle = {2025 IEEE REGION 10 SYMPOSIUM, TENSYMP},
Series = {IEEE Region 10 Symposium},
Year = {2025},
Note = {2025 Region 10 Symposium-TENSYMP-Annual, Christchurch, NEW ZEALAND, JUL
   07-09, 2025},
Abstract = {This paper presents the implementation and verification process of a
   32-bit microcontroller using the opensource RISC-V Steel 32-bit
   processor on the FPGA DE2 development kit and ASIC implementation on
   45nm CMOS technology. The main goal is to design a complete 32-bit
   microcontroller that functions effectively with its designated features.
   This design is distinguished by the integration of a program loading
   controller that directly transfers instructions to RAM via the SPI
   interface without the involvement of the CPU and system data bus. This
   approach reduces boot time and alleviates CPU workload, enhancing
   overall system efficiency. The RISC-V Steel processor utilizes the RV32I
   instruction set architecture, complemented by 4KB of RAM, a 1KB stack,
   and basic interfaces such as UART, SPI, GPIO, and a Timer. With a total
   power consumption of 13.52 mW at 100 MHz and an area of 380,339 mu m(2),
   the proposed design presents an energyefficient, low-power, and compact
   solution suitable for modern embedded systems and IoT applications.},
Type = {Proceedings Paper},
Affiliation = {Le, DH (Corresponding Author), Vietnam Natl Univ Ho Chi Minh City, Univ Sci, Fac Elect \& Telecommun, Ho Chi Minh City, Vietnam.
