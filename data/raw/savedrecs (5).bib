@inproceedings{ WOS:001253778900356,
Author = {Parisi, Emanuele and Musa, Alberto and Manoni, Simone and Ciani, Maicol
   and Rossi, Davide and Barchi, Francesco and Bartolini, Andrea and
   Acquaviva, Andrea},
Book-Group-Author = {IEEE},
Title = {TitanCFI: Toward Enforcing Control-Flow Integrity in the Root-of-Trust},
Booktitle = {2024 DESIGN, AUTOMATION \& TEST IN EUROPE CONFERENCE \& EXHIBITION, DATE},
Series = {Design Automation and Test in Europe Conference and Exhibition},
Year = {2024},
Note = {27th Design, Automation and Test in Europe Conference and Exhibition
   (DATE), Valencia, SPAIN, MAR 25-27, 2024},
Abstract = {Modern RISC-V platforms control and monitor security-critical systems
   such as industrial controllers and autonomous vehicles. While these
   platforms feature a Root-of-Trust (RoT) to store authentication secrets
   and enable secure boot technologies, they often lack Control-Flow
   Integrity (CFI) enforcement and are vulnerable to cyber-attacks which
   divert the control flow of an application to trigger malicious
   behaviours. Recent techniques to enforce CFI in RISC-V systems include
   ISA modifications or custom hardware IPs, all requiring ad-hoc binary
   toolchains or design of CFI primitives in hardware. This paper proposes
   TitanCFI, a novel approach to enforce CFI in the RoT. TitanCFI modifies
   the commit stage of the protected core to stream control flow
   instructions to the RoT and it integrates the CFI enforcement policy in
   the RoT firmware. Our approach enables maximum reuse of the hardware
   resource present in the System-on-Chip (SoC), and it avoids the design
   of custom IPs and the modification of the compilation toolchain, while
   exploiting the RoT tamper-proof storage and cryptographic accelerators
   to secure CFI metadata. We implemented the proposed architecture on a
   modern RISC-V SoC along with a return address protection policy in the
   RoT, and benchmarked area and runtime overhead. Experimental results
   show that TitanCFI achieves overhead comparable to SoA hardware CFI
   solutions for most benchmarks, with lower area overhead, resulting in
   1\% of additional area occupation.},
Type = {Proceedings Paper},
Affiliation = {Parisi, E (Corresponding Author), Univ Bologna, Dept Elect Elect \& Informat Engn DEI, Bologna, Italy.
   Parisi, Emanuele; Musa, Alberto; Manoni, Simone; Ciani, Maicol; Rossi, Davide; Barchi, Francesco; Bartolini, Andrea; Acquaviva, Andrea, Univ Bologna, Dept Elect Elect \& Informat Engn DEI, Bologna, Italy.},
DOI = {10.23919/DATE58400.2024.10546873},
Keywords = {Control-Flow Integrity; OpenTitan; RISC-V},
Author-Email = {emanuele.parisi@unibo.it},
