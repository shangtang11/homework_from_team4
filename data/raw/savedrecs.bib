@article{ WOS:001603456700006,
Author = {An, Junyang and Wu, Lei and Hu, Zhiyan and Song, Xiaopan and Wang,
   Junzhuan and Yu, Linwei},
Title = {In-plane growth control of uniform SiGe nanowires for thin film
   electronics},
Journal = {APPLIED SURFACE SCIENCE},
Year = {2026},
Volume = {718},
Month = {FEB 15},
Abstract = {The planar catalytic growth of highly ordered silicon nanowires (SiNWs)
   via an in-plane solid-liquid--solid (IPSLS) mechanism represents a
   promising approach for the scalable fabrication of electronic and
   sensing devices over large areas. While alloying Si with Ge offers the
   potential for bandgap tuning and enhanced carrier mobility, the
   IPSLS-based synthesis of silicon-germanium nanowires (SiGeNWs) has
   remained relatively unexplored. In this work, we report the successful
   low-temperature (250 degrees C) growth of ultrathin Si(1-x)Ge(x)NWs
   using the IPSLS process, with varied composition from 0 to 75 at.\%.
   Interestingly, the Ge composition in the alloy NWs is atomically uniform
   and can be precisely controlled by the Ge content in amorphous SiGe
   (a-SiGe) precursor layer. The resulting SiGeNWs exhibit uniform
   diameters (similar to 35 nm) and can be organized into densely packed,
   well-aligned arrays, free of substrate-induced epitaxial strain as
   confirmed by Raman spectroscopy. All-low-temperature (<450 degrees C)
   field-effect transistors (FETs) fabricated using Si0.7Ge0.3NW channels
   demonstrate a improvement compared to baseline SiNW FETs, including an
   order-of-magnitude increase in on-current, increased hole mobility to 76
   cm(2)/V<middle dot>s, an on/off current ratio (I-on/I-off > 10(6)), and
   a subthreshold swing (SS = 135 mV/dec). These findings highlight the
   potential of IPSLS-grown SiGeNWs as ideal one-dimensional (1D) channels
   for future large-area thin-film and flexible electronics.},
Type = {Article},
Affiliation = {Wang, JZ; Yu, LW (Corresponding Author), Nanjing Univ, Sch Elect Sci \& Engn, Natl Lab Solid State Microstruct, Nanjing 210023, Peoples R China.
   An, Junyang; Wu, Lei; Hu, Zhiyan; Song, Xiaopan; Wang, Junzhuan; Yu, Linwei, Nanjing Univ, Sch Elect Sci \& Engn, Natl Lab Solid State Microstruct, Nanjing 210023, Peoples R China.},
