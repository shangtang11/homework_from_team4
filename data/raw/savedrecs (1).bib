@article{ WOS:001539016100006,
Author = {Zhang, Yuxia and Xu, Chao and Li, Baihao and Liu, Siyuan and Song,
   Yongxin},
Title = {Spatio-temporal dual-attention network enabled shape-independent
   hardness estimation with a vision-based tactile sensor},
Journal = {MEASUREMENT},
Year = {2025},
Volume = {256},
Number = {D},
Month = {DEC 1},
Abstract = {The perception of hardness using a vision-based tactile sensor (VBTS)
   for objects with complex shapes is crucial yet challenging. Recognizing
   that hardness is an intrinsic property independent of shape, this paper
   introduces a dual-attention network in space and time (DAST) for
   shape-independent hardness evaluation with a VBTS. The algorithm
   leverages the time- and space-dependent evolution of a portion of an
   object's contour to assess hardness. The performance of DAST was
   evaluated using two datasets, our dataset and the MIT public dataset,
   and was compared against the spatiotemporal network models (CLNet and
   SRVP). The results indicated that when employing local contour analysis,
   the root-mean-squared error (RMSE) and the mean absolute percentage
   error (MAPE) were minimized, while the coefficient of determination (R2)
   was maximized. Extensive experiments across various angles confirmed our
   DAST model's superiority and general applicability.},
Type = {Article},
Affiliation = {Liu, SY; Song, YX (Corresponding Author), 1 Lingshui Rd, Dalian, Liaoning, Peoples R China.
   Zhang, Yuxia; Xu, Chao; Li, Baihao; Liu, Siyuan; Song, Yongxin, Dalian Maritime Univ, Dept Marine Engn, Dalian 116026, Peoples R China.},
