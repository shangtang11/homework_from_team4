@inproceedings{ WOS:000889465700012,
Author = {Boeseler, Felix and Walter, Joerg and Perjikolaei, Behnam Razi},
Book-Group-Author = {IEEE},
Title = {A Comparison of Virtual Platform Simulation Solutions for Timing
   Prediction of Small RISC-V Based SoCs},
Booktitle = {PROCEEDINGS OF THE 2022 FORUM ON SPECIFICATION \& DESIGN LANGUAGES (FDL)},
Series = {International Forum on Design Languages},
Year = {2022},
Note = {Forum on Specification and Design Languages (FDL), Linz, AUSTRIA, SEP
   14-16, 2022},
Abstract = {In an electronic system level design flow, early timing predictions can
   be realized by employing virtual platform simulations in the transaction
   level abstraction. However, there is little research comparing virtual
   platform solutions for small RISC-V based System-on-a-Chip
   architectures. This paper tries to fill this gap with a qualitative and
   quantitative comparison focusing on timing prediction accuracy. Starting
   with a total list of 25 RISC-V simulators, we found that only three
   candidates fulfill a comprehensive set of requirements for research
   applications. For these candidates we performed a quantitative
   comparison in which we model a single-master bus-based System-on-a-Chip
   at different abstraction levels and measure each simulator's timing
   prediction accuracy and simulation speed.},
Type = {Proceedings Paper},
Affiliation = {Böseler, F (Corresponding Author), Inst Informat Technol, OFFIS, Oldenburg, Germany.
