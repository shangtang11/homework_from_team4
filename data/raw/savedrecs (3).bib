@article{ WOS:001367635100001,
Author = {Fu, Weimin and Li, Shijie and Zhao, Yifang and Yang, Kaichen and Zhang,
   Xuan and Jin, Yier and Guo, Xiaolong},
Title = {A Generalize Hardware Debugging Approach for Large Language Models
   Semi-Synthetic, Datasets},
