   Kwon, Donghyun, Pusan Natl Univ, Sch Comp Sci \& Engn, 63beon Gil 2, Busan 46241, South Korea.},
DOI = {10.1016/j.cose.2025.104812},
EarlyAccessDate = {JAN 2026},
