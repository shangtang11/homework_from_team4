@article{ WOS:001175065000009,
Author = {Schindler, Lieze and Ayala, Christopher L. and Takeuchi, Naoki and
   Yoshikawa, Nobuyuki},
Title = {The Effect of Quantised Flux on AQFP Circuits for a
   Double-Active-Layered Niobium Fabrication Process},
Journal = {IEEE TRANSACTIONS ON APPLIED SUPERCONDUCTIVITY},
Year = {2024},
Volume = {34},
Number = {3},
Month = {MAY},
Abstract = {Adiabatic quantum-flux-parametron (AQFP) is an ac-biased logic family
   noted for its extremely low switching energy of around 1.4 zJ per
   Josephson junction (JJ) at a clock frequency of 5 GHz. Therefore, the
   AQFP logic family provides a high-speed, ultra-low-energy alternative to
   CMOS technology. However, quantised flux, such as vortices, trapped in
   the superconductor film can adversely affect circuit operation. A
   conventional solution to vortices is the introduction of low potential
   holes, also known as moats, within the film. Although basic guidelines
   have been introduced from published circuits, there is currently no
   standard method for designing and analysing moats for AQFP circuits. The
   double gate process (DGP) is a double-active-layered niobium fabrication
   process that allows for more compact circuits. But the effects of
   quantised flux for AQFP circuits on both active layers are currently
   unknown. We use 3D parameter extraction software tools to analyse the
   effect of various moat structures for AQFP logic cells for DGP and
   improve layout and moat placement designs.},
Type = {Article},
Affiliation = {Schindler, L (Corresponding Author), Yokohama Natl Univ, Inst Adv Sci, Yokohama 2408501, Japan.
   Schindler, Lieze; Ayala, Christopher L.; Takeuchi, Naoki; Yoshikawa, Nobuyuki, Yokohama Natl Univ, Inst Adv Sci, Yokohama 2408501, Japan.
   Yoshikawa, Nobuyuki, Yokohama Natl Univ, Dept Elect \& Comp Engn, Yokohama 2408501, Japan.},
DOI = {10.1109/TASC.2024.3354687},
Article-Number = {1100908},
Keywords = {Adiabatic quantum-flux-parametron (AQFP); adiabatic logic; flux
   trapping; magnetic flux; quantum flux parametron},
