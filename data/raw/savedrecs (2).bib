@inproceedings{ WOS:001661575100008,
Author = {Hsu, Min-Hsiu and Liao, Shih-wei and Wei, Chi-Hung and Kuan, Chi-Bang},
Book-Group-Author = {ACM},
Title = {Enhancing Superword-Level Parallelism on RISC-V through Custom
   Instruction Extensions},
Booktitle = {54TH INTERNATIONAL CONFERENCE ON PARALLEL PROCESSING, ICPP 2025,
   WORKSHOPS PROCEEDINGS},
Year = {2025},
Pages = {64-70},
Note = {54th International Conference on Parallel Processing-ICPP-Annual, San
   Diego, CA, SEP 08-11, 2025},
Abstract = {RISC-V has gained widespread attention for its simplicity and
   extensibility, making it a compelling choice for high-performance
   processor design. However, its vector extension, RVV (RISC-V Vector
   Extension), lacks efficient support for immediate offset addressing,
   which limits the effectiveness of Superword-Level Parallelism (SLP)
   optimization in certain scenarios. This research addresses that
   limitation by introducing custom vector load/store instructions with
   immediate offsets to the RISC-V ISA. We extend the LLVM compiler
   infrastructure with modified TTI hooks, backend TableGen, and QEMU
   support to enable these custom instructions. Experimental results on the
   SPEC CPU2006 benchmark suite show that our approach reduces
   vectorization costs and improves SLP coverage, yielding notable
   performance gains.},
Type = {Proceedings Paper},
Affiliation = {Liao, SW (Corresponding Author), Natl Taiwan Univ, Taipei, Taiwan.
   Hsu, Min-Hsiu; Liao, Shih-wei; Wei, Chi-Hung, Natl Taiwan Univ, Taipei, Taiwan.
   Kuan, Chi-Bang, Mediatek, Hsinchu, Taiwan.},
DOI = {10.1145/3750720.3757287},
