@inproceedings{ WOS:001575951700070,
Author = {Basharkhah, Katayoon and Hojati, Zahra and Navabi, Zainalabedin},
Book-Group-Author = {IEEE},
Title = {An Event-Based Gate-Level Framework for Power Side-Channel Leakage
   Assessment},
Booktitle = {2025 IEEE COMPUTER SOCIETY ANNUAL SYMPOSIUM ON VLSI, ISVLSI},
Series = {IEEE Computer Society Annual Symposium on VLSI},
Year = {2025},
Pages = {412-417},
Note = {2025 Computer Society Symposium on VLSI-ISVLSI, Kalamata, GREECE, JUL
   06-09, 2025},
Abstract = {Side channel attacks are becoming a major concern in the area of
   security, specifically in cryptographic applications. Power-based
   side-channel attacks are a topic of interest in research and academia
   because of the informative nature of power consumption. In this work, we
   propose an automated framework for assessing hardware design
   vulnerabilities against power side-channel attacks. Our approach focuses
   on power-based analysis, leveraging SystemC power-aware gate models to
   calculate the exact power of the design during the functional simulation
   phase. The proposed gate models can perform online leakage analysis
   during functional simulations. This removes the barrier of
   time-consuming decoupled power simulation and large trace signal
   analysis. Simulation results show that this framework achieves up to
   180X speed-up in comparison to existing works with granularity of
   gate-level and resolution of sub-cycle, with an error of 2.5\%.},
Type = {Proceedings Paper},
Affiliation = {Basharkhah, K (Corresponding Author), Univ Tehran, Sch Elect \& Comp Engn, Coll Engn, Tehran, Iran.
   Basharkhah, Katayoon; Hojati, Zahra; Navabi, Zainalabedin, Univ Tehran, Sch Elect \& Comp Engn, Coll Engn, Tehran, Iran.},
