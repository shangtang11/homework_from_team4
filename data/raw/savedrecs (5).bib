@inproceedings{ WOS:001451879300008,
Author = {Ichioka, Tomosuke and Watanabe, Yohei and Hara, Yuko},
Book-Group-Author = {IEEE},
Title = {PreLock: Precision Locking for Protecting Embedded Processor},
Booktitle = {2024 ASIAN HARDWARE ORIENTED SECURITY AND TRUST SYMPOSIUM, ASIANHOST},
Year = {2024},
Note = {2024 Asian Hardware Oriented Security and Trust Symposium, Kobe, JAPAN,
   DEC 16-18, 2024},
Abstract = {Logic locking and eFPGA-based redaction are effective hardware design
   methods to thwart various threats that may happen when hardware designs
   containing intellectual properties (IPs) are outsourced to untrusted
   third-party fabrication facilities. Although a number of methods have
   been proposed, they focused on protecting an application-specific
   datapath IP and/or controller IP - protecting the datapath IP of
   general-purpose systems (such as processors) has not been studied yet
   even though they could also contain datapath IPs (e.g., custom operators
   added to the datapath through processor extension). Because applications
   executed on the processors may have different error-tolerance when a
   locked (functionally-incorrect) datapath IP is used, the challenge here
   is to disable the processor's functionality for various applications
   (i.e., achieve the sufficient security level) while mitigating the
   circuit overheads induced by the protection. In this work, we present an
   eFPGA-based redaction method to protect a datapath IP in processors.
   Varying the number of bits and the operator for redaction, we
   quantitatively evaluate the effects on various applications with
   different error-tolerance and figure out appropriate eFPGA settings for
   protection from both the application and circuit overhead perspectives.},
Type = {Proceedings Paper},
Affiliation = {Ichioka, T (Corresponding Author), Inst Sci Tokyo, Tokyo, Japan.
   Ichioka, Tomosuke; Hara, Yuko, Inst Sci Tokyo, Tokyo, Japan.
   Watanabe, Yohei, Univ Elect Commun, Tokyo, Japan.},
DOI = {10.1109/ASIANHOST63913.2024.10838478},
Author-Email = {ichioka.t.aa@m.titech.ac.jp
