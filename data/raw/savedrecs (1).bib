@article{ WOS:001529339700001,
Author = {Zhong, Yan and Li, Yudong and Shi, Lu and Hu, Meng and Cheng, Guanggui},
Title = {Self-powered triboelectric sensor based on micro-pyramid-conformal dome
   composite structures for texture recognition},
Journal = {MEASUREMENT},
Year = {2025},
Volume = {256},
Number = {C},
Month = {DEC 1},
Abstract = {Humans can identify textures by gently sliding their fingers over the
   surfaces of objects. Tactile sensors based on triboelectric
   nanogenerators (TENGs) have garnered widespread attention due to their
   great potential in fine texture recognition. Herein, a self-powered
   sensor is constructed for texture recognition by integrating
   micropyramid structures onto the surface of conformal dome structures
   using thin-film transfer and reverse dome adsorption process. The sensor
   captures the transferred charges generated during the interaction with
   textures in the sliding process to achieve texture recognition. The
   results show that the composite structure based on micropyramids with a
   height of 200 mu m achieves the largest output peak voltage. In
   addition, Fast Fourier Transform (FFT) is used to determine the
   characteristic frequencies, and the results indicate that the
   characteristic frequency is mainly related to the spacing between
   texture structures and scanning speed (lambda = v/f), and is independent
   of applied normal pressure. Four samples with different texture spacings
   are prepared, and the texture spacings are successfully distinguished
   through the characteristic frequencies. 30 mu m spacing is identified as
   the perception limit. This work provides a route such as integrated
   structure design strategy to develop self-powered sensor for texture
   recognition.},
Type = {Article},
Affiliation = {Zhong, Y; Cheng, GG (Corresponding Author), Jiangsu Univ, Sch Mech Engn, Key Lab Intelligent Flexible Actuat \& Control Univ, Zhenjiang 212013, Peoples R China.
   Zhong, Yan; Li, Yudong; Shi, Lu; Hu, Meng; Cheng, Guanggui, Jiangsu Univ, Sch Mech Engn, Key Lab Intelligent Flexible Actuat \& Control Univ, Zhenjiang 212013, Peoples R China.},
DOI = {10.1016/j.measurement.2025.118342},
EarlyAccessDate = {JUL 2025},
Article-Number = {118342},
Keywords = {Micro-pyramids; Self-powered sensor; Conformal dome structure; Texture
   recognition},
