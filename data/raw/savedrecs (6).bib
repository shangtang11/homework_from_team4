@article{ WOS:000975399300022,
Author = {Darmawi-Iskandar, Patrick K. and Aaron, Andrew M. and Zhang, En Xia and
   Bhuva, Bharat L. and Kauppila, Jeffery S. and Davidson, Jim L. and
   Alles, Michael L. and Fleetwood, Daniel M. and Massengill, Lloyd W.},
Title = {Total-Ionizing-Dose Effects and Low-Frequency Noise in N-Type Carbon
   Nanotube Field-Effect Transistors With HfO2 Gate Dielectrics},
Journal = {IEEE TRANSACTIONS ON NUCLEAR SCIENCE},
Year = {2023},
Volume = {70},
Number = {4},
Pages = {449-455},
Month = {APR},
Abstract = {Total ionizing dose (TID) irradiation and low-frequency noise
   characterization are performed on carbon nanotube field-effect
   transistors (CNTFETs). Large hysteresis due to high border-trap
   densities is observed in as-processed and irradiated devices. TID
   irradiation also leads to significant radiation-induced charge trapping
   in the surrounding dielectrics resulting in parametric degradation.
   Percolation-path switching and border traps contribute to low-frequency
   noise, with a relatively more prominent role for border traps after
   irradiation than before irradiation. These results show that process
   improvements are required to optimize both the initial operating
   characteristics and the radiation response of CNTFETs.},
Type = {Article},
Affiliation = {Darmawi-Iskandar, PK (Corresponding Author), Vanderbilt Univ, Dept Elect \& Comp Engn, Nashville, TN 37235 USA.
