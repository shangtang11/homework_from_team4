@article{ WOS:001335947700005,
Author = {Song, Wei and Xie, Da and Xue, Zihan and Liu, Peng},
Title = {A Parallel Tag Cache for Hardware Managed Tagged Memory in Multicore
   Processors},
Journal = {IEEE TRANSACTIONS ON COMPUTERS},
Year = {2024},
Volume = {73},
Number = {11},
Pages = {2488-2503},
Month = {NOV},
Abstract = {Hardware-managed tagged memory is the dominant way of supporting tags in
   current processor designs. Most of these processors reserve a hidden tag
   partition in the memory dedicated for tags and use a small tag cache
   (TC) to reduce the extra memory accesses introduced by the tag
   partition. Recent research shows that storing tags in a hierarchical tag
   table (HTT) inside the tag partition allows efficient compression in a
   TC, but the use of the HTT causes special data inconsistency issues when
   multiple related tag accesses are served simultaneously. How to design a
   parallel TC for multicore processors remains an open problem. We
   proposed the first TC capable of serving multiple tag accesses in
   parallel. It adopts a two-phase locking procedure to maintain data
   consistency and integrates seven techniques, where three are firstly
   proposed, and two are theoretical concepts materialized into usable
   solutions for the first time. Single-core and multicore performance
   results show that the proposed TC is effective in reducing both the
   extra amount of memory accesses to the tag partition and the overhead in
   execution time. It is important to provide enough number of trackers in
   multicore processors while providing extra trackers is beneficial for
   running HTT/TC ineffective applications.},
Type = {Article},
Affiliation = {Song, W (Corresponding Author), Chinese Acad Sci, Inst Informat Engn, Key Lab Cyberspace Secur Def, Beijing 100085, Peoples R China.
   Song, Wei; Xie, Da; Xue, Zihan, Chinese Acad Sci, Inst Informat Engn, Key Lab Cyberspace Secur Def, Beijing 100085, Peoples R China.
