Title = {Tb3+-activated intense mechanoluminescence materials for potential
   automotive accident alert sensing},
Journal = {JOURNAL OF ALLOYS AND COMPOUNDS},
Year = {2026},
Volume = {1050},
Month = {JAN 15},
Abstract = {Mechanoluminescent (ML) materials, as functional materials capable of
   generating light radiation under external stimuli, hold significant
   research value in engineering application fields such as structural
   health monitoring and stress sensing. Due to the limited diversity of ML
   materials, a novel terbium ion (Tb3+)-doped strontium lanthanum gallate
   (SrLaGaO4) phosphor was developed, which mechanoluminescent properties
   were systematically investigated for the first time. This work also
   provides new insights for the development of novel ML materials. The
   results demonstrate that SrLa1-xGaO4:xTb3+@PDMS thin films exhibit
   mechanoluminescent capabilities under both ultraviolet pre-irradiation
   and untreated conditions, and their luminescence characteristics are
   regulated by the coupling of trap and non-trap effects. Additionally,
   under no pre-irradiation, the ML intensity of the films decreases by
   only about 29 \% after 3 min at 573 K, indicating a certain degree of
   high-temperature resistance. Finally, an airbag simulation experiment
   was conducted, demonstrating the material's potential for practical
   applications in stress sensing and real-time safety monitoring.},
