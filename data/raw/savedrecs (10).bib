@inproceedings{ WOS:000658850600014,
Author = {Mische, Joerg and Frieb, Martin and Stegmeier, Alexander and Ungerer,
   Theo},
Editor = {Pnevmatikatos, DN and Pelcat, M and Jung, M},
Title = {PIMP My Many-Core: Pipeline-Integrated Message Passing},
