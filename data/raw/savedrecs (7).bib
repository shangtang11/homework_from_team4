@inproceedings{ WOS:001164081800059,
Author = {Guo, Yanan and Cao, Dingyuan and Xin, Xin and Zhang, Youtao and Yang,
   Jun},
Book-Group-Author = {ACM},
Title = {Uncore Encore: Covert Channels Exploiting Uncore Frequency Scaling},
Booktitle = {56TH IEEE/ACM INTERNATIONAL SYMPOSIUM ON MICROARCHITECTURE, MICRO 2023},
Year = {2023},
