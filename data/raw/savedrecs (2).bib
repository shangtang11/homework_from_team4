@article{ WOS:001641531500033,
Author = {Konishi, Yohei and Ikami, Akio and Amrallah, Amr and Tsukamoto, Yu and
   Murakami, Takahide and Shinbo, Hiroyuki and Amano, Yoshiaki},
Title = {Efficient Hardware Acceleration of P-MMSE in Scalable Cell-Free Massive
   MIMO Systems},
Journal = {IEEE ACCESS},
Year = {2025},
Volume = {13},
Pages = {209023-209036},
Abstract = {In beyond fifth-generation (B5G) and sixth-generation (6G) mobile
   networks, cell-free massive multiple-input multiple-output (CF-mMIMO)
   has emerged as a promising solution for delivering uniform communication
   quality across the radio access network. In CF-mMIMO systems, as the
   number of access points (APs) and user equipment (UEs) increases, the
   size of the matrices involved in MIMO signal processing grows
   substantially. These computationally intensive signal processing
   operations must be completed within the duration of a wireless frame. To
   alleviate the resulting computational burden, the partial minimum mean
   squared error (P-MMSE) method processes only selected AP-UE
   combinations, while hardware accelerators (HAs) such as graphics
   processing units (GPUs) and field-programmable gate arrays (FPGAs) offer
   high-speed parallel computation. However, a key inefficiency persists:
   the fixed matrix dimensions used in parallel operations on HAs led to
   underutilization of computational resources when processing the smaller
   matrices generated by P-MMSE. This study introduces an HA-oriented
   P-MMSE scheme designed to address this limitation by optimizing UE
   grouping to maximize single-instruction multiple-data (SIMD) set
   utilization, while preserving the computational efficiency advantages of
   P-MMSE. Experimental evaluations on a GPU demonstrate that the proposed
   method improves SIMD set utilization from 62.2\% to 75.4\% during matrix
   operations. Under practical conditions with varying AP cluster sizes, it
   achieves a 53.0\% reduction in energy consumption compared to
   conventional MMSE, thereby validating its effectiveness for
   energy-efficient wireless signal processing in large-scale CF-mMIMO
   systems.},
Type = {Article},
Affiliation = {Konishi, Y (Corresponding Author), KDDI Res Inc, Wireless Technol Div, Saitama 3568502, Japan.
