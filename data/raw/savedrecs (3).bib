Title = {Real-Time Linux on RISC-V: Long-Term Performance Analysis of PREEMPT RT
   Patches},
Booktitle = {EMBEDDED COMPUTER SYSTEMS: ARCHITECTURES, MODELING, AND SIMULATION,
   SAMOS 2024, PT II},
