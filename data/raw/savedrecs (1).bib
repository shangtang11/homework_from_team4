@article{ WOS:001506724300007,
Author = {Hong, Xuenong and Tee, Yee-Yang and Hu, Zilong and Lin, Tong and Shi,
   Yiqiong and Cheng, Deruo and Gwee, Bah-Hwee},
Title = {GNNReveal: A Novel Graph-Neural-Network-Based Attack Method for
   Integrated Circuit Logic Gate Decamouflaging},
Journal = {IEEE INTELLIGENT SYSTEMS},
Year = {2025},
Volume = {40},
Number = {3},
Pages = {59-67},
Month = {MAY-JUN},
Abstract = {Recent advancement in circuit extraction poses new threats to integrated
   circuits (ICs) intellectual property protection. Hardware obfuscation by
   IC logic gate camouflaging results in logic gates with unknown
   functionalities in an extracted netlist, protecting manufactured ICs
   from circuit extraction. Logic gate decamouflaging attacks have been
   proposed. Conventional attacks are not suitable for large-scale
   camouflaging due to infeasible computation cost. Existing graph neural
   network (GNN)-based methods are efficient, but they are less effective
   in differentiating between fan-in and fan-out structures, which hampers
   their effectiveness. In this article, we propose a novel GNN-based
   attack method, namely, GNNReveal, for logic gate decamouflaging. Our
   proposed GNNReveal performs separate fan-in/fan-out aggregations to
   generate unique node embeddings for logic gates with different
   functionalities, allowing for direct node classification for logic gate
   decamouflaging. Our experiments show that our proposed GNNReveal
   achieved high decamouflaging accuracy and significantly outperformed
   competing methods by, at most, 20\%.},
Type = {Article},
Affiliation = {Hong, XN (Corresponding Author), Nanyang Technol Univ, Singapore 639798, Singapore.
   Hong, Xuenong; Tee, Yee-Yang; Hu, Zilong; Lin, Tong; Shi, Yiqiong; Cheng, Deruo; Gwee, Bah-Hwee, Nanyang Technol Univ, Singapore 639798, Singapore.},
DOI = {10.1109/MIS.2024.3430263},
Keywords = {Logic gates; Training; Intelligent systems; Graph neural networks;
   Benchmark testing; Integrated circuit modeling; Hardware},
Author-Email = {xuenong.hong@ntu.edu.sg
   yeeyang.tee@ntu.edu.sg
   zhu010@ntu.edu.sg
   lintong@ntu.edu.sg
   yqshi@ntu.edu.sg
   deruo.cheng@ntu.edu.sg
   ebhgwee@ntu.edu.sg},
