DOI = {10.1109/ACCESS.2024.3512419},
Keywords = {Logic gates; Entropy; Circuits; Field programmable gate arrays;
   Security; Inverters; Cryptography; Hazards; Delays; Generators; True
   random number generator (TRNG); race hazard; ring oscillator; field
   programmable gate array (FPGA); jitter},
