Series = {IEEE Computer Society Annual Symposium on VLSI},
Year = {2024},
Pages = {557-564},
Note = {IEEE-Computer-Society Annual Symposium on VLSI (ISVLSI), Knoxville, TN,
   JUL 01-03, 2024},
Abstract = {The adiabatic quantum-flux-parametron (AQFP) is the basis of an emerging
   computing technology that shows tremendous promise towards building
   extremely energy efficient computing systems with bit energies
   approaching sub-zeptojoule levels at clock frequencies as high as 10
   GHz. We review some of the latest AQFP circuit demonstrations including
   a RISC-like microprocessor called MANA and a SHA-3 permutation unit
   breakout chip. We briefly explore other computing possibilities for AQFP
   and hybrid AQFP systems and present implementation challenges for AQFP
   technology such as limited integration density and signal integrity to
   name a few. Finally, we present possible solutions to these challenges,
   and summarize the prospects of building practical, feature-rich AQFP
   chips that are comparable to the modern CMOS circuits used today.},
