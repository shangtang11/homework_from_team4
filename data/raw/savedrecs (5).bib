Title = {Verifying a C Implementation of Derecho's Coordination Mechanism Using
   VST and Coq},
Booktitle = {NASA FORMAL METHODS, NFM 2024},
Series = {Lecture Notes in Computer Science},
Year = {2024},
Volume = {14627},
Pages = {99-117},
Note = {16th International Symposium on NASA Formal Methods (NFM), NASA Ames Res
   Ctr, Moffett Field, CA, JUN 04-06, 2024},
Abstract = {Derecho is a C++ framework for distributed programming leveraging high
   performance communication primitives such as RDMA. At its core is the
   shared state table (SST), a replicated data structure that supports
   efficient protocols for consensus and group membership. Our aim is to
   formalize the reasoning principles articulated by the designers, which
   focus on knowledge and monotonicity, as basis for highly assured high
   performance distributed applications. To this end we develop a high
   level model that exposes the SST principles in an application-friendly
   way. We use the model to specify and verify a re-implementation in C of
   the SST API. We validate the specifications by verifying simple
   applications that embody key parts of the Derecho protocols. The
   development is carried out using VST and Coq. This lays groundwork for
   verification of the full Derecho protocols and applications built on
   them.},
