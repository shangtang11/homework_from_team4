@article{ WOS:000507151600063,
Author = {Wang, Ying and Liu, Dayan and Zhang, Hongjie and Wang, Jiacheng and Du,
   Ran and Li, Ting-Ting and Qian, Jinjie and Hu, Yue and Huang, Shaoming},
Title = {Methylation-Induced Reversible Metallic-Semiconducting Transition of
   Single-Walled Carbon Nanotube Arrays for High-Performance Field-Effect
   Transistors},
Journal = {NANO LETTERS},
Year = {2020},
Volume = {20},
Number = {1},
Pages = {496-501},
Month = {JAN},
Abstract = {Acquirement of aligned semiconducting single-walled carbon nanotube
   (s-SWNT) arrays is one of the most promising directions to break Moore's
   Law, thus developing the next-generation electronic devices. Despite
   that widespread approaches have been developed, it is still a great
   challenge to facilely prepare s-SVVNT arrays with tunable electronic
   properties. Herein, a different perspective is proposed to produce
   s-SWNT arrays by implementing reversible methylation reactions on the
   as-grown aligned SWNT arrays. In this way, the metallic single-walled
   carbon nanotubes (m-SWNTs) are selectively and reversibly methylated to
   acquire semiconducting properties, to afford tunable electronic
   properties of the as-obtained SWNT arrays in a highly controllable and
   simple manner. Electrical measurements suggest a high fraction of
   s-SWNTs is attained (>97.5\%) after methylation, facilitating its
   exceptional performance as a field-effect transistor (FET) with an
   on-off ratio of up to 17543. This method may provide a new way for the
   preparation of s-SWNT arrays with tunable electronic properties and
   impressive prospects toward the fabrication of high-performance FETs.},
Type = {Article},
Affiliation = {Qian, JJ; Hu, Y; Huang, SM (Corresponding Author), Wenzhou Univ, Coll Chem \& Mat Engn, Key Lab Carbon Mat Zhejiang Prov, Wenzhou 325000, Peoples R China.
   Huang, SM (Corresponding Author), Guangdong Univ Technol, Sch Mat \& Energy, Guangzhou 510006, Peoples R China.
   Wang, Ying; Liu, Dayan; Zhang, Hongjie; Wang, Jiacheng; Qian, Jinjie; Hu, Yue; Huang, Shaoming, Wenzhou Univ, Coll Chem \& Mat Engn, Key Lab Carbon Mat Zhejiang Prov, Wenzhou 325000, Peoples R China.
