@inproceedings{ WOS:001213882700011,
Author = {Agrawal, Megha and Duraisamy, Kumar and Ganesan, Karthikeyan Sabari and
   Gupta, Shivam and Kandele, Suyash and Konduru, Sai Sandilya and
   Maddipati, Harika Chowdary and Raghavendra, K. and Sahu, Rajeev Anand
   and Saraswat, Vishal},
Editor = {Chattopadhyay, A and Bhasin, S and Picek, S and Rebeiro, C},
Title = {Secure Boot in Post-Quantum Era (Invited Paper)},
Booktitle = {PROGRESS IN CRYPTOLOGY - INDOCRYPT 2023, PT II},
