@article{ WOS:001399637900001,
Author = {Amirany, Abdolah and Mohebbi, Ladan},
Title = {SQTRNG: Spintronic Quaternary True Random Number Generator},
Journal = {SPIN},
Year = {2025},
Volume = {15},
Number = {01},
Month = {FEB},
Abstract = {In this paper, a quaternary true random number generator (QTRNG) is
   designed and simulated. The proposed QTRNG capitalizes on the stochastic
   behavior of the magnetic tunnel junction (MTJ) device at currents below
   the critical current, alongside the adjustable threshold voltage of the
   carbon nanotube field-effect transistor (CNTFET). To maintain uniformity
   in the ratio of numbers generated by the QTRNG and mitigate the impact
   of fabrication process variations, a mid-level processing block has been
   incorporated. Simulation results show that the proposed QTRNG occupies
   at least 7\% less area and can produce 36\% more digits per second
   compared to existing binary and ternary true random number generators.},
Type = {Article},
Affiliation = {Amirany, A (Corresponding Author), George Washington Univ, Dept Elect \& Comp Engn, Washington, DC 20052 USA.
