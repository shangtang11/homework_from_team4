@inproceedings{ WOS:001572877200091,
Author = {Dommel, Johannes and Hassan, Fatma and Utkovski, Zoran},
Book-Group-Author = {IEEE},
Title = {AN ENERGY-EFFICIENT AND ROBUST TRANSMISSION SCHEME FOR IOT-BASED
   PHYSIOLOGICAL ACTIVITY MONITORING},
Booktitle = {2022 IEEE GLOBECOM WORKSHOPS, GC WKSHPS},
Series = {IEEE Globecom Workshops},
Year = {2022},
Pages = {547-551},
Note = {2022 Globecom Workshops-GLOBECOM, Rio de Janeiro, BRAZIL, DEC 04-08,
   2022},
Abstract = {The continuous monitoring of physiological activity via cellular
   wireless networks promises enormous potential for applications in the
   telemedicine setting. Though, the underlying assumption of reliable
   wireless connectivity to transmit raw sensor readings from the patient
   to the monitoring application in real time makes an energy-efficient
   implementation challenging. This paper introduces an AI-assisted
   transmission scheme that exploits on-device pre-processing to extract
   and transmit only task-relevant information. As an example application,
   a heart rate variability (HRV) monitoring system is designed that relies
   on electrocardiography (ECG) measurements. A numerical evaluation shows
   robust performance with high packet loss at only 1\% of the throughput
   required for the baseline approach. Thus, the proposed scheme it
   suitable for energy efficient implementation with cellular Narrowband
   Internet of Things (NB-IoT).},
