@inproceedings{ WOS:001543539900019,
Author = {Pradhan, Ashutosh and Ottaviano, Daniele and Jiang, Yi and Huang,
   Haozheng and Zuepke, Alexander and Bastoni, Andrea and Caccamo, Marco},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Arm Dynamiq Shared Unit and Real-Time: An Empirical Evaluation},
Booktitle = {2025 IEEE 31ST REAL-TIME AND EMBEDDED TECHNOLOGY AND APPLICATIONS
   SYMPOSIUM, RTAS},
Series = {IEEE Real-Time and Embedded Technology and Applications Symposium},
Year = {2025},
Pages = {241-254},
Note = {31st Embedded Technology and Applications Symposium-RTAS-Annual, Irvine,
   CA, MAY 06-09, 2025},
Abstract = {The increasing complexity of embedded hardware platforms poses
   significant challenges for real-time workloads. Architectural features
   such as Intel RDT, Arm QoS, and Arm MPAM are either unavailable on
   commercial embedded platforms or designed primarily for server
   environments optimized for average-case performance and might fail to
   deliver the expected real-time guarantees. Arm DynamIQ Shared Unit (DSU)
   includes isolation features-among others, hardware per-way cache
   partitioning-that can improve the real-time guarantees of complex
   embedded multicore systems and facilitate real-time analysis. However,
   the DSU also targets average cases, and its real-time capabilities have
   not yet been evaluated. This paper presents the first comprehensive
   analysis of three real-world deployments of the Arm DSU on Rockchip
   RK3568, Rockchip RK3588, and NVIDIA Orin platforms. We integrate support
   for the DSU at the operating system and hypervisor level and conduct a
   large-scale evaluation using both synthetic and real-world benchmarks
   with varying types and intensities of interference. Our results make
   extensive use of performance counters and indicate that, although
   effective, the quality of partitioning and isolation provided by the DSU
   depends on the type and the intensity of the interfering workloads. In
   addition, we uncover and analyze in detail the correlation between
   benchmarks and different types and intensities of interference.},
Type = {Proceedings Paper},
Affiliation = {Pradhan, A (Corresponding Author), Tech Univ Munich, Munich, Germany.
   Pradhan, Ashutosh; Ottaviano, Daniele; Jiang, Yi; Huang, Haozheng; Zuepke, Alexander; Bastoni, Andrea; Caccamo, Marco, Tech Univ Munich, Munich, Germany.},
DOI = {10.1109/RTAS65571.2025.00032},
