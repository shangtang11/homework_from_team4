@article{ WOS:000531884700005,
Author = {Sriraman, Harini and Venkatasubbu, Pattabiraman},
Title = {SeRA: Self-Repairing Architecture for Dark Silicon Era},
Journal = {JOURNAL OF CIRCUITS SYSTEMS AND COMPUTERS},
Year = {2020},
Volume = {29},
Number = {4},
Month = {MAR 31},
Abstract = {The lifetime reliability of processors has become a major design
   constraint in the dark silicon era. Processor reliability issues are
   mainly due to design defects and aging. Unlike design defects, however,
   aging faults gradually accumulate over time. Many methods have recently
   been proposed to monitor the performance degradation of circuits. In
   this study, an architectural solution that extends the circuit-level age
   monitoring to processor stages is proposed for monitoring performance
   degradation. When degradation of a stage quantified as delay of half of
   the reference clock occurs, a self-repairing mechanism is triggered.
   This mechanism configures an field programmable gate array (FPGA), which
   takes over the functions of the degraded unit. The proposed
   self-repairing mechanism is applied to the stages of the processor
   data-path. This method (SeRA) has lesser area overhead compared with the
   state-of-art solutions.},
Type = {Article},
Affiliation = {Sriraman, H (Corresponding Author), Vellore Inst Technol, Sch Comp Sci \& Engn, Chennai, Tamil Nadu, India.
