@article{ WOS:001652569800040,
Author = {Chukwuemeka Osuorah, Josemaria and Ahmed, Sheikh Tareq and Annamalai,
   Annamalai and Chouikha, Mohamed F.},
Title = {Vulnerabilities and Layered Security Threats in LoRaWAN Systems: A
   Comprehensive Survey on Physical, MAC, and Application Layer Weaknesses},
Journal = {IEEE ACCESS},
Year = {2025},
Volume = {13},
Pages = {217939-217953},
Abstract = {LoRa has emerged as a leading Low Power Wide Area Network (LPWAN)
   technology, widely adopted for long-range communication, low energy
   consumption, and adaptability across diverse IoT applications. However,
   its lightweight design, optimized for constrained environments, exposes
   critical security vulnerabilities across multiple protocol layers. As
   deployments in agriculture, healthcare, smart cities, and industrial
   automation grow, understanding LoRa's security posture has become
   imperative. This survey provides a comprehensive, layer-wise analysis of
   LoRa's vulnerabilities and attack vectors, covering the physical, MAC,
   and application layers. It categorizes threats such as jamming,
   eavesdropping, replay attacks, key reuse, and packet injection, and
   examines adversary models and their capabilities. The paper also
   highlights emerging trends in leveraging artificial intelligence (AI)
   and machine learning (ML) techniques for intrusion detection and anomaly
   recognition in LoRa-based systems. By consolidating technical findings
   and introducing a novel taxonomy of vulnerabilities and mitigations,
   this work contributes a structured reference for designing secure and
   resilient LoRa networks and guides future research directions.},
Type = {Article},
