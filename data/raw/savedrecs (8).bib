@inproceedings{ WOS:000890026200008,
Author = {Tollec, Simon and Asavoae, Mihail and Courousse, Damien and Heydemann,
   Karine and Jan, Mathieu},
Book-Group-Author = {IEEE},
Title = {Exploration of Fault Effects on Formal RISC-V Microarchitecture Models},
Booktitle = {2022 WORKSHOP ON FAULT DETECTION AND TOLERANCE IN CRYPTOGRAPHY (FDTC
   2022)},
Year = {2022},
Pages = {73-83},
Note = {19th Workshop on Fault Detection and Tolerance in Cryptography (FDTC),
   ELECTR NETWORK, SEP 16, 2022},
Abstract = {This paper introduces a formal workflow for modeling software/hardware
   systems in order to explore the effects of fault injections and evaluate
   the robustness to fault injection attacks. We illustrate this workflow
   on four versions of a PIN authentication code, embedding different
   software countermeasures. The code is symbolically evaluated on two
   implementations of the RISC-V CV32E40P core: the original implementation
   from the OpenliW group and an implementation that integrates protection
   of the pipeline control signals. On the original, unprotected core, our
   formal workflow exposes various vulnerabilities, including previously
   unknown ones, whereas, on the protected core, it confirms the
   effectiveness of the proposed countermeasures.},
Type = {Proceedings Paper},
Affiliation = {Tollec, S (Corresponding Author), Univ Paris Saclay, CEA, List, F-91120 Palaiseau, France.
   Tollec, Simon; Asavoae, Mihail; Jan, Mathieu, Univ Paris Saclay, CEA, List, F-91120 Palaiseau, France.
