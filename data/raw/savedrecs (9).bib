@article{ WOS:000641972300014,
Author = {Kneip, Adrian and Bol, David},
Title = {Impact of Analog Non-Idealities on the Design Space of 6T-SRAM
   Current-Domain Dot-Product Operators for In-Memory Computing},
Journal = {IEEE TRANSACTIONS ON CIRCUITS AND SYSTEMS I-REGULAR PAPERS},
Year = {2021},
Volume = {68},
Number = {5},
Pages = {1931-1944},
Month = {MAY},
Abstract = {In-memory computing provides unprecedented power and area efficiency for
   the execution of convolutional neural networks by using memory bitcells
   to perform dot-product (DP) operations in the analog domain. Yet, these
   operators suffer from analog non-idealities (ANIs) that degrade the
   inference accuracy. This paper proposes design guidelines inferred from
   a holistic simulation-based analysis of the impact of ANIs on the
   accuracy-efficiency trade-off that affects current-domain DP operators
   based on conventional 6T-SRAM bitcell arrays. We define a custom SNR
   metric aware of the DP operand distribution to quantify decision errors
   associated with various ANIs, over ranges of input/output resolution and
   hardware design parameters. We find out that non-linearity and local
   mismatch are the dominant ANIs limiting the design space, while IR drops
   turn out to be critical only when targeting high parallelism. We then
   quantify the accuracy-efficiency trade-off related to these dominant
   ANIs across the design space and propose optimal design choices. We
   notably identify that using larger operators can either improve or
   worsen the SNR depending on the target output resolution. Furthermore,
   we show that hardware calibration techniques which mitigate mismatch
   help to recover a fraction of the lost SNR, with greater effectiveness
   when scaling down the supply voltage.},
Type = {Article},
Affiliation = {Kneip, A (Corresponding Author), UCLouvain, ICTEAM Inst, B-1348 Ottignies, Belgium.
   Kneip, Adrian; Bol, David, UCLouvain, ICTEAM Inst, B-1348 Ottignies, Belgium.},
