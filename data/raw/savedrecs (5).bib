@inproceedings{ WOS:001447796700075,
Author = {Liu, Xiaoyi and Pu, Zhongzhu and Qu, Peng and Zheng, Weimin and Zhang,
   Youhui},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {ActiveN: A Scalable and Flexibly-programmable Event-driven Neuromorphic
   Processor<bold> </bold>},
Booktitle = {2024 57TH IEEE/ACM INTERNATIONAL SYMPOSIUM ON MICROARCHITECTURE, MICRO},
Series = {International Symposium on Microarchitecture Proceedings},
Year = {2024},
Pages = {1122-1137},
Note = {57th International Symposium on Microarchitecture, Austin, TX, NOV
   02-06, 2024},
Abstract = {At present, most neuromorphic chips utilize custom circuits and/or
   on-chip memory to achieve neural computations and parameter storage.
   However, with the diversified development of brain-inspired
   applications, this approach faces significant challenges regarding
   programming flexibility and scalability.
   To address these issues, we propose a RISC-V-based many-core
   neuromorphic architecture, ActiveN. Each neuro-core is equipped with an
   active-message-enabled micro-architecture to support the event-driven
   programming model of Spiking Neural Networks (SNNs), and the memory
   subsystem is enhanced to identify sparse data and forward them directly.
   These mechanisms significantly mitigate the impact of memory latency on
   performance to enable the storage of synapse data in off-chip (or
   off-die) bulk storages (e.g., DRAMs, HBMs), which not only improve
   storage scalability but also increase computing density. Furthermore,
   the core's instruction set is customized to include a compact and
   complete set of fixed- and floating-point computing instructions,
   supporting various neural models and SNN computation algorithms
   flexibly.
   End-to-end prototype testing demonstrates that, compared to a
   state-of-the-art chip based on custom circuitry and onchip SRAM that
   also supports event-driven operations, ActiveN can integrate over 10x
   more processing units (512) with strong scalability to fully utilize
   memory bandwidth. Additionally, it achieves 7.9 times the performance of
   this counterpart and 96.6 times the performance of an NVIDIA A100 GPU,
   while maintaining flexible programmability.<bold> </bold>},
Type = {Proceedings Paper},
Affiliation = {Liu, XY (Corresponding Author), Tsinghua Univ, Beijing Natl Res Ctr Informat Sci \& Technol, Beijing, Peoples R China.
