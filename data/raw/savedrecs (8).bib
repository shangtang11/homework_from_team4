@article{ WOS:000736589300034,
Author = {Tang, Dai-Ming and Erohin, V, Sergey and Kvashnin, Dmitry G. and Demin,
   Victor A. and Cretu, Ovidiu and Jiang, Song and Zhang, Lili and Hou,
   Peng-Xiang and Chen, Guohai and Futaba, Don N. and Zheng, Yongjia and
   Xiang, Rong and Zhou, Xin and Hsia, Feng-Chun and Kawamoto, Naoyuki and
   Mitome, Masanori and Nemoto, Yoshihiro and Uesugi, Fumihiko and
   Takeguchi, Masaki and Maruyama, Shigeo and Cheng, Hui-Ming and Bando,
   Yoshio and Liu, Chang and Sorokin, Pavel B. and Golberg, Dmitri},
Title = {Semiconductor nanochannels in metallic carbon nanotubes by
   thermomechanical chirality alteration},
Journal = {SCIENCE},
Year = {2021},
Volume = {374},
Number = {6575},
Pages = {1616+},
Month = {DEC 24},
Abstract = {Carbon nanotubes have a helical structure wherein the chirality
   determines whether they are metallic or semiconducting. Using in situ
   transmission electron microscopy, we applied heating and mechanical
   strain to alter the local chirality and thereby control the electronic
   properties of individual single-wall carbon nanotubes. A transition
   trend toward a larger chiral angle region was observed and explained in
   terms of orientation-dependent dislocation formation energy. A
   controlled metal-to-semiconductor transition was realized to create
   nanotube transistors with a semiconducting nanotube channel covalently
   bonded between a metallic nanotube source and drain. Additionally,
   quantum transport at room temperature was demonstrated for the
   fabricated nanotube transistors with a channel length as short as 2.8
   nanometers.},
