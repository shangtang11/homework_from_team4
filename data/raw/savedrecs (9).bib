@article{ WOS:000749040300006,
Author = {Nagasawa, Shuichi and Tanaka, Masamitsu and Takeuchi, Naoki and
   Yamanashi, Yuki and Miyajima, Shigeyuki and China, Fumihiro and Yamae,
   Taiki and Yamazaki, Koki and Somei, Yuta and Sega, Naonori and Mizugaki,
   Yoshinao and Myoren, Hiroaki and Terai, Hirotaka and Hidaka, Mutsuo and
   Yoshikawa, Nobuyuki and Fujimaki, Akira},
Title = {Planarized Nb 4-Layer Fabrication Process for Superconducting Integrated
   Circuits and Its Fabricated Device Evaluation},
Journal = {IEICE TRANSACTIONS ON ELECTRONICS},
Year = {2021},
Volume = {E104C},
Number = {9},
Pages = {435-445},
Month = {SEP},
Abstract = {We developed a Nb 4-layer process for fabricating superconducting
   integrated circuits that involves using caldera planarization to
   increase the flexibility and reliability of the fabrication process. We
   call this process the planarized high-speed standard process (PHSTP).
   Planarization enables us to flexibly adjust most of the Nb and SiO2 film
   thicknesses; we can select reduced film thicknesses to obtain larger
   mutual coupling depending on the application. It also reduces the risk
   of intra-layer shorts due to etching residues at the step-edge regions.
   We describe the detailed process flows of the planarization for the
   Josephson junction layer and the evaluation of devices fabricated with
   PHSTP. The results indicated no short defects or degradation in junction
   characteristics and good agreement between designed and measured
   inductances and resistances. We also developed single-flux-quantum (SFQ)
   and adiabatic quantum-flux-parametron (AQFP) logic cell libraries and
   tested circuits fabricated with PHSTP. We found that the designed
   circuits operated correctly. The SFQ shift-registers fabricated using
   PHSTP showed a high yield. Numerical simulation results indicate that
   the AQFP gates with increased mutual coupling by the planarized layer
   structure increase the maximum interconnect length between gates.},
Type = {Article},
Affiliation = {Tanaka, M (Corresponding Author), Nagoya Univ, Nagoya, Aichi 4648603, Japan.
   Nagasawa, Shuichi; Hidaka, Mutsuo, AIST, Tsukuba, Ibaraki 3058568, Japan.
   Tanaka, Masamitsu; Fujimaki, Akira, Nagoya Univ, Nagoya, Aichi 4648603, Japan.
