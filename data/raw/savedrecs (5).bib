@inproceedings{ WOS:001179175100006,
Author = {Schaetzle, Fabian and Falquez, Carlos and Heinen, Stefan and Ho, Nam and
   Portero, Antoni and Suarez, Estela and van den Boom, Johannes and van
   Waasen, Stefan},
Book-Group-Author = {Assoc Computing Machinery},
Title = {Modeling methodology for multi-die chip design based on gem5/SystemC
   co-simulation},
Booktitle = {PROCEEDINGS OF THE RAPIDO 2024 WORKSHOP, HIPEAC 2024},
Year = {2024},
Pages = {35-41},
Note = {Rapido Workshop on Rapid Simulation and Performance Evaluation - Methods
   and Tools (Rapido) / HiPEAC Conference, Munich, GERMANY, JAN 17-19, 2024},
Abstract = {The paper introduces a modeling methodology aimed at thoroughly
   exploring the design space of multi-die chip architecture tailored for
   High-Performance Computing (HPC). For accurate simulations, we leverage
   the capabilities of gem5's Ruby for its robust CPU models and cache
   coherence protocols, providing a comprehensive representation of die
   architecture. Die-to-die interfaces are modeled using SystemC TLM,
   offering flexibility to integrate with other simulators. This enables
   co-simulation with varying abstraction levels, making it well-suited for
   the design analysis of multi-die chip architecture. We present, to the
   best of our knowledge, the first attempt to integrate gem5's Ruby memory
   system with SystemC TLM for the modeling of multi-die chip architecture.
   The benefits of this model are demonstrated through the instantiation of
   a multi-die design using modern Arm architectures with four compute dies
   and twoexecuting STREAM Triad with Linux, followed by a comparative
   performance analysis against a monolithic design.},
