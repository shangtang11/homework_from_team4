@inproceedings{ WOS:000675600200075,
Author = {Patankar, Udayan Sunil and Flores, Miguel E. and Koel, Ants},
Book-Group-Author = {IEEE},
Title = {Study of Estimation Based Functional Iteration Approximation Dividers},
Booktitle = {2021 IEEE INTERNATIONAL CONFERENCE ON CONSUMER ELECTRONICS (ICCE)},
Series = {International Conference on Consumer Electronics},
Year = {2021},
Note = {IEEE International Conference on Consumer Electronics (ICCE), Las Vegas,
   NV, JAN 10-12, 2021},
Abstract = {Electronic implementation of mathematical operations is very important
   and critical part of digital system. The major aspects that must be
   considered are quotient convergence rate, hardware primitives,
   overheads, and mathematical formulation. Many algorithms were
   implemented to achieve dividers, which provide inflexible solutions
   without any percentage of error. In actuality there exist many
   error-resilient applications where such types of dividers fail to work
   satisfactorily in terms of power consumption and overall circuit
   performance. This paper highlights the different estimation or
   prediction-based dividers. In this paper, we highlighted the key feature
   points of conversion for approximation and functional iteration class
   dividers.},
Type = {Proceedings Paper},
