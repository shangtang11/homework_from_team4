@article{ WOS:001712052200004,
Author = {George, Nishant and Gurumurthi, Sudhanva and Sridharan, Vilas and Dixit,
   Harish Dattatraya and Goksu, Emel and Parthasarathy, Bharath and
   Huffman, Amber and Macieira, Thiago and Sinha, Arani and Liberty, Dean
   and Minwell, Lisa and Chappell, Robert S.},
Title = {Silent Data Corruption in Artificial Intelligence: A Growing Challenge
   for Large-Scale Machine Learning},
Journal = {IEEE MICRO},
Year = {2026},
Volume = {46},
Number = {1},
Pages = {66-72},
Month = {JAN},
Abstract = {As artificial intelligence (AI) and machine learning scale to
   high-performance computing-class workloads, reliability and data
   integrity emerge as critical concerns. Silent data corruption (SDC), or
   hardware faults that escape detection, pose a hidden threat to training
   and inference. While neural networks can sometimes absorb small
   perturbations, faults in critical computations may derail convergence or
   bias results in ways that are difficult to diagnose. Traditional
   hardware reliability metrics rely on rates of device-level faults but do
   not align with AI correctness metrics like accuracy or loss, leaving a
   gap in understanding the true impact of hardware errors. At datacenter
   scale, even rare per device events accumulate into a meaningful risk
   that challenges detection and recovery. We review emerging strategies,
   including proactive screening, anomaly detection, redundancy, and
   algorithm-based fault tolerance, and call for open collaboration and
   standardized benchmarks to ensure resilient and trustworthy AI systems.},
