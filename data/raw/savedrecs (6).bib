DOI = {10.1109/TNS.2023.3242644},
Keywords = {1/f; border traps; carbon nanotube field-effect transistor (CNTFET);
   single-walled carbon nanotubes (SWC-NTs); LFN; percolation; total
   ionizing dose (TID)},
