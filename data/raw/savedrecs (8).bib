@inproceedings{ WOS:000869553400002,
Author = {Daghero, Francesco and Burrello, Alessio and Xie, Chen and Benini, Luca
   and Calimera, Andrea and Macii, Enrico and Poncino, Massimo and
   Pagliari, Daniele Jahier},
Editor = {Grimblatt, V and Chang, CH and Reis, R and Chattopadhyay, A and Calimera, A},
Title = {Low-Overhead Early-Stopping Policies for Efficient Random Forests
   Inference on Microcontrollers},
Booktitle = {VLSI-SOC: TECHNOLOGY ADVANCEMENT ON SOC DESIGN (VLSI-SOC 2021)},
Series = {IFIP Advances in Information and Communication Technology},
Year = {2022},
Volume = {661},
Pages = {25-47},
Note = {29th IFIP WG 10.5/IEEE International Conference on Very Large Scale
   Integration (VLSI-SoC), Singapore, SINGAPORE, OCT 04-08, 2021},
Abstract = {Random Forests (RFs) are popular Machine Learning models for edge
   computing, due to their lightweight nature and high accuracy on several
   common tasks. Large RFs however, still have significant energy costs, a
   serious concern for battery-operated ultra-low-power devices. Following
   the adaptive (or dynamic) inference paradigm, we introduce a
   hardware-friendly early stopping policy for RF-based classifiers,
   halting the execution as soon as a sufficient prediction confidence is
   achieved. We benchmark our approach on three state-of-the-art datasets
   relative to different embedded classification tasks, and deploy our
   models on a single core RISC-V microcontroller. We achieve an energy
   reduction ranging from 18\% to more than 91\%, with an accuracy drop
   lower than 0.5\%. Additionally, we compare our approach with other
   early-stopping policies, showing that we outperform them.},
Type = {Proceedings Paper},
Affiliation = {Daghero, F (Corresponding Author), Politecn Torino, Turin, Italy.
   Daghero, Francesco; Xie, Chen; Calimera, Andrea; Macii, Enrico; Poncino, Massimo; Pagliari, Daniele Jahier, Politecn Torino, Turin, Italy.
