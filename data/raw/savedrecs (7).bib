@inproceedings{ WOS:001133946600036,
Author = {Lopez-Villellas, Lorien and Pineda-Sanchez, Esteve and Badouh, Asaf and
   Marco-Sola, Santiago and Ibanez, Pablo and Alastruey-Benede, Jesus and
   Moreto, Miquel},
