@inproceedings{ WOS:000610549200085,
Author = {Bayerl, Sebastian P. and Frassetto, Tommaso and Jauernig, Patrick and
   Riedhammer, Korbinian and Sadeghi, Ahmad-Reza and Schneider, Thomas and
   Stapf, Emmanuel and Weinert, Christian},
Editor = {DiNatale, G and Bolchini, C and Vatajelu, EI},
Title = {OFFLINE MODEL GUARD: Secure and Private ML on Mobile Devices},
Booktitle = {PROCEEDINGS OF THE 2020 DESIGN, AUTOMATION \& TEST IN EUROPE CONFERENCE
   \& EXHIBITION (DATE 2020)},
Series = {Design Automation and Test in Europe Conference and Exhibition},
Year = {2020},
Pages = {460-465},
Note = {Design, Automation and Test in Europe Conference and Exhibition (DATE),
   Grenoble, FRANCE, MAR 09-13, 2020},
Abstract = {Performing machine learning tasks in mobile applications yields a
   challenging conflict of interest: highly sensitive client information
   (e.g., speech data) should remain private while also the intellectual
   property of service providers (e.g., model parameters) must be
   protected. Cryptographic techniques offer secure solutions for this, but
   have an unacceptable overhead and moreover require frequent network
   interaction.
   In this work, we design a practically efficient hardware-based solution.
   Specifically, we build OFFLINE MODEL GUARD (OMG) to enable
   privacy-preserving machine learning on the predominant mobile computing
   platform ARM-even in offline scenarios. By leveraging a trusted
   execution environment for strict hardware-enforced isolation from other
   system components, OMG guarantees privacy of client data, secrecy of
   provided models, and integrity of processing algorithms. Our prototype
   implementation on an ARM HiKey 960 development board performs
   privacy-preserving keyword recognition using TensorFlow Lite for
   Microcontrollers in real time.},
Type = {Proceedings Paper},
Affiliation = {Bayerl, SP (Corresponding Author), TH Nurnberg, Nurnberg, Germany.
   Bayerl, Sebastian P.; Riedhammer, Korbinian, TH Nurnberg, Nurnberg, Germany.
