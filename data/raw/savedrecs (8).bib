@article{ WOS:000771906800005,
Author = {Wei, Nan and Gao, Ningfei and Xu, Haitao and Liu, Zhen and Gao, Lei and
   Jiang, Haoxin and Tian, Yu and Chen, Yufeng and Du, Xiaodong and
   Lian-Mao Peng},
Title = {Wafer-scale fabrication of carbon-nanotube-based CMOS transistors and
   circuits with high thermal stability},
Journal = {NANO RESEARCH},
Year = {2022},
Volume = {15},
Number = {11, SI},
Pages = {9875-9880},
Month = {NOV},
Abstract = {Thanks to its single-atomic-layer structure, high carrier transport, and
   low power dissipation, carbon nanotube electronics is a leading
   candidate towards beyond-silicon technologies. Its low temperature
   fabrication processes enable three-dimensional (3D) integration with
   logic and memory (static random access memory (SRAM), magnetic random
   access memory (MRAM), resistive random access memory (RRAM), etc.) to
   realize efficient near-memory computing. Importantly, carbon nanotube
   transistors require good thermal stability up to 400 degrees C
   processing temperature to be compatible with back-end-of-line (BEOL)
   process, which has not been previously addressed. In this work, we
   developed a robust wafer-scale process to build complementary carbon
   nanotube transistors with high thermal stability and good uniformity,
   where AIN was employed as electrostatic doping layer. The gate stack and
   passivation layer were optimized to realize high-quality interfaces.
   Specifically, we demonstrate 1-bit carbon nanotube full adders working
   under 250 degrees C with rail-to-rail outputs.},
