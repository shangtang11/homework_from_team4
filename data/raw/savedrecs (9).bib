@article{ WOS:000648823700001,
Author = {Stojanovic, Igor and Jovanovic, Milica and Djosic, Sandra and
   Djordjevic, Goran Lj.},
Title = {Optimal port allocation scheme for deflection-routed networks-on-chip},
Journal = {JOURNAL OF SUPERCOMPUTING},
Year = {2021},
Volume = {77},
Number = {12},
Pages = {14161-14179},
Month = {DEC},
Abstract = {Deflection routing is considered a promising approach for improving the
   energy efficiency of networks-on-chip (NoCs) because of its hardware
   simplicity and minimal buffer requirements. The major weakness of the
   deflection routing is poor performance under high network load because
   of excessive flit deflections that occur in routers as a result of
   resolving frequent port conflicts. In this paper, we propose a design
   solution for optimal port allocation in permutation-network-based
   deflection NoC routers. The proposed solution requires 3.3x fewer
   hardware resources compared to a naive implementation of the optimal
   port allocation scheme while providing 38.6\% higher network throughput
   than a commonly used suboptimal port allocation scheme. We also present
   a novel low-cost suboptimal port allocator, which improves the network
   throughput by 17.4\% over the conventional port allocator with
   comparable hardware complexity.},
Type = {Article},
Affiliation = {Stojanovic, I (Corresponding Author), Univ Nis, Fac Elect Engn, Aleksandra Medvedeva 14, Nish 18000, Serbia.
