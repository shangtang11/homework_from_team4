@inproceedings{ WOS:001422954300003,
Author = {Quinlan, James and Omtzigt, E. Theodore L.},
Editor = {Michalewicz, M and Gustafson, S and DeSilva, H},
Title = {Iterative Refinement with Low-Precision Posit Arithmetic},
Booktitle = {NEXT GENERATION ARITHMETIC, CONGA 2024},
Series = {Lecture Notes in Computer Science},
Year = {2024},
Volume = {14666},
Pages = {74-90},
Note = {5th International Conference for Next Generation Arithmetic, Sydney,
   AUSTRALIA, FEB 20-21, 2024},
Abstract = {This study examines the mixed-precision iterative refinement technique
   using posit numbers instead of standard IEEE floating-point. The process
   is applied to a general linear system Ax = b where A is a large sparse
   matrix. Multiple scaling strategies, including row and column
   equilibration, scale matrix entries into higher-density regions of
   machine numbers before performing the O(n(3)) factorization operation.
   Low-precision LU factorization followed by forward/backward substitution
   yields an initial estimate. The residual r = b - Ax is computed to a
   higher precision with a deferred rounding mechanism, then used as the
   right-hand side in a new linear system Ac = r. The corrector c is
   calculated and used to refine the previous solution. Results show a
   16-bit posit configuration coupled with equilibration yields accuracy
   comparable to IEEE half-precision (fp16), showing potential for
   balancing efficiency and accuracy.},
Type = {Proceedings Paper},
Affiliation = {Quinlan, J (Corresponding Author), Univ Southern Maine, Portland, ME 04104 USA.
