@inproceedings{ WOS:000799181700015,
Author = {Hu, Guangyuan and He, Zecheng and Lee, Ruby B.},
Book-Group-Author = {IEEE},
Title = {SoK: Hardware Defenses Against Speculative Execution Attacks},
Booktitle = {2021 INTERNATIONAL SYMPOSIUM ON SECURE AND PRIVATE EXECUTION ENVIRONMENT
   DESIGN (SEED 2021)},
Year = {2021},
Pages = {108-120},
Note = {IEEE International Symposium on Secure and Private Execution Environment
   Design (SEED), ELECTR NETWORK, SEP 20-21, 2021},
Abstract = {Speculative execution attacks leverage the speculative and out-of-order
   execution features in modern computer processors to access secret data
   or execute code that should not be executed. Secret information can then
   be leaked through a covert channel. While software patches can be
   installed for mitigation on existing hardware, these solutions can incur
   big performance overhead. Hardware mitigation is being studied
   extensively by the computer architecture community. It has the benefit
   of preserving software compatibility and the potential for much smaller
   performance overhead than software solutions.
   This paper presents a systematization of the hardware defenses against
   speculative execution attacks that have been proposed. We show that
   speculative execution attacks consist of 6 critical attack steps. We
   propose defense strategies, each of which prevents a critical attack
   step from happening, thus preventing the attack from succeeding. We then
   summarize 20 hardware defenses and overhead-reducing features that have
   been proposed. We show that each defense proposed can be classified
   under one of our defense strategies, which also explains why it can
   thwart the attack from succeeding. We discuss the scope of the defenses,
   their performance overhead, and the security-performance trade-offs that
   can be made.},
