@article{ WOS:001605109900003,
Author = {El Bouayadi, O. and Chenouf, J. and Elhadfi, S. and Abdelkader, S. A. A.
   and Fakrach, B. and Rahmouni, A. and Rahmani, A. H.},
Title = {Raman spectroscopy of carbon nanotubes embedded in boron nitride
   nanotubes: Insights into the origin of the observed shifts},
Journal = {DIAMOND AND RELATED MATERIALS},
Year = {2025},
Volume = {160},
Month = {DEC},
Abstract = {With the significant advances recently achieved in the synthesis of the
   1D van der Waals heterostructures (1D vdWHTs) based on carbon nanotubes
   embedded by boron nitride nanotubes, Raman spectroscopy has emerged as
   an indispensable tool for their characterization. Although experimental
   data on these 1D vdWHTs have been reported over the past few years, a
   comprehensive theoretical description of the observed shifts is still
   lacking. Here we report a systematic computational investigation of the
   energetic stability, Raman spectra, and optoelectronic properties of
   such 1D vdWHTs. The energetic stability of a series of zigzag C(n,0)
   nanotubes embedded by BN(n,m) nanotubes is examined from the universal
   force field with included vdW interaction (UFF-vdW). We identify the
   optimal interwall spacing in which the resulting C(n,0)@BN(n,m) 1D
   vdWHTs are stable. Then, as a prototypical system of such 1D vdWHTs, we
   report the calculated Raman spectra of the stable C(8,0)@BN(17,0) 1D
   vdWHTs in the framework of the bond polarization theory, using the
   spectral moments method. The origin of the observed shifts is
   investigated as a function of the interwall spacing, and a deeper
   understanding of the interactions subsisting in these systems is
   achieved. Notably, the persistent unshifting of the tangential modes
   (TM) excludes any possible interwall charge-transfer effect, which is
   then supported by first-principles calculations of the electronic
   structure, while enhanced optical absorption is shown from the NIR up to
   the far-UV spectral regions.},
