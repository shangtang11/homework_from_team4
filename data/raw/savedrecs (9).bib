   Roscoe, A. W., Univ Oxford, Dept Comp Sci, Oxford, England.},
DOI = {10.1145/3474123.3486755},
Keywords = {SGX; enclave; orderliness; TEE; Trusted Execution Environment; symbolic
   execution; memory corruption},
