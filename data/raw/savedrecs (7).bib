@article{ WOS:000877295000020,
Author = {Fanti, Andrea and Perez, Carlos Chinea and Denis-Courmont, Remi and
   Roascio, Gianluca and Ekberg, Jan-Erik},
Title = {Toward Register Spilling Security Using LLVM and ARM Pointer
   Authentication},
Journal = {IEEE TRANSACTIONS ON COMPUTER-AIDED DESIGN OF INTEGRATED CIRCUITS AND
   SYSTEMS},
Year = {2022},
Volume = {41},
Number = {11},
Pages = {3757-3766},
Month = {NOV},
Note = {ACM/IEEE Int Conf on Hardware/Software Codesign and Syst Synthesis / Int
   Conf on Compilers, Architectures, and Synthesis for Embedded Syst / Int
   Conf on Embedded Software part of the Embedded Syst Week, ELECTR
   NETWORK, OCT 08-15, 2021},
Abstract = {Modern reduced instruction set computer processors are based on a
   load/store architecture, where all computations are performed on
   register operands. Compilers therefore allocate registers based on
   demand, and when occupancy is at maximum, register contents are spilled
   onto the stack and then retrieved later as data is needed. This
   phenomenon has security implications that cannot be ignored, as data on
   the stack is subject to well-known memory corruption attacks. Moreover,
   works presented so far are mainly targeting protection of pointers to
   code (e.g., return addresses), but are ineffective for protecting other
   context data in the stack. This article presents a security solution for
   spilled registers, generalizing the use of ARM pointer authentication
   (PA) for this purpose. The protection is enforced by the LLVM compiler
   via additional compiler passes and modifications. The solution provides
   guarantees for both integrity and confidentiality protection, and also
   addressing reuse attack problems associated with PA usage. Experimental
   data collected demonstrates the effectiveness of the solution against
   corruption and eavesdropping. We test our solution using SPEC CPU 2017,
   which confirms the functional viability of our solution. Additionally,
   we expose real-world performance overhead metrics of our protection
   design on a ARM-PA-enabled processor.},
Type = {Article; Proceedings Paper},
Affiliation = {Roascio, G (Corresponding Author), Politecn Torino, Dept Control \& Comp Engn, I-10129 Turin, Italy.
   Fanti, Andrea; Roascio, Gianluca, Politecn Torino, Dept Control \& Comp Engn, I-10129 Turin, Italy.
   Perez, Carlos Chinea; Denis-Courmont, Remi; Ekberg, Jan-Erik, Huawei Technol Oy Co Ltd, Dept Mobile Secur, FI-0620 Helsinki, Finland.
   Roascio, Gianluca, Cybersecur Natl Lab, CINI, I-00185 Rome, Italy.},
DOI = {10.1109/TCAD.2022.3197511},
Keywords = {Registers; Program processors; Codes; Resource management; Reduced
   instruction set computing; Authentication; Hardware; Compiler;
   control-flow integrity (CFI); memory safety; pointer authentication
   (PA); register spill; security; software security},
Author-Email = {andrea.fanti@studenti.polito.it
   carlos.chinea.perez@huawei.com
   remi.denis.courmont@huawei.com
   gian-luca.roascio@polito.it
   jan.erik.ekberg@huawei.com},
