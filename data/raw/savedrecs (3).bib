@inproceedings{ WOS:001476945200077,
Author = {Pan, Shangjie and Peng, Xuanyao and Man, Zeyuan and Zhao, Xiquan and
   Zhang, Dongrong and Yang, Bicheng and Du, Dong and Lu, Hang and Xia,
   Yubin and Li, Xiaowei},
Book-Group-Author = {ACM},
Title = {Dep-TEE: Decoupled Memory Protection for Secure and Scalable
   Inter-enclave Communication on RISC-V},
Booktitle = {30TH ASIA AND SOUTH PACIFIC DESIGN AUTOMATION CONFERENCE, ASP-DAC 2025},
Series = {Asia and South Pacific Design Automation Conference Proceedings},
Year = {2025},
Pages = {454-460},
Note = {30th Asia and South Pacific Design Automation Conference-ASP-DAC-Annual,
   ACM SIGDA, Tokyo, JAPAN, JAN 20-23, 2025},
Abstract = {Trusted Execution Environment (TEE) has been widely implemented by
   modern hardware vendors to protect security and privacy-sensitive
   applications and data, such as Intel SGX/TDX, ARM TrustZone, AMD SEV,
   and RISC-V Penglai. However, existing TEE systems face challenges in
   balancing memory isolation among security, performance, and scalability
   requirements. This paper introduces a novel TEE system, Dep-TEE, which
   decouples memory protection (to segments) from address translation (to
   page tables). This design improves communication performance by
   dynamically adjusting memory protection capabilities, without
   sacrificing application compatibility, and enhances security by
   safeguarding against attacks on page tables. We have built a prototype
   of Dep-TEE based on FPGA, incorporating hardware extensions and software
   support. The evaluation demonstrates that Dep-TEE significantly
   surpasses existing TEE solutions, achieving three orders of magnitude
   lower communication latency and 10x greater scalability while
   maintaining robust security guarantees.},
