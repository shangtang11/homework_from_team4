# 检索式配置文件 | RISC-V处理器设计相关研究
# 课程要求：所有参数变更必须记录，所有选择需具备可辩护理由
# 提交位置：config/query.yaml
---
# 1. 元数据
metadata:
  version: "v0.1"
  create_time: "2026-04-08"
  update_time: "2026-04-08"
  research_topic: "RISC-V指令集及核心的处理器设计、架构与实现研究，排除GPU、DSP领域"
  author: "课程项目组"

# 2. 基础检索字段配置（仅基于您提供的字段代码）
constraint:
  # 字段映射：您使用的ALL/TS字段适配主流学术数据库（Web of Science/Scopus）
  field_mapping:
    ALL: "All Fields（全字段检索）"
    TS: "Topic（主题字段：标题+摘要+关键词）"
  # 无额外时间窗、文献类型、语言限定（您的检索式未包含）

# 3. 检索式核心逻辑（严格对应您提供的三组术语，无增删）
query_logic:
  # 3.1 第一组：RISC-V及相关核心术语
  group_1:
    group_role: "研究对象"
    field_code: "ALL"
    terms:
      - "RISC-V"
      - "RISC V"
      - "RISC_V"
      - "RV32"
      - "RV32I"
      - "RV32M"
      - "RV32A"
      - "RV32F"
      - "RV32D"
      - "RV64"
      - "RV64I"
      - "RV64M"
      - "RV64A"
      - "RV64F"
      - "RV64D"
      - "RISC-V core"
      - "open source RISC-V"
      - "embedded RISC-V"
    operator: "OR"
    bracket_wrap: true

  # 3.2 第二组：处理器设计与架构相关术语
  group_2:
    group_role: "研究主题"
    field_code: "ALL"
    terms:
      - "CPU"
      - "processor"
      - "microprocessor"
      - "core"
      - "processor core"
      - "CPU core"
      - "design"
      - "architecture"
      - "implementation"
      - "microarchitecture"
      - "pipeline"
      - "branch prediction"
      - "cache"
      - "ISA"
      - "instruction set architecture"
      - "datapath"
      - "control unit"
    operator: "OR"
    bracket_wrap: true

  # 3.3 第三组：排除术语
  group_3:
    group_role: "排除条件"
    field_code: "TS"
    terms:
      - "GPU"
      - "graphics processing unit"
      - "DSP"
      - "digital signal processor"
    operator: "OR"
    bracket_wrap: true

  # 3.4 组间逻辑
  inter_group_logic: "group_1 AND group_2 NOT group_3"

# 4. 标准化完整布尔检索表达式（完全照搬您的内容，仅调整格式可读性）
full_boolean_expression: |
  ALL=("RISC-V" OR "RISC V" OR "RISC_V" OR RV32 OR RV32I OR RV32M OR RV32A OR RV32F OR RV32D OR RV64 OR RV64I OR RV64M OR RV64A OR RV64F OR RV64D OR "RISC-V core" OR "open source RISC-V" OR "embedded RISC-V")
  AND
  ALL=(CPU OR processor OR microprocessor OR core OR "processor core" OR "CPU core" OR design OR architecture OR implementation OR microarchitecture OR pipeline OR "branch prediction" OR cache OR ISA OR "instruction set architecture" OR datapath OR "control unit")
  NOT
  TS=(GPU OR "graphics processing unit" OR DSP OR "digital signal processor")

# 5. 变更日志（课程强制要求：版本化管理）
changelog:
  - version: "v0.1"
    date: "2026-04-08"
    change_content: "基于用户提供的检索式构建初始配置文件，完整保留三组术语、字段代码及组间逻辑，无额外增删"
    change_rationale: "严格匹配用户需求，仅做结构化整理，确保检索式内容100%还原"
    impact: "初始版本，无历史偏差"

# 6. 质量控制（QC）检查项（课程Checklist要求，仅针对您的检索式）
qc_checklist:
  bracket_priority_check: true
  or_scope_control_check: true
  not_miskill_risk_check: "待完成：抽样核对是否存在误杀相关文献风险"