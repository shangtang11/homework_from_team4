@inproceedings{ WOS:001253690000081,
Author = {Dai, Ruochen and Liu, Zhaoxiang and Arias, Orlando and Guo, Xiaolong and
   Yavuz, Tuba},
Book-Group-Author = {Assoc Computing Machinery},
Title = {DTjRTL: A Configurable Framework for Automated Hardware Trojan Insertion
   at RTL},
Booktitle = {PROCEEDING OF THE GREAT LAKES SYMPOSIUM ON VLSI 2024, GLSVLSI 2024},
Series = {Proceedings - Great Lakes Symposium on VLSI},
Year = {2024},
Pages = {465-470},
Note = {34th Great Lakes Symposium on VLSI (GLSVLSI), Clearwater, FL, JUN 12-14,
   2024},
Abstract = {Shifts in the IC supply chain have necessitated outsourcing design or
   fabrication to third-party vendors, introducing various hardware
   security issues, notably Hardware Trojans (HTs) as a prominent risk. The
   research in detecting and preventing HTs faces challenges due to the
   lack of standardized benchmarks and measurements. This paper introduces
   a framework to automatically generate dynamic functional HTs in a
   configurable and systematical manner at Register Transfer Level (RTL).
   The objective is not to produce HTs that are difficult to activate but
   to systematically create a diverse set of HT designs. This approach
   serves dual purposes: it aids the research community in testing their
   detection frameworks and facilitates buggy design benchmark creation for
   competitive exercises between blue and red teams. Our framework accepts
   RTL designs and configuration parameters, automating the generation of
   HT-inserted designs at RTL. We present an evaluation of the generated HT
   designs focusing on hardware cost overhead and post-synthesis
   survivability by verifying HT presence at both RT and gate levels.
   Results indicate that HTs employing only combinational logic are easier
   to optimize away but result in lower overhead compared to HTs that
   incorporate additional sequential logic.},
Type = {Proceedings Paper},
Affiliation = {Dai, RC (Corresponding Author), Univ Florida, Gainesville, FL 32611 USA.
