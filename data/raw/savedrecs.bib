@article{ WOS:001652143300012,
Author = {Agosta, Giovanni and Galimbertl, Andrea and Zoni, Davide},
Title = {Deep Learning on RISC-V Platforms at the Edge: A Perspective on the
   Hardware and Software Support},
Journal = {ACM COMPUTING SURVEYS},
Year = {2026},
Volume = {58},
Number = {5},
Month = {APR},
Abstract = {The growing demand for always-on intelligence in resource-constrained
   devices makes edge deployment of deep learning both a necessity and a
   challenge, requiring platforms that combine efficiency, scalability, and
   flexibility. RISC-V has emerged as the de facto standard architecture
   for modern computing platforms at the edge tasked with deep-learning
   workloads, a trend reinforced by the increasing availability of
   commercial solutions tailored for inference. This survey delivers a
   structured taxonomy of the hardware architectures for deep learning at
   the edge, classified according to how they process data in parallel,
   represent data, and optimize data movement and whether they implement an
   application-specific design, and of the supporting software tools,
   ranging from hardware-software co-design approaches to autotuning and
   compiler frameworks. Finally, it identifies a set of key findings and
   outlines the most promising directions for research in the field.},
Type = {Article},
Affiliation = {Galimbertl, A (Corresponding Author), Politecn Milan, Dipartimento Elettron Informaz \& Bioingn DEIB, Milan, Italy.
