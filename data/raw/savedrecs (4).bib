Book-Group-Author = {IEEE},
Title = {Special Session: SE-UVM, an Integrated Simulation Environment for Single
   Event Induced Failures Characterization and its Application to the
   CV32E40P Processor<bold> </bold>},
Booktitle = {2024 IEEE INTERNATIONAL SYMPOSIUM ON DEFECT AND FAULT TOLERANCE IN VLSI
