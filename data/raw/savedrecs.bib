@article{ WOS:001727215500025,
Author = {Yang, Yingqi and Guo, Linyuan and Ma, Liran},
Title = {Synthetic Aperture Sonar Compressive Sensing Imaging by Iterative
   Optimization Based on Ridge Regression},
Journal = {IEEE ACCESS},
Year = {2026},
Volume = {14},
Pages = {44233-44244},
Abstract = {Synthetic aperture sonar (SAS) imaging based on compressive sensing (CS)
   has shown strong potential for high-resolution reconstruction under
   sparse sampling conditions. However, many existing CS-based SAS imaging
   methods rely on convex optimization solvers or ADMM-type iterative
   schemes, which often suffer from high computational cost and limited
   robustness to motion-induced phase errors, especially in high-frequency
   SAS systems employing linear frequency modulated (LFM) signals. In this
   paper, an iterative CS imaging framework for SAS is proposed based on
   ridge regression-embedded optimization. By incorporating the
   regularization term directly into the gradient descent process, an
   explicit iterative update rule is derived, avoiding the need for
   auxiliary variables or complex solver structures. In addition, a
   dedicated signal processing strategy is developed for high-frequency LFM
   waveforms, which effectively mitigates motion-induced phase deviations
   and significantly enhances the robustness of CS-based reconstruction.
   Numerical simulations and experimental results obtained from a
   laboratory ultrasonic SAS testbed demonstrate that the proposed approach
   achieves improved reconstruction quality, faster convergence, and
   enhanced robustness to phase perturbations compared with conventional
   ADMM-based and convex optimization methods. These results indicate that
   the proposed method is well suited for practical SAS imaging
   applications requiring efficient and robust reconstruction.},
Type = {Article},
Affiliation = {Ma, LR (Corresponding Author), Tsinghua Univ, Dept Mech Engn, State Key Lab Tribol Adv Equipment, Beijing 100084, Peoples R China.
