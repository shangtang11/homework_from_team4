Title = {VisMorph: A Live Programming Environment for Shape-Adaptive Computers},
Booktitle = {ADJUNCT PROCEEDINGS OF THE 38TH ANNUAL ACM SYMPOSIUM ON USER INTERFACE
   SOFTWARE AND TECHNOLOGY, UIST 2025},
Year = {2025},
Note = {38th Symposium on User Interface Software and Technology-UIST-Annual,
   Busan, SOUTH KOREA, SEP 28-OCT 01, 2025},
Abstract = {We present VisMorph, a live programming environment for shape-adaptive
   computers-systems composed of microscopic units that wirelessly
   coordinate to change shape and function. VisMorph supports intuitive
   application development for such systems through real-time
   visualization, interactive feedback, and a declarative programming
   language called MorphLang. It allows users to define physical layouts,
   specify behaviors, and visualize communication on a 2D grid, making
   development more intuitive and efficient. VisMorph streamlines the
   process of programming dynamic, reconfigurable interfaces, enabling
   advanced workflows for shape-changing systems.},
