@article{ WOS:001711092600007,
Author = {Uslu, Ege Erberk and Ozturk, Bunyamin and Gorkemli, Burak and Soyturk,
   Mesut and Cihan, Salih Bilge and Gunduzhev, Aycan Ramazan and
   Dagdeviren, Orhan},
Title = {Next-Generation Management and Orchestration for 6G: Emerging Trends,
   Architectures, and Challenges},
Journal = {IEEE OPEN JOURNAL OF THE COMMUNICATIONS SOCIETY},
Year = {2026},
Volume = {7},
Pages = {2222-2269},
Abstract = {Traditional network management models are inadequate due to the
   increasing complexity of infrastructures and the growing complexity of
   user requirements, from ultra-low latency to massive device
   connectivity. As a result of the pursuit of sixth generation (6G) and
   beyond networks, the Management and Orchestration (MANO) of
   communication architectures requires a paradigm shift. To the best of
   our knowledge, a review covering the diverse challenges and open
   research issues in the area of MANO architectures for 6G and beyond
   networks is noticeably lacking. To fill this gap, we provide a
   comprehensive survey of the latest work on MANO frameworks that
   emphasizes the relationship between cloud-edge integration, terrestrial
   and non-terrestrial domains, and Artificial Intelligence (AI)-driven
   approaches. The paper highlights emerging innovations in distributed
   intelligence, zero-touch automation, and virtualization for dynamic
   resource and service orchestration. Moreover, key functional layers such
   as radio access networks, transport, core, and internet of things are
   examined in the paper to identify current issues such as scalability,
   security, and cross-domain interoperability. The transformative
   potential of AI/machine learning, digital twin technologies, and
   standards-based collaboration to meet the stringent requirements of MANO
   in future 6G systems is demonstrated in the findings. Therefore, this
   research provides new insights and a future research agenda for building
   robust, agile, and energy-efficient MANO design and implementation in
   next-generation networks.},
