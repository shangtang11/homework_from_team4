@inproceedings{ WOS:001540569200020,
Author = {Waucquez, Luis and Rodriguez, Alfonso},
Book-Group-Author = {ACM},
Title = {EROS: Extensible Reliable Offloading Solution},
Booktitle = {COMPANION PROCEEDINGS OF THE 22ND ACM INTERNATIONAL CONFERENCE ON
   COMPUTING FRONTIERS 2025 WORKSHOPS AND SPECIAL SESSIONS, CF2025},
Year = {2025},
Pages = {82-85},
Note = {22nd International Conference on Computing Frontiers-CF, Cagliari,
   ITALY, MAY 28-30, 2025},
Abstract = {The growing complexity of systems due to the more demanding computation
   algorithms linked with the shrinking technology trend makes systems more
   susceptible to perturbation. The necessity of placing some safety
   countermeasures in mixed-critical application areas to avoid possible
   fatal casualties and economic losses is a reality. The trade-offs and
   developments costs associated with these reliable measures could impact
   deeply in the performance, area overhead, power consumption and time
   development. This paper presents an open-source architectural template
   for processor-centric accelerator deployment in safety-critical
   applications. The template, based on a triple-core RISC-V skeleton,
   incorporates system-level reliability mechanisms to support run-time
   adaptivity by dynamically switching between different operation modes
   such as Single, Triple-Core LockStep (TCLS), Dual-Core LockStep (DCLS)
   or DCLS with classical staggering. In addition, the template supports
   the addition of domain-specific hardware-accelerated functionalities via
   custom ISA extensions (using a standard extension interface) or with
   loosely-coupled MMIO modules.},
Type = {Proceedings Paper},
Affiliation = {Waucquez, L (Corresponding Author), Univ Politecn Madrid, Ctr Elect Ind, Madrid, Spain.
   Waucquez, Luis; Rodriguez, Alfonso, Univ Politecn Madrid, Ctr Elect Ind, Madrid, Spain.},
