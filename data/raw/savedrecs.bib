@article{ WOS:001595912300001,
Author = {Almaraz Luengo, Elena},
Title = {Current tendencies in Free-Running Oscillators: a review},
Journal = {STATISTICS AND COMPUTING},
Year = {2025},
Volume = {35},
Number = {6},
Month = {OCT 19},
Abstract = {The use of random numbers, or at least sequences with particular
   stochastic properties, is crucial in several disciplines. The literature
   classifies these sequences into two main classes: true random numbers
   and pseudorandom numbers. The process of generating each category
   requires different methodologies adapted to their intrinsic properties.
   This study focuses on the generation of true random numbers,
   specifically by exploiting free-running oscillators as a source of
   entropy. A comprehensive analysis of different generation techniques is
   presented, with special emphasis on the validation and verification
   procedures used to assess the statistical robustness and
   unpredictability of the generated sequences.},
