Editor = {DiNatale, G and Bolchini, C and Vatajelu, EI},
Title = {An Event-Based System for Low-Power ECG QRS Complex Detection},
Booktitle = {PROCEEDINGS OF THE 2020 DESIGN, AUTOMATION \& TEST IN EUROPE CONFERENCE
   \& EXHIBITION (DATE 2020)},
Series = {Design Automation and Test in Europe Conference and Exhibition},
Year = {2020},
Pages = {258-263},
Note = {Design, Automation and Test in Europe Conference and Exhibition (DATE),
   Grenoble, FRANCE, MAR 09-13, 2020},
Abstract = {One of the greatest challenges in the design of modern wearable devices
   is energy efficiency. While data processing and communication have
   received a lot of attention from the industry and academia, leading to
   highly efficient micro-controllers and transmission devices, sensor data
   acquisition in medical devices is still based on a conservative paradigm
   that requires regular sampling at the Nyquist rate of the target signal.
   This requirement is usually excessive for sparse and highly
   non-stationary signals, leading to data overload and a waste of
   resources in the full processing pipeline. In this work, we propose a
   new system to create event-based heart-rate analysis devices, including
   a novel algorithm for QRS detection that is able to process
   electrocardiogram signals acquired irregularly and much below the
   theoretically-required Nyquist rate. This technique allows us to
   drastically reduce the average sampling frequency of the signal and,
   hence, the energy needed to process it and extract the relevant
   information. We implemented both the proposed event-based algorithm and
   a state-of-the-art version based on regular Nyquist rate based sampling
   on an ultra-low power hardware platform, and the experimental results
   show that the event-based version reduces the energy consumption in
   runtime up to 15.6 times, while the detection performance is maintained
   at an average F1 score of 99.5\%.},
Type = {Proceedings Paper},
Affiliation = {Zanoli, S (Corresponding Author), Ecole Polytech Fed Lausanne, Embedded Syst Lab ESL, Lausanne, Switzerland.
