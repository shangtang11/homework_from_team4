@article{ WOS:001470409900002,
Author = {Simon, William Andrew and Boybat, Irem and Kodra, Riselda and Ferro,
   Elena and Singh, Gagandeep and Alser, Mohammed and Jain, Shubham and
   Tsai, Hsinyu and Burr, Geoffrey W. and Mutlu, Onur and Sebastian, Abu},
Title = {CiMBA: Accelerating Genome Sequencing Through On-Device Basecalling via
   Compute-in-Memory},
Journal = {IEEE TRANSACTIONS ON PARALLEL AND DISTRIBUTED SYSTEMS},
Year = {2025},
Volume = {36},
Number = {6},
Pages = {1130-1145},
Month = {JUN},
Abstract = {As genome sequencing is finding utility in a wide variety of domains
   beyond the confines of traditional medical settings, its computational
   pipeline faces two significant challenges. First, the creation of up to
   0.5 GB of data per minute imposes substantial communication and storage
   overheads. Second, the sequencing pipeline is bottlenecked at the
   basecalling step, consuming >40\% of genome analysis time. A range of
   proposals have attempted to address these challenges, with limited
   success. We propose to address these challenges with a Compute-in-Memory
   Basecalling Accelerator (CiMBA), the first embedded (similar to 25
   mm(2)) accelerator capable of real-time, on-device basecalling, coupled
   with AnaLog (AL)-Dorado, a new family of analog focused basecalling
   DNNs. Our resulting hardware/software co-design greatly reduces data
   communication overhead, is capable of a throughput of 4.77 million bases
   per second, 24x that required for real-time operation, and achieves 17 x
   /27x power/area efficiency over the best prior basecalling embedded
   accelerator while maintaining a high accuracy comparable to
   state-of-the-art software basecallers.},
Type = {Article},
Affiliation = {Simon, WA (Corresponding Author), Int Business Machines IBM, CH-8803 Ruschlikon, Switzerland.
   Simon, William Andrew; Boybat, Irem; Kodra, Riselda; Ferro, Elena; Sebastian, Abu, Int Business Machines IBM, CH-8803 Ruschlikon, Switzerland.
   Kodra, Riselda, Swiss Fed Inst Technol, CH-1015 Lausanne, Switzerland.
   Singh, Gagandeep, Adv Micro Devices AMD, Santa Clara, CA 95054 USA.
   Alser, Mohammed, Georgia State Univ, Atlanta, GA 30302 USA.
   Jain, Shubham, Int Business Machines IBM, Yorktown Hts, NY 10598 USA.
   Tsai, Hsinyu; Burr, Geoffrey W., Int Business Machines IBM Almaden, San Jose, CA 95120 USA.
   Mutlu, Onur, Swiss Fed Inst Technol, CH-8092 Zurich, Switzerland.},
DOI = {10.1109/TPDS.2025.3550811},
Keywords = {Sequential analysis; Accuracy; Genomics; Bioinformatics; Real-time
   systems; Decoding; Pipelines; Graphics processing units; Computer
   architecture; Nonvolatile memory; Genome sequencing; analog in-memory
   computing; edge computing},
Keywords-Plus = {REAL-TIME},
Author-Email = {william.simon1@ibm.com},
Affiliations = {Swiss Federal Institutes of Technology Domain; Ecole Polytechnique
