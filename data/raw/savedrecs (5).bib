@inproceedings{ WOS:001268541102082,
Author = {Thai-Ha Tran and Van-Phuc Hoang and Duc-Hung Le and Trong-Thuc Hoang and
   Cong-Kha Pham},
Book-Group-Author = {IEEE},
Title = {An Efficient Hiding Countermeasure with Xilinx MMCM Primitive in Spread
   Mode},
