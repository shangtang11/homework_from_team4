DOI = {10.1109/TCAD.2023.3248500},
Keywords = {Task analysis; Schedules; Jitter; Computer architecture; System-on-chip;
   Scheduling algorithms; Switches; Co-scheduling; deterministic chip
   (DetChip); embedded end-system; mixed-criticality tasks; time-sensitive
   networking (TSN)},
