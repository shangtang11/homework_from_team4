@article{ WOS:001558697400002,
Author = {Huang, Shansong and Raad, Raad and Tubbal, Faisel and Odeh, Nidhal},
Title = {An ARP-integrated enhancement of AODV for wormhole attack detection in
   mobile ad hoc networks},
Journal = {JOURNAL OF NETWORK AND COMPUTER APPLICATIONS},
Year = {2025},
Volume = {243},
Month = {NOV},
Abstract = {Wireless sensor networks are increasingly vulnerable to sophisticated
   security threats, among which wormhole attacks are particularly severe
   due to their ability to disrupt routing and compromise data integrity.
   This paper presents a lightweight wormhole detection algorithm using the
   Address Resolution Protocol (ARP) in mobile networks employing the Ad
   hoc On-Demand Distance Vector (AODV) routing protocol. Compared with
   existing solutions, the proposed method operates without additional
   hardware or software and minimizes computational complexity, making it
   suitable for resource constrained environments. Simulation results
   confirm its effectiveness, demonstrating a high detection rate under
   various network conditions.},
