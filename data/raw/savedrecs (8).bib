@inproceedings{ WOS:000852702500051,
Author = {Hua, Weizhe and Umar, Muhammad and Zhang, Zhiru and Suh, G. Edward},
Book-Group-Author = {ACM},
Title = {MGX: Near-Zero Overhead Memory Protection for Data-Intensive
   Accelerators},
Booktitle = {PROCEEDINGS OF THE 2022 THE 49TH ANNUAL INTERNATIONAL SYMPOSIUM ON
   COMPUTER ARCHITECTURE (ISCA `22)},
Series = {Conference Proceedings Annual International Symposium on Computer
   Architecture},
Year = {2022},
Pages = {726-741},
Note = {49th IEEE/ACM Annual International Symposium on Computer Architecture
   (ISCA), New York, NY, JUN 18-22, 2022},
Abstract = {This paper introduces MGX, a near-zero overhead memory protection scheme
   for hardware accelerators. MGX minimizes the performance overhead of
   off-chip memory encryption and integrity verification by exploiting the
   application-specific properties of the accelerator execution. In
   particular, accelerators tend to explicitly manage data movement between
   on-chip and off-chip memories. Therefore, the general memory access
   pattern of an accelerator can largely be determined for a given
   application. Exploiting these characteristics, MGX generates version
   numbers used in memory encryption and integrity verification using
   on-chip accelerator state rather than storing them in the off-chip
   memory; it also customizes the granularity of the memory protection to
   match the granularity used by the accelerator. To demonstrate the
   efficacy of MGX, we present an in-depth study of MGX for DNN and graph
   algorithms. Experimental results show that on average, MGX lowers the
   performance overhead of memory protection from 28\% and 33\% to 4\% and
   5\% for DNN and graph processing accelerators in a wide range of
   benchmarks, respectively.},
Type = {Proceedings Paper},
Affiliation = {Suh, GE (Corresponding Author), Cornell Univ, Ithaca, NY 14850 USA.
   Suh, GE (Corresponding Author), Meta AI, Cambridge, MA USA.
   Hua, Weizhe; Umar, Muhammad; Zhang, Zhiru; Suh, G. Edward, Cornell Univ, Ithaca, NY 14850 USA.
   Suh, G. Edward, Meta AI, Cambridge, MA USA.},
DOI = {10.1145/3470496.3527418},
Keywords = {Off-chip memory protection; version number generation; secure
   accelerators; neural networks; graph algorithms},
