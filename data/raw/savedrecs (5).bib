@inproceedings{ WOS:001214074700001,
Author = {Marotta, Amelie and Lashermes, Ronan and Bouffard, Guillaume and
   Sentieys, Olivier and Dafali, Rachid},
Editor = {Wacquez, R and Homma, N},
Title = {Characterizing and Modeling Synchronous Clock-Glitch Fault Injection},
Booktitle = {CONSTRUCTIVE SIDE-CHANNEL ANALYSIS AND SECURE DESIGN, COSADE 2024},
Series = {Lecture Notes in Computer Science},
Year = {2024},
Volume = {14595},
Pages = {3-21},
Note = {15th International Workshop on Constructive Side-Channel Analysis and
   Secure Design (COSADE), Ctr Microelectron, Gardanne, FRANCE, APR 09-10,
   2024},
Abstract = {In the realm of fault injection (FI), electromagnetic fault injection
   (EMFI) attacks have garnered significant attention, particularly for
   their effectiveness against embedded systems with minimal setup. These
   attacks exploit vulnerabilities with ease, underscoring the importance
   of comprehensively understanding EMFI. Recent studies have highlighted
   the impact of EMFI on phase-locked loops (PLLs), uncovering specific
   clock glitches that induce faults. However, these studies lack a
   detailed explanation of how these glitches translate into a specific
   fault model. Addressing this gap, our research investigates the physical
   fault model of synchronous clock glitches (SCGs), a clock glitch
   injection mechanism likely to arise from EMFI interactions within the
   clock network. Through an integrated approach combining experimental and
   simulation techniques, we critically analyze the adequacy of existing
   fault models, such as the Timing Fault Model and the Sampling Fault
   Model, in explaining SCGs. Our findings reveal specific failure modes in
   D flip-flops (DFFs), contributing to a deeper understanding of EMFI
   effects and aiding in the development of more robust defensive
   strategies against such attacks.},
Type = {Proceedings Paper},
Affiliation = {Marotta, A (Corresponding Author), Univ Rennes, INRIA, Rennes, France.
   Marotta, Amelie; Lashermes, Ronan; Sentieys, Olivier, Univ Rennes, INRIA, Rennes, France.
   Bouffard, Guillaume, Natl Cybersecur Agcy France ANSSI, Paris, France.
   Dafali, Rachid, DGA MI, Bruz, France.},
DOI = {10.1007/978-3-031-57543-3\_1},
