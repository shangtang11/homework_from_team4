@article{ WOS:001464383700001,
Author = {Rajan, J. Gopika and Ganesh, R. S.},
Title = {Dynamic pixel shuffling and hash LSB steganography with RC4 encryption:
   A robust data security framework},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2025},
Volume = {279},
Month = {JUN 15},
Abstract = {The most prominent challenge through local networks and the internet is
   information security. Steganography and cryptography can be used
   together to provide better data security and secrecy during
   transmission. Encrypted data is used for embedding into image using
   steganography for better data security. To guarantee encryption, the RC4
   and pixel shuffling are incorporated followed by data hiding using the
   Hash Least Significant Bit (HLSB), which is a substantial method to
   insert data present in the LSB bits. In addition, this approach
   incorporates the innovative use of the Cheetah Optimizer, inspired by
   the hunting behavior of cheetahs, to dynamically select optimal
   shuffling factors during the encryption process. This dynamic shuffling
   adds an extra layer of security, making it more formidable for potential
   attackers to uncover hidden data. The Peak Signal to Noise Ratio (PSNR)
   and Mean Square Error (MSE) calculations are used to measure the quality
   of security. The peak value of PSNR is found to be 61.67 dB and the
   lowest MSE is 0.0441. The value of Structural Similarity Index Measure
   (SSIM) is obtained as 0.9999. Compared with existing methodologies this
   proposed technique provides promising results.},
Type = {Article},
