@article{ WOS:000687133800022,
Author = {Pickard, Mitchell and Hutton, Graham},
Title = {Calculating Dependently-Typed Compilers (Functional Pearl)},
Journal = {PROCEEDINGS OF THE ACM ON PROGRAMMING LANGUAGES-PACMPL},
Year = {2021},
Volume = {5},
Month = {AUG},
Abstract = {Compilers are difficult to write, and difficult to get right. Bahr and
   Hutton recently developed a new technique for calculating compilers
   directly from specifications of their correctness, which ensures that
   the resulting compilers are correct-by-construction. To date, however,
   this technique has only been applicable to source languages that are
   untyped. In this article, we show that moving to a dependently-typed
   setting allows us to naturally support typed source languages, ensure
   that all compilation components are type-safe, and make the resulting
   calculations easier to mechanically check using a proof assistant.},
