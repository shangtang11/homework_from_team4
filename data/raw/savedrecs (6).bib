@inproceedings{ WOS:001050763800048,
Author = {Boni, Andrea and Caselli, Michele and Frattini, Francesco and Malena,
   Francesco and Ronchi, Marco},
Book-Group-Author = {IEEE},
Title = {Analog Baseband Circuits for Low-power 802-11ba Wake-up Radio in 40-nm
   CMOS},
Booktitle = {2023 21ST IEEE INTERREGIONAL NEWCAS CONFERENCE, NEWCAS},
Series = {IEEE International New Circuits and Systems Conference},
Year = {2023},
Note = {21st IEEE Interregional NEWCAS Conference (NEWCAS), Edinburgh, SCOTLAND,
   JUN 26-28, 2023},
Abstract = {The paper describes the analog baseband circuits for 802.11ba-compliant
   wake-up radios. A four-stage variable-ain amplifier provides up to 64-dB
   signal amplification, with a foreground offset cancellation, and it
   implements the anti-aliasing bandwidth limiting. A low-power Successive
   Approximation-Register A/D converter is used for the input signal
