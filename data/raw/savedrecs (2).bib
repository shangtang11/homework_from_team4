@inproceedings{ WOS:001710575400049,
Author = {Asuai, Chukwunalu and Ponugoti, Kushal K.},
Book-Group-Author = {IEEE},
Title = {Formal Verification of LSQ-LFENCE for Memory Ordering and Security
   Assurance},
Booktitle = {2025 IEEE INTERNATIONAL CARNAHAN CONFERENCE ON SECURITY TECHNOLOGY,
   ICCST},
Year = {2025},
Note = {2025 International Carnahan Conference on Security
   Technology-ICCST-Annual, San Antonio, TX, OCT 13-17, 2025},
Abstract = {Speculative execution can violate memory ordering guarantees, exposing
   systems to critical security vulnerabilities such as Spectre, Meltdown
   and their variants. LSQ-LFENCE (lfence) has been proposed as a
   software-level mitigation, where lfence instructions are inserted to
   enforce strict load ordering. However, the effectiveness of this
   approach depends heavily on correct hardware handling of lfence, making
   its implementation a prime target for bugs and Trojans. In this work, we
   propose a formal property that specifies the correct behavior of lfence
   within a Load-Store Queue (LSQ) in an out-of-order processor. These
   properties ensure that memory ordering constraints are enforced and that
   speculative execution does not bypass security boundaries. We
   demonstrate the effectiveness of our methodology by formally verifying a
   hardware implementation of lfence using Cadence JasperGold, an
   industry-standard formal verification tool.},
Type = {Proceedings Paper},
Affiliation = {Asuai, C (Corresponding Author), North Dakota State Univ, Dept Elect \& Comp Engn, Fargo, ND 58105 USA.
   Asuai, Chukwunalu; Ponugoti, Kushal K., North Dakota State Univ, Dept Elect \& Comp Engn, Fargo, ND 58105 USA.},
