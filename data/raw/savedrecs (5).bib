@inproceedings{ WOS:001414927800031,
Author = {Sajan, Christie Sajitha and Martin, Kevin J. M. and Das, Satyajit and
   Coussy, Philippe},
Editor = {Kryjak, T and Petrot, F},
Title = {SplitMS: Split Modulo-Scheduling for Accelerating Loops onto CGRAs},
Booktitle = {2024 27TH EUROMICRO CONFERENCE ON DIGITAL SYSTEM DESIGN, DSD 2024},
Series = {Euromicro Symposium on Digital System Design},
Year = {2024},
Pages = {242-249},
Note = {27th Euromicro Conference on Digital System Design, FRANCE, AUG 28-30,
   2024},
Abstract = {Coarse-Grained Reconfigurable Array (CGRA) architectures are popular for
   accelerating loop kernels due to a good balance between energy
   efficiency and flexibility. Modulo scheduling (MS) is the preferred
   solution for efficiently mapping loops onto CGRAs. Existing CGRA MS
   algorithms suffer from low resource utilization if the number of
   operation nodes in the Data Flow Graph (DFG) is less than the number of
   Processing Elements (PEs) in the CGRA. To improve instruction level
   parallelism (ILP), the common approaches unroll the loop before applying
   MS. However, finding valid MS solutions for larger DFGs becomes
   difficult for CGRAs with resource constraints. This paper proposes a
   novel Split Modulo-Scheduling (SplitMS) technique to improve the ILP by
   segmenting the target CGRA into clusters and mapping loop chunks. We
   also present a lightweight hardware approach to support the cluster
   execution. Experiments show that SplitMS for a 4x{[}2x2] CGRA cluster
   achieves an average speedup of 2.8x over MS for a 4x4 target CGRA with 8
   Load-Store Units (LSUs). SplitMS increases an average of 2.9x the PE
   utilization and 3x the energy efficiency over the conventional MS
   approach.},
Type = {Proceedings Paper},
Affiliation = {Sajan, CS (Corresponding Author), Univ Bretagne Sud, CNRS, UMR 6285, Lab STICC, Lorient, France.
   Sajan, CS (Corresponding Author), IIT Palakkad, Kanjikode, India.
