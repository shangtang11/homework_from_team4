@inproceedings{ WOS:001448004400003,
Author = {Nikiema, Pegdwende Romaric and Traiola, Marcello and Kritikakou,
   Angeliki},
Book-Group-Author = {IEEE},
Title = {Special Session: Impact of Compiler Optimizations on the Reliability of
   a RISC-V-based Core<bold> </bold>},
Booktitle = {2024 IEEE INTERNATIONAL SYMPOSIUM ON DEFECT AND FAULT TOLERANCE IN VLSI
