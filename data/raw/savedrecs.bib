@article{ WOS:001635744900002,
Author = {Wu, Kun and Dong, Yuhan and Yu, Xinchun and Song, Jian and Zhang,
   Xiao-Ping},
Title = {Relay-Aided Physical Layer Security in Multi-Eavesdropper VLC via
   Optimization of Beamforming Vector and Spatial Position},
Journal = {IEEE WIRELESS COMMUNICATIONS LETTERS},
Year = {2025},
Volume = {14},
Number = {12},
Pages = {4107-4111},
Month = {DEC},
Abstract = {We propose a novel relay-aided physical layer security scheme for
   multi-eavesdropper visible light communication. When eavesdroppers
   outnumber relays, we strategically position relays to prioritize
   blocking line-of-sight (LoS) paths from the light source to the subset
   of eavesdroppers with stronger interception capabilities, ingeniously
   transforming potential limitations of obstacles into security
   advantages. Subsequently, relays are designed to broadcast jamming
   signals, with beamforming vector optimized to minimize the sum
   signal-to-interference-plus-noise-ratio at remaining eavesdroppers.
   Conversely, we solely determine relay placement to obstruct all LoS
   paths from the light source to eavesdroppers. Numerical results
   demonstrate that our scheme significantly outperforms traditional
   schemes in security capacity.},
Type = {Article},
