@inproceedings{ WOS:001600382900004,
Author = {Rani, Rupa and Kumar, Pawan and Chakraborty, Sudeshna},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Enhanced Clone Attack Detection in Media Networks: Leveraging
   Multiperceptron Neural Networks with XGBoost},
Booktitle = {2025 SEVENTH INTERNATIONAL CONFERENCE ON COMPUTATIONAL INTELLIGENCE AND
   COMMUNICATION TECHNOLOGIES, CCICT},
Year = {2025},
Pages = {22-27},
Note = {7th International Conference on Computational Intelligence and
   Communication Technologies-CCICT, INDIA, APR 11-12, 2025},
Abstract = {The rise of social media platforms and other media networks has
   facilitated the sharing and dissemination of information on a global
   scale. But this massive accessibility has additionally unfolded new
   vulnerabilities for malicious actors to make the most of, mainly through
   the usage of clone assaults. These assaults involve the advent of faux
   bills or identities to govern and impact the facts being shared inside
   media networks. Because clone assaults are constantly developing,
   standard detection approaches have not been able to adequately discover
   and counteract them in response to this hazard. The proposed approach is
   an improved Clone attack Detection device that uses Mult Perceptron
   Neural Networks (MPNN) with a Boost set of rules to handle this
   endeavor. The proposed system employs a real-time gadget-studying
   approach along with artificial intelligence to detect and avert clone
   assaults. The MPNN is a type of neural network that is ideal for
   evaluating the large amount of temporal data seen in media network
   sports since it is specifically made for sequential facts processing.
   Additionally, the MPNN's performance is improved by using the Boost set
   of rules to sharpen its prediction abilities. To improve its accuracy
   and dependability, our improved clone attack detection device has been
   trained on a sizable dataset of verified clone attacks and everyday
   operations.},
