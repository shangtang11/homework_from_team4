@inproceedings{ WOS:000999132100017,
Author = {Wehrheim, Heike and Bargmann, Lara and Dongol, Brijesh},
Editor = {Katoen, JP and Chechik, M and Leucker, M},
Title = {Reasoning About Promises in Weak Memory Models with Event Structures},
Booktitle = {FORMAL METHODS, FM 2023},
Series = {Lecture Notes in Computer Science},
Year = {2023},
Volume = {14000},
Pages = {282-300},
Note = {25th International Symposium on Formal Methods (FM), Univ Lubeck,
   Lubeck, GERMANY, MAR 06-10, 2023},
Abstract = {Modern processors such as ARMv8 and RISC-V allow executions in which
   independent instructions within a process may be reordered. To cope with
   such phenomena, so called promising semantics have been developed, which
   permit threads to read values that have not yet been written. Each
   promise is a speculative update that is later validated (fulfilled) by
   an actual write. Promising semantics are operational, providing a
   pathway for developing proof calculi. In this paper, we develop an
   incorrectness-style logic, resulting in a framework for reasoning about
   state reachability. Like incorrectness logic, our assertions are
   underapproximating, since the set of all valid promises are not known at
   the start of execution. Our logic uses event structures as assertions to
   compactly represent the ordering among events such as promised and
   fulfilled writes. We prove soundness and completeness of our proof
   calculus and demonstrate its applicability by proving reachability
   properties of standard weak memory litmus tests.},
Type = {Proceedings Paper},
Affiliation = {Dongol, B (Corresponding Author), Univ Surrey, Guildford, Surrey, England.
   Wehrheim, Heike; Bargmann, Lara, Carl von Ossietzky Univ Oldenburg, Oldenburg, Germany.
   Dongol, Brijesh, Univ Surrey, Guildford, Surrey, England.},
DOI = {10.1007/978-3-031-27481-7\_17},
Keywords = {Weak memory models; Promises; Event structures; Incorrectness logic},
