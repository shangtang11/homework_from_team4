@inproceedings{ WOS:001705131500037,
Author = {Ursul, Ivan},
Editor = {Yang, XS and Sherratt, RS and Dey, N},
Title = {Real-Time Fall Detection with Transformers on a Customized System on
   Chip for High-speed Efficiency},
Booktitle = {PROCEEDINGS OF TENTH INTERNATIONAL CONGRESS ON INFORMATION AND
   COMMUNICATION TECHNOLOGY, ICICT 2025, VOL 3},
