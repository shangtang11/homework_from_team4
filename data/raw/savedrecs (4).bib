@article{ WOS:001266668800043,
Author = {Dang, Tuan-Kiet and Nguyen, Khai-Duy and Pham, Cong-Kha and Hoang,
   Trong-Thuc},
Title = {Accumulator-Based 16-Bit Processor for Wireless Sensor Nodes},
Journal = {IEEE TRANSACTIONS ON CIRCUITS AND SYSTEMS II-EXPRESS BRIEFS},
Year = {2024},
