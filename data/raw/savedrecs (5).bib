@inproceedings{ WOS:001447271200355,
Author = {Hu, Yinghua and Cherupalli, Hari and Borza, Mike and Sherlekar, Deepak},
Book-Group-Author = {ACM},
Title = {Late Breaking Results: On the One-Key Premise of Logic Locking},
Booktitle = {PROCEEDINGS OF THE 61ST ACM/IEEE DESIGN AUTOMATION CONFERENCE, DAC 2024},
Year = {2024},
Note = {61st Design Automation Conference, San Francisco, CA, JUN 23-27, 2024},
Abstract = {The evaluation of logic locking methods has long been predicated on an
   implicit assumption that only the correct key can unveil the true
   functionality of a protected circuit. Consequently, a locking technique
   is deemed secure if it resists a good array of attacks aimed at finding
   this correct key. This paper challenges this one-key premise by
   introducing a more efficient attack methodology, focused not on
   identifying that one correct key, but on finding multiple, potentially
   incorrect keys that can collectively produce correct functionality from
   the protected circuit. The tasks of finding these keys can be
   parallelized, which is well suited for multi-core computing
   environments. Empirical results show our attack achieves a runtime
   reduction of up to 99.6\% compared to the conventional attack that tries
   to find a single correct key.},
Type = {Proceedings Paper},
Affiliation = {Hu, YH (Corresponding Author), Synopsys Inc, Sunnyvale, CA 94085 USA.
   Hu, Yinghua; Cherupalli, Hari; Borza, Mike; Sherlekar, Deepak, Synopsys Inc, Sunnyvale, CA 94085 USA.},
