@article{ WOS:001626762700001,
Author = {Mareta, Rella and Satriawan, Ardianto and Lee, Hanho},
Title = {High Throughput Arithmetic Computing Unit for BFV Homomorphic Encryption},
Journal = {IEEE OPEN JOURNAL OF CIRCUITS AND SYSTEMS},
Year = {2025},
Volume = {6},
Pages = {457-466},
Abstract = {Homomorphic Encryption (HE) enables secure computations on encrypted
   data, which is<br /> crucial for cloud and edge computing. The BFV
   scheme, widely used for integer arithmetic, faces performance
   bottlenecks in polynomial multiplication, especially in tensor
   operations. The Residue Number System (RNS) helps address this, leading
   to the BEHZ and HPS BFV variants. The Halevi-Polyakov-Shoup (HPS)
   variant simplifies implementation but still struggles with the overhead
   of modular arithmetic. We propose an Arithmetic Computing Unit (ACU)
   optimized for key BFV operations, including modular addition,
   multiplication, NTT/INTT, and MAC to improve efficiency. Implemented on
   a Xilinx Alveo U250 FPGA, our design achieves up to 2.3x higher
   throughput, 2.2x less latency, and 9.4x better BRAM efficiency than
   existing solutions, demonstrating FPGA acceleration's for homomorphic
   encryption.},
Type = {Article},
Affiliation = {Lee, H (Corresponding Author), Inha Univ, Dept Elect \& Comp Engn, Incheon 22212, South Korea.
   Mareta, Rella; Satriawan, Ardianto; Lee, Hanho, Inha Univ, Dept Elect \& Comp Engn, Incheon 22212, South Korea.},
DOI = {10.1109/OJCAS.2025.3581188},
Keywords = {Tensors; Memory management; Computer architecture; Transforms;
   Throughput; Polynomials; Table lookup; Homomorphic encryption; Field
   programmable gate arrays; Arithmetic; BFV; HPS; number-theoretic
   transform},
