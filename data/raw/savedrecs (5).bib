@inproceedings{ WOS:001279248600039,
Author = {Mittone, Gianluca and Birke, Robert and Aldinucci, Marco},
Editor = {Zeinalipour, D and Heras, DB and Pallis, G and Herodotou, H and Trihinas, D and Balouek, D and Diehl, P and Cojean, T and Furlinger, K and Kirkeby, MH and Nardelli, M and DiSanzo, P},
Title = {Efficiently Distributed Federated Learning},
Booktitle = {EURO-PAR 2023: PARALLEL PROCESSING WORKSHOPS, PT II, EURO-PAR 2023},
Series = {Lecture Notes in Computer Science},
Year = {2024},
Volume = {14352},
