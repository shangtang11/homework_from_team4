@article{ WOS:001618761200009,
Author = {Alijani, Morteza and Joseph, Wout and Plets, David},
Title = {Unmodulated Visible-Light Positioning: A Deep-Dive Into Techniques,
   Studies, and Future Prospects},
Journal = {IEEE OPEN JOURNAL OF THE COMMUNICATIONS SOCIETY},
Year = {2025},
Volume = {6},
Pages = {9448-9485},
Abstract = {Visible Light Positioning (VLP) has emerged as a promising technology
   for next-generation indoor positioning systems (IPS), particularly
   within the scope of sixth-generation (6G) wireless networks. Its
   attractiveness stems from leveraging existing lighting infrastructures
   equipped with light-emitting diodes (LEDs), enabling cost-efficient
   deployments and achieving high-precision positioning accuracy in the
   centimeter-to-decimeter range. However, widespread adoption of
   traditional VLP solutions faces significant barriers due to the
   increased costs and operational complexity associated with modulating
   LEDs, which consequently reduces illumination efficiency by lowering
   their radiant flux. To address these limitations, recent research has
   introduced the concept of unmodulated Visible Light Positioning (uVLP),
   which exploits Light Signals of Opportunity (LSOOP) emitted by
   unmodulated illumination sources such as conventional LEDs. This
   paradigm offers a cost-effective, low-infrastructure alternative for
   indoor positioning by eliminating the need for modulation hardware and
   maintaining lighting efficiency. This paper delineates the fundamental
   principles of uVLP, provides a comparative analysis of uVLP versus
   conventional VLP methods, and classifies existing uVLP techniques
   according to receiver technologies into intensity-based methods (e.g.,
   photodiodes, solar cells, etc.) and imaging-based methods. Additionally,
   we propose a comprehensive taxonomy categorizing techniques into
   demultiplexed and undemultiplexed approaches. Within this structured
   framework, we critically review current advancements in uVLP, discuss
   prevailing challenges, and outline promising research directions
   essential for developing robust, scalable, and widely deployable uVLP
   solutions.},
Type = {Article},
Affiliation = {Alijani, M (Corresponding Author), Univ Ghent, Dept Informat Technol INTEC, IMEC,WAVES, B-9052 Ghent, Belgium.
   Alijani, Morteza; Joseph, Wout; Plets, David, Univ Ghent, Dept Informat Technol INTEC, IMEC,WAVES, B-9052 Ghent, Belgium.},
DOI = {10.1109/OJCOMS.2025.3628482},
Keywords = {Visible light positioning (VLP); unmodulated light; unmodulated light;
   indoor positioning systems (IPS); indoor positioning systems (IPS);
   indoor positioning systems (IPS)},
