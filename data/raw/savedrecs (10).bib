Title = {Agile Autotuning of a Transprecision Tensor Accelerator Overlay for TVM
   Compiler Stack},
Booktitle = {2020 30TH INTERNATIONAL CONFERENCE ON FIELD-PROGRAMMABLE LOGIC AND
   APPLICATIONS (FPL)},
Series = {International Conference on Field Programmable Logic and Applications},
Year = {2020},
Pages = {310-316},
Note = {30th International Conference on Field-Programmable Logic and
   Applications (FPL), ELECTR NETWORK, AUG 31-SEP 04, 2020},
Abstract = {Specialized accelerators for tensor-operations, such as blocked-matrix
   operations and multi-dimensional convolutions, have emerged as powerful
   architecture choices for high-performance Deep-Learning computing. The
   rapid development of frameworks, models, and precision options
   challenges the adaptability of such tensor-accelerators since the
   adaptation to new requirements incurs significant engineering costs.
   Programmable tensor accelerators offer a promising alternative by
   allowing reconfiguration of a virtual architecture that overlays on top
   of the physical FPGA configurable fabric. We propose an overlay
   (tau-VTA) and an optimization method guided by agile-inspired
   auto-tuning techniques. We achieve higher performance of up to 2.5x and
   faster convergence of up to 8.1x.},
