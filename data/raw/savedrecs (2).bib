@inproceedings{ WOS:001562506200011,
Author = {Mohamed, Abdalrhman and Mascarenhas, Tomaz and Khan, Harun and Barbosa,
   Haniel and Reynolds, Andrew and Qian, Yicheng and Tinelli, Cesare and
   Barrett, Clark},
Editor = {Rakamaric, Z and Piskac, R},
Title = {LEAN-SMT: An SMT Tactic for Discharging Proof Goals in
   Lean},
Booktitle = {COMPUTER AIDED VERIFICATION, CAV 2025, PT III},
Series = {Lecture Notes in Computer Science},
Year = {2025},
Pages = {197-212},
Note = {37th International Conference on Computer Aided Verification-CAV-Annual,
   Zagreb, CROATIA, JUL 23-25, 2025},
Abstract = {Lean is an increasingly popular proof assistant based on dependent type
   theory. Despite its success, it still lacks important automation
   features present in more seasoned proof assistants, such as the
   Sledgehammer tactic in Isabelle/HOL. A key aspect of Sledgehammer is the
   use of proof-producing SMT solvers to prove a translated proof goal and
   the reconstruction of the resulting proof into valid justifications for
   the original goal. We present LEAN-SMT, a tactic providing this
   functionality in Lean. We detail how the tactic converts Lean goals into
   SMT problems and, more importantly, how it reconstructs SMT proofs into
   native Lean proofs. We evaluate the tactic on established benchmarks
   used to evaluate Sledgehammer's SMT integration, with promising results.
   We also evaluate lean-smt as a standalone proof checker for proofs of
   SMT-LIB problems. We show that LEAN-SMT offers a smaller trusted core
   without sacrificing too much performance.},
Type = {Proceedings Paper},
