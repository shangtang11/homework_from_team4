Title = {Technical Feasibility Study of the Current Carbon Nanotube Field Effect
   Transistor Technology in a Zigbee Transceiver Design},
Booktitle = {2021 WORKSHOP ON COMMUNICATION NETWORKS AND POWER SYSTEMS (WCNPS)},
Series = {Workshop on Communication Networks and Power Systems},
Year = {2021},
Note = {Workshop on Communication Networks and Power Systems (WCNPS), ELECTR
   NETWORK, NOV 18-19, 2021},
Abstract = {The present work demonstrates the realization of a technical feasibility
   study in the use of transistors with carbon nanotubes (CNTFets) using
   the purity level currently possible. With this in mind, a Zigbee
   transceiver was designed, containing the upconversion and downconversion
   mixers developed with CNTFets. The circuit performance was then compared
   with that obtained with similar circuits designed with CMOS transistors.
   It was possible to verify a better linearity and lower power consumption
   of circuits designed with CNTFets. The CNTFets were simulated with the
   CCAM model (Compact Carbon Nanotube Field-Effect Transistor Model),
   developed by the University of Dresden using the Verilog-A language.},
