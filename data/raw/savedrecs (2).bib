@inproceedings{ WOS:001540479400026,
Author = {Boulifa, Roua and Maistri, Paolo and Di Natale, Giorgio},
Book-Group-Author = {IEEE},
Title = {Early Result Capture: Racing Conditions in Pipeline due to Clock
   Glitches},
Booktitle = {2025 IEEE EUROPEAN TEST SYMPOSIUM, ETS},
Series = {Proceedings of the European Test Symposium},
Year = {2025},
Note = {2025 European Test Symposium-ETS-Annual, Tallinn, ESTONIA, MAY 26-30,
   2025},
Abstract = {Computing systems are now embedded in nearly all aspects of modern life,
   including sensitive and privacy-critical applications, making them prime
   targets for a variety of attacks, such as fault injection. Many of these
   systems rely on CPUs or microcontrollers, which are particularly
   vulnerable to these threats. As a result, ensuring the security of these
   systems is essential, necessitating the development of realistic fault
   models to guide the creation of effective countermeasures.
   Faulty behavior in microcontrollers is closely tied to the underlying
   microarchitecture and its specific implementation. This paper introduces
   a novel fault model that explains how the execution flow is disrupted by
   clock glitch-based attacks, with a focus on identifying which pipeline
   stages are affected by fault injections. Specifically, we provide a
   detailed analysis of the faulty behavior in the execution stage, which
   has not been previously explored in depth. We validate our model using
   an open RISC-V implementation and present experimental evidence of both
   known and newly discovered vulnerabilities.},
