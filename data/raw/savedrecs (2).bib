@inproceedings{ WOS:001447099800012,
Author = {Gesper, Sven and Koehler, Daniel and Gia Bao Thieu and Homann, Jasper
   and Meinl, Frank and Blume, Holger and Paya-Vaya, Guillermo},
Editor = {Carro, L and Regazzoni, F and Pilato, C},
Title = {A Novel Chaining-Based Indirect Addressing Mode in a Vertical Vector
   Processor},
Booktitle = {EMBEDDED COMPUTER SYSTEMS: ARCHITECTURES, MODELING, AND SIMULATION,
   SAMOS 2024, PT I},
