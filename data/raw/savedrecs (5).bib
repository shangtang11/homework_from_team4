@inproceedings{ WOS:001304427600011,
Author = {Jiang, Bo and Xie, Xianzhong and Yi, Lingjie and Wan, Yi},
Book-Group-Author = {Assoc Computing Machinery},
Title = {Improved YOLOv5s algorithm for aluminum sheet surface defect detection
   deployed on FPGA},
Booktitle = {2024 8TH INTERNATIONAL CONFERENCE ON INTELLIGENT SYSTEMS, METAHEURISTICS
   \& SWARM INTELLIGENCE, ISMSI 2024},
Year = {2024},
Pages = {49-56},
Note = {8th International Conference on Intelligent Systems, Metaheuristics \&
   Swarm Intelligence (ISMSI), Singapore, SINGAPORE, APR 24-25, 2024},
Abstract = {In response to issues such as poor real-time performance and complexity
   of network structure in the detection algorithm for surface defects on
   aluminum sheets, as well as difficulties in deploying on
   resource-constrained edge devices, a novel algorithm for aluminum sheet
   surface defect detection suitable for deployment on Field-Programmable
   Gate Arrays (FPGA) is proposed. Firstly, Shufflenetv2 is employed to
   replace the YOLOv5s backbone network, while the Focus layer in the model
   is removed to avoid repeated use of slice operations, reducing the
   parameter and computational complexity of the algorithm network model.
   Secondly, the improved Fast Spatial Pyramid Pooling (SPPF) module is
   embedded into the backbone network to enhance the algorithm's detection
   accuracy. Finally, the Complete Intersection over Union (CIoU) loss
   function is replaced with Efficient Intersection over Union (EIoU).
   Results on the aluminum sheet defect dataset show that the detection
   speed reaches 90.3 frames per second on a PC, a 34\% improvement over
   the original version. Simulation on an FPGA development board
   demonstrates that the improved algorithm achieves a detection speed of
   75.6 frames per second and an accuracy of 93.1\% mAP@0.5.},
Type = {Proceedings Paper},
Affiliation = {Jiang, B (Corresponding Author), Chongqing Univ Posts \& Telecommun, Sch Commun \& Informat Engn, Chongqing, Peoples R China.
