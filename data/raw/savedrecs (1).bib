@article{ WOS:001517377700001,
Author = {Ahmadunnisa, Shaik and Mathe, Sudha Ellison},
Title = {A comprehensive review on hardware implementations of lattice-based
   cryptographic schemes},
Journal = {JOURNAL OF SYSTEMS ARCHITECTURE},
Year = {2025},
Volume = {167},
Month = {OCT},
Abstract = {The rise in threats from large-scale quantum computer has driven
   significant advancements in the field of Post Quantum Cryptography
   (PQC). In this context, the National Institute of Standards and
   Technology (NIST) has initiated a call to standardize PQC schemes. Among
   all the PQC schemes, lattice-based cryptography (LBC) is considered one
   of the most viable due to its robust security proofs and ease of
   implementation. In this paper, we survey the mathematical hardness of
   lattice-based schemes, and provide a comprehensive review of the
   existing hardware implementations for LBC schemes. Further, we also
   provide a review of the hardware optimization techniques involved in the
   existing designs. We give certain approaches for advancing our research
   to ensure an efficient and secure cryptosystem.},
Type = {Article},
Affiliation = {Mathe, SE (Corresponding Author), VIT AP Univ, Vijayawada, India.
   Ahmadunnisa, Shaik; Mathe, Sudha Ellison, VIT AP Univ, Vijayawada, India.},
