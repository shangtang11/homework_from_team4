Title = {Numerical Analysis of the TMR Redundancy Method Against Faults by SEU
   Effect for Space Missions Using FPGA},
Booktitle = {PROCEEDINGS OF THE 7TH BRAZILIAN TECHNOLOGY SYMPOSIUM (BTSYM'21):
   EMERGING TRENDS IN SYSTEMS ENGINEERING MATHEMATICS AND PHYSICAL
   SCIENCES, VOL 2},
