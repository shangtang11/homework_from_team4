@inproceedings{ WOS:001506972600025,
Author = {Colagrande, Luca and Jonnalagadda, Jayanth and Benini, Luca},
Book-Group-Author = {IEEE},
Title = {Late Breaking Results: A RISC-V ISA Extension for Chaining in Scalar
   Processors},
Booktitle = {2025 DESIGN, AUTOMATION \& TEST IN EUROPE CONFERENCE, DATE},
Series = {Design Automation and Test in Europe Conference and Exhibition},
Year = {2025},
Note = {2025 Design, Automation \& Test in Europe Conference-DATE, Lyon, FRANCE,
   MAR 31-APR 02, 2025},
Abstract = {Modern general-purpose accelerators integrate a large number of
   programmable area- and energy-efficient processing elements (PEs), to
   deliver high performance while meeting stringent power delivery and
   thermal dissipation constraints. In this context, PEs are often
   implemented by scalar in-order cores, which are highly sensitive to
   pipeline stalls. Traditional software techniques, such as loop
   unrolling, mitigate the issue at the cost of increased register
   pressure, limiting flexibility. We propose scalar chaining, a novel
   hardware-software solution, to address this issue without incurring the
   drawbacks of traditional software-only techniques. We demonstrate our
   solution on register-limited stencil codes, achieving >93\% FPU
   utilizations and a 4\% speedup and 10\% higher energy efficiency, on
   average, over highly-optimized baselines. Our implementation is fully
   open source and performance experiments are reproducible using free
   software. 1},
Type = {Proceedings Paper},
Affiliation = {Colagrande, L (Corresponding Author), Swiss Fed Inst Technol, Integrated Syst Lab IIS, Zurich, Switzerland.
   Colagrande, Luca; Benini, Luca, Swiss Fed Inst Technol, Integrated Syst Lab IIS, Zurich, Switzerland.
   Jonnalagadda, Jayanth, Swiss Fed Inst Technol, D ITET, Zurich, Switzerland.},
