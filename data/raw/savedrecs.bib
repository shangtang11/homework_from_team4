@article{ WOS:001706708200013,
Author = {Yang, Heebong and Kim, Na Young},
Title = {Comparative study of photoluminescence in carbon nanotube films and
   cavity-coupled systems},
Journal = {JOURNAL OF THE OPTICAL SOCIETY OF AMERICA B-OPTICAL PHYSICS},
Year = {2026},
Volume = {43},
Number = {3},
Pages = {A191-A199},
Month = {MAR 1},
Abstract = {This study presents a comprehensive investigation of photoluminescence
   (PL) in chirality-enriched (6,5) singlewalled carbon nanotube (SWCNT)
   films. By systematically varying film thickness, fabrication methods,
   and excitation conditions, the intrinsic PL properties and
   exciton-polariton behavior within planar microcavities are explored. The
   findings reveal critical dependencies on intertube spacing, film
   morphology, and cavity design, offering new insights, to our knowledge,
   into optimizing light-matter interactions and guiding future efforts
   toward polariton condensation in SWCNT-based optoelectronic devices. (c)
   2026 Optica Publishing Group. All rights, including for text and data
   mining (TDM), Artificial Intelligence (AI) training, and similar
   technologies, are reserved.},
