@article{ WOS:000477733400005,
Author = {Chekuri, Venkata Chaitanya Krishna and Kar, Monodeep and Singh, Arvind
   and Mukhopadhyay, Saibal},
Title = {Autotuning of Integrated Inductive Voltage Regulator Using On-Chip Delay
   Sensor to Tolerate Process and Passive Variations},
Journal = {IEEE TRANSACTIONS ON VERY LARGE SCALE INTEGRATION (VLSI) SYSTEMS},
Year = {2019},
Volume = {27},
Number = {8},
Pages = {1768-1778},
Month = {AUG},
Abstract = {This paper demonstrates autotuning of the coefficients of the feedback
   loop of an inductive integrated voltage regulator (IVR) using an on-chip
   delay sensor. The proposed approach improves the effective performance
   of the digital core under variations in the on-die/package integrated
   passives and transistor process. A 130-nm CMOS test-chip is designed
   containing a multisampled 125-MHz IVR with a wirebond inductor, on-die
   capacitor, and all-digital proportional-integral-differential (PID)
   controller powering a parallel Advanced Encryption Standard (AES)
   engine. The autotuning is performed using a Vernier delay line based
   on-chip delay sensor and an all-digital tuning engine. The measurement
   results demonstrate up to 5.2\% improvement in the maximum operating
   frequency of the AES core using performance-based autotuning.},
Type = {Article},
Affiliation = {Chekuri, VCK (Corresponding Author), Georgia Inst Technol, Sch Elect \& Comp Engn, Atlanta, GA 30332 USA.
