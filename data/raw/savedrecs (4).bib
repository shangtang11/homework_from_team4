@inproceedings{ WOS:001229041700066,
Author = {Anand, Shashank and Friedman, Michal and Giardino, Michael and Alonso,
   Gustavo},
Book-Group-Author = {Assoc Computing Machinery},
Title = {Skip It: Take Control of Your Cache!},
Booktitle = {PROCEEDINGS OF THE 29TH ACM INTERNATIONAL CONFERENCE ON ARCHITECTURAL
   SUPPORT FOR PROGRAMMING LANGUAGES AND OPERATING SYSTEMS, ASPLOS 2024,
   VOL 2},
Year = {2024},
Pages = {1077-1094},
Note = {29th ACM International Conference on Architectural Support for
   Programming Languages and Operating Systems (ASPLOS), La Jolla, CA, APR
   27-MAY 01, 2024},
Abstract = {Mechanisms to explicitly manage the presence of data in caches are
   fundamental for the correctness and performance of modern systems. These
   operations, while critical, often incur significant performance
   penalties even when carefully used. Moreover, these mechanisms are
   implemented in proprietary and often undocumented hardware, so research
   into optimizations and novel designs is mostly limited to slow,
   simplified software simulations. In this paper, we design
   microarchitectural extensions to support two types of user-controlled
   cache writebacks to main memory. Furthermore, we propose Skip It, a
   mechanism built on top of our extensions that substantially reduces
   redundant writebacks. We implemented these designs on the open-source
   BOOM out-of-order RISC-V CPU. The performance in hardware is similar to
   100 cycles which favorably compares to similar operations in
   commercially available server-class platforms. In addition, Skip It
   performs as well as or better than state-of-the-art software techniques
   for avoiding unnecessary writebacks.},
Type = {Proceedings Paper},
Affiliation = {Giardino, M (Corresponding Author), Huawei Technol, Zurich, Switzerland.
   Anand, Shashank; Friedman, Michal; Alonso, Gustavo, Swiss Fed Inst Technol, Zurich, Switzerland.
   Giardino, Michael, Huawei Technol, Zurich, Switzerland.},
