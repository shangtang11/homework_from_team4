@article{ WOS:001419690000001,
Author = {Sathiamoorthy, Keerthana and Ganesan, Indumathi},
Title = {Revolutionizing interior Spaces: A comprehensive analysis of LED
   lighting for illumination and communication in modern Architecture},
Journal = {ENERGY AND BUILDINGS},
Year = {2025},
Volume = {331},
Month = {MAR 15},
Abstract = {Lighting is an art and technology is its canvas. In modern interior
   architectural designs lighting systems have evolved beyond their primary
   function to integrate communication capabilities through Visible Light
   Communication (VLC). This work explores the dual role of LED (Light
   Emitting Diode) lighting in providing illumination and enabling data
   transmission. A number of lighting models have been analyzed such as
   flush mount lighting, recessed lighting, hanging pendant, chandeliers,
   slide rails, pendant light cluster, diagonal linear strips, linear
   strips across y-axis, random LED lighting patterns and wall fixture
   LEDs. Performance metrics such as illuminance levels, uniformity, ISO
   compliance, received power, signal-to-noise ratio (SNR) and mobility
   area coverage were analyzed to assess lighting efficiency and VLC data
   transmission quality. The work employs MATLAB and DIALux Evo software to
   simulate and analyze the performance of various lighting configurations.
   Additionally, four specific LED products 726.70 PANTALLA 4000 K, 726.80
   PANTALLA 3000 K, ELIA PL M2 DALI and MOLNPRO 4400LM 840 MP were
   evaluated for their dual capabilities in illumination and Visible Light
   Communication (VLC). The work offers valuable insights into designing
   multifunctional, energy-efficient indoor environments that integrate
   advanced lighting and communication technologies.},
Type = {Article},
