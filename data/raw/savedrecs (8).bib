   Hamed, Hesham F. A., Minia Univ, Fac Engn, Al Minya, Egypt.
   Hamed, Hesham F. A., Egyptian Russian Univ, Fac Engn, Cairo, Egypt.},
DOI = {10.1016/j.compeleceng.2021.107585},
EarlyAccessDate = {JAN 2022},
Article-Number = {107585},
