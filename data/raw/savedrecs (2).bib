@inproceedings{ WOS:001665766800220,
Author = {Abdelmaksoud, Hany and Schubert, Tim and Friedrich, Sven and Brust,
   Clemens-Alexander and Lund, Andreas and Ltidtke, Daniel},
Book-Group-Author = {IEEE},
Title = {Enhancing Fault Tolerance in ARINC 653-compliant Partitioned Systems: A
   Focus on Dynamic Reconfiguration},
Booktitle = {2025 AIAA DATC/IEEE 44TH DIGITAL AVIONICS SYSTEMS CONFERENCE, DASC},
Series = {IEEE-AIAA Digital Avionics Systems Conference},
Year = {2025},
Note = {44th AIAA DATC/IEEE Digital Avionics Systems Conference-DASC, Montreal,
   CANADA, SEP 14-18, 2025},
Abstract = {Software avionic systems are critical for aircraft and spacecraft,
   incorporating key subcomponents such as Collision Avoidance Systems
   (CAS) and Terrain Awareness and Warning Systems (TAWS). The software
   within these systems must be resilient against failures, often using
   hypervisors to separate subcomponents into partitions that share
   resources. However, because these systems are subject to dynamic
   constraints, failures, or attacks, precompiled configurations can become
   inflexible and insufficient. To address these challenges, adaptive
   systems are increasingly necessary for responding to dynamic operational
   and security conditions, a requirement driven particularly by military
   needs. One promising approach is dynamic reconfiguration, where
   alternative subcomponents take over from failing ones. For example, if
   camera vision fails in the dark we switch to a full RADAR relying
   approach. However, ARINC 653-compliant hypervisors offer limited support
   for reconfiguration at run-time due to their fixed inter-partition
   communication structure. In this work, we introduce a
   ``mitigator{''}-along with routing and health monitoring components-to
   handle run-time failures of software components that process sensor data
   in an ARINC 653-compliant environment. The mitigator dynamically
   reconfigures the system using redundancies and a run-time scoring scheme
   to replace failed components and optimize the use of remaining ones,
   ensuring continued functionality and performance. Our evaluation
   measures the system's adaptation speed and output coverage, revealing a
   trade-off between fault tolerance and processing overhead.},
Type = {Proceedings Paper},
Affiliation = {Abdelmaksoud, H (Corresponding Author), German Aerosp Ctr DLR, Inst Software Technol, Braunschweig, Germany.
   Abdelmaksoud, Hany; Ltidtke, Daniel, German Aerosp Ctr DLR, Inst Software Technol, Braunschweig, Germany.
   Schubert, Tim; Friedrich, Sven, German Aerosp Ctr DLR, Inst Flight Syst, Braunschweig, Germany.
   Brust, Clemens-Alexander, German Aerosp Ctr DLR, Inst Data Sci, Jena, Germany.
   Lund, Andreas, German Aerosp Ctr DLR, Inst Software Technol, Waling, Germany.},
DOI = {10.1109/DASC66011.2025.11257410},
Keywords = {Fault Tolerance; FDIR; Dynamic Reconfiguration; Safety-Critical Systems;
   Avionics; ARINC 653},
Affiliations = {Helmholtz Association; German Aerospace Centre (DLR); Helmholtz
   Association; German Aerospace Centre (DLR); Helmholtz Association;
