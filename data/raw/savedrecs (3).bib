@article{ WOS:001511065700027,
Author = {Zagan, Ionel and Gaitan, Vasile Gheorghita},
Title = {System Verification and FPGA Implementation of Hardware Preemptive
   Scheduler for RISC-V Processor},
Journal = {IEEE ACCESS},
Year = {2025},
Volume = {13},
Pages = {103019-103032},
Abstract = {In soft-core processor implementations based on software schedulers,
   there is an overhead that should not be neglected in HARD and FIRM
   real-time systems (RTS). Due to interrupt service routines (ISRs), which
   are asynchronous with the processor and have a higher priority than
   thread execution, the response time of an execution thread interrupted
   by an asynchronous ISR may exhibit jitter. The overall purpose of this
   paper is to present the hardware scheduler accelerator (HwSA) concept
   based on the RISC-V 4-stage pipeline CPU, where the scheduling algorithm
   is implemented in hardware. The proposed system is compared with
   existing soft-core processors using different parameters, such as the
   field-programmable gate arrays (FPGA) resources used for implementation,
   frequency, instruction set architecture (ISA), scheduler type, and the
   number of pipeline stages. Priority inversion is a scheduling
   concurrency issue in RTOS, in which a high-priority task is indirectly
   blocked by a task with lower priority. The scientific contribution
   within this project is given by a dynamic scheduling algorithm
   implemented in hardware, support for resolving the priority inversion
   situations and the use of RISC-V ISA provided under open source
   licenses. The analysis shows that the proposed system has higher
   performance in terms of the event response time and lower jitter for the
   scheduler, as well as higher FPGA resource utilization compared to
   existing designs. The support for solving priority inheritance, as a
   derivative contribution presented in this paper, is represented by the
   HwSA\_RTOS hardware scheduler and dynamically changing the priorities of
   a task (instPi). The corresponding instPi priorities set by the
   mrPRIsCPUi register can be changed based on hardware logic since
   HwSA\_RTOS handles multiple prioritized events at each instPi, including
   the mutex event lr\_enMutexi. The results obtained achieve the proposed
   objectives since the execution threads have their hardware context,
   mainly following the real-time deterministic response of the system. We
   evaluate FPGA resource utilization, operating frequency, and processor
   performance jitter. From the implementation results, we show that
   HwSA\_RTOS achieves 10,82\% (FFs) and 14,84\% (LUTs) FPGA hardware
   resource utilisation improvement compared with nMPRA + nHSE, which is
   based on MIPS32 and 5-stage pipeline implementation.},
Type = {Article},
Affiliation = {Zagan, I; Gaitan, VG (Corresponding Author), Stefan Cel Mare Univ Suceava, MANSiD Res Ctr, PDADMCPI Lab, Suceava 720229, Romania.
   Zagan, Ionel; Gaitan, Vasile Gheorghita, Stefan Cel Mare Univ Suceava, MANSiD Res Ctr, PDADMCPI Lab, Suceava 720229, Romania.},
DOI = {10.1109/ACCESS.2025.3579294},
