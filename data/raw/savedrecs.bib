DOI = {10.1109/JETCAS.2025.3590065},
Keywords = {Cooling; Stacking; Space exploration; Microfluidics; Through-silicon
   vias; Three-dimensional displays; Space cooling; Predictive models; Heat
   transfer; Computer architecture; 3DIC; design space exploration (DSE);
   pre-RTL design; thermal simulation; microfluidic cooling},
