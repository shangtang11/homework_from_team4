@article{ WOS:001038593000006,
Author = {Alattar, Alhassan E. and Mohsen, Saeed},
Title = {A Survey on Smart Wearable Devices for Healthcare Applications},
Journal = {WIRELESS PERSONAL COMMUNICATIONS},
Year = {2023},
Volume = {132},
Number = {1},
Pages = {775-783},
Month = {SEP},
Abstract = {This paper introduces a survey on recent smart wearable devices used in
   different fields, especially healthcare applications. A discussion is
   presented in terms of power supply, wireless technologies, applications,
   and wearability of these devices. Regarding the power supply, a
   photovoltaic is the best harvesting energy source, while the best energy
   storage is a Li-ion battery. Regarding wireless technologies, Bluetooth
   low energy (BLE) is the best for personal usage, while Wi-Fi has
   preferred for Internet of Things (IoT) applications. Regarding the
   applications, medical and non-medical applications can be used.
   Regarding wearability, smart wearable devices can be positioned on a
   human hand or arm. Also, wearable sensors can be patched on human skin,
   besides, they can be placed on clothes, such as a smart suit which is
   preferred for heavy duties.},
