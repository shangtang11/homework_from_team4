@article{ WOS:001389001100001,
Author = {Zobaed, Sm and Salehi, Mohsen Amini},
Title = {Confidential Computing Across Edge-To-Cloud for Machine Learning: A
   Survey Study},
Journal = {SOFTWARE-PRACTICE \& EXPERIENCE},
