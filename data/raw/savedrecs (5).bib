@inproceedings{ WOS:001411745600004,
Author = {Patankar, Udayan S. and Flores, Miguel E. and Koel, Ants and Patankar,
   Sunil},
Book-Group-Author = {IEEE},
Title = {Moving Average Filter Block Implementation Using USP-Awadhoot Divider},
Booktitle = {2024 19TH BIENNIAL BALTIC ELECTRONICS CONFERENCE, BEC 2024},
Series = {Proceedings of the Biennial Baltic Electronics Conference},
Year = {2024},
Note = {19th Baltic Electronics Conference, Tallinn University Of Technology,
   Tallinn, ESTONIA, OCT 02-04, 2024},
Abstract = {In IoT systems, compact, battery-operated circuitry, and rapid data
   transmission are essential for reducing power consumption and extending
   battery life. Efficient data transmission requires robust local data
   processing capabilities supported by appropriate arithmetic and logical
   units (ALU). Modern processors or field-programmable gate arrays (FPGA)
   with a suitable ALU are well-suited for meeting these demands. To ensure
   data quality, effective signal processing before transmission is
   crucial. A moving average filter (MAF) is an excellent choice for this
   purpose, providing a balance of speed and precision while utilizing
   minimal hardware resources, thereby reducing the chip area needed for
   implementation. This article describes the design and implementation of
   the moving average low pass filter using the area-efficient novel
   USP-Awadhoot divider. The proposed USP-Awadhoot divider requires 266
   LUTs and 146 FFs for 8-bit implementation using Xilinx FPGA. The
   proposed moving average filter based on a novel USP-Awadhoot divider is
   implemented on Nexys A7 XC7A100T-1CSG324C FPGA boards with Xilinx Vivado
   Design Suite. It is suitable for the cost-effective implementation of
   IoT and battery-operated applications.},
Type = {Proceedings Paper},
Affiliation = {Patankar, US (Corresponding Author), TalTech Tallinn Univ Technol, TJS Dept Elect, Tallinn, Estonia.
