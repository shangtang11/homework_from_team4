@inproceedings{ WOS:001097480100009,
Author = {Li, AoXuan and Tang, Su-Kit and D'Angelo, Gabriele},
Book-Group-Author = {IEEE},
Title = {Implementation and preliminary evaluation of an auditable
   confidentiality mechanism for DeFi},
Booktitle = {2023 IEEE 43RD INTERNATIONAL CONFERENCE ON DISTRIBUTED COMPUTING SYSTEMS
   WORKSHOPS, ICDCSW},
Series = {IEEE International Conference on Distributed Computing Systems Workshops},
Year = {2023},
Pages = {49-54},
Note = {43rd IEEE International Conference on Distributed Computing Systems
   (ICDCS), Hong Kong, HONG KONG, JUL 18-21, 2023},
Abstract = {A well-known use of the blockchain technology is Decentralized Finance
   (DeFi). DeFi makes financial information accessible to the public but
   raises potential privacy and security issues. In this study, we
   implemented a DeFi protocol that protects privacy, which is based on the
   Mystiko.Network protocol. As a proxy between the user and DeFi
   platforms, the Mystiko.Network protocol offers an auditable
   confidentiality mechanism for blockchain transactions. Via the new
   system, users may submit anonymous DeFi transactions and get income back
   into a shielded tokens pool. Moreover, we implemented a rollup approach
   to handle anonymous DeFi transactions in groups. The evaluation results
   suggest that the protocol is both practical and affordable, in fact it
   is able to save around 90\% of the cost for DeFi transactions.},
Type = {Proceedings Paper},
