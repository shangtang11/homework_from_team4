@inproceedings{ WOS:001288719600012,
Author = {Tan, Yong Kiam and Heule, Marijn J. H. and Myreen, Magnus O.},
Editor = {Groote, JF and Larsen, KG},
Title = {cake\_lpr: Verified Propagation Redundancy Checking in CakeML},
Booktitle = {TOOLS AND ALGORITHMS FOR THE CONSTRUCTION AND ANALYSIS OF SYSTEMS, PT
   II, TACAS 2021},
