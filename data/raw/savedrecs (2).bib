@article{ WOS:001631899000002,
Author = {Luo, Hu and Xu, Yangyang and Huang, Qiuhui and Wang, Xiaohui and Wang,
   Zesheng and Yu, Jian and Zhu, Yunchao and Ma, Xin and Chen, Wen-Ming},
Title = {A Quantitative Benchmark of Deep Learning-Based Decoupling Methods for
   Multidimensional Force Platform Used in Dynamic Gait Analysis},
Journal = {IEEE TRANSACTIONS ON INSTRUMENTATION AND MEASUREMENT},
Year = {2025},
Volume = {74},
Abstract = {Plantar pressure and shear stresses are the 3-D contact forces that
   occur during foot-ground interactions, serving as the core parameters
   for dynamic gait analysis. Despite the implementation of various force
   measurement systems for clinical analysis, only few can detect plantar
   pressure and shear stress distribution simultaneously. Our recent work
   on the vision-based 3-D plantar force detection platform offers new
   possibilities in resolving complex 3-D forces using deep learning (DL)
   techniques. However, the 3-D forces decoupling capabilities of neural
   networks (NNs) must be evaluated using domain-specific metrics to meet
   the stringent demands of clinical applications. In this work, we propose
   a set of domain-specific metrics for evaluating the performance of
   DL-based 3-D force platforms: linearity, accuracy, contact area,
   multidimensional force distribution, and response time. We trained and
   evaluated 4300 sets of optical flow-multidimensional force data using a
   customized data collection system. The force platform was implemented
   utilizing eight classical DL models based on either image regression or
   segmentation strategies. To rigorously evaluate their real-world
   applicability, we then performed a separate pre-clinical evaluation
   using an extra but more challenging dataset of 140 pairs gathered from
   3-D-printed anatomical foot phantoms with different contact stiffness
   properties. Finally, we deployed the optimal model, PSPNet, on the
   platform and conducted a comparative validation against the commercial
   pressure sensing devices using in vivo gait experiments with six
   participants. The platform can sensitively detect the multidimensional
   force distribution at critical anatomical locations (i.e., high shear
   stresses under the big toe) during push-off phase in gait, which were
   not well captured by the previous vision-based force platform. To the
   best of our knowledge, such a unified set of metrics has not been
   systematically explored and validated in prior research. Furthermore, we
   demonstrate the practical utility of these metrics by applying them to
   evaluate the performance of eight classic DL models, thereby providing a
   quantitative framework for benchmarking and improving the current
   DL-based 3-D force platforms. This research is anticipated to notably
   accelerate the implementation of multidimensional force decoupling
   technology for gait analysis, facilitating its practical application in
   early diagnosis and prevention of biomechanics-related foot disorders.},
