@article{ WOS:001562410200001,
Author = {Valuskar, Ashish and Shandilya, Madhu and Rajawat, Arvind},
Title = {Performance Evaluation of a Novel EPO-FMPTMS Scheduling Technique for
   Balancing Traffic Patterns on NOC-Based Communication Infrastructure},
Journal = {JOURNAL OF CIRCUITS SYSTEMS AND COMPUTERS},
Year = {2026},
Volume = {35},
Number = {03},
Month = {FEB 15},
Abstract = {The network-on-chip (NoC) has appeared as a well-organized and
   accessible communication fabric for chip multiprocessors (CMPs) and
   multiprocessor systems on chips (MPSoCs). NoC is an auspicious method
   for diminishing the communication bottleneck of a multi-core
   system-on-chip (SoC). The performance of the system, energy consumption,
   and congestion avoidance tend to be prodigious challenges for system
   designers. In this paper, the Emperor Penguin optimization-based
   fast-moving protocol for Task mapping and scheduling (EPO-FMPTMS) is
   proposed for application mapping and scheduling techniques with static
   and dynamic constraints to evade contention and traffic deadlock issues.
   Multi-objective optimization problems are considered for the
   minimization of makespan, energy consumption, and contention. Also, the
   traffic patterns in real-time applications in NoC have been focused. The
   analysis includes four types of traffic patterns: recorded traffic
   pattern (RTP), statistical traffic pattern (STP), uniform traffic
   pattern (UTP) and peak power traffic pattern (PPT). Four traffic
   patterns are analyzed with network topology to reveal which traffic
   pattern is best suited for which topology. This paper analyzes the
   performance of the proposed scheduling strategy, four traffic patterns
   with four NoC architectures such as star, mesh, ring and torus
   architecture in terms of power, area, delay frequency, latency,
   throughput, minimization of contention, makespan, energy consumption,
   reliability, deadline performance and allocation time are evaluated.},
Type = {Article},
Affiliation = {Valuskar, A (Corresponding Author), Indore Profess Studies Acad, Indore, India.
