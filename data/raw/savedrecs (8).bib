Title = {Scale up your In-Memory Accelerator: Leveraging Wireless-on-Chip
   Communication for AIMC-based CNN Inference},
Booktitle = {2022 IEEE INTERNATIONAL CONFERENCE ON ARTIFICIAL INTELLIGENCE CIRCUITS
