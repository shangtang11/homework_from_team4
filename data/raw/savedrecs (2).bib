@inproceedings{ WOS:001540569200006,
Author = {Gavioli, Federico and Moretti, Francesco and Russo, Antonio and
   Capotondi, Alessandro and Burgio, Paolo},
Book-Group-Author = {ACM},
Title = {Thundershot: an open-source autonomous vehicles research platform for
   embedded heterogeneous MPSoCs},
