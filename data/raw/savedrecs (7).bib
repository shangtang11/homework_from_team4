Series = {IEEE International Symposium on Circuits and Systems},
Year = {2023},
Note = {56th IEEE International Symposium on Circuits and Systems (ISCAS),
   Monterey, CA, MAY 21-25, 2023},
Abstract = {The RISC-V open source instruction set architecture is a promising
   solution for applications related to low power embedded systems. This
   paper presents a configurable RISCV processor architecture providing a
   compromise between the number of clock cycles required to execute an
   instruction, the maximum operating frequency, the resource utilization
   and the power consumption. This architectural flexibility enables the
   processor to be adapted to fit application constraints, on either FPGA
   or ASIC targets.},
