@article{ WOS:000849264200005,
Author = {Mallasen, David and Murillo, Raul and Del Barrio, Alberto A. and
   Botella, Guillermo and Pinuel, Luis and Prieto-Matias, Manuel},
Title = {PERCIVAL: Open-Source Posit RISC-V Core With Quire Capability},
Journal = {IEEE TRANSACTIONS ON EMERGING TOPICS IN COMPUTING},
Year = {2022},
Volume = {10},
Number = {3},
Pages = {1241-1252},
Month = {JUL-SEP},
Abstract = {The posit representation for real numbers is an alternative to the
   ubiquitous IEEE 754 floating-point standard. In this work, we present
   PERCIVAL, an application-level posit RISC-V core based on CVA6 that can
   execute all posit instructions, including the quire fused operations.
   This solves the obstacle encountered by previous works, which only
   included partial posit support or which had to emulate posits in
   software. In addition, Xposit, a RISC-V extension for posit instructions
   is incorporated into LLVM. Therefore, PERCIVAL is the first work that
   integrates the complete posit instruction set in hardware. These
   elements allow for the native execution of posit instructions as well as
   the standard floating-point ones, further permitting the comparison of
   these representations. FPGA and ASIC synthesis show the hardware cost of
   implementing 32-bit posits and highlight the significant overhead of
   including a quire accumulator. However, results show that the quire
   enables a more accurate execution of dot products. In general matrix
   multiplications, the accuracy error is reduced up to 4 orders of
   magnitude. Furthermore, performance comparisons show that these accuracy
   improvements do not hinder their execution, as posits run as fast as
   single-precision floats and exhibit better timing than double-precision
   floats, thus potentially providing an alternative representation.},
Type = {Article},
Affiliation = {Mallasén, D (Corresponding Author), Univ Complutense Madrid, Fac Informat, Madrid 28040, Spain.
   Mallasen, David; Del Barrio, Alberto A.; Botella, Guillermo; Prieto-Matias, Manuel, Univ Complutense Madrid, Fac Informat, Madrid 28040, Spain.
