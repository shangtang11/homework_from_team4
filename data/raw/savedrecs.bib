@article{ WOS:001687064000001,
Author = {Kumar, Sujeet and Ray, Kailash Chandra},
Title = {FCMFID: A Full Coverage Multi-bit Fault-Tolerant Instruction Decoder for
   RISC-V based softcore},
Journal = {INTEGRATION-THE VLSI JOURNAL},
Year = {2026},
Volume = {108},
Month = {MAY},
Abstract = {The use of RISC-V-based soft processors in space technology is rapidly
   expanding, owing to their modular architecture, open instruction set,
   and flexible system integration capabilities. However, Single-Event
   Multiple Upsets (SEMUs) due to radiation effects pose critical
   reliability challenges, as faults in the instruction decoder will abort
   execution and cause system failures. Hence, the paper presents a new
   Full-Coverage Multi-Bit FaultTolerant Instruction Decoder (FCMFID)
   design that enhances the reliability of a pipeline RV32I processor core
   by providing protection to the full Instruction decoder, including IF/ID
   and ID/EX pipeline registers. The design employs nibble-level parity
   checking to correct single-bit faults within each nibble and mitigate
   multi-bit errors through selective nibble replacement. The proposed
   FCMFID architecture is implemented in Verilog HDL and prototyped on a
   Xilinx Artix-7 FPGA by employing Fault injection using the Xilinx Soft
   Error Mitigation (SEM) IP to validate its resilience at the silicon
   level. In comparison to an unprotected design, the results show that
   FCMFID improves fault tolerance by 99.36\%. It also reduces power
   consumption by 30.05\% and LUT overhead by 145.53\% as compared to TMR
   and is suited for RISC-V-based soft processors in resource-constrained
   space applications.},
Type = {Article},
Affiliation = {Kumar, S (Corresponding Author), Indian Inst Technol Patna, Dept Elect Engn, Patna, Bihar, India.
   Kumar, Sujeet; Ray, Kailash Chandra, Indian Inst Technol Patna, Dept Elect Engn, Patna, Bihar, India.},
