@inproceedings{ WOS:001253778900204,
Author = {Yu, Xinglong and Sun, Yi and Zhao, Yifan and Kuang, Honglin and Han, Jun},
Book-Group-Author = {IEEE},
Title = {RVCE-FAL: A RISC-V Scalar-Vector Custom Extension for Faster FALCON
   Digital Signature},
Booktitle = {2024 DESIGN, AUTOMATION \& TEST IN EUROPE CONFERENCE \& EXHIBITION, DATE},
Series = {Design Automation and Test in Europe Conference and Exhibition},
Year = {2024},
Note = {27th Design, Automation and Test in Europe Conference and Exhibition
   (DATE), Valencia, SPAIN, MAR 25-27, 2024},
Abstract = {The National Institute of Standards and Technology (NIST) has selected
   FALCON as one of the standardized digital signature algorithms against
   quantum attacks in 2022. Compared with the other post-quantum
   cryptography (PQC) schemes, lattice-based FALCON is more appropriate for
   future Internet of Things (IoT) applications due to the fastest
   signature verification process and the lowest transmission overhead. In
   this paper, we propose a custom extension based on the RISC-V
   scalar-vector framework for efficient implementation of FALCON. To our
   best knowledge, this work is the first hardware-software co-design for
   complete FALCON signature generation and verification routines. Besides,
   we design the first FALCON Gaussian sampling hardware and a RISC-V
   vector extension (RVV) based domain-specific core. The proposed
   architecture accelerates kernel operations in FALCON, such as discrete
   Gaussian sampling, number theoretic transform (NTT), inverse NTT, and
   polynomial operations. Compared with the reference implementation,
   results on the gem5-RTL simulation platform present a speedup for
   signature generation and verification of up to 18x and 6.9x.},
Type = {Proceedings Paper},
Affiliation = {Han, J (Corresponding Author), Fudan Univ, State Key Lab Integrated Chips \& Syst, Shanghai, Peoples R China.
   Yu, Xinglong; Sun, Yi; Zhao, Yifan; Kuang, Honglin; Han, Jun, Fudan Univ, State Key Lab Integrated Chips \& Syst, Shanghai, Peoples R China.},
