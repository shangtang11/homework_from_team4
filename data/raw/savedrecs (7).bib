@article{ WOS:000870052700001,
Author = {Canton-Vitoria, Ruben and Quintana, Mildred and Malliaros, Nikitas G.
   and Tagmatarchis, Nikos},
Title = {Decatungstate-Photocatalyzed Acylation of Single-Walled Carbon Nanotubes},
Journal = {ADVANCED MATERIALS INTERFACES},
Year = {2023},
Volume = {10},
Number = {1},
Month = {JAN},
Abstract = {Although the functionalization and modification of single-walled carbon
   nanotubes (SWCNTs) has been advanced for two decades, their chemical
   transformation via catalytic processes has yet to be explored and
   further facilitate their industrial utility. Here, the
   decatungstate-photocatalyzed acylation is described of semiconducting
   (7,6)SWCNTs and the scope of the reaction is investigated by employing
   alkyl, aromatic, and organometallic aldehydes. The success of the
   methodology is confirmed by diverse spectroscopic, thermal, microscopy
   imaging, and redox techniques. The developed catalytic process for the
   functionalization of SWCNTs is environmetal friendly, since the catalyst
   and unreacted aldehydes can be recovered and reused, while the modified
   SWCNTs can be easily isolated and purified by membrane filtration. It is
   believed that the current findings will open new avenues for the
   catalytic functionalization of SWCNTs and the approach is intended to
   extend for modifying 2D nanomaterials.},
