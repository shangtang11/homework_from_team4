@inproceedings{ WOS:001657120200225,
Author = {Thomas, Fabian and Arribas, Eric Garcia and Hetterich, Lorenz and Weber,
   Daniel and Gerlach, Lukas and Zhang, Ruiyi and Schwarz, Michael},
Book-Group-Author = {ACM},
Title = {RISCOVER: Automatic Discovery of User-exploitable Architectural Security
   Vulnerabilities in Closed-Source RISC-V CPUs},
Booktitle = {PROCEEDINGS OF THE 2025 ACM SIGSAC CONFERENCE ON COMPUTER AND
   COMMUNICATIONS SECURITY, CCS 2025},
Year = {2025},
Pages = {3326-3340},
Note = {32nd Conference on Computer and Communications Security-CCS, Taipei,
   TAIWAN, OCT 13-17, 2025},
Abstract = {The open and extensible RISC-V instruction set has enabled many new CPU
   vendors and implementations, but most commercial CPUs are closed-source,
   significantly hindering vulnerability analysis-especially for bugs
   exploitable from unprivileged user space.
   We present RISCOVER, a user-space framework for detecting architectural
   vulnerabilities in closed-source RISC-V CPUs. It compares
   instruction-sequence behavior across CPUs, identifying deviations
   without source code, hardware changes, or models, and achieving
   orders-of-magnitude speedups over RTL-based methods. Unlike prior work,
   RISCOVER runs user code on Linux directly on real hardware, exposing
   vulnerabilities exploitable by unprivileged attackers. Evaluated on 8
   off-the-shelf CPUs from 3 different vendors, it uncovers 4 previously
   unknown vulnerabilities.
   Notably, GhostWrite lets unprivileged code write chosen bytes to
   physical memory, enabling arbitrary data leakage and full machine-mode
   execution, while 3 unprivileged ``halt-and-catch-fire{''} bugs halt CPUs
   and misaligned zero-stores silently corrupt data. Our results highlight
   the pressing need for post-silicon fuzzing techniques. RISCOVER
   complements existing RTL-level fuzzers by enabling rapid and automated
   security analysis of closed-source CPUs.},
Type = {Proceedings Paper},
Affiliation = {Thomas, F (Corresponding Author), CISPA Helmholtz Ctr Informat Secur, Saarbrucken, Germany.
   Thomas, Fabian; Arribas, Eric Garcia; Hetterich, Lorenz; Weber, Daniel; Gerlach, Lukas; Zhang, Ruiyi; Schwarz, Michael, CISPA Helmholtz Ctr Informat Secur, Saarbrucken, Germany.},
