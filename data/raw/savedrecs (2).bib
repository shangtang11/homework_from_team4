@article{ WOS:001643431900029,
Author = {Liu, Zilu and Yu, Ningmei},
Title = {Evaluation and Optimization of Glitch Power Based on Signal Transition
   Behavior of Logic Gates},
Journal = {IEEE ACCESS},
Year = {2025},
Volume = {13},
Pages = {212517-212530},
Abstract = {With the continuous development of integrated circuits, reducing glitch
   power in dynamic power consumption has become a critical issue in
   low-power design. However, existing evaluation methods can only assess
   glitch power during the functional verification stage of design. To
   enable glitch power evaluation and low-power design at an earlier stage,
   this paper proposes a method for evaluating and optimizing glitch power
   at the logic synthesis stage. By analyzing the factors that affect
   switching power and simulating the signal transitions of logic cells
   during the testing stage, switching power can be predicted. Based on the
   signal transition behavior, the mapping of logic cells is further
   optimized to achieve low-power design. The proposed method is validated
   on the EPFL benchmark circuits. Experimental results show that, compared
   with Electronic Design Automation (EDA) tools, the proposed prediction
   algorithm reduces the time cost by more than 90\%, achieves a prediction
   error of less than 8\% for switching power, and maintains the prediction
   error of glitch power mostly below 20\%. In terms of power optimization,
   the total power consumption of the optimized circuits is reduced by
   7\%-15\%, while glitch power is reduced by 6\%-30\%.},
Type = {Article},
Affiliation = {Yu, NM (Corresponding Author), Xian Univ Technol, Xian 710048, Peoples R China.
   Liu, Zilu; Yu, Ningmei, Xian Univ Technol, Xian 710048, Peoples R China.},
