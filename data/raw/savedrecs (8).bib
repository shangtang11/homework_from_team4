Title = {RVVRADAR: A Framework for Supporting the Programmer in Vectorization for
   RISC-V},
Booktitle = {PROCEEDINGS OF THE 32ND GREAT LAKES SYMPOSIUM ON VLSI 2022, GLSVLSI 2022},
Year = {2022},
