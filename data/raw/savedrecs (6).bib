@inproceedings{ WOS:001116715100174,
Author = {Brohet, Marco and Valencia, Felipe and Regazzoni, Francesco},
Book-Group-Author = {IEEE},
Title = {Invited Paper: Instruction Set Extensions for Post-Quantum Cryptography},
Booktitle = {2023 IEEE/ACM INTERNATIONAL CONFERENCE ON COMPUTER AIDED DESIGN, ICCAD},
Series = {ICCAD-IEEE ACM International Conference on Computer-Aided Design},
Year = {2023},
Note = {42nd IEEE/ACM International Conference on Computer-Aided Design (ICCAD),
   San Francisco, CA, OCT 28-NOV 02, 2023},
Abstract = {Quantum computing is one of the latest breakthroughs in the field of
   computer science, having the potential of breaking the underlying
   assumptions of public-key cryptography. With the National Institute of
   Standards and Technology (NIST) having announced that lattice-based
   KYBER as Key Encapsulation Mechanism (KEM) and DILITHIUM and FALCON as
   digital signatures are going to be standardized as the first
   Post-Quantum Cryptography (PQC) schemes, the scientific community needs
   to investigate how to efficiently implement these new primitives to
   ensure a smooth transition. We review in this work the state-of-the-art
   in Instruction Set Extensions (ISEs) for the lattice-based PQC schemes
   to be standardized. We categorize them into three groups. Firstly,
   tightly-integrated implementations that aim to be small and only
   accelerate the core functions, secondly more generic and bigger ISEs
   that target more lattice operations, and thirdly a special class that
   focuses on vectorized processing. While we observe promising results in
   improving on runtime and energy consumption, the memory footprint is
   often overlooked in the evaluation, even though this is a serious issue
   in PQC where keys, ciphertexts and signatures tend to be larger.
   Additionally, we envision that more generic lattice-based ISEs will
   surface, and that side-channel and fault attacks will become more
   important.},
Type = {Proceedings Paper},
Affiliation = {Brohet, M (Corresponding Author), Univ Amsterdam, Informat Inst, Amsterdam, Netherlands.
   Brohet, Marco; Regazzoni, Francesco, Univ Amsterdam, Informat Inst, Amsterdam, Netherlands.
