@article{ WOS:001492450000003,
Author = {Chen, Tian and Tan, Yu-an and Li, Wenjuan and Ci, Zhaohui and Shi, Ning},
Title = {Toward secure program execution in multi-tenant cloud FPGA environments},
Journal = {JOURNAL OF SUPERCOMPUTING},
Year = {2025},
Volume = {81},
Number = {8},
Month = {MAY 21},
Abstract = {Field-programmable gate arrays (FPGAs) are increasingly utilized in
   cloud computing due to their reconfigurability and ability to accelerate
   tasks such as machine learning and cryptography. However, multi-tenancy,
   where multiple users share FPGA resources, introduces significant
   security challenges. This paper analyzes both traditional and
   FPGA-specific attacks, including side-channel, covert-channel, and fault
   injection attacks, which exploit shared resources to compromise
   confidentiality, integrity, and availability. Countermeasures,
   encompassing preventive and runtime approaches, are reviewed to address
   these threats, emphasizing the need for a multi-layered security
   strategy. Although multi-tenancy in FPGA cloud servers has yet to be
   widely adopted, this paper provides critical insights into securing
   future multi-tenant FPGA infrastructures, ensuring the safe and
   efficient use of FPGA resources in cloud environments.},
