@inproceedings{ WOS:001537918205116,
Author = {Sang, Haoyang and Wang, Zhao and Lin, Ningchao and Zhao, Guangshu and
   Law, Man-Kay},
Book-Group-Author = {IEEE},
Title = {Ultra Low Power Video Understanding Smart Vision SoC with On-Chip
   Sensing and Hybrid Similarity-Aware SRAM/ROM CIM Macro},
Booktitle = {2025 IEEE INTERNATIONAL SYMPOSIUM ON CIRCUITS AND SYSTEMS, ISCAS},
Series = {IEEE International Symposium on Circuits and Systems},
Year = {2025},
Note = {2025 International Symposium on Circuits and Systems-ISCAS-Annual,
   ENGLAND, MAY 25-28, 2025},
Abstract = {The proliferation of augmented reality (AR), virtual reality (VR), and
   extended reality (XR) edge devices drives the demand for video
   understanding, which imposes substantial demands on computational
   resources, memory, and energy efficiency. This work proposes an
   ultra-low power and highly compact smart vision SoC, composed of: 1) a
   bit-line (BL) segmented parallel charging ROM CIM macro with power
   gating and coupled coding; 2) heterogeneous similarity-aware hybrid
   SRAM/ROM cores for exploiting temporal similarity with high utilization;
   3) a hierarchical multi-modal system trigger uses an on-chip CMOS imager
   with near-sensor caching for skipping unnecessary inference; and 4) a
   RISC-V core featuring dedicated ISA extensions to support flexible
   workload allocation and programmability. The proposed ROM CIM macro
   achieves a storage density of 4705 kb/mm(2) and an area efficiency of
   0.753 TOPS/mm(2), demonstrating a 3.2 similar to 14.83x improvement in
   density FoM compared to state-of-the-art (SOTA) CIM macros. Furthermore,
   the SoC achieves an energy efficiency of 13.6 similar to 18.3 TOPS/W on
   ResNet-20 (fixed-point 8-bit activation and 10-bit weight), representing
   a 1.8 similar to 3.0x improvement over existing smart vision SoCs.},
