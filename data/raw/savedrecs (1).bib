@article{ WOS:001474139700001,
Author = {Li, Jianxi and Duan, Tianyi and Wang, Jun and Tian, Weiliang and Liu,
   Kai and Zhang, Fengran and Wang, Yuchen and Zhang, Kewei and Yang, Song},
Title = {Conductive polymer decorated alginate fabrics as flexible
   triboelectric-piezoresistive haptic tactile sensors for action and
   texture recognitions},
Journal = {CHEMICAL ENGINEERING JOURNAL},
Year = {2025},
Volume = {512},
Month = {MAY 15},
Abstract = {Empowering robots with tactile perception as well as human-like
   cognitive and decision-making abilities is fundamentally important yet
   still challenging for artificial intelligence. Herein, we develop a
   flexible triboelectric-piezoresistive haptic tactile sensor using
   conductive polymer decorated nonwoven alginate fabrics. The dimples and
   bumps on interlocking fabric structure not only give rise to excellent
   mechanical stability but also enable superior electronic outputs. As
   expected, the flexible sensor exhibits ultrahigh piezoresistive
   sensitivity of 5.67 kPa(-1) with rapid response/recovery time of 25/43
   ms and self-powered triboelectric sensitivity of 0.73 kPa(-1) with
   response/recovery time of 200/80 ms. Conjugated with K-Nearest Neighbors
   (KNN) algorithm, the sensor demonstrates superior capabilities beyond
   human tactile perception, including impressive ability to real-time
   detect slight actions with 98.9 \% accuracy and single-contact recognize
   textured surfaces with 98.3 \% accuracy. This work not only provides a
   methodology for engaging eco-friendly fabric electronics but also endows
   a broad prospect in the field of advanced intelligent tactile cognition
   era.},
