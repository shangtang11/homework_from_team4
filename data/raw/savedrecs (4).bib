@article{ WOS:001273000000001,
Author = {Schneider, Felix and Karagounis, Michael and Choubey, Bhaskar},
Title = {Energy and Bandwidth Efficient Sparse Programmable Dataflow Accelerator},
Journal = {IEEE TRANSACTIONS ON CIRCUITS AND SYSTEMS I-REGULAR PAPERS},
Year = {2024},
Volume = {71},
Number = {9},
Pages = {4092-4105},
Month = {SEP},
Abstract = {The high performance Neural Network accelerator architectures rely on
   either large external memory bandwidth and/or sparse computation
   paradigms which scale down unfavorably. Current state-of-the-art
   architectures also include on-chip SRAMs often more than 150 kB,
   establishing a lower bound on silicon area based on memory alone. This
   article presents an architecture which exploits programmable dataflow in
   combination with sparsity to make more efficient use of small on-chip
   memories. Its control logic supports an enlarged map space through
   uneven mappings, searched by a cost-model driven compiler to find points
   which allow prioritizing energy consumption and memory access over
   throughput. The problem of supporting sparse processing for flexible
   dataflows is circumvented by introducing an encoding scheme which
   provides sparsity metadata while still allowing random read and write
   access. Altogether, the system showcases enhanced performance in terms
   of external memory access while requiring only 51 kB of on-chip SRAM and
   small silicon area (0.5 mm (2)). The design achieves average energy
   efficiency of 4.4 TOPS/W and 9.7 inferences/s for a sparse AlexNet
   workload.},
Type = {Article},
Affiliation = {Schneider, F (Corresponding Author), Dortmund Univ Appl Sci \& Arts, Dept Elect Engn, D-44139 Dortmund, Germany.
