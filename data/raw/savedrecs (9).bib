@article{ WOS:000663147500016,
Author = {Marques, Ivo and Rodrigues, Cristiano and Tavares, Adriano and Pinto,
   Sandro and Gomes, Tiago},
Title = {Lock-V: A heterogeneous fault tolerance architecture based on Arm and
   RISC-V{*}},
Journal = {MICROELECTRONICS RELIABILITY},
Year = {2021},
Volume = {120},
Month = {MAY},
Abstract = {This article presents Lock-V, a heterogeneous fault tolerance
   architecture that explores a dual-core lockstep (DCLS) technique to
   mitigate single event upset (SEU) and common-mode failure (CMF)
   problems. The Lock-V was deployed in two versions, Lock-VA and Lock-VM
   by applying design diversity in two processor architectures at the
   instruction set architecture (ISA)-level. Lock-VA features an Arm
   Cortex-A9 with a RISC-V RV64GC, while Lock-VM includes an Arm Cortex-M3
   along with a RISC-V RV32IMA processor. The solution explores
   fieldprogrammable gate array (FPGA) technology to deploy softcore
   versions of the RISC-V processors, and dedicated accelerators for
   performing error detection and triggering the software rollback system
   used for error recovery. To test Lock-V in both versions, a
   fault-injection mechanism was implemented to cause bit-flips in the
   processor registers, a common problem usually present in heavy radiation
   environments.},
Type = {Article},
Affiliation = {Gomes, T (Corresponding Author), Univ Minho, Ctr ALGORITMI, Braga, Portugal.
   Marques, Ivo; Rodrigues, Cristiano; Tavares, Adriano; Pinto, Sandro; Gomes, Tiago, Univ Minho, Ctr ALGORITMI, Braga, Portugal.},
