@article{ WOS:001598768900001,
Author = {Xia, Junyang and Zhang, Pengfei and Niu, Ziyi and Chen, Wenbo and Zhang,
   Zhili and Liu, Penghui and Liu, Bitao and Zhao, Lei},
Title = {Design of broadband near-infrared mechanoluminescence for effective
   mechanical sensing in bright field},
Journal = {CHEMICAL ENGINEERING JOURNAL},
Year = {2025},
Volume = {524},
Month = {NOV 15},
Abstract = {Mechanoluminescence (ML)-based mechanical sensing has emerged as a
   promising approach for structural health monitoring and intelligent
   sensings, owing to its mechanical-optical coupling, self-powered
   operation, non-contact detection, and immunity to electromagnetic
   interference. However, the prevalent use of visibleemitting ML materials
   poses a critical limitation - strong spectral overlap with ambient light
   sources (e.g., sunlight, indoor lighting, signal indicators) - which
   severely compromises signal-to-noise ratio and sensing accuracy under
   real-world conditions. Herein, we report a broadband near-infrared (NIR)
   ML composite, GCNY (Gd3Ga5O12: Cr3+, Nd3+, Yb3+)/PDMS, exhibiting
   broadband emission from NIR-I to NIR-II (650 nm-1150 nm). The ML
   response originates from triboelectric coupling at the inorganic-organic
   interface, and the NIR II ML emitting is further boosted through
   stepwise energy transfer among Cr3+, Nd3+, and Yb3+ dopants. Benefiting
   from its long-wavelength output, GCNY/PDMS composite enables
   interference-free mechanical sensing under bright-field conditions,
   including both natural and artificial illumination. This work offers a
   general design strategy for ambient-light-compatible ML materials and
   expands the practical applicability of ML-based sensing toward
   high-fidelity operation in complex real-world environments.},
Type = {Article},
Affiliation = {Liu, PH; Zhao, L (Corresponding Author), Baoji Univ Arts \& Sci, Collaborat Innovat Ctr Rare Earth Opt Funct Mat \&, Sch Phys \& Optoelect Technol, Baoji 721016, Shaanxi, Peoples R China.
