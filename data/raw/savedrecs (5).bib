@inproceedings{ WOS:001329127500129,
Author = {Vemuri, Madhava Sarma and Ahmed, Tanvir and Tida, Umamaheswara Rao},
Editor = {Thapliyal, H and Becker, J},
Title = {Compact 6T-SRAM using bottom-gate transistor in FD-SOI process for
   Monolithic-3D Integration},
Booktitle = {2024 IEEE COMPUTER SOCIETY ANNUAL SYMPOSIUM ON VLSI, ISVLSI},
Series = {IEEE Computer Society Annual Symposium on VLSI},
Year = {2024},
Pages = {725-729},
Note = {IEEE-Computer-Society Annual Symposium on VLSI (ISVLSI), Knoxville, TN,
   JUL 01-03, 2024},
Abstract = {Monolithic three-dimensional integrated circuits (M3D-IC) have gained
   attraction as a promising alternative to conventional IC design to
   preserve Moore's law. The interconnections between the top and bottom
   layers in M3D-ICs are facilitated through the Metal interlayer via
   (MIV). Previous works on M3D-IC show that up to 108 MIVs pass through
   the top substrate creating an overhead since these MIVs occupied active
   device region areas in the top substrate. On the other hand, on-chip
   SRAM has become an important component in modern IC design. This area
   overhead brought by MIV has become significant for SRAM cell design in
   M3D-IC. Towards this, we propose a bottom gate transistor on the
   top-layer, which requires one extra lithography step. With bottom-gate
   transistor utilization, there is no MIV overhead for SRAM cell design in
   M3D-IC implementation. Simulation results suggest that the proposed
   approach can reduce the SRAM cell area and leakage current I-leak by
   21\% and 12.45\% compared to the conventional SRAM cell implementation
   in M3D-IC. In addition, the noise margins of the SRAM cell also improved
   for the bottom-gate transistor-based approach to the conventional SRAM
   cell design.},
Type = {Proceedings Paper},
Affiliation = {Vemuri, MS (Corresponding Author), North Dakota State Univ, Dept Elect \& Comp Engn, Fargo, ND 58105 USA.
   Vemuri, Madhava Sarma; Ahmed, Tanvir; Tida, Umamaheswara Rao, North Dakota State Univ, Dept Elect \& Comp Engn, Fargo, ND 58105 USA.},
