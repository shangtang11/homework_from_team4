Title = {Consistency-Aware and Predictable Memory Processing for Safety-Critical
   Out-of-Order Multicores},
Booktitle = {2025 IEEE 31ST REAL-TIME AND EMBEDDED TECHNOLOGY AND APPLICATIONS
   SYMPOSIUM, RTAS},
Series = {IEEE Real-Time and Embedded Technology and Applications Symposium},
Year = {2025},
Pages = {68-81},
Note = {31st Embedded Technology and Applications Symposium-RTAS-Annual, Irvine,
   CA, MAY 06-09, 2025},
Abstract = {We introduce an approach that facilitates predictable processing of
   multiple outstanding memory requests in safety-critical out-of-order
   multicores. A primary challenge addressed by this work is ensuring that
   multiple outstanding memory requests maintain a memory consistent model
   while minimizing a low worst-case latency. Adhering to a memory
   consistency model is crucial for ensuring the correctness of programs
   executed on such multicores. Our approach, termed predictable processing
   of multiple outstanding requests (PPP), Teverages micro-architectural
   enhancements to tackle this challenge. Experimental results show that
   PPP delivers speedups of 2.07x,2.79x, and 3.38x over serialization for
   2,4, and 8 cores, while maintaining the worst-case latency.},
