@inproceedings{ WOS:001323546200071,
Author = {Posso, Julien and Bois, Guy and Savaria, Yvon},
Book-Group-Author = {IEEE},
Title = {Real-Time Spacecraft Pose Estimation Using Mixed-Precision Quantized
   Neural Network on COTS Reconfigurable MPSoC},
