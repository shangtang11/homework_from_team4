   Choi, Injun; Je, Minkyu, Korea Adv Inst Sci \& Technol KAIST, Sch Elect Engn, Daejeon, South Korea.},
DOI = {10.1109/ISCAS58744.2024.10558110},
Keywords = {Reconfigurable SoC; FPGA; Dynamic partial reconfiguration; Dynamic
