@article{ WOS:001645353900019,
Author = {Prasad, Govind and Seshadri, Abhijith and Garg, Siddharth},
Title = {QRAM4Space: Dual-Node Radiation-Tolerant Quadruple SRAM for Space
   Systems},
Journal = {IEEE TRANSACTIONS ON DEVICE AND MATERIALS RELIABILITY},
Year = {2025},
Volume = {25},
Number = {4},
Pages = {802-809},
Month = {DEC},
Abstract = {High-energy neutrons, alpha particles, photons, and heavy ions pose a
   significant threat to the operation and stability of SRAMs in aerospace
   applications. These particles can considerably corrupt data,
   particularly at lower technologies, causing node upsets. Conventional 6T
   SRAMS are not capable of operating in such conditions. Instead,
   radiation-hardened by design (RHBD) SRAMs are employed. Existing RHBD
   SRAM circuits are typically capable of tolerating single-node upsets
   and, to a limited extent dual-node upsets, but they are generally
   ineffective against comprehensive dual-node upsets. This paper
   introduces a novel 14-transistor (14T) RHBD SRAM implemented in 28 nm
   CMOS technology, which robustly mitigates SNUs as well as complete
   dual-node upsets (DNUs). The proposed 14T SRAM cell achieves a low
   leakage power of 1.65 nW per cell and exhibits a significantly enhanced
   read static noise margin (RSNM). Compared to other existing RHBD
   designs, our proposal shows the least write access time of 0.17 ns,
   reduced power consumption with dynamic energy at 72 fJ/cell and 100\%
   bit recovery even in DNUs. Subsequent Monte Carlo and post-layout
   simulations confirm that the proposed SRAM design is sufficiently stable
   and robust in high radiation regions, making it suitable for space
   applications.},
Type = {Article},
Affiliation = {Prasad, G (Corresponding Author), Birla Inst Technol \& Sci, Dept Elect \& Elect Engn, Pilani 333031, Rajasthan, India.
