DOI = {10.1109/TAES.2023.3266314},
Keywords = {Decoding; Computer architecture; Program processors; Field programmable
   gate arrays; Symbols; Standards; Reliability; Decoder architecture;
   field-programmable gate array (FPGA); nonbinary low-density parity-check
