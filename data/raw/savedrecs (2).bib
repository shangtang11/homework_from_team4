@inproceedings{ WOS:001506972600287,
Author = {Lee, Seungho and Nam, Donghyun and Park, Jeongwoo},
Book-Group-Author = {IEEE},
Title = {RGHT-Q: Reconfigurable GEMM Unit for Heterogeneous-Homogeneous Tensor
   Quantization},
Booktitle = {2025 DESIGN, AUTOMATION \& TEST IN EUROPE CONFERENCE, DATE},
Series = {Design Automation and Test in Europe Conference and Exhibition},
Year = {2025},
Note = {2025 Design, Automation \& Test in Europe Conference-DATE, Lyon, FRANCE,
   MAR 31-APR 02, 2025},
Abstract = {The high computational demands of large language models (LLMs) are
   limited by the lack of GPU hardware support for heterogeneous
   quantization, which mixes integers and floating points. To address this
   limitation, we propose an LLM processing element (PE), RGHT-Q, which
   features reconfigurable general-matrix multiplication (GEMM) operations
   for both heterogeneous and homogeneous tensor quantization. The RGHT-Q
   introduces a novel design that leverages butterfly routing and
   multi-precision multipliers. As a result, we achieve significant
   performance improvements, offering 3.14x higher energy efficiency, and
   1.56x better area efficiency compared to prior designs.},
Type = {Proceedings Paper},
Affiliation = {Lee, S (Corresponding Author), Sungkyunkwan Univ, Dept Semicond Convergence Engn, Seoul, South Korea.
   Lee, Seungho; Nam, Donghyun, Sungkyunkwan Univ, Dept Semicond Convergence Engn, Seoul, South Korea.
