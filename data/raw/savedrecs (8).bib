@inproceedings{ WOS:000855969800033,
Author = {Antonov, Alexander},
Book-Group-Author = {IEEE},
Title = {Superscalar Out-of-Order RISC-V ASIP Based on Programmable Hardware
   Generator with Decoupled Computations and Flow Control},
Booktitle = {2022 11TH MEDITERRANEAN CONFERENCE ON EMBEDDED COMPUTING (MECO)},
Series = {Mediterranean Conference on Embedded Computing},
Year = {2022},
Pages = {155-158},
Note = {11th Mediterranean Conference on Embedded Computing (MECO) / 3rd Summer
   School on Cyber-Physical + Systems and Internet of Things (CPS and IoT),
   Budva, MONTENEGRO, JUN 07-10, 2022},
Abstract = {The research deals with limitations of common hardware description
   languages in abstraction and explicit implementation of generic
   microarchitectural mechanisms. Original hardware generator for
   superscalar processors with out-of-order (OoO) execution is proposed.
   This generator provides orthogonalization of selected microarchitectural
   mechanisms, including computations in execution units, transaction flow
   control, datapath width, and register management. The generator is based
   on original hardware design approach and ActiveCore framework focused on
   explicit allocation of programmable execution kernels inferred from
   microarchitectural templates. Experimental designing of superscalar OoO
   RISC-V ASIP based on this approach and framework has shown capability
   for generic, synthesizable implementation of microarchitecture-level
   hardware mechanisms with abstracted functional purpose of the design and
   competitive quality of results.},
Type = {Proceedings Paper},
Affiliation = {Antonov, A (Corresponding Author), ITMO Univ, Software Engn \& Comp Syst Fac, St Petersburg, Russia.
