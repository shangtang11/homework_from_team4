@inproceedings{ WOS:001533060100047,
Author = {Deepanjali, S. and Mahammad, Noor S. K. and Sakali, Raghavendra Kumar},
Book-Group-Author = {IEEE},
Title = {Fault Resilient Micro-Coded Control Unit for Space-Based Digital Systems},
Booktitle = {2024 28TH INTERNATIONAL SYMPOSIUM ON VLSI DESIGN AND TEST, VDAT 2024},
Series = {International Symposium on VLSI Design and Test-VDAT},
Year = {2024},
Note = {28th International Symposium on VLSI Design and Test-VDAT, Vellore,
   INDIA, SEP 01-03, 2024},
Abstract = {The deployment of SoC-based FPGAs is gaining popularity for space
   applications due to their adaptability and reconfigurability. However,
   transient faults such as Single Event Upsets (SEUs) at the control unit
   of System-on-Chips (SoCs) pose a significant threat to dependable
   systems. Ensuring the reliability of the control unit is a fundamental
   requirement for mission-critical applications, as failures can lead to
   functional breakdowns. Employing redundancy at the hardware or
   information level designed by the user, in addition to the original
   design, is widely accepted for fault tolerance against transient faults.
   In contrast, this work leverages the inherent redundancy available
   through the multicore architecture of SoCs to provide protection. Our
   proposed approach demonstrates reduced area usage of approximate to
   150\% compared to traditional methods such as Triple Modular Redundancy
   (TMR) and Error Correction Code (ECC), as shown in related work.},
