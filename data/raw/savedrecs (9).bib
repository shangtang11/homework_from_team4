@article{ WOS:000585068000001,
Author = {Al-Hamid, Ali A. and Kim, HyungWon},
Title = {Optimization of Spiking Neural Networks Based on Binary Streamed Rate
   Coding},
Journal = {ELECTRONICS},
Year = {2020},
Volume = {9},
Number = {10},
Month = {OCT},
Abstract = {Spiking neural networks (SNN) increasingly attract attention for their
   similarity to the biological neural system. Hardware implementation of
   spiking neural networks, however, remains a great challenge due to their
   excessive complexity and circuit size. This work introduces a novel
   optimization method for hardware friendly SNN architecture based on a
   modified rate coding scheme called Binary Streamed Rate Coding (BSRC).
   BSRC combines the features of both rate and temporal coding. In
   addition, by employing a built-in randomizer, the BSRC SNN model
   provides a higher accuracy and faster training. We also present SNN
   optimization methods including structure optimization and weight
   quantization. Extensive evaluations with MNIST SNNs demonstrate that the
   structure optimization of SNN (81-30-20-10) provides 183.19 times
   reduction in hardware compared with SNN (784-800-10), while providing an
   accuracy of 95.25\%, a small loss compared with 98.89\% and 98.93\%
   reported in the previous works. Our weight quantization reduces 32-bit
   weights to 4-bit integers leading to further hardware reduction of 4
   times with only 0.56\% accuracy loss. Overall, the SNN model
   (81-30-20-10) optimized by our method shrinks the SNN's circuit area
   from 3089.49 mm(2) for SNN (784-800-10) to 4.04 mm(2)-a reduction of 765
   times.},
Type = {Article},
