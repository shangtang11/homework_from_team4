@inproceedings{ WOS:001041471300119,
Author = {Dow, Hsu-Kang and Li, Tuo and Parameswaran, Sri},
Book-Group-Author = {ACM},
Title = {HWST128: Complete Memory Safety Accelerator on RISC-V with Metadata
   Compression},
Booktitle = {PROCEEDINGS OF THE 59TH ACM/IEEE DESIGN AUTOMATION CONFERENCE, DAC 2022},
Year = {2022},
Pages = {709-714},
Note = {59th ACM/IEEE Design Automation Conference (DAC) - From Chips to Systems
   - Learn Today, Create Tomorrow, San Francisco, CA, JUL 10-14, 2022},
Abstract = {Memory safety is paramount for secure systems. Pointer-based memory
   safety relies on additional information (metadata) to check validity
   when a pointer is dereferenced. Such operations on the metadata
   introduce significant performance overhead to the system. This paper
   presents HWST128, a system to reduce performance overhead by using
   hardware/software co-design. As a result, the system described achieves
   spatial and temporal safety by utilizing microarchitecture support,
   pointer analysis from the compiler, and metadata compression. HWST128 is
   the first complete solution for memory safety (spatial and temporal) on
   RISC-V. The system is implemented and tested on a Xilinx ZCU102 FPGA
   board with 1536 LUTs (+4.11\%) and 112 FFs (+0.66\%) on top of a Rocket
   Chip processor. HWST128 is 3.74x faster than the equivalent
   software-based safety system in the SPEC2006 benchmark suite while
   providing similar or better security coverage for the Juliet test suite.},
Type = {Proceedings Paper},
Affiliation = {Li, T (Corresponding Author), Univ New South Wales, Sydney, Australia.
   Dow, Hsu-Kang; Li, Tuo; Parameswaran, Sri, Univ New South Wales, Sydney, Australia.},
