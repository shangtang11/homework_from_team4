@inproceedings{ WOS:001605645000022,
Author = {Kabir, Md Arafat and Petranovic, Dusan and Peng, Yarui},
Book-Group-Author = {ACM},
Title = {Cross -Boundary Inductive Timing Optimization for 2.5D Chiplet-Package
   Co -Design},
Booktitle = {PROCEEDINGS OF THE 2021 GREAT LAKES SYMPOSIUM ON VLSI, GLSVLSI 2021},
Year = {2021},
Pages = {135-140},
Note = {2021 Great Lakes Symposium on VLSI-GLSVLSI, ELECTR NETWORK, JUN 22-25,
   2021},
Abstract = {With the popularity of 2.5D integration, an increasing number of
   chiplets are integrated into advanced system-in-package designs. In such
   systems, redistribution layer (RDL) wires become longer and denser, with
   a growing impact on system performance. However, RDL inductive impacts
   in timing analysis are ignored by the traditional CAD tools. This paper
   presents our chiplet-package co optimization flow, which can capture the
   RDL inductance impact on system performance and automatically adjust the
   JO drivers to compensate for the inductance overhead. We develop our
   extraction and timing analysis tool that models RDL wire inductive
   timing impact on 2.5D system performance within +1-1\% error. Our study
   shows 35\% signal paths through RDL violate the timing requirement
   because of the inductive impact, and remain undetected through only RC
   -based STA.},
Type = {Proceedings Paper},
Affiliation = {Kabir, MA (Corresponding Author), Univ Arkansas, Fayetteville, AR 72701 USA.
   Kabir, Md Arafat; Peng, Yarui, Univ Arkansas, Fayetteville, AR 72701 USA.
