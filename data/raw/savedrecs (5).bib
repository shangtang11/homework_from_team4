   APPLICATIONS, ICRERA 2024},
Series = {International Conference on Renewable Energy Research and Applications},
Year = {2024},
Pages = {777-780},
Note = {13th International Conference on Renewable Energy Research and
   Applications, Nagasaki, JAPAN, NOV 09-13, 2024},
Abstract = {As an initial study toward the development of a processor that achieves
   high energy efficiency by cooperating with a power supply, this paper
   implemented a vector extension of the RISC-V architecture on a
   field-programmable gate array (FPGA) and evaluated the impact of the
   extension instructions on energy efficiency. Experiments were conducted
   to measure the current flowing into the FPGA when a benchmark program
   was executed, and the results showed an average improvement in energy
   efficiency of 3.8 times.},
