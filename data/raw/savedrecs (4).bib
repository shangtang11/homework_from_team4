@inproceedings{ WOS:001253778900164,
Author = {Colagrande, Luca and Benini, Luca},
Book-Group-Author = {IEEE},
Title = {Optimizing Offload Performance in Heterogeneous MPSoCs},
Booktitle = {2024 DESIGN, AUTOMATION \& TEST IN EUROPE CONFERENCE \& EXHIBITION, DATE},
Series = {Design Automation and Test in Europe Conference and Exhibition},
Year = {2024},
Note = {27th Design, Automation and Test in Europe Conference and Exhibition
   (DATE), Valencia, SPAIN, MAR 25-27, 2024},
Abstract = {Heterogeneous multi-core architectures combine a few ``host{''} cores,
   optimized for single-thread performance, with many small
   energy-efficient ``accelerator{''} cores for data-parallel processing,
   on a single chip. Offloading a computation to the many-core acceleration
   fabric introduces a communication and synchronization cost which reduces
   the speedup attainable on the accelerator, particularly for small and
   fine-grained parallel tasks. We demonstrate that by co-designing the
   hardware and offload routines, we can increase the speedup of an
   offloaded DAXPY kernel by as much as 47.9\%. Furthermore, we show that
   it is possible to accurately model the runtime of an offloaded
   application, accounting for the offload overheads, with as low as 1\%
   MAPE error, enabling optimal offload decisions under offload execution
   time constraints.},
Type = {Proceedings Paper},
Affiliation = {Colagrande, L (Corresponding Author), Swiss Fed Inst Technol, Integrated Syst Lab, IIS, Zurich, Switzerland.
   Colagrande, Luca; Benini, Luca, Swiss Fed Inst Technol, Integrated Syst Lab, IIS, Zurich, Switzerland.},
DOI = {10.23919/DATE58400.2024.10546670},
Keywords = {heterogeneous systems; fine-grain parallelism; job offloading; manycore
   accelerators},
