@inproceedings{ WOS:000455393700014,
Author = {Wichelmann, Jan and Moghimi, Ahmad and Eisenbarth, Thomas and Sunar,
   Berk},
Book-Group-Author = {ACM},
Title = {MicroWalk: A Framework for Finding Side Channels in Binaries},
Booktitle = {34TH ANNUAL COMPUTER SECURITY APPLICATIONS CONFERENCE (ACSAC 2018)},
Year = {2018},
Pages = {161-173},
Note = {34th Annual Computer Security Applications Conference (ACSAC), San Juan,
   PR, DEC 03-07, 2018},
Abstract = {Microarchitectural side channels expose unprotected software to
   information leakage attacks where a software adversary is able to track
   runtime behavior of a benign process and steal secrets such as
   cryptographic keys. As suggested by incremental software patches for the
   RSA algorithm against variants of side-channel attacks within different
   versions of cryptographic libraries, protecting security-critical
   algorithms against side channels is an intricate task. Software
   protections avoid leakages by operating in constant time with a uniform
   resource usage pattern independent of the processed secret. In this
   respect, automated testing and verification of software binaries for
   leakage-free behavior is of importance, particularly when the source
   code is not available. In this work, we propose a novel technique based
   on Dynamic Binary Instrumentation and Mutual Information Analysis to
   efficiently locate and quantify memory based and control-flow based
   microarchitectural leakages. We develop a software framework named
   MicroWalk for side-channel analysis of binaries which can be extended to
   support new classes of leakage. For the first time, by utilizing
   MicroWalk, we perform rigorous leakage analysis of two widely-used
   closed-source cryptographic libraries: Intel IPP and Microsoft CNG. We
   analyze 15 different cryptographic implementations consisting of 112
   million instructions in about 105 minutes of CPU time. By locating
   previously unknown leakages in hardened implementations, our results
   suggest that MicroWalk can efficiently find microarchitectural leakages
   in software binaries.},
Type = {Proceedings Paper},
Affiliation = {Wichelmann, J (Corresponding Author), Univ Lubeck, Lubeck, Germany.
   Wichelmann, Jan; Eisenbarth, Thomas, Univ Lubeck, Lubeck, Germany.
   Moghimi, Ahmad; Sunar, Berk, Worcester Polytech Inst, Worcester, MA 01609 USA.},
