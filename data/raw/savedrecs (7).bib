@inproceedings{ WOS:001209675300016,
Author = {Vasireddy, Pranathi and Kavi, Krishna and Weaver, Alex and Mehta,
   Gayatri},
Book-Group-Author = {Assoc Computing Machinery},
Title = {Streaming Sparse Data on Architectures with Vector Extensions using Near
   Data Processing},
Booktitle = {PROCEEDINGS OF THE INTERNATIONAL SYMPOSIUM ON MEMORY SYSTEMS, MEMSYS
   2023},
Year = {2023},
Note = {9th International Symposium on Memory Systems (MEMSYS), Washington,, DC,
   OCT 02-05, 2023},
Abstract = {Most scientific and AI applications rely on data that is usually sparse.
   Sparsity is sometimes deliberately introduced with pruning of
   insignificant and redundant connections in the neural network layers.
   This sparse data can efficiently be represented through various
   compression formats, thereby, reducing storage footprint and eliminating
   computations with zero values. However, accessing nonzero values
   introduces extra computational overhead.
   Consider sparse matrix-dense vector multiplication (spMV), where the
   sparse matrix data is represented in Compressed Sparse Row (CSR) format.
   In CSR format sparse matrix data is stored in three arrays, capturing
   nonzero values row-wise and their corresponding positions. This
   optimized storage of nonzero values results in irregular memory loads
   during spMV, which are particularly vexing for vectorized computations
   (e.g., modern CPUs with SVE or AVX extensions, GPUs) because they do not
   exploit spatial and temporal localities. In this work, we propose a
   memory-side accelerator known as MAID (Memory-side Acceleration for
   Irregular Data), which is a simple integer unit that performs these
   irregular memory accesses and streams the aligned data to the primary
   core. The primary vectorized CPU focuses on only fetching these aligned
   values and computing multiply-accumulate operations concurrently
   alongside our MAID accelerator. To accurately evaluate the performance
   effects of our proposed accelerator in a CPU-MAID-memory system, we used
   a Gem5 extension that permits simulating near data processing (NDP)
   accelerators close to memory devices at various levels of the memory
   hierarchy. Our experimental evaluations show that when MAID is placed
   close to L2 or LLC, minimizes data transfer to L1 cache, eliminates
   cache conflicts, and thus increases energy savings. We observed
   performance gains ranging between 2.76 and 3.56 times over in-order
   SIMD-CPU and an average of 2 times for out-of-order SIMD-CPU for sparse
   matrix {*} dense vector multiplication (spMV) algorithm. We also
   evaluated our MAID with sparse matrix {*} sparse vector (spMspV) and
   observed gains as high as 5.3 times over SIMD baseline.},
Type = {Proceedings Paper},
Affiliation = {Vasireddy, P (Corresponding Author), Univ North Texas, Denton, TX 76205 USA.
   Vasireddy, Pranathi; Kavi, Krishna; Weaver, Alex; Mehta, Gayatri, Univ North Texas, Denton, TX 76205 USA.},
DOI = {10.1145/3631882.3631898},
Article-Number = {16},
Keywords = {Near-memory computing; SIMD processors; sparse linear algebra; neural
   networks; edge devices; Gem5},
