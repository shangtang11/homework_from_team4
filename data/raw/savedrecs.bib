@article{ WOS:001698723300001,
Author = {Javeed, Khalid and Gregg, David},
Title = {AT-NTT: Area-time efficient polynomial multiplication architecture for
   CRYSTALS-Kyber},
Journal = {COMPUTERS \& ELECTRICAL ENGINEERING},
Year = {2026},
Volume = {133},
Month = {MAY},
Abstract = {CRYSTALS-Kyber has been selected by NIST for Key Encapsulation Mechanism
   (KEM) as a Post-Quantum Cryptography (PQC) standard. Its deployment in
   real-world applications will soon be widespread. The internal structure
   of Kyber heavily relies on polynomial arithmetic, where polynomial
   multiplication significantly dominates the overall performance. Number
   Theoretic Transform (NTT) is used to accelerate its computation, where
   modular reduction in a modular multiplier is the most demanding
   primitive, limiting the performance of the overall scheme. We propose a
   novel, fully lookup-table (LUT)-based reduction scheme for efficiently
   computing the modular multiplication primitive. We use a novel
   negative-biased table in the third stage to simplify the final
   add/subtract. Our scheme groups bits for reduction in novel ways that
   allow the lookup tables to be implemented with fewer LUTs. Subsequently,
   a pipelined unified butterfly unit (PUBU) is developed, which is finally
   used to develop an AT-NTT, an area-time-efficient pipelined NTT/INTT
   architecture to accelerate the computation of polynomial multiplication
   in Kyber. On the Artix-7 FPGA platform, the proposed design provides
   significant improvement in area-delay product and efficiency, making it
   suitable for many PQC applications.},
Type = {Article},
Affiliation = {Javeed, K (Corresponding Author), Univ Sharjah, Dept Comp Engn, Sharjah, U Arab Emirates.
   Javeed, Khalid, Univ Sharjah, Dept Comp Engn, Sharjah, U Arab Emirates.
