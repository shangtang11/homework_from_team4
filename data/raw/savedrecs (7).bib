Affiliation = {Huemer, S (Corresponding Author), Tech Univ Wien, Vienna, Austria.
   Huemer, S.; TaheriNejad, N., Tech Univ Wien, Vienna, Austria.
   Baroughi, A. S.; Shahhoseini, H. S., Iran Univ Sci \& Technol, Tehran, Iran.
   TaheriNejad, N., Heidelberg Univ, Inst Comp Engn ZITI, Heidelberg, Germany.},
