@inproceedings{ WOS:001027444200231,
Author = {Bruns, Niklas and Herdt, Vladimir and Drechsler, Rolf},
Editor = {IEEE},
Title = {Processor Verification using Symbolic Execution: A RISC-V Case-Study},
Booktitle = {2023 DESIGN, AUTOMATION \& TEST IN EUROPE CONFERENCE \& EXHIBITION, DATE},
Series = {Design Automation and Test in Europe Conference and Exhibition},
Year = {2023},
Note = {Design, Automation and Test in Europe Conference and Exhibition (DATE),
   Antwerp, BELGIUM, APR 17-19, 2023},
Abstract = {We propose to leverage state-of-the-art symbolic execution techniques
   from the Software (SW) domain for processor verification at the
   Register-Transfer Level (RTL). In particular, we utilize an Instruction
   Set Simulator (ISS) as a reference model and integrate it with the RTL
   processor under test in a co-simulation setting. We then leverage the
   symbolic execution engine KLEE to perform a symbolic exploration that
   searches for functional mismatches between the ISS and RTL processor. To
   ensure a comprehensive verification process, symbolic values are used to
   represent the instructions and also to initialize the register values of
   the ISS and processor. As a case study, we present results on the
   verification of the open source RISC-V based MicroRV32 processor, using
   the ISS of the open source RISC-V VP as a reference model. Our results
   demonstrate that modern symbolic execution techniques are applicable to
   a full scale processor co-simulation in the embedded domain and are very
   effective in finding bugs in the RTL core.},
