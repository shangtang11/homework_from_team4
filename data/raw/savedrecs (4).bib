@inproceedings{ WOS:001268541102046,
Author = {Chong, Yi Sheng and Cao, Hongyu and Goh, Wang Ling and Bore, Patrick and
   Tan, Yuanzheng Paul and Yap, Yung Szen and Dumke, Rainer and Nambiar,
   Vishnu P. and Do, Anh Tuan},
Book-Group-Author = {IEEE},
Title = {Quantum Readout Processing Accelerator with a CORDIC Core at Cryogenic
   Temperature},
Booktitle = {2024 IEEE INTERNATIONAL SYMPOSIUM ON CIRCUITS AND SYSTEMS, ISCAS 2024},
Series = {IEEE International Symposium on Circuits and Systems},
Year = {2024},
Note = {IEEE International Symposium on Circuits and Systems (ISCAS), Singapore,
   SINGAPORE, MAY 19-22, 2024},
Abstract = {Quantum computing has been the most promising in addressing
   computational challenging problems beyond classical computers'
   capabilities. Recent work focus on developing system-on-chip (SoC) for
   quantum control and readout, yet there are scarce literature discussing
   how the measurement blocks are developed in details. This paper presents
   a quantum readout processing accelerator that operates at cryogenic
   temperature to process measurement data directly to obtain the qubit
   state. The proposed accelerator includes a coordinate rotation digital
   computer (CORDIC) based direct digital frequency synthesizer (DDFS) and
   a qubit state decision unit. To enable compact processing accelerator,
   the error of the qubit state prediction is analyzed when choosing
   different bitwidths and number of CORDIC iterations, aiming to balance
   the accuracy and hardware cost. The proposed accelerator, implemented
   using a 28-nm CMOS, consumes 36mW of power at room temperature and 8.9mW
   at 196 degrees C. The processing latency and total energy consumption
   when determining a qubit state are reduced by 6 and 3 orders of
   magnitude respectively, when compared to a general purpose processor.},
