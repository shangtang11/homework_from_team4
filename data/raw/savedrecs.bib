Keywords = {Computer architecture; Artificial neural networks; Single instruction
   multiple data; Hardware; Accuracy; Computational modeling; Adaptation
   models; Arithmetic; Throughput; Computational efficiency; Adaptive
   precision; CORDIC-driven computation; SIMD processing element; DNN
   accelerator; edge AI},
