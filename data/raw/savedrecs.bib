   Watters, Paul, Cyberstron Pty Ltd, Ballarat, Vic 3350, Australia.
   McIntosh, Timothy R., Cyberoo Pty Ltd, Surry Hills, NSW 2010, Australia.},
DOI = {10.3390/jcp5040087},
Article-Number = {87},
Keywords = {zero trust; generative AI; cybersecurity; adversarial attacks; trust
   mechanisms; AI auditing},
