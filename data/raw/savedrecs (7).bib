@inproceedings{ WOS:001283896700228,
Author = {Xu, Zheng and Zhou, Xinjie and Xiao, Zhiqiang},
Book-Group-Author = {ASSOC COMPUTING MACHINERY},
Title = {A Hardware Backup Dual-Core Lockstep for Error Checking and Recovery},
Booktitle = {PROCEEDINGS OF 2023 7TH INTERNATIONAL CONFERENCE ON ELECTRONIC
   INFORMATION TECHNOLOGY AND COMPUTER ENGINEERING, EITCE 2023},
Year = {2023},
Pages = {1357-1363},
Note = {7th International Conference on Electronic Information Technology and
   Computer Engineering (EITCE), Xiamen, PEOPLES R CHINA, OCT 20-22, 2023},
Abstract = {Dual-core Lockstep, commonly known as DCLS, is being widely used in
   various application scenarios. However, the typical checkpoint scheme
   has long check intervals, poor real-time response, also affects the
   operating efficiency of the core. This paper proposes a Dual-core
   Lockstep scheme with hardware backup and software error correction to
   improve the response speed. At the hardware level, the master and slave
   cores each share a portion of the Dual-core Lockstep hardware structure,
   and the exception handler is only responsible for memory access. The
   proposed Dual-core Lockstep scheme is implemented based on RISC-V
   processor IP, and its feasibility is verified by VCS simulation and DC
   synthesis.},
Type = {Proceedings Paper},
Affiliation = {Xiao, ZQ (Corresponding Author), China Elect Technol Grp Corp, Res Inst 58, Wuxi, Jiangsu, Peoples R China.
