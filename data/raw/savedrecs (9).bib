   Rahimi, Abbas, IBM Res Zurich, CH-8803 Zurich, Switzerland.},
DOI = {10.1109/JETCAS.2020.3031698},
Keywords = {Feature extraction; Support vector machines; Memory management;
   Convolutional neural networks; EEG; binary embedding; sparse random
   projection; SVM; binarized memory-augmented neural networks},
