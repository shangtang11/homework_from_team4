@article{ WOS:001442951900022,
Author = {Xu, Ke and Tang, Ming and Wang, Quancheng and Wang, Han},
Title = {Microarchitectural Attacks and Mitigations on Retire Resources in Modern
   Processors},
Journal = {IEEE TRANSACTIONS ON COMPUTERS},
Year = {2025},
Volume = {74},
Number = {4},
Pages = {1253-1266},
Month = {APR},
Abstract = {In modern processors, the Retire Control Unit (RCU) is responsible for
   receiving the mu ops decoded from the frontend and retiring the
   completed mu ops in order through the retirement. Consequently, the
   retirement may stall differently depending on the execution time of the
   first instruction in the RCU, causing varying stalling in the RCU
   reception. Moreover, We find that the RCU reception in AMD processors
   and retirement in Intel processors are shared between two logical cores
   of the same physical core, allowing an attacker to infer the
   instructions executed by another logical core based on its retire
   resources efficiency. Based on these findings, we introduce the
   retirement covert channel on Intel processors and the RCU covert channel
   on AMD processors. Furthermore, we explores additional applications of
   retire resources. On the one hand, we combined the misprediction penalty
   mechanism to apply our covert channels to the Spectre attacks. On the
   other hand, based on the principle that different programs result in
   varied usage patterns of retire resources, we propose an attack method
   that leverages the retire resources to infer the program run by the
   victim. Finally, we design the corresponding mitigations and extend our
   mitigation to fetch unit to reduce the performance overhead.},
Type = {Article},
Affiliation = {Tang, M (Corresponding Author), Wuhan Univ, Sch Cyber Sci \& Engn, Key Lab Aerosp Informat Securityand Trusted Comp, Minist Educ, Wuhan 430072, Peoples R China.
   Xu, Ke; Tang, Ming; Wang, Quancheng; Wang, Han, Wuhan Univ, Sch Cyber Sci \& Engn, Key Lab Aerosp Informat Securityand Trusted Comp, Minist Educ, Wuhan 430072, Peoples R China.},
DOI = {10.1109/TC.2024.3521225},
Keywords = {Retirement; Program processors; Microarchitecture; Prevention and
   mitigation; Pipelines; Bandwidth; Protection; Accuracy; Side-channel
   attacks; Decoding; retire control unit; microprocessor; information
   leakage; hardware security},
Author-Email = {kexuwhu@whu.edu.cn
   m.tang@126.com
   wangquancheng@whu.edu.cn
   han.wang@whu.edu.cn},
Affiliations = {Wuhan University},
