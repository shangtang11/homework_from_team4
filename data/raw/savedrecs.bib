@article{ WOS:001611614000001,
Author = {Dong, Yanchi and Liu, Xueping and Bai, Kangbo and Li, Guoxiang and Wu,
   Meng and Jing, Yiqi and Zhang, Yihan and Zhan, Pixian and Zhang, Yadong
   and Ma, Yufei and Huang, Ru and Jia, Tianyu and Ye, Le},
Title = {A Heterogeneous TinyML SoC With Systematic Minimum Energy Searching and
   Management for Keyword Spotting},
Journal = {IEEE JOURNAL OF SOLID-STATE CIRCUITS},
Year = {2025},
Month = {2025 NOV 4},
Abstract = {Edge AI deploys diversified AI models on resource-constrained tiny
   machine learning (TinyML) SoCs, which often have heterogeneous
   architectures, including both microprocessors and domain-specific
   accelerators. Considering the tight power and performance constraints,
   the high diversity of ML workloads and chip architectures results in
   complex chip power management. In this article, we present a low-power
   heterogeneous TinyML SoC for keyword spotting (KWS) with systematic
   minimum energy searching and management. Comprehensive fully
   synthesizable monitors are developed to be aware of the runtime energy,
   event, and performance ((EP)-P-2) for each computing block and guide the
   system-level minimum energy point (MEP) search. Hierarchical voltage
   regulation is designed with in-block power switches and on-chip
   switched-capacitor regulators. Additionally, a two-stage
   compute-in-memory (CIM)-based event-driven wake-up scheme is developed
   to reduce the standby energy. Fabricated with TSMC 55-nm technology, the
   systematic energy management approach obtains an average of 51\% energy
   saving, which is 28\% higher than single-block MEP management.
   Meanwhile, the SoC achieves a minimum power consumption of 3.5 mu W and
   a peak-to-idle power ratio of 30 000x. Overall, the presented TinyML SoC
   is suitable for edge AI applications with state-of-the-art low-power
   features.},
Type = {Article; Early Access},
Affiliation = {Jia, TY; Ye, L (Corresponding Author), Peking Univ, Beijing 100871, Peoples R China.
   Dong, Yanchi; Liu, Xueping; Bai, Kangbo; Li, Guoxiang; Wu, Meng; Jing, Yiqi; Zhang, Yihan; Ma, Yufei; Huang, Ru; Jia, Tianyu; Ye, Le, Peking Univ, Beijing 100871, Peoples R China.
