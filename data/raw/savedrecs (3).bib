@inproceedings{ WOS:001684940200073,
Author = {Tashdid, Ishraq and Saiham, Dewan and Anjum, Nafisa and Farheen, Tasnuva
   and Rahman, Sazadur},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {ECOLogic: Enabling Circular, Obfuscated, and Adaptive Logic via
   eFPGA-Augmented SoCs},
Booktitle = {2025 IEEE 43RD INTERNATIONAL CONFERENCE ON COMPUTER DESIGN, ICCD},
Series = {Proceedings IEEE International Conference on Computer Design},
Year = {2025},
Pages = {523-527},
Note = {43rd International Conference on Computer Design-ICCD-Annual,
   Richardson, TX, NOV 10-12, 2025},
Abstract = {Traditional hardware platforms, ASICs and FPGAs, offer competing
   trade-offs among performance, flexibility, and sustainability. ASICs
   provide high efficiency but are inflexible post-fabrication, require
   costly re-spins for updates, and expose IPs to piracy risks. FPGAs offer
   reconfigurability and reuse, yet suffer from substantial area, power,
   and performance overheads, resulting in higher carbon footprints. We
   present ECOLogic, a hybrid design paradigm that embeds lightweight eFPGA
   fabric within ASICs to enable secure, updatable, and resource-aware
   computation. Central to this architecture is ECOScore, a quantitative
   scoring framework that evaluates IPs based on adaptability, piracy
   threat, performance tolerance, and resource fit to guide RTL
   partitioning. Evaluated across six diverse SoC modules, ECOLogic retains
   an average of 90\% ASIC-level performance (up to 2 GHz), achieves 9.8 ns
   timing slack (versus 5.1 ns in FPGA), and reduces power by 480x on
   average. Moreover, sustainability analysis shows a 99.7\% reduction in
   deployment carbon footprint and 300-500x lower emissions relative to
   FPGA-only implementations. These results position ECOLogic as a
   high-performance, secure, and environmentally sustainable solution for
   next-generation reconfigurable systems.},
