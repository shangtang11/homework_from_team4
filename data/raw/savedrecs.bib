@article{ WOS:001639978800001,
Author = {Tong, Dian and Hu, Wei and Li, Zijuan},
Title = {Simulation of homomorphic encryption of composite power data based on
   elliptic curve digital signature algorithm},
Journal = {AIP ADVANCES},
Year = {2025},
Volume = {15},
Number = {12},
Month = {DEC 1},
Abstract = {The security and privacy of power data, which are core assets of energy
   systems, have become critical bottlenecks that restrict the development
   of new power systems, such as smart grids and the energy internet.
   Existing simulation techniques for composite power data encryption often
   suffer from high computational complexity, leading to slow processing
   speeds when dealing with large-scale power data, which makes it
   difficult to meet the real-time requirements of power system
   applications. To address this issue, a homomorphic encryption simulation
   method for composite power data is designed based on the elliptic curve
   digital signature algorithm. Smart meters enable the collection,
   measurement, and transmission of power data, while an encoding model for
   composite power data encryption is established. In addition, an advanced
   key-sharing mechanism is introduced, utilizing derived bilinear mappings
   on elliptic curves. By applying different key signatures, the proposed
   method integrates homomorphic encryption with arithmetic coding
   encryption to achieve comprehensive encryption of composite power data.
   Experimental results show that the proposed method achieves an
   encryption and decryption accuracy of over 98\%, along with high
   performance in computational and communication efficiency. Moreover, its
   anti-attack capability remains consistently above 0.98. When processing
   800-bit composite power data, the data transmission response time is 2.5
   s.},
Type = {Article},
