   Miao, Jin, Google, Mountain View, CA 94043 USA.
   Roy, Subhendu, Cadence Design Syst, Design \& Sign Grp Machine Learning Grp, San Jose, CA 95134 USA.},
DOI = {10.1109/TCAD.2021.3114262},
Keywords = {Adders; Very large scale integration; Space exploration; Delays; Tools;
   Physical design; Gaussian processes; Design space exploration; graph
   autoencoder; graph neural process; high speed adder; neural process;
   sequential model-based optimization},
Keywords-Plus = {INDICATORS},
Author-Email = {byu@cse.cuhk.edu.hk},
Affiliations = {Chinese University of Hong Kong; Chinese Academy of Sciences; University
   of Science \& Technology of China, CAS; Alphabet Inc.; Google
