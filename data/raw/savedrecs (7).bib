@inproceedings{ WOS:001108944900009,
Author = {Hedam, Niclas and Clausen, Morten Tychsen and Bonnet, Philippe and Lee,
   Sangin and Larsen, Ken Friis},
Book-Group-Author = {ACM},
Title = {Delilah: eBPF-offload on Computational Storage},
Booktitle = {19TH INTERNATIONAL WORKSHOP ON DATA MANAGEMENT ON NEW HARDWARE, DAMON
   2023},
Year = {2023},
Pages = {70-76},
Note = {19th International Workshop on Data Management on New Hardware (DaMoN),
   Seattle, WA, JUN 18-23, 2023},
Abstract = {The idea of pushing computation to storage devices has been explored for
   decades, without widespread adoption so far. The definition of
   Computational Programs namespaces in NVMe (TP 4091) might be a
   breakthrough. The proposal defines device-specific programs, that are
   installed statically, and downloadable programs, offloaded from a host
