@article{ WOS:000878171600017,
Author = {Garzon, Esteban and Teman, Adam and Lanuzza, Marco and Yavits, Leonid},
Title = {AIDA: Associative In-Memory Deep Learning Accelerator},
Journal = {IEEE MICRO},
Year = {2022},
Volume = {42},
Number = {6},
Pages = {67-75},
Month = {NOV 1},
Abstract = {This work presents an associative in-memory deep learning processor
   (AIDA) for edge devices. An associative processor is a massively
   parallel non-von Neumann accelerator that uses memory cells for
   computing; the bulk of data is never transferred outside the memory
   arrays for external processing. AIDA utilizes a dynamic content
   addressable memory for both data storage and processing, and benefits
   from sparsity and limited arithmetic precision, typical in modern deep
   neural networks. The novel in-data processing implementation designed
   for the AIDA accelerator achieves a speedup of 270x over an advanced
   central processing unit at more than three orders-of-magnitude better
   energy efficiency.},
Type = {Article},
Affiliation = {Garzón, E (Corresponding Author), Univ Calabria, IT-87036 Arcavacata Di Rende, Italy.
