Year = {2020},
Pages = {990-994},
Note = {IEEE 5th Information Technology and Mechatronics Engineering Conference
   (ITOEC), ELECTR NETWORK, JUN 12-14, 2020},
Abstract = {Heterogeneous computing of CPU-FPGA is the current research hotspot, and
   quite a few scholars have done in-depth research on FPGA heterogeneous
   computing, such as accelerated matrix multiplication, neural network,
   image analysis and other applications. This article deploys the RISC-V
   processor soft core ROCKET to the FPGA acceleration card, compiles the
   code to be run into RISC-V instructions, and runs it on the soft core
   processor implemented on the FPGA acceleration card. This method can
   avoid CPU- Frequent data exchange between FPGAs. This system selects
   ADM-PCIE-8K5 as FPGA acceleration card, implements ROCKET soft core
   processor under SDACCEL environment, and uses OpenCL C ++ to build a
   front-end server to call OpenCL API to communicate with ROCKET processor
   on FPGA acceleration card. Finally, the computing performance of the
   ROCKET soft-core processor was tested.},
Type = {Proceedings Paper},
Affiliation = {Min, SY (Corresponding Author), Wuhan Univ Technol, Sch Informat Engn, Wuhan, Peoples R China.
