   Bakas, Alexandros and Brumley, Billy Bob and Michalas, Antonis},
Editor = {Conti, M and Stevens, M and Krenn, S},
Title = {Attestation Waves: Platform Trust via Remote Power Analysis},
Booktitle = {CRYPTOLOGY AND NETWORK SECURITY, CANS 2021},
