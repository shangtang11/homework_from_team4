@inproceedings{ WOS:000687839602081,
Author = {Kuelzer, Daniel F. and Kasparick, Martin and Palaios, Alexandros and
   Sattiraju, Raja and Ramos-Canto, Oscar D. and Wieruch, Dennis and
   Tchouanken, Hugues and Goettsch, Fabian and Geuer, Philipp and
   Schwardman, Jens and Fettweis, Gerhard and Schotten, Hans D. and
   Stanczak, Slawomir},
Book-Group-Author = {IEEE},
Title = {AI4Mobile: Use Cases and Challenges of AI-based QoS Prediction for
   High-Mobility Scenarios},
Booktitle = {2021 IEEE 93RD VEHICULAR TECHNOLOGY CONFERENCE (VTC2021-SPRING)},
Series = {IEEE Vehicular Technology Conference VTC},
Year = {2021},
Note = {IEEE 93rd Vehicular Technology Conference (VTC-Spring), ELECTR NETWORK,
   APR 25-28, 2021},
Abstract = {The integration of functions into future communication systems that
   predict crucial Quality of Service (QoS) parameters is expected to
   enable many new or enhanced use cases, for example, in vehicular
   networks and Industry 4.0. Especially with high user mobility, QoS
   prediction is required in an End-to-End (E2E) fashion to guarantee
   uninterrupted connectivity and provisioning of real-time applications.
   In this paper, we present a concise list of mobility use cases, both
   from automotive and industrial production domains, that benefit from
   Artificial Intelligence-based QoS prediction. These applications are
   investigated in the publicly-funded research project AI4Mobile by a
   representative consortium of industry and academia. Based on a
   literature review, we identify the main challenges in realizing
   predictive QoS at high mobility, and we propose research directions to
   enable the envisioned E2E solutions.},
