@article{ WOS:000741381300001,
Author = {Chen, Ruiqi and Wu, Tianyu and Zheng, Yuchen and Ling, Ming},
Title = {MLoF: Machine Learning Accelerators for the Low-Cost FPGA Platforms},
Journal = {APPLIED SCIENCES-BASEL},
Year = {2022},
