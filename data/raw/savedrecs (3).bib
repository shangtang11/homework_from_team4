@inproceedings{ WOS:001511035800007,
Author = {Srichandan, Aditya and Ragheb, Omar and Anderson, Jason},
Editor = {Ueno, T and Abdelhadi, A and Koch, D and Osana, Y and Sato, Y},
Title = {Systolic Array-Based Matrix Multiplication and Reduction on Elastic
   CGRAs},
Booktitle = {PROCEEDINGS OF THE 15TH INTERNATIONAL SYMPOSIUM ON HIGHLY EFFICIENT
   ACCELERATORS AND RECONFIGURABLE TECHNOLOGIES, HEART 2025},
Year = {2025},
Pages = {67-75},
Note = {15th International Symposium on Highly Efficient Accelerators and
   Reconfigurable Technologies-HEART, Kumamoto, JAPAN, MAY 26-28, 2025},
Abstract = {Coarse-Grained Reconfigurable Arrays (CGRAs) provide a compelling
   balance between energy efficiency and computational adaptability, making
   them ideal for accelerating workloads like Matrix-Multiplication
   (MatMul) in machine learning (ML). Elastic CGRAs operate according to
   the dataflow model, where their internal primitives are connected with
   elastic channels, comprising data and handshaking signals to indicate
   data validity and to exert back-pressure. In elastic CGRAs, operations
   occur when data arrives, eliminating the need for static scheduling,
   which is attractive in scenarios when latencies are unknown in advance.
   In this work, we enhance the RIKEN elastic CGRA architecture {[}2] and
   CAD flow {[}20] to enable implementation of systolic arrays for MatMul
   and also for reduction. Systolic arrays normally exhibit precisely
   defined cycle-by-cycle behavior, which is generally not compatible with
   the dataflow paradigm, necessitating both architectural and CAD changes.
   In an experimental study, we use an MLIR-based front-end compiler {[}14]
   for ML workloads to extract MatMul and reduction tasks from ML models
   and target them for CGRA acceleration, producing an end-to-end
   MLIR-to-CGRA compilation flow. Results show average speedups of similar
   to 10.4x for the systolic array implementations over conventional MatMul
   mappings, and an average of 4x speedup for the optimized reduction
   operations.},
Type = {Proceedings Paper},
Affiliation = {Srichandan, A (Corresponding Author), Univ Toronto, Toronto, ON, Canada.
   Srichandan, Aditya; Ragheb, Omar; Anderson, Jason, Univ Toronto, Toronto, ON, Canada.},
