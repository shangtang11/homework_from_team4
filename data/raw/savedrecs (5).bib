Title = {Power Analysis on Hardware Implementation of CRYSTALS-Kyber},
Booktitle = {2024 IEEE 18TH INTERNATIONAL CONFERENCE ON ANTI-COUNTERFEITING,
   SECURITY, AND IDENTIFICATION, ASID},
Series = {Proceedings of the International Conference on Anti-counterfeiting
   Security and Identification},
Year = {2024},
Pages = {1-5},
Note = {18th IEEE International Conference on Anti-counterfeiting, Security, and
   Identification, Xiamen, PEOPLES R CHINA, NOV 01-03, 2024},
Abstract = {CRYSTALS-Kyber is a post-quantum cryptography that can effectively
   resist quantum attacks. It has been included in the draft standard by
   NIST. Therefore, it is greatly important to research the side-channel
   security of its hardware implementation. In this paper, we propose an
   optimized chosen-ciphertext power analysis method for the hardware
   implementation of the CRYSTALS-Kyber. We conducted the side-channel
   security analysis experiments using the CW305 Artix-7 FPGA and analyzed
   the experimental results. The results demonstrate that our method can
   effectively exploit the side-channel leakage information from the
   hardware implementation of CRYSTALS-Kyber, improving the accuracy of the
   attack, reducing the number of power traces required, and achieving a
   key recovery accuracy of 98.8\%.},
