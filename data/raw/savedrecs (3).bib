@inproceedings{ WOS:001506891000002,
Author = {Zhang, Weiyan and Hassan, Muhammad and Drechsler, Rolf},
Editor = {Bosio, A and Bernardi, P and Traiola, M and Mrazek, V},
Title = {LLM-assisted Performance Estimation of Embedded Software on RISC-V
   Processors},
Booktitle = {2025 IEEE 28TH INTERNATIONAL SYMPOSIUM ON DESIGN AND DIAGNOSTICS OF
   ELECTRONIC CIRCUITS AND SYSTEMS, DDECS},
Series = {IEEE International Symposium on Design and Diagnostics of Electronic
