@inproceedings{ WOS:001437393600025,
Author = {Dokic, Kristian and Mandusic, Dubravka and Blaskovic, Lucija},
Editor = {Saeed, K and Dvorsky, J},
Title = {Battle on Edge - Comparison of Convolutional Neural Networks Inference
   Speed on Two Various Hardware Platforms},
Booktitle = {COMPUTER INFORMATION SYSTEMS AND INDUSTRIAL MANAGEMENT, CISIM 2021},
Series = {Lecture Notes in Computer Science},
Year = {2021},
