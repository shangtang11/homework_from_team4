@article{ WOS:001254614100001,
Author = {Somoye, Idris O. and Plusquellic, Jim and Mannos, Tom J. and Dziki,
   Brian},
Title = {An Engineered Minimal-Set Stimulus for Periodic Information Leakage
   Fault Detection on a RISC-V Microprocessor},
Journal = {CRYPTOGRAPHY},
Year = {2024},
Volume = {8},
Number = {2},
Month = {JUN},
Abstract = {Recent evaluations of counter-based periodic testing strategies for
   fault detection in Microprocessor (mu P) have shown that only a small
   set of counters is needed to provide complete coverage of severe faults.
   Severe faults are defined as faults that leak sensitive information,
   e.g., an encryption key on the output of a serial port. Alternatively,
   fault detection can be accomplished by executing instructions that
   periodically test the control and functional units of the mu P. In this
   paper, we propose a fault detection method that utilizes an `engineered'
   executable program combined with a small set of strategically placed
   counters in pursuit of a hardware Periodic Built-In-Self-Test (PBIST).
   We analyze two distinct methods for generating such a binary; the first
   uses an Automatic Test Generation Pattern (ATPG)-based methodology, and
   the second uses a process whereby existing counter-based node-monitoring
   infrastructure is utilized. We show that complete fault coverage of all
   leakage faults is possible using relatively small binaries with low
   latency to fault detection and by utilizing only a few strategically
   placed counters in the mu P.},
Type = {Article},
Affiliation = {Somoye, IO (Corresponding Author), Univ New Mexico, Elect \& Comp Engn, Albuquerque, NM 87131 USA.
   Somoye, Idris O.; Plusquellic, Jim, Univ New Mexico, Elect \& Comp Engn, Albuquerque, NM 87131 USA.
