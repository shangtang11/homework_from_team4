@inproceedings{ WOS:001494383800045,
Author = {Wang, Yingjia and Lu, Tao and Liang, Yuhong and Chen, Xiang and Yang,
   Ming-Chang},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Reviving In-Storage Hardware Compression on ZNS SSDs through Host-SSD
   Collaboration},
Booktitle = {2025 IEEE INTERNATIONAL SYMPOSIUM ON HIGH PERFORMANCE COMPUTER
   ARCHITECTURE, HPCA},
Series = {International Symposium on High-Performance Computer
   Architecture-Proceedings},
Year = {2025},
Pages = {608-623},
Note = {2025 International Symposium on High Performance Computer
   Architecture-HPCA-Annual, Las Vegas, NV, MAR 01-05, 2025},
Abstract = {Zoned Namespace (ZNS) is an emerging SSD interface with great potential
   for performance and cost in large-scale cloud SSD deployments. Enabling
   in-storage hardware compression on ZNS SSDs is promising for further
   enhancing the cost-effectiveness of ZNS-based storage infrastructures.
   However, based on our investigation, existing solutions based on the
   host-transparent methodology are sub-optimal on ZNS SSDs due to two
   intrinsic challenges: (1) locating compressed chunks and (2) harvesting
   space savings from compression.
   In this paper, we for the first time revisit the compression storage
   system architecture on the emerging ZNS SSD and propose to decouple
   compression execution with indexing. We propose CCZNS (CC: collaborative
   compression), an advanced ZNS interface that revives in-storage hardware
   compression on ZNS SSDs through a novel host-SSD collaborative approach.
   We present how CCZNS can benefit host software by performing a case
   study on RocksDB and ZenFS. Extensive experiments demonstrate that the
   CCZNS-based storage system significantly outperforms existing system
   solutions.},
