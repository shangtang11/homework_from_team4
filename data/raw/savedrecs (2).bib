}

@inproceedings{ WOS:001537918204048,
Author = {Faruqe, Omar and Chen, Zhenghong and Bhattacharya, Suprio and Foysal,
   Md. Fahim and Hasan, Samit and Truesdell, Daniel S. and Calhoun, Benton
   H.},
Book-Group-Author = {IEEE},
Title = {A 0.36 mm2 On-the-Fly I2C-to-SPI Converter for E-Textile
   Applications},
Booktitle = {2025 IEEE INTERNATIONAL SYMPOSIUM ON CIRCUITS AND SYSTEMS, ISCAS},
Series = {IEEE International Symposium on Circuits and Systems},
Year = {2025},
Note = {2025 International Symposium on Circuits and Systems-ISCAS-Annual,
   ENGLAND, MAY 25-28, 2025},
Abstract = {This paper presents a 0.36-mm(2) I2C-to-SPI converter chip with
   on-the-fly conversion for E-textile applications. The on-the-fly
   operation eliminates the need for on-chip data buffers and clock
   generation, improving the area and power efficiency versus prior works.
   The die area is 7.33x smaller than commercially-available off-the-shelf
   (COTS) I2C-to-SPI converters, enabling it to integrate unobtrusively
   into E-textile applications. The chip supports conversion at ultra-fast
   I2C operating frequency up to 5 MHz while consuming only 0.379 mW of
   power. At the standard I2C speed of 400 kHz, it consumes 0.145 mW, which
   is 48x more power-efficient than commercially available I2C-to-SPI
   converters.},
