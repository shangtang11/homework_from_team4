@article{ WOS:001587573100001,
Author = {Ooi, Chia Yee and Mamat, Khairul Shazwan},
Title = {Review on Secure Scan Design Toward Testable Hardware Security},
Journal = {IETE TECHNICAL REVIEW},
Year = {2025},
Volume = {42},
Number = {6},
Pages = {713-739},
Month = {NOV 2},
Abstract = {Scan design, as a design-for-testability (DFT) method, has become a
   major concern for hardware security because scan chains, although
   improving a circuit's testability, can be exploited as backdoors for
   attacks such as stealing cryptographic secret keys or intellectual
   property. While several secure scan techniques have been proposed, a
   comprehensive and structured review evaluating their effectiveness and
   trade-offs remains lacking. This paper addresses this gap by
   systematically reviewing scan-based hardware security attacks and
   countermeasures. First, general hardware security threats are discussed,
   followed by a demonstration using a data encryption standard (DES) core
   to illustrate vulnerabilities introduced by scan design. We then
   highlight the importance of secure scan methods in mitigating the side
   effects of DFT on hardware security and categorize these methods into
   four groups: scan flushing, scan locking, scan obfuscation, and scan
   data encryption. The advantages and limitations of each method are
   reviewed, focusing on security, hardware overhead, and testability. By
   presenting a structured comparison, this review aims to guide
   researchers and industry practitioners in selecting appropriate secure
   scan strategies for modern integrated circuit (IC) designs.
   Additionally, potential future directions are discussed, including
   applying secure scan techniques to IEEE 1149.1 and IEEE 1500 test
   standards, and combining secure scan protections with vulnerability
   detection to further strengthen hardware security.},
Type = {Review},
Affiliation = {Ooi, CY (Corresponding Author), Univ Teknol Malaysia, Malaysia Japan Int Inst Technol, Kuala Lumpur 54100, Malaysia.
   Ooi, Chia Yee; Mamat, Khairul Shazwan, Univ Teknol Malaysia, Malaysia Japan Int Inst Technol, Kuala Lumpur 54100, Malaysia.},
DOI = {10.1080/02564602.2025.2561806},
EarlyAccessDate = {OCT 2025},
