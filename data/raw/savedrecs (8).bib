@inproceedings{ WOS:001443189100108,
Author = {Sayeeshwari, S. and Prabhu, E.},
Book-Group-Author = {IEEE},
Title = {A simple countermeasure to mitigate buffer overflow attack using
   minimalistic hardware-integrated software simulation for FPGA},
Booktitle = {2022 IEEE INTERNATIONAL CONFERENCE ON ELECTRONICS, COMPUTING AND
   COMMUNICATION TECHNOLOGIES, CONECCT},
Series = {IEEE International Conference on Electronics Computing and Communication
   Technologies},
Year = {2022},
Note = {2022 International Conference on Electronics Computing and Communication
   Technologies, Bengaluru, INDIA, JUL 08-10, 2022},
Abstract = {Buffer overflow attack in FPGAs is a persisting problem in the industry
   and various solutions to mitigate these vulnerabilities are continuously
   being addressed by manufacturers. A simple and effective mitigation
   method is proposed and simulated in Vivado using Verilog codes. Checking
   of bounds of the buffer memory, accompanied by using minimalistic number
   of logic gates as an encryption method, was simulated and demonstrated
   to successfully function as a strong countermeasure to this
   vulnerability.},
