Title = {TOWARD A SELF-POWERED MM-SCALE MEMS SENSOR PLATFORM THROUGH
   HETEROGENEOUS INTEGRATION OF SCUM AND HV SOI CMOS},
Booktitle = {2025 23RD INTERNATIONAL CONFERENCE ON SOLID-STATE SENSORS, ACTUATORS AND
   MICROSYSTEMS, TRANSDUCERS},
