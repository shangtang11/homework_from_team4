@inproceedings{ WOS:001229693800004,
Author = {Matsuo, Reoma and Degawa, Yuya and Irie, Hidetsugu and Sakai, Shuichi
   and Shioya, Ryota},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Branch Divergence-Aware Flexible Approximating Technique on GPUs},
Booktitle = {2024 IEEE SYMPOSIUM IN LOW-POWER AND HIGH-SPEED CHIPS, COOL CHIPS 27},
Series = {Proceedings for IEEE COOL CHIPS},
Year = {2024},
Note = {Symposium in Low-Power and High-Speed Chips (COOL CHIPS), Tokyo, JAPAN,
   APR 17-19, 2024},
Abstract = {Graphics Processing Units (GPUs) are widely adopted in various fields,
   attributed to their high throughput and energy efficiency. One of the
   primary challenges in GPU computing is branch divergence, which is a
   scenario that arises when the control flow among simultaneously
   processing threads diverges. This phenomenon leads to substantial
   performance degradation, as diverged threads are processed in a
   time-slice manner. To address this issue, we introduce a novel
   approximate computing approach in GPUs. Our proposed method approximates
   the outcomes of diverged threads by selectively terminating their
   execution. Additionally, this approach features a dynamic mechanism that
   adjusts both the likelihood of termination and the number of
   instructions executed prior to termination, according to user-defined
   criteria. This method enables users to finely tune the balance between
   execution speed and result fidelity, thereby providing enhanced
   flexibility in managing computational quality.},
Type = {Proceedings Paper},
Affiliation = {Matsuo, R (Corresponding Author), Univ Tokyo, Tokyo, Japan.
   Matsuo, Reoma; Degawa, Yuya; Irie, Hidetsugu; Sakai, Shuichi; Shioya, Ryota, Univ Tokyo, Tokyo, Japan.},
DOI = {10.1109/COOLCHIPS61292.2024.10531165},
