@inproceedings{ WOS:001432365500006,
Author = {Shekhawat, Diksha and Gandhi, Jugal and Santosh, M. and Pandey, Jai
   Gopal},
Editor = {Gustafson, J and Leong, SH and Michalewicz, M},
Title = {PHAc: Posit Hardware Accelerator for Efficient Arithmetic Logic
   Operations},
Booktitle = {NEXT GENERATION ARITHMETIC, CONGA 2023},
Series = {Lecture Notes in Computer Science},
Year = {2023},
Volume = {13851},
Pages = {88-100},
Note = {4th International Conference for Next Generation Arithmetic, SINGAPORE,
   MAR 01-02, 2023},
Abstract = {Arithmetic accelerators are always in demand for fast computations and
   logic operations. Here, posit arithmetic plays an important role; it
   outperforms the traditional IEEE-754 floating-point in terms of accuracy
   and dynamic range. This paper proposes efficient sequential
   architectures for the posit adder/subtractor and multiplier that work
   according to the desired bit size of operands. Here, 32-bit
   architectures with different exponent sizes (ES) have been designed with
   a control unit. FPGA implementations of these architectures have been
   performed on the Xilinx Virtex-7 xc7vx330t-3ffg1157 and the Zynq
   UltraScale + MPSoC ZCU102 device. In comparison with the existing work,
   it is observed that the datapath delay is lowered by 64.64\% for the
   32-bit adder and 52.66\% for the 32-bit multiplier on the Xilinx
   Virtex-7 FPGA device. Furthermore, the area-delay (AD) product is
   reduced by 52.69\% and 69.30\% for the 32-bit posit adder and
   multiplier, respectively. In addition, the proposed design has reduced
   dynamic power than the existing architectures.},
