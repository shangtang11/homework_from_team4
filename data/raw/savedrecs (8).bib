@inproceedings{ WOS:000934076200036,
Author = {Vacca, Eleonora and De Sio, Corrado and Azimi, Sarah},
Book-Group-Author = {ACM},
Title = {Layout-oriented Radiation Effects Mitigation in RISC-V Soft Processor},
Booktitle = {PROCEEDINGS OF THE 19TH ACM INTERNATIONAL CONFERENCE ON COMPUTING
   FRONTIERS 2022 (CF 2022)},
Year = {2022},
Pages = {215-220},
Note = {19th ACM International Conference on Computing Frontiers (CF), Turin,
   ITALY, MAY 17-19, 2022},
Abstract = {Last decade, the RISC-V soft processor has become popular due to the
   benefits such as transparency and availability of hardware
   implementations on reconfigurable devices such as SRAM-based FPGAs.
   However, these devices are highly sensitive to high-energy particles. In
   this work, we propose an implementation methodology that ranges from the
   hardening method applied at the Register Transfer Level (RTL) to the
   optimization of layout techniques acting on the place \& route of the
   design. As a case study, the TMR-hardened Arithmetic Logic Unit (ALU) of
   the RISC-V soft processor implementation was taken and its reliability
   under different design layouts has been analyzed using fault injection
