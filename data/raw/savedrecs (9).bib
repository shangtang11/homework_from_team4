Affiliation = {Pilipovic, R (Corresponding Author), Univ Ljubljana, Fac Comp \& Informat Sci, Ljubljana 1000, Slovenia.
   Lotric, Uros; Pilipovic, Ratko; Bulic, Patricio, Univ Ljubljana, Fac Comp \& Informat Sci, Ljubljana 1000, Slovenia.},
