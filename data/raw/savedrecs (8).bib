@inproceedings{ WOS:000869767400016,
Author = {Visintin, Alessandro and Toffalini, Flavio and Losiouk, Eleonora and
   Conti, Mauro and Zhou, Jianying},
Editor = {Zhou, J and Adepu, S and Alcaraz, C and Batina, L and Casalicchio, E and Chattopadhyay, S and Jin, C and Lin, J and Losiouk, E and Majumdar, S and Meng, W and Picek, S and Shao, J and Su, C and Wang, C and Zhauniarovich, Y and Zonouz, S},
Title = {HolA: Holistic and Autonomous Attestation for IoT Networks},
Booktitle = {APPLIED CRYPTOGRAPHY AND NETWORK SECURITY WORKSHOPS, ACNS 2022},
Series = {Lecture Notes in Computer Science},
Year = {2022},
Volume = {13285},
Pages = {277-296},
Note = {20th International Conference on Applied Cryptography and Network
   Security (ACNS), ELECTR NETWORK, JUN 20-23, 2022},
Abstract = {Collective Remote Attestation (CRA) is a well-established approach where
   a single Verifier attests the integrity of multiple devices in a single
   execution of the challenge-response protocol. Current CRA solutions are
   well-suited for Internet of Things (IoT) networks, where the devices are
   distributed in a mesh topology and communicate only with their physical
   neighbours. Recent advancements on low-energy protocols, though, enabled
   the IoT devices to connected to the Internet, thus disrupting the
   concept of physical neighbour. In this paper, we propose HolA (Holistic
   and Autonomous Attestation), the first CRA scheme designed for
   Internet-like IoT networks. HolA provides defence against attacks
   targeting both the nodes and the network infrastructure. We deployed
   HolA on both a network of real devices (i.e., 5 Raspberry Pis) and a
   simulated environment (i.e., 1M devices in an Omnet++ network). Our
   results demonstrate that HolA can resist against a disruptive attacker
   that compromises up to half of the network devices and that tampers with
   network traffic. HolA can verify the integrity of 1M devices in around
   12 s while the state-of-the-art requires 71 s. Finally, HolA requires 7
   times less memory per device compared with the state-of-the-art.},
Type = {Proceedings Paper},
Affiliation = {Visintin, A (Corresponding Author), Univ Padua, Padua, Italy.
   Visintin, Alessandro; Losiouk, Eleonora; Conti, Mauro, Univ Padua, Padua, Italy.
