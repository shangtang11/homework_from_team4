@inproceedings{ WOS:001687137600263,
Author = {Sun, Yucheng and Luo, Xinyu and Zhong, Tianyang and Ding, Wenhua and
   Chen, Jialong and Duan, Ruiyang and Hong, Weijie and Chen, Xinlei},
Book-Group-Author = {ACM},
Title = {Event-IR: Microsecond-Level UAV Landing via Event Camera and
   Stroboscopic Infrared Marker},
Booktitle = {COMPANION OF THE 2025 ACM INTERNATIONAL JOINT CONFERENCE ON PERVASIVE
   AND UBIQUITOUS COMPUTING, UBICOMP COMPANION 2025},
Year = {2025},
Pages = {1364-1369},
Note = {2025 International Joint Conference on Pervasive and Ubiquitous
   Computing-UbiComp Companion, Espoo, FINLAND, OCT 12-16, 2025},
Abstract = {Rapid and accurate attitude estimation plays a crucial role in the
   automatic landing system of unmanned aerial vehicles (UAVs). Current
   autonomous landing methods for drones struggle to address the challenge
   of real-time position estimation under low-light conditions and in urban
   environments with severe signal interference. To address these
   limitations, we propose Event-IR, a comprehensive hierarchical guidance
   system that integrates ground-based infrared transmitters with onboard
   event cameras in a parallel processing architecture. This system
   uniquely leverages both geometric and frequency features of event
   streams to enable real-time pose estimation. The high dynamic range and
   low latency of event cameras enable precise and rapid pose estimation by
   capturing high-frequency transmitter signals. Additionally, the infrared
   light transmitter design provides stable signal output for event cameras
   to capture even in low-light conditions. Experimental results
   demonstrate that our method achieves a 64.8\% improvement in positioning
   accuracy compared to the baseline approach.},
