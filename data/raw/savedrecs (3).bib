@inproceedings{ WOS:001576286100049,
Author = {Umezawa, Takumu and Saiki, Akihiro and Kimura, Keiji},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Enclave Application Cache for RISC-V Keystone},
Booktitle = {2025 IEEE EUROPEAN SYMPOSIUM ON SECURITY AND PRIVACY WORKSHOPS,
   EUROS\&PW},
Series = {IEEE European Symposium on Security and Privacy Workshops},
Year = {2025},
Pages = {422-428},
Note = {2025 European Symposium on Security and Privacy Workshop-EuroS\&PW,
   Venice, ITALY, JUN 30-JUL 03, 2025},
Abstract = {The development of the IoT society and the spread of cloud computing
   have also increased the number of insecure devices and vulnerable host
   OSs. We must protect the applications that deal with sensitive
   information, even from untrusted OSs. Trusted execution environment
   (TEE) technologies have attracted much attention because they enable an
   isolated, secure program execution environment from OSs. However, the
   booting phase of application execution in a TEE requires an expensive
   hash calculation in the measurement process for its executable binary
   image to guarantee its integrity. To mitigate this overhead, this paper
   proposes an enclave application cache mechanism for RISC-V Keystone, a
   representative RISC-V TEE. It bypasses the measurement process by
   storing the previously executed binary image in a secure memory space.
   The performance evaluation shows the proposed cache can achieve a 6-40x
   speedup in a TEE application's execution time.},
Type = {Proceedings Paper},
Affiliation = {Umezawa, T (Corresponding Author), Waseda Univ, Tokyo, Japan.
   Umezawa, Takumu; Saiki, Akihiro; Kimura, Keiji, Waseda Univ, Tokyo, Japan.},
