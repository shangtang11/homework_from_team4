Title = {Thanks for Nothing: Predicting Zero-Valued Activations with Lightweight
   Convolutional Neural Networks},
Booktitle = {COMPUTER VISION - ECCV 2020, PT X},
Series = {Image Processing Computer Vision Pattern Recognition and Graphics},
Year = {2020},
Volume = {12355},
Pages = {234-250},
Note = {16th European Conference on Computer Vision-ECCV-Biennial, ELECTR
   NETWORK, AUG 23-28, 2020},
Abstract = {Convolutional neural networks (CNNs) introduce state-of-the-art results
   for various tasks with the price of high computational demands. Inspired
   by the observation that spatial correlation exists in CNN output feature
   maps (ofms), we propose a method to dynamically predict whether ofm
   activations are zero-valued or not according to their neighboring
   activation values, thereby avoiding zero-valued activations and reducing
   the number of convolution operations. We implement the zero activation
   predictor (ZAP) with a lightweight CNN, which imposes negligible
   overheads and is easy to deploy on existing models. ZAPs are trained by
   mimicking hidden layer ouputs; thereby, enabling a parallel and
   label-free training. Furthermore, without retraining, each ZAP can be
   tuned to a different operating point trading accuracy for MAC reduction.},
Type = {Proceedings Paper},
Affiliation = {Shomron, G (Corresponding Author), Technion, Fac Elect Engn, Haifa, Israel.
