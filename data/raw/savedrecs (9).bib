@inproceedings{ WOS:000758415000020,
Author = {Fu, Weimin and Arias, Orlando and Jin, Yier and Guo, Xiaolong},
Book-Group-Author = {IEEE},
Title = {Fuzzing Hardware: Faith or Reality?},
Booktitle = {2021 IEEE/ACM INTERNATIONAL SYMPOSIUM ON NANOSCALE ARCHITECTURES
   (NANOARCH)},
Series = {IEEE International Symposium on Nanoscale Architectures},
Year = {2021},
Note = {IEEE/ACM International Symposium on Nanoscale Architectures (NANOARCH),
   ELECTR NETWORK, NOV 08-10, 2021},
Abstract = {Compared to software defects which can be patched in the field, hardware
   defects are permanent. As hardware iterations accelerate, a leftward
   shift in hardware testing is necessary. Among all existing techniques,
   formal methods (both automated and deductive) are the most effective
   solutions in detecting vulnerabilities in hardware. However, most of the
   existing formal methods are not scalable to large-scale designs due to
   the lack of practical automated tools. Very recently, hardware fuzzing
   solutions are proposed which treat the executable simulation code
   directly as software and test it with a Fuzz tool such as AFL or
   Symbolic Execution Engine such as KLEE. In this paper, we survey
   existing hardware fuzzing studies and discuss whether it is a valuable
   research direction to pursue. We also review these approaches by
   identifying potential challenges and gaps, based on which we present
   visions that can be performed to eliminate these challenges.},
