@article{ WOS:001577087600001,
Author = {Gao, Yuan and Yao, Liang and Wei, Xinyue and Wang, Yuhao and Huang,
   Zhengfeng and Lu, Yingchun},
Title = {High-performance approximate Booth multiplier based on novel encoding
   scheme and 4-2 compressor},
Journal = {INTERNATIONAL JOURNAL OF ELECTRONICS},
Year = {2026},
Volume = {113},
Number = {5},
Pages = {872-890},
Month = {MAY 4},
Abstract = {The development of approximate multipliers is intrinsically linked to
   the rapid advancements in technologies such as cloud computing, the
   Internet of Things (IoT), and artificial intelligence (AI), which impose
   substantial demands on computational power and energy efficiency. This
   paper introduces a novel approximate 4-2 compressor, a new approximate
   Booth encoder, and two approximate array compression schemes,
   culminating in the design of two innovative approximate Booth
   multipliers. Compared to exact multipliers, the proposed designs achieve
   significant improvements, with PDAP (Power Delay Area Product) reduced
   by 10.96\% and 39.35\% respectively.Compared to existing approximate
   multipliers, the multipliers proposed in this paper (HABM1 and HABM2)
   achieve the highest accuracy, with mean error distance (MED) of 21.04
   and 32.53, respectively. Moreover, HABM2 maintains high accuracy while
   exhibiting comparable hardware performance to other approximate
   multipliers in the comparison group, achieving an excellent trade-off
   between accuracy and hardware performance. Experimental results using a
   Gaussian filter further demonstrate the proposed multipliers' superior
   performance and validate their practical applicability in image
   processing tasks.},
Type = {Article},
Affiliation = {Yao, L (Corresponding Author), Anhui Univ, Sch Integrated Circuits, 111 Jiulong Rd, Hefei 230601, Anhui, Peoples R China.
