@inproceedings{ WOS:001554565400017,
Author = {Cuong Pham-Quoc},
Editor = {Caino-Lores, S and Zeinalipour, D and Doudali, TD and Singh, DE and Garzon, GEM and Sousa, L and Andrade, D and Cucinotta, T and D'Ambrosio, D and Diehl, P and Dolz, MF and Jukan, A and Montella, R and Nardelli, M and Garcia-Gasulla, M and Neuwirth, S},
Title = {Hardware/Software Co-design for FPGA-Based Scalable Secure Edge
   Computing Platforms},
