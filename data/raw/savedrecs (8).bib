@inproceedings{ WOS:001041471300014,
Author = {Ma, Haocheng and Zhang, Qizhi and Gao, Ya and He, Jiaji and Zhao,
   Yiqiang and Jint, Yier},
Book-Group-Author = {ACM},
Title = {PATHFINDER: Side Channel Protection through Automatic Leaky Paths
   Identification and Obfuscation},
Booktitle = {PROCEEDINGS OF THE 59TH ACM/IEEE DESIGN AUTOMATION CONFERENCE, DAC 2022},
Year = {2022},
Pages = {79-84},
Note = {59th ACM/IEEE Design Automation Conference (DAC) - From Chips to Systems
   - Learn Today, Create Tomorrow, San Francisco, CA, JUL 10-14, 2022},
Abstract = {Side-channel analysis (SCA) attacks show an enormous threat to
   cryptographic integrated circuits (ICs). To address this threat,
   designers try to adopt various countermeasures during the IC development
   process. However, many existing solutions are costly in terms of area,
   power and/or performance, and may require full-custom circuit design for
   proper implementations. In this paper, we propose a tool, namely
   PATHFINDER, to automatically identify leaky paths and protect the
   design, and is compatible with the commercial design flow. The tool
   first finds out partial logic cells that leak the most information
   through dynamic correlation analysis. PATHFINDER then exploits static
   security checking to construct complete leaky paths based on these
   cells. After leaky paths are identified, PATHFINDER will leverage proper
   hardware countermeasures, including Boolean masking and random
   precharge, to eliminate information leakage from these paths. The
   effectiveness of PATHFINDER is validated both through simulation and
   physical measurements on FPGA implementations. Results demonstrate more
   than 1000x improvements on side-channel resistance, with less than 6.53
   \% penalty to the power, area and performance.},
Type = {Proceedings Paper},
Affiliation = {Ma, HC (Corresponding Author), Tianjin Univ, Sch Microelect, Tianjin, Peoples R China.
   Ma, Haocheng; Zhang, Qizhi; Gao, Ya; He, Jiaji; Zhao, Yiqiang, Tianjin Univ, Sch Microelect, Tianjin, Peoples R China.
   Jint, Yier, Univ Florida, Dept Elect \& Comp Engn, Gainesville, FL USA.},
DOI = {10.1145/3489517.3530413},
Keywords = {CAD for Security; Side Channel Analysis; Countermeasure},
Author-Email = {hc\_ma@tju.edu.cn
   qizhi\_zhang@tju.edu.cn
   gaoyaya@tju.edu.cn
   dochejj@tju.edu.cn
   yq\_zhao@tju.edu.cn
   yier.jin@ece.ufl.edu},
