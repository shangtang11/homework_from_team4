   Srinivasan, Anuradha},
Book-Group-Author = {IEEE},
Title = {Resonant Rotary Clock Synchronization with Active and Passive Silicon
   Interposer},
Booktitle = {2022 IEEE INTERNATIONAL SYMPOSIUM ON CIRCUITS AND SYSTEMS (ISCAS 22)},
Series = {IEEE International Symposium on Circuits and Systems},
Year = {2022},
Note = {IEEE International Symposium on Circuits and Systems (ISCAS), Austin,
   TX, MAY 28-JUN 01, 2022},
Abstract = {Rotary traveling wave oscillators (RTWO) are designed to provide a high
   frequency clock signal through the silicon interposer to multiple
   chiplets in a heterogeneous 2.5D system. In particular, two different
   RTWO synchronization topologies are presented: 1) Active interposer RTWO
   and 2) passive interposer RTWO. The proposed topologies are evaluated
   across a silicon interposer with a dimension of 42 mm x 20 mm. Each
   topology is implemented with post-layout, parasitic extracted models for
   a clock frequency of approximate to 8 GHz. The performance metrics are
   presented for clock period, skew, rise time, fall time, and oscillation
   start-up and settling times across the multi-die system (MDS) with SPICE
   based simulations.},
