@article{ WOS:001692639400001,
Author = {Wu, Sheng and Wang, Yinzhen and Xiong, Puxian},
Title = {Forecasting mechanoluminescence self-recovery stability via
   optically-stimulated luminescence},
Journal = {ADVANCED POWDER MATERIALS},
Year = {2026},
Volume = {5},
Number = {4},
Month = {AUG},
Abstract = {Mechanoluminescence (ML) materials, known for the ability to convert
   mechanical energy into light, are increasingly recognized for their
   potential applications. However, current ML research mainly focuses on
   improving luminescence performance and exploring practical applications,
   while the self-recovery behavior under continuous mechanical stimuli has
   not been deeply studied. Here, based on ZnS: Cu+, ZnS: Mn2+ and SrAl2O4:
   Eu2+, Dy3+, we systematically investigated the consistent positive
   correlation relationship between ML self-recoverable response stability
   and optically-stimulated luminescence (OSL). In addition, this positive
   correlation still exists after high-temperature treatment at 573.15 K.
   Through multiple consecutive (similar to 50 times) ML and OSL response
   tests, a positive correlation between ML self-recovery ability and OSL
   stability was established: ML materials with high OSL stability may
   usually exhibit excellent ML self-recovery ability, and vice versa.
   These findings provide a convenient and quantifiable strategy for
   predicting and evaluating the long-term performance of ML materials.},
