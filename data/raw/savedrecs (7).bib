@inproceedings{ WOS:001062106700032,
Author = {Gupta, Suyash and Rahnama, Sajjad and Pandey, Shubham and Crooks,
   Natacha and Sadoghi, Mohammad},
Book-Group-Author = {ASSOC COMPUTING MACHINERY},
Title = {Dissecting BFT Consensus: In Trusted Components we Trust!},
Booktitle = {PROCEEDINGS OF THE EIGHTEENTH EUROPEAN CONFERENCE ON COMPUTER SYSTEMS,
   EUROSYS 2023},
Year = {2023},
Pages = {521-539},
Note = {18th European Conference on Computer Systems (EuroSys), Sapienza Univ
   Rome, Rome, ITALY, MAY 08-12, 2023},
Abstract = {The growing interest in reliable multi-party applications has fostered
   widespread adoption of Byzantine Fault-Tolerant (BFT) consensus
   protocols. Existing BFT protocols need f more replicas than Paxos-style
   protocols to prevent equivocation attacks. trust-BFT protocols seek to
   minimize this cost by making use of trusted components at replicas.
   This paper makes two contributions. First, we analyze the design of
   existing trust-BFT protocols and uncover three fundamental limitations
   that preclude most practical deployments. Some of these limitations are
   fundamental, while others are linked to the state of trusted components
   today. Second, we introduce a novel suite of consensus protocols,
   FLEXITRUST, that attempts to sidestep these issues. We show that our
   FlexiTrust protocols achieve up to 185\% more throughput than their
   trust-BFT counterparts.},
Type = {Proceedings Paper},
Affiliation = {Gupta, S (Corresponding Author), Univ Calif Berkeley, SkyLab, Berkeley, CA 94720 USA.
   Rahnama, Sajjad; Pandey, Shubham; Sadoghi, Mohammad, Univ Calif Davis, Exploratory Syst Lab, Davis, CA 95616 USA.
