@article{ WOS:000908213900021,
Author = {Zhu, Lingjun and Chaudhuri, Arjun and Banerjee, Sanmitra and Murali,
   Gauthaman and Vanna-Iampikul, Pruek and Chakrabarty, Krishnendu and Lim,
   Sung Kyu},
Title = {Design Automation and Test Solutions for Monolithic 3D ICs},
Journal = {ACM JOURNAL ON EMERGING TECHNOLOGIES IN COMPUTING SYSTEMS},
Year = {2022},
Volume = {18},
Number = {1},
Month = {JAN},
Abstract = {Monolithic 3D (M3D) is an emerging heterogeneous integration technology
   that overcomes the limitations of the conventional through-silicon-via
   (TSV) and provides significant performance uplift and power reduction.
   However, the ultra-dense 3D interconnects impose significant challenges
   during physical design on how to best utilize them. Besides, the unique
   low-temperature fabrication process of M3D requires dedicated
   design-for-test mechanisms to verify the reliability of the chip. In
   this article, we provide an in-depth analysis on these design and test
   challenges in M3D. We also provide a comprehensive survey of the
   state-of-the-art solutions presented in the literature. This article
   encompasses all key steps on M3D physical design, including
   partitioning, placement, clock routing, and thermal analysis and
   optimization. In addition, we provide an in-depth analysis of various
   fault mechanisms, including M3D manufacturing defects, delay faults, and
   MIV (monolithic inter-tier via) faults. Our design-for-test solutions
   include test pattern generation for pre/post-bond testing,
   built-in-self-test, and test access architectures targeting M3D.},
Type = {Article},
Affiliation = {Zhu, LG (Corresponding Author), Georgia Inst Technol, Sch Elect \& Comp Engn, Atlanta, GA 30332 USA.
