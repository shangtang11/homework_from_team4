@inproceedings{ WOS:001424381300014,
Author = {Akgun, Gokhan and Kalms, Lester and Goehringer, Diana},
Editor = {Rincon, F and Barba, J and So, HKH and Diniz, P and Caba, J},
Title = {Resource Efficient Dynamic Voltage and Frequency Scaling on Xilinx FPGAs},
