Title = {Resilience in Smart City Applications: Faults, Failures, and Solutions},
Journal = {IT PROFESSIONAL},
Year = {2020},
Volume = {22},
Number = {6},
Pages = {74-81},
Month = {NOV},
Abstract = {A smart city provides significant services to it is inhabitants.
   Continued operation of these service is critical. This article
   investigates resilience against failures in a smart city. It classifies
   applications based on their impact of service degradation. It provides
   an overview of a wide range of faults and failures that could lead to
   service degradation. It also explores strengths of existing solutions.
   The paper asserts that requirements of availability vary according to
   different applications. The paper concludes that for a cost-effective
   and feasible solution, an adaptive model is needed, which can enable
   resilience measures as per the needs of an application.},
