@inproceedings{ WOS:001533389600024,
Author = {Liu, Wei and Chen, Guang and Jiang, Jenny Xiaohong and Milligan, Ed},
Book-Group-Author = {IEEE},
Title = {Innovative Decoupling Capacitor Solutions for Power Delivery Improvement
   on Advanced FPGA Packages},
