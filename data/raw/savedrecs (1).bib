@article{ WOS:001453689300001,
Author = {Huang, Chuntian and Ye, Nini and Luo, Haijun and Shao, Hezhu and Qian,
   Weijin and Fang, Chaolong and Dong, Changkun},
Title = {Impacts of Hydrogen Adsorption on Carbon Nanotube-Metal Schottky
   Contacts},
Journal = {MATERIALS},
Year = {2025},
Volume = {18},
Number = {6},
Month = {MAR 7},
Abstract = {Carbon nanotube (CNT)-metal Schottky contacts are widely employed in
   different types of electronic devices, including field effect
   transistors (FET) and gas sensors. CNTs are normally considered stable
   on electronic properties with gas adsorptions. In this work, performance
   changes of the multi-walled carbon nanotube (MWCNT)-metal junctions
   related to hydrogen adsorptions were illustrated. MWCNT/Pd and MWCNT/Au
   Schottky junctions based resistive sensors were constructed to
   investigate the low-pressure gas sensing performances for hydrogen in
   the range of 10(-6)similar to 10(-3) Pa. Two types of sensors presented
   opposite behaviors with hydrogen adsorptions, i.e., the sensor
   resistance rose for the MWCNT/Pd sensor but dropped for the MWCNT/Au
   sensor with increasing hydrogen pressure. The work function reductions
   of Pd and CNT are considered the key cause, which could change the
   Schottky barrier properties dramatically. This behavior may play crucial
   roles for the accurate utilization of CNT-based Schottky devices.},
Type = {Article},
Affiliation = {Dong, CK (Corresponding Author), Wenzhou Univ, Wenzhou Key Lab Micronano Optoelect Devices, Wenzhou 325035, Peoples R China.
