@article{ WOS:001483706500001,
Author = {Yu, Zhonghe and He, Hualing and Zhou, Mi and Xu, Jie and Huang, Lele and
   Wang, Yudong and Mia, Md Hasib and Wan, Yuhang and Jiang, Qing and Qu,
   Xueru and Yu, Zhicai and Wang, Jinfeng},
Title = {Flame-retardant cotton-based wearable tribovoltaic nanogenerator for
   electromechanical switchover with integrated active-passive fire
   protection in firefighting clothing},
Journal = {INTERNATIONAL JOURNAL OF BIOLOGICAL MACROMOLECULES},
Year = {2025},
Volume = {310},
Number = {4},
Month = {MAY},
Abstract = {Sustainable cotton-based direct-current (DC) tribovoltaic nanogenerators
   (TVNGs) show promise for firefighting wearables due to their inherent
   comfort and DC output without requiring rectification. However,
   integrating flame retardancy with high-temperature alarm functions
   remains challenging. Herein, a cotton fabric-based TVNG was developed
   with polypyrrole/phytic acid/cotton (PPC) and aluminum slider as
   friction layers while the phytic acid/MXene/cotton (PMC) conductive
   fabric was assembled into TVNG as electrode layers. Under the built-in
   electric field, a potential energy difference and DC flux are formed
   between aluminum slider and PPC in TVNG, which outputs a peak voltage of
   0.56 V with a sliding speed of 10 cm s-1 under 9 N contact pressures.
   Furthermore, the resulting TVNG also achieve self-protection ability
   through passive flame retardant (Limiting oxygen index of PPC 32.5 \%
   and PMC 32.3 \%) and active high temperature alarm based on a linear
   relationship between output thermoelectric voltage and temperature
   difference on fire ground. The TVNG's PMC-PPC generates 1.61 mV at Delta
   T = 100 K, triggering a high-temperature alarm within 2 s to prevent
   firefighting clothing damage. This work presents a wearable TVNG design
   that collects energy during sliding and integrates both active and
   passive fire protection functions, enhancing the safety of TVNG in fire
   scenes.},
Type = {Article},
