@inproceedings{ WOS:001568944200036,
Author = {Riedel, Samuel and Zhang, Yichao and Bertuletti, Marco and Benini, Luca},
Book-Group-Author = {IEEE},
Title = {Optimizing Scalable Multi-Cluster Architectures for Next-Generation
   Wireless Sensing and Communication},
Booktitle = {2025 10TH INTERNATIONAL WORKSHOP ON ADVANCES IN SENSORS AND INTERFACES,
   IWASI},
Series = {International Workshop on Advances in Sensors and Interface},
Year = {2025},
Pages = {208-213},
Note = {10th International Workshop on Advances in Sensors and
   Interfaces-IWASI-Annual, Manfredonia, ITALY, JUL 03-04, 2025},
Abstract = {Next-generation wireless technologies (for immersivemassive
   communication, joint communication and sensing) demand highly parallel
   architectures for massive data processing. A common architectural
   template scales up by grouping tens to hundreds of cores into
   shared-memory clusters, which are then scaled out as multi-cluster
   manycore systems. This hierarchical design, used in GPUs and
   accelerators, requires a balancing act between fewer large clusters and
   more smaller clusters, affecting design complexity, synchronization,
   communication efficiency, and programmability. While all multi-cluster
   architectures must balance these trade-offs, there is limited insight
   into optimal cluster sizes. This paper analyzes various cluster
   configurations, focusing on synchronization, data movement overhead, and
   programmability for typical wireless sensing and communication
   workloads. We extend the open-source shared-memory cluster MemPool into
   a multi-cluster architecture and propose a novel double-buffering
   barrier that decouples processor and DMA. Our results show a single
   256-core cluster can be twice as fast as 16 16-core clusters for
   memory-bound kernels and up to 24\% faster for compute-bound kernels due
   to reduced synchronization and communication overheads.},
Type = {Proceedings Paper},
Affiliation = {Riedel, S (Corresponding Author), Swiss Fed Inst Technol, IIS, Zurich, Switzerland.
   Riedel, Samuel; Zhang, Yichao; Bertuletti, Marco; Benini, Luca, Swiss Fed Inst Technol, IIS, Zurich, Switzerland.
