@inproceedings{ WOS:001704661700058,
Author = {Li, Zhenghao and Chen, Xingchi and Chen, Yanli and Wang, Zhigang and He,
   Yuyu and Lu, Hui},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Unveiling Directed Gray-Box Fuzzing: A Profound Insight from
   Foundational Principles to Future Frontiers},
Booktitle = {2025 IEEE 10TH INTERNATIONAL CONFERENCE ON DATA SCIENCE IN CYBERSPACE,
   DSC},
Year = {2025},
Pages = {464-471},
Note = {10th International Conference on Data Science in Cyberspace-DSC,
   Baoding, PEOPLES R CHINA, AUG 15-17, 2025},
Abstract = {Gray-box fuzzing plays a key role in software quality assurance due to
   its scalability and practicality. However, mainstream coverage-guided
   fuzzing face efficiency bottlenecks: the blind pursuit of high coverage
   often leads to resource waste because large amount of covered code
   usually contains no substantial defects. Different from traditional
   methods, Directed Gray-box Fuzzing (DGF) focuses core testing resources
   on predefined key targets (such as high-risk vulnerability areas)
   through a dynamic resource allocation algorithm, and introduces an
   intelligent filtering mechanism to avoid invalid path exploration. This
   goal-oriented strategy has shown unique advantages in scenarios such as
   patch verification, vulnerability reproduction, and abnormal behavior
   detection. Given that DGF has become a research hotpot in the field of
   software security testing, this paper systematically analyzes
   state-of-the-art papers over the recent three years and summarizes the
   latest progress in popular research directions such as multi-objective
   processing and reduction of invalid exploration. By analyzing the
   advantages and disadvantages of DGF research, we aim to identify new
   research opportunities and propose future research directions.},
Type = {Proceedings Paper},
Affiliation = {Chen, YL (Corresponding Author), Guangzhou Univ, Cyberspace Inst Adv Technol, Guangzhou, Peoples R China.
