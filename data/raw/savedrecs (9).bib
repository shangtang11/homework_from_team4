@inproceedings{ WOS:000758464500011,
Author = {Gao, Wanling and Tang, Fei and Zhan, Jianfeng and Wen, Xu and Wang, Lei
   and Cao, Zheng and Lan, Chuanxin and Luo, Chunjie and Liu, Xiaoli and
   Jiang, Zihan},
