@article{ WOS:001220746500001,
Author = {Yang, Jie and Li, Chunbiao and Zhang, Qian and Zhong, Haidong and Wu,
   Zhihao and Liu, Peiqiao and Liu, Zuohua and Huang, Keyu and Tao,
   Changyuan and Zheng, Guocan and Yang, Yong and Wei, Hanke},
Title = {Hyperchaotic power with wide current variation for efficient manganese
   electrodeposition},
Journal = {CHEMICAL ENGINEERING SCIENCE},
Year = {2024},
Volume = {293},
Month = {JUL 5},
Abstract = {A practical hyperchaotic circuit has been designed, which has further
   been successfully applied to the manganese metal electrolysis system,
   replacing the traditional direct current power to alter the dynamic
   system of electrolysis process. The results illustrate that the
   hyperchaotic current can significantly suppress the electrochemical
   oscillation. Therefore, the growth of manganese (Mn) dendrites in the
   cathode can be significantly suppressed by the ultra - wide chaotic
   current fluctuation because of the regulation of electronic dynamic
   system. In addition, the distribution of manganese dendrites is
   quantified for the first time through image analysis, processing, and
   calculation. Besides, the hyperchaotic current can also considerably
   improve the current efficiency with 2 \% increasing and reduce the
   energy consumption about 0.3 kW \& sdot; h/kg simultaneously. It also
   demonstrates some advantages of chaotic current electrodeposition
   technology by conducting a larger -scale chaotic current electrolysis
   experiment.},
