   Sun, Changyin, Anhui Univ, Sch Artificial Intelligence, Hefei, Peoples R China.},
DOI = {10.1109/DAC63849.2025.11132429},
Keywords = {IR drop prediction; Convolutional neural network; Graph neural network;
   Heterogeneous fusion},
