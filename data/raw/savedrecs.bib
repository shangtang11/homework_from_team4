@article{ WOS:001720409000001,
Author = {Basile, Alfio and Imperato, Nicola and Andronaco, Sonia and Castellano,
   Marco and Grasso, Alfio Dario},
Title = {Self-Timed Asynchronous RISC-V Microprocessor for Contactless Cards},
Journal = {ELECTRONICS LETTERS},
Year = {2026},
Volume = {62},
Number = {1},
Month = {MAR 20},
Abstract = {Contactless smart cards operate using power harvested through inductive
   coupling, which requires the use of extremely low-power, supply-tolerant
   digital architectures. This work presents a self-timed RISC-V RV32I
   microprocessor that replaces the global clock with an asynchronous
   finite state machine based on a handshake protocol. This control scheme
   naturally adapts to supply voltage fluctuations, reducing both average
   and peak power consumption while ensuring the microprocessor operates
   robustly under variable conditions. The microprocessor was fabricated
   using a CMOS process and was then compared with equivalent synchronous
   implementations.},
Type = {Article},
Affiliation = {Basile, A (Corresponding Author), STMicroelectronics, APMS A\&M R\&D IC DESIGN, Catania, Italy.
