@article{ WOS:000525250100002,
Author = {Hisama, Kaoru and Chiashi, Shohei and Maruyama, Shigeo and Okada, Susumu},
Title = {Energetics and electronic structures of single walled carbon nanotubes
   encapsulated in boron nitride nanotubes},
Journal = {APPLIED PHYSICS EXPRESS},
Year = {2020},
