@article{ WOS:001638244500001,
Author = {Zhang, Junyan and Wang, Quanyu and Wang, Haoran and Li, Dongqing and
   Song, Yongxin and Zhang, Jundong},
Title = {Self-powered underwater conductive object identification with a
   contact-potential-difference (CPD) tactile sensor},
Journal = {MEASUREMENT},
Year = {2026},
Volume = {261},
Month = {FEB 17},
Abstract = {The reliable identification of underwater conductive objects using a
   tactile sensor is greatly needed for an underwater robot, yet it remains
   challenging as conventional sensors often require external power and are
   susceptible to high hydrostatic aquatic environment. To address this
   challenge, this paper presents a self-powered tactile sensor based on
   contact-potential-difference (CPD) effect-a mechanism previously
   unexploited for underwater robotic tactile identification of conductive
   materials. The proposed sensor innovatively utilizes the inherent work
   function difference between the sensing electrode (SE) and the target
   object to generate a current signal upon contact. Experimental results
   demonstrate that the sensor can rapidly (response time: similar to 30
   ms) distinguish different conductive materials based on the signal's
   magnitude and direction, which is correlated with the work function
   difference between the conductive object and the SE. The magnitudes of
   the signals increase with the increase in the contacting area,
   conductive object surface area. The sensing performance is not affected
   by grounding or water depth. As a proof-of-concept application,
   successful integration of this sensor into a robotic manipulator for the
   accurate identification of underwater conductive objects has been
   established, showcasing its potential for challenging autonomous
   underwater tasks.},
Type = {Article},
