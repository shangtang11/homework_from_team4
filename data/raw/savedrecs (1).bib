@article{ WOS:001576695500001,
Author = {Tang, Yuanjun and Zhu, Huiping and Wang, Chengcheng and Bu, Jianhui and
   Li, Mengda and Zhou, Hongshan and Zhang, Jing and Ma, Yingqi and Wu,
   Zhenping and Liu, Fanyu and Wang, Lei and Zhu, Maguang and Li, Bo},
Title = {High-efficiency removal of surface adsorbates on carbon nanotubes via
   electron irradiation},
Journal = {JOURNAL OF ALLOYS AND COMPOUNDS},
Year = {2025},
Volume = {1041},
Month = {OCT 10},
Abstract = {Carbon nanotube field-effect transistors (CNT-FETs) are promising for
   next-generation integrated circuits, but their performance and
   uniformity are severely hampered by surface adsorbates. This study
   introduces an effective technique for adsorbate removal using 3 MeV
   high-energy electron irradiation. X-ray photoelectron spectroscopy (XPS)
   and time-of-flight secondary ion mass spectrometry (TOF-SIMS) identified
   hydroxyl groups and oxygen molecules as the primary adsorbates and
   confirmed their removal post-irradiation. Crucially, the preservation of
   the CNTs' structural integrity at an optimal fluence of 5.75 x 10(13) e
   cm(-2) was directly verified by scanning electron microscopy (SEM),
   which revealed pristine nanotube structures. In contrast, atomic force
   microscopy (AFM) analysis confirmed that higher fluences induce tangible
   structural damage, thereby establishing a clear processing window for
   selective cleaning. This high selectivity arises because low-energy
   transfer from inelastic scattering is sufficient to desorb adsorbates
   but not enough to break robust C-C bonds through rare knock-on events.
   At the optimal fluence, CNT-FETs demonstrated significantly enhanced
   electrical properties, including a 51.2 \% increase in carrier mobility
   and a marked reduction in subthreshold swing. Most importantly, the
   treatment drastically improved device-to-device uniformity, reducing the
   standard deviation of transfer characteristics by up to 73.6 \%. Our
   work establishes high-energy electron irradiation as a dual-function
   technique that not only cleans the CNT surface but also homogenizes
   device performance, offering a viable path to reliable carbon-based
   electronics.},
Type = {Article},
