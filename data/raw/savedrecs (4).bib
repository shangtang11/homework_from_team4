Affiliation = {Alshaer, I (Corresponding Author), Univ Grenoble Alpes, Grenoble INP, LCIS, F-26000 Valence, France.
   Alshaer, Ihab; Al-Kaf, Ahmed; Egloff, Valentin; Beroulle, Vincent, Univ Grenoble Alpes, Grenoble INP, LCIS, F-26000 Valence, France.},
