   Li, Wei and Guo, Qi and Chen, Yunji},
Editor = {Salakhutdinov, R and Kolter, Z and Heller, K and Weller, A and Oliver, N and Scarlett, J and Berkenkamp, F},
Title = {AutoOS: Make Your OS More Powerful by Exploiting Large Language Models},
Booktitle = {INTERNATIONAL CONFERENCE ON MACHINE LEARNING},
