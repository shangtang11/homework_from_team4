   Suzaki, Kuniyasu, Inst Informat SECur IISEC, Yokohama 2210835, Japan.},
DOI = {10.1109/ACCESS.2024.3366344},
Keywords = {Linux; Servers; Image edge detection; Semantics; Runtime; Trust
