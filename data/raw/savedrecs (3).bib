@article{ WOS:001308507100001,
Author = {Fu, Xuemei and Cheng, Wen and Wan, Guanxiang and Yang, Zijie and Tee,
   Benjamin C. K.},
Title = {Toward an AI Era: Advances in Electronic Skins},
Journal = {CHEMICAL REVIEWS},
Year = {2024},
Volume = {124},
Number = {17},
Pages = {9899-9948},
Month = {AUG 28},
Abstract = {Electronic skins (e-skins) have seen intense research and rapid
   development in the past two decades. To mimic the capabilities of human
   skin, a multitude of flexible/stretchable sensors that detect
   physiological and environmental signals have been designed and
   integrated into functional systems. Recently, researchers have
   increasingly deployed machine learning and other artificial intelligence
   (AI) technologies to mimic the human neural system for the processing
   and analysis of sensory data collected by e-skins. Integrating AI has
   the potential to enable advanced applications in robotics, healthcare,
   and human-machine interfaces but also presents challenges such as data
   diversity and AI model robustness. In this review, we first summarize
   the functions and features of e-skins, followed by feature extraction of
   sensory data and different AI models. Next, we discuss the utilization
   of AI in the design of e-skin sensors and address the key topic of AI
   implementation in data processing and analysis of e-skins to accomplish
   a range of different tasks. Subsequently, we explore hardware-layer
   in-skin intelligence before concluding with an analysis of the
   challenges and opportunities in the various aspects of AI-enabled
   e-skins.},
Type = {Review},
Affiliation = {Tee, BCK (Corresponding Author), Natl Univ Singapore, Dept Mat Sci \& Engn, Singapore 117575, Singapore.
   Tee, BCK (Corresponding Author), Natl Univ Singapore, Inst Hlth Innovat \& Technol, Singapore 119276, Singapore.
