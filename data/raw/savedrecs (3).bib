@inproceedings{ WOS:001540479400005,
Author = {Welling, Tarick and Gay, Maeel and Polian, Ilia},
Book-Group-Author = {IEEE},
Title = {Multi Coefficient CPA on a Black Box Hardware Implementation of
   CRYSTALS-Kyber},
Booktitle = {2025 IEEE EUROPEAN TEST SYMPOSIUM, ETS},
Series = {Proceedings of the European Test Symposium},
Year = {2025},
Note = {2025 European Test Symposium-ETS-Annual, Tallinn, ESTONIA, MAY 26-30,
   2025},
Abstract = {With the emergence of quantum computers, the need for new quantum safe
   encryption schemes has arisen. These post quantum cryptographic
   primitives need to be implemented and evaluated, especially when they
   are implemented at the hardware level. In particular, their side-channel
   vulnerabilities must be assessed. Prior research effort has focused on
   software based implementations, while parallel architectures, such as
   FPGAs, remain relatively unexplored. In this paper, we attack
   CRYSTALS-kyber, adopted by the NIST as ML-KEM, implemented on an FPGA.
   We perform a CPA attack on a black box HLS implementation of kyber which
   is provided by Thales GmbH. We are able to recover the full secret key
   within only a few hours of analysis thanks to the parallelizable nature
   of our attack. To our knowledge, no prior research has been published
   which shows full recovery in a complete black box scenario, using only
   power analysis. In addition, we provide a new methodology to leverage
   leakages at multiple time points within a single correlation model in
   order to improve the attack effectiveness. Due to the structure of
   kyber, this methodology could be of further interest, as it can be
   applied across multiple models, since multiple computations dependent on
   the same secret values are performed.},
Type = {Proceedings Paper},
Affiliation = {Welling, T (Corresponding Author), Thales SIX, Ditzingen, Germany.
