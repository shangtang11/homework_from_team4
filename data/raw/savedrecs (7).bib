@inproceedings{ WOS:001339376400011,
Author = {Koshiba, Atsushi and Gust, Felix and Pritzi, Julian and
   Vahldiek-Oberwagner, Anjo and Santos, Nuno and Bhatotia, Pramod},
Book-Group-Author = {ACM},
Title = {Trusted Heterogeneous Disaggregated Architectures},
Booktitle = {PROCEEDINGS OF THE 14TH ACM SIGOPS ASIA-PACIFIC WORKSHOP ON SYSTEMS,
   APSYS 2023},
Year = {2023},
Pages = {72-79},
Note = {14th ACM SIGOPS Asia-Pacific Workshop on Systems (APSys), Seoul, SOUTH
   KOREA, AUG 24-25, 2023},
Abstract = {The rising performance demands and increasing heterogeneity in cloud
   data centers lead to a paradigm shift in the cloud infrastructure, from
   monolithic servers to a disaggregated architecture. In a multi-tenant
   cloud, users should be able to leverage trusted computing to protect
   their applications from untrusted parties. While Trusted Execution
   Environments (TEEs) are a well-known technique to realize trusted
   computing on monolithic servers, we cannot adopt existing TEE
   technologies to the disaggregated architecture due to their distributed
   nature and heterogeneity of devices. To address these challenges, we
   propose trusted heterogeneous disaggregated architectures, which allows
   cloud users to construct virtual TEEs (vTEEs): TEE-based, secure,
   isolated environments assembled with any combination of disaggregated
   components.},
Type = {Proceedings Paper},
Affiliation = {Koshiba, A (Corresponding Author), Tech Univ Munich, Munich, Germany.
