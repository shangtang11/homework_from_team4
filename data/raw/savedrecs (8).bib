@inproceedings{ WOS:001515575200027,
Author = {Pohjola, Johannes Aman and Gomez-Londono, Alejandro and Shaker, James
   and Norrish, Michael},
Editor = {Andronick, J and DeMoura, L},
Title = {Kalas: A Verified, End-To-End Compiler for a Choreographic Language},
Booktitle = {13TH INTERNATIONAL CONFERENCE ON INTERACTIVE THEOREM PROVING, ITP 2022},
Series = {Leibniz International Proceedings in Informatics},
Year = {2022},
Volume = {237},
Note = {13th International Conference on Interactive Theorem Proving-ITP, Haifa,
   ISRAEL, AUG 07-10, 2022},
Abstract = {Choreographies are an abstraction for globally describing deadlock-free
   communicating systems. A choreography can be compiled into multiple
   endpoints preserving the global behavior, providing a path for concrete
   system implementations. Of course, the soundness of this approach hinges
   on the correctness of the compilation function. In this paper, we
   present a verified compiler for Kalas, a choreographic language. Its
   machine-checked end-to-end proof of correctness ensures all generated
   endpoints adhere to the system description, preserving the top-level
   communication guarantees. This work uses the verified CakeML compiler
   and Hol4 proof assistant, allowing for concrete executable
   implementations and statements of correctness at the machine code level
   for multiple architectures.},
