@article{ WOS:000730175900006,
Author = {Liu, Ke and Wang, Jing-Yi and Wei, Qiang and Zhang, Zhen-Yong and Sun,
   Jun and Ma, Rong-Kuan and Deng, Rui-Long},
Title = {HRPDF: A Software-Based Heterogeneous Redundant Proactive Defense
   Framework for Programmable Logic Controller},
Journal = {JOURNAL OF COMPUTER SCIENCE AND TECHNOLOGY},
Year = {2021},
Volume = {36},
Number = {6},
Pages = {1307-1324},
Month = {DEC},
Abstract = {Programmable logic controllers (PLCs) play a critical role in many
   industrial control systems, yet face increasingly serious cyber threats.
   In this paper, we propose a novel PLC-compatible software-based defense
   mechanism, called Heterogeneous Redundant Proactive Defense Framework
   (HRPDF). We propose a heterogeneous PLC architecture in HRPDF, including
   multiple heterogeneous, equivalent, and synchronous runtimes, which can
   thwart multiple types of attacks against PLC without the need of
   external devices. To ensure the availability of PLC, we also design an
   inter-process communication algorithm that minimizes the overhead of
   HRPDF. We implement a prototype system of HRPDF and test it in a
   real-world PLC and an OpenPLC-based device, respectively. The results
   show that HRPDF can defend against multiple types of attacks with
   10.22\% additional CPU and 5.56\% additional memory overhead, and about
   0.6 ms additional time overhead.},
