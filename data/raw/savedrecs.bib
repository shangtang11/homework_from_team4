@article{ WOS:001673759200045,
Author = {Kang, Jeonghwan and Kang, Seungmin and Kim, Euijun and Park, Jaeseon and
   Kim, Kyounghwan and Kwon, Donghyun},
Title = {SERA: Secure Micro XRCE-DDS Establishment With Remote Attestation for
   Micro-ROS},
Journal = {IEEE ACCESS},
Year = {2026},
Volume = {14},
Pages = {12028-12042},
Abstract = {The Robot Operating System 2 (ROS 2) ecosystem and its embedded variant
   micro-ROS are increasingly used in Cyber-Physical Systems (CPS) on
   Microcontroller Units (MCUs). micro-ROS clients communicate through the
   Data Distribution Service (DDS) profile for eXtremely
   Resource-Constrained Environments (XRCE-DDS), but this middleware has no
   built-in way to verify client firmware integrity before nodes join the
   network, so a compromised client can join and disseminate malicious
   data. Existing mechanisms such as secure boot and Trusted Platform
   Module (TPM)-based remote attestation let verifiers check that a device
   boots an expected image, but they usually require dedicated TPM hardware
   and are ill-suited to low-end MCU-based platforms. MCU attestation
   schemes have been proposed, but they largely remain research prototypes
   and are not integrated with ROS 2 or XRCE-DDS, so micro-ROS lacks a
   standard way to enforce firmware integrity at network admission time. In
   this paper, we propose SERA, a secure mechanism that embeds remote
   attestation into the Micro XRCE-DDS handshake, requiring each client to
   prove its firmware integrity before joining the DDS network. SERA
   leverages Roots of Trust, including the Device Identifier Composition
   Engine (DICE), Arm Platform Security Architecture (Arm PSA), the Memory
   Protection Unit (MPU), and Arm TrustZone-M to offer isolation profiles
   on MCUs. On a NUCLEO-L552ZE-Q board, SERA adds handshake latency of
   380-795 ms and increases initialization time and firmware size compared
   to a baseline without attestation, while keeping startup overheads
   practical. In targeted experiments, SERA successfully prevents firmware
   tampering and replay attacks from joining the DDS network.},
Type = {Article},
Affiliation = {Kwon, D (Corresponding Author), Pusan Natl Univ, Sch Comp Sci \& Engn, Pusan, South Korea.
   Kang, Jeonghwan, Pusan Natl Univ, Dept Informat Convergence Engn, Pusan, South Korea.
   Kang, Seungmin; Kim, Euijun; Park, Jaeseon; Kim, Kyounghwan; Kwon, Donghyun, Pusan Natl Univ, Sch Comp Sci \& Engn, Pusan, South Korea.},
