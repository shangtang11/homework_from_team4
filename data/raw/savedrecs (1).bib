@article{ WOS:001507873500001,
Author = {Liu, Siqi and Wei, Songtao and Yao, Peng and Wu, Dong and Jie, Lu and
   Pan, Sining and Tang, Jianshi and Gao, Bin and Qian, He and Wu, Huaqiang},
Title = {A 28 nm 576K RRAM-based computing-in-memory macro featuring hybrid
   programming with area efficiency of 2.82 TOPS/mm2},
Journal = {JOURNAL OF SEMICONDUCTORS},
Year = {2025},
Volume = {46},
Number = {6},
Month = {JUN 1},
Abstract = {Computing-in-memory (CIM) has been a promising candidate for
   artificial-intelligent applications thanks to the absence of data
   transfer between computation and storage blocks. Resistive random access
   memory (RRAM) based CIM has the advantage of high computing density,
   non-volatility as well as high energy efficiency. However, previous CIM
   research has predominantly focused on realizing high energy efficiency
   and high area efficiency for inference, while little attention has been
   devoted to addressing the challenges of on-chip programming speed, power
   consumption, and accuracy. In this paper, a fabricated 28 nm 576K
   RRAM-based CIM macro featuring optimized on-chip programming schemes is
   proposed to address the issues mentioned above. Different strategies of
   mapping weights to RRAM arrays are compared, and a novel direct-current
   ADC design is designed for both programming and inference stages.
   Utilizing the optimized hybrid programming scheme, 4.67x programming
   speed, 0.15x power saving and 4.31x compact weight distribution are
   realized. Besides, this macro achieves a normalized area efficiency of
   2.82 TOPS/mm2 and a normalized energy efficiency of 35.6 TOPS/W.},
Type = {Article},
Affiliation = {Yao, P (Corresponding Author), Tsinghua Univ, Sch Integrated Circuits, Beijing 100083, Peoples R China.
   Liu, Siqi; Wei, Songtao; Yao, Peng; Wu, Dong; Jie, Lu; Pan, Sining; Tang, Jianshi; Gao, Bin; Qian, He; Wu, Huaqiang, Tsinghua Univ, Sch Integrated Circuits, Beijing 100083, Peoples R China.
