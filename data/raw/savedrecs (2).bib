@inproceedings{ WOS:001553566500001,
Author = {Ferretti, Lorenzo and Bandlamudi, Surya Teja and Athreyas, Nihar and
   Yan, Michael and Narayan, Vikram and Mittal, Samir},
Book-Group-Author = {IEEE},
Title = {CTGAN-Bandit: A Conditional Tabular GAN Model Leveraging Upper
   Confidence Bound Estimators for Hardware Design Verification},
Booktitle = {2025 IEEE WORKSHOP ON MICROELECTRONICS AND ELECTRON DEVICES, WMED},
Series = {IEEE Workshop on Microelectronics and Electron Devices},
Year = {2025},
Pages = {1-4},
Note = {2025 Workshop on Microelectronics and Electron Devices-WMED-Annual,
   Boise, ID, MAR 28, 2025},
Abstract = {Constrained Random Verification (CRV) is the de facto standard in ASIC
   design flow. Parametrized tests are simulated to exercise different
   execution paths of a Design Under Tests (DUT). These tests are simulated
   multiple times to generate different test scenarios, by leveraging
   constrained random stimulus generation. In this work, we propose a
   methodology utilizing Conditional Tabular Generative Adversarial Network
   (CTGAN) methodology, conditioned by Upper Confidence Bound (UCB)
   acquisition function as a reward. The combination of CTGAN and UCB
   allows the selection of the most relevant test parameters to efficiently
   navigate the test space and generate new tests. Our methodology,
   evaluated in live industrial projects, is able to generate new tests,
   and achieve higher coverage with respect to the baseline generated from
   the test suite manually created by experienced DV engineers, resulting
   in an overall coverage improvement of 2.3\%.},
Type = {Proceedings Paper},
Affiliation = {Ferretti, L (Corresponding Author), Micron Technol, San Jose, CA 95134 USA.
