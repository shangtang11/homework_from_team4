@inproceedings{ WOS:001476945200096,
Author = {Jiang, Limin and Shi, Yi and Liu, Yintao and Deng, Qingyu and Xu, Siyi
   and Shen, Yihao and Ye, Fangfang and Cao, Shan and Jiang, Zhiyuan},
Book-Group-Author = {ACM},
Title = {A Hierarchical Dataflow-Driven Heterogeneous Architecture for Wireless
   Baseband Processing},
Booktitle = {30TH ASIA AND SOUTH PACIFIC DESIGN AUTOMATION CONFERENCE, ASP-DAC 2025},
Series = {Asia and South Pacific Design Automation Conference Proceedings},
Year = {2025},
Pages = {587-593},
Note = {30th Asia and South Pacific Design Automation Conference-ASP-DAC-Annual,
   ACM SIGDA, Tokyo, JAPAN, JAN 20-23, 2025},
Abstract = {Wireless baseband processing (WBP) is a key element of wireless
   communications, with a series of signal processing modules to improve
   data throughput and counter channel fading. Conventional hardware
   solutions, such as digital signal processors (DSPs) and more recently,
   graphic processing units (GPUs), provide various degrees of parallelism,
   yet they both fail to take into account the cyclical and consecutive
   character of WBP. Furthermore, the large amount of data in WBPs cannot
   be processed quickly in symmetric multiprocessors (SMPs) due to the
   unpredictability of memory latency. To address this issue, we propose a
   hierarchical dataflow-driven architecture to accelerate WBP. A
   pack-and-ship approach is presented under a non-uniform memory access
   (NUMA) architecture to allow the subordinate tiles to operate in a
   bundled access and execute manner. We also propose a multi-level
   dataflow model and the related scheduling scheme to manage and allocate
   the heterogeneous hardware resources. Experiment results demonstrate
   that our prototype achieves 2x and 2.3x speedup in terms of normalized
   throughput and single-tile clock cycles compared with GPU and DSP
   counterparts in several critical WBP benchmarks. Additionally, a
   link-level throughput of 288 Mbps can be achieved with a 45-core
   configuration.},
Type = {Proceedings Paper},
Affiliation = {Jiang, ZY (Corresponding Author), Shanghai Univ, Sch Commun \& Informat Engn, Shanghai, Peoples R China.
   Jiang, Limin; Shi, Yi; Liu, Yintao; Deng, Qingyu; Xu, Siyi; Shen, Yihao; Ye, Fangfang; Cao, Shan; Jiang, Zhiyuan, Shanghai Univ, Sch Commun \& Informat Engn, Shanghai, Peoples R China.},
DOI = {10.1145/3658617.3697558},
Keywords = {Wireless baseband processing; NUMA; dataflow-driven},
Author-Email = {jiangzhiyuan@shu.edu.cn},
Affiliations = {Shanghai University},
