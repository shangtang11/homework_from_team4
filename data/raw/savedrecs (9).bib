   Conti, Francesco; Benini, Luca, Univ Bologna, Dept Elect Elect \& Informat Engn, I-40136 Bologna, Italy.},
DOI = {10.1109/TVLSI.2021.3093242},
Keywords = {5G mobile communication; Multicore processing; Throughput; Task
   analysis; Benchmark testing; Resource management; Program processors;
   Application-specific instruction-set processor (ASIP); long short-term
   memory (LSTM); machine learning; neural networks; radio resource
   management (RRM); recurrent neural network (RNN); RISC-V},
