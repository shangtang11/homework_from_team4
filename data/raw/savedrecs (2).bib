Title = {Zero-Day Hardware-Supported Malware Detection of Stack Buffer Overflow
   attacks: an application exploiting the CV32e40p RISC-V core},
Booktitle = {2025 IEEE 26TH LATIN AMERICAN TEST SYMPOSIUM, LATS},
Series = {Latin American Test Workshop},
Year = {2025},
Note = {26th Latin American Test Symposium-LATS-Annual, COLOMBIA, MAR 11-14,
   2025},
Abstract = {The RISC-V architecture has become increasingly popular due to its
   open-source nature and flexibility, making it susceptible to various
   security attacks, such as Stack Buffer Overflow (SBO) attacks. It is
   crucial to effectively detect these attacks to ensure the security of
   RISC-V systems. This study explores Hardware-Supported Malware Detection
   (HMD) techniques for identifying these security threats. Using the
   CV32e40p RISC-V platform, we conducted simulations to assess the
   effectiveness of anomaly-based HMD methods in detecting SBO attacks by
   analyzing hardware microarchitectural events. The findings demonstrate
   the potential of these approaches but also reveal significant challenges
   in detection performance. These elements are essential for advancing the
   security capabilities of HMD systems in RISC-V environments.},
