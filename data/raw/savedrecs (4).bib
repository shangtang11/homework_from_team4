   Licht, Johannes de Fine, Swiss Fed Inst Technol, Zurich, Switzerland.
   Karandikar, Rajas, Purdue Univ, W Lafayette, IN 47907 USA.
   Licht, Johannes de Fine, NextSilicon, Zurich, Switzerland.},
DOI = {10.1145/3656420},
Article-Number = {190},
Keywords = {Hardware Threading; Wavefront Threading; Wavefront Consistency},
