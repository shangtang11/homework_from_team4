@article{ WOS:001452740600001,
Author = {Fernandez-Aragon, Jorge and Diez-Senorans, Guillermo and Garcia-Bosque,
   Miguel and Aparicio-Tellez, Raul and Lopez-Pinar, Gabriel and Celma,
   Santiago},
Title = {Improving Physically Unclonable Functions' Performance Using
   Second-Order Compensated Measurement},
Journal = {INFORMATION},
Year = {2025},
Volume = {16},
Number = {3},
Month = {FEB 21},
Abstract = {In this paper, we study the performance of second-order compensated
   measurement to generate a multi-bit response in physically unclonable
   functions (PUFs). The proposed technique is based on a novel
   second-order compensated measurement generating multiple bits instead of
   a single bit provided by the conventional compensated measurement. A PUF
   based on this technique has been proposed and implemented in 40 Artix-7
   FPGAs, and its uniqueness and reproducibility have been compared to
   those of another PUF using the compensated measurement technique. In
   addition, we demonstrate that the best trade-off between identifiability
   and computation time performance is obtained when using only two bits.
   At the same time, the good performance of the technique has been
   demonstrated, improving the identifiability of a ring oscillator PUF
   (RO-PUF) between 70 and 90\% compared to a RO-PUF that uses conventional
   compensated measurement. In particular, equal error rates (EER) of the
   order of EER similar to 10-16 can be achieved by combining the sign bit
   with another bit extracted using the proposed technique; and up to EER
   similar to 10-19 by using one more extra bit. In addition, the high
   reliability of the responses generated by this technique against
   possible temperature and voltage variations has been proved. These
   results show how this new technique improves the performance of the PUF
   in terms of identifiability, so it can be effectively used for device
   identification purposes.},
