Title = {Microarchitecture-aware Fault Models: Experimental Evidence and
   Cross-Layer Inference Methodology},
Booktitle = {2021 16TH INTERNATIONAL CONFERENCE ON DESIGN \& TECHNOLOGY OF INTEGRATED
   SYSTEMS IN NANOSCALE ERA (DTIS 2021)},
Year = {2021},
Note = {16th International Conference on Design and Technology of Integrated
   Systems in Nanoscale Era (DTIS), ELECTR NETWORK, JUN 28-30, 2021},
Abstract = {Fault injection attacks are considered one of the major threats to
   cyber-physical systems. The increasing complexity of embedded
   microprocessors involves complicated behaviours in presence of such
   attacks. Realistic fault models are required to study code
   vulnerabilities and be able to protect digital systems from these
   attacks. However, inferring fault models using only limited observations
   of faulty microprocessors is difficult. In this article, we present
   experiments that show the difficulty of characterizing and modelling the
   fault injection effects. From there, we propose a complete approach for
   fault analysis to build proper fault models at different system levels,
   which will help in designing suitable countermeasures at reasonable
   cost.},
