   Yao, Yiyang, State Grid Zhejiang Elect Power Co Ltd, Informat \& Telecommun Branch, Hangzhou 310007, Peoples R China.},
DOI = {10.1109/ACCESS.2020.3047411},
Keywords = {Assembly layer; formal verification; Internet of Things; smart cities;
   Isabelle; HOL; operating system},
Author-Email = {qianzj@cslg.edu.cn},
Affiliations = {Suzhou University of Technology; State Grid Corporation of China; Nari
   Group Corp; State Grid Corporation of China},
