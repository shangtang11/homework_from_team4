@inproceedings{ WOS:001336893300027,
Author = {Bargmann, Lara and Dongol, Brijesh and Wehrheim, Heike},
Editor = {Platzer, A and Rozier, KY and Pradella, M and Rossi, M},
Title = {Unifying Weak Memory Verification Using Potentials},
