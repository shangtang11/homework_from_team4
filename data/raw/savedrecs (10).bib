@inproceedings{ WOS:000521762000009,
Author = {Linhares, Alisson and Azevedo, Rodolfo},
Book-Group-Author = {IEEE},
Title = {Towards a Transprecision Polymorphic Floating-Point Unit for
   Mixed-precision Computing},
Booktitle = {2019 31ST INTERNATIONAL SYMPOSIUM ON COMPUTER ARCHITECTURE AND HIGH
   PERFORMANCE COMPUTING (SBAC-PAD 2019)},
Series = {International Symposium on Computer Architecture and High Performance
   Computing},
Year = {2019},
Pages = {56-63},
Note = {31st International Symposium on Computer Architecture and High
   Performance Computing (SBAC-PAD), Campo Grande, BRAZIL, OCT 15-18, 2019},
Abstract = {Mixed-precision is a paradigm that tries to combine computations with
   different levels of precision to compose results. This approach has been
   used extensively to optimize scientific applications and has shown speed
   and energy gains, without causing any relevant precision loss. However,
   to exploit mixed precision opportunities most applications need to be
   recompiled to use different instructions and types. Thus, in this work,
   we present a new floating-point unit design, able to automatically
   decide when an instruction should be executed using less precision,
   without recompilation or user direct intervention. Our proposal takes
   advantage of ad-hoc polymorphism to perform computations with different
   data types, dynamically selecting a proper instruction on demand, and
   can also be configured according to overall precision requirements. Our
   simulated results show that, for some doubleprecision benchmarks, we are
   able to execute more than 90\% of all floating-point operations in
   half-precision, without affecting its accuracy and resulting in a
   precision error below 1\%. In addition, this new technology may increase
   instruction level parallelism and cut down the necessity for type
   casting operations.},
Type = {Proceedings Paper},
Affiliation = {Linhares, A (Corresponding Author), Univ Campinas Unicamp, Inst Comp, Campinas, Brazil.
   Linhares, Alisson; Azevedo, Rodolfo, Univ Campinas Unicamp, Inst Comp, Campinas, Brazil.},
