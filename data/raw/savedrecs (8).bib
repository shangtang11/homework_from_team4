   Bossuet, Lilian, Jean Monnet Univ, Lab Hubert Curien, F-42000 St Etienne, France.},
DOI = {10.1109/DSD57027.2022.00080},
Keywords = {Fault injection attack; countermeasures; masking; fault detection;
   RISC-V},
