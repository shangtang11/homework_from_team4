Title = {FPGA Implementation of a Fixed-Point Arctangent Function Using
   Harmonized Parabolic Synthesis},
Booktitle = {2025 IEEE COMPUTER SOCIETY ANNUAL SYMPOSIUM ON VLSI, ISVLSI},
Series = {IEEE Computer Society Annual Symposium on VLSI},
Year = {2025},
Pages = {269-273},
Note = {2025 Computer Society Symposium on VLSI-ISVLSI, Kalamata, GREECE, JUL
   06-09, 2025},
Abstract = {Harmonized Parabolic Synthesis (HPS) is a method that combines parabolic
   synthesis with second-degree interpolation. In this work, we implement
   an arctangent function for Neural Networks on FPGAS, with high accuracy
   using this method (error < 1 ULP). Experiments are carried out for the
   activation function on a Xilinx FPGA, and the implementation
   demonstrates lower resource usage, lower latency, high clock rates, and
   higher throughput compared to other implementations, such as CORDIC. The
   method is implemented in unsigned fixed-point format (FxP) of 16 bits
   and is suitable for high-performance embedded systems due to its small
   size, low latency, and high throughput. It can be used as a stand-alone
   accelerator or integrated into an ALU or FPU.},
Type = {Proceedings Paper},
