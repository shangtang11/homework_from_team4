Affiliation = {Chen, L (Corresponding Author), Chinese Acad Sci, Inst Automat, Beijing, Peoples R China.
   Zhang, Zirui; Chen, Liang; Liu, Xin; Xu, Dongjun, Chinese Acad Sci, Inst Automat, Beijing, Peoples R China.
