@article{ WOS:001678847700001,
Author = {Liu, S. and Wang, J. J. and Liu, Y. H. and Xiao, S. Y. and Chen, Y. T.
   and Hu, H. and Yan, S. Q. and Pan, R. C. and Wang, Y. and Hu, Z. Y. and
   Yu, Q. and Chen, T. P. and Liu, Y.},
Title = {A row-and column-individually programmable logic-in-memory macro using
   memristor-based non-volatile SRAM},
Journal = {MICROELECTRONICS JOURNAL},
Year = {2026},
Volume = {170},
Month = {APR},
Abstract = {In this article, we present a logic-in-memory (PLIM) macro using
   memristor-based non-volatile SRAM (nvSRAM). The proposed macro features
   standard SRAM storage, non-volatile storage, programmable
   logic-in-memory (PLIM) computation, and binary content addressable
   memory (BCAM) capabilities. Owing to the programming of memristors to
   store various types of logic operations, the PLIM array exhibits
   non-volatile abilities can be independently configured in either the row
   or column direction for any one of the three logic operations, which is
   more competitive than other works that can only be configured to realize
   same logic operation for each row or column. Differential voltage
   between processing bit lines (PBL and PBLB) is leveraged to enhance
   noise tolerance during in-memory computation, and the macro requires
   only two layers of PLIM cells to construct a full adder, which shortens
   computing latency and saves area overhead. Compared with prior works,
   the proposed 64-bit adder achieves a significant reduction in both area
   and energy consumption, with the area reduced to 28\% and the total
   energy consumed decreased to 1.37\%.},
Type = {Article},
Affiliation = {Wang, JJ (Corresponding Author), Univ Elect Sci \& Technol China, State Key Lab Thin Solid Films \& Integrated Device, Chengdu, Peoples R China.
