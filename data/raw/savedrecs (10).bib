@inproceedings{ WOS:000447282400151,
Author = {Mhanna, Sleiman and Verbic, Gregor and Chapman, Archie C.},
Book-Group-Author = {IEEE},
Title = {Accelerated Methods for the SOCP-Relaxed Component-Based Distributed
   Optimal Power Flow},
Booktitle = {2018 POWER SYSTEMS COMPUTATION CONFERENCE (PSCC)},
Year = {2018},
Note = {Power Systems Computation Conference (PSCC), Dublin, IRELAND, JUN 11-15,
   2018},
Abstract = {In light of the increased focus on distributed methods, this paper
   proposes two accelerated subgradient methods and an adaptive penalty
   parameter scheme to speed-up the convergence of ADMM on the
   component-based dual decomposition of the second-order cone programming
   (SOCP) relaxation of the OPF. This work is the first to apply an
   adaptive penalty parameter method along with an accelerated subgradient
   method together in one scheme for distributed OPF. This accelerated
   scheme is demonstrated to reach substantial speed-ups, as high as 87\%,
   on real-world test systems with more than 9000 buses, as well as on
   other difficult test cases.},
Type = {Proceedings Paper},
Keywords = {Accelerated methods; Adaptive ADMM; component-based dual decomposition;
