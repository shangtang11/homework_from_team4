@article{ WOS:001167421700001,
Author = {Skrzypiec, P. and Grybos, P. and Szczygiel, R.},
Title = {System for the fast readout and tests of pixel IC operating in single
   photon counting mode using PCIe-based FPGA},
Journal = {JOURNAL OF INSTRUMENTATION},
Year = {2024},
Volume = {19},
Number = {1},
Month = {JAN},
Note = {24th International Workshop on Radiation Imaging Detectors, Oslo,
   NORWAY, JUN 25-29, 2023},
Abstract = {Hybrid Pixel Detectors (HPDs) have become popular in particle and photon
   detection techniques in recent years. This type of devices consists of
   two parts: a pixelated sensor (based on Si, Ge, GaAs, CZT, etc.), and a
   readout Integrated Circuit (IC), which usually contains thousands of
   pixels and millions of transistors. ICs suffer from the inaccuracies of
   manufacturing processes, therefore HPDs have to be thoroughly tested
   before the sensor bump -bonding process. This paper presents a highly
   efficient system for the automated testing of pixelated HPDs. The
   presented solution is based on the Intel Arria 10 GX Field Programmable
   Gate Array (FPGA) development kit and a Linux-powered Personal Computer
   (PC), connected via Peripheral Component Interconnect Express (PCIe) 8x
   Gen. 3 interface. The proposed system has been built of well -thoughtout
