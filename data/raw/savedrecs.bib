@article{ WOS:001626151200002,
Author = {Shi, Hanyu and Hu, Junjie and Xu, Hong and Li, Junjie and Peng, Jiarui
   and Wu, Huifeng},
Title = {Dynamic contention-aware workflow scheduling on shared bus-based
   CPU-FPGA heterogeneous computing systems},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2026},
Volume = {300},
Month = {MAR 5},
Abstract = {Heterogeneous computing systems (HCSs), which integrate a central
   processing unit (CPU) cluster and a field-programmable gate array (FPGA)
   fabric, are widely used to execute workflow tasks. In these systems, the
   two processing domains are interconnected through a shared-bus
   architecture to facilitate cross-domain communication. During task
   execution, multiple communications inevitably contend for the same
   shared bus, thereby degrading overall performance. Consequently,
   contention-aware scheduling is essential. This paper presents a dynamic
   contention-aware workflow scheduling framework. First, we formulate a
   workflow scheduling problem that explicitly incorporates dynamic
   communication contention. Then, we develop a meta-process-based dynamic
   contention-aware (MP-DCA) simulator to provide fast and accurate
   workflow completion time (makespan) estimation. Building on MP-DCA, a
   two-phase meta-heuristic algorithm (TPMHA) is introduced to solve the
   scheduling problem. In the first phase, an improved genetic algorithm
   equipped with a dedicated combined-EFT heuristic scheduler in MP-DCA
   (CEGA) is employed to perform list scheduling optimization and obtain
   near-optimal solutions. In the second phase, an enhanced ant colony
   algorithm with a quota-weighted strategy (QWACO) is used to refine the
   communication schedule. Experiments conducted on a Xilinx ZCU102 board
   with real-world workflows demonstrate that, compared with
   state-of-the-art baselines, MP-DCA achieves an average speedup of 100.8x
   in workflow makespan estimation and an average accuracy improvement of
   1.31x, and TPMHA yields an average improvement of 9.3\% (up to 14.5\%)
   in normalized makespan.},
