@article{ WOS:000915803900001,
Author = {Yao, Chun-Yen and Wu, Tsung-Yen and Liang, Han-Chung and Chen, Yu-Kai
   and Liu, Tsung-Te},
Title = {A Fully Bit-Flexible Computation in Memory Macro Using Multi-Functional
   Computing Bit Cell and Embedded Input Sparsity Sensing},
Journal = {IEEE JOURNAL OF SOLID-STATE CIRCUITS},
Year = {2023},
Volume = {58},
Number = {5},
Pages = {1487-1495},
Month = {MAY},
Abstract = {Computation in memory (CIM) overcomes the von Neumann bottleneck by
   minimizing the communication overhead between memory and process
   elements. However, using conventional CIM architectures to realize
   multiply-accumulate operations (MACs) with flexible input and weight bit
   precision is extremely challenging. This article presents a fully
   bit-flexible CIM design with a compact area and high energy efficiency.
   The proposed CIM macro employs a novel multi-functional computing bit
   cell design by integrating the MAC and the A/D conversion to maximize
   efficiency and flexibility. Moreover, an embedded input sparsity sensing
   and a self-adaptive dynamic range (DR) scaling scheme are proposed to
   minimize the energy-consuming A/D conversions in CIM. Finally, the
   proposed CIM macro implementation utilizes an interleaved placement
   structure to enhance the weight-updating bandwidth and the layout
   symmetry. The proposed CIM design fabricated in standard 28-nm CMOS
   technology achieves an area efficiency of 27.7 TOPS/mm(2 )and an energy
   efficiency of 291 TOPS/W, demonstrating a highly energy-area-efficient
   flexible CIM solution.},
Type = {Article},
Affiliation = {Liu, TT (Corresponding Author), Natl Taiwan Univ, Grad Inst Elect Engn, Taipei 10617, Taiwan.
   Yao, Chun-Yen; Wu, Tsung-Yen; Liang, Han-Chung; Chen, Yu-Kai; Liu, Tsung-Te, Natl Taiwan Univ, Grad Inst Elect Engn, Taipei 10617, Taiwan.
   Yao, Chun-Yen, Univ Calif Berkeley, Dept Elect Engn \& Comp Sci, Berkeley, CA 94720 USA.
   Wu, Tsung-Yen, MediaTekInc, Taipei 11491, Taiwan.},
DOI = {10.1109/JSSC.2022.3224363},
EarlyAccessDate = {JAN 2023},
Keywords = {Analog-digital conversion; Computer architecture; Common Information
   Model (computing); Microprocessors; Standards; Sensors; Capacitors;
   Area-efficient; bit scalability; computation in memory (CIM); deep
   neural network (DNN); energy-efficient; in-memory A/D conversion;
   sparsity sensing},
Keywords-Plus = {UNIT-MACRO; SRAM MACRO; ADC},
Author-Email = {cyyao@eecs.ee.ntu.edu.tw
   r08943051@ntu.edu.tw
