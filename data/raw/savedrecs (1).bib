@article{ WOS:001470432100001,
Author = {Wasif, Sandy A. and Wael, Miran and Genssler, Paul R. and Azab, Eman and
   Mashaly, Maggie and Abd El Ghany, Mohamed A. and Amrouch, Hussam},
Title = {Domain-Specific Hyperdimensional RISC-V Processor for Edge-AI Training},
