@inproceedings{ WOS:001476945200163,
Author = {Yil, Xiaoling and Antonio, Ryan and Dumoulinl, Joren and Sunl, Jiacong
   and Van Delml, Josse and Paim', Guilherme and Verhelstl, Marian},
Book-Group-Author = {ACM},
Title = {OpenGeMM: A High-Utilization GeMM Accelerator Generator with Lightweight
   RISC-V Control and Tight Memory Coupling},
Booktitle = {30TH ASIA AND SOUTH PACIFIC DESIGN AUTOMATION CONFERENCE, ASP-DAC 2025},
Series = {Asia and South Pacific Design Automation Conference Proceedings},
Year = {2025},
Pages = {1055-1061},
Note = {30th Asia and South Pacific Design Automation Conference-ASP-DAC-Annual,
   ACM SIGDA, Tokyo, JAPAN, JAN 20-23, 2025},
Abstract = {Deep neural networks (DNNs) face significant challenges when deployed on
   resource-constrained extreme edge devices due to their computational and
   data-intensive nature. While standalone accelerators tailored for
   specific application scenarios suffer from inflexible control and
   limited programmability, generic hardware acceleration platforms coupled
   with RISC-V CPUs can enable high reusability and flexibility, yet
   typically at the expense of system-level efficiency and low utilization.
   To fill this gap, we propose OpenGeMM, an open-source acceleration
   platform, jointly demonstrating high efficiency and utilization, as well
   as ease of configurability and programmability. OpenGeMM encompasses a
   parameterized Chisel-coded GeMM accelerator, a lightweight RISC-V
   processor, and a tightly coupled multi-banked scratchpad memory. The
   GeMM core utilization and system efficiency are boosted through three
   mechanisms: configuration pre-loading, input pre-fetching with output
   buffering, and programmable strided memory access. Experimental results
   show that OpenGeMM can consistently achieve hardware utilization ranging
   from 81.89\% to 99.34\% across diverse CNN and Transformer workloads.
   Compared to the SotA open-source Gemmini accelerator, OpenGeMM
   demonstrates a 3.58x to 16.40x speedup on normalized throughput across a
   wide variety of GeMM workloads, while achieving 4.68 TOPS/W system
   efficiency.},
