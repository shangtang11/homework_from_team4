Keywords = {Resource management; Optimization; Servers; Computational modeling;
   Collaboration; Bandwidth; Internet of Things; Data models; Mobile
   computing; Adaptation models; Semi-supervised federated learning;
   dynamic edge selection; wireless network allocation; incentive
   optimization; dynamic timer},
