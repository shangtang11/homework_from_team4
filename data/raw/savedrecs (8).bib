Pages = {2592-2597},
Month = {JUN},
Abstract = {High spatiotemporal resolution biosignal that is vital for biomedical
   applications results in an information bottleneck that poses challenges
   for their transferring and processing. The energy efficiency of
   biosignal-dedicated circuits becomes increasingly important with the
   emergence of wearable and implantable healthcare devices where low power
   consumption must be fulfilled. This tutorial brief presents a concise
   overview of emerging energy-efficient biosignal-dedicated circuits from
   bandwidth- and computation-reduction perspectives, aiming to provide
   designers with a guideline for different design choices.},
