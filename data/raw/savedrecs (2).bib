@inproceedings{ WOS:001572136700092,
Author = {Islam, Riadul and Challagundla, Dhandeep},
Book-Group-Author = {IEEE},
Title = {Pre-Global Routing DRC Violation Prediction Using Unsupervised Learning},
Booktitle = {2025 23RD IEEE INTERREGIONAL NEWCAS CONFERENCE, NEWCAS},
