@article{ WOS:001627703800001,
Author = {He, Hao and Zhang, Yajia and An, Kunlong and Ma, Xiaoning and Luo, Yanna
   and Li, Zhiqiang and Liu, Jianyun and Cao, He and Zhang, Qingzhu and
   Yin, Huaxiang and Wu, Zhenhua and Xu, Qinzhi},
Title = {Simulation Design of Novel Hybrid Channel Complementary FET (HC-CFET)
   and Interconnect Scheme for Sub-1 nm Node},
Journal = {IEEE TRANSACTIONS ON ELECTRON DEVICES},
Year = {2025},
Volume = {72},
Number = {12},
Pages = {7101-7107},
Month = {DEC},
Abstract = {Vertically stacked complementary field-effect transistors (CFETs) are
   considered a leading option for sustaining logic density thanks to their
   footprint efficiency. However, scaling CFETs to the sub-1 nm node faces
   severe challenges, including extreme aspect ratios and bottom-device
   contact difficulties. We propose a co-designed hybrid-channel CFET
   (HC-CFET) architecture with a tailored interconnect scheme to overcome
   these limitations. Using self-aligned quadruple patterning (SAQP), the
   bottom PFET is implemented as a single conventional lateral nanosheet,
   whereas the top NFET is formed as a single vertical channel. The
   mutually perpendicular channels shorten the overall stack height, relax
   high-aspect-ratio etch-and-fill constraints, and exploit crystal
   orientations that maximize electron and hole mobility, respectively. The
   orthogonal placement of the top NFET also leaves space for vias that
   directly contact each transistor's drain, eliminating extra routing.
   TCAD simulations show that the HC-CFET increases PFET drive current by
   approximately 34\% over a conventional equal-width CFET. Circuit-level
   analysis indicates that a nine-stage ring oscillator (RO) achieves
   14.5\% higher frequency and 15.6\% lower energy per transition, while a
   1-nm-node 6T static random access memory (SRAM) exhibits 10\% faster
   reads and 11\% faster writes owing to reduced parasitics. By combining
   channel-mobility co-optimization, intermediate dielectric isolation,
   isolated source/drain regions, and dual work function metal (WFM) gates,
   the HC-CFET provides a scalable path to extend CMOS technology beyond 1
   nm.},
