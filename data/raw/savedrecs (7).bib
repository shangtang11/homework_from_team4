@article{ WOS:000852269100001,
Author = {Richa, Majdi and Prevotet, Jean-Christophe and Dardaillon, Mickael and
   Mroue, Mohamad and Samhat, Abed Ellatif},
Title = {High-level power estimation techniques in embedded systems hardware: an
   overview},
Journal = {JOURNAL OF SUPERCOMPUTING},
Year = {2023},
Volume = {79},
Number = {4},
Pages = {3771-3790},
Month = {MAR},
Abstract = {Power optimization has become a major concern for most digital hardware
   designers, particularly in early design phases and especially in limited
   power budget systems (battery-operated hand-held devices,
   electro-optical pluggable modules, IoT and green energy systems, etc.).
   Subsequently, early power consumption estimation at design time is
   crucial for power optimization. The aim of this paper is to present an
   overview of high-level power estimation techniques currently available
   along with a comprehensive comparison between different methodologies
   and their applications on estimated models. When high speed and high
   performance are key features of a specific embedded system, increase in
   energy consumption becomes the main hurdle to be tackled while keeping
   speed/performance v/s power consumption trade-off at a minimum. This
   paper provides designers, interested in power consumption modeling, with
   knowledge on how to select best power estimation techniques applied to
   designated target models.},
