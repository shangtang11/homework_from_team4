@inproceedings{ WOS:001329127500036,
Author = {Bhargavi, Mekala Bindu and Harshith, Grandhala Sri Sai and Parameswaran,
   Sri and Soumya, J.},
Editor = {Thapliyal, H and Becker, J},
Title = {Optimizing LU Decomposition with RISC-V Based Hardware Acceleration},
Booktitle = {2024 IEEE COMPUTER SOCIETY ANNUAL SYMPOSIUM ON VLSI, ISVLSI},
Series = {IEEE Computer Society Annual Symposium on VLSI},
Year = {2024},
Pages = {210-215},
Note = {IEEE-Computer-Society Annual Symposium on VLSI (ISVLSI), Knoxville, TN,
   JUL 01-03, 2024},
Abstract = {LU decomposition (L stands for lower triangular matrix and U stands for
   upper triangular matrix), a fundamental matrix factorization technique
   holds significant importance across diverse domains due to its
   versatility and efficiency in solving linear systems. In this work, we
   explore the utilization of a dedicated hardware accelerator, coupled
   with a RISC-V processor, to expedite the LU Decomposition process.
   Leveraging the inherent flexibility and efficiency of the RISC-V
   architecture, we aim to enhance both computational speed and efficiency.
   To efficiently manage the hardware accelerator, a custom RISC-V
   processor is implemented with tailored instructions. We look at
   left-looking and right-looking techniques and the latter is chosen for
   implementation due to its inherent parallelizability, which promises
   improved performance. The hardware accelerator accelerates computation
   by directly accessing memory, utilizing specialized hardware for rapid
   operations, and exploiting parallelism through multiple PEs. To evaluate
   the performance of the implemented algorithms and hardware, we employ
   the RARS tool at the assembly level for algorithms and the Vivado tool
   at the architectural level for hardware. Further, the processor
   architecture is synthesized and deployed on the Zed Board for hardware
   validation. We report the speedup in execution time for matrices of
   various sizes with different numbers of PEs, demonstrating the
   effectiveness of the proposed approach. For a matrix of order 256 x 256,
   the proposed accelerator achieved a speedup of over 338x times compared
   to the sequential execution on processor.},
