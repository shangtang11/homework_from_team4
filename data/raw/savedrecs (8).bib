   Moreno-Sanchez, Pedro, IMDEA Software Inst, Madrid, Spain.
   Maffei, Matteo, TU Wien, Christian Doppler Lab, Blockchain Technol Internet Things, Vienna, Austria.},
DOI = {10.1145/3548606.3559370},
Keywords = {cryptocurrencies; payment channels; watchtowers; blockchain},
