@inproceedings{ WOS:001592510000014,
Author = {Szczepanski, Rafal},
Book-Group-Author = {IEEE},
Title = {Parameter Optimization of Artificial Potential Field Algorithm for Local
   Path Planning Problem},
Booktitle = {2025 29TH INTERNATIONAL CONFERENCE ON METHODS AND MODELS IN AUTOMATION
