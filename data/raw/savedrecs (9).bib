@inproceedings{ WOS:001245234900013,
Author = {Zhou, Yaoyang and Yu, Zihao and Zhang, Chuanqi and Xu, Yinan and Wang,
   Huizhe and Wang, Sa and Sun, Ninghui and Bao, Yungang},
Book-Group-Author = {Assoc Computing Machinery},
Title = {Omegaflow: A High-Performance Dependency-based Architecture},
Booktitle = {PROCEEDINGS OF THE 2021 ACM INTERNATIONAL CONFERENCE ON SUPERCOMPUTING,
   ICS 2021},
Year = {2021},
Pages = {152-163},
Note = {35th ACM International Conference on Supercomputing (ICS), ELECTR
   NETWORK, JUN 14-17, 2021},
Abstract = {This paper investigates how to better track and deliver dependency in
   dependency-based cores to exploit instruction-level parallelism (ILP) as
   much as possible. To this end, we first propose an analytical
   performance model for state-of-the-art dependency-based core,
   Forwardflow, and figure out three vital factors affecting its upper
   bound of performance. Then we propose Omegaflow, a dependency-based
   architecture adopting three new techniques, which respond to the
   discovered three factors. Experimental results show that Omegaflow
   improves IPC by 24.6\% compared to the state-of-the-art design,
   approaching the performance of the OoO architecture with an ideal
   scheduler (94.4\%) without increasing the clock cycle and consumes only
   8.82\% more energy than Forwardflow.},
