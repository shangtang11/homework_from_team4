@article{ WOS:001254510500001,
Author = {Hayashi, Victor Takashi and Ruggiero, Wilson Vicente},
Title = {Hardware Trojan Dataset of RISC-V and Web3 Generated with ChatGPT-4},
Journal = {DATA},
Year = {2024},
Volume = {9},
Number = {6},
Month = {JUN},
Abstract = {Although hardware trojans impose a relevant threat to the hardware
   security of RISC-V and Web3 applications, existing datasets have a
   limited set of examples, as the most famous hardware trojan dataset
   TrustHub has 106 different trojans. RISC-V specifically has study cases
   of three and four different hardware trojans, and no research was found
   regarding Web3 hardware trojans in modules such as a hardware wallet.
   This research presents a dataset of 290 Verilog examples generated with
   ChatGPT-4 Large Language Model (LLM) based on 29 golden models and the
   TrustHub taxonomy. It is expected that this dataset supports future
   research endeavors regarding defense mechanisms against hardware trojans
   in RISC-V, hardware wallet, and hardware Proof of Work (PoW) miner.},
Type = {Article},
Affiliation = {Hayashi, VT (Corresponding Author), Univ Sao Paulo, Polytech Sch, BR-05508010 Sao Paulo, Brazil.
