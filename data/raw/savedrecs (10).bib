@inproceedings{ WOS:000679186400012,
Author = {Papadopoulos, Nikolaos Charalampos and Karakostas, Vasileios and Nikas,
   Konstantinos and Koziris, Nectarios and Pnevmatikatos, Dionisios N.},
Editor = {Mentens, N and Sousa, L and Trancoso, P and Pericas, M and Sourdis, I},
Title = {A Configurable TLB Hierarchy for the RISC -V Architecture},
Booktitle = {2020 30TH INTERNATIONAL CONFERENCE ON FIELD-PROGRAMMABLE LOGIC AND
   APPLICATIONS (FPL)},
Series = {International Conference on Field Programmable Logic and Applications},
Year = {2020},
Pages = {85-90},
Note = {30th International Conference on Field-Programmable Logic and
   Applications (FPL), ELECTR NETWORK, AUG 31-SEP 04, 2020},
Abstract = {The Rocket Chip Generator uses a collection of parameterized processor
   components to produce RISC -V-based SoCs. It is a powerful tool that can
   produce a wide variety of processor designs ranging from tiny embedded
   processors to complex multi-core systems. In this paper we extend the
   features of the Memory Management Unit of the Rocket Chip Generator and
   specifically the TLB Hierarchy. TLBs are essential in terms of
   performance because they mitigate the overhead of frequent Page Table
   Walks, but may harm the critical path of the processor due to their size
   and/or associativity. In the original Rocket Chip implementation the Ll
   Data/Instruction TLB is fully-associative and the shared L2 TLB is
   directmapped. We lift these restrictions and design and implement
   configurable, set-associative Ll and L2 TLB templates that can create
   any organization from direct-mapped to fully-associative to achieve the
   desired ratio of performance and resource utilization, especially for
   larger TLBs. We present the area for different configurations and
   evaluate the overall performance of our design using the SPEC2006
   benchmark suite on the Xilinx ZCU102 FPGA. Our design is intended both
   for ASIC implementation and for FPGA-friendly soft processors. As FPGAs
   continue to increase in size, it becomes increasingly attainable and
   desirable to use configurable high-performance soft processors that can
   run full-fledged operating systems, especially for applications with
   large memory footprints.},
Type = {Proceedings Paper},
Affiliation = {Papadopoulos, NC (Corresponding Author), Natl Tech Univ Athens, Sch ECE, Athens, Greece.
