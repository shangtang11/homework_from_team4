   Tong, Ling; Qian, Kun, Southeast Univ, Shenzhen Res Inst, Shenzhen 518063, Peoples R China.
   Luo, Shan, Kings Coll London, Dept Engn, London WC2R 2LS, England.},
DOI = {10.1109/TCSVT.2025.3598373},
Keywords = {Visualization; Grasping; Robot sensing systems; Robots; Contrastive
   learning; Feature extraction; Sensors; Accuracy; Force; Tactile sensors;
   Robotic grasping; multimodal contrastive learning; tactile sensor;
   visual-tactile alignment},
