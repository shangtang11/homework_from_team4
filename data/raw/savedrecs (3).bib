   Merchant, Farhad, Newcastle Univ, Elect \& Elect Engn Dept, NEWCASTLE UPON TYNE NE1 7RU, England.},
DOI = {10.1109/LES.2024.3354831},
Keywords = {Monitoring; Security; Hardware; Behavioral sciences; Threat modeling;
