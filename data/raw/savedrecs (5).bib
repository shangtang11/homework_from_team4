@inproceedings{ WOS:001448004400010,
Author = {Grignani, Wesley and Santana, Khalil G. Q. and Santos, Douglas A. and
   Dilillo, Luigi and Melo, Douglas R.},
Book-Group-Author = {IEEE},
Title = {Implementation and Reliability Evaluation of a ChaCha20 Stream Cipher
   Hardware Accelerator<bold> </bold>},
Booktitle = {2024 IEEE INTERNATIONAL SYMPOSIUM ON DEFECT AND FAULT TOLERANCE IN VLSI
   AND NANOTECHNOLOGY SYSTEMS, DFT},
Series = {International Symposium on Defect and Fault Tolerance in VLSI and
   Nanotechnology Systems},
Year = {2024},
Note = {37th IEEE International Symposium on Defect and Fault Tolerance in VLSI
   and Nanotechnology Systems, Harwell Science and Innovation Campus,
   Oxfordshire, ENGLAND, OCT 08-10, 2024},
Abstract = {Cryptography is fundamental to ensuring the security and privacy of
   space communications, enabling the reliable exchange of sensitive data
   between spacecraft, ground stations, and other components of space
   infrastructure. However, using encryption can be computationally costly,
   resulting in lower throughput or higher latencies. One strategy to
   mitigate the costs imposed by cryptography is using accelerators. In
   addition, these systems that operate in space are susceptible to faults
   due to adverse conditions and require the implementation of protection
   techniques to mitigate these faults and ensure correct operation. In
   this context, this paper presents a fault-tolerant and high-performance
   encryption accelerator for the ChaCha20 stream cipher. We present a
   low-cost optimized implementation and a fault-tolerant version using
   Hamming Error Correction Code (ECC) and Triple Modular Redundancy (TMR).
   Results show that the optimized and hardened versions accelerated the
   application by 23x and 17x compared to the software solution. The
   optimized solution can process 281.25 MB/s, presenting a higher
   throughput than state-of-the-art works that rely on FPGA implementation.
   The hardened solution can process 187.50 MB/s, leading to an overhead of
   1.52x more Look-Up Tables (LUTs) and 1.03x more Flip-Flops (FFs)
   compared to the optimized solution of this work.<bold> </bold>},
Type = {Proceedings Paper},
Affiliation = {Grignani, W (Corresponding Author), Univ Vale Itajai, LEDS, Itajai, SC, Brazil.
   Grignani, Wesley; Santana, Khalil G. Q.; Melo, Douglas R., Univ Vale Itajai, LEDS, Itajai, SC, Brazil.
   Santos, Douglas A.; Dilillo, Luigi, Univ Montpellier, IES, CNRS, Montpellier, France.},
DOI = {10.1109/DFT63277.2024.10753530},
Keywords = {Cryptography; RFC 8439; Hardware Acceleration; Fault Tolerance<bold>;
   </bold>},
Author-Email = {wesley.grignani@edu.univali.br
   khalil.santana@edu.univali.br
   douglas.santos@umontpellier.fr
   luigi.dilillo@umontpellier.fr
   drm@univali.br},
