Number = {2},
Month = {FEB},
Abstract = {The utilization of a radiation -hard microprocessor or a System -on
   -Chip (SoC) design methodology significantly benefits the future design
   of ASICs for HEP experiments. To evaluate the fault tolerance of a
   radiation -hard design, it is important to obtain detailed information
