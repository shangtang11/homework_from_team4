@inproceedings{ WOS:001575951700021,
Author = {Dolmeta, Alessandra and Piscopo, Valeria and Martina, Maurizio and
   Masera, Guido},
Book-Group-Author = {IEEE},
Title = {CHIMERA: Cryptographic Hardware for Integrated Multipurpose Engine on
   RISC-V with ASCON},
Booktitle = {2025 IEEE COMPUTER SOCIETY ANNUAL SYMPOSIUM ON VLSI, ISVLSI},
Series = {IEEE Computer Society Annual Symposium on VLSI},
Year = {2025},
Pages = {120-125},
Note = {2025 Computer Society Symposium on VLSI-ISVLSI, Kalamata, GREECE, JUL
   06-09, 2025},
Abstract = {In the context of the growing Internet-of-Things (IoT) ecosystem, where
   security and privacy concerns are critical due to the limited resources
   of connected devices, lightweight cryptography plays a vital role.
   ASCON, a lightweight cryptographic algorithm designed for constrained
   environments, offers robust security mechanisms such as Authenticated
   Encryption with Associated Data (AEAD), hashing, Message Authentication
   Code (MAC) generation and Pseudorandom Functions (PRF). In this work, we
   introduce CHIMERA, an Application Specific Instruction Set Processor
   (ASIP) architecture tailored to efficiently compute the ASCON algorithm
   on 32-bit RISC processors. The ASIP interfaces with the RISC-V core via
   the Core-V eXtension Interface (CV-X-IF), a novel communication
   mechanism. CHIMERA functions as a multipurpose coprocessor, supporting
   AEAD (ASCON-128, ASCON-128a) and hashing (Hash, Hasha). We present two
   versions of CHIMERA: the Complete Round (CR) version, a tightly coupled
   accelerator that delivers high performance at a higher hardware cost,
   and the Bitwise Rotation Unit (BRU) version, an Instruction Set
   Extension (ISE) offering lower efficiency but minimal area requirements.
   The design has been implemented on both Zynq Ultrascale+ FPGA and ASIC
   platforms, with results comparing the two versions and evaluating their
   performance relative to the state-of-the-art.},
Type = {Proceedings Paper},
Affiliation = {Dolmeta, A (Corresponding Author), Politecn Torino, Dept Elect \& Telecommunicat, Turin, Italy.
   Dolmeta, Alessandra; Piscopo, Valeria; Martina, Maurizio; Masera, Guido, Politecn Torino, Dept Elect \& Telecommunicat, Turin, Italy.},
