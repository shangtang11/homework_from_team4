@inproceedings{ WOS:001605645000053,
Author = {Pieper, Pascal and Wimmer, Ralf and Angst, Gerhard and Drechsler, Rolf},
Book-Group-Author = {ACM},
Title = {Minimally Invasive HW/SW Co-debug Live Visualization on Architecture
   Level},
Booktitle = {PROCEEDINGS OF THE 2021 GREAT LAKES SYMPOSIUM ON VLSI, GLSVLSI 2021},
Year = {2021},
Pages = {321-326},
Note = {2021 Great Lakes Symposium on VLSI-GLSVLSI, ELECTR NETWORK, JUN 22-25,
   2021},
Abstract = {We present a tool that allows developers to debug hard- and software and
   their interaction in an early design stage. We combine a SystemC virtual
   prototype (SystemC) with an easily configurable and interactive
   graphical user interface and a standard software debugger. The graphical
   user interface visualizes the internal slate of the hardware. At the
   same time, the software debugger monitors and allows to manipulate the
   slate of the software. This co-visualization supports design
   understanding and live debugging of the HW/SW interaction. We
