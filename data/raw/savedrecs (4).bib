@article{ WOS:001220674200001,
Author = {Baungarten-Leon, Emilio Isaac and Ortega-Cisneros, Susana and
   Abdelmoneum, Mohamed and Morales, Ruth Yadira Vidana and Pinedo-Diaz,
   German},
Title = {The Genesis of AI by AI Integrated Circuit: Where AI Creates AI},
