@inproceedings{ WOS:001656843900002,
Author = {Austa, Cedrick and Muhlberg, Jan Tobias and Dricot, Jean-Michel},
Editor = {Nicomette, V and Benzekri, A and Boulahia-Cuppens, N and Vaidya, J},
Title = {Systematic Assessment of Cache Timing Vulnerabilities on RISC-V
   Processors},
Booktitle = {COMPUTER SECURITY-ESORICS 2025, PT III},
