@inproceedings{ WOS:001566005900169,
Author = {Waucquez, Luis and Rodriguez, Alfonso},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Reconfigurable Processor-Centric Accelerators for Safety-Critical
   Applications},
Booktitle = {2025 IEEE INTERNATIONAL PARALLEL AND DISTRIBUTED PROCESSING SYMPOSIUM
   WORKSHOPS, IPDPSW},
Series = {International Symposium on Parallel and Distributed Processing Workshops
   and Phd Forum},
Year = {2025},
Pages = {1236-1242},
Note = {2025 International Parallel and Distributed Processing Symposium
   Workshops-IPDPSW-Annual, Milan, ITALY, JUN 03-07, 2025},
Abstract = {The increasing complexity of modern electronic systems deployed in harsh
   environments with stringent safety-critical requirements demands robust
   mechanisms to ensure safety and to provide fault-tolerance capabilities.
   These systems must operate effectively under adverse conditions,
   addressing challenges such as single-event upsets and common mode
   failures in applications such as IoT, aerospace, and automotive
   industries. This paper presents a flexible processor-centric accelerator
   platform tailored for safety-critical applications. Based on the RISC-V
   ISA, the cores of the platform support four operational modes: Single,
   Triple-Core LockStep (TCLS), Dual-Core LockStep (DCLS), and DCLS with
   classic staggering, enabling adaptable safety-oriented configurations to
   meet diverse critical application profiles. A fault injection campaign
   has been conducted to characterize the performance and fault tolerance
   of the platform, demonstrating its ability to ensure reliable operation
   while providing the required computing power.},
