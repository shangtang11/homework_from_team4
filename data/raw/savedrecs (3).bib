@inproceedings{ WOS:001540479400049,
Author = {Vargas, Fabian and Andjelkovic, Marko and Krstic, Milos and Kar, Anirban
   and Deshwal, Swati and Chauhan, Yogesh S. and Amrouch, Hussam and Tille,
   Daniel and Huhn, Sebastian},
Book-Group-Author = {IEEE},
Title = {Self-Aware Silicon: Enhancing Lifecycle Management with Intelligent
   Testing and Data Insights},
Booktitle = {2025 IEEE EUROPEAN TEST SYMPOSIUM, ETS},
Series = {Proceedings of the European Test Symposium},
Year = {2025},
Note = {2025 European Test Symposium-ETS-Annual, Tallinn, ESTONIA, MAY 26-30,
   2025},
Abstract = {Traditional Integrated Circuit (IC) testing methods rely on external
   testers and predefined test patterns, which are becoming increasingly
   inadequate as semiconductor complexity grows. The demand for higher
   reliability, functional safety, and lifecycle efficiency necessitates a
   shift toward more autonomous and intelligent testing approaches.
   Embedding intelligence directly into silicon enables real-time
   diagnostics, adaptive optimization, and predictive maintenance,
   addressing the limitations of conventional tester-dependent
   methodologies. This paper explores self-aware silicon and its role in
   the overall Silicon Lifecycle Management. By leveraging on-chip sensors
   and Electronic Design Automation methodologies for advanced CMOS
   technology nodes, self-aware silicon facilitates continuous monitoring,
   anomaly detection, and intelligent decision-making within ICs. These
   innovations enhance reliability, optimize performance, and reduce costly
   failures throughout the silicon lifecycle.},
