@inproceedings{ WOS:001329127500153,
Author = {Dehghani, Mahsa and Elahi, Mehdi and Fazeli, Mahdi and Patooghy, Ahmad},
Editor = {Thapliyal, H and Becker, J},
Title = {Advancing IoT Security Through Run-time Monitoring \& Post-Execution
   Verification},
Booktitle = {2024 IEEE COMPUTER SOCIETY ANNUAL SYMPOSIUM ON VLSI, ISVLSI},
Series = {IEEE Computer Society Annual Symposium on VLSI},
Year = {2024},
Pages = {825-829},
Note = {IEEE-Computer-Society Annual Symposium on VLSI (ISVLSI), Knoxville, TN,
   JUL 01-03, 2024},
Abstract = {This paper, for the first time, proposes the joint application of
   run-time monitoring and post-execution verification methods to protect
   the integrity of AES encryption on Internet-of-Things (IoT) systems
   against fault injection attacks. The proposed method operates on the
   source code of the encryption algorithm and introduces a limited number
   of redundant variables into the AES code before compilation to monitor
   and detect fault attacks at runtime. For further integrity checking,
   time-series analysis of the redundant variables is used as a
   post-execution verification method that captures the attacks not caught
   by runtime detection. Our combined method has been evaluated through
   software simulation, in which we have injected 1200 fault attacks into a
   running AES code. The simulation results show that the run-time
   monitoring and post-execution verification methods can, together, detect
   up to 98\% of conducted fault attacks. The biggest advantage of this
   method is its applicability to any hardware platform without the need
   for additional hardware support.},
Type = {Proceedings Paper},
Affiliation = {Elahi, M (Corresponding Author), North Carolina A\&T State Univ, Dept Comp Syst Technol, Greensboro, NC 27411 USA.
   Elahi, Mehdi; Patooghy, Ahmad, North Carolina A\&T State Univ, Dept Comp Syst Technol, Greensboro, NC 27411 USA.
   Fazeli, Mahdi, Halmstad Univ, Halmstad, Sweden.},
