DOI = {10.1109/JSSC.2018.2888866},
Keywords = {Near-subthreshold system; phase-locked loop (PLL); process; voltage; and
   temperature (PVT) variation; supply droop; switched capacitor (SC);
   UniCaP; voltage margin; voltage regulation},
