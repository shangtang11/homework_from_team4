@inproceedings{ WOS:001691804100906,
Author = {Zhang, Xinkai and Gao, Shang and Yu, Bintao and Dai, Wenbin},
Book-Group-Author = {IEEE},
Title = {A High-Performance Fault-Tolerant Scheduling Mechanism for Virtualized
   Industrial Edge Applications},
Booktitle = {IECON 2025-51ST ANNUAL CONFERENCE OF THE IEEE INDUSTRIAL ELECTRONICS
   SOCIETY},
Year = {2025},
Note = {51st Conference of the Industrial Electronics Society-IECON-Annual,
   Madrid, SPAIN, OCT 14-17, 2025},
Abstract = {The core requirement of industrial automation systems is continuous and
   stable running. System design for the next-generation Industrial
   Internet must meet the high reliability requirements of industrial
   automation systems. This paper presents a design method for a dual-mode
   redundancy mechanism in virtualized runtime systems for the Industrial
   Internet. Through reliability analysis and comparison of multiple
   redundancy architectures, the applicability of the dual-mode redundancy
   mechanism in industrial scenarios is established. Compared with
   traditional hardware redundancy solutions, this method features
   lightweight deployment and fast iterative updates, significantly
   reducing system resource consumption and labor costs. Experimental data
   show that as the number of connected devices increases, the complexity
   growth curve of the virtualized runtime system is significantly lower
   than traditional hardware redundancy mechanisms, and performance
   indicators meet the stability and reliability requirements of
   next-generation industrial scenarios.},
