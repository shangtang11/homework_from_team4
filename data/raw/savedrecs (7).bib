   Naith, Qamar H., Univ Jeddah, Coll Comp Sci \& Engn, Dept Software Engn, Jeddah 21959, Saudi Arabia.},
DOI = {10.1109/ACCESS.2023.3342079},
Keywords = {Asymmetric cryptography; blockchain; consensus protocols; digital
