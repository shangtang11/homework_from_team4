@inproceedings{ WOS:001339362100025,
Author = {Kumar, P. Siva and Rajalakshmi, R. and Kumar, N. Hemanth and Gupta, B.
   Prem and Nikhilesh, C. H. and Pavan, J. Sai Padma},
Book-Group-Author = {IEEE},
Title = {Robust Serial Driver Verification Through UVM Framework},
Booktitle = {2024 CONTROL INSTRUMENTATION SYSTEM CONFERENCE, CISCON 2024},
Year = {2024},
Note = {Control Instrumentation System Conference (CISCON) - Guiding Tomorrow -
   Emerging Trends in Control, Instrumentation, and Systems Engineering,
   Manipal, INDIA, AUG 02-03, 2024},
Abstract = {The goal of this work is to provide thorough verification using the
   Universal Verification Methodology (UVM) to guarantee the accuracy and
   reliability of serial drivers in contemporary electronic systems. The
   primary aim is to create a Monitor Module in the UVM framework for the
   purpose of observing and verifying the behavior of the serial driver in
   testing and simulation scenarios. The Monitor Module is critical for
   determining compliance with UVM's standards and improves modularity and
   reusability. In order to test serial drivers, the project will create a
   UVM-based verification environment, create a monitor module to track
   important behaviors of the driver, run a number of test cases to assess
   functionality and dependability, and expand verification coverage to
   investigate the communication protocol in detail. In digital
   electronics, serial driver verification is essential for maintaining
   system accuracy and robustness. To make protocol compliance evaluation
   easier, the recommended Serial Driver Verification Scoreboard Module is
   a great help. Error detection, thorough protocol verification, and
   efficient reporting are some of its benefits.},
