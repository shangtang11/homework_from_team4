@inproceedings{ WOS:001414927800053,
Author = {Peccia, Federico Nicolas and Pavlitska, Svetlana and Fleck, Tobias and
   Bringmann, Oliver},
Editor = {Kryjak, T and Petrot, F},
Title = {Efficient Edge AI: Deploying Convolutional Neural Networks on FPGA with
   the Gemmini Accelerator},
Booktitle = {2024 27TH EUROMICRO CONFERENCE ON DIGITAL SYSTEM DESIGN, DSD 2024},
Series = {Euromicro Symposium on Digital System Design},
Year = {2024},
Pages = {418-426},
Note = {27th Euromicro Conference on Digital System Design, FRANCE, AUG 28-30,
   2024},
Abstract = {The growing concerns regarding energy consumption and privacy have
   prompted the development of AI solutions deployable on the edge,
   circumventing the substantial CO2 emissions associated with cloud
   servers and mitigating risks related to sharing sensitive data. But
   deploying Convolutional Neural Networks (CNNs) on non-off-the-shelf edge
   devices remains a complex and labor-intensive task. In this paper, we
   present an end-to-end workflow for the deployment of CNNs on Field
   Programmable Gate Arrays (FPGAs) using the Gemmini accelerator, which we
   modified for efficient implementation on FPGAs. We describe how we
   leverage the use of open-source software on each optimization step of
   the deployment process, the customizations we added to them and their
   impact on the final system's performance. We were able to achieve
   real-time performance by deploying a YOLOv7 model on a Xilinx ZCU102
   FPGA with an energy efficiency of 36.5 GOP/s/W. Our FPGA-based solution
   demonstrates superior power efficiency compared with other embedded
   hardware devices and even outperforms other FPGA reference
   implementations. Finally, we present how this kind of solution can be
   integrated into a wider system, by testing our proposed platform in a
   traffic monitoring scenario.},
Type = {Proceedings Paper},
Affiliation = {Peccia, FN (Corresponding Author), FZI Res Ctr Informat Technol, Karlsruhe, Germany.
