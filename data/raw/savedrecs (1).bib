@article{ WOS:001543382600001,
Author = {Li, Jingsheng and Gao, Mingyu},
Title = {A comprehensive survey of hardware-based security techniques from an
   architectural perspective},
Journal = {JOURNAL OF SYSTEMS ARCHITECTURE},
Year = {2025},
Volume = {168},
Month = {NOV},
Abstract = {In response to the increasing complexity and severity of system-level
   attacks, hardware-based security has gained prominence for its superior
   predictability, consistency, and ability to establish a strong root of
   trust compared to software-based solutions. However, the rapid evolution
   of hardware-based security mechanisms makes it difficult to develop a
   cohesive taxonomy. Researchers face a diverse and expanding array of
   techniques, many integrating multiple hardware primitives. Given these
   challenges, existing taxonomies often focus on specific domains, attack
   models, or implementation details, failing to capture structural
   relationships between technologies. Moreover, although industrial
   advancements have significantly inspired academic research, the process
   of systematically tracing their influence on new security designs
   remains unestablished. To address these limitations, we introduce a
   novel hierarchical taxonomy that categorizes hardware-based security
   mechanisms into three groups based on their protection goals: trusted
   computing platform, isolated execution environment, and trusted program
   execution. Within each group, key designs are further classified based
   on distinctive characteristics . This study also identifies shared
   architectural primitives and reveals how they are combined to satisfy
   diverse security needs. Not only bridges the gap between academic and
   industrial perspectives, this taxonomy also offers architectural
   guidance for developing future hardware-based security solutions.},
Type = {Article},
