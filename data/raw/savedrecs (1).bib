@article{ WOS:001521670300004,
Author = {Yadav, Dhirendra Prasad and Sharma, Bhisham and Olague, Gustavo},
Title = {Explainable attention-based fuzzy residual convolution network for solar
   cell defect identification and classification},
Journal = {ENGINEERING APPLICATIONS OF ARTIFICIAL INTELLIGENCE},
Year = {2025},
Volume = {158},
Number = {A},
Month = {OCT 15},
Abstract = {The demand for renewable energy is increasing globally, which has led to
   significant progress in solar cell technology. Solar cell plates convert
   sunlight into electrical energy used in several utilities. Various
   faults, including cracks, delamination, and cell breakdowns, can
   significantly affect the performance of a photovoltaic module.
   Conventional manual inspection techniques are costly and prone to human
   mistakes, rendering them unfeasible on a broad scale. Advancements in AI
   (artificial intelligence) techniques, such as ML (machine learning) and
   DL (deep learning), have shown effectiveness in automatic solar cell
   defect detection. DL automatically extracts spatial features and
   improves solar cell defect detection. However, ML-based methods need
   hand-crafted solar cell analysis features. Indeed, DL performance
   correlates to the quality of the annotated dataset in which the expert
   is unsure about classifying damaged and good solar panels. To approach
   such a problem, we have designed an attention-based fuzzy residual
   convolution network, which generates crisp and fuzzy values to enhance
   solar cell defect identification. In the proposed model, five
   convolution layers extract high-dimensional spatial features. In
   addition, we designed a residual attention module, which focuses on the
   relevant region of the solar cell image. The improved feature map is
   passed to the fuzzy inference module to capture more fine-grained
   spatial features using the Gaussian fuzzy membership rule. Furthermore,
   a gradientweighted module is implemented on the model to make it more
   explainable in defect analysis. We assessed the effectiveness of our
   model on three datasets and compared the results with six other methods,
   which achieved significant improvement according to the benchmarks.
   -Source code of the method is available via GitHub URL:
   https://github.com/dhirujis02/Solarcell.},
