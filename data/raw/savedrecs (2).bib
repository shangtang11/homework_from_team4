@inproceedings{ WOS:001539185100013,
Author = {Brilli, Gianluca and Capotondi, Alessandro and Burgio, Paolo and
   Marongiu, Andrea},
Book-Group-Author = {ACM},
Title = {Enabling the Proxy Computing Paradigm on DPU-based FPGA Acceleration},
Booktitle = {PROCEEDINGS OF THE22ND ACM INTERNATIONAL CONFERENCE ON COMPUTING
   FRONTIERS 2025, CF 2025},
Year = {2025},
Pages = {80-83},
Note = {22nd International Conference on Computing Frontiers-CF, Cagliari,
   ITALY, MAY 28-30, 2025},
Abstract = {FPGA-based heterogeneous systems are a popular choice for accelerating
   Deep Neural Networks (DNNs), but efficiently integrating and
   orchestrating HW and SW tasks remains challenging. FPGA overlay
   architectures have been proposed to simplify accelerator management, yet
   state-of-the-art solutions struggle with performance bottlenecks caused
   by frequent CPU-FPGA interactions. We introduce a novel overlay-based
   methodology enabling the Proxy Computing paradigm, leveraging a local
   orchestrator and shared memory to (i) reduce accelerator control
   overhead and (ii) minimize unnecessary data movements. As a case study,
   we integrate the AMD/Xilinx Deep Learning Processing Unit (DPU) with
   additional accelerators for unsupported layers. Experiments show that
   our approach significantly reduces memory transfers, achieving up to 4x
   speed up in the proposed case study.},
Type = {Proceedings Paper},
Affiliation = {Brilli, G (Corresponding Author), Univ Modena \& Reggio Emilia, Modena, Italy.
   Brilli, Gianluca; Capotondi, Alessandro; Burgio, Paolo; Marongiu, Andrea, Univ Modena \& Reggio Emilia, Modena, Italy.},
