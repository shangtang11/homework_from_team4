@article{ WOS:001443122500001,
Author = {Nikdel, Nazila and Kouhi, Abolfazl},
Title = {Mitigating tractor vibrations with a robust adaptive fractional
   Controller: Design and Validation},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2025},
Volume = {275},
Month = {MAY 25},
Abstract = {Agricultural tractors are often used on uneven grounds, which results in
   significant vibrations. These vibrations negatively affect driver
   comfort and health. Moreover, they lead to more vehicle mechanical parts
   wear. Traditional suspension systems fail to adapt to changing road
   conditions due to nonlinear dynamics and uncertainties in tractor
   suspension systems. To address these challenges, this paper proposes a
   nonlinear adaptive fractional-order controller for agricultural
   tractors' active suspension systems to decrease vibrations caused by
   changing road criteria. The suggested controller faces the challenges of
   nonlinear dynamics and uncertainties in tractor suspension systems using
   fractional-order calculus. This paper first formulates the tractor's
   active suspension dynamics, including the interaction between the
   tractor body, suspension masses, and control forces. Then, an adaptive
   controller is developed using fractional-order operators, and stability
   analyses are performed based on Mittag-Leffler conditions to ensure
   robust performance in the presence of parameter variations and external
   disturbances. Results demonstrate the efficacy of the proposed method in
   significant reduction of vehicle body accelerations and improvement of
   ride comfort compared to state-of-the-art controllers. This research
   demonstrates the potential of fractional-order control in the
   advancement of active suspension technology in agricultural machines,
   enhancements in driver safety, operational efficiency in challenging
   agricultural environments, and reduction of mechanical parts wear.},
Type = {Article},
