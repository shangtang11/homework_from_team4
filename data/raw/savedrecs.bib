@article{ WOS:001606791700001,
Author = {Wan, Rentao and Lin, Chuan-Tung and Zhang, Bo and Tsividis, Yannis and
   Seok, Mingoo},
Title = {AACIM: A 2785-TOPS/W, 161-TOP/mm2, <1.17\%-RMSE, Analog-In
   Analog-Out Computing-In-Memory Macro in 28 nm},
Journal = {IEEE JOURNAL OF SOLID-STATE CIRCUITS},
Year = {2025},
Month = {2025 OCT 29},
Abstract = {This article presents an analog-in analog-out CIM macro (AACIM) for use
   in analog deep neural network (DNN) processors. Our macro receives
   analog inputs, performs a 64-by-32 vector-matrix multiplication (VMM)
   with a current-discharging computation mechanism, and produces analog
   outputs. It stores a 4-bit weight as an analog voltage in the custom
   3T1C capacitor-based memory cell. The macro features a current-based
   self-calibration writing (CSCW) scheme to program weight-proportional
   currents into cells with a feedback loop, greatly reducing the writing
   error across process, voltage, and temperature (PVT) variations. In
   addition, the macro uses a discharging current stabilization (DCS)
   scheme to mitigate current degradation due to short-channel effects,
   improving the computation accuracy. Besides, it combines several
   techniques to mitigate coupling noise and leakages, extending the cell
   retention time to approximately 300 mu s. Fabricated in a 28-nm process,
   the AACIM macro demonstrates an energy efficiency of 2785 TOPS/W and a
   compute density of 160.9 TOPS/mm(2 ), with a weight density of 1.67
   Mb/mm(2 )for 4-bit operations at 0.9 V. In addition, it maintains robust
   performance with an RMSE of less than 1.17\% across temperature
   variations from -20 C-degrees to 70(degrees)C and +/- 10\% supply
   voltage variations. We also confirm the functionality at a cryogenic
   temperature with a significantly improved retention time.},
Type = {Article; Early Access},
Affiliation = {Seok, M (Corresponding Author), Columbia Univ, Dept Elect Engn, New York, NY 10027 USA.
   Wan, Rentao; Lin, Chuan-Tung; Zhang, Bo; Tsividis, Yannis; Seok, Mingoo, Columbia Univ, Dept Elect Engn, New York, NY 10027 USA.},
