@inproceedings{ WOS:001540716400176,
Author = {Ammar, Mahmoud and Caulfield, Adam and Nunes, Ivan De Oliveira},
Editor = {Blanton, M and Enck, W and Nita-Rotaru, C},
Title = {SoK: Integrity, Attestation, and Auditing of Program Execution},
Booktitle = {2025 IEEE SYMPOSIUM ON SECURITY AND PRIVACY, SP},
Series = {IEEE Symposium on Security and Privacy},
Year = {2025},
Pages = {3255-3272},
Note = {2025 Symposium on Security and Privacy-SP, San Francisco, CA, MAY 12-15,
   2025},
Abstract = {This paper provides a systematic exploration of Control Flow Integrity
   (CFI) and Control Flow Attestation (CFA) mechanisms, examining their
   differences and relationships. It addresses crucial questions about the
   goals, assumptions, features, and design spaces of CFI and CFA,
   including their potential coexistence on the same platform. Through a
   comprehensive review of existing defenses, this paper positions CFI and
   CFA within the broader landscape of runtime defenses, critically
   evaluating their strengths, limitations, and trade-offs. The findings
   emphasize the importance of further research to bridge the gaps in CFI
   and CFA and thus advance the field of runtime defenses.},
Type = {Proceedings Paper},
Affiliation = {Caulfield, A (Corresponding Author), Rochester Inst Technol, Rochester, NY 14623 USA.
