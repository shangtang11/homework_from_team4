@inproceedings{ WOS:001339488100083,
Author = {Lungu, Nelson and Dash, Bibhuti Bhusan and Mishra, Manoj Ranjan and
   Pattnayak, Parthasarathi and Gourisaria, Mahendra Kumar and Patra,
   Sudhansu Shekhar},
Book-Group-Author = {IEEE},
Title = {RISC-V Power Analysis Attack Mitigation in a GPU Execution Framework},
Booktitle = {2024 SECOND INTERNATIONAL CONFERENCE ON INTELLIGENT CYBER PHYSICAL
   SYSTEMS AND INTERNET OF THINGS, ICOICI 2024},
Year = {2024},
Pages = {512-517},
Note = {2nd International Conference on Intelligent Cyber Physical Systems and
   Internet of Things (ICoICI), JCT Coll Engn \& Technol, Coimbatore,
   INDIA, AUG 28-30, 2024},
Abstract = {Side-channel analysis attacks utilising power or electromagnetic
   emanations have demonstrated success against cryptosystems implemented
   in Reduced Instruction Set Computer V (RISC-V) processors. The high
   parallelism and data intensity of graphics processing units (GPUs)
   executing shader programs leaves them vulnerable to such attacks. We
   propose novel countermeasures leveraging RISC-V extensions targeting GPU
   architectures to detect and mitigate power analysis attacks during
   shader execution. By monitoring instruction entropy and applying
   randomised code transformations through the GPU backend compiler, we
   detect abnormal power consumption patterns. Selective duplication of
   shader ALU operations masks power models while preserving performance.
   Our techniques provide provable information leakage bounds under
   standard power analysis attack models. Experiments on a Field
   Programmable Gate Array (FPGA)based RISC-V GPU demonstrate negligible
   overhead with high attack resistance. This work enables secure RISC-V
   shader execution resilient against side-channel leakage.},
