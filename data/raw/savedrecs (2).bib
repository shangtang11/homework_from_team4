@inproceedings{ WOS:001511035800008,
Author = {Aihara, Yasuto and Adhi, Boma Anantasatya and Aiyoshi, Kota and Shi,
   Chenlin and Anderson, Jason and Ueno, Tomohiro and Sano, Kentaro and
   Miyajima, Takaaki},
Editor = {Ueno, T and Abdelhadi, A and Koch, D and Osana, Y and Sato, Y},
Title = {Impact of Reconvergent DFG Paths and Buffer Depth on Elastic CGRA
   Throughput},
Booktitle = {PROCEEDINGS OF THE 15TH INTERNATIONAL SYMPOSIUM ON HIGHLY EFFICIENT
   ACCELERATORS AND RECONFIGURABLE TECHNOLOGIES, HEART 2025},
Year = {2025},
Pages = {76-79},
Note = {15th International Symposium on Highly Efficient Accelerators and
   Reconfigurable Technologies-HEART, Kumamoto, JAPAN, MAY 26-28, 2025},
Abstract = {The elastic architecture of RIKEN's coarse-grained reconfigurable array
   (RIKEN CGRA) allows autonomous and decentralized flow-control with a
   back-pressure mechanism everywhere in the array that is necessary for
   dynamic response of external modules. However, when a data-flow graph
   (DFG) mapped on the CGRA has different lengths for paths from
   synchronous input nodes to a target operator node, back-pressure
   triggered in a shorter path can cause oscillation of stalls for data
   flow, resulting in degradation of computational throughput, while FIFO
   queues in processing elements (PEs) can absorb the difference in path
   lengths. To address this issue, we evaluate the impact of FIFO depth on
   computational throughput for the RIKEN CGRA. Given an imbalanced DFG
   with different path lengths, we observe that increasing FIFO depth for
   all the PEs improves computational throughput. However, the impact is
   nonlinear and diminishing.},
Type = {Proceedings Paper},
Affiliation = {Aihara, Y (Corresponding Author), Meiji Univ, Tokyo, Japan.
