@inproceedings{ WOS:001293532100016,
Author = {Wirsch, Ramon and Hochberger, Christian},
Editor = {Goumas, G and Tomforde, S and Brehm, J and Wildermann, S and Pionteck, T},
Title = {Improved Condition Handling in CGRAs with Complex Loop Support},
Booktitle = {ARCHITECTURE OF COMPUTING SYSTEMS, ARCS 2023},
Series = {Lecture Notes in Computer Science},
Year = {2023},
Volume = {13949},
Pages = {233-247},
Note = {36th International Conference on Architecture of Computing Systems
   (ARCS), Athens, GREECE, JUN 13-15, 2023},
Abstract = {Coarse Grained Reconfigurable Arrays (CGRA) have become a popular
   technology to realize compute accelerators. CGRAs can be found in
   High-Performance systems and also in embedded systems. In order to
   provide the highest speedup, they need to support conditional statements
   and nested loops. This requires a management of conditions within the
   CGRA. This management can be done in different ways. In this
   contribution, we compare two such concepts and evaluate the impact that
   these concepts have on the achievable clock frequency, the required
   resources and the change of schedules. It turns out, that with our new
   condition management and the accompanying advanced schedule, we can save
   more than 20\% of runtime.},
