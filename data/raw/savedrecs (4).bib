@inproceedings{ WOS:001148151200010,
Author = {Bargmann, Lara and Wehrheim, Heike},
Editor = {Herber, P and Wijs, A},
Title = {Lifting the Reasoning Level in Generic Weak Memory Verification},
Booktitle = {INTEGRATED FORMAL METHODS, IFM 2023},
Series = {Lecture Notes in Computer Science},
Year = {2024},
Volume = {14300},
Pages = {175-192},
Note = {18th International Conference on Integrated Formal Methods (IFM), Leiden
   Univ, Leiden Inst Adv Comp Sci, Leiden, NETHERLANDS, NOV 13-15, 2023},
Abstract = {Weak memory models specify the semantics of concurrent programs on
   multi-core architectures. Reasoning techniques for weak memory models
   are often specialized to one fixed model and verification results are
   hence not transferable to other memory models. A recent proposal of a
   generic verification technique based on axioms on program behaviour
   expressed via weakest preconditions aims at overcoming this
   specialization to dedicated models. Due to the usage of weakest
   preconditions, reasoning however takes place on a very low level
   requiring the application of numerous axioms for deriving program
   properties, even for a single statement.
   In this paper, we lift reasoning in this generic verification approach
   to a more abstract level. Based on a view-based assertion language, we
   provide a number of novel proof rules for directly reasoning on the
   level of program constructs. We prove soundness of our proof rules and
   exemplify them on the write-to-read causality (WRC) litmus test. A
   comparison to the axiom-based low-level proof reveals a significant
   reduction in the number of required proof steps.},
Type = {Proceedings Paper},
Affiliation = {Bargmann, L (Corresponding Author), Carl von Ossietzky Univ Oldenburg, Dept Comp Sci, Oldenburg, Germany.
   Bargmann, Lara; Wehrheim, Heike, Carl von Ossietzky Univ Oldenburg, Dept Comp Sci, Oldenburg, Germany.},
