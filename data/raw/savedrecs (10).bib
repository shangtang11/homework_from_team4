@article{ WOS:000497973300007,
Author = {Chao, Lu and Peng, Xiaohui and Xu, Zhiwei and Zhang, Lei},
Title = {Ecosystem of Things: Hardware, Software, and Architecture},
Journal = {PROCEEDINGS OF THE IEEE},
Year = {2019},
Volume = {107},
Number = {8, SI},
Pages = {1563-1583},
Month = {AUG},
Abstract = {Edge computing is a continuum that includes the computing resources from
   cloud to things. Ecosystem of things (EoT) is a subsystem of the
   ecosystem of edge computing, which potentially contains trillions of
   devices of things and directly interacts with the physical world. This
   paper surveys the state of the art of EoT by focusing on the computing
   infrastructure aspect with a forward-looking perspective. We point out a
   trend of smart edge computing with four types of smartness and
   intelligence. We address three fundamental questions. 1) What
   capabilities and how much energy efficiency are the hardware providing?
   What is the future growth potential? 2) What abstractions are provided
   by the system software? Are they adequate to support smart edge
   computing? 3) What ecosystem architectures have been proposed for the
   coordination of things, the edge, and the cloud? Are they meeting the
   needs to encourage innovation but avoid unnecessary ecosystem
   fragmentation? We examine advances from both industry and academia,
   including research results, visions, and project concepts. We also point
   out future research directions.},
Type = {Article},
Affiliation = {Peng, XH (Corresponding Author), Chinese Acad Sci, Inst Comp Technol, State Key Lab Comp Architecture, Beijing 100190, Peoples R China.
   Chao, Lu; Peng, Xiaohui; Xu, Zhiwei; Zhang, Lei, Chinese Acad Sci, Inst Comp Technol, State Key Lab Comp Architecture, Beijing 100190, Peoples R China.
   Chao, Lu; Peng, Xiaohui; Xu, Zhiwei; Zhang, Lei, Univ Chinese Acad Sci, Beijing 100049, Peoples R China.},
DOI = {10.1109/JPROC.2019.2925526},
Keywords = {Architecture; ecosystem of things (EoT); edge computing; hardware;
   Internet of Things (IoT); software},
Keywords-Plus = {SEMANTIC INTEROPERABILITY; INTERNET; IOT; CLOUD; ACCELERATOR; POWER},
