Title = {An Energy-Efficient Near-Memory Computing Architecture for CNN Inference
   at Cache Level},
Booktitle = {2021 28TH IEEE INTERNATIONAL CONFERENCE ON ELECTRONICS, CIRCUITS, AND
   SYSTEMS (IEEE ICECS 2021)},
Series = {IEEE International Conference on Electronics Circuits and Systems},
Year = {2021},
Note = {28th IEEE International Conference on Electronics, Circuits, and Systems
   (IEEE ICECS), Dubai, U ARAB EMIRATES, NOV 28-DEC 01, 2021},
Abstract = {A non-von Neumann Near-Memory Computing architecture, optimized for CNN
   inference in edge computing, is integrated in the cache memory
   sub-system of a microcontroller unit. The NMC co-processor is evaluated
   using an 8-bit fixedpoint quantized CNN model, and achieves an accuracy
   of 98\% on the MNIST dataset. A full inference of the CNN model executed
   on the NMC processor, demonstrates an improvement of more than 34 x in
   performance, and 28 x in energy-efficiency, compared to the baseline
   scenario of a conventional single-core processor. The design achieves a
   performance of 1.39GOPS (at 200 MHz) and an energy-efficiency of 49
   GOPS/W, with negligible area overhead of less than 1\%.},
