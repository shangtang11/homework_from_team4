@inproceedings{ WOS:000722241000005,
Author = {Ottavi, Gianmarco and Karunaratne, Geethan and Conti, Francesco and
   Boybat, Irem and Benini, Luca and Rossi, Davide},
Book-Group-Author = {IEEE},
Title = {End-to-end 100-TOPS/W Inference With Analog In-Memory Computing: Are We
   There Yet?},
Booktitle = {2021 IEEE 3RD INTERNATIONAL CONFERENCE ON ARTIFICIAL INTELLIGENCE
   CIRCUITS AND SYSTEMS (AICAS)},
Year = {2021},
Note = {IEEE 3rd International Conference on Artificial Intelligence Circuits
   and Systems (AICAS), ELECTR NETWORK, JUN 06-09, 2021},
Abstract = {In-Memory Acceleration (IMA) promises major efficiency improvements in
   deep neural network (DNN) inference, but challenges remain in the
   integration of IMA within a digital system. We propose a heterogeneous
   architecture coupling 8 RISC-V cores with an IMA in a shared-memory
   cluster, analyzing the benefits and trade-offs of in-memory computing on
   the realistic use case of a MobileNetV2 bottleneck layer. We explore
   several IMA integration strategies, analyzing performance, area, and
   energy efficiency. We show that while pointwise layers achieve
   significant speed-ups over software implementation, on depthwise layer
   the inability to efficiently map parameters on the accelerator leads to
   a significant trade-off between throughput and area. We propose a hybrid
   solution where pointwise convolutions are executed on IMA while
   depthwise on the cluster cores, achieving a speed-up of 3x over SW
   execution while saving 50\% of area when compared to an all-in IMA
   solution with similar performance.},
