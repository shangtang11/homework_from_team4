@inproceedings{ WOS:001027444200143,
Author = {Thakur, Shailja and Ahmad, Baleegh and Fan, Zhenxing and Pearce, Hammond
   and Tan, Benjamin and Karri, Ramesh and Dolan-Gavitt, Brendan and Garg,
   Siddharth},
