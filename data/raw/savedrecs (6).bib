   Azarderakhsh, Reza, Florida Atlantic Univ, Dept Comp \& Elect Engn \& Comp Sci, Boca Raton, FL 33431 USA.},
DOI = {10.1109/TCAD.2022.3218614},
Keywords = {Field-programmable gate array (FPGA); number-theoretic transform (NTT);
   post-quantum cryptography (PQC); recomputing with negated operands
   (RENO)},
