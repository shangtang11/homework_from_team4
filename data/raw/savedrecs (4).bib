@article{ WOS:001235687300001,
Author = {Saoudi, Mohamed and Kermiche, Akram and Benhaddad, Omar Hocine and
   Guetmi, Nadir and Allailou, Boufeldja},
Title = {Low latency FPGA implementation of NTT for Kyber},
Journal = {MICROPROCESSORS AND MICROSYSTEMS},
Year = {2024},
Volume = {107},
Month = {JUN},
Abstract = {This paper presents an FPGA implementation of Number Theoretic Transform
   (NTT) for the Kyber PostQuantum Cryptographic (PQC) standard. NTT is the
   slowest process within Kyber thus a large number of efforts has been
   conducted to enhance its computational efficiency. Leveraging
   parallelism and dedicated multipliers, our design achieves
   state-of-the-art latency, performing NTT/INTT in just 0.4/ 0 . 5 mu s ,
   surpassing existing designs by at least 3.75/3 times. The proposed
   design is implemented on the cost-effective Artix-7 FPGA.},
