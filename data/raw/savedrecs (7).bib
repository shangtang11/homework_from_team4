@inproceedings{ WOS:001072829100002,
Author = {Schrammel, David and Sultana, Salmin and Grewal, Karanvir Ken and LeMay,
   Michael and Durham, David M. and Unterguggenberger, Martin and Nasahl,
   Pascal and Mangard, Stefan},
Editor = {DiVimercati, SD and Samarati, P},
Title = {MEMES: Memory Encryption-Based Memory Safety on Commodity Hardware},
Booktitle = {PROCEEDINGS OF THE 20TH INTERNATIONAL CONFERENCE ON SECURITY AND
   CRYPTOGRAPHY, SECRYPT 2023},
Series = {SECRYPT},
Year = {2023},
Pages = {25-36},
Note = {20th International Conference on Security and Cryptography (SECRYPT),
   Rome, ITALY, JUL 10-12, 2023},
Abstract = {Memory encryption is an effective security building block broadly
   available on commodity systems from Intel (R) and AMD. Schemes, such as
   Intel (R) TME-MK and AMD SEV, help provide data confidentiality and
   integrity, enabling cryptographic isolation of workloads on shared
   platforms. However, due to their coarse encryption granularity (i.e.,
   pages or entire virtual machines), these hardware-enabled primitives
   cannot unleash their full potential to provide protection for other
   security applications, such as memory safety. To this end, we present a
   novel approach to achieving sub-page-granular memory encryption without
   hardware modifications on off-the-shelf systems featuring Intel (R)'s
   TME-MK. We showcase how to utilize our fine-grained memory encryption
   approach for memory safety by introducing MEMES. MEMES is capable of
   mitigating both spatial and temporal heap memory vulnerabilities by
   encrypting individual memory objects with different encryption keys.
   Compared to other hardware-based memory safety schemes, our approach
   works on existing commodity hardware, which allows easier adoption. Our
   extensive analysis attests to the strong security benefits which are
   provided at a geometric mean runtime overhead of just 16-27\%.},
Type = {Proceedings Paper},
Affiliation = {Schrammel, D (Corresponding Author), Graz Univ Technol, Graz, Austria.
   Schrammel, David; Unterguggenberger, Martin; Nasahl, Pascal; Mangard, Stefan, Graz Univ Technol, Graz, Austria.
