@inproceedings{ WOS:001687137600260,
Author = {Gao, Shuxin and Lin, Chenhao and Zhao, Junyi and Deng, Jingyi and Zhao,
   Zhengyu and Zhang, Chong and Yang, Le and Shen, Chao},
Book-Group-Author = {ACM},
Title = {Beyond One-Size-Fits-All: Fine-Grained Age Group Identification on
   Smartphones for Targeted Child Protection},
Booktitle = {COMPANION OF THE 2025 ACM INTERNATIONAL JOINT CONFERENCE ON PERVASIVE
   AND UBIQUITOUS COMPUTING, UBICOMP COMPANION 2025},
Year = {2025},
Pages = {1346-1352},
Note = {2025 International Joint Conference on Pervasive and Ubiquitous
   Computing-UbiComp Companion, Espoo, FINLAND, OCT 12-16, 2025},
Abstract = {Smartphones are reshaping children's lives more profoundly than ever
   before. However, they also expose children to risks such as gaming
   addiction and violent content, highlighting the urgent need for
   effective identification and protection. Existing methods for age group
   identification typically rely on behavioral data from smartphones
   (touchscreen and built-in sensors) and group all minors together. Such
   approaches overlook the fact that children in different age groups
   exhibit distinct developmental characteristics in cognitive ability,
   emotional sensitivity, and self-control, rendering a one-size-fits-all
   strategy inadequate. Moreover, in real-world smartphone systems,
   collecting user behavior data is challenging, especially since child
   users are far fewer than adults across age groups. In this paper, we
   introduce FineGuard, a fine-grained age group identification system
   utilizing only smartphone sensor data. Our approach eliminates reliance
   on raw touchscreen inputs by extracting rich and informative behavioral
   signals from minimal sensor data. Specifically, we fully leverage domain
   knowledge to design behavioral dynamics features across three
   complementary domains, enabling comprehensive capture of age-related
   interaction patterns. To boost identification accuracy, we further
   employ LLMs to extract high-level semantic features for richer
   representation. We evaluate our system on a self-collected dataset of
   800 participants. Results show that our model outperforms
   state-of-the-art methods in both fine-grained (four-class) and binary
   identification tasks.},
Type = {Proceedings Paper},
Affiliation = {Lin, CH (Corresponding Author), Xi An Jiao Tong Univ, Interdisciplinary Res Ctr Frontier Sci \& Technol, Sch Cyber Sci \& Engn, Xian, Shaanxi, Peoples R China.
