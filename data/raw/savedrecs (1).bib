@article{ WOS:001508990100011,
Author = {Liu, Tingjie and Cheng, Shuli and Du, Anyu and Li, Wenjun},
Title = {Content-adaptive perception mixer visual transformer for hashing image
   retrieval},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2025},
Volume = {289},
Month = {SEP 15},
Abstract = {With the rapid growth of image data, efficient image retrieval methods
   have become increasingly important. Hash image retrieval has gained
   widespread attention due to its advantages in storage and computational
   efficiency. However, existing methods still face limitations in
   capturing global semantic information, resulting in insufficient feature
   extraction. In addition, complex label relationships in datasets lead to
   low efficiency in hash function learning. To address these issues, this
   paper proposes a Content-Adaptive Perception Mixer Visual Transformer
   (CAPMH) for Hash Image Retrieval . First, considering the complex and
   diverse nature of image features, we introduce a Content-Adaptive
   Perception Mixer (CPM), which consists of two key branches: the Dynamic
   Perception Attention Mixer (DPAM) and Multi-Head Feature Fusion (MHFF).
   The DPAM module extracts global semantic information through offset
   sampling and mixed masks, while the MHFF employs convolutional heads
   with varying receptive fields to capture fine-grained details at
   different scales and weight the outputs from the DPAM branch. The CPM
   effectively balances global semantic information with multi-scale
   fine-grained representations, providing richer semantic details for the
   hash mapping process. Second, a balance classification loss function is
   designed to effectively address class imbalance and complex label
   relationships, resulting in more discriminative hash codes. Finally, we
   conduct extensive experiments on three public datasets: CIFAR10, MS-COCO
   and NUS-WIDE, to validate the retrieval performance. The retrieval
   accuracy achieved on the three datasets is 96.48\%, 93.01 \%, and
   89.13\%, respectively.},
Type = {Article},
Affiliation = {Li, WJ (Corresponding Author), Xinjiang Univ, Coll Comp Sci \& Technol, Urumqi 830046, Peoples R China.
