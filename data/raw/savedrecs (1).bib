@article{ WOS:001568928500028,
Author = {Wang, Shuyu and Zhen, Haiqian and Zhao, Hongsheng and Zhang, Dingli and
   Yue, Hongxing},
Title = {Visual-tactile inference in soft grippers leveraging piezoionic
   hydrogels and neuromorphic computing},
Journal = {CHEMICAL ENGINEERING JOURNAL},
Year = {2025},
Volume = {522},
Month = {OCT 15},
Abstract = {Soft grippers struggle to mimic human sensory integration, where touch
   and vision synergize dynamically, a capability epitomized by the
   rubber-hand illusion. To replicate this bioinspired fusion, we present a
   neuromorphic framework combining a self-powered piezoionic hydrogel
   sensor with event-driven vision processing. The PVA/PEDOT:PSS/graphene
   hydrogel's hybrid ionic-electronic conduction resolves the
   static/dynamic sensing trade-off through three synergistic mechanisms:
   (1) PEDOT's ionic channels and graphene's electronic network enable
   rapid charge transport. (2) H+/SO3-migration sustains static signals via
   charge delocalization. (3) Interfacial electric double-layer effects
   amplify outputs. This dual-timescale sensitivity is essential for
   cross-modal prediction, providing temporally diverse tactile inputs
   aligned with visual dynamics. Crucially, our system emulates the
   rubber-hand illusion's neural principles: event-based spike encoding of
   vision reduces tactile prediction errors by 87 \%. The resulting
   visuo-tactile inference enables robots to ``feel{''} touch from sight, a
   milestone in neuromorphic perception. By unifying material innovation
   with brain-like computation, this work pioneers embodied sensory fusion
   for adaptive robotics.},
