@article{ WOS:001643474000037,
Author = {Boubakri, Marouene and Zouari, Belhassen},
Title = {GATOR-V: Accelerating the RISC-V Confidential Computing Ecosystem With a
   Production-Grade TEE},
Journal = {IEEE ACCESS},
Year = {2025},
Volume = {13},
Pages = {210892-210916},
Abstract = {Trusted Execution Environments (TEEs) have become essential for securing
   sensitive computations across modern computing platforms. While the open
   RISC-V architecture offered promising opportunities for security
   innovation, the ecosystem had lacked a production-ready TEE framework
   suitable for real-world deployment. This study introduced GATOR-V, the
   first upstream-ready, production-grade TEE ecosystem for RISC-V. By
   combining hardware-enforced isolation and a standards-compliant trusted
   operating system architecture, GATOR-V provided a complete and reusable
   foundation that was successfully integrated into mainstream open-source
   projects. The framework was implemented and validated across multiple
   RISC-V platforms and demonstrated its practicality through
   representative use cases, including secure communication based on
   Transport Layer Security. Experimental evaluation confirmed that GATOR-V
   achieved strong security guarantees with minimal performance overhead.
   The full implementation was released as open source to ensure
   transparency, reproducibility, and community adoption. Overall, this
   work established a foundational step toward a unified and deployable
   confidential computing ecosystem for RISC-V, enabling future
   advancements in embedded systems, Internet of Things, and confidential
   computing applications.},
Type = {Article},
Affiliation = {Boubakri, M (Corresponding Author), Univ Carthage, Mediatron Lab, SUPCOM, LR11TIC05, Ariana, Tunisia.
   Boubakri, Marouene; Zouari, Belhassen, Univ Carthage, Mediatron Lab, SUPCOM, LR11TIC05, Ariana, Tunisia.},
DOI = {10.1109/ACCESS.2025.3641293},
Keywords = {Ecosystems; Software; Hardware; Computer architecture; Protection;
   Trusted computing; Scalability; Runtime; Standards; Reduced instruction
   set computing; Confidential computing; cryptography; enclave computing;
