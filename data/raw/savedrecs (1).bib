   Hu, Yuxiang; Cui, Pengshuai; Wu, Jiangxing, Natl Key Lab Adv Commun Networks, Zhengzhou 450001, Henan, Peoples R China.},
DOI = {10.1016/j.comnet.2025.111576},
EarlyAccessDate = {AUG 2025},
Article-Number = {111576},
Keywords = {Multi-protocol network; Ternary Content Addressable Memory (TCAM);
   Storage compression; Rule optimization},
Keywords-Plus = {PACKET CLASSIFICATION; TCAM; FRAMEWORK; ALGORITHM},
Author-Email = {huyuxiangchn@163.com},
