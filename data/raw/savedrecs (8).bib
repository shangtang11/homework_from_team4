@inproceedings{ WOS:000980033800045,
Author = {Takayama, Riku and Tada, Jubee},
Book-Group-Author = {IEEE},
Title = {An Implementation of a Pattern Matching Accelerator on a RISC-V
   Processor},
Booktitle = {2022 TENTH INTERNATIONAL SYMPOSIUM ON COMPUTING AND NETWORKING
   WORKSHOPS, CANDARW},
Year = {2022},
Pages = {273-275},
Note = {10th International Symposium on Computing and Networking (CANDAR),
   Himeji, JAPAN, NOV 21-22, 2022},
Abstract = {This paper proposes a pattern matching accelerator and implements it on
   a RISC-V processor. The proposed pattern matching accelerator counts the
   number of times input data matches multiple registered data. The
   accelerator could be used by custom instructions added to a RISC-V
   processor, and the pattern matching process can be accelerated by using
   these instructions. As a benchmark, a program that counts the number of
   times the grid square codes converted from randomly generated latitudes
   and longitudes match the registered grid square codes is used.
   Experimental results show the RISC-V processor with the proposed
   accelerator achieves 52.7\% reduction of execution time compared to the
   original processor.},
Type = {Proceedings Paper},
