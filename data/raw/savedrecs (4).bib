@article{ WOS:001228106000001,
Author = {Shin, Hunbeom and Kim, Giuk and Lee, Sujeong and Choi, Hyojun and Lee,
   Sangho and Lee, Sangmok and Nam, Yunseok and Kang, Geonhyeong and Kim,
   Hyungjun and Ahn, Jinho and Jeon, Sanghun},
Title = {Stabilization of Morphotropic Phase Boundary in Hafnia via Microwave
   Low-Temperature Crystallization Process for Next-Generation Dynamic
   Random Access Memory Technology},
Journal = {PHYSICA STATUS SOLIDI-RAPID RESEARCH LETTERS},
Year = {2024},
Volume = {18},
Number = {9, SI},
Month = {SEP},
Abstract = {The morphotropic phase boundary (MPB), which arises from the combination
   of antiferroelectric and ferroelectric phases, demonstrates the highest
   dielectric constant (kappa) compared to other phases. This emphasizes
   its potential as a leading contender for dielectric films in future
   dynamic random access memory (DRAM) capacitors. MPB-based high-kappa
   materials using hafnia have shown a trade-off between equivalent oxide
   thickness (EOT) and leakage current density (J(leak)) when the
   crystallization temperature increases with scaling the thickness.
   Herein, a microwave annealing (MWA) method that can achieve
   low-temperature crystallization below 350 degrees C is employed. The
   purpose of this method is to mitigate the trade-off relationships and
   achieve the strict criteria of current DRAM capacitors. These criteria
   include low EOT (less than 4 \& Aring;) and J(leak) (less than 10(-7) A
   cm(-2) at 0.8 V) characteristics. The MWA is capable of relatively
   low-temperature annealing by supplying energy to the films through both
   thermal energy and dipole vibration energy. As a result, a record-low
   EOT of 3.76 \& Aring; and a low leakage current characteristic of 4.2 x
   10(-8) A cm(-2) at 0.8 V are achieved concurrently. It is confident that
   the research can be important in addressing the challenges associated
   with reducing the size of next-generation DRAM capacitors.},
Type = {Article},
Affiliation = {Jeon, S (Corresponding Author), Korea Adv Inst Sci \& Technol KAIST, Sch Elect Engn, Daejeon 34141, South Korea.
   Ahn, J (Corresponding Author), Hanyang Univ, Div Mat Sci \& Engn, Seoul 04763, South Korea.
