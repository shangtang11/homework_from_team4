@inproceedings{ WOS:000565237700016,
Author = {Herdt, Vladimir and Grosse, Daniel and Drechsler, Rolf and Gerum,
   Christoph and Jung, Alexander and Benz, Joscha-Joel and Bringmann,
   Oliver and Schwarz, Michael and Stoffel, Dominik and Kunz, Wolfgang},
