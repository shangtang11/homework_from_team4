@article{ WOS:001712581900001,
Author = {Zulberti, Luca and Monopoli, Matteo and Mystkowska, Gabriela and
   Monorchio, Andrea and Moranti, Silvia and Fanucci, Luca and Nannipieri,
   Pietro},
Title = {CGR-AI Engine: A scalable CGRA-based processing platform for Artificial
   Intelligence in space applications},
Journal = {MICROPROCESSORS AND MICROSYSTEMS},
Year = {2026},
Volume = {122},
Month = {JUN},
Abstract = {The execution of processing tasks in space is a cornerstone of modern
   space missions, enabling a wide range of critical applications. In
   recent years, the integration of Artificial Intelligence (AI) within the
   space industry has gained prominence, driven by its superior performance
   compared to traditional methods, particularly in image processing. This
   trend has accelerated the adoption of AI in the space sector. In this
   context, the choice of processing architecture onboard spacecraft
   becomes crucial for ensuring the efficiency of inference algorithms and
   maximizing platform versatility across diverse missions. This paper
   introduces the CGR-AI Engine, a scalable Coarse-Grained Reconfigurable
   Array (CGRA)-based processing platform designed to facilitate the
   deployment of AI applications in space. The platform comprises highly
   customizable components, whose capabilities can be optimized through
   Design Space Exploration (DSE) activities. The results of these
   optimizations are presented in this work. By combining the
   programmability of a RISC-V processor, employed as a memory transaction
   scheduler, with the reconfigurability of a CGRA processing matrix for
   implementing Data Flow Graphs (DFGs) of specific algorithms, the CGR-AI
   Engine offers a flexible and adaptable solution. It is well-suited for
   diverse workloads and can be tailored to meet specific application
   requirements, as well as stringent resource and power constraints. This
   paper outlines the methodology for implementing generalpurpose Neural
   Network (NN) layers and models. It presents synthesis outcomes on the
   DARE65T standard cell library platform and provides a detailed analysis
   of benchmarks conducted to assess their performance, validating the
   proposed solution's capability to meet the demanding requirements of
   onboard processing in space missions.},
