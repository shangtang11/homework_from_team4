@article{ WOS:001650628000001,
Author = {Yadav, Darshana},
Title = {A novel (r, m) threshold QSS protocol with group authentication and
   share distribution using trivariate polynomial},
Journal = {PHYSICA SCRIPTA},
Year = {2025},
Volume = {100},
Number = {12},
Month = {DEC 1},
Abstract = {Quantum Secret Sharing (QSS) mitigates critical vulnerabilities in
   classical cryptographic protocols by leveraging quantum mechanics to
   achieve information-theoretic security. However, existing QSS schemes
   encounter challenges related to scalability, resistance to collusive
   attacks, and the lack of robust participant authentication. This paper
   proposes a novel (r, m) threshold QSS protocol that integrates group
   authentication with quantum-classical hybrid techniques to address these
   limitations. By incorporating the Quantum Fourier Transform (QFT),
   Inverse QFT (IQFT), and controlled-U gate operations within a trivariate
   polynomial secret-sharing framework, the protocol enhances security
   against intercept-resend, entangle-measure, and collusive attacks while
   reducing computational overhead. A practical example is provided to
   validate the protocol's effectiveness.},
