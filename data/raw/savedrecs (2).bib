@article{ WOS:001641551600022,
Author = {Choi, Yongryeol and Lee, Jaeseok and Kim, Youngbeom and Susilo, Willy
   and Yi, Okyeon and You, Ilsun and Seo, Seog Chung},
Title = {Accelerating ALTEQ With HardwareSoftware Co-Design on FPGA},
Journal = {IEEE ACCESS},
Year = {2025},
Volume = {13},
Pages = {206606-206616},
Abstract = {The emergence of quantum computing poses a significant threat to the
   security of modern public-key cryptography, spurring a global effort to
   standardize Post-Quantum Cryptography (PQC). However, optimization
   research has predominantly focused on software implementations and
   lattice-based algorithms, leaving a notable gap in the hardware
   acceleration of non-lattice-based schemes, particularly on platforms
   such as FPGAs. This paper aims to bridge this gap by proposing the first
   HW/SW co-design to accelerate ALTEQ, a non-lattice-based digital
   signature algorithm submitted to the NIST PQC additional signature
   competition. Our approach maximizes performance by strategically
   offloading ALTEQ's most computationally intensive operations-the hash
   function and modular arithmetic-to dedicated hardware accelerators. To
   the best of our knowledge, this is the first study to investigate a
   hardware acceleration architecture for ALTEQ or similar schemes. The
   proposed design achieves performance improvements of up to approximately
   88\% for Keygen, 91\% for Sign, and 92\% for Verify. This demonstrates
   that algorithms not selected for standardization can still achieve
   substantial performance gains through hardware optimization, suggesting
   the potential for re-evaluating such schemes for specific application
   environments and encouraging further research into hardware
   implementations of a broader range of PQC algorithms.},
Type = {Article},
Affiliation = {Seo, SC (Corresponding Author), Kookmin Univ, Dept Cyber Secur, Seoul 02707, South Korea.
   Choi, Yongryeol; Lee, Jaeseok; Yi, Okyeon; You, Ilsun; Seo, Seog Chung, Kookmin Univ, Dept Cyber Secur, Seoul 02707, South Korea.
