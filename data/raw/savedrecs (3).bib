@article{ WOS:001410884500005,
Author = {Vostrikov, Sergei and Tille, Josquin and Benini, Luca and Cossettini,
   Andrea},
Title = {TinyProbe: A Wearable 32-Channel Multimodal Wireless Ultrasound Probe},
Journal = {IEEE TRANSACTIONS ON ULTRASONICS FERROELECTRICS AND FREQUENCY CONTROL},
Year = {2025},
Volume = {72},
