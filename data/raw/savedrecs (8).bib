Title = {A review on SRAM-based computing in-memory: Circuits, functions, and
   applications},
Journal = {JOURNAL OF SEMICONDUCTORS},
Year = {2022},
Volume = {43},
Number = {3},
Month = {MAR 1},
Abstract = {Artificial intelligence (AI) processes data-centric applications with
   minimal effort. However, it poses new challenges to system design in
   terms of computational speed and energy efficiency. The traditional von
   Neumann architecture cannot meet the requirements of heavily
   data-centric applications due to the separation of computation and
   storage. The emergence of computing in-memory (CIM) is significant in
   circumventing the von Neumann bottleneck. A commercialized memory
   architecture, static random-access memory (SRAM), is fast and robust,
   consumes less power, and is compatible with state-of-the-art technology.
   This study investigates the research progress of SRAM-based CIM
   technology in three levels: circuit, function, and application. It also
   outlines the problems, challenges, and prospects of SRAM-based CIM
   macros.},
Type = {Review},
