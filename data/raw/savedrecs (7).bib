   Yang, Mengfei, State Key Lab Space Intelligent Control Technol, Beijing 100090, Peoples R China.},
DOI = {10.1109/TCSI.2022.3228774},
EarlyAccessDate = {DEC 2022},
Keywords = {Fault tolerant systems; Program processors; Registers; Redundancy;
   Encoding; Power demand; Random access memory; L0 BTB; fault tolerance;
   branch predictor; prediction},
Keywords-Plus = {REGISTER FILE; CODES; ECC},
