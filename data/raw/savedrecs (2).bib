@inproceedings{ WOS:001691804100220,
Author = {Eneriz, Daniel and Antolin, Diego and Medrano, Nicolas and Calvo, Belen},
Book-Group-Author = {IEEE},
Title = {A High-Performance FPGA Implementation of MI-BMINet},
Booktitle = {IECON 2025-51ST ANNUAL CONFERENCE OF THE IEEE INDUSTRIAL ELECTRONICS
   SOCIETY},
Year = {2025},
Note = {51st Conference of the Industrial Electronics Society-IECON-Annual,
   Madrid, SPAIN, OCT 14-17, 2025},
Abstract = {This paper presents the FPGA implementation of MI-BMINet, a compact and
   efficient Convolutional Neural Network (CNN) designed for detecting
   Motor-Imagery (MI) tasks in embedded Brain-Computer Interface (BCI)
   systems. Utilizing fpgaConvNet, the MI-BMINet model is mapped into a
   Synchronous Dataflow Graph (SDFG), which was then optimized for minimum
   latency using the SAMO tool. The SDFG was subsequently converted into a
   hardware description, resulting in the MI-BMINet IP, which was tested
   with the ZU7EV MultiProcessor Systen on Chip (MPSoC) on the ZCU104
   evaluation board. A specialized driver was developed to interface with
   the generated IP to assess its performance. The MI-BMINet IP achieved a
   latency of 594 mu s, surpassing the implementation on the Vega Parallel
   Ultra-Low Power (PULP) platform by a factor of over five, at the cost of
   an increased power consumption and energy per inference. To mitigate
   this, a power reduction study was conducted, examining the effects of
   adjusting the FPGA clock frequency and supply voltage on power
   consumption, latency, and energy per inference, finally achieving a
   decrease of 75\% in power consumption and a reduction of 33\% in energy
   per inference.},
Type = {Proceedings Paper},
Affiliation = {Enériz, D (Corresponding Author), Univ Zaragoza, Aragon Inst Engn Res I3A, Grp Power Elect \& Microelect GEPM, Zaragoza, Spain.
