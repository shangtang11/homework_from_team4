Keywords = {Deep Learning; Simulink; TargetLink; SFunction; Electronic control unit
   (ECU); AUTomotive Open System ARchitecture (AUTOSAR);
   Software-in-the-Loop (SIL); Hardware-in-the-Loop (HIL)},
