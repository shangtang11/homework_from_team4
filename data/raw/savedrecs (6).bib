   Wang, Zhenyu, Natl Univ Def Technol, Coll Comp, Changsha, Peoples R China.
   Ren, Guolei, Natl Univ Def Technol, Ctr Teaching \& Res Support, Changsha, Peoples R China.},
DOI = {10.1016/j.jisa.2023.103543},
EarlyAccessDate = {JUN 2023},
