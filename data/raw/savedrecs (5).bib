@inproceedings{ WOS:001447271200328,
Author = {Xing, Daniel and Srivastava, Ankur},
Book-Group-Author = {ACM},
Title = {A High Level Approach to Co-Designing 3D ICs},
Booktitle = {PROCEEDINGS OF THE 61ST ACM/IEEE DESIGN AUTOMATION CONFERENCE, DAC 2024},
Year = {2024},
Note = {61st Design Automation Conference, San Francisco, CA, JUN 23-27, 2024},
Abstract = {3D ICs promise increased logic density and reduced routing congestion
   over conventional monolithic 2D ICs. High level synthesis (HLS) tools
   promise reduced design complexity by approaching the design from a
   higher abstraction level and allow for more optimization flexibility. We
   propose improving timing closure of 3D ICs by co-designing the
   architecture and physical design by integrating HLS and 3D IC macro
   placement into the same holistic loop. On average our method is able to
   reduce estimated total negative slack (TNS) by 62\% and 92\% when
   compared to a traditional binding and placement technique for 2D and 3D
   ICs respectively.},
