Title = {Sound, Precise, and Fast Abstract Interpretation with Tristate Numbers},
Booktitle = {CGO `22: PROCEEDINGS OF THE 2022 IEEE/ACM INTERNATIONAL SYMPOSIUM ON
   CODE GENERATION AND OPTIMIZATION (CGO)},
Series = {International Symposium on Code Generation and Optimization},
Year = {2022},
