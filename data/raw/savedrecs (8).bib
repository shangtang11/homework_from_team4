Author = {Alfieri, Adam and Anantharaman, Surendra B. and Zhang, Huiqin and
   Jariwala, Deep},
Title = {Nanomaterials for Quantum Information Science and Engineering},
Journal = {ADVANCED MATERIALS},
Year = {2023},
Volume = {35},
Number = {27, SI},
Month = {JUL},
Abstract = {Quantum information science and engineering (QISE)-which entails the use
   of quantum mechanical states for information processing, communications,
   and sensing-and the area of nanoscience and nanotechnology have
   dominated condensed matter physics and materials science research in the
   21st century. Solid-state devices for QISE have, to this point,
   predominantly been designed with bulk materials as their constituents.
   This review considers how nanomaterials (i.e., materials with intrinsic
   quantum confinement) may offer inherent advantages over conventional
   materials for QISE. The materials challenges for specific types of
   qubits, along with how emerging nanomaterials may overcome these
   challenges, are identified. Challenges for and progress toward
   nanomaterials-based quantum devices are condidered. The overall aim of
   the review is to help close the gap between the nanotechnology and
   quantum information communities and inspire research that will lead to
   next-generation quantum devices for scalable and practical quantum
   applications.},
Type = {Review},
