   Karmakar, Angshuman, KU Leuven Belgium, Dept Electrotech, Imec COS, B-3000 Leuven, Belgium.},
DOI = {10.1109/JIOT.2023.3282255},
Keywords = {Cryptography; general matrix multiplication (GEMM); lattice-based
   cryptography; polynomial convolution; post-quantum cryptography (PQC);
   tensor cores},
