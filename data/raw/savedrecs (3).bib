@article{ WOS:001397663300001,
Author = {Jiang, Li and Mu, Chunxiao},
Title = {Secure identity access and data transmission scheme of cloud-assisted
   intelligent gymnasium},
Journal = {ALEXANDRIA ENGINEERING JOURNAL},
Year = {2025},
Volume = {115},
Pages = {469-478},
Month = {MAR},
Abstract = {Addressing the privacy security challenges in identity access and data
   transmission for cloud-assisted intelligent gymnasium, this paper
   designs a secure identity access and data transmission scheme (SIA-DTS).
   SIA-DTS employs a three-factor authentication method to achieve secure
   authentication, protects the privacy of identities, utilizes elliptic
   curves for enhanced performance and security, and applies lightweight
   hash operations to minimize computational load. It also establishes
   secure session keys through Diffie-Hellman key exchange for data
   transmission security. SIA-DTS is proved to be secure and meets various
   security requirements as shown by the mode and informal analysis.
   Furthermore, performance analysis reveals that SIA-DTS significantly
   reduces computation and communication overhead, thereby improving
   operational efficiency. Data availability: All relevant data are within
   the paper.},
Type = {Article},
Affiliation = {Jiang, L (Corresponding Author), Yantai Univ, Sch Phys Educ, Yantai 264005, Peoples R China.
