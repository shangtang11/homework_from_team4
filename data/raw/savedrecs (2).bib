@inproceedings{ WOS:001562603200061,
Author = {Kavyashree, B. and Geethashree, A. and Suresh, Monisha and Khatavkar,
   Niranjan R. and Suhas, D. D. and Nikhil, N. M.},
Book-Group-Author = {IEEE},
Title = {RISC-V SIMD Instructions - Vector Extension (Load/Store)},
Booktitle = {2025 3RD INTERNATIONAL CONFERENCE ON INVENTIVE COMPUTING AND
   INFORMATICS, ICICI},
Year = {2025},
Pages = {394-397},
Note = {3rd International Conference on Inventive Computing and
   Informatics-ICICI-Annual, Bengaluru, INDIA, JUN 04-06, 2025},
Abstract = {This research aims to enhance the performance of RISC-V's vector
   extension by optimizing load and store operations, critical for
   efficient parallel processing in applications like multimedia and
   high-performance computing. The proposed design introduces a pipelined
   architecture with three execution stages: Instruction Decision
   Instruction Work (ID-IE), Instruction Work Data Memory (IE-DM), and Data
   Memory-Write-Back (DM-WB). These stages address memory bandwidth and
   latency challenges, improving data transfer efficiency between vector
   registers and memory. Implemented using ASIC, the design is evaluated
   for area, power, and processing performance. Complexity is analyzed
   through pipeline stage interactions, and computational cost is assessed
   via simulation metrics. Effectiveness is measured by comparing
   throughput and latency against baseline RISC-V implementations. This
   work advances RISC V's scalability for data-intensive tasks, ensuring
   compliance with vector extension standards.},
