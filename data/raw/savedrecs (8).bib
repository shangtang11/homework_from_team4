   Catthoor, Francky and Milojevic, Dragomir and Komalan, Manu and
   Cavalcante, Matheus and Riedel, Samuel and Benini, Luca and Lim, Sung
   Kyu},
Book-Group-Author = {ACM},
Title = {Hier-3D: A Hierarchical Physical Design Methodology for
   Face-to-Face-Bonded 3D ICs},
Booktitle = {2022 ACM/IEEE INTERNATIONAL SYMPOSIUM ON LOW POWER ELECTRONICS AND
   DESIGN, ISLPED 2022},
Series = {International Symposium on Low Power Electronics and Design},
Year = {2022},
Note = {ACM/IEEE International Symposium on Low Power Electronics and Design
   (ISLPED), Boston Univ, Boston, MA, AUG 01-02, 2022},
Abstract = {Hierarchical very-large-scale integration (VLSI) flows are an
   understudied yet critical approach to achieving design closure at
   giga-scale complexity and gigahertz frequency targets. This paper
   proposes a novel hierarchical physical design flow enabling the building
   of high-density and commercial-quality two-tier face-to-face-bonded
   hierarchical 3D ICs. We significantly reduce the associated
   manufacturing cost compared to existing 3D implementation flows and, for
   the first time, achieve cost competitiveness against the 2D reference in
   large modern designs. Experimental results on complex industrial and
   open manycore processors demonstrate in two advanced nodes that the
   proposed flow provides major power, performance, and area/cost (PPAC)
   improvements of 1.2-2.2x compared with 2D, where all metrics are
   improved simultaneously, including up to 20 \% power savings.},
Type = {Proceedings Paper},
Affiliation = {Agnesina, A (Corresponding Author), Georgia Inst Technol, Atlanta, GA 30332 USA.
