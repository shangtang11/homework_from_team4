Affiliation = {Dolmeta, A (Corresponding Author), Politecn Torino, Dept Elect \& Telecommun, Turin, Italy.
   Dolmeta, Alessandra; Piscopo, Valeria; Mirigaldi, Mattia; Martina, Maurizio; Masera, Guido, Politecn Torino, Dept Elect \& Telecommun, Turin, Italy.},
