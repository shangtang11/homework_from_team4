@article{ WOS:001688710500001,
Author = {Ji, Yuanfa and Zhong, Mingfeng and Sun, Xiyan and Jiang, Furong and Fu,
   Qiang},
Title = {MADA-Unet: MultiRes-scale attentive dense-aggregating Unet for
   worst-case transient IR-drop prediction},
Journal = {MICROELECTRONICS JOURNAL},
Year = {2026},
Volume = {171},
Month = {MAY},
Abstract = {Predicting the worst-case transient IR drop is critical for ensuring
   power supply integrity. However, IR drop analysis methods based on
   established commercial tools are computationally expensive. In recent
   years, applying machine learning approaches to enhance the efficiency
   and accuracy of IR drop prediction emerged as a significant research
   focus. Existing methods focus on cross-temporal patterns but often
   neglect the influence of local current density and macro-level power
   delivery network(PDN) constraints. This paper proposes MADA-Unet, which
   extracts local details at multi-scale through the SC-MultiResBlock
   module, models global PDN topological relationship using the DenseASPP
   module, and aggregates worst-case IR drop features across different
   channels via the CTrans module. Experiments on the CircuitNet-N28
   dataset demonstrate MADA-Unet reduces the Normalized Mean Absolute Error
   (NMAE) by 9.10\% compared with the state-of-the-art (SOTA) model, and
   significantly decreases Floating-point Operations (FLOPs) and GPU memory
   consumption by 60.18\% and 71.21\%, respectively, thereby achieving an
   optimal balance between high accuracy and computational overhead.},
