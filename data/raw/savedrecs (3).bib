Title = {POSTER: FastBWA: Practical and Cost-Efficient Genome Sequence Alignment
   Pipeline},
Booktitle = {PROCEEDINGS OF THE 2025 THE 30TH ACM SIGPLAN ANNUAL SYMPOSIUM ON
