@inproceedings{ WOS:001698186700019,
Author = {Wang, Zhou and Dui, Haochen and Xu, Yanqing and Shu, Zhou and Zhou,
   Jiuren and Guo, Liyuan and Han, Baoyi and Tang, Xiaonan and Qiao,
   Shushan and Yin, Shouyi and Bharath, Anil A. and Drakakis, Manos Mic},
Book-Group-Author = {IEEE},
Title = {UPE: A Device-edge DNN Inference Artificial Intelligence Processor with
   Supporting Reconfigurable Training},
Booktitle = {2025 IEEE 7TH INTERNATIONAL CONFERENCE ON ARTIFICIAL INTELLIGENCE
