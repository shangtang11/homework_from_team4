@inproceedings{ WOS:001328494800012,
Author = {Ramos, Esteban and Soule, Robert and Alvaro, Peter and Bressana, Pietro
   and Chen, Edmund and Cummings, Uri and Li, Rui and Tsai, James and
   Manohar, Rajit},
Book-Group-Author = {ASSOC COMPUTING MACHINERY},
Title = {Split gRPC: An Isolation Architecture for RPC Software Stacks},
Booktitle = {PROCEEDINGS OF THE 15TH ACM SIGOPS ASIA-PACIFIC WORKSHOP ON SYSTEMS,
   APSYS 2024},
Year = {2024},
Pages = {81-87},
Note = {15th Asia-Pacific Workshop on Systems (APSys), Kyoto, JAPAN, SEP 04-05,
   2024},
Abstract = {Remote procedure calls are a major contributor to performance variance
   in distributed systems due to lack of isolation and contention on shared
   resources. We propose a novel split architecture for a popular RPC
   framework, gRPC. The design partitions RPC applications into two
   communicating components: one dedicated to user-implemented business
   logic, and one dedicated to RPC infrastructure processing. The
   infrastructure process can be run on a dedicated core or on a smart NIC
   (e.g., IPU or DPU), providing effective physical isolation and
   predictable performance. An initial evaluation shows that the split
   architecture adds modest overhead for average case latency, but allows
