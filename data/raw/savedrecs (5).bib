@inproceedings{ WOS:001414891300074,
Author = {Karlos, George and Bal, Henri and Wang, Lin},
Book-Group-Author = {IEEE},
Title = {NetCL: A Unified Programming Framework for In-Network Computing},
Booktitle = {SC24: INTERNATIONAL CONFERENCE FOR HIGH PERFORMANCE COMPUTING,
   NETWORKING, STORAGE AND ANALYSIS, 2024},
Year = {2024},
Note = {2024 International Conference for High Performance Computing,
   Networking, Storage and Analysis, Atlanta, GA, NOV 17-22, 2024},
Abstract = {The emergence of programmable data planes (PDPs) has paved the way for
   in-network computing (INC), a paradigm wherein networking devices
   actively participate in distributed computations. However, PDPs are
   still a niche technology, mostly available to network operators, and
   rely on packet-processing DSLs like P4. This necessitates great
   networking expertise from INC programmers to articulate computational
   tasks in networking terms and reason about their code. To lift this
   barrier to INC we propose a unified compute interface for the data
   plane. We introduce C/C++ extensions that allow INC to be expressed as
   kernel functions processing in-flight messages, and APIs for
   establishing INC-aware communication. We develop a compiler that
   translates kernels into P4, and thin runtimes that handle the required
   network plumbing, shielding INC programmers from low-level networking
   details. We evaluate our system using common INC applications from the
   literature.},
Type = {Proceedings Paper},
Affiliation = {Karlos, G (Corresponding Author), Vrije Univ Amsterdam, Amsterdam, Netherlands.
   Karlos, George; Bal, Henri, Vrije Univ Amsterdam, Amsterdam, Netherlands.
