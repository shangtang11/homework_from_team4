@inproceedings{ WOS:000722006801012,
Author = {Bahmani, Raad and Brasser, Ferdinand and Dessouky, Ghada and Jauernig,
   Patrick and Klimmek, Matthias and Sadeghi, Ahmad-Reza and Stapf,
