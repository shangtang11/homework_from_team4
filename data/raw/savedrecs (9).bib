@article{ WOS:000731143300001,
Author = {Ham, Hyungkyu and Cho, Hyunuk and Kim, Minjae and Park, Jueon and Hong,
   Jeongmin and Sung, Hyojin and Park, Eunhyeok and Lim, Euicheol and Kim,
   Gwangsun},
Title = {Near-Data Processing in Memory Expander for DNN Acceleration on GPUs},
Journal = {IEEE COMPUTER ARCHITECTURE LETTERS},
Year = {2021},
Volume = {20},
Number = {2},
Pages = {171-174},
Month = {JUL-DEC},
Abstract = {We propose a near-data processing (NDP) architecture that exploits a
   memory expander with byte-addressable memory-semantic interconnect to
   accelerate memory-bound operations in deep neural networks (DNNs). Our
   architecture can execute NDP operations on the memory traffic from the
   GPU on-the-fly by employing bump-in-the-wire NDP logic between the
   off-chip link and memory controller. In addition, the memory-bound
   operations executed on the NDP unit can be effectively overlapped with
   compute-intensive operations executed on a GPU, even if the two
   operations have a dependency. Furthermore, the NDP offloading can be
   automatically done by the compiler without any code modification by deep
   learning practitioners. Our approach can achieve a 51\% speedup for
   training VGG-16 with batch normalization.},
Type = {Article},
Affiliation = {Kim, G (Corresponding Author), Pohang Univ Sci \& Technol, Dept Comp Sci \& Engn, Pohang 37673, South Korea.
