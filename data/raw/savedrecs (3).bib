Book-Group-Author = {ACM},
Title = {JBSA: A Bit-Serial Accelerator for Deep Neural Networks Using
   Superconducting SFQ Logic},
Booktitle = {PROCEEDINGS OF THE 39TH ACM INTERNATIONAL CONFERENCE ON SUPERCOMPUTING,
   ACM ICS 2025},
Year = {2025},
