@inproceedings{ WOS:001351042300002,
Author = {Malik, Manuj and Tomas, David and Rosso, Paolo},
Editor = {Metais, E and Meziane, F and Sugumaran, V and Manning, W and Reiff-Marganiec, S},
Title = {How Challenging is Multimodal Irony Detection?},
Booktitle = {NATURAL LANGUAGE PROCESSING AND INFORMATION SYSTEMS, NLDB 2023},
Series = {Lecture Notes in Computer Science},
Year = {2023},
Volume = {13913},
Pages = {18-32},
Note = {28th International Conference on Applications of Natural Language to
   Information Systems (NLDB), Univ Derby, Derby, ENGLAND, JUN 21-23, 2023},
Abstract = {The possibility that social networks offer to attach audio, video, and
   images to textual information has led many users to create messages with
   multimodal irony. Over the last years, a series of approaches have
   emerged trying to leverage all these formats to address the problem of
   multimodal irony detection. The question that the present work tries to
   answer is whether multimodal irony systems are being properly evaluated.
   More specifically, this work studies the most popular dataset used in
   multimodal irony detection combining text and images, identifying
   whether image information is really necessary to understand the ironic
   intention of the text. This corpus was compared to a text-only corpus,
   and different textual and multimodal Transformer models were evaluated
   on them. This study reveals that, in many situations, Transformer models
   were able to identify the ironic nature of the posts considering only
   textual information.},
