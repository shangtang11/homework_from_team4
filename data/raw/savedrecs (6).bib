   Goulao, Manuel, Univ Lisbon, Inst Telecomunicacoes, Inst Super Tecn, Dept Math, P- 1049001 Lisbon, Portugal.},
DOI = {10.1109/ACCESS.2023.3246119},
Keywords = {Hash functions; Side-channel attacks; Receivers; Instruction sets;
   Transient analysis; Timing; Task analysis; Covert channels; last level
   cache; randomized cache; side-channel attacks},
