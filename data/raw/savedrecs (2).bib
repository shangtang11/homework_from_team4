@inproceedings{ WOS:001546474200028,
Author = {Jiang, Binze and Gong, Xiaohang and Wang, Chao and Li, Xi},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Timing-Anomaly-Free Hardware Architecture: A Formal Approach},
Booktitle = {2025 IEEE 25TH INTERNATIONAL SYMPOSIUM ON CLUSTER, CLOUD AND INTERNET
   COMPUTING WORKSHOPS, CCGRIDW},
Year = {2025},
Pages = {206-209},
Note = {25th International Symposium on Cluster, Cloud and Internet Computing
   Workshops-CCGridW, Tromso, NORWAY, MAY 19-22, 2025},
Abstract = {This paper presents a formal method for designing dynamic scheduling
   processors that effectively eliminate timing anomalies. A timing anomaly
   refers to a local worst case (e.g., a cache miss) does not result in a
   global worst case (e.g., the worst-case execution time of the program).
   By restricting the order of instruction execution, we provide a rigorous
   formal proof that the constrained processor is free from scheduling-type
   timing anomalies. This approach ensures accurate and efficient
   worst-case execution time (WCET) analysis for time-critical systems.
   Additionally, the proposed method preserves performance, with the
   constrained processor exhibiting only a 2-4\% reduction in speed
   compared to the original processor.},
