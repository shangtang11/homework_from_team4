@inproceedings{ WOS:000698732400020,
Author = {Kokologiannakis, Michalis and Vafeiadis, Viktor},
Editor = {Silva, A and Leino, KRM},
Title = {GENMC: A Model Checker for Weak Memory Models},
Booktitle = {COMPUTER AIDED VERIFICATION (CAV 2021), PT I},
Series = {Lecture Notes in Computer Science},
Year = {2021},
Volume = {12759},
Pages = {427-440},
Note = {33rd International Conference on Computer-Aided Verification (CAV),
   ELECTR NETWORK, JUL 20-23, 2021},
Abstract = {GENMC is an LLVM-based state-of-the-art stateless model checker for
   concurrent C/C++ programs. Its modular infrastructure allows it to
   support complex memory models, such as RC11 and IMM, and makes it easy
   to extend to support further axiomatic memory models.
   In this paper, we discuss the overall architecture of the tool and how
   it can be extended to support additional memory models, programming
   languages, and/or synchronization primitives. To demonstrate the point,
   we have extended the tool with support for the Linux kernel memory model
   (LKMM), synchronization barriers, POSIX I/O system calls, and better
   error detection capabilities.},
