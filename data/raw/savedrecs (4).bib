@article{ WOS:001181371600002,
Author = {Li, Chunbiao and Akgul, Akif and Bi, Lvqing and Xu, Yuanxiao and Zhang,
   Chuang},
Title = {A chaotic jerk oscillator with interlocked offset boosting},
Journal = {EUROPEAN PHYSICAL JOURNAL PLUS},
Year = {2024},
Volume = {139},
Number = {3},
Month = {MAR 12},
Abstract = {Offset boosting provides a direct channel for chaotic signal
   conditioning in chaos-based engineering. The broadband random-like
   property of chaos poses a great challenge to the design of a chaotic
   system with independent non-bifurcation parameters. In this work, a
   chaotic jerk oscillator with two independent offset parameters is
   constructed, one of which realizes interlocked cross-dimensional offset
   boosting, while the other realizes direct single offset control.
   Furthermore, this system has a single parameter for total amplitude
   control. The chaotic circuit shows the convenient control for easy
   signal conditioning.},
