@inproceedings{ WOS:001267256100015,
Author = {Murillo, Raul and Del Barrio, Alberto A. and Botella, Guillermo},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Square Root Unit with Minimum Iterations for Posit Arithmetic},
Booktitle = {PROCEEDINGS 2024 IEEE 31ST SYMPOSIUM ON COMPUTER ARITHMETIC, ARITH 2024},
Series = {Proceedings Symposium on Computer Arithmetic},
Year = {2024},
Pages = {132-138},
Note = {31st Symposium on Computer Arithmetic (ARITH), Malaga, SPAIN, JUN 10-12,
   2024},
Abstract = {In this paper, we introduce a novel implementation of a square root
   algorithm specifically tailored for posit arithmetic. Unlike traditional
   methods, the proposed approach capitalizes on the inherent flexibility
   of posits, which lack fixed-length fields, to optimize square root
   computations. By accurately estimating the minimum number of required
   fraction bits, our algorithm substantially reduces the recurrence
   iterations without sacrificing accuracy. Implemented across standard
   16-bit, 32-bit, and 64-bit posit formats, our units showcase a
   significant latency reduction in different applications with only a
   marginal increase in resource utilization. Comparative analysis against
   previous pipelined designs underscores the area efficiency of our
   proposed solutions. This research significantly contributes to the
   advancement of posit-based arithmetic units, presenting promising
   opportunities for improving computational system efficiency.},
Type = {Proceedings Paper},
Affiliation = {Murillo, R (Corresponding Author), Univ Complutense Madrid, Fac Phys, Madrid 28040, Spain.
   Murillo, Raul, Univ Complutense Madrid, Fac Phys, Madrid 28040, Spain.
   Del Barrio, Alberto A.; Botella, Guillermo, Univ Complutense Madrid, Fac Comp Sci, Madrid 28040, Spain.},
