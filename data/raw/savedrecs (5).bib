@inproceedings{ WOS:001280469200115,
Author = {Xu, Zhiyuan and Kang, Xinyu and Wang, Xingbo and Chen, Bingzhen and Ye,
   Terry Tao},
Book-Group-Author = {IEEE},
Title = {FlexBits: A Configurable Lightweight RISC-V Micro-architecture for
   Flexible Bit-Width Execution},
Booktitle = {2024 IEEE 6TH INTERNATIONAL CONFERENCE ON AI CIRCUITS AND SYSTEMS, AICAS
   2024},
Series = {IEEE International Conference on Artificial Intelligence Circuits and
   Systems},
Year = {2024},
Pages = {287-291},
Note = {6th International Conference on AI Circuits and Systems (AICAS), Abu
   Dhabi, U ARAB EMIRATES, APR 22-25, 2024},
Abstract = {Fixed-point Quantized Neural Networks (QNNs) can significantly reduce
   computational and bandwidth overhead on energy-efficient edge devices
   while maintaining comparable accuracy. However, edge devices do not have
   the flexibility to support multiple-precision fixed point QNN
   inferences. In this paper, we propose FlexBits, a RISC-V based
   configurable micro-architecture that supports multiple precisions
   fix-point QNN inference through Single Instruction Multiple Data (SIMD)
   custom instruction set. Using FlexBits extension architecture, we
   further build a VexRiscv compatible CPU, called FlexP that implements
   the FlexBits instructions with optimized pipeline and logics on FPGA
   platform. Experimental results demonstrate substantial improvements for
   convolution operations quantized to 2, 4, 8, and 16 bits, with average
   speedups of 20.8x, 7.6x, 3.0x, and 1.7x, respectively, as compared to
   the baseline processors without the extended instructions. In the
   inference task of 8-bit quantized MobileNetV1, the end-to-end inference
   speedup is 1.57x, achieving inference performance comparable to ARM
   Cortex-M4.},
Type = {Proceedings Paper},
Affiliation = {Ye, TT (Corresponding Author), Southern Univ Sci \& Technol, Shenzhen, Peoples R China.
   Xu, Zhiyuan; Kang, Xinyu; Wang, Xingbo; Chen, Bingzhen; Ye, Terry Tao, Southern Univ Sci \& Technol, Shenzhen, Peoples R China.},
