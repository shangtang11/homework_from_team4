@article{ WOS:000876478700002,
Author = {Jia, Min and Sha, Edwin Hsing. -M. and Zhuge, Qingfeng and Gu, Shouzhen},
Title = {Transient computing for energy harvesting systems: A survey},
Journal = {JOURNAL OF SYSTEMS ARCHITECTURE},
Year = {2022},
Volume = {132},
Month = {NOV},
Abstract = {Battery-powered, ultra-low-power embedded devices are often limited by
   the size and maintenance costs of batteries, giving rise to battery-less
   devices and the emergence of energy harvesting systems. Energy
   harvesters obtain enough energy from the environment in order to satisfy
   program execution. However, the difference in the harvesting source and
   the size of the energy storage makes the program not execute
   continuously due to frequent interruptions due to power failures.
   Frequent power failures make the program lose volatile state,
   inconsistent data, and non-termination, so the energy harvesting system
   has to preserve the storage of volatile logic, maintain data
   consistency, and avoid non-termination. In this paper, we show the
   transient computing techniques for energy harvesting systems. We hope
   that this research will provide researchers with insights into transient
   computing and help them address the remaining challenges.},
Type = {Article},
Affiliation = {Sha, EHM (Corresponding Author), East China Normal Univ, Sch Comp Sci \& Technol, Shanghai, Peoples R China.
