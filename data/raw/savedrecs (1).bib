@article{ WOS:001501968700019,
Author = {Guo, Zhaori and Yu, Haitao and Norman, Timothy J. and Gerding, Enrico H.
   and Auricchio, Gennaro and Cai, Zhongqi},
Title = {A cautious multi-advisor sequential decision-making strategy without
   ground truth for maximizing the profits},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2025},
Volume = {286},
Month = {AUG 15},
Abstract = {Multi-advisor decision-making without access to ground truth presents a
   significant problem across various domains, such as investment and
   crowdsourcing. In such scenarios, the challenge lies in designing a
   decision-making strategy to maximize decision profits according to
   decision values and querying costs. To address the challenge above, we
   propose a novel approach, Multi-Advisor Decision Making for Maximizing
   Profits. Our contributions are as follows: First, we propose a novel
   cautious trustworthiness assessment model without relying on ground
   truth. Second, we introduce an adaptive advisor selection strategy based
   on decision values and querying costs. Third, we design an adaptive
   ensemble decision-making strategy based on the advisors' uncertainty,
   achieving high decision accuracy. Additionally, extensive experiments
   demonstrate that our method significantly outperforms eleven baselines
   across twelve conditions.},
Type = {Article},
Affiliation = {Cai, ZQ (Corresponding Author), Xiamen Univ Technol, Xicun, Peoples R China.
