@inproceedings{ WOS:000981940000068,
Author = {BanaGozar, Ali and Shadmehri, Seyed Hossein Hashemi and Stuijk, Sander
   and Kamal, Mehdi and Afzali-Kusha, Ali and Corporaal, Henk},
Book-Group-Author = {IEEE},
Title = {ReMeCo: Reliable memristor-based in-memory neuromorphic computation},
Booktitle = {2023 28TH ASIA AND SOUTH PACIFIC DESIGN AUTOMATION CONFERENCE, ASP-DAC},
Series = {Asia and South Pacific Design Automation Conference Proceedings},
Year = {2023},
Pages = {396-401},
Note = {28th Asia and South Pacific Design Automation Conference (ASP-DAC),
   Miraikan Natl Museum Emerging Sci \& Informat, Tokyo, JAPAN, JAN 16-19,
   2023},
Abstract = {Memristor-based in-memory neuromorphic computing systems promise a
   highly efficient implementation of vector-matrix multiplications,
   commonly used in artificial neural networks (ANNs). However, the
   immature fabrication process of memristors and circuit level
   limitations, i.e., stuck-at-fault (SAF), IR-drop, and deviceto-device
   (D2D) variation, degrade the reliability of these platforms and thus
   impede their wide deployment. In this paper, we present ReMeCo, a
   redundancy-based reliability improvement framework. It addresses the
   non-idealities while constraining the induced overhead. It achieves this
   by performing a sensitivity analysis on ANN. With the acquired insight,
   ReMeCo avoids the redundant calculation of least sensitive neurons and
   layers. ReMeCo uses a heuristic approach to find the balance between
   recovered accuracy and imposed overhead. ReMeCo further decreases
   hardware redundancy by exploiting the bit-slicing technique. In
   addition, the framework employs the ensemble averaging method at the
   output of every ANN layer to incorporate the redundant neurons. The
   efficacy of the ReMeCo is assessed using two well-known ANN models,
   i.e., LeNet, and AlexNet, running the MNIST and CIFAR10 datasets. Our
   results show 98.5\% accuracy recovery with roughly 4\% redundancy which
   is more than 20x lower than the state-of-the-art.},
Type = {Proceedings Paper},
Affiliation = {BanaGozar, A (Corresponding Author), Eindhoven Univ Technol, Eindhoven, Netherlands.
   BanaGozar, Ali; Stuijk, Sander; Corporaal, Henk, Eindhoven Univ Technol, Eindhoven, Netherlands.
   Shadmehri, Seyed Hossein Hashemi, Univ Tehran, Tehran, Iran.
   Kamal, Mehdi, USC, Los Angeles, CA USA.},
DOI = {10.1145/3566097.3567889},
Keywords = {Reliability; Neural Networks; Computation In-Memory; Neuromorphic;
