   Lee, Ben, Oregon State Univ, Sch Elect Engn \& Comp Sci, Corvallis, OR 97331 USA.},
DOI = {10.1109/ACCESS.2023.3293862},
Keywords = {IoT security; bare-metal device; LLVM; code instrumentation; instruction
   obfuscation},
