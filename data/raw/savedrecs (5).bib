@inproceedings{ WOS:001283306100007,
Author = {Sunny, Chilankamol and Das, Satyajit and Martin, Kevin J. M. and Coussy,
   Philippe},
Editor = {Dias, T and Busia, P},
Title = {Standalone Nested Loop Acceleration on CGRAs for Signal Processing
   Applications},
Booktitle = {DESIGN AND ARCHITECTURES FOR SIGNAL AND IMAGE PROCESSING, DASIP 2024},
Series = {Lecture Notes in Computer Science},
Year = {2024},
Volume = {14622},
Pages = {83-95},
Note = {17th International Workshop on Design and Architecture for Signal and
   Image Processing (DASIP), Munich, GERMANY, JAN 17-19, 2024},
Abstract = {Coarse-Grained Reconfigurable Array (CGRA) architectures are becoming
   increasingly popular as low-power accelerators in compute and data
   intensive application domains such as security, multimedia, signal
   processing, and machine learning. The efficiency of a CGRA is determined
   by its architectural features and the compiler's ability to exploit the
   spatio-temporal configuration. Numerous design optimizations and mapping
   techniques have been introduced in this direction. However, the
   execution model has been overlooked, despite its critical role in
   ensuring the efficient acceleration of applications. Most of the
   existing CGRA implementations follow a hosted approach i.e., they
   execute the modulo scheduled innermost loop, entrusting outer loops to
   the host processor. This increases synchronization overhead with the
   host, mitigating the benefits of acceleration provided by the CGRA. In
   this paper, we propose a compilation flow that supports efficient
   standalone execution of nested loops. Experiments show that the
   standalone execution model leads to a maximum of 12.33x and an average
   of 6.75x performance improvement compared to the existing hosted
   execution model. In the proposed model, energy consumption is reduced up
   to 14.49x compared to that of the hosted one. We also compared our
   results with state-of-the-art standalone execution that uses loop
   flattening and achieved a maximum of 4.80x speed up with an average of
   2.80x.},
Type = {Proceedings Paper},
Affiliation = {Das, S (Corresponding Author), IIT Palakkad, Kanjikode, Kerala, India.
   Sunny, Chilankamol; Das, Satyajit, IIT Palakkad, Kanjikode, Kerala, India.
