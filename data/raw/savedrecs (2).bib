   Garofalo, Angelo; Benini, Luca, Swiss Fed Inst Technol, Zurich, Switzerland.
   Belano, Andrea, Univ Pavia, Pavia, Italy.},
Keywords = {neural network acceleration; softmax; transformers; approximate
   computing; exponential function},
Affiliations = {University of Bologna; Swiss Federal Institutes of Technology Domain;
