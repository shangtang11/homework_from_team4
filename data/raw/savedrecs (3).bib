@article{ WOS:001395056300001,
Author = {Arribas, Miguel Jimenez and Hellin, Agustin Martinez and Mateo, Manuel
   Prieto and del Rio, Ivan Gamino and Gallego, Andrea Fernandez and Polo,
   oscar Rodriguez and da Silva, Antonio and Parra, Pablo and Sanchez,
   Sebastian},
Title = {Design and implementation of a synchronous Hardware Performance Monitor
   fora RISC-V space-oriented processor},
Journal = {MICROPROCESSORS AND MICROSYSTEMS},
Year = {2025},
Volume = {112},
Month = {FEB},
Abstract = {The ability to collect statistics about the execution of a program
   within a CPU is of the utmost importance across all fields of computing
   since it allows characterizing the timing performance of a program. This
   capability is even more relevant in safety-critical software systems,
   where it is mandatory to analyze the software timing requirements to
   ensure the correct operation of the programs. Moreover, in order to
   properly evaluate and verify the extra-functional properties of these
   systems, besides timing performance, there are many other statistics
   available on a CPU, such as those associated with its resource
   utilization. In this paper, we showcase a Performance Measurement Unit
   (PMU), also known as a Hardware Performance Monitor (HPM), integrated
   into a RISC-V On-Board Computer (OBC) designed for space applications by
   our research group. The monitoring technique features a novel approach
   whereby the events triggered are not counted immediately but instead are
   propagated through the pipeline so that their annotation is synchronized
   with the executed instruction. Additionally, we also demonstrate the use
   of this PMU in a process to characterize the execution model of the
   processor. Finally, as an example of the statistics provided by the PMU,
   the results obtained running the CoreMark and Dhrystone benchmarks on
   the RISC-V OBC are shown.},
Type = {Article},
Affiliation = {Arribas, MJ (Corresponding Author), Univ Alcala, Space Res Grp, Alcala De Henares 28805, Madrid, Spain.
   Arribas, Miguel Jimenez; Hellin, Agustin Martinez; Mateo, Manuel Prieto; del Rio, Ivan Gamino; Gallego, Andrea Fernandez; Polo, oscar Rodriguez; da Silva, Antonio; Parra, Pablo; Sanchez, Sebastian, Univ Alcala, Space Res Grp, Alcala De Henares 28805, Madrid, Spain.},
