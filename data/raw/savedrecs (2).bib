Title = {FLI: Folding Lookup Instances},
Booktitle = {ADVANCES IN CRYPTOLOGY - ASIACRYPT 2024, PT V},
Series = {Lecture Notes in Computer Science},
Year = {2025},
Volume = {15488},
Pages = {402-435},
Note = {30th International Conference on the Theory and Application of
   Cryptology and Information Security, Kolkata, INDIA, DEC 09-13, 2024},
Abstract = {We introduce two folding schemes for lookup instances: FLI and FLI+SOS.
   Both use a PIOP to check that a matrix has elementary basis vectors as
   rows, with FLI+SOS adding a twist based on Lasso's {[}26]
   SOS-decomposability. FLI takes two lookup instances \{a(1)\}, \{a(2)\}
   subset of \{t\}, and expresses them as matrix equations M-i . t(T) =
   a(i)(T) for i = 1, 2, where each matrix M-i is an element of F-mxN has
   rows which are elementary basis vectors in F-N. Matrices that satisfy
   this condition are said to be in R-elem. Then, a folding scheme for
   R-elem into a relaxed relation is used, which combines the matrices M-1,
   M-2 as M-1 + alpha M-2 for a random alpha is an element of F. Finally,
   the lookup equations are combined as (M-1 + alpha M-2) . t(T) = (a1 +
   alpha a(2))(T). In FLI, only the property that a matrix is in R-elem is
   folded, and this makes the FLI folding step the cheapest among existing
   solutions. The price to pay is in the cost for proving accumulated
   instances. FLI+SOS builds upon FLI to enable folding of large
   SOS-decomposable {[}26] tables. This is achieved through a variation of
   Lasso's approach to SOS-decomposability, which fits FLI naturally. For
   comparison, we describe (for the first time to our knowledge)
   straightforward variations of Protostar {[}5] and Proofs for Deep
   Thought {[}7] that also benefit from SOSdecomposability. We see that for
   many reasonable parameter choices, and especially those arising from
   lookup-based zkVMs {[}1], FLI+SOS can concretely be the cheapest folding
   solution.},
Type = {Proceedings Paper},
Affiliation = {Garreta, A (Corresponding Author), Nethermind Res, London, England.
   Garreta, Albert; Manzur, Ignacio, Nethermind Res, London, England.},
DOI = {10.1007/978-981-96-0935-2\_13},
