@inproceedings{ WOS:001412766300013,
Author = {Zermanek, Vit and Hu, Yixin and de Reus, Pepijn},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {Exploring the Impact of K-Anonymisation on the hnergy Efficiency of
   Machine Learning Algorithms},
Booktitle = {2024 10TH INTERNATIONAL CONFERENCE ON ICT FOR SUSTAINABILITY, ICT4S 2024},
Year = {2024},
Pages = {128-137},
Note = {10th International Conference on ICT for Sustainability, Stockholm,
   SWEDEN, JUN 24-28, 2024},
Abstract = {With the increased use of Artificial Intelligence (AI), concerns about
   AI's energy consumption are increasing as well. This paper investigates
   the impact of k-anonymisation and dataset characteristics on energy
   consumption during machine learning (ML) training. Using three datasets
   from the UCI Machine Learning Repository, we analyze the energy
   efficiency of ML algorithms-Random Forest (RF), k-Nearest neighbours
   (KNN), and Logistic Regression (LR)-trained on both k-anonymised and
   original datasets. Our experiment reveals that k-anonymisation
   significantly reduces energy consumption during Random Forest (RF) and
   Logistic Regression (LR) training. Additionally, we find that
   k-anonymisation leads to greater energy savings in Logistic Regression
   (LR) training if more features are present in the dataset. However, we
   also find that the energy savings do not hold in the KNN case, except
   for one feature case. These findings are backed by Aligned Ranked
   Transform Analysis of Variance on empirically measured energy
   consumption data. Our work strengthens the need for further empirical
   exploration into energy efficiency in ML algorithms amidst the growing
   demand for AI.},
Type = {Proceedings Paper},
Affiliation = {Zermanek, V (Corresponding Author), Univ Amsterdam, Master Comp Sci, Amsterdam, Netherlands.
   Zermanek, Vit, Univ Amsterdam, Master Comp Sci, Amsterdam, Netherlands.
