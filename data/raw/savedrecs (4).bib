@article{ WOS:001294048700010,
Author = {Cui, Yuanxin and Chen, Chen and Cai, Yueping and Zeng, Zhihong and Liu,
   Min and Ye, Jia and Shao, Sihua and Haas, Harald},
Title = {Retroreflective optical ISAC using OFDM: channel modeling and
   performance analysis},
Journal = {OPTICS LETTERS},
Year = {2024},
Volume = {49},
Number = {15},
Pages = {4214-4217},
Month = {AUG 1},
Abstract = {In this Letter, we propose and investigate a retroreflective optical
   integrated sensing and communication (RO-ISAC) system using orthogonal
   frequency division multiplexing (OFDM) and corner cube reflector (CCR).
   To accurately model the reflected sensing channel of the RO-ISAC system,
   both a point source model and an area source model are proposed
   according to the two main types of light sources that are widely used.
   Detailed theoretical and experimental results are presented to verify
   the accuracy of the proposed channel models and evaluate the
   communication and sensing performance of the considered RO-ISAC system.
