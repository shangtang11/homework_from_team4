@inproceedings{ WOS:001441178200039,
Author = {Koenig, Cyril and Forsberg, Bjorn and Benini, Luca},
Book-Group-Author = {IEEE COMPUTER SOC},
Title = {HeroSDK: Streamlining Heterogeneous RISC-V Accelerated Computing From
   Embedded To High-Performance Systems},
Booktitle = {2024 IEEE 42ND INTERNATIONAL CONFERENCE ON COMPUTER DESIGN, ICCD},
Series = {Proceedings IEEE International Conference on Computer Design},
Year = {2024},
Pages = {280-287},
Note = {42nd International Conference on Computer Design, Milan, ITALY, NOV
   18-20, 2024},
Abstract = {Heterogeneous computing systems couple a generalpurpose host processor
   with a single or multiple domain-specific accelerators. Generally,
   embedded systems exploit heterogeneity to increase energy efficiency
   through on-chip accelerators, while high-performance architectures
   leverage it for higher performance through powerful off-chip resources.
   In both cases, heterogeneity comes with programmability and portability
   challenges. In this work, we present HeroSDK, a software development kit
   (SDK) that facilitates both application developers and platform
   designers of RV-based heterogeneous accelerated computing systems. For
   developers, HeroSDK facilitates programming by offering OpenMP-based
   offloading and a device management library. For designers, it boosts
   portability by segmenting its codebase into platform-agnostic and
   platform-specific regions. We demonstrate HeroSDK on two open-source
   systems-on-chip coupling RISC-V 64-bit host processors with RISC-V
   32-bit multi-core accelerators. By emulating these platforms on FPGA, we
   measure an overhead as small as 98k clock cycles to offload the simplest
   OpenMP regions within Linux user space applications. Additionally, we
   benchmark matrix-vector operations for both platforms and measure up to
   5.9x speedup with a 19\% offloadto-work ratio using eight accelerator
   cores. Finally, we propose a kernel module to extend the HeroSDK
   capabilities to off-chip PCIe accelerator cards while reusing 100\% of
   its codebase.},
