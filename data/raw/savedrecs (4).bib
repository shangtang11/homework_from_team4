Keywords = {Circuit faults; Flip-flops; Integrated circuit modeling; Feature
   extraction; Reliability; Graph neural networks; Logic gates; Graph
   neural networks (GNNs); machine learning (ML); selective hardening;
   simulation-based fault injection},
