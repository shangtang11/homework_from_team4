@inproceedings{ WOS:001327659000215,
Author = {Radhika, V and Jaganathan, V and Kanish, V and Surya, S. P. and Subash,
   R.},
Book-Group-Author = {IEEE},
Title = {AI based Smart Boot Space Management System},
Booktitle = {2ND INTERNATIONAL CONFERENCE ON SUSTAINABLE COMPUTING AND SMART SYSTEMS,
   ICSCSS 2024},
Year = {2024},
Pages = {1326-1330},
Note = {2nd International Conference on Sustainable Computing and Smart Systems
   (ICSCSS), Hindusthan Coll Engn \& Technol, Coimbatore, INDIA, JUL 10-12,
   2024},
Abstract = {The boot space is often an overlooked part of a vehicle, representing a
   missed opportunity for efficiency and convenience. Boot space of a car,
   remains underutilized due to the lack of automation and intelligent
   planning. Firstly, the inability to fulfil the optimal utilization of
   available space leads to inefficient packing, often resulting in wasted
   room and compromised comfort during travel. Secondly, the absence of a
   smart planner of luggage causes the problem, especially when
   coordinating luggage from multiple passengers or pick-up points. This
   lack of coordination not only impedes efficient space allocation but
   also prolongs the loading process, causing delays and inconvenience. The
   technical implementation of the project involves hardware, software, and
   machine learning principles. Hardware components such as raspberry pi,
   force sensors, and camera module will form the backbone of the system.
   On the software side, a cloud-based Android Auto application will
   facilitate communication between the vehicle and a centralized server,
   where the machine learning model resides. This model will continuously
   analyze incoming data, learning from past experiences to generate
   optimized packing plans. Finally, user interfaces on the vehicle's
   infotainment system through the Android auto application provides smart
   access to the system, allowing passengers to input their luggage details
   and receive real-time packing recommendations.},
